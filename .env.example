# ============================================================
# EIIBD26 — Variables de Entorno Requeridas
# ============================================================
# Este archivo es SOLO documentación. No contiene valores reales.
# Copia este archivo como .env (ignorado por git) para uso local
# con docker-compose u otros orquestadores.
#
# En Producción: configurar estas variables en el servidor / CI/CD.
# En Desarrollo: usar dotnet user-secrets (ver SECRETS.md).
# ============================================================

# --- Base de Datos ---
ConnectionStrings__DefaultConnection=Server=<HOST>\<INSTANCE>;Database=eiibd26;user id=<USER>;password=<PASSWORD>;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- SendGrid (Email) ---
SendGrid__ApiKey=SG.<your-sendgrid-api-key>
SendGrid__FromEmail=no-reply@eiibd.com
SendGrid__FromName=EIIBD

# --- Twilio (SMS) ---
Twilio__AccountSid=AC<your-twilio-account-sid>
Twilio__AuthToken=<your-twilio-auth-token>
Twilio__FromNumber=+1<your-twilio-phone-number>

# --- VAPID Keys (Push Notifications) ---
# Generar con: npx web-push generate-vapid-keys
VapidKeys__PublicKey=<your-vapid-public-key>
VapidKeys__PrivateKey=<your-vapid-private-key>
VapidKeys__Subject=mailto:admin@eiibd.com

# --- Anthropic / Claude AI ---
AiAnswer__AnthropicApiKey=sk-ant-api03-<your-anthropic-api-key>
AiAnswer__Enabled=true

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
