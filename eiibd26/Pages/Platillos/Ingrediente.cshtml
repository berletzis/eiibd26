@page
@model eiibd26.Pages.Platillos.IngredienteModel
@{
    ViewData["Title"] = Model.MetaTitle;
    var canonical = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/Platillos/Ingrediente/{Model.Slug}";
    // Sin nota clínica REVISADA la página es delgada: noindex hasta que un médico apruebe contenido.
    // Se reactiva solo (y el sitemap la incluye solo) cuando el ingrediente o su grupo tienen nota visible.
    var tieneContenido = Model.IngredienteNota != null || Model.GrupoNota != null;

    // Compartir: puro cliente, URL canónica del ingrediente + su título (espejo de Contenidos/Detalle).
    var shareUrl = canonical;
    var shareTitle = $"¿Puedo comer {Model.Nombre}?";
    var encUrl = System.Net.WebUtility.UrlEncode(shareUrl);
    var encTitle = System.Net.WebUtility.UrlEncode(shareTitle);
    var waHref = $"https://api.whatsapp.com/send?text={encTitle}%20{encUrl}";
    var fbHref = $"https://www.facebook.com/sharer/sharer.php?u={encUrl}";
    var twHref = $"https://twitter.com/intent/tweet?text={encTitle}&url={encUrl}";
}

@section Head {
    @if (!tieneContenido)
    {
        <meta name="robots" content="noindex,follow" />
    }
    <meta name="description" content="@Model.MetaDescription" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:title" content="@Model.MetaTitle" />
    <meta property="og:description" content="@Model.MetaDescription" />
    <meta property="og:type" content="article" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalle.css" asp-append-version="true" />
}

<div class="conte-detail">
    <nav aria-label="miga" class="mb-3">
        <a class="eii-btn eii-btn--ghost eii-btn--sm" href="/Platillos"><i class="bi bi-arrow-left"></i> Platillos</a>
    </nav>

    @* ===== 1. Qué es ===== *@
    <div class="eii-page-header mb-3">
        <div class="eii-page-header__content">
            <h1 class="eii-page-title mb-2">¿Puedo comer @Model.Nombre?</h1>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (!string.IsNullOrWhiteSpace(Model.GrupoNombre))
                {
                    <span class="eii-badge">@Model.GrupoNombre</span>
                }
                @foreach (var a in Model.Atributos)
                {
                    <span class="eii-badge">@a</span>
                }
            </div>
        </div>
    </div>

    <div class="detail-grid" role="main">
        <article class="content-panel">
            @* ===== 2. El hecho honesto ===== *@
            <div class="eii-card mb-4">
                <div class="eii-card__body">
                    <p class="mb-0">
                        <strong>No es un alimento prohibido en la enfermedad inflamatoria intestinal.</strong>
                        No existe un "sí" ni un "no" que valga para todos: lo que cambia es cuánto lo tolera cada persona,
                        y eso depende de tu caso, tu momento y tu tratamiento.
                    </p>
                </div>
            </div>

            @* ===== 3. Nota del ingrediente (solo si el candado la deja pasar) ===== *@
            @if (Model.IngredienteNota != null)
            {
                <div class="eii-card mb-4">
                    <div class="eii-card__body">
                        <h2 class="eii-card__title h6 mb-2"><i class="bi bi-lightbulb"></i> Sobre @Model.Nombre</h2>
                        <partial name="_NotaClinica" model="Model.IngredienteNota" />
                    </div>
                </div>
            }

            @* ===== 4. Contexto clínico del grupo (solo si el candado la deja pasar) ===== *@
            @if (Model.GrupoNota != null)
            {
                <div class="eii-card mb-4">
                    <div class="eii-card__body">
                        <h2 class="eii-card__title h6 mb-2"><i class="bi bi-heart-pulse"></i> Contexto: @Model.GrupoNombre</h2>
                        <partial name="_NotaClinica" model="Model.GrupoNota" />
                    </div>
                </div>
            }

            @* ===== 5. Tu perfil ===== *@
            @if (Model.ExcluidoPorTi)
            {
                <div class="eii-card mb-4">
                    <div class="eii-card__body">
                        <h2 class="eii-card__title h6 mb-2"><i class="bi bi-person-check"></i> En tu perfil</h2>
                        <p class="eii-form-text mb-2">@Model.MotivoExclusion Por eso no te aparece en tus platillos.</p>
                        <a class="eii-btn eii-btn--sm eii-btn--ghost" href="/Identity/Usuario/UsuarioAlimentacion">
                            <i class="bi bi-basket"></i> Lo que no tolero
                        </a>
                    </div>
                </div>
            }

            @* ===== 6. Comunidad y experiencia — maquetado, apagado en v1 (módulo de Tolerancia #16) ===== *@
            <div class="eii-card mb-4">
                <div class="eii-card__body">
                    <h2 class="eii-card__title h6 mb-2">Lo que reporta la comunidad</h2>
                    <p class="eii-form-text mb-0">Nadie ha registrado su tolerancia a este alimento todavía. Pronto podrás ser el primero.</p>
                </div>
            </div>
            <div class="eii-card mb-4">
                <div class="eii-card__body">
                    <h2 class="eii-card__title h6 mb-2">Tu experiencia</h2>
                    <p class="eii-form-text mb-0">Aún no registras tu tolerancia a este alimento. Esta función llegará pronto.</p>
                </div>
            </div>

            @* ===== 7. Cierre — siempre visible ===== *@
            <div class="eii-card mb-4">
                <div class="eii-card__body">
                    <p class="eii-help-text mb-0">
                        <i class="bi bi-info-circle"></i> Esto no es consejo médico. Son datos para que los lleves a tu
                        médico o nutriólogo y decidan juntos. Restringir alimentos "por si acaso" tiene su propio costo:
                        no evites nada sin motivo.
                    </p>
                </div>
            </div>
        </article>

        <aside class="right-panel" aria-label="Acciones">
            @* ===== COMPARTIR (siempre visible, sin toggle) ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">Compartir</h4>
                </div>
                <div class="sidebar-section-content-static">
                    <div class="share-icons" aria-label="Compartir">
                        <a class="share-btn" href="#" data-href="@waHref" title="Compartir en WhatsApp" aria-label="Compartir en WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <a class="share-btn" href="#" data-href="@fbHref" title="Compartir en Facebook" aria-label="Compartir en Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="share-btn" href="#" data-href="@twHref" title="Compartir en X" aria-label="Compartir en X"><i class="bi bi-twitter"></i></a>
                    </div>
                </div>
            </div>

            @* ===== PLATILLOS QUE LO INCLUYEN (movido al sidebar para equilibrar la columna) ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">Platillos que lo incluyen</h4>
                </div>
                <div class="sidebar-section-content-static">
                    @if (Model.PlatillosCount > 0)
                    {
                        <ul class="eii-form-text mb-2">
                            @foreach (var n in Model.PlatillosNombres)
                            {
                                <li>@n</li>
                            }
                        </ul>
                        <a class="eii-btn eii-btn--sm eii-btn--primary" href="/Platillos">Ver todos los platillos</a>
                    }
                    else
                    {
                        <p class="eii-form-text mb-0">Todavía no hay platillos publicados con @Model.Nombre.</p>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Compartir: abre popup centrado (espejo de Contenidos/Detalle). Puro cliente.
        (function () {
            function openPopup(url) {
                try {
                    var w = 600, h = 600;
                    var left = (screen.width / 2) - (w / 2);
                    var top = (screen.height / 2) - (h / 2);
                    window.open(url, '_blank', `scrollbars=yes,resizable=yes,toolbar=no,location=no,width=${w},height=${h},top=${top},left=${left}`);
                } catch (e) { window.location.href = url; }
            }
            document.addEventListener('click', function (e) {
                var a = e.target.closest && e.target.closest('.share-btn');
                if (!a) return;
                e.preventDefault();
                var href = a.getAttribute('data-href') || a.getAttribute('href');
                if (!href) return;
                if (href.indexOf('mailto:') === 0) { window.location.href = href; return; }
                openPopup(href);
            }, { passive: false });
        })();
    </script>
}
