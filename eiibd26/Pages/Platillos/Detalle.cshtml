@page
@model eiibd26.Pages.Platillos.DetalleModel
@{
    ViewData["Title"] = Model.MetaTitle;
    var canonical = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/Platillos/{Model.Slug}";

    var shareUrl = canonical;
    var shareTitle = Model.Nombre;
    var encUrl = System.Net.WebUtility.UrlEncode(shareUrl);
    var encTitle = System.Net.WebUtility.UrlEncode(shareTitle);
    var waHref = $"https://api.whatsapp.com/send?text={encTitle}%20{encUrl}";
    var fbHref = $"https://www.facebook.com/sharer/sharer.php?u={encUrl}";
    var twHref = $"https://twitter.com/intent/tweet?text={encTitle}&url={encUrl}";
}

@section Head {
    <meta name="description" content="@Model.MetaDescription" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:title" content="@Model.MetaTitle" />
    <meta property="og:description" content="@Model.MetaDescription" />
    <meta property="og:type" content="article" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalle.css" asp-append-version="true" />
}

<div class="conte-detail">
    <nav aria-label="miga" class="mb-3">
        <a class="eii-btn eii-btn--ghost eii-btn--sm" href="/Platillos"><i class="bi bi-arrow-left"></i> Platillos</a>
    </nav>

    <div class="eii-page-header mb-3">
        <div class="eii-page-header__content">
            <h1 class="eii-page-title mb-2">@Model.Nombre</h1>
        </div>
    </div>

    @* ===== Metadatos escaneables: primitiva .eii-statrow / .eii-stat (ícono en color +
            valor grande + etiqueta chica, sobre fondos --eii-*-soft). Reemplaza la línea gris ===== *@
    <div class="eii-statrow">
        @if (!string.IsNullOrWhiteSpace(Model.Categoria))
        {
            <div class="eii-stat eii-stat--primary">
                <i class="bi bi-bookmark eii-stat__icon" aria-hidden="true"></i>
                <span class="eii-stat__value">@Model.Categoria</span>
                <span class="eii-stat__label">categoría</span>
            </div>
        }
        @if (Model.Porciones.HasValue)
        {
            <div class="eii-stat eii-stat--info">
                <i class="bi bi-people eii-stat__icon" aria-hidden="true"></i>
                <span class="eii-stat__value">@Model.Porciones</span>
                <span class="eii-stat__label">porciones</span>
            </div>
        }
        @if (Model.TiempoPrepMin.HasValue)
        {
            <div class="eii-stat eii-stat--warning">
                <i class="bi bi-clock eii-stat__icon" aria-hidden="true"></i>
                <span class="eii-stat__value">@Model.TiempoPrepMin min</span>
                <span class="eii-stat__label">preparación</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Dificultad))
        {
            <div class="eii-stat eii-stat--success">
                <i class="bi bi-bar-chart eii-stat__icon" aria-hidden="true"></i>
                <span class="eii-stat__value">@Model.Dificultad</span>
                <span class="eii-stat__label">dificultad</span>
            </div>
        }
    </div>

    <div class="detail-grid" role="main">
        <article class="content-panel">
            @* ===== ¿Cómo encaja contigo? — el bloque de más valor, arriba. Callout (no card):
                    afirmación HONESTA = "no contiene lo que TÚ dijiste que no toleras", nunca "es bueno para ti". ===== *@
            <h2 class="detalle-section-title"><i class="bi bi-person-check"></i> ¿Cómo encaja contigo?</h2>
            @if (!Model.IsAuth || !Model.HasProfile)
            {
                <div class="eii-callout mb-4">
                    <p class="eii-form-text mb-2">Aún no nos dijiste lo que no toleras — cuando lo hagas, filtramos por ti.</p>
                    <a class="eii-btn eii-btn--sm eii-btn--primary" href="/Identity/Usuario/UsuarioAlimentacion">
                        <i class="bi bi-basket"></i> Lo que no tolero
                    </a>
                </div>
            }
            else if (Model.Cumple)
            {
                <div class="eii-callout eii-callout--success mb-4">
                    <p class="eii-form-text mb-1"><i class="bi bi-check-circle"></i> <strong>No contiene lo que dijiste que no toleras.</strong></p>
                    @{
                        const int maxChips = 5;
                        var chips = Model.Exclusiones.Take(maxChips).ToList();
                        var extra = Model.Exclusiones.Count - chips.Count;
                    }
                    @if (chips.Any())
                    {
                        <div class="encaje-chips">
                            @foreach (var ex in chips)
                            {
                                <span class="encaje-chip"><i class="bi bi-check" aria-hidden="true"></i> sin @ex.ToLowerInvariant()</span>
                            }
                            @if (extra > 0)
                            {
                                <span class="encaje-chip encaje-chip--more">…y @extra más</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="eii-callout eii-callout--warning mb-4">
                    <p class="eii-form-text mb-2">Este platillo tiene algo que marcaste que no toleras:</p>
                    <ul class="eii-form-text mb-0">
                        @foreach (var it in Model.Rompen)
                        {
                            <li><strong>@it.Ingrediente</strong>, @it.Detalle.</li>
                        }
                    </ul>
                </div>
            }

            @* ===== Ingredientes en mini-cards (título como sección, fuera del card). El pie varía por
                    ingrediente: link "¿Puedo comerlo?" si tiene ficha clínica, o leyenda muted si aún no. ===== *@
            <h2 class="detalle-section-title">Ingredientes</h2>
            <div class="ingredientes-grid">
                @foreach (var r in Model.Ingredientes)
                {
                    <div class="ingrediente-card">
                        <a href="/Platillos/Ingrediente/@r.Slug" class="ingrediente-card__name">@r.Nombre</a>
                        @{
                            var metaParts = new List<string>();
                            if (r.EsAlGusto) { metaParts.Add("al gusto"); }
                            else if (r.Cantidad.HasValue) { metaParts.Add($"{r.Cantidad.Value.ToString("0.###")} {r.Unidad}".Trim()); }
                            metaParts.AddRange(r.Usos);
                        }
                        @if (metaParts.Any())
                        {
                            <div class="ingrediente-card__meta">@string.Join(" · ", metaParts)</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.NotaPreparacion))
                        {
                            <div class="ingrediente-card__note">@r.NotaPreparacion</div>
                        }
                        <div class="ingrediente-card__foot">
                            @if (r.TieneNota)
                            {
                                <a href="/Platillos/Ingrediente/@r.Slug" class="eii-inline-link" title="Ver qué se sabe sobre @r.Nombre">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i> ¿Puedo comerlo?
                                </a>
                            }
                            else
                            {
                                <span class="ingrediente-card__sin-ficha">Aún no hay una ficha para este alimento</span>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ===== Preparación en card aparte ===== *@
            @if (!string.IsNullOrWhiteSpace(Model.PasosResumidos))
            {
                <h2 class="detalle-section-title">Preparación</h2>
                <div class="eii-card mb-4">
                    <div class="eii-card__body">
                        @foreach (var linea in Model.PasosResumidos.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p class="mb-2">@linea</p>
                        }
                    </div>
                </div>
            }

            @* ===== Crédito de la fuente: línea discreta, sin caja ===== *@
            @if (!string.IsNullOrWhiteSpace(Model.FuenteNombre))
            {
                <p class="eii-help-text">
                    Fuente:
                    @if (!string.IsNullOrWhiteSpace(Model.FuenteUrl))
                    {
                        <a href="@Model.FuenteUrl" target="_blank" rel="noopener nofollow">@Model.FuenteNombre</a>
                    }
                    else
                    {
                        @Model.FuenteNombre
                    }
                </p>
            }

            @* ===== Aviso legal (card morado) — versión móvil; el sidebar lo oculta en desktop ===== *@
            <div class="aviso-termino-inline aviso-termino-box mb-4">
                <p class="aviso-title mb-2">Esto no es una dieta</p>
                <p class="aviso-text">
                    Solo te mostramos los platillos que <strong>no contienen lo que tú dijiste que no toleras</strong>. No sabemos
                    nada de tu enfermedad, tu tratamiento, ni de si estás en brote. Que un platillo aparezca aquí
                    <strong>no significa que te haga bien</strong>. Tu dieta la diseñas con tu Profesional de la Salud.
                </p>
            </div>
        </article>

        <aside class="right-panel" aria-label="Acciones">
            @* ===== CALIFICAR (PlatCalificacion, TipoDestino='Platillo') ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">Calificar</h4>
                </div>
                <div class="sidebar-section-content-static">
                    <div class="article-rating" id="platilloRating" data-tipo="Platillo" data-destino-id="@Model.PlatilloId">
                        <div class="rating-buttons">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <button type="button" class="rating-btn rating-like" data-rating="like" title="Me fue útil">
                                    <i class="bi bi-hand-thumbs-up"></i>
                                    <span class="rating-text">Me fue útil</span>
                                    <span class="rating-count" id="likeCount">...</span>
                                </button>
                                <button type="button" class="rating-btn rating-dislike" data-rating="dislike" title="No me fue útil">
                                    <i class="bi bi-hand-thumbs-down"></i>
                                    <span class="rating-text">No me fue útil</span>
                                    <span class="rating-count" id="dislikeCount">...</span>
                                </button>
                            }
                            else
                            {
                                <div class="rating-login-hint">
                                    <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)">Inicia sesión</a> para calificar
                                </div>
                            }
                        </div>
                        <div class="rating-message" id="ratingMessage" style="display: none;"></div>
                    </div>
                </div>
            </div>

            @* ===== COMPARTIR ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">Compartir</h4>
                </div>
                <div class="sidebar-section-content-static">
                    <div class="share-icons" aria-label="Compartir">
                        <a class="share-btn" href="#" data-href="@waHref" title="Compartir en WhatsApp" aria-label="Compartir en WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <a class="share-btn" href="#" data-href="@fbHref" title="Compartir en Facebook" aria-label="Compartir en Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="share-btn" href="#" data-href="@twHref" title="Compartir en X" aria-label="Compartir en X"><i class="bi bi-twitter"></i></a>
                    </div>
                </div>
            </div>

            @* ===== AVISO LEGAL (card morado) — debajo de Compartir; hijo directo de .right-panel para
                    que la responsive de detalle.css lo oculte en móvil (se muestra el inline del artículo) ===== *@
            <div class="aviso-termino-box">
                <p class="aviso-title mb-2">Esto no es una dieta</p>
                <p class="aviso-text">
                    Solo te mostramos los platillos que <strong>no contienen lo que tú dijiste que no toleras</strong>. No sabemos
                    nada de tu enfermedad, tu tratamiento, ni de si estás en brote. Que un platillo aparezca aquí
                    <strong>no significa que te haga bien</strong>. Tu dieta la diseñas con tu Profesional de la Salud.
                </p>
            </div>

            @* ===== SIN SELLO MÉDICO (card ámbar) — contenido FIJO, sin lógica. Explica por qué un platillo
                    (una receta) no se valida médicamente y redirige al ingrediente, que sí. Solo en el detalle
                    de platillo (el ingrediente sí tiene validación). Misma forma que el aviso morado de arriba
                    (.aviso-termino-box), variante --warning: hermanos, solo distinto color. ===== *@
            <div class="aviso-termino-box aviso-termino-box--warning">
                <p class="aviso-title mb-2">¿Por qué este platillo no tiene sello médico?</p>
                <p class="aviso-text mb-2">
                    Un platillo es solo una receta — una combinación de ingredientes. La plataforma no dice
                    si un platillo "es bueno" para ti, porque eso depende de tu caso, no de la receta.
                </p>
                <p class="aviso-text">
                    Lo que sí revisan profesionales de la salud es la información de cada ingrediente. Toca un
                    ingrediente de la lista —los que tienen el enlace
                    <span class="eii-inline-link"><i class="bi bi-info-circle" aria-hidden="true"></i> ¿Puedo comerlo?</span>—
                    para ver qué se sabe sobre él.
                </p>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Compartir: popup centrado. Puro cliente.
        (function () {
            function openPopup(url) {
                try {
                    var w = 600, h = 600;
                    var left = (screen.width / 2) - (w / 2);
                    var top = (screen.height / 2) - (h / 2);
                    window.open(url, '_blank', `scrollbars=yes,resizable=yes,toolbar=no,location=no,width=${w},height=${h},top=${top},left=${left}`);
                } catch (e) { window.location.href = url; }
            }
            document.addEventListener('click', function (e) {
                var a = e.target.closest && e.target.closest('.share-btn');
                if (!a) return;
                e.preventDefault();
                var href = a.getAttribute('data-href') || a.getAttribute('href');
                if (!href) return;
                if (href.indexOf('mailto:') === 0) { window.location.href = href; return; }
                openPopup(href);
            }, { passive: false });
        })();

        // Calificación del platillo (mismo patrón que el ingrediente, TipoDestino='Platillo').
        (function () {
            const container = document.getElementById('platilloRating');
            if (!container) return;

            const tipo = container.getAttribute('data-tipo');
            const destinoId = container.getAttribute('data-destino-id');
            const likeBtn = container.querySelector('.rating-like');
            const dislikeBtn = container.querySelector('.rating-dislike');
            const likeCount = document.getElementById('likeCount');
            const dislikeCount = document.getElementById('dislikeCount');
            const ratingMessage = document.getElementById('ratingMessage');
            const endpoint = `/api/platillos/calificacion/${tipo}/${destinoId}`;

            function showMessage(text, type) {
                if (!ratingMessage) return;
                ratingMessage.textContent = text;
                ratingMessage.className = 'rating-message ' + (type || 'info');
                ratingMessage.style.display = 'block';
            }
            function hideMessage() { if (ratingMessage) ratingMessage.style.display = 'none'; }

            async function loadState() {
                try {
                    const resp = await fetch(endpoint);
                    const data = await resp.json();
                    if (data.ok && data.estadisticas) {
                        if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                        if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;
                        if (data.ratingUsuario) {
                            if (data.ratingUsuario.tipo === 'like' && likeBtn) likeBtn.classList.add('active');
                            else if (data.ratingUsuario.tipo === 'dislike' && dislikeBtn) dislikeBtn.classList.add('active');
                        }
                    }
                } catch (err) {
                    if (likeCount) likeCount.textContent = '0';
                    if (dislikeCount) dislikeCount.textContent = '0';
                }
            }

            async function sendRating(ratingType) {
                try {
                    showMessage('Guardando...', 'info');
                    const resp = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ratingType: ratingType })
                    });
                    const data = await resp.json();
                    if (data.ok) {
                        if (data.estadisticas) {
                            if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                            if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;
                        }
                        if (likeBtn) likeBtn.classList.toggle('active', ratingType === 'like');
                        if (dislikeBtn) dislikeBtn.classList.toggle('active', ratingType === 'dislike');
                        showMessage('✅ ¡Gracias por tu opinión!', 'success');
                        setTimeout(hideMessage, 3000);
                    } else {
                        showMessage('❌ ' + (data.error || 'Error al guardar'), 'error');
                    }
                } catch (err) {
                    showMessage('❌ Error de conexión', 'error');
                }
            }

            if (likeBtn) likeBtn.addEventListener('click', function () {
                if (likeBtn.classList.contains('active')) return;
                sendRating('like');
            });
            if (dislikeBtn) dislikeBtn.addEventListener('click', function () {
                if (dislikeBtn.classList.contains('active')) return;
                sendRating('dislike');
            });

            loadState();
        })();
    </script>
}
