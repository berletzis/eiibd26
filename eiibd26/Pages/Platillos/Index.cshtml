@page "/Platillos"
@model eiibd26.Pages.Platillos.IndexModel
@{
    ViewData["Title"] = "Platillos";
    bool hayFiltros = Model.Chips.Any();
    bool modoQuery = Model.Filtrado || Model.VerTodos;
}

@section Styles {
    @* Reusa el chrome de búsqueda/filtros de Contenidos/Index (.se-*, .filters-toggle-header,
       .tag, .more-tags-toggle) — ya vive en este archivo compartido. Cero CSS nuevo. *@
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        .plat-page { padding-top: var(--eii-space-6); padding-bottom: var(--eii-space-7); }

        .plat-chips { display: flex; flex-wrap: wrap; gap: var(--eii-space-2); align-items: center; }
        .plat-chip-x { margin-left: var(--eii-space-2); opacity: .8; }

        .plat-grid {
            display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: var(--eii-space-4); align-items: start; margin-bottom: var(--eii-space-5);
        }
        @@media (max-width: 991.98px) { .plat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (max-width: 575.98px) { .plat-grid { grid-template-columns: minmax(0, 1fr); } }

        .plat-card__meta { display: flex; flex-wrap: wrap; gap: var(--eii-space-2); align-items: center; margin-bottom: var(--eii-space-2); }
        .plat-card__pasos { color: var(--eii-text-soft); font-size: var(--eii-text-sm); line-height: 1.55; margin: var(--eii-space-2) 0; }
        .plat-card__fuente { color: var(--eii-text-soft); font-size: var(--eii-text-xs); margin-top: var(--eii-space-2); }

        .plat-cercano { display: flex; flex-direction: column; gap: var(--eii-space-1); padding: var(--eii-space-3) 0; border-bottom: 1px solid var(--eii-border); }
        .plat-cercano:last-child { border-bottom: none; }
        .plat-cercano__motivo { color: var(--eii-text-soft); font-size: var(--eii-text-sm); }

        .load-more-wrap { display: flex; justify-content: center; width: 100%; margin-top: var(--eii-space-5); }
    </style>
}

<main class="plat-page" role="main" aria-label="Platillos">
    <div class="container py-4">
        <div class="eii-page-header">
            <div class="eii-page-header__content">
                <h1 class="eii-page-title">Platillos</h1>
                <p class="eii-form-text mb-0">
                    Platillos que puedes preparar. Si nos dices lo que no toleras, te mostramos solo los que sí puedes comer.
                </p>
            </div>
        </div>

        @* ===== Buscador + filtro por categoría (espejo de Contenidos/Index) ===== *@
        @{
            const int TAG_PREVIEW = 12;
            // Querystring base que preserva búsqueda y modo (todo MENOS 'categoria'). Mismo criterio
            // que usaban los hidden del form anterior: los tags de categoría se comportan igual que
            // pulsar "Buscar", sin cambiar la semántica de filtrado del backend.
            var baseParams = new List<string>();
            if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) baseParams.Add("q=" + Uri.EscapeDataString(Model.SearchQuery));
            if (Model.VerTodos)
            {
                baseParams.Add("verTodos=true");
            }
            else
            {
                baseParams.Add("f=true");
                if (Model.FilterGrupoIds.Any()) baseParams.Add("grupos=" + Uri.EscapeDataString(string.Join(",", Model.FilterGrupoIds)));
                if (Model.FilterIngredienteIds.Any()) baseParams.Add("ingredientes=" + Uri.EscapeDataString(string.Join(",", Model.FilterIngredienteIds)));
                if (Model.FilterAtributoIds.Any()) baseParams.Add("atributos=" + Uri.EscapeDataString(string.Join(",", Model.FilterAtributoIds)));
            }
            Func<int?, string> catUrl = id =>
            {
                var ps = new List<string>(baseParams);
                if (id.HasValue) ps.Add("categoria=" + id.Value);
                return "/Platillos" + (ps.Count > 0 ? "?" + string.Join("&", ps) : "");
            };
        }

        <div class="se-header" role="region" aria-label="Buscador de platillos">
            <label for="q" class="se-search-label">Busca un platillo por su nombre.</label>
            <form method="get" action="/Platillos" class="se-search" role="search" aria-label="Buscar platillos">
                <input id="q" name="q" class="se-search-input" value="@(Model.SearchQuery ?? "")"
                       placeholder="Nombre del platillo…" autocomplete="off" aria-label="Buscar platillos" />
                <div style="display:flex; gap:8px; align-items:center;">
                    <button class="se-btn se-btn-primary" type="submit" title="Buscar" aria-label="Buscar">
                        <i class="bi bi-search" style="font-size:1.05rem;"></i>
                    </button>
                </div>
                @* Conserva la categoría activa al buscar por texto *@
                @if (Model.Categoria.HasValue)
                {
                    <input type="hidden" name="categoria" value="@Model.Categoria" />
                }
                @* Conserva el modo/filtros actuales al buscar *@
                @if (Model.VerTodos)
                {
                    <input type="hidden" name="verTodos" value="true" />
                }
                else
                {
                    <input type="hidden" name="f" value="true" />
                    @if (Model.FilterGrupoIds.Any())
                    {
                        <input type="hidden" name="grupos" value="@string.Join(",", Model.FilterGrupoIds)" />
                    }
                    @if (Model.FilterIngredienteIds.Any())
                    {
                        <input type="hidden" name="ingredientes" value="@string.Join(",", Model.FilterIngredienteIds)" />
                    }
                    @if (Model.FilterAtributoIds.Any())
                    {
                        <input type="hidden" name="atributos" value="@string.Join(",", Model.FilterAtributoIds)" />
                    }
                }
            </form>

            @* ===== Abajo, dos columnas: "Filtrando por" | "Filtrar por categoría" — mismo componente .tag ===== *@
            @{ bool hasLeft = hayFiltros || (Model.IsAuth && !Model.HasProfile); }
            <div class="row mt-2">
                @if (hasLeft)
                {
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="tag-group">
                            <div class="group-tags">
                                <label class="group-title">Filtrando por</label>
                                @if (hayFiltros)
                                {
                                    @foreach (var chip in Model.Chips)
                                    {
                                        <button type="button" class="tag active" data-nav-url="@Model.BuildRemoveUrl(chip.Tipo, chip.RefId)" title="Quitar de esta búsqueda">
                                            @chip.Nombre <span class="plat-chip-x" aria-hidden="true">✕</span>
                                        </button>
                                    }
                                    <a href="@Model.BuildVerTodosUrl()" class="eii-btn eii-btn--sm eii-btn--ghost">Ver todos los platillos</a>
                                }
                                else
                                {
                                    <span class="eii-form-text mb-0">Estás viendo todos los platillos. Dinos lo que no toleras y filtramos por ti.</span>
                                    <a href="/Identity/Usuario/UsuarioAlimentacion" class="eii-btn eii-btn--sm eii-btn--primary">
                                        <i class="bi bi-basket"></i> Lo que no tolero
                                    </a>
                                }
                            </div>
                            @if (hayFiltros)
                            {
                                <p class="eii-help-text mb-0 mt-2">
                                    Quitar un filtro aquí es solo para esta búsqueda. Para cambiarlo de forma
                                    permanente, ve a <a href="/Identity/Usuario/UsuarioAlimentacion">Lo que no tolero</a> en tu panel.
                                </p>
                            }
                        </div>
                    </div>
                }

                @if (Model.Categorias.Any())
                {
                    <div class="@(hasLeft ? "col-md-6" : "col-12")">
                        <div class="tag-group">
                            <div class="group-tags" data-group="categorias">
                                <label class="group-title">Filtrar por categoría</label>
                                <button type="button" class="tag @(!Model.Categoria.HasValue ? "active" : "")" data-nav-url="@catUrl(null)">Todas</button>
                                @{ var idx = 0; }
                                @foreach (var c in Model.Categorias)
                                {
                                    var active = Model.Categoria == c.Id;
                                    <button type="button" class="tag @(active ? "active" : "")" data-nav-url="@catUrl(c.Id)"
                                            data-overflow="@(idx >= TAG_PREVIEW ? "true" : "false")" hidden="@(idx >= TAG_PREVIEW)">@c.Nombre</button>
                                    idx++;
                                }
                                @if (Model.Categorias.Count > TAG_PREVIEW)
                                {
                                    <button type="button" class="more-tags-toggle" data-toggle-group="categorias" aria-expanded="false">Ver más</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ===== "Esto no es una dieta" (aviso legal, card morado): pegado al contador, solo al filtrar por perfil ===== *@
        @if (hayFiltros)
        {
            <div class="aviso-termino-box">
                <p class="aviso-title mb-2">Esto no es una dieta</p>
                <p class="aviso-text">
                    Solo te mostramos los platillos que <strong>no contienen lo que tú dijiste que no toleras</strong>. No sabemos
                    nada de tu enfermedad, tu tratamiento, ni de si estás en brote. Que un platillo aparezca aquí
                    <strong>no significa que te haga bien</strong>. Tu dieta la diseñas con tu Profesional de la Salud.
                </p>
            </div>
        }

        @* ===== Contador X de Y + volver a perfil ===== *@
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
            <div class="eii-form-text mb-0">
                @if (hayFiltros)
                {
                    <strong>@Model.TotalCumplen</strong> <span>de @Model.TotalEnScope platillos cumplen tu perfil.</span>
                }
                else
                {
                    <strong>@Model.TotalEnScope</strong> <span>platillos.</span>
                }
            </div>
            @if (modoQuery && Model.IsAuth && Model.HasProfile)
            {
                <a href="@Model.BuildPerfilUrl()" class="eii-btn eii-btn--sm eii-btn--ghost">
                    <i class="bi bi-arrow-counterclockwise"></i> Volver a mi perfil
                </a>
            }
        </div>

        @* ===== Resultados ===== *@
        @if (Model.Items.Any())
        {
            <div class="plat-grid" id="platGrid">
                <partial name="~/Pages/Shared/_PlatilloItems.cshtml" model="Model.Items" />
            </div>

            @if (Model.TotalCumplen > Model.Items.Count)
            {
                <div class="load-more-wrap" id="loadMoreWrap">
                    <button id="loadMoreBtn" class="eii-btn eii-btn--primary"
                            data-nextpage="@(Model.PageNumber + 1)" data-pagesize="@Model.PageSize" data-total="@Model.TotalCumplen">
                        Cargar más
                    </button>
                </div>
            }
        }
        else if (Model.Cercanos.Any())
        {
            @* Estado vacío: nunca lista vacía — mostramos los más cercanos con su motivo *@
            <div class="eii-card">
                <div class="eii-card__body">
                    <h2 class="eii-card__title h6 mb-1">Ningún platillo cumple tu perfil completo</h2>
                    <p class="eii-form-text">Estos son los más cercanos — solo tienen algo que marcaste que no toleras:</p>
                    <div>
                        @foreach (var c in Model.Cercanos)
                        {
                            <div class="plat-cercano">
                                <span class="fw-semibold">@c.Nombre</span>
                                <span class="plat-cercano__motivo">Solo tiene: @string.Join(", ", c.Motivo)</span>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <a href="@Model.BuildVerTodosUrl()" class="eii-btn eii-btn--sm eii-btn--primary">Ver todos los platillos</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="eii-card">
                <div class="eii-card__body">
                    <p class="eii-form-text mb-0">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.Categoria.HasValue)
                        {
                            <span>No hay platillos con esos criterios. <a href="/Platillos">Ver todos</a>.</span>
                        }
                        else
                        {
                            <span>Aún no hay platillos publicados.</span>
                        }
                    </p>
                </div>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('loadMoreBtn');
            if (!btn) return;
            const grid = document.getElementById('platGrid');
            const wrap = document.getElementById('loadMoreWrap');

            // Estado de filtro ACTUAL (ya resuelto: perfil o query string). Se materializa con f=true
            // para que /Platillos/Mas reproduzca exactamente las mismas exclusiones que esta página.
            const F = {
                q: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchQuery ?? "")),
                categoria: @(Model.Categoria?.ToString() ?? "null"),
                verTodos: @(Model.VerTodos ? "true" : "false"),
                grupos: '@string.Join(",", Model.FilterGrupoIds)',
                ingredientes: '@string.Join(",", Model.FilterIngredienteIds)',
                atributos: '@string.Join(",", Model.FilterAtributoIds)'
            };

            function buildParams(next, pageSize) {
                const p = new URLSearchParams();
                p.set('PageNumber', String(next));
                p.set('PageSize', String(pageSize));
                if (F.q) p.set('q', F.q);
                if (F.categoria != null) p.set('categoria', String(F.categoria));
                if (F.verTodos) {
                    p.set('verTodos', 'true');
                } else {
                    p.set('f', 'true');
                    if (F.grupos) p.set('grupos', F.grupos);
                    if (F.ingredientes) p.set('ingredientes', F.ingredientes);
                    if (F.atributos) p.set('atributos', F.atributos);
                }
                return p;
            }

            btn.addEventListener('click', async () => {
                const next = parseInt(btn.dataset.nextpage, 10);
                const pageSize = parseInt(btn.dataset.pagesize, 10);
                btn.disabled = true;
                const original = btn.textContent;
                btn.textContent = 'Cargando…';
                try {
                    const res = await fetch('/Platillos/Mas?' + buildParams(next, pageSize).toString(),
                        { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const html = await res.text();
                    const total = parseInt(res.headers.get('X-Total-Count') || '0', 10);

                    const temp = document.createElement('div');
                    temp.innerHTML = html;
                    const nuevas = temp.querySelectorAll('.eii-card').length;
                    while (temp.firstChild) grid.appendChild(temp.firstChild);

                    btn.dataset.nextpage = String(next + 1);
                    const cargadas = grid.querySelectorAll('.eii-card').length;
                    if (nuevas === 0 || cargadas >= total) {
                        wrap.remove();   // no vienen más
                    } else {
                        btn.disabled = false;
                        btn.textContent = original;
                    }
                } catch (e) {
                    console.error(e);
                    btn.disabled = false;
                    btn.textContent = original;
                }
            });
        })();

        // ===== Filtros: navegación de cápsulas (categoría y exclusión) + "Ver más" =====
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                // Cápsula .tag → navega (categoría: single-select; exclusión: quita el filtro).
                // El href preserva búsqueda y modo; no cambia la semántica de filtrado del backend.
                document.querySelectorAll('.tag[data-nav-url]').forEach(function (t) {
                    t.addEventListener('click', function () {
                        const url = t.getAttribute('data-nav-url');
                        if (url) window.location.href = url;
                    });
                });

                // "Ver más": muestra/oculta los tags de overflow (atributo nativo hidden, sin CSS)
                document.querySelectorAll('.more-tags-toggle[data-toggle-group="categorias"]').forEach(function (mt) {
                    mt.addEventListener('click', function () {
                        const expanded = mt.getAttribute('aria-expanded') === 'true';
                        document.querySelectorAll('.group-tags[data-group="categorias"] .tag[data-overflow="true"]')
                            .forEach(function (el) { el.hidden = expanded; });
                        mt.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                        mt.textContent = expanded ? 'Ver más' : 'Ver menos';
                    });
                });
            });
        })();
    </script>
}
