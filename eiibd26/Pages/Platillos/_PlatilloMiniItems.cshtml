@model IReadOnlyList<eiibd26.Pages.Platillos.PlatilloMiniVm>
@*
    Filas de "Platillos que lo incluyen" (sidebar de la vista de ingrediente). Espejo de
    _ExternosSimilares: MISMAS clases .ext-item, usado para el render inicial Y para la respuesta
    AJAX de "Ver más" (así la fila 6 se ve idéntica a la fila 1). Enlace INTERNO al detalle del
    platillo (misma pestaña); en vez del % de similitud, un ícono de platillo en el badge.
*@
@if (Model != null)
{
    foreach (var p in Model)
    {
        <a class="ext-item" href="/Platillos/@p.Slug" title="Ver @p.Nombre">
            <span class="ext-fav ext-fav--soft" aria-hidden="true"><i class="bi bi-egg-fried"></i></span>
            <span class="ext-body">
                <span class="ext-title">@p.Nombre</span>
                <span class="ext-meta">
                    <span class="ext-site">@p.Meta</span>
                    <i class="bi bi-chevron-right ext-out" aria-hidden="true"></i>
                </span>
            </span>
        </a>
    }
}
