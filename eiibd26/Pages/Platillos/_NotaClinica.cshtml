@model eiibd26.Services.Platillos.PlatNotaVisibleDto
@*
    Cuerpo de una nota clínica YA filtrada por el candado (el servicio solo entrega notas visibles).
    Render puro y SIN clases de caja: fluye como artículo dentro de .contenido-html (la tipografía
    —h3, p, ul— la pone el contenedor, misma escala que Contenidos/Detalle). Secciones en orden
    (párrafos y viñetas) + bloque "Referencias" con rel="noopener".
    Nota: el realce por callout de secciones "Importante"/"seguridad" se hará cuando el CRUD del
    médico (F2) marque un TIPO de sección; hoy los títulos del seed son inconsistentes y adivinar
    por texto sería frágil en contenido clínico.
*@
@foreach (var sec in Model.Secciones)
{
    @if (!string.IsNullOrWhiteSpace(sec.Titulo))
    {
        <h3>@sec.Titulo</h3>
    }
    @foreach (var bloque in sec.Bloques)
    {
        @if (bloque.EsLista)
        {
            <ul>
                @foreach (var li in bloque.Lineas)
                {
                    <li>@li</li>
                }
            </ul>
        }
        else
        {
            <p>@(bloque.Lineas.Count > 0 ? bloque.Lineas[0] : "")</p>
        }
    }
}

@if (Model.Referencias.Count > 0)
{
    @* Referencias como bloque secundario al pie de la nota (hairline + título muted), no como
       sección más del artículo. Los estilos .nota-refs* viven en detalle.css, scopeados a .nota-card. *@
    <div class="nota-refs">
        <div class="nota-refs__title">Referencias</div>
        <ul class="nota-refs__list">
            @foreach (var r in Model.Referencias)
            {
                <li>
                    @if (!string.IsNullOrWhiteSpace(r.Url))
                    {
                        <a href="@r.Url" target="_blank" rel="noopener">@r.Titulo</a>
                    }
                    else
                    {
                        @r.Titulo
                    }
                </li>
            }
        </ul>
    </div>
}
