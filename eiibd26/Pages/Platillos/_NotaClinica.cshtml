@model eiibd26.Services.Platillos.PlatNotaVisibleDto
@*
    Cuerpo de una nota clínica YA filtrada por el candado (el servicio solo entrega notas visibles).
    v4: se escanea tipo FAQ. Cada sección = una FILA (pregunta + respuesta), separada por hairline;
    NADA lleva estilo de caja (los estilos .nota-row* viven en detalle.css, scopeados a .nota-card).
    Última fila = Referencias en una línea. El realce por "Importante"/"seguridad" se hará cuando el
    CRUD del médico (F2) marque un TIPO de sección; adivinar por texto sería frágil en contenido clínico.
*@
@foreach (var sec in Model.Secciones)
{
    <div class="nota-row">
        @if (!string.IsNullOrWhiteSpace(sec.Titulo))
        {
            <p class="nota-row__q">@sec.Titulo</p>
        }
        <div class="nota-row__a">
            @foreach (var bloque in sec.Bloques)
            {
                @if (bloque.EsLista)
                {
                    <ul>
                        @foreach (var li in bloque.Lineas)
                        {
                            <li>@li</li>
                        }
                    </ul>
                }
                else
                {
                    <p>@(bloque.Lineas.Count > 0 ? bloque.Lineas[0] : "")</p>
                }
            }
        </div>
    </div>
}

@if (Model.Referencias.Count > 0)
{
    @* Referencias en UNA línea al pie ("Referencias · X · Y"), como última fila (no sección con viñetas). *@
    <div class="nota-row nota-refs">
        <span class="nota-refs__label">Referencias</span>
        @foreach (var r in Model.Referencias)
        {
            <span class="nota-refs__sep" aria-hidden="true">·</span>
            @if (!string.IsNullOrWhiteSpace(r.Url))
            {
                <a href="@r.Url" target="_blank" rel="noopener">@r.Titulo</a>
            }
            else
            {
                <span>@r.Titulo</span>
            }
        }
    </div>
}
