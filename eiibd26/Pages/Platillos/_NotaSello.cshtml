@model List<eiibd26.Services.Validacion.ValidacionPublicaDto>
@*
    Sello "Validado por Profesionales de la Salud" de UNA nota, en la COLUMNA PRINCIPAL, bajo su
    contenido — es lo que ve el PACIENTE (espejo del glosario: Termino.cshtml). La tarjeta de validar
    del médico va aparte, en el sidebar. Reusa las clases .validaciones-profesionales / .validacion-item
    de detalle.css (cero CSS nuevo). El partial se pinta SIEMPRE que haya nota — sin validaciones muestra
    el estado vacío con su leyenda, para no dejar al paciente sin saber en qué estado está lo que lee.
    El padre (Ingrediente.cshtml) ya lo invoca dentro de @if (…Nota != null), así que sin nota no sale nada.
*@
@{
    var hayValidacionProfesional = Model != null && Model.Any();

    @* Un solo encabezado "Validado por"; luego las filas. Las que tienen nombre aprobado se pintan
       como {Titulo} {Nombre} + especialidad.

       Las anónimas se parten en dos, para no perder lo único que aportan al paciente — el comentario:
       - CON comentario  → fila propia, igual que en el glosario (Termino.cshtml). UserDisplay ya viene
                           como "Profesional verificado", así que la regla de identidad no cambia:
                           el nombre real sigue saliendo solo con badge.
       - SIN comentario  → se resumen en UNA línea de conteo; una fila vacía por cada uno no aporta nada. *@
    var conNombre = hayValidacionProfesional ? Model!.Where(v => v.TieneNombre).ToList() : new();
    var anonimos  = hayValidacionProfesional ? Model!.Where(v => !v.TieneNombre).ToList() : new();
    var anonimosConComentario = anonimos.Where(v => !string.IsNullOrWhiteSpace(v.Comentario)).ToList();
    var anonimosSinComentario = anonimos.Count - anonimosConComentario.Count;
}

    <div class="validaciones-profesionales mt-3 mb-4">
        @* Sin validaciones el encabezado se neutraliza: sello verde solo para lo validado. *@
        <div class="validaciones-profesionales__header">
            <div class="validaciones-profesionales__header-icon@(hayValidacionProfesional ? "" : " validaciones-profesionales__header-icon--vacio")">
                <i class="bi @(hayValidacionProfesional ? "bi-patch-check-fill" : "bi-patch-check")"></i>
            </div>
            <h4 class="validaciones-profesionales__title">
                @(hayValidacionProfesional
                    ? "Validado por Profesionales de la Salud"
                    : "Validación de profesionales de la salud")
            </h4>
        </div>
        <div class="validaciones-profesionales__body">
            @* Estado vacío: informativo, nunca un sello. Mismo texto y mismo estilo que en
               Pages/Glosario/Termino.cshtml — se lee igual en los tres contextos. *@
            @if (!hayValidacionProfesional)
            {
                <p class="mb-0 small text-muted fst-italic">Este contenido aún no ha sido validado por profesionales de la salud.</p>
            }

            @foreach (var v in conNombre)
            {
                <div class="validacion-item">
                    @if (!string.IsNullOrWhiteSpace(v.AvatarUrl))
                    {
                        <img src="@v.AvatarUrl" alt="@v.UserDisplay" class="validacion-avatar"
                             loading="lazy" decoding="async"
                             onerror="this.onerror=null;this.src='/img/default-avatar.png';" />
                    }
                    else
                    {
                        <div class="validacion-avatar-placeholder"><i class="bi bi-person-fill"></i></div>
                    }
                    <div>
                        <div class="validacion-name">
                            @if (!string.IsNullOrWhiteSpace(v.Slug))
                            {
                                <a href="/medicos/@v.Slug" class="text-decoration-none">@v.UserDisplay</a>
                            }
                            else
                            {
                                @v.UserDisplay
                            }
                            <i class="bi bi-patch-check-fill validacion-check" aria-hidden="true"></i>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(v.Especialidad))
                        {
                            <span class="validacion-especialidad">@v.Especialidad</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(v.Comentario))
                        {
                            <p class="validacion-comment mb-0">"@v.Comentario"</p>
                        }
                        <span class="validacion-date">@v.CreadoEn.ToString("MMMM yyyy")</span>
                    </div>
                </div>
            }

            @* Anónimos CON comentario: fila propia, espejo del glosario. Avatar por defecto a propósito
               —no el real— para no delatar por la foto a quien no aparece con nombre. *@
            @foreach (var v in anonimosConComentario)
            {
                <div class="validacion-item">
                    <div class="validacion-avatar-placeholder"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <div class="validacion-name">
                            @v.UserDisplay
                            <i class="bi bi-patch-check-fill validacion-check" aria-hidden="true"></i>
                        </div>
                        <p class="validacion-comment mb-0">"@v.Comentario"</p>
                        <span class="validacion-date">@v.CreadoEn.ToString("MMMM yyyy")</span>
                    </div>
                </div>
            }

            @* Resumen único de los anónimos que no dejaron comentario. *@
            @if (anonimosSinComentario > 0)
            {
                <div class="validacion-item">
                    <div class="validacion-avatar-placeholder"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <div class="validacion-name">
                            @if (anonimosSinComentario == 1)
                            {
                                <text>Profesional verificado</text>
                            }
                            else
                            {
                                <text>@anonimosSinComentario profesionales verificados</text>
                            }
                            <i class="bi bi-patch-check-fill validacion-check" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
