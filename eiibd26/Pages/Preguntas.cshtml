@page
@model eiibd26.Pages.PreguntasModel
@{
    ViewData["Title"] = "Todas las Preguntas";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }
}
<style>
    .pr-container {
        max-width: 980px;
        margin: 28px auto;
        padding: 0 12px;
    }

    .pr-toolbar {
        margin-bottom: 12px;
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .pr-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(20,40,80,.06);
        padding: 16px;
        margin-bottom: 12px;
        position: relative;
        overflow: visible;
    }

    /* Main row: left content (title/body/meta) + right actions */
    .pr-main {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .pr-content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .pr-title {
        font-weight: 600;
        color: #16324a;
        font-size: 1.05rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
    }

    .pr-body {
        margin-top: 8px;
        color: #253443;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Row of avatars (author first, larger, then responders) aligned left */
    .avatars-row {
        margin-top: 10px;
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-start;
    }

    .avatar-author {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        flex: 0 0 auto;
    }

    .avatar-res {
        width: 27px;
        height: 27px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        flex: 0 0 auto;
    }

    /* Actions (score, responses count, view) pinned to right */
    .pr-actions {
        flex: 0 0 160px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
        justify-content: flex-start;
    }

    .pr-eye {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .pr-score {
        text-align: right;
    }

    .btn-voto {
        width: 38px;
        height: 38px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .vote-login-hint {
        font-size: 0.9rem;
        color: #495057;
        text-align: right;
    }

    @@media (max-width:760px) {
        .pr-main

    {
        flex-direction: column;
    }

    .pr-actions {
        flex-direction: row;
        width: 100%;
        justify-content: space-between;
        align-items: center;
    }

    .vote-login-hint {
        text-align: left;
    }

    }
</style>

<div class="pr-container">
    <h2>Todas las Preguntas</h2>

    <div class="pr-toolbar">
        <form method="get" id="searchForm" class="d-flex align-items-center gap-2">
            <input name="search" class="form-control search-input" placeholder="Buscar por título o contenido..." value="@Model.Search" />
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
            <a class="btn btn-outline-secondary" href="/Preguntas">Limpiar</a>
        </form>

        <form method="get" id="pageSizeForm" class="d-flex align-items-center gap-1">
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="page" value="1" />
            <select name="pageSize" class="form-select form-select-sm" onchange="document.getElementById('pageSizeForm').submit();">
                @{
                    var sizes = new[] { 6, 12, 24, 48 };
                }
                @foreach (var s in sizes)
                {
                    if (Model.PageSize == s)
                    {
                        <option value="@s" selected>@s</option>
                        ;
                    }
                    else
                    {
                        <option value="@s">@s</option>
                        ;
                    }
                }
            </select>
        </form>
    </div>

    <div>
        @if (!Model.Preguntas.Any())
        {
            <div class="alert alert-secondary">No se encontraron preguntas.</div>
        }
        else
        {
            foreach (var q in Model.Preguntas)
            {
                var authAttr = User.Identity.IsAuthenticated ? "true" : "false";
                var isMineAttr = q.EsMia ? "true" : "false";
                <div class="pr-card" data-id="@q.Id" data-authenticated="@authAttr" data-is-mine="@isMineAttr" data-user-vote="@q.UsuarioVoto" data-score="@q.Score">
                    <div class="pr-main">
                        <div class="pr-content">
                            <a href="/Preguntas/Detalles/@q.Id" class="pr-title">@q.Titulo</a>
                            @if (q.EsMia)
                            {
                                <form method="post" asp-page-handler="EliminarPregunta" class="d-inline" style="display:inline-block;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@q.Id" />
                                    <button class="btn-delete-inline" title="Eliminar pregunta" aria-label="Eliminar pregunta" type="submit" onclick="return confirm('¿Deseas eliminar esta pregunta? Esta acción no se puede deshacer.');">🗑</button>
                                </form>
                            }
                            <div class="pr-body">@Html.Raw(q.CuerpoPreview)</div>

                            <div class="avatars-row" aria-hidden="true">
                                @* Author avatar first (slightly larger) *@
                                <img class="avatar-author lazy-avatar"
                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                                     alt="@q.AutorNombre" width="36" height="36"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />

                                @* responders avatars (skip duplicates) *@
                                @{
                                    var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                                    if (!string.IsNullOrWhiteSpace(q.AutorAvatarUrl)) added.Add(q.AutorAvatarUrl);
                                    var rcnt = 0;
                                    foreach (var a in q.RespondersAvatars)
                                    {
                                        if (rcnt >= 6) break;
                                        if (string.IsNullOrWhiteSpace(a)) continue;
                                        if (added.Contains(a)) continue;
                                        added.Add(a);
                                        <img class="avatar-res lazy-avatar"
                                             src="@Url.Content("~/img/avatar-placeholder.png")"
                                             data-src="@ResolveAvatar(a)"
                                             alt="Responder" width="27" height="27"
                                             decoding="async"
                                             onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                        rcnt++;
                                    }
                                }
                            </div>
                        </div>

                        <div class="pr-actions">
                            <div class="pr-eye">
                                <a class="btn btn-sm btn-outline-secondary" href="/Preguntas/Detalles/@q.Id" title="Ver detalle" aria-label="Ver detalle">
                                    <span style="font-size:0.95rem;">👁</span>
                                </a>
                            </div>

                            <span class="badge bg-light text-dark">Respuestas: <strong>@q.RespuestasCount</strong></span>

                            <div class="vote-container">
                                @if (!User.Identity.IsAuthenticated)
                                {
                                    <div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Account/Login">Iniciar sesión</a></div>
                                }
                                else if (q.EsMia)
                                {
                                    <span class="text-muted small">No puedes votar tu propia pregunta</span>
                                }
                                else
                                {
                                    if (q.UsuarioVoto == 1)
                                    {
                                        <button class="btn btn-outline-danger btn-voto btn-voto-q" data-id="@q.Id" data-valor="-1" title="Quitar voto">-1</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success btn-voto btn-voto-q" data-id="@q.Id" data-valor="1" title="+1">+1</button>
                                    }
                                }
                            </div>

                            <div class="pr-score badge bg-light text-dark ms-2" id="score-@q.Id">Score: @q.Score</div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="pagination-block">
            @{
                var prev = Model.Page > 1 ? Model.Page - 1 : 1;
                var next = Model.Page < Model.TotalPages ? Model.Page + 1 : Model.TotalPages;
                var qsBase = $"?search={Uri.EscapeDataString(Model.Search ?? "")}&pageSize={Model.PageSize}";
            }
            <a class="btn btn-sm btn-outline-secondary" href="@($"{qsBase}&page={prev}")">Anterior</a>
            <span class="mx-2">Página <strong>@Model.Page</strong> de <strong>@Model.TotalPages</strong></span>
            <a class="btn btn-sm btn-outline-secondary" href="@($"{qsBase}&page={next}")">Siguiente</a>
        </div>

        <div>
            <small class="text-muted">@Model.TotalItems preguntas encontradas</small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (async function () {
            // init lazy avatars
            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const onLoad = img => img.classList.add('loaded');
                const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { onError(img); return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = function () { try { img.src = src; } catch {} onLoad(img); };
                    tmp.onerror = function () { onError(img); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                observer.unobserve(img);
                                loadImg(img);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => {
                        if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) {
                            io.observe(i);
                        } else if (i.getAttribute('data-src')) {
                            i.classList.add('loaded');
                        }
                    });
                } else {
                    imgs.forEach(i => loadImg(i));
                }
            }

            // delegated vote handling for questions (single-button UI)
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.btn-voto-q');
                if (!btn) return;
                e.preventDefault();

                const id = btn.getAttribute('data-id');
                const valor = parseInt(btn.getAttribute('data-valor') || "0", 10);
                if (!id || (valor !== 1 && valor !== -1)) return;

                btn.disabled = true;
                try {
                    const res = await fetch('/api/preguntas/' + id + '/votar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ valor: valor })
                    });

                    if (!res.ok) {
                        const txt = await res.text();
                        console.warn('Votar pregunta falló:', res.status, txt);
                        alert('Error al votar: ' + (txt || res.status));
                        return;
                    }

                    const j = await res.json();
                    const scoreEl = document.getElementById('score-' + id);
                    if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;

                    // update single control in the card
                    const card = document.querySelector('.pr-card[data-id="' + id + '"]');
                    if (!card) return;
                    const voteContainer = card.querySelector('.vote-container');
                    const authenticated = card.getAttribute('data-authenticated') === 'true';
                    const isMine = card.getAttribute('data-is-mine') === 'true';
                    const userVote = (j.userVote !== undefined) ? j.userVote : 0;

                    card.setAttribute('data-user-vote', String(userVote));
                    card.setAttribute('data-score', String(j.score ?? 0));

                    if (!authenticated) {
                        voteContainer.innerHTML = '<div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Account/Login">Iniciar sesión</a></div>';
                    } else if (isMine) {
                        voteContainer.innerHTML = '<span class="text-muted small">No puedes votar tu propia pregunta</span>';
                    } else {
                        if (userVote === 1) {
                            voteContainer.innerHTML = '<button class="btn btn-outline-danger btn-voto btn-voto-q" data-id="' + id + '" data-valor="-1" title="Quitar voto">-1</button>';
                        } else {
                            voteContainer.innerHTML = '<button class="btn btn-outline-success btn-voto btn-voto-q" data-id="' + id + '" data-valor="1" title="+1">+1</button>';
                        }
                    }
                } catch (err) {
                    console.error('Error votando pregunta', err);
                    alert('Error de red al votar');
                } finally {
                    btn.disabled = false;
                }
            });

            initLazyAvatars();
        })();
    </script>
}