@model eiibd26.Pages.PreguntasModel
@{
    ViewData["Title"] = "Preguntas";
    Layout = "_Layout";

    // Determine site root (map localhost to production domain for structured data)
    var siteRoot = (Request.Host.HasValue && Request.Host.Value.IndexOf("localhost", StringComparison.OrdinalIgnoreCase) >= 0)
        ? "https://eiibd.com"
        : $"{Request.Scheme}://{Request.Host.Value}";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        // Normaliza barras invertidas y espacios
        avatar = avatar.Replace("\\", "/").Trim();

        if (avatar.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return avatar;
        // Quita prefijos ~/ o / para construir Url.Content de forma consistente
        if (avatar.StartsWith("~/")) avatar = avatar.TrimStart('~', '/');
        if (avatar.StartsWith("/")) avatar = avatar.TrimStart('/');
        return Url.Content("~/" + avatar);
    }

    string HumanizeDate(DateTimeOffset dt)
    {
        var ts = DateTimeOffset.UtcNow - dt;
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays} {(ts.TotalDays < 2 ? "day" : "dia(s)")} antes";
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} {(ts.TotalHours < 2 ? "hour" : "hora(s)")} antes";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} {(ts.TotalMinutes < 2 ? "minute" : "minuto(s)")} antes";
        return "just now";
    }
}

@section Head {
    @{
        // Build ItemList JSON-LD for the questions listing
        var ldOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default };
        var elements = new System.Collections.Generic.List<object>();
        int pos = 1;
        if (Model.Preguntas != null && Model.Preguntas.Any())
        {
            foreach (var q in Model.Preguntas.Take(20))
            {
                try {
                    var qUrl = !string.IsNullOrWhiteSpace(q.Slug) ? (siteRoot.TrimEnd('/') + "/Preguntas/" + q.Slug) : (siteRoot.TrimEnd('/') + "/Preguntas/Detalles?id=" + q.Id);
                    elements.Add(new System.Collections.Generic.Dictionary<string, object> {
                        ["@type"] = "ListItem",
                        ["position"] = pos++,
                        ["url"] = qUrl,
                        ["name"] = q.Titulo ?? ""
                    });
                } catch { }
            }
        }
        else
        {
            // Fallback example entries so the schema is visible for testing
            elements.Add(new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["url"] = siteRoot.TrimEnd('/') + "/Preguntas/voy-a-estar-bien", ["name"] = "¿Voy a estar bien?" });
            elements.Add(new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["url"] = siteRoot.TrimEnd('/') + "/Preguntas/esto-me-define-ahora", ["name"] = "¿Esto me define ahora?" });
            elements.Add(new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["url"] = siteRoot.TrimEnd('/') + "/Preguntas/que-tengo-que-cambiar-en-mi-vida", ["name"] = "¿Qué tengo que cambiar en mi vida?" });
            pos = 4;
        }

        var listObj = new System.Collections.Generic.Dictionary<string, object> {
            ["@context"] = "https://schema.org",
            ["@type"] = "ItemList",
            ["name"] = "Preguntas y Respuestas sobre EII",
            ["description"] = "Comunidad de apoyo donde pacientes comparten dudas y experiencias sobre Crohn y Colitis Ulcerosa.",
            ["url"] = siteRoot.TrimEnd('/') + "/Preguntas",
            ["numberOfItems"] = Model.TotalItems > 0 ? Model.TotalItems : elements.Count,
            ["itemListElement"] = elements
        };

        var listJson = System.Text.Json.JsonSerializer.Serialize(listObj, ldOptions);
        // Canonical URL for this listing (avoid localhost in production)
        var canonicalUrl = siteRoot.TrimEnd('/') + "/Preguntas";
    }

    <link rel="canonical" href="@canonicalUrl" />
    <script type="application/ld+json">
        @Html.Raw(listJson)
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" />
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        /* ===== TABS DE ORDENAMIENTO ESTILO STACK OVERFLOW ===== */
        .sort-tabs-wrapper {
            margin: var(--space-lg) 0 var(--space-md) 0;
            border-bottom: 1px solid var(--color-border);
        }

        .sort-tabs {
            display: flex;
            gap: var(--space-xs);
            padding: 0;
            margin: 0;
        }

        .sort-tab {
            padding: var(--space-sm) var(--space-lg);
            font-size: var(--font-size-sm);
            font-weight: 600;
            color: var(--color-text-secondary);
            text-decoration: none;
            border: none;
            border-bottom: 3px solid transparent;
            background: transparent;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            cursor: pointer;
            font-family: var(--font-primary);
        }

        .sort-tab:hover {
            color: var(--color-primary);
            background: var(--color-bg-subtle);
            border-radius: 0.375rem 0.375rem 0 0;
        }

        .sort-tab.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-primary);
            font-weight: 700;
        }

        .sort-tab i {
            font-size: var(--font-size-md);
        }

        /* Responsive */
        @@media (max-width: 600px) {
            .sort-tabs {
                flex-direction: column;
                gap: var(--space-xs);
            }

            .sort-tab {
                padding: var(--space-sm) var(--space-md);
                border-bottom: none;
                border-left: 3px solid transparent;
                border-radius: 0.375rem;
            }

            .sort-tab.active {
                border-left-color: var(--color-primary);
                border-bottom-color: transparent;
                background: #f9fafb;
            }
        }
    </style>
}

<div class="container py-4">
    <h1 class="se-page-title">Preguntas y Respuestas sobre EII</h1>


    <div class="qp-wrapper-flex">
        <div style="width:100%">
            <div class="preguntas-main-buscador">
                <div class="se-header">
                    <label for="cpreguntaBuscar" class="se-search-label">
                        Haz tu mejor pregunta; entre más específico seas, mayor será la probabilidad de encontrar respuestas.
                    </label>
                    <form method="get" id="searchForm" class="se-search" role="search" aria-label="Buscar preguntas">
                        <input name="search"
                               aria-label="Buscar preguntas"
                               class="se-search-input"
                               placeholder="Ej: ¿Porque duele el lado izquierdo?"
                               value="@Model.Search" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <button class="se-btn se-btn-primary" type="submit" title="Buscar"><i class="bi bi-search"></i></button>
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <a class="se-btn se-btn-ghost"
                               href="@Url.Page(null, null, new { pageNumber = 1, pageSize = Model.PageSize, search = "" })"
                               title="Limpiar búsqueda">Limpiar</a>
                        }
                    </form>
                </div>
            </div>
            @* ===== TABS DE ORDENAMIENTO (ESTILO STACK OVERFLOW) ===== *@
            <div class="sort-tabs-wrapper">
                <div class="sort-tabs">
                    <a href="@Url.Page(null, new { orden = eiibd26.Pages.PreguntasModel.OrdenPreguntas.Activas, search = Model.Search, pageSize = Model.PageSize, pageNumber = 1 })" 
                       class="sort-tab @(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Activas ? "active" : "")"
                       aria-current="@(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Activas ? "page" : null)">
                        <i class="bi bi-activity"></i> Activas
                    </a>
                    <a href="@Url.Page(null, new { orden = eiibd26.Pages.PreguntasModel.OrdenPreguntas.Recientes, search = Model.Search, pageSize = Model.PageSize, pageNumber = 1 })" 
                       class="sort-tab @(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Recientes ? "active" : "")"
                       aria-current="@(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Recientes ? "page" : null)">
                        <i class="bi bi-clock"></i> Recientes
                    </a>
                    <a href="@Url.Page(null, new { orden = eiibd26.Pages.PreguntasModel.OrdenPreguntas.Votadas, search = Model.Search, pageSize = Model.PageSize, pageNumber = 1 })" 
                       class="sort-tab @(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Votadas ? "active" : "")"
                       aria-current="@(Model.Orden == eiibd26.Pages.PreguntasModel.OrdenPreguntas.Votadas ? "page" : null)">
                        <i class="bi bi-trophy"></i> Más votadas
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="preguntas-paginacion" aria-label="Paginación">
        @if (Model.TotalPages > 1)
        {
            int current = Model.PageNumber;
            int total = Model.TotalPages;
            int window = 2;
            var list = new List<int>();

            if (total <= 12)
            {
                list.AddRange(Enumerable.Range(1, total));
            }
            else
            {
                int start = Math.Max(1, current - window);
                int end = Math.Min(total, current + window);

                if (start > 1)
                {
                    list.Add(1);
                    if (start > 2) list.Add(-1);
                }
                list.AddRange(Enumerable.Range(start, end - start + 1));
                if (end < total)
                {
                    if (end < total - 1) list.Add(-1);
                    list.Add(total);
                }
            }

            string baseSearch = Model.Search ?? "";
            Func<int, string> pageUrl = p => Url.Page("/Preguntas", null, new { search = baseSearch, pageSize = Model.PageSize, pageNumber = p, orden = Model.Orden }, null) ?? "#";

            <div class="pag-bar">
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Primera página"
                   href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Página anterior"
                   href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>

                @foreach (var p in list)
                {
                    if (p == -1)
                    {
                        <span class="pag-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        var active = p == current ? "active" : "";
                        <a class="pag-num @active"
                           aria-label="Página @p"
                           aria-current="@(active == "active" ? "page" : null)"
                           href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                    }
                }

                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Página siguiente"
                   href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Última página"
                   href="@(current == total ? "#" : pageUrl(total))">»</a>

                <div class="pag-info">
                    <span>Total: @Model.TotalItems preguntas</span>
                    <span>Página @Model.PageNumber de @Model.TotalPages</span>
                    <form method="get" class="pag-size-inline" id="inlineSizeForm">
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="orden" value="@Model.Orden" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <label for="inlinePageSize">Tamaño</label>
                        <select id="inlinePageSize" name="pageSize" onchange="document.getElementById('inlineSizeForm').submit();">
                            @{
                                var sizes2 = new[] { 15, 50, 100 };
                            }
                            @foreach (var s in sizes2)
                            {
                                <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                            }
                        </select>
                    </form>

                </div>
            </div>
        }
    </div>

    @* ===== AVISO PASIVO (no autenticado) ===== *@
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="qp-wrapper-flex">
            <div class="vote-auth-notice" id="voteAuthNotice" role="note" aria-live="polite">
                <span class="vote-auth-notice__text">Participa votando y compartiendo experiencias.
                    <strong>Necesitas iniciar sesión para interactuar.</strong></span>
                <span class="vote-auth-notice__actions">
                    <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-auth-notice-login">Iniciar sesión</a>
                    <a href="/Identity/Account/Register" class="btn-auth-notice-register">Crear cuenta</a>
                </span>
            </div>
        </div>
    }

    @* ===== MODAL DE AUTENTICACIÓN ===== *@
    <div id="voteAuthModal" class="vote-auth-modal" role="dialog" aria-modal="true" aria-labelledby="voteAuthModalTitle" style="display:none;">
        <div class="vote-auth-modal__backdrop" id="voteAuthModalBackdrop"></div>
        <div class="vote-auth-modal__box">
            <button class="vote-auth-modal__close" id="voteAuthModalClose" aria-label="Cerrar">&times;</button>
            <div class="vote-auth-modal__icon">🔒</div>
            <h2 class="vote-auth-modal__title" id="voteAuthModalTitle">Inicia sesión para votar</h2>
            <p class="vote-auth-modal__desc">Tu voto se registrará automáticamente al iniciar sesión.</p>
            <div class="vote-auth-modal__btns">
                <a id="voteAuthModalLoginBtn" href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-modal-login">Iniciar sesión</a>
                <a href="/Identity/Account/Register?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-modal-register">Crear cuenta</a>
            </div>
        </div>
    </div>

    <div class="qp-wrapper-flex">
        @if (!Model.Preguntas.Any())
        {
            <div class="se-empty">No se encontraron preguntas.</div>
        }
        else
        {
            <div class="qp-main">

                <div class="se-list" id="preguntasList" role="list">
                    @{
                        var _visIdx = 0; // visual index used to eager-load first few avatars
                    }
                    @foreach (var q in Model.Preguntas)
                    {
                        var authAttr = User.Identity.IsAuthenticated ? "true" : "false";
                        var isMineAttr = q.EsMia ? "true" : "false";
                        // Lógica correcta: deshabilitar solo el botón usado, habilitar el opuesto
                        var disableUp = q.UsuarioVoto == 1;    // Deshabilitar upvote solo si ya votó upvote
                        var disableDown = (q.Score <= 0) || (q.UsuarioVoto == -1);  // Deshabilitar downvote si score=0 o ya votó downvote
                        var detailUrl = !string.IsNullOrWhiteSpace(q.Slug)
                            ? $"/Preguntas/{q.Slug}"
                            : $"/Preguntas/Detalles?id={q.Id}";
                        <article class="se-item"
                                 role="listitem"
                                 data-id="@q.Id"
                                 data-authenticated="@authAttr"
                                 data-is-mine="@isMineAttr"
                                 data-user-vote="@q.UsuarioVoto"
                                 data-score="@q.Score"
                                 data-detail-url="@detailUrl">
                            <div class="se-stats">
                                <div class="se-vote" aria-label="Votación">
                                    @if (!User.Identity.IsAuthenticated || q.EsMia)
                                    {
                                        <button class="se-vote-btn se-vote-up" type="button"
                                                data-id="@q.Id" data-dir="up"
                                                title="@(q.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"
                                                aria-label="Like"
                                                @(q.EsMia ? "disabled" : null)>
                                        </button>
                                        <div class="se-votes-count" id="score-@q.Id">@q.Score</div>
                                        <button class="se-vote-btn se-vote-down" type="button"
                                                data-id="@q.Id" data-dir="down"
                                                title="@(q.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"
                                                aria-label="Dislike"
                                                @(q.EsMia ? "disabled" : null)>
                                        </button>
                                    }
                                    else
                                    {
                                        var upActive = q.UsuarioVoto == 1 ? "active" : "";
                                        var downActive = q.UsuarioVoto == -1 ? "active" : "";
                                        <button class="se-vote-btn se-vote-up @upActive"
                                                data-id="@q.Id"
                                                data-dir="up"
                                                type="button"
                                                title="+1"
                                                aria-label="Like"
                                                @(disableUp ? "disabled" : null)>
                                        </button>
                                        <div class="se-votes-count" id="score-@q.Id">@q.Score</div>
                                        <button class="se-vote-btn se-vote-down @downActive"
                                                data-id="@q.Id"
                                                data-dir="down"
                                                type="button"
                                                title="-1"
                                                aria-label="Dislike"
                                                @(disableDown ? "disabled" : null)>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="se-summary">
                                <h2 class="se-title">
                                    @{
                                        var questionUrl = !string.IsNullOrWhiteSpace(q.Slug) 
                                            ? $"/Preguntas/{q.Slug}" 
                                            : $"/Preguntas/Detalles?id={q.Id}";
                                    }
                                    <a href="@questionUrl">@q.Titulo</a>
                                </h2>
                                <div class="se-excerpt">
                                    @q.CuerpoPreview
                                </div>

                                @if (q.Condiciones.Any() || q.Sintomas.Any() || q.Tratamientos.Any())
                                {
                                    <div class="se-relations">
                                        @if (q.Condiciones.Any())
                                        {
                                            <div class="se-rel-group">
                                                <span class="se-rel-label">Condiciones</span>
                                                <div class="se-rel-badges">
                                                    @foreach (var n in q.Condiciones)
                                                    {
                                                        <span class="se-rel-badge">@n</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (q.Sintomas.Any())
                                        {
                                            <div class="se-rel-group">
                                                <span class="se-rel-label">Síntomas</span>
                                                <div class="se-rel-badges">
                                                    @foreach (var n in q.Sintomas)
                                                    {
                                                        <span class="se-rel-badge">@n</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (q.Tratamientos.Any())
                                        {
                                            <div class="se-rel-group">
                                                <span class="se-rel-label">Tratamientos</span>
                                                <div class="se-rel-badges">
                                                    @foreach (var n in q.Tratamientos)
                                                    {
                                                        <span class="se-rel-badge">@n</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="se-meta">
                                    <div class="se-user">
                                        @{
                                            var perfilHref = !string.IsNullOrWhiteSpace(q.AutorSlug)
                                                ? Url.Page("/u/Index", new { slug = q.AutorSlug }) ?? ("/u/" + q.AutorSlug)
                                                : "/u/" + q.UsuarioId;
                                        }
                                        <a class="se-avatar-link" href="@perfilHref" aria-label="Perfil del autor">
                                            @if (_visIdx < 4)
                                            {
                                                <img class="se-avatar"
                                                     src="@ResolveAvatar(q.AutorAvatarUrl)"
                                                     alt="@q.AutorNombre" width="36" height="36"
                                                     decoding="async"
                                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                            }
                                            else
                                            {
                                                <img class="se-avatar lazy-avatar"
                                                     src="@Url.Content("~/uploads/avatar-placeholder.png")"
                                                     data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                                                     alt="@q.AutorNombre" width="36" height="36"
                                                     decoding="async" loading="lazy"
                                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                            }
                                        </a>
                                        @{
                                            _visIdx++;
                                        }
                                        <a class="se-user-name" href="@perfilHref" aria-label="Autor">@q.AutorNombre</a>
                                    </div>
                                    <div class="se-time">
                                        pregunto <time datetime="@q.FechaCreacion.ToString("o")">@HumanizeDate(q.FechaCreacion)</time>
                                    </div>
                                    @if (q.EsMia)
                                    {
                                        <a class="se-action-link se-action-edit"
                                           href="~/Identity/Usuario/UusuarioPreguntaDetalle?id=@q.Id"
                                           title="Editar pregunta">Editar</a>
                                    }
                                </div>

                                    <div class="se-answers-float @(q.RespuestasCount > 0 ? "answered" : "unanswered")"
                                     title="Respuestas totales">
                                    <span class="se-answers-float-count">@q.RespuestasCount</span>
                                    <span class="se-answers-float-label">Respuesta(s)</span>
                                    @if (q.RespuestasCount == 0)
                                    {
                                        <div class="se-answers-cta" style="font-size:.82rem;color:#0f172a;margin-top:6px;">Sé el primero en ayudar</div>
                                    }
                                    @if (q.RespondersAvatars?.Any() == true)
                                    {
                                        <div class="se-answers-responders">
                                            @foreach (var av in q.RespondersAvatars)
                                            {
                                                <img class="se-responder-avatar lazy-avatar"
                                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                                     data-src="@ResolveAvatar(av)"
                                                     alt="Responder"
                                                     width="10" height="10"
                                                     decoding="async" loading="lazy"
                                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @* Invitación post-voto inline (se muestra solo tras votar en esta sesión) *@
                            <div class="se-share-invite" id="se-share-invite-@q.Id" style="display:none;" role="status" aria-live="polite" data-pregunta-id="@q.Id" data-detail-url="@detailUrl">
                                <span class="se-share-invite__text">Muchas personas viven esto de forma distinta.
                                    <em>Si quieres, cuéntanos cómo fue tu experiencia.</em></span>
                                <button type="button" class="btn-share-experience se-share-invite__btn">Compartir experiencia</button>
                                <button type="button" class="btn-share-dismiss se-share-invite__close" aria-label="Cerrar">&times;</button>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </div>

    <div class="preguntas-paginacion" aria-label="Paginación">
        @if (Model.TotalPages > 1)
        {
            int current = Model.PageNumber;
            int total = Model.TotalPages;
            int window = 2;
            var list = new List<int>();

            if (total <= 12)
            {
                list.AddRange(Enumerable.Range(1, total));
            }
            else
            {
                int start = Math.Max(1, current - window);
                int end = Math.Min(total, current + window);

                if (start > 1)
                {
                    list.Add(1);
                    if (start > 2) list.Add(-1);
                }
                list.AddRange(Enumerable.Range(start, end - start + 1));
                if (end < total)
                {
                    if (end < total - 1) list.Add(-1);
                    list.Add(total);
                }
            }

            string baseSearch = Model.Search ?? "";
            Func<int, string> pageUrl = p => Url.Page("/Preguntas", null, new { search = baseSearch, pageSize = Model.PageSize, pageNumber = p, orden = Model.Orden }, null) ?? "#";

            <div class="pag-bar">
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Primera página"
                   href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Página anterior"
                   href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>

                @foreach (var p in list)
                {
                    if (p == -1)
                    {
                        <span class="pag-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        var active = p == current ? "active" : "";
                        <a class="pag-num @active"
                           aria-label="Página @p"
                           aria-current="@(active == "active" ? "page" : null)"
                           href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                    }
                }

                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Página siguiente"
                   href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Última página"
                   href="@(current == total ? "#" : pageUrl(total))">»</a>

                <div class="pag-info">
                    <span>Total: @Model.TotalItems registros</span>
                    <span>Página @Model.PageNumber de @Model.TotalPages</span>
                    <form method="get" class="pag-size-inline" id="inlineSizeForm">
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="orden" value="@Model.Orden" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <label for="inlinePageSize">Tamaño</label>
                        <select id="inlinePageSize" name="pageSize" onchange="document.getElementById('inlineSizeForm').submit();">
                            @{
                                var sizes2 = new[] { 15, 50, 100 };
                            }
                            @foreach (var s in sizes2)
                            {
                                <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                            }
                        </select>
                    </form>
                    
                </div>
            </div>
        }
    </div>
</div>

<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        (function () {
            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { img.src='@Url.Content("~/img/avatar-placeholder.png")'; return; }
                    const tmp = new Image();
                    tmp.decoding='async';
                    tmp.onload = () => { img.src = src; img.classList.add('loaded'); };
                    tmp.onerror= () => { img.src='@Url.Content("~/img/avatar-placeholder.png")'; img.classList.add('loaded'); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver(entries=>{
                        entries.forEach(e=>{
                            if(e.isIntersecting){
                                io.unobserve(e.target);
                                loadImg(e.target);
                            }
                        });
                    },{rootMargin:'200px 0px'});
                    imgs.forEach(i=>io.observe(i));
                } else {
                    imgs.forEach(loadImg);
                }
            }
            initLazyAvatars();

            const jumpBtn = document.getElementById('jumpBtn');
            const jumpInput = document.getElementById('jumpPage');
            if(jumpBtn && jumpInput){
                jumpBtn.addEventListener('click',()=>{
                    const v = parseInt(jumpInput.value,10);
                    const max = @Model.TotalPages;
                    if(!v || v<1) return;
                    const page = Math.min(v,max);
                    const url = "@Url.Page("/Preguntas", null, new { search = Model.Search, pageSize = Model.PageSize, pageNumber = "__PN__" }, null)".replace("__PN__", String(page));
                    window.location.href = url;
                });
                jumpInput.addEventListener('keydown',e=>{
                    if(e.key==='Enter'){
                        e.preventDefault();
                        jumpBtn.click();
                    }
                });
            }

            // ===== AUTH MODAL =====
            (function () {
                const modal    = document.getElementById('voteAuthModal');
                const backdrop = document.getElementById('voteAuthModalBackdrop');
                const closeBtn = document.getElementById('voteAuthModalClose');
                const loginBtn = document.getElementById('voteAuthModalLoginBtn');
                if (!modal) return;

                function openModal(preguntaId, dir) {
                    // Guardar contexto completo: volver a Index con scroll restaurado
                    const indexUrl = window.location.pathname + window.location.search;
                    const scrollY  = window.scrollY || window.pageYOffset;
                    sessionStorage.setItem('pendingVoteAction', JSON.stringify({
                        action: 'vote', preguntaId, voteType: dir,
                        returnUrl: indexUrl,
                        source: 'index',
                        scrollY: scrollY
                    }));
                    // ReturnUrl apunta de vuelta a Index (no a Detalles)
                    loginBtn.href = '/Identity/Account/Login?returnUrl=' + encodeURIComponent(indexUrl);
                    modal.style.display = 'flex';
                    closeBtn.focus();
                }

                function closeModal() { modal.style.display = 'none'; }

                closeBtn.addEventListener('click', closeModal);
                backdrop.addEventListener('click', closeModal);
                document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

                window._openVoteAuthModal = openModal;
            })();

            // ===== RESTORE VOTO PENDIENTE DESDE INDEX (post-login) =====
            (function () {
                const isAuth = @(User.Identity.IsAuthenticated ? "true" : "false");
                if (!isAuth) return;
                const raw = sessionStorage.getItem('pendingVoteAction');
                if (!raw) return;
                let pending;
                try { pending = JSON.parse(raw); } catch (e) { sessionStorage.removeItem('pendingVoteAction'); return; }
                if (!pending || pending.action !== 'vote' || pending.source !== 'index') return;
                sessionStorage.removeItem('pendingVoteAction');

                const preguntaId = String(pending.preguntaId);
                const dir        = pending.voteType;
                const scrollY    = pending.scrollY || 0;

                setTimeout(async function () {
                    // Restaurar scroll primero
                    window.scrollTo({ top: scrollY, behavior: 'instant' });

                    const article = document.querySelector('.se-item[data-id="' + preguntaId + '"]');
                    if (!article) return;

                    const upBtn   = article.querySelector('.se-vote-up');
                    const downBtn = article.querySelector('.se-vote-down');
                    if (upBtn)   upBtn.disabled   = true;
                    if (downBtn) downBtn.disabled = true;

                    const valor = dir === 'up' ? 1 : -1;

                    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    try {
                        const res = await fetch('/api/preguntas/' + preguntaId + '/votar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                            body: JSON.stringify({ valor })
                        });
                        if (!res.ok) {
                            if (upBtn)   upBtn.disabled   = false;
                            if (downBtn) downBtn.disabled = false;
                            return;
                        }
                        const j = await res.json();

                        const newScore    = j.score    !== undefined ? parseInt(j.score, 10)    : parseInt(article.getAttribute('data-score') || '0', 10);
                        const newUserVote = j.userVote !== undefined ? parseInt(j.userVote, 10) : 0;

                        const scoreEl = document.getElementById('score-' + preguntaId);
                        if (scoreEl) scoreEl.textContent = String(newScore);
                        article.setAttribute('data-score',     String(newScore));
                        article.setAttribute('data-user-vote', String(newUserVote));

                        if (upBtn)   { upBtn.classList.toggle('active',   newUserVote === 1);  upBtn.disabled   = newUserVote === 1; }
                        if (downBtn) { downBtn.classList.toggle('active', newUserVote === -1); downBtn.disabled = (newScore <= 0) || (newUserVote === -1); }

                        // Mostrar invitación inline y ajustar scroll para que sea visible
                        _showIndexShareInvitation(preguntaId);

                    } catch (err) {
                        console.error('[VoteRestore/Index]', err);
                        if (upBtn)   upBtn.disabled   = false;
                        if (downBtn) downBtn.disabled = false;
                    }
                }, 150);
            })();

            // ===== POST-VOTE SHARE INVITATION (inline por artículo) =====
            function _showIndexShareInvitation(preguntaId) {
                const invite = document.getElementById('se-share-invite-' + preguntaId);
                if (!invite) return;
                invite.style.display = 'flex';
                // Scroll suave al artículo para que la invitación sea visible
                const article = invite.closest('.se-item');
                if (article) {
                    setTimeout(() => article.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 80);
                }
            }

            // Delegación de eventos para botones de la invitación inline
            document.addEventListener('click', function (e) {
                // Botón "Compartir experiencia"
                const shareBtn = e.target.closest('.se-share-invite__btn');
                if (shareBtn) {
                    const invite = shareBtn.closest('.se-share-invite');
                    if (!invite) return;
                    const detailUrl = invite.getAttribute('data-detail-url') || '/Preguntas/Detalles?id=' + invite.getAttribute('data-pregunta-id');
                    invite.style.display = 'none';
                    // Ir a Detalles y hacer scroll+focus al textarea de respuesta
                    window.location.href = detailUrl + (detailUrl.includes('?') ? '&' : '?') + '_focusReply=1';
                    return;
                }
                // Botón "Cerrar"
                const dismissBtn = e.target.closest('.se-share-invite__close');
                if (dismissBtn) {
                    const invite = dismissBtn.closest('.se-share-invite');
                    if (invite) invite.style.display = 'none';
                    return;
                }
            });

            // Voting (sin cambios en lógica backend)
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.se-vote-btn');
                if (!btn) return;
                const article = btn.closest('.se-item');
                if (!article) return;

                const isAuth = article.getAttribute('data-authenticated') === 'true';
                const isMine = article.getAttribute('data-is-mine') === 'true';
                const id = article.getAttribute('data-id');
                if (!id) return;

                if (!isAuth) {
                    const dir = btn.getAttribute('data-dir');
                    if (window._openVoteAuthModal) window._openVoteAuthModal(id, dir);
                    return;
                }
                if (isMine) { alert('No puedes votar tu propia pregunta.'); return; }

                const dir = btn.getAttribute('data-dir');
                const currentScore = parseInt(article.getAttribute('data-score') || '0', 10);

                if (dir === 'down' && currentScore <= 0) { return; }

                const upBtn   = article.querySelector('.se-vote-up');
                const downBtn = article.querySelector('.se-vote-down');
                if (upBtn)   upBtn.disabled   = true;
                if (downBtn) downBtn.disabled = true;

                const valor = dir === 'up' ? 1 : -1;
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                try {
                    const res = await fetch('/api/preguntas/' + id + '/votar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                        body: JSON.stringify({ valor })
                    });
                    if (!res.ok) { alert('Error al votar'); return; }
                    const j = await res.json();

                    const newScore    = (j.score     !== undefined) ? parseInt(j.score, 10)    : currentScore;
                    const newUserVote = (j.userVote  !== undefined) ? parseInt(j.userVote, 10) : 0;

                    const scoreEl = document.getElementById('score-' + id);
                    if (scoreEl) scoreEl.textContent = String(newScore);
                    article.setAttribute('data-score',     String(newScore));
                    article.setAttribute('data-user-vote', String(newUserVote));

                    if (upBtn)   { upBtn.classList.toggle('active',   newUserVote === 1);  upBtn.disabled   = newUserVote === 1; }
                    if (downBtn) { downBtn.classList.toggle('active', newUserVote === -1); downBtn.disabled = (newScore <= 0) || (newUserVote === -1); }

                    // Mostrar invitación inline dentro del artículo
                    _showIndexShareInvitation(id);

                } catch (err) {
                    console.error(err);
                    alert('Error de red al votar');
                } finally {
                    const finalScore    = parseInt(article.getAttribute('data-score')     || '0', 10);
                    const finalUserVote = parseInt(article.getAttribute('data-user-vote') || '0', 10);
                    if (upBtn)   upBtn.disabled   = finalUserVote === 1;
                    if (downBtn) downBtn.disabled = (finalScore <= 0) || (finalUserVote === -1);
                }
            });
        })();
    </script>
}