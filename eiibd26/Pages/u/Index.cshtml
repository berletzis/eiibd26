            font-weight: 400;
            color: #000;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .perfil-section-title i {
                color: #764ba2;
            }

        /* Estados de ánimo grid */
        .perfil-estados-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 0.75rem;
        }

        .perfil-estado-item {
            padding: 0.75rem;
            background: #f9fafb;
            border-radius: 6px;
            border-left: 3px solid;
        }

        .perfil-estado-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }

            .perfil-estado-header img {
                width: 28px;
                height: 28px;
                flex-shrink: 0;
            }

            .perfil-estado-header span {
                font-size: 0.8rem;
                font-weight: 400;
            }

        .perfil-estado-texto {
            font-size: 0.8rem;
            font-weight: 400;
            color: #4b5563;
            font-style: italic;
            line-height: 1.4;
            margin-bottom: 0.4rem;
        }

        .perfil-estado-relaciones {
            margin-bottom: 0.5rem;
        }

        .perfil-estado-relacion {
            font-size: 0.75rem;
            font-weight: 400;
            color: #6b7280;
            line-height: 1.3;
            margin-bottom: 0.2rem;
        }

            .perfil-estado-relacion:last-child {
                margin-bottom: 0;
            }

            .perfil-estado-relacion strong {
                color: #374151;
                font-weight: 500;
            }

        .perfil-estado-fecha {
            font-size: 0.7rem;
            font-weight: 400;
            color: #9ca3af;
        }

        /* Viaje de Salud - Fila 1 (2 columnas) */
        .perfil-viaje-grid-row1 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        /* Viaje de Salud - Fila 2 (ancho completo) */
        .perfil-viaje-grid-row2 {
            display: grid;
            grid-template-columns: 1fr;
        }

        .perfil-viaje-card {
            background: #f9fafb;
            border-radius: 8px;
            padding: 1rem;
            border: 1px solid #e5e7eb;
        }

        .perfil-viaje-card-full {
            background: #f9fafb;
            border-radius: 8px;
            padding: 1rem;
            border: 1px solid #e5e7eb;
        }

        .perfil-viaje-card-title {
            font-size: 0.875rem;
            font-weight: 400;
            color: #000;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .perfil-viaje-card-title i {
                color: #764ba2;
            }

        .perfil-viaje-item {
            padding: 0.625rem;
            background: white;
            border-radius: 6px;
            margin-bottom: 0.5rem;
        }

            .perfil-viaje-item:last-child {
                margin-bottom: 0;
            }

        .perfil-viaje-nombre {
            font-weight: 400;
            color: #1f2937;
            font-size: 0.875rem;
            margin-bottom: 0.15rem;
        }

        .perfil-viaje-fecha {
            font-size: 0.75rem;
            font-weight: 400;
            color: #9ca3af;
        }

        /* Grid para tracking de síntomas */
        .perfil-tracking-sintomas-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 0.75rem;
        }

        .perfil-tracking-item {
            background: white;
            border-radius: 6px;
            padding: 0.75rem;
            border-left: 3px solid;
        }

        .perfil-tracking-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

            .perfil-tracking-header i {
                font-size: 1.1rem;
            }

        .perfil-tracking-sintoma {
            font-weight: 500;
            font-size: 0.85rem;
            color: #1f2937;
            line-height: 1.2;
        }

        .perfil-tracking-estado {
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .perfil-tracking-fecha {
            font-size: 0.7rem;
            color: #9ca3af;
            font-weight: 400;
        }

        .perfil-tracking-meta {
            font-size: 0.7rem;
            margin-bottom: 0.2rem;
        }

        .perfil-sintoma-grupo-header {
            font-size: 0.875rem;
            color: #374151;
            padding: 0.25rem 0;
            border-bottom: 1px solid #f3f4f6;
        }

        /* Tarjetas de resumen estadístico */
        .perfil-resumen-stat {
            background: white;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            border: 1px solid #e5e7eb;
            text-align: center;
        }

        .perfil-resumen-stat-label {
            font-size: 0.7rem;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.25rem;
        }

        .perfil-resumen-stat-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1f2937;
        }

        .perfil-resumen-stat-sub {
            font-size: 0.7rem;
            color: #9ca3af;
        }

        .perfil-no-data {
            text-align: center;
            padding: 1.5rem 1rem;
            color: #9ca3af;
            font-size: 0.85rem;
            font-weight: 400;
        }

        .perfil-no-encontrado {
            max-width: 500px;
            margin: 4rem auto;
            padding: 3rem 2rem;
            text-align: center;
            background: white;
            border-radius: 8px;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.08);
        }

            .perfil-no-encontrado h2 {
                font-size: 1.5rem;
                font-weight: 400;
                color: #1f2937;
                margin-bottom: 1rem;
            }

            .perfil-no-encontrado p {
                font-weight: 400;
                color: #6b7280;
                margin-bottom: 1.5rem;
            }

        /* Responsive */
        @@media (max-width: 1200px) {
            .perfil-estados-grid {
                grid-template-columns: repeat(4, 1fr);
            }

            .perfil-tracking-sintomas-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .perfil-estados-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .perfil-tracking-sintomas-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .perfil-info-layout {
                flex-direction: column;
            }

            .perfil-info-sidebar {
                width: 100%;
            }

            .perfil-banner {
                height: 80px;
                font-size: 0.8rem;
            }

            .perfil-header-content {
                margin-top: -50px;
                padding: 0 1rem 1rem;
            }

            .perfil-avatar,
            .perfil-avatar-placeholder {
                width: 100px;
                height: 100px;
            }

            .perfil-avatar-placeholder {
                font-size: 2.5rem;
            }

            .perfil-nombre {
                font-size: 1.3rem;
            }

            .perfil-estados-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .perfil-viaje-grid-row1 {
                grid-template-columns: 1fr;
            }

            .perfil-tracking-sintomas-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .perfil-estados-grid {
                grid-template-columns: 1fr;
            }

            .perfil-tracking-sintomas-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="perfil-publico-container">
    @if (Model.PerfilIncompleto)
    {
        <div class="perfil-section">
            <h2 class="perfil-section-title"><i class="bi bi-person-x-fill"></i> Perfil incompleto</h2>
            <p>Este usuario no ha completado su perfil público, por lo que no es posible conocer más detalles. Si deseas, puedes intentarlo más tarde.</p>
        </div>
    }
    else if (Model.PerfilPublico != null)
    {
        <div class="perfil-header">
            <div class="perfil-banner">
                <div class="perfil-banner-fecha">
                    Miembro desde @Model.PerfilPublico.FechaRegistro.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                </div>
            </div>

            <div class="perfil-header-content">
                @* ✅ ACTUALIZADO: Avatar con fallback *@
                @if (!string.IsNullOrWhiteSpace(Model.PerfilPublico.Avatar))
                {
                    <img src="@Model.PerfilPublico.Avatar"
                         alt="Avatar de @Model.PerfilPublico.NombreCompleto"
                         class="perfil-avatar"
                         onerror="this.onerror=null; this.src='/img/default-avatar.png';" />
                }
                else
                {
                    <div class="perfil-avatar-placeholder">
                        <i class="bi bi-person-circle"></i>
                    </div>
                }

                <div class="perfil-info-layout">
                    <div class="perfil-info-principal">
                        <h1 class="perfil-nombre">@Model.PerfilPublico.NombreCompleto</h1>
                        <div class="perfil-slug">@("@" + Model.PerfilPublico.Slug)</div>

                        @if (!string.IsNullOrWhiteSpace(Model.PerfilPublico.EstoyAquiTexto))
                        {
                            <div class="perfil-estoy-aqui">
                                @Model.PerfilPublico.EstoyAquiTexto
                            </div>
                        }

                        @if (Model.PerfilPublico.Condiciones.Any())
                        {
                            var primeraCondicion = Model.PerfilPublico.Condiciones.First();
                            var tiempoConCondicion = eiibd26.Helpers.DateCalculationHelper
                                .FormatearDuracion(primeraCondicion.FechaInicio);

                            <div style="display:flex; flex-direction:column; align-items:flex-start; gap:0.25rem;">
                                <div style="display:flex; align-items:center; width:100%; max-width:560px; gap:0.5rem;">
                                    <div class="perfil-condicion-badge">
                                        <i class="bi bi-heart-pulse-fill"></i>
                                        <span>@primeraCondicion.Nombre@(!string.IsNullOrEmpty(tiempoConCondicion) ? $" · {tiempoConCondicion}" : "")</span>
                                    </div>
                                </div>

                                    
                                    @if (primeraCondicion.EdadDiagnostico.HasValue)
                                    {
                                <div class="perfil-leyenda-diagnostico" style="width:100%; max-width:560px; display:flex; justify-content:space-between; align-items:center;">
                                        <span class="perfil-leyenda-edad">Al momento de ser Diagnosticado @primeraCondicion.EdadDiagnostico años</span>
                                </div>
                                    }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.PerfilPublico.AcercaDe))
                        {
                            <div class="perfil-acerca">
                                @Model.PerfilPublico.AcercaDe
                            </div>
                        }
                    </div>

                    <div class="perfil-info-sidebar">
                        @if (!string.IsNullOrWhiteSpace(Model.PerfilPublico.GeneroTexto))
                        {
                            <div class="perfil-ficha-item">
                                <i class="bi bi-gender-ambiguous"></i>
                                <span>@Model.PerfilPublico.GeneroTexto</span>
                            </div>
                        }

                        @if (Model.PerfilPublico.EdadAproximada.HasValue)
                        {
                            <div class="perfil-ficha-item">
                                <i class="bi bi-calendar-event"></i>
                                <span>@Model.PerfilPublico.EdadAproximada años</span>
                            </div>
                        }

                        @if (Model.PerfilPublico.MostrarUbicacion && !string.IsNullOrWhiteSpace(Model.PerfilPublico.UbicacionTexto))
                        {
                            <div class="perfil-ficha-item">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@Model.PerfilPublico.UbicacionTexto</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.PerfilPublico.MostrarDatosMedicos)
        {
            <div class="perfil-section">
                <p class="perfil-no-data">
                    <i class="bi bi-lock-fill me-1"></i>
                    Este usuario ha preferido mantener su información médica en privado.
                </p>
            </div>
        }

        @if (Model.PerfilPublico.EstadosAnimo.Any())
        {
            <div class="perfil-section">
                <h2 class="perfil-section-title">
                    <i class="bi bi-emoji-smile-fill"></i> Cómo me he sentido (últimos 10 registros)
                </h2>
                <div class="perfil-estados-grid">
                    @foreach (var estado in Model.PerfilPublico.EstadosAnimo)
                    {
                        <div class="perfil-estado-item" style="border-left-color: @estado.ColorEstado">
                            <div class="perfil-estado-header">
                                <img src="@estado.ImagenEstado"
                                     alt="@estado.TextoEstado" />
                                <span style="color: @estado.ColorEstado">@estado.TextoEstado</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(estado.Texto))
                            {
                                <div class="perfil-estado-texto">
                                    "@estado.Texto"
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(estado.CondicionNombre) ||
                                                             !string.IsNullOrWhiteSpace(estado.SintomaNombre) ||
                                                             !string.IsNullOrWhiteSpace(estado.TratamientoNombre))
                            {
                                <div class="perfil-estado-relaciones">
                                    @if (!string.IsNullOrWhiteSpace(estado.CondicionNombre))
                                    {
                                        <div class="perfil-estado-relacion">
                                            <strong>Condición:</strong> @estado.CondicionNombre
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(estado.SintomaNombre))
                                    {
                                        <div class="perfil-estado-relacion">
                                            <strong>Síntoma:</strong> @estado.SintomaNombre
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(estado.TratamientoNombre))
                                    {
                                        <div class="perfil-estado-relacion">
                                            <strong>Tratamiento:</strong> @estado.TratamientoNombre
                                        </div>
                                    }
                                </div>
                            }

                            <div class="perfil-estado-fecha">
                                @estado.FechaRegistro.ToString("dd MMM yyyy · HH:mm", new System.Globalization.CultureInfo("es-ES"))
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.PerfilPublico.Condiciones.Any() ||
                     Model.PerfilPublico.Tratamientos.Any() ||
                     Model.PerfilPublico.SintomasAgrupados.Any() ||
                     Model.PerfilPublico.EstadosAnimo.Any())
        {
            <div class="perfil-section">
                <h2 class="perfil-section-title">
                    <i class="bi bi-clipboard2-pulse-fill"></i> Mi Viaje de Salud
                </h2>
                <p class="perfil-section-periodo text-muted small mb-3">
                    Período: @Model.PerfilPublico.Desde.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES")) — @Model.PerfilPublico.Hasta.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                </p>

                @* FILA 1: Condiciones y Tratamientos (2 columnas) *@
                @if (Model.PerfilPublico.Condiciones.Any() || Model.PerfilPublico.Tratamientos.Any())
                {
                    <div class="perfil-viaje-grid-row1">
                        @if (Model.PerfilPublico.Condiciones.Any())
                        {
                            <div class="perfil-viaje-card">
                                <div class="perfil-viaje-card-title">
                                    <i class="bi bi-heart-pulse-fill"></i> Condiciones
                                </div>
                                @foreach (var condicion in Model.PerfilPublico.Condiciones)
                                {
                                    <div class="perfil-viaje-item">
                                        <div class="perfil-viaje-nombre">@condicion.Nombre</div>
                                        @if (condicion.FechaInicio.HasValue)
                                        {
                                            <div class="perfil-viaje-fecha">
                                                Desde @condicion.FechaInicio.Value.ToString("MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (Model.PerfilPublico.Tratamientos.Any())
                        {
                            <div class="perfil-viaje-card">
                                <div class="perfil-viaje-card-title">
                                    <i class="bi bi-capsule-pill"></i> Tratamientos
                                </div>
                                @foreach (var tratamiento in Model.PerfilPublico.Tratamientos)
                                {
                                    <div class="perfil-viaje-item">
                                        <div class="perfil-viaje-nombre">@tratamiento.Nombre</div>
                                        @if (tratamiento.FechaInicio.HasValue)
                                        {
                                            <div class="perfil-viaje-fecha">
                                                Desde @tratamiento.FechaInicio.Value.ToString("MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                            </div>
                                        }
                                        @if (tratamiento.FechaFin.HasValue)
                                        {
                                            <div class="perfil-viaje-fecha">
                                                Fin: @tratamiento.FechaFin.Value.ToString("MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* FILA 2: Síntomas agrupados con historial de tracking *@
                @if (Model.PerfilPublico.SintomasAgrupados.Any())
                {
                    <div class="perfil-viaje-grid-row2">
                        <div class="perfil-viaje-card-full">
                            <div class="perfil-viaje-card-title">
                                <i class="bi bi-thermometer-half"></i> Historial de Síntomas
                            </div>
                            @foreach (var sintoma in Model.PerfilPublico.SintomasAgrupados)
                            {
                                <div class="perfil-sintoma-grupo mb-3">
                                    <div class="perfil-sintoma-grupo-header d-flex align-items-center gap-2 fw-semibold mb-1">
                                        <i class="bi bi-activity"></i>
                                        <span>@sintoma.NombreSintoma</span>
                                        @if (sintoma.Tratamientos.Any())
                                        {
                                            <span class="ms-2 text-muted small">
                                                <i class="bi bi-capsule-pill"></i>
                                                @string.Join(", ", sintoma.Tratamientos)
                                            </span>
                                        }
                                    </div>
                                    <div class="perfil-tracking-sintomas-grid">
                                        @foreach (var tracking in sintoma.Trackings)
                                        {
                                            <div class="perfil-tracking-item" style="border-left-color: @tracking.ColorEstado">
                                                <div class="perfil-tracking-header">
                                                    <i class="bi @tracking.IconoEstado" style="color: @tracking.ColorEstado"></i>
                                                    <span class="perfil-tracking-estado" style="color: @tracking.ColorEstado">@tracking.Estado</span>
                                                </div>
                                                @if (tracking.Dolor.HasValue)
                                                {
                                                    <div class="perfil-tracking-meta small text-muted">
                                                        <i class="bi bi-bandaid"></i> Dolor: <strong>@tracking.Dolor/10</strong>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(tracking.FrecuenciaNombre))
                                                {
                                                    <div class="perfil-tracking-meta small text-muted">
                                                        <i class="bi bi-arrow-repeat"></i> @tracking.FrecuenciaNombre
                                                    </div>
                                                }
                                                @if (tracking.TieneSangrado == true)
                                                {
                                                    <div class="perfil-tracking-meta small" style="color:#ef4444">
                                                        <i class="bi bi-droplet-fill"></i> Sangrado
                                                    </div>
                                                }
                                                <div class="perfil-tracking-fecha">
                                                    @tracking.Fecha.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* FILA 3: Resumen estadístico e insights (equivalente al bloque inicial del PDF) *@
                @if (Model.PerfilPublico.HealthResumen != null && Model.PerfilPublico.HealthResumen.TieneInsights)
                {
                    var r = Model.PerfilPublico.HealthResumen;
                    <div class="perfil-viaje-grid-row2 mt-3">
                        <div class="perfil-viaje-card-full">
                            <div class="perfil-viaje-card-title">
                                <i class="bi bi-bar-chart-line-fill"></i> Resumen del Período
                            </div>
                            <div class="row g-3 mb-3">
                                @if (r.MoodTotalRegistros > 0)
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="perfil-resumen-stat">
                                            <div class="perfil-resumen-stat-label">Estado de ánimo</div>
                                            <div class="perfil-resumen-stat-value">@r.MoodPromedio</div>
                                            <div class="perfil-resumen-stat-sub">@r.MoodTotalRegistros registros</div>
                                        </div>
                                    </div>
                                }
                                @if (r.TendenciaTotalRegistros > 0)
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="perfil-resumen-stat">
                                            <div class="perfil-resumen-stat-label">Tendencia síntomas</div>
                                            <div class="perfil-resumen-stat-value">@r.TendenciaGeneral</div>
                                            <div class="perfil-resumen-stat-sub">@r.TendenciaTotalRegistros registros</div>
                                        </div>
                                    </div>
                                }
                                @if (r.PromedioDolorGlobal.HasValue)
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="perfil-resumen-stat">
                                            <div class="perfil-resumen-stat-label">Dolor promedio</div>
                                            <div class="perfil-resumen-stat-value">@r.PromedioDolorGlobal.Value.ToString("0.#")/10</div>
                                        </div>
                                    </div>
                                }
                                @if (r.RegistrosDolorAlto > 0)
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="perfil-resumen-stat" style="border-color:#ef4444">
                                            <div class="perfil-resumen-stat-label">Episodios dolor alto</div>
                                            <div class="perfil-resumen-stat-value" style="color:#ef4444">@r.RegistrosDolorAlto</div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.SintomaFrecuente) || !string.IsNullOrWhiteSpace(r.SintomaConMayorDolor))
                            {
                                <div class="perfil-viaje-card-title mt-2">
                                    <i class="bi bi-lightbulb-fill"></i> Insights
                                </div>
                                <ul class="list-unstyled small mb-0">
                                    @if (!string.IsNullOrWhiteSpace(r.SintomaFrecuente))
                                    {
                                        <li><i class="bi bi-arrow-right-short"></i> Síntoma más frecuente: <strong>@r.SintomaFrecuente</strong> (@r.SintomaFrecuenteConteo registros)</li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.SintomaConMayorDolor))
                                    {
                                        <li><i class="bi bi-arrow-right-short"></i> Mayor dolor en: <strong>@r.SintomaConMayorDolor</strong> (promedio @r.PromedioDolorMax?.ToString("0.#")/10)</li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.SintomaMayorFrecuencia) && !string.IsNullOrWhiteSpace(r.SintomaMayorFrecuenciaNombre))
                                    {
                                        <li><i class="bi bi-arrow-right-short"></i> Mayor frecuencia: <strong>@r.SintomaMayorFrecuencia</strong> — @r.SintomaMayorFrecuenciaNombre</li>
                                    }
                                    @if (r.TendenciaPorSintoma.Any())
                                    {
                                        foreach (var (sintomaNombre, tendencia) in r.TendenciaPorSintoma)
                                        {
                                            <li><i class="bi bi-arrow-right-short"></i> <strong>@sintomaNombre</strong>: @tendencia</li>
                                        }
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="perfil-no-encontrado">
            <i class="bi bi-person-x" style="font-size: 3rem; color: #d1d5db; margin-bottom: 1rem;"></i>
            <h2>Perfil no encontrado</h2>
            <p>No pudimos encontrar el perfil que buscas.</p>
            <a href="/" class="btn btn-primary">Volver al inicio</a>
        </div>
    }
</div>