@page
@model eiibd26.Pages.Glosario.SintomasModel
@{
    ViewData["Title"] = "Síntomas - Glosario Médico";
    ViewData["Description"] = "Índice alfabético de síntomas relacionados con la Enfermedad Inflamatoria Intestinal.";
}

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/Glosario">Glosario</a></li>
                    <li class="breadcrumb-item active">Síntomas</li>
                </ol>
            </nav>
            
            <h1 class="display-5 fw-bold text-primary">
                <i class="bi bi-heart-pulse"></i> Síntomas
            </h1>
            <p class="lead text-muted">
                @Model.Terminos.Count síntomas en el glosario
            </p>
        </div>
    </div>

    @if (Model.Terminos.Any())
    {
        <!-- Navegación alfabética -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    @foreach (var letra in Model.LetrasDisponibles)
                    {
                        <a href="#letra-@letra" class="btn btn-outline-primary btn-sm">
                            @letra
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Lista agrupada por letra -->
        @foreach (var grupo in Model.TerminosAgrupados)
        {
            <div class="mb-5" id="letra-@grupo.Key">
                <h2 class="border-bottom pb-2 mb-3 text-primary">
                    @grupo.Key
                </h2>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var termino in grupo)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm hover-card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a href="/Termino/@termino.Slug" class="text-decoration-none text-dark">
                                            @termino.Nombre
                                        </a>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No hay síntomas disponibles en este momento.
        </div>
    }

    <!-- Botón volver -->
    <div class="row mt-5">
        <div class="col text-center">
            <a href="/Glosario" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Glosario
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hover-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .hover-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
        .btn-outline-primary.active {
            background-color: var(--bs-primary);
            color: white;
        }
    </style>
}

@section Scripts {
    <script>
        // Smooth scroll para navegación alfabética
        document.querySelectorAll('a[href^="#letra-"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
}
