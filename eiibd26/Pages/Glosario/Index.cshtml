@page
@model eiibd26.Pages.Glosario.IndexModel
@{
    ViewData["Title"] = "Glosario Médico";
    ViewData["Description"] = "Explora nuestro glosario médico con síntomas y tratamientos explicados en lenguaje sencillo.";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">
                Guía de síntomas y tratamientos
            </h1>
            <p class="lead text-muted">
                Encuentra definiciones claras de síntomas y tratamientos relacionados con la Enfermedad Inflamatoria Intestinal.
            </p>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-heart-pulse display-1 text-primary"></i>
                    <h3 class="mt-3">@Model.Home.TotalSintomas</h3>
                    <p class="text-muted mb-0">Síntomas</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-prescription2 display-1 text-success"></i>
                    <h3 class="mt-3">@Model.Home.TotalTratamientos</h3>
                    <p class="text-muted mb-0">Tratamientos</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Top lists: Síntomas y Tratamientos -->
    <!-- Duplicate se-card top-lists block removed. Only Contenidos-style block remains below. -->
    <!-- Top lists: Síntomas y Tratamientos (Contenidos style) -->
    <div class="conte-page">
        <div class="se-header">
            <div class="se-page-title">Guía de síntomas y tratamientos</div>
            <p class="text-muted">Contenido validado y revisado por profesionales. Explora los términos más confiables.</p>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <h3 class="se-card-title">Síntomas (Top 20)</h3>
                @if (Model.TopSymptoms != null && Model.TopSymptoms.Any())
                {
                    <div class="items-container">
                        @foreach (var item in Model.TopSymptoms)
                        {
                            <div class="blog-card">
                                <div class="content d-flex align-items-center justify-content-between">
                                    <div class="flex-fill me-3">
                                        <a href="/Termino/@item.Slug" class="text-decoration-none text-dark">
                                            <div class="blog-title">@item.Nombre</div>
                                            @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                                            {
                                                <div class="text-muted small">@item.ShortDescription</div>
                                            }
                                        </a>
                                    </div>
                                    <div class="relation-badges d-flex align-items-center">
                                        <span class="relation-badge relation-badge--direct" title="Directa" aria-label="Directa: @item.RelationDirectCount">@item.RelationDirectCount</span>
                                        <span class="relation-badge relation-badge--indirect" title="Indirecta" aria-label="Indirecta: @item.RelationIndirectCount">@item.RelationIndirectCount</span>
                                        <span class="relation-badge relation-badge--secondary" title="Secundaria" aria-label="Secundaria: @item.RelationSecondaryCount">@item.RelationSecondaryCount</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No hay síntomas validados para mostrar.</p>
                }
                <div class="mt-3 text-end">
                    <a href="/Glosario/Sintomas" class="btn btn-outline-primary btn-sm">Ver todos →</a>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <h3 class="se-card-title">Tratamientos (Top 20)</h3>
                @if (Model.TopTreatments != null && Model.TopTreatments.Any())
                {
                    <div class="items-container">
                        @foreach (var item in Model.TopTreatments)
                        {
                            <div class="blog-card">
                                <div class="content d-flex align-items-center justify-content-between">
                                    <div class="flex-fill me-3">
                                        <a href="/Termino/@item.Slug" class="text-decoration-none text-dark">
                                            <div class="blog-title">@item.Nombre</div>
                                            @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                                            {
                                                <div class="text-muted small">@item.ShortDescription</div>
                                            }
                                        </a>
                                    </div>
                                    <div class="relation-badges d-flex align-items-center">
                                        <span class="relation-badge relation-badge--direct" title="Directa" aria-label="Directa: @item.RelationDirectCount">@item.RelationDirectCount</span>
                                        <span class="relation-badge relation-badge--indirect" title="Indirecta" aria-label="Indirecta: @item.RelationIndirectCount">@item.RelationIndirectCount</span>
                                        <span class="relation-badge relation-badge--secondary" title="Secundaria" aria-label="Secundaria: @item.RelationSecondaryCount">@item.RelationSecondaryCount</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No hay tratamientos validados para mostrar.</p>
                }
                <div class="mt-3 text-end">
                    <a href="/Glosario/Tratamientos" class="btn btn-outline-success btn-sm">Ver todos →</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        .hover-lift {
            transition: transform 0.2s ease-in-out;
        }
        .hover-lift:hover {
            transform: translateY(-5px);
        }
        /* Relation badges */
        .relation-badges { gap: 8px; }
        .relation-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 600;
            margin-left: 6px;
        }
        .relation-badge--direct { background: #16a34a; } /* green */
        .relation-badge--indirect { background: #eab308; } /* yellow */
        .relation-badge--secondary { background: #2563eb; } /* blue */
        /* Ensure the badges stay on one line and not wrap the item title */
        .se-card .list-unstyled li { white-space: nowrap; }
        .se-card .list-unstyled li .me-3 { overflow: hidden; text-overflow: ellipsis; }
    </style>
}
