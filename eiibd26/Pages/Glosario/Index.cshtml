@page
@model eiibd26.Pages.Glosario.IndexModel
@{
    ViewData["Title"] = "Glosario Médico";
    ViewData["Description"] = "Explora nuestro glosario médico con síntomas y tratamientos explicados en lenguaje sencillo.";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">
                <i class="bi bi-book"></i> Glosario Médico
            </h1>
            <p class="lead text-muted">
                Encuentra definiciones claras de síntomas y tratamientos relacionados con la Enfermedad Inflamatoria Intestinal.
            </p>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-heart-pulse display-1 text-primary"></i>
                    <h3 class="mt-3">@Model.Home.TotalSintomas</h3>
                    <p class="text-muted mb-0">Síntomas</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-prescription2 display-1 text-success"></i>
                    <h3 class="mt-3">@Model.Home.TotalTratamientos</h3>
                    <p class="text-muted mb-0">Tratamientos</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-heart-pulse fs-1 text-primary me-3"></i>
                        <h3 class="mb-0">Síntomas</h3>
                    </div>
                    <p class="text-muted mb-4">
                        Consulta síntomas comunes y cómo pueden sentirse las personas que viven con EII.
                    </p>
                    <a href="/Glosario/Sintomas" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-arrow-right-circle"></i> Ver todos los síntomas
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm hover-lift">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-prescription2 fs-1 text-success me-3"></i>
                        <h3 class="mb-0">Tratamientos</h3>
                    </div>
                    <p class="text-muted mb-4">
                        Descubre opciones de tratamiento explicadas en lenguaje sencillo.
                    </p>
                    <a href="/Glosario/Tratamientos" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-arrow-right-circle"></i> Ver todos los tratamientos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Buscador (opcional - fase futura) -->
    <div class="row mt-5">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="mb-3">
                        <i class="bi bi-search"></i> Buscar término
                    </h4>
                    <form method="get" action="/Glosario/Buscar">
                        <div class="input-group input-group-lg">
                            <input type="text" 
                                   name="q" 
                                   class="form-control" 
                                   placeholder="Ej: fatiga, infliximab, dolor abdominal..."
                                   required>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hover-lift {
            transition: transform 0.2s ease-in-out;
        }
        .hover-lift:hover {
            transform: translateY(-5px);
        }
    </style>
}
