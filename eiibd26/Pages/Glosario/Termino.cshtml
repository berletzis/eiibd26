                        {
                            <div id="termino-tab-preguntas" class="tab-panel"
                                 role="tabpanel" aria-hidden="true">
                                <ul class="list-unstyled mt-3">
                                    @foreach (var preg in Model.Term.PreguntasRelacionadas)
                                    {
                                        <li class="mb-3 pb-2" style="border-bottom:1px solid var(--eii-border);">
                                            <a href="/Preguntas/Detalles/@preg.Slug" class="fw-semibold text-decoration-none">
                                                @preg.Titulo
                                            </a>
                                            @if (preg.Score > 0)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary ms-2" style="font-size:.7rem;">
                                                    ↑@preg.Score
                                                </span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>

                @{
                    var experiencias = Model.Term.ExperienciasComunidad;
                    var hayExperiencias = experiencias.Any();
                    var urlEstadoAnimo = "/Identity/Usuario/UsuarioEstadoAnimo";
                }

                @* Comunidad header *@
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <h2 class="editorial-section-h2 mb-0">Comunidad</h2>
                    @{
                        var totalRelated = Model.Term.RelatedUsersCount;
                        var showing = experiencias.Count;
                    }
                    @if (totalRelated > 0)
                    {
                        <span class="eii-count-badge ms-2"
                              style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;">
                            @totalRelated usuarios &middot; mostrando @showing
                        </span>
                    }
                    else if (hayExperiencias)
                    {
                        <span class="eii-count-badge ms-2"
                              style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;">
                            mostrando @experiencias.Count
                        </span>
                    }
                    @* Seguimiento PERSONAL del paciente: solo paciente puro. Médico/Admin no llevan
                       registro clínico propio aquí; ven las experiencias de la comunidad sin el botón. *@
                    @if (User.IsInRole("Paciente") && !User.IsInRole("Administrador") && !User.IsInRole("Medico"))
                    {
                        <button type="button" id="btnAgregarMiMood" class="eii-btn eii-btn--primary eii-btn--sm ms-auto"
                                data-tipo="@(isSintoma ? "sintoma" : "tratamiento")"
                                data-id="@(isSintoma ? (Model.Term.SintomaId.HasValue ? Model.Term.SintomaId.Value.ToString() : "") : (Model.Term.TratamientoId.HasValue ? Model.Term.TratamientoId.Value.ToString() : ""))"
                                data-name="@System.Text.Encodings.Web.HtmlEncoder.Default.Encode(Model.Term.Nombre)">
                            <i class="bi bi-plus-lg me-1"></i> Agregar
                        </button>
                    }
                </div>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="comunidad-login-cta">
                        <p class="comunidad-login-cta__msg">
                            <i class="bi bi-unlock comunidad-login-cta__icon"></i>
                            Inicia sesi&oacute;n para ver y participar en las respuestas de la comunidad.
                        </p>
                        @{
                            var currentUrl = $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
                        }
                        <div class="comunidad-login-cta__btns">
                            <a href="/Identity/Account/Register?returnUrl=@Uri.EscapeDataString(currentUrl)" class="eii-btn eii-btn--solid eii-btn--sm">
                                <i class="bi bi-person-plus me-1"></i> Crear cuenta gratis
                            </a>
                            <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(currentUrl)" class="eii-btn eii-btn--primary eii-btn--sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesi&oacute;n
                            </a>
                        </div>
                    </div>
                }
                else if (hayExperiencias)
                {
                    <div class="cards-grid" id="comunidadGrid">
                        @foreach (var exp in experiencias)
                        {
                            <div class="card user-card h-100">
                                <div class="user-card-main">
                                    <div class="user-avatar">
                                        @if (!string.IsNullOrWhiteSpace(exp.AvatarUrl))
                                        {
                                            <img src="@exp.AvatarUrl" alt="@exp.AliasUsuario" loading="lazy" decoding="async"
                                                 onerror="this.onerror=null;this.src='/img/default-avatar.png';" />
                                        }
                                        else
                                        {
                                            <img src="/img/default-avatar.png" alt="@exp.AliasUsuario" loading="lazy" decoding="async" />
                                        }
                                    </div>
                                    <div class="user-info">
                                        <div class="user-name">@exp.AliasUsuario</div>
                                        <div class="user-meta">@exp.FechaRelativa</div>
                                        @if (!string.IsNullOrWhiteSpace(exp.CondicionNombre))
                                        {
                                            <div class="user-meta">🩺 @exp.CondicionNombre</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(exp.SintomaContextoNombre))
                                        {
                                            <div class="user-meta">⚡ @exp.SintomaContextoNombre</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(exp.TratamientoContextoNombre))
                                        {
                                            <div class="user-meta">💊 @exp.TratamientoContextoNombre</div>
                                        }
                                    </div>
                                </div>
                                <div class="user-card-bottom">
                                    <div class="mood-entry-text">
                                        @if (!string.IsNullOrWhiteSpace(exp.TextoPreview))
                                        {
                                            @exp.TextoPreview
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Se sintió <strong>@exp.EstadoMoodNombre.ToLower()</strong>.</span>
                                        }
                                    </div>
                                    <img src="@exp.MoodIconUrl" alt="@exp.EstadoMoodNombre" title="@exp.EstadoMoodNombre" class="mood-entry-icon" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div id="sinExperienciasMsg" class="text-center py-3">
                        <p class="text-muted small mb-0">S&eacute; el primero en compartir tu experiencia con este t&eacute;rmino.</p>
                    </div>
                    <div class="cards-grid" id="comunidadGrid"></div>
                }

                @* Modal siempre disponible para usuarios autenticados *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Html.PartialAsync("~/Views/Shared/_EstadoAnimoModal.cshtml")
                }
                <script>
                (function () {
                    var MOOD_ICONS = { 1: '/img/muymal.svg', 2: '/img/mal.svg', 3: '/img/neutral.svg', 4: '/img/bien.svg', 5: '/img/muybien.svg' };
                    var MOOD_LABELS = { 1: 'Muy mal', 2: 'Mal', 3: 'Neutral', 4: 'Bien', 5: 'Muy bien' };

                    var btn = document.getElementById('btnAgregarMiMood');
                    if (btn) {
                        btn.addEventListener('click', function () {
                            try {
                                openEstadoAnimoModal({ tipo: btn.dataset.tipo || null, id: btn.dataset.id ? parseInt(btn.dataset.id, 10) : null, name: btn.dataset.name || null });
                            } catch (e) { console.error(e); }
                        });
                    }

                    window.addEventListener('mood:added', function (e) {
                        var d = e.detail || {};
                        var msgEl = document.getElementById('sinExperienciasMsg');
                        if (msgEl) msgEl.style.display = 'none';
                        var grid = document.getElementById('comunidadGrid');
                        if (!grid) return;

                        var moodNum = d.estadoMood || 3;
                        var moodLabel = MOOD_LABELS[moodNum] || d.estadoMoodNombre || 'Neutral';
                        var moodIcon = MOOD_ICONS[moodNum] || '/img/neutral.svg';

                        var contextMeta = '';
                        if (d.ctxTipo === 'sintoma' && d.sintomaNombre) {
                            contextMeta += '<div class="user-meta">&#x26A1; ' + esc(d.sintomaNombre) + '</div>';
                        } else if (d.ctxTipo === 'tratamiento' && d.tratamientoNombre) {
                            contextMeta += '<div class="user-meta">&#x1F48A; ' + esc(d.tratamientoNombre) + '</div>';
                        }
                        if (d.condicionNombre) {
                            contextMeta = '<div class="user-meta">&#x1FA7A; ' + esc(d.condicionNombre) + '</div>' + contextMeta;
                        }

                        var textoHtml = d.texto
                            ? '<span>' + esc(d.texto.substring(0, 160)) + '</span>'
                            : '<span class="text-muted fst-italic">Se sinti\u00F3 <strong>' + esc(moodLabel.toLowerCase()) + '</strong>.</span>';

                        var card = document.createElement('div');
                        card.className = 'card user-card h-100';
                        card.innerHTML =
                            '<div class="user-card-main">' +
                              '<div class="user-avatar"><img src="/img/default-avatar.png" alt="Tú" loading="lazy" decoding="async" /></div>' +
                              '<div class="user-info">' +
                                '<div class="user-name">T\u00FA</div>' +
                                '<div class="user-meta">ahora mismo</div>' +
                                contextMeta +
                              '</div>' +
                            '</div>' +
                            '<div class="user-card-bottom">' +
                              '<div class="mood-entry-text">' + textoHtml + '</div>' +
                              '<img src="' + moodIcon + '" alt="' + esc(moodLabel) + '" title="' + esc(moodLabel) + '" class="mood-entry-icon" />' +
                            '</div>';

                        grid.insertBefore(card, grid.firstChild);
                    });

                    function esc(s) {
                        if (!s) return '';
                        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                    }
                })();
                </script>

            </div><!-- /content-panel -->
            <!-- ===== SIDEBAR ===== -->
            <div class="right-panel">
                <!-- ===== CALIFICAR TÉRMINO (TOP del sidebar, siempre visible) ===== -->
                <div class="sidebar-section sidebar-static mb-3">
                    <div class="sidebar-section-header-static">
                        <span class="sidebar-section-title">Calificar término</span>
                    </div>
                    <div class="sidebar-section-content-static">
                        <div class="article-rating" id="glossaryRating" data-term-id="@Model.Term.Id">
                            <div class="rating-buttons">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="rating-btn rating-like" data-rating="like" title="Me fue útil">
                                        <i class="bi bi-hand-thumbs-up"></i>
                                        <span class="rating-text">Me fue útil</span>
                                        <span class="rating-count" id="glossaryLikeCount">...</span>
                                    </button>
                                    <button type="button" class="rating-btn rating-dislike" data-rating="dislike" title="No me fue útil">
                                        <i class="bi bi-hand-thumbs-down"></i>
                                        <span class="rating-text">No me fue útil</span>
                                        <span class="rating-count" id="glossaryDislikeCount">...</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="rating-login-hint">
                                        <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)">Inicia sesión</a> para calificar este término
                                    </div>
                                }
                            </div>
                            <div class="rating-message" id="glossaryRatingMessage" style="display: none;"></div>
                        </div>
                    </div>
                </div>

                @* ===== COMPARTIR TÉRMINO ===== *@
                <div class="sidebar-section sidebar-static mb-3">
                    <div class="sidebar-section-header-static">
                        <h4 class="sidebar-section-title">Compartir Término</h4>
                    </div>
                    <div class="sidebar-section-content-static">
                        <div class="share-icons" aria-label="Compartir término">
                            @{
                                var req = HttpContext.Request;
                                var siteRoot = $"{req.Scheme}://{req.Host}";
                                var terminoShareUrl = siteRoot + $"/Termino/{Model.Term.Slug}";
                                var terminoShareTitle = Model.Term.Nombre ?? "Término médico";
                                var tEncUrl   = System.Net.WebUtility.UrlEncode(terminoShareUrl);
                                var tEncTitle = System.Net.WebUtility.UrlEncode(terminoShareTitle);
                                var tWaHref   = $"https://api.whatsapp.com/send?text={tEncTitle}%20{tEncUrl}";
                                var tFbHref   = $"https://www.facebook.com/sharer/sharer.php?u={tEncUrl}";
                                var tTwHref   = $"https://twitter.com/intent/tweet?text={tEncTitle}&url={tEncUrl}";
                                var tMailHref = $"mailto:?subject={tEncTitle}&body={tEncUrl}";
                            }
                            <a class="share-btn" href="#" data-href="@tWaHref"   title="Compartir en WhatsApp" aria-label="Compartir en WhatsApp"><i class="bi bi-whatsapp"></i></a>
                            <a class="share-btn" href="#" data-href="@tFbHref"   title="Compartir en Facebook" aria-label="Compartir en Facebook"><i class="bi bi-facebook"></i></a>
                            <a class="share-btn" href="#" data-href="@tTwHref"   title="Compartir en X"        aria-label="Compartir en X"><i class="bi bi-twitter"></i></a>
                            <a class="share-btn" href="@tMailHref"               title="Enviar por email"      aria-label="Enviar por email"><i class="bi bi-envelope"></i></a>
                        </div>
                        <script>
                            (function(){
                                function openSharePopup(url){
                                    try{
                                        var w=600,h=600;
                                        var left=(screen.width/2)-(w/2);
                                        var top=(screen.height/2)-(h/2);
                                        window.open(url,'_blank','scrollbars=yes,resizable=yes,toolbar=no,location=no,width='+w+',height='+h+',top='+top+',left='+left);
                                    }catch(e){ window.location.href=url; }
                                }
                                document.addEventListener('click',function(e){
                                    var a=e.target.closest&&e.target.closest('.share-btn');
                                    if(!a)return;
                                    e.preventDefault();
                                    var href=a.getAttribute('data-href')||a.getAttribute('href');
                                    if(!href)return;
                                    if(href.indexOf('mailto:')===0){window.location.href=href;return;}
                                    openSharePopup(href);
                                },{passive:false});
                            })();
                        </script>
                    </div>
                </div>

                <!-- Aviso importante -->
                <div class="aviso-termino-box">

                    <p class="aviso-title mb-2">Aviso Importante</p>
                    <p class="aviso-text">
                        Esta información es educativa y no reemplaza el consejo de un
                        médico profesional. <strong>Siempre consulta con tu médico</strong>
                        sobre tu condición y tratamiento.
                    </p>
                </div>
                <!-- Card de validación de relación con EII para médicos/admins (PRIMERO EN EL SIDEBAR) -->
                @if (Model.CanValidate)
                {

                    @await Html.PartialAsync("_ValidacionContenidoMedico", new eiibd26.Services.Validacion.ValidacionContenidoPartialVm
                    {
                        ContenidoId = Model.Term.Id,
                        Slug        = Model.Term.Slug,
                        Existente   = Model.MiValidacionDesc
                    })


                    <div class="sidebar-section sidebar-static mb-3">
                        <div class="sidebar-section-header-static">
                            <span class="sidebar-section-title">Validar relación con EII</span>
                        </div>
                        <div class="sidebar-section-content-static">
                            <!-- Validar relación con EII -->
                            <form method="post" asp-page-handler="AddValidation" class="mb-3">
                                <input type="hidden" name="termId" value="@Model.Term.Id" />
                                <input type="hidden" name="slug" value="@Model.Term.Slug" />
                                <input type="hidden" name="validationType" value="2" />
                                <div class="mb-2">
                                    <label for="medicalRelationTypeId" class="form-label" style="font-weight:600;">Nivel de relación:</label>
                                    <select class="form-select" name="medicalRelationTypeId" id="medicalRelationTypeId" required>
                                        <option value="">Selecciona un nivel</option>
                                        <option value="1">Directa</option>
                                        <option value="2">Indirecta</option>
                                        <option value="3">Secundaria</option>
                                    </select>
                                </div>
                                <div class="mb-2">
