                                    <textarea class="form-control" name="comment" id="comment-rel" rows="2" maxlength="400" placeholder="Agrega un comentario clínico (máx. 400 caracteres)"></textarea>
                                </div>
                                <button type="submit" class="eii-btn eii-btn--solid">Validar relación</button>
                            </form>
                            <!-- Validar descripción -->
                        </div>
                    </div>

                }


                
                <!-- Relación con EII (sidebar) -->
                @if (counts.RelationConsensus.Any() || counts.RelationSuggested.HasValue)
                {
                    <div class="sidebar-section sidebar-static mb-3">
                        <div class="sidebar-section-header-static">
                            <span class="sidebar-section-title">Relación con EII</span>
                        </div>
                        <div class="sidebar-section-content-static">
                            @if (counts.RelationConsensus.Any())
                            {
                                <p class="small text-muted mb-2">Consenso médico:</p>
                                @foreach (var item in counts.RelationConsensus.OrderByDescending(i => i.Count))
                                {
                                    var (dotColor, label) = item.RelationType switch
                                    {
                                        eiibd26.Models.Glossary.MedicalRelationType.Directa => ("#22c55e", "Directa"),
                                        eiibd26.Models.Glossary.MedicalRelationType.Indirecta => ("#c4b5fd", "Indirecta"),
                                        _ => ("#d1d5db", "Secundaria")
                                    };
                                    <div class="d-flex align-items-center mb-2 gap-2">
                                        <span class="eii-nivel-dot" style="background:@dotColor;"></span>
                                        <span class="@(item.IsTopConsensus ? "fw-bold" : "") small">@label</span>
                                        <span class="eii-count-badge ms-2"
                                              style="background:@(item.Count > 0 ? dotColor + "22" : "#f1f5f9");
                                                     color:@(item.Count > 0 ? dotColor : "#94a3b8");
                                                     border:1px solid @(item.Count > 0 ? dotColor + "55" : "#e2e8f0");">
                                            @item.Count
                                        </span>
                                    </div>
                                }
                            }
                            else if (counts.RelationSuggested.HasValue)
                            {
                                var (dotColor, label) = counts.RelationSuggested.Value switch
                                {
                                    eiibd26.Models.Glossary.MedicalRelationType.Directa => ("#22c55e", "Directa"),
                                    eiibd26.Models.Glossary.MedicalRelationType.Indirecta => ("#c4b5fd", "Indirecta"),
                                    _ => ("#d1d5db", "Secundaria")
                                };
                                <p class="small text-muted mb-1">Sugerido por NINA:</p>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="eii-nivel-dot" style="background:@dotColor;"></span>
                                    <span class="small">@label</span>
                                    <span class="eii-count-badge ms-2"
                                          style="background:#f1f5f9;color:#94a3b8;border:1px solid #e2e8f0;">0</span>
                                </div>
                                <p class="mb-0 small">(pendiente validación)</p>
