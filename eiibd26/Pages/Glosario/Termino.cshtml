                    <div class="sidebar-section-header-static">
                        <span class="sidebar-section-title">Artículos Relacionados</span>
                    </div>
                    <div class="sidebar-section-content-static">
                        @if (Model.Term.ArticulosRelacionados != null && Model.Term.ArticulosRelacionados.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var c in Model.Term.ArticulosRelacionados.Take(5))
                                {
                                    <li class="py-2 border-bottom d-flex gap-2">
                                        @if (!string.IsNullOrWhiteSpace(c.ImagenDestacada))
                                        {
                                            <img src="@c.ImagenDestacada" alt="@c.Titulo" class="sidebar-thumb" loading="lazy" decoding="async" />
                                        }
                                        <div>
                                            <a href="/Contenidos/Detalle/@c.Slug" class="text-decoration-none text-dark">
                                                <div class="small fw-medium">@c.Titulo</div>
                                            </a>
                                            @if (c.FechaPublicacion.HasValue)
                                            {
                                                <small class="text-muted">@c.FechaPublicacion.Value.ToString("dd MMM yyyy")</small>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">No se encontraron contenidos relacionados.</p>
                        }
                    </div>
                </div>

                

            </div><!-- /right-panel -->

        </div><!-- /detail-grid -->
    </div><!-- /conte-detail -->
}

@section Scripts {
    <script>
        // ===== EII TOGGLE CARDS =====
        function toggleEiiCard(contentId, header) {
            const body = document.getElementById(contentId);
            if (!body) return;

            const icon = header.querySelector('.eii-toggle-icon');
            if (body.classList.contains('partial-open')) {
                body.classList.remove('partial-open');
                body.classList.add('open');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else if (body.classList.contains('open')) {
                body.classList.remove('open');
                body.classList.add('partial-open');
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                body.classList.add('open');
                if (icon) icon.style.transform = 'rotate(180deg)';
            }
        }

        // ===== GLOSSARY TERM RATING SYSTEM =====
        (function () {
            const ratingContainer = document.getElementById('glossaryRating');
            if (!ratingContainer) return;

            const termId = ratingContainer.getAttribute('data-term-id');
            const likeBtn = ratingContainer.querySelector('.rating-like');
            const dislikeBtn = ratingContainer.querySelector('.rating-dislike');
            const likeCount = document.getElementById('glossaryLikeCount');
            const dislikeCount = document.getElementById('glossaryDislikeCount');
            const ratingMessage = document.getElementById('glossaryRatingMessage');

            async function loadRatingState() {
                try {
                    const response = await fetch(`/api/glossary/${termId}/rating`);
                    const data = await response.json();
                    if (data.ok && data.estadisticas) {
                        if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                        if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;
                        if (data.ratingUsuario) {
                            const tipo = data.ratingUsuario.tipo;
                            if (tipo === 'like' && likeBtn) likeBtn.classList.add('active');
                            else if (tipo === 'dislike' && dislikeBtn) dislikeBtn.classList.add('active');
                        }
                    }
                } catch {
                    if (likeCount) likeCount.textContent = '0';
                    if (dislikeCount) dislikeCount.textContent = '0';
                }
            }

            async function sendRating(ratingType) {
                try {
                    showMessage('Guardando...', 'info');
                    const response = await fetch(`/api/glossary/${termId}/rating`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ratingType })
                    });
                    const data = await response.json();
                    if (data.ok) {
                        if (data.estadisticas) {
                            if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                            if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;
                        }
                        if (likeBtn) likeBtn.classList.toggle('active', ratingType === 'like');
                        if (dislikeBtn) dislikeBtn.classList.toggle('active', ratingType === 'dislike');
                        showMessage('✅ ¡Gracias por tu opinión!', 'success');
                        setTimeout(() => hideMessage(), 3000);
                    } else {
                        showMessage('❌ ' + (data.error || 'Error al guardar'), 'error');
                    }
                } catch {
                    showMessage('❌ Error de conexión', 'error');
                }
            }

            if (likeBtn) {
                likeBtn.addEventListener('click', function () {
                    if (likeBtn.classList.contains('active')) return;
                    sendRating('like');
                });
            }
            if (dislikeBtn) {
                dislikeBtn.addEventListener('click', function () {
                    if (dislikeBtn.classList.contains('active')) return;
                    sendRating('dislike');
                });
            }

            function showMessage(text, type) {
                if (!ratingMessage) return;
                ratingMessage.textContent = text;
                ratingMessage.className = 'rating-message ' + (type || 'info');
                ratingMessage.style.display = 'block';
            }
            function hideMessage() {
                if (ratingMessage) ratingMessage.style.display = 'none';
            }

            loadRatingState();
        })();

        // Tabs de contenido relacionado (artículos + preguntas)
        (function () {
            const container = document.getElementById('terminoRelatedTabs');
            if (!container) return;
            container.querySelectorAll('.tab-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    container.querySelectorAll('.tab-btn').forEach(function (b) {
                        b.classList.remove('active');
                        b.setAttribute('aria-selected', 'false');
                    });
                    container.querySelectorAll('.tab-panel').forEach(function (p) {
                        p.classList.remove('active');
                        p.setAttribute('aria-hidden', 'true');
                    });
                    btn.classList.add('active');
                    btn.setAttribute('aria-selected', 'true');
                    var panel = document.getElementById(btn.dataset.panel);
                    if (panel) {
                        panel.classList.add('active');
                        panel.setAttribute('aria-hidden', 'false');
                    }
                });
            });
        })();
    </script>
}
