@page
@model eiibd26.Pages.Glosario.TratamientosModel
@{
    ViewData["Title"] = "Tratamientos - Glosario Médico";
    ViewData["Description"] = "Índice alfabético de tratamientos para la Enfermedad Inflamatoria Intestinal.";
}

<div class="container py-5">
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="vote-auth-notice" role="note" aria-live="polite">
            <span class="vote-auth-notice__icon">💊</span>
            <span class="vote-auth-notice__text">Inicia sesión para registrar tus tratamientos en tu perfil.</span>
            <span class="vote-auth-notice__actions">
                <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-auth-notice-register">Iniciar sesión</a>
                <a href="/Identity/Account/Register?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-auth-notice-register">Crear cuenta</a>
            </span>
        </div>
    }
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold text-dark" style="color:#000;margin-bottom:0;">
                Tratamientos
                <span class="badge bg-light text-dark ms-2" style="font-weight:600;font-size:.9rem;">@Model.Terminos.Count</span>
            </h1>
            <nav aria-label="breadcrumb" class="mt-2">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/Glosario">Glosario</a></li>
                    <li class="breadcrumb-item active">Tratamientos</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (Model.Terminos.Any())
    {
        <!-- Navegación alfabética -->
        <div class="alphabet-nav mb-4">
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                @foreach (var letra in Model.LetrasDisponibles)
                {
                    <a href="#letra-@letra" class="alphabet-letter">@letra</a>
                }
            </div>
        </div>

        <!-- Lista agrupada por letra -->
        @foreach (var grupo in Model.TerminosAgrupados)
        {
            <div class="mb-5" id="letra-@grupo.Key">
                <h2 class="border-bottom pb-2 mb-3">
                    <span class="text-purple">@grupo.Key</span>
                </h2>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var termino in grupo)
                    {
                        <div class="col">
                            <article class="se-card h-100">
                                <a href="/Termino/@termino.Slug" class="text-decoration-none text-reset d-flex flex-column h-100">
                                    <div class="se-card-body">
                                        <h5 class="se-card-title">@termino.Nombre</h5>
                                    </div>
                                </a>
                            </article>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No hay tratamientos disponibles en este momento.
        </div>
    }

    <!-- Botón volver -->
    <div class="row mt-5">
        <div class="col text-center">
            <a href="/Glosario" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Glosario
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        /* keep small compatibility tweaks */
        /* Ensure alphabet letters are large and styled on this page as well */
        .alphabet-letter {
            font-size: 2rem !important;
            text-decoration: none !important;
            display: inline-block !important;
            min-width: 48px !important;
            height: 48px !important;
            line-height: 48px !important;
            padding: 0 10px !important;
            border-radius: 8px !important;
            color: #6d28d9 !important;
            background: transparent !important;
            cursor: pointer !important;
            font-weight: 700 !important;
        }
        .alphabet-letter:hover { background: #f3e8ff !important; color: #5b21b6 !important; }
        .alphabet-letter:active, .alphabet-letter.active { background: #e9d5ff !important; color: #6d28d9 !important; }
        .alphabet-letter:focus { outline: 3px solid rgba(124,58,237,0.18) !important; outline-offset: 3px !important; }
    </style>
}

@section Scripts {
    <script>
        // Smooth scroll para navegación alfabética
        document.querySelectorAll('a[href^="#letra-"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
}
