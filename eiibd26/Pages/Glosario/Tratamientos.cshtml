@page
@model eiibd26.Pages.Glosario.TratamientosModel
@{
    ViewData["Title"] = "Tratamientos - Glosario Médico";
    ViewData["Description"] = "Índice alfabético de tratamientos para la Enfermedad Inflamatoria Intestinal.";
}

<div class="container py-5">
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="vote-auth-notice" role="note" aria-live="polite">
            <span class="vote-auth-notice__icon">💊</span>
            <span class="vote-auth-notice__text">Inicia sesión para registrar tus tratamientos en tu perfil.</span>
            <span class="vote-auth-notice__actions">
                <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-auth-notice-register">Iniciar sesión</a>
                <a href="/Identity/Account/Register?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-auth-notice-register">Crear cuenta</a>
            </span>
        </div>
    }
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <div class="eii-page-header">
                <div class="eii-page-header__content">
                    <h1 class="eii-page-title">
                        Tratamientos
                        <span class="badge bg-light text-dark ms-2" style="font-weight:600;font-size:.9rem;">@Model.Terminos.Count</span>
                    </h1>
                </div>
            </div>
            <nav aria-label="breadcrumb" class="mt-2">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/Glosario">Glosario</a></li>
                    <li class="breadcrumb-item active">Tratamientos</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (Model.Terminos.Any())
    {
        <!-- Filtro por nivel de relación EII -->
        <div class="eii-nivel-filter mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center">
                <button type="button" class="btn-nivel-eii active" data-nivel="todos">
                    <span class="nivel-dot" style="background:#6c757d;"></span> Todos
                    <span class="nivel-count">(@Model.Terminos.Count)</span>
                </button>
                <button type="button" class="btn-nivel-eii" data-nivel="1">
                    <span class="nivel-dot" style="background:var(--eii-primary);"></span> Directa
                    <span class="nivel-count">(@Model.Terminos.Count(t => t.NivelRelacion == eiibd26.Models.Glossary.MedicalRelationType.Directa))</span>
                </button>
                <button type="button" class="btn-nivel-eii" data-nivel="2">
                    <span class="nivel-dot" style="background:#c4b5fd;"></span> Indirecta
                    <span class="nivel-count">(@Model.Terminos.Count(t => t.NivelRelacion == eiibd26.Models.Glossary.MedicalRelationType.Indirecta))</span>
                </button>
                <button type="button" class="btn-nivel-eii" data-nivel="3">
                    <span class="nivel-dot" style="background:#d1d5db;"></span> Secundaria
                    <span class="nivel-count">(@Model.Terminos.Count(t => t.NivelRelacion == eiibd26.Models.Glossary.MedicalRelationType.Secundaria))</span>
                </button>
                <button type="button" class="btn-nivel-eii" data-nivel="sin">
                    <span class="nivel-dot" style="background:#ced4da; border:1px solid #adb5bd;"></span> Sin clasificar
                    <span class="nivel-count">(@Model.Terminos.Count(t => t.NivelRelacion == null))</span>
                </button>
            </div>
        </div>

        <!-- Navegación alfabética -->
        <div class="alphabet-nav mb-4">
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                @foreach (var letra in Model.LetrasDisponibles)
                {
                    <a href="#letra-@letra" class="alphabet-letter">@letra</a>
                }
            </div>
        </div>

        <!-- Lista agrupada por letra -->
        @foreach (var grupo in Model.TerminosAgrupados)
        {
            <div class="mb-5 letra-grupo" id="letra-@grupo.Key">
                <h2 class="border-bottom pb-2 mb-3">
                    <span class="text-purple">@grupo.Key</span>
                </h2>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var termino in grupo)
                    {
                        <div class="col termino-item" data-nivel="@(termino.NivelRelacion.HasValue ? ((int)termino.NivelRelacion!).ToString() : "sin")">
                            <article class="eii-card eii-card--link h-100">
                                <a href="/Termino/@termino.Slug" class="text-decoration-none text-reset d-flex flex-column h-100">
                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                        <h5 class="mb-0 fw-semibold" style="font-size:var(--eii-text-sm);">@termino.Nombre</h5>
                                        @{
                                            var dotColor = termino.NivelRelacion.HasValue
                                                ? termino.NivelRelacion.Value switch
                                                {
                                                    eiibd26.Models.Glossary.MedicalRelationType.Directa    => "#6a4e7a",
                                                    eiibd26.Models.Glossary.MedicalRelationType.Indirecta  => "#c4b5fd",
                                                    eiibd26.Models.Glossary.MedicalRelationType.Secundaria => "#d1d5db",
                                                    _ => "#ced4da"
                                                }
                                                : "#ced4da";
                                            var dotTitle = termino.NivelRelacion.HasValue
                                                ? termino.NivelRelacion.Value switch
                                                {
                                                    eiibd26.Models.Glossary.MedicalRelationType.Directa    => "Relación directa con EII",
                                                    eiibd26.Models.Glossary.MedicalRelationType.Indirecta  => "Relación indirecta con EII",
                                                    eiibd26.Models.Glossary.MedicalRelationType.Secundaria => "Relación secundaria con EII",
                                                    _ => "Sin clasificar"
                                                }
                                                : "Sin clasificar";
                                        }
                                        <span class="nivel-dot-card" style="background:@dotColor;" title="@dotTitle" aria-label="@dotTitle"></span>
                                    </div>
                                </a>
                                @if (termino.Validadores.Any())
                                {
                                    <partial name="_ValidadoresAvatares" model="@termino.Validadores" />
                                }
                            </article>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No hay tratamientos disponibles en este momento.
        </div>
    }

    <!-- Botón volver -->
    <div class="row mt-5">
        <div class="col text-center">
            <a href="/Glosario" class="eii-btn eii-btn--neutral">
                <i class="bi bi-arrow-left"></i> Volver al Glosario
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        /* keep small compatibility tweaks */
        /* Ensure alphabet letters are large and styled on this page as well */
        .alphabet-letter {
            font-size: 2rem !important;
            text-decoration: none !important;
            display: inline-block !important;
            min-width: 48px !important;
            height: 48px !important;
            line-height: 48px !important;
            padding: 0 10px !important;
            border-radius: 8px !important;
            color: var(--eii-primary) !important;
            background: transparent !important;
            cursor: pointer !important;
            font-weight: 700 !important;
        }
        .alphabet-letter:hover { background: var(--eii-primary-soft) !important; color: var(--eii-primary-hover) !important; }
        .alphabet-letter:active, .alphabet-letter.active { background: var(--eii-primary-border) !important; color: var(--eii-primary) !important; }
        .alphabet-letter:focus { outline: 3px solid rgba(106,78,122,0.18) !important; outline-offset: 3px !important; }

        /* ── Filtro EII ── */
        .eii-nivel-filter { border-top: 1px solid var(--eii-primary-soft); border-bottom: 1px solid var(--eii-primary-soft); padding: .6rem 0; }
        .btn-nivel-eii {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .35rem .85rem; border-radius: 999px;
            border: 1.5px solid var(--eii-primary-border); background: #fff;
            font-size: .85rem; font-weight: 500; color: #374151;
            cursor: pointer; transition: border-color .15s, background .15s;
        }
        .btn-nivel-eii:hover { border-color: var(--eii-primary); background: var(--eii-primary-soft); }
        .btn-nivel-eii.active { border-color: var(--eii-primary); background: var(--eii-primary-soft); color: var(--eii-primary-hover); font-weight: 600; }
        .nivel-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .nivel-count { font-size: .78rem; opacity: .7; }
        /* punto circular de nivel en la tarjeta */
        .nivel-dot-card {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        /* grupo de letra oculto cuando todos sus hijos están ocultos */
        .letra-grupo.hidden { display: none; }
        .termino-item.hidden { display: none; }
    </style>
}

@section Scripts {
    <script>
        // Smooth scroll para navegación alfabética
        document.querySelectorAll('a[href^="#letra-"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Filtro EII sin recarga
        (function () {
            const btns = document.querySelectorAll('.btn-nivel-eii');
            btns.forEach(btn => {
                btn.addEventListener('click', function () {
                    btns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    const nivel = this.dataset.nivel;
                    filtrar(nivel);
                });
            });

            function filtrar(nivel) {
                const items = document.querySelectorAll('.termino-item');
                items.forEach(item => {
                    const match = nivel === 'todos' || item.dataset.nivel === nivel;
                    item.classList.toggle('hidden', !match);
                });
                // ocultar grupos de letra que quedaron sin hijos visibles
                document.querySelectorAll('.letra-grupo').forEach(grupo => {
                    const visible = grupo.querySelectorAll('.termino-item:not(.hidden)').length > 0;
                    grupo.classList.toggle('hidden', !visible);
                });
            }
        })();
    </script>
}
