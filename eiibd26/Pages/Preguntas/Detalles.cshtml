@page "{id:guid}"
@model eiibd26.Pages.Preguntas.DetallesModel
@{
    ViewData["Title"] = Model.Pregunta?.Titulo ?? "Pregunta";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }

    string RenderQuestionVoteControl()
    {
        if (!User.Identity.IsAuthenticated)
        {
            return "<div class=\"vote-login-hint\">Inicia sesión para realizar un voto. <a href=\"/Account/Login\">Iniciar sesión</a></div>";
        }

        if (Model.Pregunta.EsMia)
        {
            return "<span class=\"text-muted small\">No puedes votar tu propia pregunta</span>";
        }

        var userVote = Model.Pregunta.UsuarioVoto;
        if (userVote == 1)
        {
            return $"<button class=\"btn btn-outline-danger btn-voto-q\" data-id=\"{Model.Pregunta.Id}\" data-valor=\"-1\" title=\"Quitar voto\"><i class=\"bi bi-hand-thumbs-down me-1\"></i>-1</button>";
        }
        else
        {
            return $"<button class=\"btn btn-outline-success btn-voto-q\" data-id=\"{Model.Pregunta.Id}\" data-valor=\"1\" title=\"+1\"><i class=\"bi bi-hand-thumbs-up me-1\"></i>+1</button>";
        }
    }
}

<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<style>
    /* Keep styles minimal here — uses shared style.css */
    .pd-container {
        max-width: 980px;
        margin: 28px auto;
        padding: 0 12px;
        box-sizing: border-box;
    }

    .ans-card {
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }

    .ans-meta {
        font-size: .9rem;
        color: #6b7483;
    }

    .btn-delete-respuesta {
        background: transparent;
        border: 0;
        color: #d23b4a;
        cursor: pointer;
        padding: .15rem .4rem;
    }
</style>

<div class="pd-container">
    <div class="pr-card pr-main"
         data-id="@Model.Pregunta.Id"
         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
         data-is-mine="@(Model.Pregunta.EsMia ? "true" : "false")"
         data-user-vote="@Model.Pregunta.UsuarioVoto"
         data-score="@Model.Pregunta.Score">

        <div class="pr-content">
            <div class="pr-title">@Model.Pregunta.Titulo</div>

            <div class="pr-body">@Html.Raw(Model.Pregunta.Cuerpo)</div>

            <div class="avatars-row">
                <img class="avatar-author lazy-avatar"
                     src="@Url.Content("~/img/avatar-placeholder.png")"
                     data-src="@ResolveAvatar(Model.Pregunta.AutorAvatarUrl)"
                     alt="@Model.Pregunta.AutorNombre"
                     width="40" height="40"
                     decoding="async"
                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />

                <div class="author-info">
                    <div>
                        <strong>@Model.Pregunta.AutorNombre</strong>
                        @if (Model.Pregunta.EsMia)
                        {
                            <span class="author-badge" style="margin-left:8px;font-size:0.85rem;color:#6b6b6b;">Tu pregunta</span>
                        }
                    </div>
                    <div class="text-muted small">Publicado · @(Model.Pregunta.FechaCreacion.ToLocalTime().ToString("g"))</div>
                </div>
            </div>
        </div>

        <div class="pr-actions">
            <div class="pr-eye">
                <a class="btn btn-sm btn-outline-secondary" href="/Preguntas/Detalles/@Model.Pregunta.Id" title="Ver detalle" aria-label="Ver detalle">
                    <span style="font-size:0.95rem;">👁</span>
                </a>
            </div>

            <span class="badge bg-light text-dark">Respuestas: <strong>@Model.TotalItems</strong></span>

            <div class="vote-container">
                @Html.Raw(RenderQuestionVoteControl())
            </div>

            <div class="pr-score badge bg-light text-dark" id="qscore-@Model.Pregunta.Id">Score: @Model.Pregunta.Score</div>
        </div>
    </div>

    <div class="reply-form mt-3">
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="vote-login-hint">Inicia sesión para ver la(s) "@Model.TotalItems" respuesta(s). <a href="/Account/Login">Iniciar sesión</a></div>
        }
        else
        {
            <div class="mb-2"><strong>Responder a la pregunta</strong></div>
            <div class="mb-2">
                <textarea id="replyCuerpo" class="form-control reply-textarea" placeholder="Escribe tu respuesta aquí..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button id="btnSendReply" class="btn btn-primary">Publicar respuesta</button>
                <small class="text-muted">Tu respuesta aparecerá abajo.</small>
            </div>
        }
    </div>

    <div class="answers-list">
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="alert alert-info">Inicia sesión para ver las respuestas. <a href="/Account/Login">Iniciar sesión</a></div>
        }
        else
        {
            @if (!Model.Respuestas.Any())
            {
                <div class="alert alert-secondary">No hay respuestas aún para esta pregunta.</div>
            }
            else
            {
                @foreach (var a in Model.Respuestas)
                {
                    <div class="ans-card"
                         data-id="@a.Id"
                         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                         data-is-mine="@(a.UsuarioId == (Model.GetUserIdGuid() ?? Guid.Empty) ? "true" : "false")">
                        <div style="display:flex;gap:12px;align-items:flex-start;">
                            <img class="lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")" data-src="@ResolveAvatar(a.AutorAvatarUrl)" alt="@a.AutorNombre" width="36" height="36" style="border-radius:50%;object-fit:cover;" />
                            <div style="flex:1;min-width:0;">
                                <strong>@a.AutorNombre</strong>
                                <div class="ans-meta">@a.FechaCreacion.ToLocalTime().ToString("g")</div>
                                <div style="margin-top:8px;">@Html.Raw(a.Cuerpo)</div>
                                <div style="margin-top:8px;" class="ans-meta">Score: <span id="ascore-@a.Id">@a.Score</span></div>
                            </div>

                            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-voto-ans" data-id="@a.Id" data-valor="1" title="Me gusta"><i class="bi bi-hand-thumbs-up"></i></button>
                                </div>
                                <div>
                                    @if (User.Identity.IsAuthenticated && a.UsuarioId == (Model.GetUserIdGuid() ?? Guid.Empty))
                                    {
                                        <button type="button" class="btn-delete-respuesta" data-id="@a.Id" title="Eliminar respuesta">🗑</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            @{
                var prev = Model.Page > 1 ? Model.Page - 1 : 1;
                var next = Model.Page < Model.TotalPages ? Model.Page + 1 : Model.TotalPages;
                var qsBase = $"?id={Model.Id}&search={Uri.EscapeDataString(Model.Search ?? "")}&pageSize={Model.PageSize}";
            }
            <a class="btn btn-sm btn-outline-secondary" href="@($"{qsBase}&page={prev}")">Anterior</a>
            <span class="mx-2">Página <strong>@Model.Page</strong> de <strong>@Model.TotalPages</strong></span>
            <a class="btn btn-sm btn-outline-secondary" href="@($"{qsBase}&page={next}")">Siguiente</a>
        </div>

        <div>
            <small class="text-muted">@Model.TotalItems respuestas</small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function getAntiForgeryToken() {
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : null;
            }

            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const onLoad = img => img.classList.add('loaded');
                const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { onError(img); return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = function () { try { img.src = src; } catch {} onLoad(img); };
                    tmp.onerror = function () { onError(img); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                observer.unobserve(img);
                                loadImg(img);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => {
                        if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) io.observe(i);
                        else if (i.getAttribute('data-src')) i.classList.add('loaded');
                    });
                } else imgs.forEach(i => loadImg(i));
            }

            async function postReplyToApi(preguntaId, cuerpo) {
                const body = { cuerpo: cuerpo };
                const res = await fetch('/api/respuestas', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Pregunta-Id': preguntaId },
                    body: JSON.stringify(body)
                });
                return res;
            }

            const btnSend = document.getElementById('btnSendReply');
            if (btnSend) {
                btnSend.addEventListener('click', async function () {
                    const cuerpoEl = document.getElementById('replyCuerpo');
                    const cuerpo = cuerpoEl.value.trim();
                    if (!cuerpo) return alert('Escribe una respuesta');
                    btnSend.disabled = true;
                    try {
                        const res = await postReplyToApi('@Model.Id', cuerpo);
                        if (!res.ok) {
                            const txt = await res.text();
                            alert('Error al publicar respuesta: ' + txt);
                        } else {
                            location.reload();
                        }
                    } catch (e) { console.error(e); alert('Error de red'); }
                    finally { btnSend.disabled = false; }
                });
            }

            // Delegated click handling: votes + delete respuesta
            document.addEventListener('click', async function (e) {
                if (e.defaultPrevented) return;

                // Question vote
                const btnQ = e.target.closest('.btn-voto-q');
                if (btnQ) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = btnQ.getAttribute('data-id');
                    const valor = parseInt(btnQ.getAttribute('data-valor') || "0", 10);
                    if (!id || (valor !== 1 && valor !== -1)) return;
                    btnQ.disabled = true;
                    try {
                        const res = await fetch('/api/preguntas/' + id + '/votar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ valor: valor })
                        });
                        if (!res.ok) { const txt = await res.text(); console.warn('Error votando pregunta:', res.status, txt); alert('Error al votar: ' + (txt || res.status)); return; }
                        const j = await res.json();
                        const scoreEl = document.getElementById('qscore-' + id);
                        if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;
                        const card = document.querySelector('.pr-card[data-id="' + id + '"]');
                        if (!card) return;
                        const voteContainer = card.querySelector('.vote-container');
                        const authenticated = card.getAttribute('data-authenticated') === 'true';
                        const isMine = card.getAttribute('data-is-mine') === 'true';
                        const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                        card.setAttribute('data-user-vote', String(userVote));
                        card.setAttribute('data-score', String(j.score ?? 0));
                        if (!authenticated) voteContainer.innerHTML = '<div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Account/Login">Iniciar sesión</a></div>';
                        else if (isMine) voteContainer.innerHTML = '<span class="text-muted small">No puedes votar tu propia pregunta</span>';
                        else if (userVote === 1) voteContainer.innerHTML = '<button class="btn btn-outline-danger btn-voto btn-voto-q" data-id="' + id + '" data-valor="-1" title="Quitar voto"><i class="bi bi-hand-thumbs-down me-1"></i>-1</button>';
                        else voteContainer.innerHTML = '<button class="btn btn-outline-success btn-voto btn-voto-q" data-id="' + id + '" data-valor="1" title="+1"><i class="bi bi-hand-thumbs-up me-1"></i>+1</button>';
                    } catch (err) { console.error(err); alert('Error de red al votar'); }
                    finally { try { btnQ.disabled = false; } catch {} }
                    return;
                }

                // Answer vote
                const btnA = e.target.closest('.btn-voto-ans');
                if (btnA) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = btnA.getAttribute('data-id');
                    const valor = parseInt(btnA.getAttribute('data-valor') || "0", 10);
                    if (!id || (valor !== 1 && valor !== -1)) return;
                    btnA.disabled = true;
                    try {
                        const res = await fetch('/api/respuestas/' + id + '/votar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ valor: valor })
                        });
                        if (!res.ok) { const txt = await res.text(); console.warn('Votar respuesta falló:', res.status, txt); alert('Error al votar: ' + (txt || res.status)); return; }
                        const j = await res.json();
                        const scoreVal = (j.score !== undefined) ? j.score : null;
                        const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                        const card = document.querySelector('.ans-card[data-id="' + id + '"]');
                        if (!card) return;
                        const scoreEl = document.getElementById('ascore-' + id);
                        const voteContainer = card.querySelector('.vote-container');
                        if (scoreEl && scoreVal !== null) scoreEl.textContent = 'Score: ' + scoreVal;
                        const authenticated = card.getAttribute('data-authenticated') === 'true';
                        const isMine = card.getAttribute('data-is-mine') === 'true';
                        card.setAttribute('data-user-vote', String(userVote));
                        card.setAttribute('data-score', String(scoreVal));
                        if (!authenticated) voteContainer.innerHTML = '<div class="vote-login-hint">Inicia sesión para ver/realizar votos. <a href="/Account/Login">Iniciar sesión</a></div>';
                        else if (isMine) voteContainer.innerHTML = '<span class="text-muted small">No puedes votar tu propia respuesta</span>';
                        else if (userVote === 1) voteContainer.innerHTML = '<button class="btn btn-outline-danger btn-voto-ans" data-id="' + id + '" data-valor="-1" title="Quitar voto"><i class="bi bi-hand-thumbs-down me-1"></i>-1</button>';
                        else voteContainer.innerHTML = '<button class="btn btn-outline-success btn-voto-ans" data-id="' + id + '" data-valor="1" title="+1"><i class="bi bi-hand-thumbs-up me-1"></i>+1</button>';
                    } catch (err) { console.error('Error votando respuesta', err); alert('Error de red al votar'); }
                    finally { try { btnA.disabled = false; } catch {} }
                    return;
                }

                // Answer delete
                const delBtn = e.target.closest('.btn-delete-respuesta');
                if (delBtn) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = delBtn.getAttribute('data-id');
                    if (!id) { alert('ID de respuesta no encontrado'); return; }
                    if (!confirm('¿Deseas eliminar esta respuesta? Esta acción no se puede deshacer.')) return;
                    delBtn.disabled = true;
                    try {
                        const token = getAntiForgeryToken();
                        const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                        const res = await fetch('/api/respuestas/' + id + '/eliminar', { method: 'POST', headers: headers });
                        if (!res.ok) {
                            const txt = await res.text();
                            console.warn('Eliminar respuesta falló:', res.status, txt);
                            alert('Error eliminando: ' + (txt || res.status));
                            return;
                        }
                        const j = await res.json();
                        if (j.ok) {
                            const ansCard = document.querySelector('.ans-card[data-id="' + id + '"]') || delBtn.closest('.ans-card');
                            if (ansCard) ansCard.remove();
                        } else {
                            alert('No se pudo eliminar: ' + (j.error || 'error'));
                        }
                    } catch (err) {
                        console.error('Error eliminando respuesta', err);
                        alert('Error de red al eliminar');
                    } finally {
                        try { delBtn.disabled = false; } catch {}
                    }
                    return;
                }
            });

            initLazyAvatars();
        })();
    </script>
}