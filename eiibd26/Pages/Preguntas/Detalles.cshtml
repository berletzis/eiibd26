<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="container py-4">
    @if (Model.Pregunta != null)
    {
        <div class="mb-3">
            <h1 class="se-page-title">@Model.Pregunta.Titulo</h1>
            <div class="se-subtitle">Pregunta</div>
        </div>
    }

    <div class="qp-wrapper-flex">
        <div class="qp-main">
            @if (Model.Pregunta == null)
            {
                <div class="se-empty">La pregunta no existe o fue eliminada.</div>
            }
            else
            {
                // Lógica correcta: deshabilitar solo el botón usado, habilitar el opuesto
                var disableUp = Model.Pregunta.UsuarioVoto == 1;    // Deshabilitar upvote solo si ya votó upvote
                var disableDown = (Model.Pregunta.Score <= 0) || (Model.Pregunta.UsuarioVoto == -1);  // Deshabilitar downvote si score=0 o ya votó downvote

                <article class="se-item"
                         data-id="@Model.Pregunta.Id"
                         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                         data-is-mine="@(Model.Pregunta.EsMia ? "true" : "false")"
                         data-user-vote="@Model.Pregunta.UsuarioVoto"
                         data-score="@Model.Pregunta.Score">

                    <div class="se-vote">
                        @if (!User.Identity.IsAuthenticated || Model.Pregunta.EsMia)
                        {
                            <button class="se-vote-btn se-vote-up" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")">▲</button>
                            <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                            <button class="se-vote-btn se-vote-down" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")">▼</button>
                        }
                        else
                        {
                            <button class="se-vote-btn se-vote-up @(Model.Pregunta.UsuarioVoto == 1 ? "active" : "")"
                                    data-id="@Model.Pregunta.Id"
                                    data-dir="up"
                                    type="button"
                                    title="Votar +1"
                                    aria-label="Votar +1"
                                    @(disableUp ? "disabled" : null)>
                                ▲
                            </button>
                            <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                            <button class="se-vote-btn se-vote-down @(Model.Pregunta.UsuarioVoto == -1 ? "active" : "")"
                                    data-id="@Model.Pregunta.Id"
                                    data-dir="down"
                                    type="button"
                                    title="Votar -1"
                                    aria-label="Votar -1"
                                    @(disableDown ? "disabled" : null)>
                                ▼
                            </button>
                        }
                    </div>

                    <div class="se-summary">
                        <div class="se-card-title" role="heading" aria-level="2">@Model.Pregunta.Titulo</div>

                        <div class="se-excerpt">@Html.Raw(Model.Pregunta.Cuerpo)</div>
                        <div class="se-answers-float answered" title="Respuestas totales">
                            <span class="se-answers-float-count">@Model.TotalItems</span>
                            <span class="se-answers-float-label">Respuesta(s)</span>
                        </div>

                        @if ((Model.Pregunta.Condiciones?.Any() ?? false) || (Model.Pregunta.Sintomas?.Any() ?? false) || (Model.Pregunta.Tratamientos?.Any() ?? false))
                        {
                            <div class="se-relations">
                                @if (Model.Pregunta.Condiciones?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Condiciones</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Condiciones)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (Model.Pregunta.Sintomas?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Síntomas</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Sintomas)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (Model.Pregunta.Tratamientos?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Tratamientos</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Tratamientos)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="se-meta">
                            <div class="se-user">
                                @{ var autorHref = !string.IsNullOrWhiteSpace(Model.Pregunta.AutorSlug) ? (siteRoot.TrimEnd('/') + "/u/" + Model.Pregunta.AutorSlug) : (siteRoot.TrimEnd('/') + "/u/" + Model.Pregunta.UsuarioId); }
                                <a href="@autorHref" class="se-author-avatar-link">
                                    <img class="se-author-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                         data-src="@ResolveAvatar(Model.Pregunta.AutorAvatarUrl)"
                                         alt="@Model.Pregunta.AutorNombre" width="48" height="48" decoding="async"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                </a>
                                <div class="se-author-meta">
                                    <a class="se-author-name" href="@autorHref">@Model.Pregunta.AutorNombre</a>
                                    <span>
                                        @if (Model.Pregunta.EsMia)
                                        {
                                            <span style="color:#555;">Preguntaste el:</span>
                                        }
                                        @Model.Pregunta.FechaCreacion.ToLocalTime().ToString("g")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                @* --- Reply box SIEMPRE debajo de la pregunta --- *@
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-header">
                            <i class="bi bi-unlock login-hint-icon"></i>
                            <div class="login-hint-text">Inicia sesión para ver y participar en las respuestas de la comunidad.</div>
                        </div>
                        <div class="login-hint-actions">
                            <a href="/Identity/Account/Register?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-login-hint btn-login-hint-primary"><i class="bi bi-person-plus"></i> Crear cuenta gratis</a>
                            <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-login-hint btn-login-hint-secondary"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a>
                        </div>
                    </div>
                }
                else
                {
                    @* Reply box for authenticated users *@
                    <div class="se-reply-box">
                        <div style="position: relative;">
                            <label for="respuestaBuscar" class="se-answers-label">Revisa que tu aporte sea claro y útil.</label>
                            <textarea id="replyCuerpo" class="se-reply-textarea" placeholder="Escribe tu respuesta..."></textarea>
                            <div><button id="btnSendReply" class="responder-boton" type="button">Publicar respuesta</button></div>
                        </div>
                    </div>
                }

                @* --- Show accepted answer always (visible to bots and users) --- *@
                @if (Model.AcceptedAnswer != null)
                {
                    var a = Model.AcceptedAnswer;
                    // Lógica correcta: deshabilitar solo el botón usado, habilitar el opuesto
                    var rDisableUp = a.UsuarioVoto == 1;    // Deshabilitar upvote solo si ya votó upvote
                    var rDisableDown = (a.Score <= 0) || (a.UsuarioVoto == -1);  // Deshabilitar downvote si score=0 o ya votó downvote
                    var esMia = a.EsMia;
                    <article class="se-answer accepted"
                             data-id="@a.Id"
                             data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                             data-is-mine="@(esMia ? "true" : "false")"
                             data-user-vote="@a.UsuarioVoto"
                             data-score="@a.Score">
                        <div class="se-answer-vote">
                            @if (!User.Identity.IsAuthenticated || esMia)
                            {
                                <button class="se-vote-btn se-vote-up" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▲</button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▼</button>
                            }
                            else
                            {
                                <button class="se-vote-btn se-vote-up @(a.UsuarioVoto == 1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="up"
                                        type="button"
                                        title="Votar +1"
                                        aria-label="Votar +1"
                                        @(rDisableUp ? "disabled" : null)>
                                    ▲
                                </button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down @(a.UsuarioVoto == -1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="down"
                                        type="button"
                                        title="Votar -1"
                                        aria-label="Votar -1"
                                        @(rDisableDown ? "disabled" : null)>
                                    ▼
                                </button>
                            }
                        </div>

                        <div>
                            <div class="se-answer-body">@Html.Raw(a.Cuerpo)</div>
                            <div class="se-answer-meta">
                                <img class="se-resp-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(a.AutorAvatarUrl)" alt="@a.AutorNombre" width="34" height="34" decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                <a class="se-answer-author" href="#">@a.AutorNombre</a>
                                <span>@a.FechaCreacion.ToLocalTime().ToString("g")</span>
                                <span class="se-answer-score">V: <span id="ascore-inline-@a.Id">@a.Score</span></span>
                                @if (esMia)
                                {
                                    <button class="se-delete-btn" data-id="@a.Id" title="Eliminar respuesta">Eliminar</button>
                                }
                            </div>
                        </div>
                    </article>
                }

                @* Answers list: render paged answers but skip accepted one if already shown above *@
                @if (User.Identity.IsAuthenticated)
                {
                    @if (!Model.Respuestas.Any())
                    {
                        <div class="se-empty">Todavía no hay respuestas.</div>
                    }
                    else
                    {
                        <div>
                            @foreach (var a in Model.Respuestas)
                            {
                                if (Model.AcceptedAnswer != null && a.Id == Model.AcceptedAnswer.Id) continue; // avoid duplicate
                                // Lógica correcta: deshabilitar solo el botón usado, habilitar el opuesto
                                var rDisableUp = a.UsuarioVoto == 1;    // Deshabilitar upvote solo si ya votó upvote
                                var rDisableDown = (a.Score <= 0) || (a.UsuarioVoto == -1);  // Deshabilitar downvote si score=0 o ya votó downvote
                                var esMia = a.EsMia;
                                <article class="se-answer"
                                         data-id="@a.Id"
                                         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                                         data-is-mine="@(esMia ? "true" : "false")"
                                         data-user-vote="@a.UsuarioVoto"
                                         data-score="@a.Score">

                                    <div class="se-answer-vote">
                                        @if (!User.Identity.IsAuthenticated || esMia)
                                        {
                                            <button class="se-vote-btn se-vote-up" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▲</button>
                                            <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                            <button class="se-vote-btn se-vote-down" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▼</button>
                                        }
                                        else
                                        {
                                            <button class="se-vote-btn se-vote-up @(a.UsuarioVoto == 1 ? "active" : "")"
                                                    data-id="@a.Id"
                                                    data-dir="up"
                                                    type="button"
                                                    title="Votar +1"
                                                    aria-label="Votar +1"
                                                    @(rDisableUp ? "disabled" : null)>
                                                ▲
                                            </button>
                                            <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                            <button class="se-vote-btn se-vote-down @(a.UsuarioVoto == -1 ? "active" : "")"
                                                    data-id="@a.Id"
                                                    data-dir="down"
                                                    type="button"
                                                    title="Votar -1"
                                                    aria-label="Votar -1"
                                                    @(rDisableDown ? "disabled" : null)>
                                                ▼
                                            </button>
                                        }
                                    </div>

                                    <div>
                                        <div class="se-answer-body">@Html.Raw(a.Cuerpo)</div>
                                        <div class="se-answer-meta">
                                            <img class="se-resp-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                                 data-src="@ResolveAvatar(a.AutorAvatarUrl)" alt="@a.AutorNombre" width="34" height="34" decoding="async"
                                                 onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                            <a class="se-answer-author" href="#">@a.AutorNombre</a>
                                            <span>@a.FechaCreacion.ToLocalTime().ToString("g")</span>
                                            <span class="se-answer-score">V: <span id="ascore-inline-@a.Id">@a.Score</span></span>
                                            @if (esMia)
                                            {
                                                <button class="se-delete-btn" data-id="@a.Id" title="Eliminar respuesta">Eliminar</button>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }

                @* pagination (sin cambios en la lógica) *@
                <div class="preguntas-paginacion" aria-label="Paginación">
                    @if (Model.TotalPages > 1)
                    {
                        int current = Model.AnswersPage;
                        int total = Model.TotalPages;
                        int window = 2;
                        var list = new List<int>();
                        if (total <= 12) { list.AddRange(Enumerable.Range(1, total)); }
                        else
                        {
                            int start = Math.Max(1, current - window);
                            int end = Math.Min(total, current + window);
                            if (start > 1) { list.Add(1); if (start > 2) list.Add(-1); }
                            list.AddRange(Enumerable.Range(start, end - start + 1));
                            if (end < total) { if (end < total - 1) list.Add(-1); list.Add(total); }
                        }

                        Func<int, string> pageUrl = p => Url.Page("/Preguntas/Detalles", new { slug = Model.Pregunta.Slug, answersPage = p, pageSize = Model.PageSize, search = Model.Search }) ?? "#";

                        <div class="pag-bar">
                            <a class="pag-btn @(current == 1 ? "disabled" : "")" aria-label="Primera página" href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                            <a class="pag-btn @(current == 1 ? "disabled" : "")" aria-label="Página anterior" href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>
                            @foreach (var p in list)
                            {
                                if (p == -1)
                                {
                                    <span class="pag-ellipsis" aria-hidden="true">…</span>
                                    ;
                                }
                                else
                                {
                                    var active = p == current ? "active" : "";

                                    <a class="pag-num @active" aria-label="Página @p" aria-current="@(active == "active" ? "page" : null)" href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                                    ;
                                }
                            }
                            <a class="pag-btn @(current == total ? "disabled" : "")" aria-label="Página siguiente" href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                            <a class="pag-btn @(current == total ? "disabled" : "")" aria-label="Última página" href="@(current == total ? "#" : pageUrl(total))">»</a>

                            <div class="pag-info">
                                <span>Total: @Model.TotalItems registros</span>
                                <span>Página @Model.AnswersPage de @Model.TotalPages</span>
                                <form method="get" class="pag-size-inline" id="inlineSizeForm2">
                                    <input type="hidden" name="slug" value="@Model.Pregunta.Slug" />
                                    <input type="hidden" name="answersPage" value="1" />
                                    <label for="inlinePageSize2">Tamaño</label>
                                    <select id="inlinePageSize2" name="pageSize" onchange="document.getElementById('inlineSizeForm2').submit();">
                                        @{
                                            var sizes3 = new[] { 10, 12, 30, 60, 100 };
                                        }
                                        @foreach (var s in sizes3)
                                        {
                                            <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                                        }
                                    </select>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ===== LAZY LOAD AVATARS =====
            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { img.src = '@Url.Content("~/img/avatar-placeholder.png")'; return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = () => { img.src = src; img.classList.add('loaded'); };
                    tmp.onerror = () => { img.src = '@Url.Content("~/img/avatar-placeholder.png")'; img.classList.add('loaded'); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver(entries => {
                        entries.forEach(e => {
                            if (e.isIntersecting) {
                                io.unobserve(e.target);
                                loadImg(e.target);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => io.observe(i));
                } else {
                    imgs.forEach(loadImg);
                }
            }

            // ===== VOTING HANDLER (QUESTIONS & ANSWERS) =====
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.se-vote-btn');
                if (!btn) return;

                // Determine if this is a question or answer
                const article = btn.closest('.se-item, .se-answer');
                if (!article) return;

                const isAuth = article.getAttribute('data-authenticated') === 'true';
                const isMine = article.getAttribute('data-is-mine') === 'true';
                const id = article.getAttribute('data-id');
                if (!id) return;

                if (!isAuth) { 
                    const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                    if (confirm('Inicia sesión para votar. ¿Ir a login?')) {
                        window.location.href = '/Identity/Account/Login?returnUrl=' + returnUrl;
                    }
                    return; 
                }
                if (isMine) { 
                    alert(article.classList.contains('se-item') 
                        ? 'No puedes votar tu propia pregunta.' 
                        : 'No puedes votar tu propia respuesta.'); 
                    return; 
                }

                const dir = btn.getAttribute('data-dir');
                const currentScore = parseInt(article.getAttribute('data-score') || '0', 10);

                // Validación: no permitir downvote si score ya es 0
                if (dir === 'down' && currentScore <= 0) {
                    return;
                }

                const upBtn = article.querySelector('.se-vote-up');
                const downBtn = article.querySelector('.se-vote-down');
                if (upBtn) upBtn.disabled = true;
                if (downBtn) downBtn.disabled = true;

                const valor = dir === 'up' ? 1 : -1;
                const isQuestion = article.classList.contains('se-item');
                const apiUrl = isQuestion 
                    ? '/api/preguntas/' + id + '/votar'
                    : '/api/respuestas/' + id + '/votar';

                try {
                    const res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ valor })
                    });

                    if (!res.ok) {
                        alert('Error al votar');
                        return;
                    }

                    const j = await res.json();
                    const scoreElId = isQuestion ? 'qscore-' + id : 'ascore-' + id;
                    const scoreEl = document.getElementById(scoreElId);
                    const scoreInlineEl = document.getElementById('ascore-inline-' + id);

                    const newScore = (j.score !== undefined) ? parseInt(j.score, 10) : currentScore;
                    const newUserVote = (j.userVote !== undefined) ? parseInt(j.userVote, 10) : 0;

                    if (scoreEl) scoreEl.textContent = String(newScore);
                    if (scoreInlineEl) scoreInlineEl.textContent = String(newScore);
                    article.setAttribute('data-score', String(newScore));
                    article.setAttribute('data-user-vote', String(newUserVote));

                    if (upBtn) {
                        if (newUserVote === 1) upBtn.classList.add('active'); else upBtn.classList.remove('active');
                        upBtn.disabled = newUserVote === 1;  // Deshabilitar solo si votó upvote
                    }
                    if (downBtn) {
                        if (newUserVote === -1) downBtn.classList.add('active'); else downBtn.classList.remove('active');
                        downBtn.disabled = (newScore <= 0) || (newUserVote === -1);  // Deshabilitar si score=0 o votó downvote
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de red al votar');
                } finally {
                    const finalScore = parseInt(article.getAttribute('data-score') || '0', 10);
                    const finalUserVote = parseInt(article.getAttribute('data-user-vote') || '0', 10);
                    if (upBtn) upBtn.disabled = finalUserVote === 1;  // Deshabilitar solo si votó upvote
                    if (downBtn) downBtn.disabled = (finalScore <= 0) || (finalUserVote === -1);  // Deshabilitar si score=0 o votó downvote
                }
            });

            // ===== PUBLISH ANSWER =====
            const btnSendReply = document.getElementById('btnSendReply');
            if (btnSendReply) {
                btnSendReply.addEventListener('click', async function () {
                    const textarea = document.getElementById('replyCuerpo');
                    if (!textarea) return;

                    const cuerpo = textarea.value.trim();
                    if (!cuerpo) {
                        alert('Por favor escribe una respuesta.');
                        return;
                    }

                    const preguntaId = '@Model.Pregunta?.Id';
                    if (!preguntaId) return;

                    btnSendReply.disabled = true;
                    btnSendReply.textContent = 'Publicando...';

                    try {
                        const res = await fetch('/api/respuestas', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'X-Pregunta-Id': preguntaId
                            },
                            body: JSON.stringify({ 
                                cuerpo: cuerpo,
                                preguntaId: preguntaId
                            })
                        });

                        if (!res.ok) {
                            const errorText = await res.text();
                            console.error('Error response:', errorText);
                            alert('Error al publicar respuesta: ' + (errorText || res.statusText));
                            return;
                        }

                        // Recargar página para mostrar la nueva respuesta
                        window.location.reload();
                    } catch (err) {
                        console.error(err);
                        alert('Error de red al publicar respuesta');
                    } finally {
                        btnSendReply.disabled = false;
                        btnSendReply.textContent = 'Publicar respuesta';
                    }
                });
            }

            // ===== DELETE ANSWER =====
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.se-delete-btn');
                if (!btn) return;

                const id = btn.getAttribute('data-id');
                if (!id) return;

                if (!confirm('¿Estás seguro de eliminar esta respuesta?')) return;

                btn.disabled = true;
                btn.textContent = 'Eliminando...';

                try {
                    const res = await fetch('/api/respuestas/' + id + '/eliminar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (!res.ok) {
                        const errorText = await res.text();
                        console.error('Error response:', errorText);
                        alert('Error al eliminar respuesta: ' + (errorText || res.statusText));
                        return;
                    }

                    // Recargar página para reflejar el cambio
                    window.location.reload();
                } catch (err) {
                    console.error(err);
                    alert('Error de red al eliminar respuesta');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Eliminar';
                }
            });

            // Initialize
            document.addEventListener('DOMContentLoaded', initLazyAvatars);
            if (document.readyState === 'interactive' || document.readyState === 'complete') initLazyAvatars();
        })();
    </script>
}
