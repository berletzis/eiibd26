@page "/Preguntas/{slug}"
@model eiibd26.Pages.Preguntas.DetallesModel
@using System.Text.Encodings.Web
@using System.Text.Json
@{
    ViewData["Title"] = Model.Pregunta?.Titulo ?? "Pregunta";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        avatar = avatar.Replace("\\", "/").Trim();
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("~/")) avatar = avatar.TrimStart('~', '/');
        if (avatar.StartsWith("/")) avatar = avatar.TrimStart('/');
        return Url.Content("~/" + avatar);
    }

    string StripHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        return System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " ").Trim();
    }

    string JsonEncode(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return JsonEncodedText.Encode(text, JavaScriptEncoder.UnsafeRelaxedJsonEscaping).ToString();
    }
}

@section Head {
    @if (Model.Pregunta != null)
    {
        var acceptedAnswer = Model.Respuestas.OrderByDescending(r => r.Score).FirstOrDefault();
        var answerCount = Model.TotalItems;
        var cleanBody = StripHtml(Model.Pregunta.Cuerpo);
        var description = cleanBody.Length > 160 ? cleanBody.Substring(0, 157) + "..." : cleanBody;
        var canonicalUrl = $"{Request.Scheme}://{Request.Host}/Preguntas/{Model.Pregunta.Slug}";

        @* Schema.org JSON-LD para Google *@
        <script type="application/ld+json">
                {
                  "@@context": "https://schema.org",
                  "@@type": "QAPage",
                  "mainEntity": {
                    "@@type": "Question",
                    "name": "@JsonEncode(Model.Pregunta.Titulo)",
                    "text": "@JsonEncode(cleanBody)",
                    "answerCount": @answerCount,
                    "dateCreated": "@Model.Pregunta.FechaCreacion.ToString("o")",
                    "author": {
                      "@@type": "Person",
                      "name": "@JsonEncode(Model.Pregunta.AutorNombre)"
                    },
                    "upvoteCount": @Model.Pregunta.Score@if (acceptedAnswer != null || Model.Respuestas.Any()){
                    <text>,</text>
            }
            @if (acceptedAnswer != null)
            {
                        var cleanAnswer = StripHtml(acceptedAnswer.Cuerpo);
                        <text>
                    "acceptedAnswer": {
                      "@@type": "Answer",
                      "text": "@JsonEncode(cleanAnswer)",
                      "dateCreated": "@acceptedAnswer.FechaCreacion.ToString("o")",
                      "upvoteCount": @acceptedAnswer.Score,
                      "author": {
                        "@@type": "Person",
                        "name": "@JsonEncode(acceptedAnswer.AutorNombre)"
                      }
                    }</text>
                        if (Model.Respuestas.Count > 1)
                        {

                            <text>,</text>
                    }
            }
            @if (Model.Respuestas.Any())
            {
                        var otherAnswers = Model.Respuestas.Where(a => a.Id != acceptedAnswer?.Id).Take(5).ToList();
                        if (otherAnswers.Any())
                        {
                                    <text>
                            "suggestedAnswer": [</text>
                                    for (int i = 0; i < otherAnswers.Count; i++)
                                    {
                                                var ans = otherAnswers[i];
                                                var cleanAns = StripHtml(ans.Cuerpo);
                                                <text>
                                      {
                                        "@@type": "Answer",
                                        "text": "@JsonEncode(cleanAns)",
                                        "dateCreated": "@ans.FechaCreacion.ToString("o")",
                                        "upvoteCount": @ans.Score,
                                        "author": {
                                          "@@type": "Person",
                                          "name": "@JsonEncode(ans.AutorNombre)"
                                        }
                                      }@(i < otherAnswers.Count - 1 ? "," : "")</text>
                                    }
                                    <text>
                            ]</text>
                        }
            }
          }
        }
    </script>

    @* Meta tags para SEO *@
    <meta name="description" content="@description">
    <link rel="canonical" href="@canonicalUrl">

    @* Open Graph *@
    <meta property="og:title" content="@Model.Pregunta.Titulo">
    <meta property="og:description" content="@description">
    <meta property="og:type" content="article">
    <meta property="og:url" content="@canonicalUrl">

    @* Twitter Card *@
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="@Model.Pregunta.Titulo">
    <meta name="twitter:description" content="@description">
}
}

@section Styles {
