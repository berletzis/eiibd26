            color: #6b7280;
            font-size: 0.85rem;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-top: 0px;
            margin-bottom: 6px;
        }

        .se-page-title {
            margin-bottom: 0px;
        }

        .mb-3 {
            margin-bottom: 6px !important;
        }

        .se-card-title {
            margin: 0 0 8px 0;
            font-size: 1.05rem;
            font-weight: 400;
            color: #0f172a;
        }

        .se-item {
            margin-bottom: 1rem;
        }

        /* Estilo mejorado para login hints - IDÉNTICO a contenidos */
        .login-hint-box {
            padding: 0.875rem 1rem;
            margin-top: 1rem;
            margin-bottom: 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
