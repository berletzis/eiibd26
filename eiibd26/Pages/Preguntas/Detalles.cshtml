@page "{id:guid}"
@model eiibd26.Pages.Preguntas.DetallesModel
@{
    ViewData["Title"] = Model.Pregunta?.Titulo ?? "Pregunta";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas-stack.css" />
}

<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="se-post-wrapper">
    @if (Model.Pregunta == null)
    {
        <div class="se-empty">La pregunta no existe o fue eliminada.</div>
    }
    else
    {
        var disableUp = Model.Pregunta.UsuarioVoto != 0;
        var disableDown = Model.Pregunta.Score <= 0;
        <article class="se-post"
                 data-id="@Model.Pregunta.Id"
                 data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                 data-is-mine="@(Model.Pregunta.EsMia ? "true" : "false")"
                 data-user-vote="@Model.Pregunta.UsuarioVoto"
                 data-score="@Model.Pregunta.Score">

            <!-- Votos pregunta -->
            <div class="se-post-vote">
                @if (!User.Identity.IsAuthenticated || Model.Pregunta.EsMia)
                {
                    <button class="se-vote-btn se-vote-up" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"></button>
                    <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                    <button class="se-vote-btn se-vote-down" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"></button>
                }
                else
                {
                    <button class="se-vote-btn se-vote-up @(Model.Pregunta.UsuarioVoto == 1 ? "active" : "")"
                            data-id="@Model.Pregunta.Id"
                            data-dir="up"
                            type="button"
                            title="Votar +1"
                            aria-label="Votar +1"
                            @(disableUp ? "disabled" : null)></button>
                    <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                    <button class="se-vote-btn se-vote-down @(Model.Pregunta.UsuarioVoto == -1 ? "active" : "")"
                            data-id="@Model.Pregunta.Id"
                            data-dir="down"
                            type="button"
                            title="Votar -1"
                            aria-label="Votar -1"
                            @(disableDown ? "disabled" : null)></button>
                }
            </div>

            <!-- Contenido pregunta -->
            <div class="se-post-content">
                <h1 class="se-post-title">@Model.Pregunta.Titulo</h1>
                <div class="se-post-body">@Html.Raw(Model.Pregunta.Cuerpo)</div>

                @if ((Model.Pregunta.Condiciones?.Any() ?? false) || (Model.Pregunta.Sintomas?.Any() ?? false) || (Model.Pregunta.Tratamientos?.Any() ?? false))
                {
                    <div class="se-relations">
                        @if (Model.Pregunta.Condiciones?.Any() ?? false)
                        {
                            <div class="se-rel-group">
                                <span class="se-rel-label">condiciones</span>
                                <div class="se-rel-badges">
                                    @foreach (var n in Model.Pregunta.Condiciones)
                                    {
                                        <span class="se-rel-badge">@n</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.Pregunta.Sintomas?.Any() ?? false)
                        {
                            <div class="se-rel-group">
                                <span class="se-rel-label">síntomas</span>
                                <div class="se-rel-badges">
                                    @foreach (var n in Model.Pregunta.Sintomas)
                                    {
                                        <span class="se-rel-badge">@n</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.Pregunta.Tratamientos?.Any() ?? false)
                        {
                            <div class="se-rel-group">
                                <span class="se-rel-label">tratamientos</span>
                                <div class="se-rel-badges">
                                    @foreach (var n in Model.Pregunta.Tratamientos)
                                    {
                                        <span class="se-rel-badge">@n</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="se-author-box">
                    <img class="se-author-avatar lazy-avatar"
                         src="@Url.Content("~/img/avatar-placeholder.png")"
                         data-src="@ResolveAvatar(Model.Pregunta.AutorAvatarUrl)"
                         alt="@Model.Pregunta.AutorNombre"
                         width="48" height="48"
                         decoding="async"
                         onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                    <div class="se-author-meta">
                        <a class="se-author-name" href="#">@Model.Pregunta.AutorNombre</a>
                        <span>Publicado @Model.Pregunta.FechaCreacion.ToLocalTime().ToString("g")</span>
                        @if (Model.Pregunta.EsMia)
                        {
                            <span style="color:#555;">(tu pregunta)</span>
                        }
                    </div>
                </div>
            </div>
        </article>

        <!-- Form Responder -->
        <div class="se-reply-box">
            @if (!User.Identity.IsAuthenticated)
            {
                <div class="vote-login-hint">
                    Inicia sesión para responder.
                    <a href="/Account/Login">Iniciar sesión</a>
                </div>
            }
            else
            {
                <div class="se-reply-title">Tu respuesta</div>
                <textarea id="replyCuerpo" class="se-reply-textarea" placeholder="Escribe tu respuesta..."></textarea>
                <div style="margin-top:8px;" class="se-inline-flex">
                    <button id="btnSendReply" class="se-btn se-btn-primary" type="button">Publicar respuesta</button>
                    <small class="text-muted">Revisa que tu aporte sea claro y útil.</small>
                </div>
            }
        </div>

        <!-- Lista Respuestas -->
        <div class="se-answers-header">
            <h2>@Model.TotalItems respuesta(s)</h2>
            <span class="se-total">@Model.TotalItems total</span>
        </div>

        @if (!User.Identity.IsAuthenticated)
        {
            <div class="se-empty">Inicia sesión para ver las respuestas. <a href="/Account/Login">Iniciar sesión</a></div>
        }
        else
        {
            @if (!Model.Respuestas.Any())
            {
                <div class="se-empty">Todavía no hay respuestas.</div>
            }
            else
            {
                foreach (var a in Model.Respuestas)
                {
                    var rDisableUp = a.UsuarioVoto != 0;
                    var rDisableDown = a.Score <= 0;
                    var esMia = a.EsMia;
                    <article class="se-answer"
                             data-id="@a.Id"
                             data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                             data-is-mine="@(esMia ? "true" : "false")"
                             data-user-vote="@a.UsuarioVoto"
                             data-score="@a.Score">

                        <div class="se-answer-vote">
                            @if (!User.Identity.IsAuthenticated || esMia)
                            {
                                <button class="se-vote-btn se-vote-up" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")"></button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")"></button>
                            }
                            else
                            {
                                <button class="se-vote-btn se-vote-up @(a.UsuarioVoto == 1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="up"
                                        type="button"
                                        title="Votar +1"
                                        aria-label="Votar +1"
                                        @(rDisableUp ? "disabled" : null)></button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down @(a.UsuarioVoto == -1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="down"
                                        type="button"
                                        title="Votar -1"
                                        aria-label="Votar -1"
                                        @(rDisableDown ? "disabled" : null)></button>
                            }
                        </div>

                        <div>
                            <div class="se-answer-body">@Html.Raw(a.Cuerpo)</div>
                            <div class="se-answer-meta">
                                <img class="se-resp-avatar lazy-avatar"
                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(a.AutorAvatarUrl)"
                                     alt="@a.AutorNombre"
                                     width="34" height="34"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                <a class="se-answer-author" href="#">@a.AutorNombre</a>
                                <span>@a.FechaCreacion.ToLocalTime().ToString("g")</span>
                                <span class="se-answer-score">score: <span id="ascore-inline-@a.Id">@a.Score</span></span>
                                @if (esMia)
                                {
                                    <button class="se-delete-btn" data-id="@a.Id" title="Eliminar respuesta">Eliminar</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        }

        <!-- Paginación respuestas -->
        <nav class="se-pagination" aria-label="Paginación respuestas">
            @{
                var prev = Model.Page > 1 ? Model.Page - 1 : 1;
                var next = Model.Page < Model.TotalPages ? Model.Page + 1 : Model.TotalPages;
                var qsBase = $"?id={Model.Id}&pageSize={Model.PageSize}&search={Uri.EscapeDataString(Model.Search ?? "")}";
            }
            <a class="se-btn se-btn-ghost" href="@($"{qsBase}&page={prev}")">Anterior</a>
            <span class="se-page-indicator">Página <strong>@Model.Page</strong> de <strong>@Model.TotalPages</strong></span>
            <a class="se-btn se-btn-ghost" href="@($"{qsBase}&page={next}")">Siguiente</a>
        </nav>
    }
</div>

@section Scripts {
    <script>
        (function () {

            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const onLoad = img => img.classList.add('loaded');
                const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { onError(img); return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = function () { try { img.src = src; } catch{} onLoad(img); };
                    tmp.onerror = function () { onError(img); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                observer.unobserve(img);
                                loadImg(img);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => {
                        if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) io.observe(i);
                        else if (i.getAttribute('data-src')) i.classList.add('loaded');
                    });
                } else imgs.forEach(i => loadImg(i));
            }

            async function sendReply(preguntaId, cuerpo){
                const res = await fetch('/api/respuestas', {
                    method:'POST',
                    headers:{'Content-Type':'application/json','X-Pregunta-Id':preguntaId},
                    body:JSON.stringify({ cuerpo })
                });
                return res;
            }

            const replyBtn = document.getElementById('btnSendReply');
            if (replyBtn){
                replyBtn.addEventListener('click', async ()=>{
                    const ta = document.getElementById('replyCuerpo');
                    const txt = (ta.value||'').trim();
                    if(!txt){ alert('Escribe tu respuesta.'); return; }
                    replyBtn.disabled = true;
                    try{
                        const res = await sendReply('@Model.Id', txt);
                        if(!res.ok){
                            const t = await res.text();
                            alert('Error al publicar: ' + t);
                        } else {
                            location.reload();
                        }
                    }catch(e){
                        console.error(e);
                        alert('Error de red');
                    }finally{
                        replyBtn.disabled = false;
                    }
                });
            }

            // Votación delegada (pregunta y respuestas)
            document.addEventListener('click', async function(e){
                const voteBtn = e.target.closest('.se-vote-btn');
                if(!voteBtn) return;

                const parent = voteBtn.closest('.se-post, .se-answer');
                if(!parent) return;

                const isQuestion = parent.classList.contains('se-post');
                const id = parent.getAttribute('data-id');
                const dir = voteBtn.getAttribute('data-dir'); // up or down
                if(!id || !dir) return;

                const currentScore = parseInt(parent.getAttribute('data-score')||'0',10);
                const currentUserVote = parseInt(parent.getAttribute('data-user-vote')||'0',10);

                // Reglas:
                // 1. Up sólo si userVote == 0
                if (dir === 'up' && currentUserVote !== 0) return;
                // 2. Down sólo si score > 0 (evitar negativos)
                if (dir === 'down' && currentScore <= 0) return;

                // Deshabilitar temporal ambos botones
                const upBtn = parent.querySelector('.se-vote-up');
                const downBtn = parent.querySelector('.se-vote-down');
                if(upBtn) upBtn.disabled = true;
                if(downBtn) downBtn.disabled = true;

                const valor = dir === 'up' ? 1 : -1;
                const endpoint = isQuestion ? '/api/preguntas/' + id + '/votar' : '/api/respuestas/' + id + '/votar';

                try{
                    const res = await fetch(endpoint, {
                        method:'POST',
                        headers:{'Content-Type':'application/json'},
                        body:JSON.stringify({ valor })
                    });
                    if(!res.ok){
                        const txt = await res.text();
                        alert('Error al votar: ' + (txt || res.status));
                        return;
                    }
                    const j = await res.json();
                    const newScore = (j.score !== undefined) ? parseInt(j.score,10) : currentScore + (valor);
                    const newUserVote = (j.userVote !== undefined) ? parseInt(j.userVote,10) : (valor === 1 ? 1 : -1);

                    parent.setAttribute('data-score', String(newScore));
                    parent.setAttribute('data-user-vote', String(newUserVote));

                    // Actualizar contador (pregunta o respuesta)
                    const scoreElId = (isQuestion ? 'qscore-' : 'ascore-') + id;
                    const scoreEl = document.getElementById(scoreElId);
                    if(scoreEl){
                        scoreEl.textContent = newScore;
                    }
                    // inline small score
                    if(!isQuestion){
                        const inlineScore = document.getElementById('ascore-inline-' + id);
                        if(inlineScore) inlineScore.textContent = newScore;
                    }

                    // Estado visual
                    if(upBtn){
                        if(newUserVote === 1) upBtn.classList.add('active'); else upBtn.classList.remove('active');
                        // Si ya votó, deshabilitar up
                        upBtn.disabled = (newUserVote !== 0);
                    }
                    if(downBtn){
                        if(newUserVote === -1) downBtn.classList.add('active'); else downBtn.classList.remove('active');
                        // Down se deshabilita si score quedó 0
                        downBtn.disabled = (newScore <= 0);
                    }

                    // Reordenar respuestas por score (opcional)
                    if(!isQuestion){
                        reorderAnswers();
                    }
                }catch(err){
                    console.error('Error votando', err);
                    alert('Error de red al votar');
                }finally{
                    // Reaplicar reglas si no se aplicó arriba
                    if(upBtn && !upBtn.disabled) upBtn.disabled = (parseInt(parent.getAttribute('data-user-vote')||'0',10) != 0);
                    if(downBtn && !downBtn.disabled) downBtn.disabled = (parseInt(parent.getAttribute('data-score')||'0',10) <= 0);
                }
            });

            // Eliminar respuesta
            document.addEventListener('click', async function(e){
                const del = e.target.closest('.se-delete-btn');
                if(!del) return;
                const card = del.closest('.se-answer');
                if(!card) return;
                const id = card.getAttribute('data-id');
                if(!id) return;
                if(!confirm('¿Eliminar esta respuesta?')) return;
                del.disabled = true;
                try{
                    const res = await fetch('/api/respuestas/' + id + '/eliminar', { method: 'POST', headers: {'Content-Type':'application/json'}});
                    if(!res.ok){
                        const txt = await res.text();
                        alert('Error al eliminar: ' + (txt || res.status));
                        return;
                    }
                    const j = await res.json();
                    if(j.ok){
                        card.remove();
                    } else {
                        alert('No se pudo eliminar.');
                    }
                }catch(err){
                    console.error(err);
                    alert('Error de red');
                }finally{
                    del.disabled = false;
                }
            });

            function reorderAnswers(){
                const container = document.querySelectorAll('.se-answer');
                if(!container.length) return;
                const parent = container[0].parentElement;
                if(!parent) return;
                const answers = Array.from(container);
                answers.sort((a,b)=>{
                    const sa = parseInt(a.getAttribute('data-score')||'0',10);
                    const sb = parseInt(b.getAttribute('data-score')||'0',10);
                    if(sb === sa) return 0;
                    return sb - sa;
                });
                answers.forEach(a=>parent.appendChild(a));
            }

            initLazyAvatars();
        })();
    </script>
}