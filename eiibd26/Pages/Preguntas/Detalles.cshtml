            color: #764ba2;
            flex-shrink: 0;
        }

        .login-hint-text {
            color: #4b5563;
            font-size: 0.9rem;
            font-weight: 400;
            line-height: 1.4;
        }

        .login-hint-actions {
            display: flex;
            gap: 0.65rem;
        }

        .btn-login-hint {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 400;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
