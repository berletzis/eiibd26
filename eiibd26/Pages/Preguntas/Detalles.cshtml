@page "/Preguntas/Detalles/{slug?}"
@model eiibd26.Pages.Preguntas.DetallesModel
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Collections.Generic

@{
    ViewData["Title"] = Model.Pregunta?.Titulo ?? "Pregunta";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        avatar = avatar.Replace("\\", "/").Trim();
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("~/")) avatar = avatar.TrimStart('~', '/');
        if (avatar.StartsWith("/")) avatar = avatar.TrimStart('/');
        return Url.Content("~/" + avatar);
    }

    string StripHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var noScript = System.Text.RegularExpressions.Regex.Replace(html, @"<script[\s\S]*?>[\s\S]*?</script>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        noScript = System.Text.RegularExpressions.Regex.Replace(noScript, @"<style[\s\S]*?>[\s\S]*?</style>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var text = System.Text.RegularExpressions.Regex.Replace(noScript, @"<[^>]+>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text;
    }
}

@section Head {
    @if (Model.Pregunta != null)
    {
        // Prepare values
        var accepted = Model.AcceptedAnswer;
        var suggested = Model.TopSuggestedAnswers ?? new List<eiibd26.Pages.Preguntas.DetallesModel.RespuestaVm>();
        var answerCount = Model.TotalItems;
        var cleanBody = StripHtml(Model.Pregunta.Cuerpo);
        var description = cleanBody.Length > 160 ? cleanBody.Substring(0, 157) + "..." : cleanBody;

        // Prefer SEO-friendly /Preguntas/{slug} when slug exists, otherwise use Detalles?id=
        var canonicalUrl = !string.IsNullOrWhiteSpace(Model.Pregunta.Slug)
            ? $"{Request.Scheme}://{Request.Host}/Preguntas/{Model.Pregunta.Slug}"
            : $"{Request.Scheme}://{Request.Host}/Preguntas/Detalles?id={Model.Pregunta.Id}";

        // Build JSON-LD structure
        var mainEntity = new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = Model.Pregunta.Titulo ?? "",
            ["text"] = cleanBody ?? "",
            ["answerCount"] = answerCount,
            ["dateCreated"] = Model.Pregunta.FechaCreacion.ToString("o"),
            ["author"] = new Dictionary<string, object>
            {
                ["@type"] = "Person",
                ["name"] = Model.Pregunta.AutorNombre ?? "Usuario"
            }
        };

        if (accepted != null)
        {
            mainEntity["acceptedAnswer"] = new Dictionary<string, object>
            {
                ["@type"] = "Answer",
                ["text"] = StripHtml(accepted.Cuerpo) ?? "",
                ["dateCreated"] = accepted.FechaCreacion.ToString("o"),
                ["upvoteCount"] = accepted.Score,
                ["author"] = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = accepted.AutorNombre ?? "Usuario" }
            };
        }

        if (suggested.Any())
        {
            var list = new List<Dictionary<string, object>>();
            foreach (var a in suggested)
            {
                // don't include accepted again
                if (accepted != null && a.Id == accepted.Id) continue;
                list.Add(new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = StripHtml(a.Cuerpo) ?? "",
                    ["dateCreated"] = a.FechaCreacion.ToString("o"),
                    ["upvoteCount"] = a.Score,
                    ["author"] = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = a.AutorNombre ?? "Usuario" }
                });
            }
            if (list.Any()) mainEntity["suggestedAnswer"] = list;
        }

        var ld = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "QAPage",
            ["mainEntity"] = mainEntity
        };

        var jsonOptions = new JsonSerializerOptions { WriteIndented = true, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
        var ldJson = JsonSerializer.Serialize(ld, jsonOptions);
        <text>
            <script type="application/ld+json">
                @Html.Raw(ldJson)
            </script>

            <meta name="description" content="@description" />
            <meta name="robots" content="index,follow" />
            <link rel="canonical" href="@canonicalUrl" />

            <!-- Open Graph / Twitter -->
            <meta property="og:title" content="@Model.Pregunta.Titulo" />
            <meta property="og:description" content="@description" />
            <meta property="og:type" content="QAPage" />
            <meta property="og:url" content="@canonicalUrl" />
            <meta name="twitter:card" content="summary" />
            <meta name="twitter:title" content="@Model.Pregunta.Titulo" />
            <meta name="twitter:description" content="@description" />
        </text>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        /* estilos originales intactos */
        .se-subtitle {
            color: #6b7280;
            font-size: 0.85rem;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-top: 0px;
            margin-bottom: 6px;
        }

        .se-page-title {
            margin-bottom: 0px;
        }

        .mb-3 {
            margin-bottom: 6px !important;
        }

        .se-card-title {
            margin: 0 0 8px 0;
            font-size: 1.05rem;
            font-weight: 400;
            color: #0f172a;
        }

        .se-item {
            margin-bottom: 1rem;
        }

        .login-hint-box {
            padding: 0.875rem 1rem;
            margin-top: 1rem;
            margin-bottom: 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .login-hint-header {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .login-hint-icon {
            font-size: 1.5rem;
            color: #764ba2;
            flex-shrink: 0;
        }

        .login-hint-text {
            color: #4b5563;
            font-size: 0.9rem;
            font-weight: 400;
            line-height: 1.4;
        }

        .login-hint-actions {
            display: flex;
            gap: 0.65rem;
        }

        .btn-login-hint {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 400;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .btn-login-hint-primary {
            background: #764ba2;
            color: white;
            border-color: #764ba2;
        }

        .btn-login-hint-secondary {
            background: white;
            color: #764ba2;
            border-color: #764ba2;
        }
    </style>
}

<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="container py-4">
    @if (Model.Pregunta != null)
    {
        <div class="mb-3">
            <h1 class="se-page-title">@Model.Pregunta.Titulo</h1>
            <div class="se-subtitle">Pregunta</div>
        </div>
    }

    <div class="qp-wrapper-flex">
        <div class="qp-main">
            @if (Model.Pregunta == null)
            {
                <div class="se-empty">La pregunta no existe o fue eliminada.</div>
            }
            else
            {
                var disableUp = Model.Pregunta.UsuarioVoto != 0;
                var disableDown = Model.Pregunta.Score <= 0;

                <article class="se-item"
                         data-id="@Model.Pregunta.Id"
                         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                         data-is-mine="@(Model.Pregunta.EsMia ? "true" : "false")"
                         data-user-vote="@Model.Pregunta.UsuarioVoto"
                         data-score="@Model.Pregunta.Score">

                    <div class="se-vote">
                        @if (!User.Identity.IsAuthenticated || Model.Pregunta.EsMia)
                        {
                            <button class="se-vote-btn se-vote-up" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")">▲</button>
                            <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                            <button class="se-vote-btn se-vote-down" disabled title="@(Model.Pregunta.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")">▼</button>
                        }
                        else
                        {
                            <button class="se-vote-btn se-vote-up @(Model.Pregunta.UsuarioVoto == 1 ? "active" : "")"
                                    data-id="@Model.Pregunta.Id"
                                    data-dir="up"
                                    type="button"
                                    title="Votar +1"
                                    aria-label="Votar +1"
                                    @(disableUp ? "disabled" : null)>
                                ▲
                            </button>
                            <div class="se-vote-count" id="qscore-@Model.Pregunta.Id">@Model.Pregunta.Score</div>
                            <button class="se-vote-btn se-vote-down @(Model.Pregunta.UsuarioVoto == -1 ? "active" : "")"
                                    data-id="@Model.Pregunta.Id"
                                    data-dir="down"
                                    type="button"
                                    title="Votar -1"
                                    aria-label="Votar -1"
                                    @(disableDown ? "disabled" : null)>
                                ▼
                            </button>
                        }
                    </div>

                    <div class="se-summary">
                        <h2 class="se-card-title">@Model.Pregunta.Titulo</h2>

                        <div class="se-excerpt">@Html.Raw(Model.Pregunta.Cuerpo)</div>
                        <div class="se-answers-float answered" title="Respuestas totales">
                            <span class="se-answers-float-count">@Model.TotalItems</span>
                            <span class="se-answers-float-label">Respuesta(s)</span>
                        </div>

                        @if ((Model.Pregunta.Condiciones?.Any() ?? false) || (Model.Pregunta.Sintomas?.Any() ?? false) || (Model.Pregunta.Tratamientos?.Any() ?? false))
                        {
                            <div class="se-relations">
                                @if (Model.Pregunta.Condiciones?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Condiciones</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Condiciones)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (Model.Pregunta.Sintomas?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Síntomas</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Sintomas)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (Model.Pregunta.Tratamientos?.Any() ?? false)
                                {
                                    <div class="se-rel-group">
                                        <span class="se-rel-label">Tratamientos</span>
                                        <div class="se-rel-badges">
                                            @foreach (var n in Model.Pregunta.Tratamientos)
                                            {
                                                <span class="se-rel-badge">@n</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="se-meta">
                            <div class="se-user">
                                <img class="se-author-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(Model.Pregunta.AutorAvatarUrl)"
                                     alt="@Model.Pregunta.AutorNombre" width="48" height="48" decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                <div class="se-author-meta">
                                    <a class="se-author-name" href="#">@Model.Pregunta.AutorNombre</a>
                                    <span>
                                        @if (Model.Pregunta.EsMia)
                                        {
                                            <span style="color:#555;">Preguntaste el:</span>
                                        }
                                        @Model.Pregunta.FechaCreacion.ToLocalTime().ToString("g")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                @* --- Show accepted answer always (visible to bots and users) --- *@
                @if (Model.AcceptedAnswer != null)
                {
                    var a = Model.AcceptedAnswer;
                    var rDisableUp = a.UsuarioVoto != 0;
                    var rDisableDown = a.Score <= 0;
                    var esMia = a.EsMia;
                    <article class="se-answer accepted"
                             data-id="@a.Id"
                             data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                             data-is-mine="@(esMia ? "true" : "false")"
                             data-user-vote="@a.UsuarioVoto"
                             data-score="@a.Score">
                        <div class="se-answer-vote">
                            @if (!User.Identity.IsAuthenticated || esMia)
                            {
                                <button class="se-vote-btn se-vote-up" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▲</button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▼</button>
                            }
                            else
                            {
                                <button class="se-vote-btn se-vote-up @(a.UsuarioVoto == 1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="up"
                                        type="button"
                                        title="Votar +1"
                                        aria-label="Votar +1"
                                        @(rDisableUp ? "disabled" : null)>
                                    ▲
                                </button>
                                <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                <button class="se-vote-btn se-vote-down @(a.UsuarioVoto == -1 ? "active" : "")"
                                        data-id="@a.Id"
                                        data-dir="down"
                                        type="button"
                                        title="Votar -1"
                                        aria-label="Votar -1"
                                        @(rDisableDown ? "disabled" : null)>
                                    ▼
                                </button>
                            }
                        </div>

                        <div>
                            <div class="se-answer-body">@Html.Raw(a.Cuerpo)</div>
                            <div class="se-answer-meta">
                                <img class="se-resp-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(a.AutorAvatarUrl)" alt="@a.AutorNombre" width="34" height="34" decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                <a class="se-answer-author" href="#">@a.AutorNombre</a>
                                <span>@a.FechaCreacion.ToLocalTime().ToString("g")</span>
                                <span class="se-answer-score">V: <span id="ascore-inline-@a.Id">@a.Score</span></span>
                                @if (esMia)
                                {
                                    <button class="se-delete-btn" data-id="@a.Id" title="Eliminar respuesta">Eliminar</button>
                                }
                            </div>
                        </div>
                    </article>
                }

                @* --- If user not authenticated: keep hint to login for viewing other answers --- *@
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-header">
                            <i class="bi bi-unlock login-hint-icon"></i>
                            <div class="login-hint-text">Inicia sesión para ver y participar en las respuestas de la comunidad.</div>
                        </div>
                        <div class="login-hint-actions">
                            <a href="/Identity/Account/Register" class="btn-login-hint btn-login-hint-primary"><i class="bi bi-person-plus"></i> Crear cuenta gratis</a>
                            <a href="/Identity/Account/Login" class="btn-login-hint btn-login-hint-secondary"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a>
                        </div>
                    </div>
                }
                else
                {
                    @* Reply box for authenticated users (no change) *@
                    <div class="se-reply-box">
                        <div style="position: relative;">
                            <label for="respuestaBuscar" class="se-answers-label">Revisa que tu aporte sea claro y útil.</label>
                            <textarea id="replyCuerpo" class="se-reply-textarea" placeholder="Escribe tu respuesta..."></textarea>
                            <div><button id="btnSendReply" class="responder-boton" type="button">Publicar respuesta</button></div>
                        </div>
                    </div>
                }

                @* Answers list: render paged answers but skip accepted one if already shown above *@
                @if (User.Identity.IsAuthenticated)
                {
                    @if (!Model.Respuestas.Any())
                    {
                        <div class="se-empty">Todavía no hay respuestas.</div>
                    }
                    else
                    {
                        <div>
                            @foreach (var a in Model.Respuestas)
                            {
                                if (Model.AcceptedAnswer != null && a.Id == Model.AcceptedAnswer.Id) continue; // avoid duplicate
                                var rDisableUp = a.UsuarioVoto != 0;
                                var rDisableDown = a.Score <= 0;
                                var esMia = a.EsMia;
                                <article class="se-answer"
                                         data-id="@a.Id"
                                         data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                                         data-is-mine="@(esMia ? "true" : "false")"
                                         data-user-vote="@a.UsuarioVoto"
                                         data-score="@a.Score">

                                    <div class="se-answer-vote">
                                        @if (!User.Identity.IsAuthenticated || esMia)
                                        {
                                            <button class="se-vote-btn se-vote-up" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▲</button>
                                            <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                            <button class="se-vote-btn se-vote-down" disabled title="@(esMia ? "No puedes votar tu propia respuesta" : "Inicia sesión para votar")">▼</button>
                                        }
                                        else
                                        {
                                            <button class="se-vote-btn se-vote-up @(a.UsuarioVoto == 1 ? "active" : "")"
                                                    data-id="@a.Id"
                                                    data-dir="up"
                                                    type="button"
                                                    title="Votar +1"
                                                    aria-label="Votar +1"
                                                    @(rDisableUp ? "disabled" : null)>
                                                ▲
                                            </button>
                                            <div class="se-vote-count" id="ascore-@a.Id">@a.Score</div>
                                            <button class="se-vote-btn se-vote-down @(a.UsuarioVoto == -1 ? "active" : "")"
                                                    data-id="@a.Id"
                                                    data-dir="down"
                                                    type="button"
                                                    title="Votar -1"
                                                    aria-label="Votar -1"
                                                    @(rDisableDown ? "disabled" : null)>
                                                ▼
                                            </button>
                                        }
                                    </div>

                                    <div>
                                        <div class="se-answer-body">@Html.Raw(a.Cuerpo)</div>
                                        <div class="se-answer-meta">
                                            <img class="se-resp-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")"
                                                 data-src="@ResolveAvatar(a.AutorAvatarUrl)" alt="@a.AutorNombre" width="34" height="34" decoding="async"
                                                 onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                            <a class="se-answer-author" href="#">@a.AutorNombre</a>
                                            <span>@a.FechaCreacion.ToLocalTime().ToString("g")</span>
                                            <span class="se-answer-score">V: <span id="ascore-inline-@a.Id">@a.Score</span></span>
                                            @if (esMia)
                                            {
                                                <button class="se-delete-btn" data-id="@a.Id" title="Eliminar respuesta">Eliminar</button>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }

                @* pagination (sin cambios en la lógica) *@
                <div class="preguntas-paginacion" aria-label="Paginación">
                    @if (Model.TotalPages > 1)
                    {
                        int current = Model.AnswersPage;
                        int total = Model.TotalPages;
                        int window = 2;
                        var list = new List<int>();
                        if (total <= 12) { list.AddRange(Enumerable.Range(1, total)); }
                        else
                        {
                            int start = Math.Max(1, current - window);
                            int end = Math.Min(total, current + window);
                            if (start > 1) { list.Add(1); if (start > 2) list.Add(-1); }
                            list.AddRange(Enumerable.Range(start, end - start + 1));
                            if (end < total) { if (end < total - 1) list.Add(-1); list.Add(total); }
                        }

                        Func<int, string> pageUrl = p => Url.Page("/Preguntas/Detalles", new { slug = Model.Pregunta.Slug, answersPage = p, pageSize = Model.PageSize, search = Model.Search }) ?? "#";

                        <div class="pag-bar">
                            <a class="pag-btn @(current == 1 ? "disabled" : "")" aria-label="Primera página" href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                            <a class="pag-btn @(current == 1 ? "disabled" : "")" aria-label="Página anterior" href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>
                            @foreach (var p in list)
                            {
                                if (p == -1)
                                {
                                    <span class="pag-ellipsis" aria-hidden="true">…</span>
                                    ;
                                }
                                else
                                {
                                    var active = p == current ? "active" : "";

                                    <a class="pag-num @active" aria-label="Página @p" aria-current="@(active == "active" ? "page" : null)" href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                                    ;
                                }
                            }
                            <a class="pag-btn @(current == total ? "disabled" : "")" aria-label="Página siguiente" href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                            <a class="pag-btn @(current == total ? "disabled" : "")" aria-label="Última página" href="@(current == total ? "#" : pageUrl(total))">»</a>

                            <div class="pag-info">
                                <span>Total: @Model.TotalItems registros</span>
                                <span>Página @Model.AnswersPage de @Model.TotalPages</span>
                                <form method="get" class="pag-size-inline" id="inlineSizeForm2">
                                    <input type="hidden" name="slug" value="@Model.Pregunta.Slug" />
                                    <input type="hidden" name="answersPage" value="1" />
                                    <label for="inlinePageSize2">Tamaño</label>
                                    <select id="inlinePageSize2" name="pageSize" onchange="document.getElementById('inlineSizeForm2').submit();">
                                        @{
                                            var sizes3 = new[] { 10, 12, 30, 60, 100 };
                                        }
                                        @foreach (var s in sizes3)
                                        {
                                            <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                                        }
                                    </select>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
}