@page "/Mapa"
@model eiibd26.Pages.Mapa.IndexModel
@{
    ViewData["HideSidebar"] = true;
    Layout = "_Layout";
    ViewData["Title"] = "Mapa - Comunidad";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500" />
    <style>
        html, body {
            overflow-x: hidden;
        }

        .mapa-root {
            width: 100%;
            margin: 0;
            padding: 12px 18px;
            box-sizing: border-box;
            background: #f8fafc;
        }

        .mapa-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 6px;
            flex-wrap: wrap;
        }

        .results-count {
            margin: 6px 0 12px;
            color: #374151;
            font-size: .95rem;
        }

        .mapa-split {
            display: flex;
            gap: 12px;
            align-items: stretch;
            height: calc(100vh - 160px);
            box-sizing: border-box;
        }

        .mapa-left {
            flex: 1 1 50%;
            min-width: 320px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .cards-scroll {
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            flex: 1 1 auto;
            padding-right: 6px;
        }

        .mapa-right {
            flex: 1 1 50%;
            background: #fff;
            border-radius: 8px;
            border: 1px solid #e6eef6;
            overflow: hidden;
            min-height: 70vh;
            position: relative;
        }
        /* Ensure map canvas fills container */
        #mapCanvas {
            width: 100%;
            height: 100%;
            min-height: 70vh;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #172849;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
        }

        .user-card {
            padding: 12px;
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            cursor: pointer;
            min-height: 140px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .user-card-top {
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .user-avatar {
            width: 72px;
            height: 72px;
            border-radius: 8px;
            overflow: hidden;
            background: #f3f6fa;
            flex: 0 0 72px;
        }

            .user-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .user-info {
            flex: 1 1 auto;
        }

        .user-name {
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .user-meta {
            color: #6b7280;
            font-size: .9rem;
        }

        .user-card-bottom {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            color: #6b7280;
            font-size: .85rem;
        }

        @@media (max-width:1400px) {
            .cards-grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media (max-width:992px) {
            .mapa-split {
                flex-direction: column;
                height: auto;
            }

            .cards-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .mapa-right {
                min-height: 56vh;
            }
        }

        @@media (max-width:576px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }

            .user-avatar {
                width: 60px;
                height: 60px;
                flex: 0 0 60px;
            }
        }

        .loading-indicator {
            text-align: center;
            padding: 12px;
            color: #6b7280;
        }

        .initial-overlay {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.65);
            z-index: 2000;
        }
    </style>
}

<main class="mapa-root">
    <div class="section-title">Mapa — Comunidad avanzada</div>

    <div class="mapa-controls" role="region" aria-label="Controles del mapa">
        <div>
            <label class="form-label mb-0">País</label>
            <select id="filter_country" class="form-select form-select-sm" style="min-width:200px;">
                <option value="">(Todos)</option>
                @foreach (var c in Model.Countries)
                {
                    <option value="@c.Code" data-name="@c.Name">@c.Name (@c.Code)</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-0">Condición</label>
            <select id="filter_condition" class="form-select form-select-sm" style="min-width:220px;">
                <option value="">(Todas)</option>
                @foreach (var cond in Model.Conditions)
                {
                    <option value="@cond.id">@cond.nombre</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-0">Años desde diagnóstico</label>
            <select id="filter_years" class="form-select form-select-sm" style="min-width:160px;">
                <option value="">(Cualquiera)</option>
                <option value="0-1">0–1 años (incluye sin fecha)</option>
                <option value="1-3">1–3 años</option>
                <option value="3-5">3–5 años</option>
                <option value="5-10">5–10 años</option>
                <option value="10+">10+ años</option>
            </select>
        </div>

        <div><button id="btnReload" class="btn btn-primary btn-sm" style="margin-top:20px;">Aplicar filtros</button></div>
    </div>

    <div id="resultsCount" class="results-count">Cargando…</div>

    <div class="mapa-split" role="main">
        <aside class="mapa-left" aria-label="Listado de usuarios filtrados">
            <div class="cards-scroll" id="cardsScroll">
                <div id="cardsContainer"></div>
                <div id="loader" class="loading-indicator" style="display:none;">Cargando más…</div>
            </div>
        </aside>

        <div class="mapa-right"><div id="mapCanvas" role="application" aria-label="Mapa de usuarios"></div></div>
    </div>
</main>

<div id="initialOverlay" class="initial-overlay" style="display:none;">
    <div style="text-align:center;">
        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;"></div>
        <div style="margin-top:12px;color:#374151">Cargando mapas y usuarios…</div>
    </div>
</div>

@section Scripts {
    <!-- Replace key and keep async+defer with callback -->
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBUUBxDv3VvzMmdR_pf9aFOd7frbTeUWXk&callback=initMap"></script>
    @* <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBUUBxDv3VvzMmdR_pf9aFOd7frbTeUWXk"></script> *@
    @Html.Raw("<script src=\"https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js\"></script>")

    <script>
        (function () {
            const PAGE_SIZE = 48;
            const SCROLL_THRESHOLD_PX = 300;
            const DEBOUNCE_MS = 350;

            const cardsContainer = document.getElementById('cardsContainer');
            const cardsScroll = document.getElementById('cardsScroll');
            const loaderEl = document.getElementById('loader');
            const resultsCountEl = document.getElementById('resultsCount');
            const mapEl = document.getElementById('mapCanvas');
            const initialOverlay = document.getElementById('initialOverlay');

            const USER_COUNTRY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserCountry ?? ""));

            const MIN_ZOOM = 2, MAX_ZOOM = 8, MAX_ZOOM_CLUSTER_CLICK = 7, JITTER_MAX_DEG = 0.02;
            let map, clusterer, markers = [];
            let totalCount = 0, loadedCount = 0, isLoading = false;
            let loadedProfiles = [];
            let firstLoadDone = false;
            let geocoder = null;

            // Ensure there is a global clustererRenderer (fallback safe renderer)
            window.clustererRenderer = window.clustererRenderer || {
                render({ count, position }) {
                    const size = Math.max(30, Math.min(76, 30 + Math.round(Math.log10(count || 1) * 10)));
                    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${size/2}" cy="${size/2}" r="${(size-4)/2}" fill="#7c3aed" stroke="#fff" stroke-width="2"/><text x="50%" y="50%" font-size="${Math.max(10, Math.round(size*0.34))}" fill="#fff" text-anchor="middle" dominant-baseline="central">${count}</text></svg>`;
                    // If google.maps not ready, return minimal marker-like object
                    if (window.google && google.maps && google.maps.Marker) {
                        return new google.maps.Marker({
                            position,
                            icon: { url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg), scaledSize: new google.maps.Size(size, size) }
                        });
                    }
                    return { position, icon: svg };
                }
            };

            // Avatar helper functions (kept as before)
            const knownPlaceholderPatterns = [/default[-_]?avatar/i, /default\.jpg/i, /ui-avatars\.com/i, /placeholder/i];
            function looksLikePlaceholder(raw) { if (!raw) return true; const s = String(raw).trim(); if (!s) return true; for (const rx of knownPlaceholderPatterns) if (rx.test(s)) return true; return false; }
            function isAbsoluteUrl(u) { return /^https?:\/\//i.test(u); }
            function toAbsolute(candidate) { if (!candidate) return null; if (isAbsoluteUrl(candidate)) return candidate; return location.origin + (candidate.startsWith('/') ? candidate : ('/' + candidate)); }

            async function resolveAvatarForElement(imgEl) {
                if (!imgEl) return;
                if (imgEl.dataset.resolved === '1') return;
                if (imgEl.dataset.resolving === '1') return;
                imgEl.dataset.resolving = '1';
                try {
                    const rawAvatar = (imgEl.dataset.avatar || '').trim();
                    if (!rawAvatar || looksLikePlaceholder(rawAvatar)) { imgEl.src = '/img/default-avatar.png'; imgEl.dataset.resolved = '1'; return; }
                    if (isAbsoluteUrl(rawAvatar)) { imgEl.src = rawAvatar; imgEl.dataset.resolved = '1'; return; }
                    if (rawAvatar.toLowerCase().includes('/uploads/avatars/') || rawAvatar.toLowerCase().startsWith('uploads/avatars/')) {
                        const asIs = rawAvatar.startsWith('/') ? rawAvatar : ('/' + rawAvatar.replace(/^\/+/, ''));
                        imgEl.src = toAbsolute(asIs); imgEl.dataset.resolved = '1'; return;
                    }
                    const path = '/uploads/avatars/' + encodeURIComponent(rawAvatar);
                    imgEl.src = toAbsolute(path); imgEl.dataset.resolved = '1';
                } catch (err) {
                    console.debug('resolveAvatarForElement error', err);
                    imgEl.src = '/img/default-avatar.png'; imgEl.dataset.resolved = '1';
                } finally { delete imgEl.dataset.resolving; }
            }

            const ioOptions = { root: null, rootMargin: '200px', threshold: 0.01 };
            let avatarObserver = null;
            try { if ('IntersectionObserver' in window) avatarObserver = new IntersectionObserver(entries => { entries.forEach(entry => { if (entry.isIntersecting) { const img = entry.target; if (img && img.dataset) { avatarObserver.unobserve(img); resolveAvatarForElement(img); } } }); }, ioOptions); } catch(e){ avatarObserver = null; }

            function observeAvatar(img) {
                if (!img) return;
                img.setAttribute('loading', 'lazy');
                const raw = img.dataset.avatar || '';
                if (!raw || looksLikePlaceholder(raw)) { img.src = '/img/default-avatar.png'; img.dataset.resolved = '1'; return; }
                if (avatarObserver) { try { avatarObserver.observe(img); return; } catch (e) {} }
                resolveAvatarForElement(img);
            }

            // clustererRenderer local reference (use global)
            const clustererRendererLocal = window.clustererRenderer;

            function escapeHtml(s) { if (!s) return ''; return String(s).replace(/[&<>"'`=\/]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#47;','`':'&#96;','=':'&#61;'}[c])); }
            function jitterCoord(lat, lng) { const f = JITTER_MAX_DEG; return { lat: lat + (Math.random() - 0.5) * f, lng: lng + (Math.random() - 0.5) * f }; }
            function smallMarkerSvgDataUrl(size = 14) { const stroke = 1; const cx = size/2, cy = size/2, r = Math.max(4, Math.round((size - stroke*2)/2)); const fill = '#7c3aed', strokeColor = '#ffffff'; const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${cx}" cy="${cy}" r="${r}" fill="${fill}" stroke="${strokeColor}" stroke-width="${stroke}" /></svg>`; return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg); }

            function buildAvatarPlaceholder(profile) {
                const avatar = profile.avatar || '';
                const id = profile.id || profile.idUser || '';
                const src = '/img/default-avatar.png';
                return `<img src="${src}" data-avatar="${escapeHtml(avatar)}" data-userid="${escapeHtml(String(id))}" class="ums-avatar" alt="${escapeHtml(profile.name || 'Usuario')}" loading="lazy" />`;
            }

            function buildCardHtml(p) {
                const yearsText = p.diagnosisAgeText ? p.diagnosisAgeText : (p.yearsSinceDiagnosis != null ? (p.yearsSinceDiagnosis === 1 ? '1 año' : (p.yearsSinceDiagnosis + ' años')) : 'Sin Fecha');
                const condName = p.condicionNombre || '';
                const mood = p.lastMood ? (p.lastMood + (p.lastMoodText ? ` — ${p.lastMoodText}` : '')) : 'Sin estado';
                const displayName = p.name || 'Usuario';
                const avatarImgHtml = buildAvatarPlaceholder(p);
                return `
                    <div class="user-card" data-id="${p.id}">
                        <div class="user-card-top">
                            <div class="user-avatar">${avatarImgHtml}</div>
                            <div class="user-info">
                                <div class="user-name">${escapeHtml(displayName)}</div>
                                <div class="user-meta">${escapeHtml(condName)} · ${escapeHtml(yearsText)}</div>
                            </div>
                        </div>
                        <div class="user-card-bottom"><span>${escapeHtml(p.country || '')}</span><span>${escapeHtml(mood)}</span></div>
                    </div>
                `;
            }

            function appendCards(profiles) {
                let grid = cardsContainer.querySelector('.cards-grid');
                if (!grid) { grid = document.createElement('div'); grid.className = 'cards-grid'; cardsContainer.appendChild(grid); }
                const fragment = document.createDocumentFragment();
                profiles.forEach(p => { const wrapper = document.createElement('div'); wrapper.innerHTML = buildCardHtml(p); fragment.appendChild(wrapper.firstElementChild); });
                grid.appendChild(fragment);
                Array.from(cardsContainer.querySelectorAll('.user-card')).forEach(el => {
                    if (el.dataset.bound) return;
                    el.dataset.bound = '1';
                    el.addEventListener('click', function () {
                        const id = this.getAttribute('data-id');
                        const m = markers.find(x => String(x._profile.id) === String(id));
                        if (m) {
                            if (map && m.getPosition) { map.setCenter(m.getPosition()); map.setZoom(MAX_ZOOM_CLUSTER_CLICK); }
                            const content = `<div style="min-width:200px"><strong>${escapeHtml(m._profile.name || '')}</strong><div>${escapeHtml(m._profile.condicionNombre||'')}</div><div style="color:#6b7280;font-size:.9rem;margin-top:6px;">${escapeHtml(m._profile.lastMood||'')}${m._profile.lastMoodText ? ' — ' + escapeHtml(m._profile.lastMoodText) : ''}</div></div>`;
                            try { if (window.google && google.maps && google.maps.InfoWindow) new google.maps.InfoWindow({ content }).open(map, m); } catch(e) { /* ignore */ }
                        }
                    });
                });
                const imgs = cardsContainer.querySelectorAll('img[data-avatar]:not([data-resolved="1"])'); imgs.forEach(img => observeAvatar(img));
            }

            function clearCards() { cardsContainer.innerHTML = ''; }
            function clearMarkers() { if (clusterer && typeof clusterer.clearMarkers === 'function') clusterer.clearMarkers(); markers.forEach(m => m.setMap && m.setMap(null)); markers = []; }

            function addMarkersFromLoaded() {
                clearMarkers();
                markers = loadedProfiles.map(p => {
                    const lat = Number(p.lat), lng = Number(p.lng);
                    const jittered = jitterCoord(isFinite(lat) ? lat : 0, isFinite(lng) ? lng : 0);
                    const pos = { lat: jittered.lat, lng: jittered.lng };
                    const size = 14;
                    const iconUrl = smallMarkerSvgDataUrl(size);
                    let m;
                    try {
                        m = new google.maps.Marker({ position: pos, title: (p.name || 'Usuario'), icon: { url: iconUrl, scaledSize: new google.maps.Size(size, size) } });
                    } catch (e) {
                        m = { _position: pos, _profile: p, getPosition: () => pos };
                        m._profile = p;
                    }
                    m._profile = p;
                    return m;
                });
                try {
                    if (markers.length && typeof markerClusterer !== 'undefined' && markerClusterer && markerClusterer.MarkerClusterer) {
                        // prefer library clusterer if available
                        clusterer = new markerClusterer.MarkerClusterer({ map, renderer: window.clustererRenderer });
                        clusterer.addMarkers(markers);
                    } else if (markers.length && typeof markerClusterer === 'undefined' && window.clustererRenderer && window.google && google.maps) {
                        // use low-level clusterer if lib exists
                        clusterer = new markerClusterer.MarkerClusterer({ map, renderer: window.clustererRenderer });
                        clusterer.addMarkers(markers);
                    } else {
                        markers.forEach(m => m.setMap && m.setMap(map));
                    }
                    if (markers.length && map && markers[0] && markers[0].getPosition) {
                        const bounds = new google.maps.LatLngBounds();
                        markers.forEach(m => bounds.extend(m.getPosition()));
                        try { map.fitBounds(bounds); } catch (e) {}
                    } else {
                        if (USER_COUNTRY) centerMapOnCountry(USER_COUNTRY);
                        else { map.setCenter({ lat: 20, lng: 0 }); map.setZoom(MIN_ZOOM); }
                    }
                } catch (ex) {
                    console.error('addMarkersFromLoaded error', ex);
                    markers.forEach(m => m.setMap && m.setMap(map));
                }
            }

            // Expose loadNextBatch globally so we can call it for debugging if needed
            window.loadNextBatch = async function loadNextBatch() {
                if (isLoading) return;
                if (loadedCount >= totalCount && totalCount !== 0) return;
                isLoading = true;
                loaderEl.style.display = 'block';
                if (!firstLoadDone) initialOverlay.style.display = 'flex';

                const country = document.getElementById('filter_country').value || '';
                const cond = document.getElementById('filter_condition').value || '';
                const years = document.getElementById('filter_years').value || '';

                const qs = new URLSearchParams();
                if (country) qs.set('country', country);
                if (cond) qs.set('conditionId', cond);
                if (years) qs.set('yearsRange', years);
                qs.set('skip', String(loadedCount));
                qs.set('take', String(PAGE_SIZE));

                const url = window.location.pathname + '?handler=Profiles&' + qs.toString();
                try {
                    const res = await fetch(url, { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('Network response not ok: ' + res.status);
                    const payload = await res.json();
                    totalCount = payload.total || 0;
                    const items = payload.items || [];

                    appendCards(items);
                    loadedProfiles = loadedProfiles.concat(items);
                    loadedCount += items.length;
                    resultsCountEl.textContent = (totalCount || 0) + ' encontrados / Mostrando ' + loadedCount;

                    addMarkersFromLoaded();
                } catch (e) {
                    console.error('Error loading batch', e);
                    // show minimal error and still hide overlay
                } finally {
                    isLoading = false;
                    loaderEl.style.display = 'none';
                    if (!firstLoadDone) { initialOverlay.style.display = 'none'; firstLoadDone = true; }
                }
            };

            function centerMapOnCountry(countryText) {
                if (!geocoder || !countryText) return;
                geocoder.geocode({ address: countryText }, function(results, status) {
                    if (status === 'OK' && results && results[0]) {
                        const r = results[0];
                        const bounds = r.geometry && (r.geometry.bounds || r.geometry.viewport) ? (r.geometry.bounds || r.geometry.viewport) : null;
                        if (bounds) { map.fitBounds(bounds); google.maps.event.addListenerOnce(map, 'idle', function() { if (map.getZoom() > MAX_ZOOM_CLUSTER_CLICK) map.setZoom(MAX_ZOOM_CLUSTER_CLICK); }); }
                        else if (r.geometry && r.geometry.location) { map.setCenter(r.geometry.location); map.setZoom(MAX_ZOOM_CLUSTER_CLICK); }
                    } else { map.setCenter({ lat: 20, lng: 0 }); map.setZoom(MIN_ZOOM); }
                });
            }

            // Global initMap for Google callback – make robust vs missing renderer/markerClusterer
            window.initMap = function initMap() {
                try {
                    if (!window.google || !google.maps) { console.warn('Google Maps not available at initMap time.'); return; }
                    geocoder = new google.maps.Geocoder();
                    map = new google.maps.Map(mapEl, {
                        center: { lat: 20, lng: 0 },
                        zoom: MIN_ZOOM,
                        minZoom: MIN_ZOOM,
                        maxZoom: MAX_ZOOM,
                        mapTypeControl: false,
                        streetViewControl: false,
                        fullscreenControl: true,
                        clickableIcons: false,
                        gestureHandling: 'greedy'
                    });
                    // Use the global renderer (we ensured window.clustererRenderer above)
                    try {
                        if (window.markerClusterer && typeof markerClusterer.MarkerClusterer === 'function') {
                            // will create clusterer when adding markers
                        } else {
                            // markerClusterer library may not be present; that's okay
                        }
                    } catch (e) {
                        console.debug('clusterer availability check failed', e);
                    }
                } catch (ex) {
                    console.error('initMap error', ex);
                }
            };

            function debounce(fn, wait) { let t; return function (...args) { clearTimeout(t); t = setTimeout(() => fn.apply(this, args), wait); }; }
            function onScroll() { if (isLoading) return; const el = cardsScroll; if (!el) return; const remaining = el.scrollHeight - el.scrollTop - el.clientHeight; if (remaining <= SCROLL_THRESHOLD_PX) window.loadNextBatch(); }

            const debouncedReset = debounce(() => { loadedCount = 0; totalCount = 0; loadedProfiles = []; clearCards(); clearMarkers(); window.loadNextBatch(); }, DEBOUNCE_MS);

            document.getElementById('btnReload').addEventListener('click', function () {
                const countryText = document.getElementById('filter_country').selectedOptions[0]?.text || '';
                if (countryText && countryText !== '(Todos)') centerMapOnCountry(countryText);
                loadedCount = 0; totalCount = 0; loadedProfiles = []; clearCards(); clearMarkers(); window.loadNextBatch();
            });

            ['filter_country','filter_condition','filter_years'].forEach(id => { const el = document.getElementById(id); if (el) el.addEventListener('change', debouncedReset); });
            cardsScroll.addEventListener('scroll', onScroll);

            // Start: if Google already loaded, initMap will be called via callback; ensure we still fetch profiles
            try { if (USER_COUNTRY) { /* center attempt will occur when map ready */ } } catch {}
            // Always load first batch of profiles (so left column shows even if map fails)
            window.loadNextBatch();
        })();
    </script>
}