@page "/Mapa"
@model eiibd26.Pages.Mapa.IndexModel
@{
    // Indica al layout que oculte el sidebar
    ViewData["HideSidebar"] = true;

    Layout = "_Layout";
    ViewData["Title"] = "Mapa - Comunidad";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500" />
    <style>
        html, body {
            overflow-x: hidden;
        }

        .mapa-root {
            width: 100%;
            margin: 0;
            padding: 12px 18px;
            box-sizing: border-box;
            background: #f8fafc;
        }

        .mapa-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 6px;
            flex-wrap: wrap;
        }

        .results-count {
            margin: 6px 0 12px;
            color: #374151;
            font-size: .95rem;
        }

        .mapa-split {
            display: flex;
            gap: 12px;
            align-items: stretch;
            height: calc(100vh - 160px);
            box-sizing: border-box;
        }

        .mapa-left {
            flex: 1 1 50%;
            min-width: 320px;
            box-sizing: border-box;
            padding: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            background: transparent;
        }

        .cards-scroll {
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            flex: 1 1 auto;
            padding-right: 6px;
        }

        .mapa-right {
            flex: 1 1 50%;
            box-sizing: border-box;
            background: #fff;
            border-radius: 8px;
            border: 1px solid #e6eef6;
            overflow: hidden;
            min-height: 70vh;
            height: 100%;
            position: relative;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #172849;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .user-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: flex-start;
            padding: 12px;
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            cursor: pointer;
            min-height: 140px;
            box-shadow: 0 4px 10px rgba(16,24,40,0.02);
        }

        .user-card-top {
            display: flex;
            gap: 10px;
            width: 100%;
            align-items: flex-start;
        }

        .user-avatar {
            width: 72px;
            height: 72px;
            border-radius: 8px;
            overflow: hidden;
            background: #f3f6fa;
            flex: 0 0 72px;
        }

            .user-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .user-info {
            flex: 1 1 auto;
        }

        .user-name {
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .user-meta {
            color: #6b7280;
            font-size: .9rem;
        }

        .user-card-bottom {
            margin-top: auto;
            width: 100%;
            display: flex;
            justify-content: space-between;
            color: #6b7280;
            font-size: .85rem;
        }

        @@media (max-width: 1400px) {
            .cards-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .mapa-split {
                flex-direction: column;
                height: auto;
            }

            .cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .mapa-right {
                min-height: 56vh;
            }
        }

        @@media (max-width: 576px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }

            .user-avatar {
                width: 60px;
                height: 60px;
                flex: 0 0 60px;
            }
        }

        .loading-indicator {
            text-align: center;
            padding: 12px;
            color: #6b7280;
        }

        .initial-overlay {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.65);
            z-index: 2000;
        }
    </style>
}

<main class="mapa-root">
    <div class="section-title">Mapa — Comunidad avanzada</div>

    <div class="mapa-controls" role="region" aria-label="Controles del mapa">
        <div>
            <label class="form-label mb-0">País</label>
            <select id="filter_country" class="form-select form-select-sm" style="min-width:200px;">
                <option value="">(Todos)</option>
                @foreach (var c in Model.Countries)
                {
                    <option value="@c.Code">@c.Name (@c.Code)</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-0">Condición</label>
            <select id="filter_condition" class="form-select form-select-sm" style="min-width:220px;">
                <option value="">(Todas)</option>
                @foreach (var cond in Model.Conditions)
                {
                    <option value="@cond.id">@cond.nombre</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-0">Años desde diagnóstico</label>
            <select id="filter_years" class="form-select form-select-sm" style="min-width:160px;">
                <option value="">(Cualquiera)</option>
                <option value="0-1">0–1 años (incluye sin fecha)</option>
                <option value="1-3">1–3 años</option>
                <option value="3-5">3–5 años</option>
                <option value="5-10">5–10 años</option>
                <option value="10+">10+ años</option>
            </select>
        </div>

        <div>
            <button id="btnReload" class="btn btn-primary btn-sm" style="margin-top:20px;">Aplicar filtros</button>
        </div>
    </div>

    <div id="resultsCount" class="results-count">Cargando…</div>

    <div class="mapa-split" role="main">
        <aside class="mapa-left" aria-label="Listado de usuarios filtrados">
            <div class="cards-scroll" id="cardsScroll">
                <div id="cardsContainer"></div>
                <div id="loader" class="loading-indicator" style="display:none;">Cargando más…</div>
            </div>
        </aside>

        <div class="mapa-right" id="mapCanvas" role="application" aria-label="Mapa de usuarios"></div>
    </div>
</main>

<div id="initialOverlay" class="initial-overlay" style="display:none;">
    <div>
        <div style="text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div style="margin-top:12px;color:#374151">Cargando mapas y usuarios…</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBUUBxDv3VvzMmdR_pf9aFOd7frbTeUWXk"></script>
    @Html.Raw("<script src=\"https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js\"></script>")

    <script>
        (function () {
            const PAGE_SIZE = 48;
            const SCROLL_THRESHOLD_PX = 300;
            const DEBOUNCE_MS = 350;

            const cardsContainer = document.getElementById('cardsContainer');
            const cardsScroll = document.getElementById('cardsScroll');
            const loaderEl = document.getElementById('loader');
            const resultsCountEl = document.getElementById('resultsCount');
            const mapEl = document.getElementById('mapCanvas');
            const initialOverlay = document.getElementById('initialOverlay');

            const MIN_ZOOM = 2, MAX_ZOOM = 8, MAX_ZOOM_CLUSTER_CLICK = 7, JITTER_MAX_DEG = 0.02;
            let map, clusterer, markers = [];
            let totalCount = 0, loadedCount = 0, isLoading = false;
            let loadedProfiles = [];
            let firstLoadDone = false;

            function debounce(fn, wait) {
                let t;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), wait);
                };
            }

            function escapeHtml(s) {
                if (!s) return '';
                return String(s).replace(/[&<>"'`=\/]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#47;','`':'&#96;','=':'&#61;'}[c]));
            }

            function jitterCoord(lat, lng) {
                const f = JITTER_MAX_DEG;
                return { lat: lat + (Math.random() - 0.5) * f, lng: lng + (Math.random() - 0.5) * f };
            }

            function smallMarkerSvgDataUrl(size = 14) {
                const stroke = 1;
                const cx = size/2, cy = size/2, r = Math.max(4, Math.round((size - stroke*2)/2));
                const fill = '#7c3aed';
                const strokeColor = '#ffffff';
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${cx}" cy="${cy}" r="${r}" fill="${fill}" stroke="${strokeColor}" stroke-width="${stroke}" /></svg>`;
                return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
            }

            function createClusterSvg(count, size) {
                const strokeFactor = 0.04, fontFactor = 0.34;
                const stroke = Math.max(1, Math.round(size * strokeFactor));
                const radius = (size - stroke * 2) / 2;
                const cx = size/2, cy = size/2;
                const fill = '#7c3aed';
                const strokeColor = '#ffffff';
                const fontSize = Math.max(10, Math.round(size * fontFactor));
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${cx}" cy="${cy}" r="${radius}" fill="${fill}" stroke="${strokeColor}" stroke-width="${stroke}" /><text x="50%" y="50%" font-size="${fontSize}" fill="#fff" text-anchor="middle" dominant-baseline="central" font-family="Arial, sans-serif">${count}</text></svg>`;
                return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
            }

            function clusterRenderer() {
                return {
                    render({ count, position }) {
                        const size = Math.max(30, Math.min(76, 30 + Math.round(Math.log10(count || 1) * 10)));
                        const svg = createClusterSvg(count || 0, size);
                        return new google.maps.Marker({
                            position,
                            icon: { url: svg, scaledSize: new google.maps.Size(size, size) },
                            zIndex: Number(google.maps.Marker.MAX_ZINDEX) + count
                        });
                    }
                };
            }

            function buildAvatarUrl(profile) {
                const a = profile.avatar || '';
                if (!a) return '/img/default-avatar.png';
                if (a.startsWith('http')) return a;
                return '/uploads/avatars/' + profile.id + '/' + a;
            }

            function buildCardHtml(p) {
                const years = p.yearsSinceDiagnosis;
                const yearsText = (p.hasFechaDiagnostico === false || years === null || years === undefined) ? 'Sin Fecha de Diagnóstico' : (years === 1 ? '1 año' : (years + ' años'));
                const condName = p.condicionNombre || '';
                const mood = p.lastMood ? (p.lastMood + (p.lastMoodText ? ` — ${p.lastMoodText}` : '')) : 'Sin estado';
                // use server-provided single-word display name when available
                const displayName = p.displayNameSingle && p.displayNameSingle.length ? p.displayNameSingle : (p.name ? p.name.split(/\s+/)[0] : 'Usuario');
                const img = buildAvatarUrl(p);
                return `
                    <div class="user-card" data-id="${p.id}">
                        <div class="user-card-top">
                            <div class="user-avatar"><img src="${img}" alt="${escapeHtml(displayName)}" onerror="this.src='/img/default-avatar.png'"/></div>
                            <div class="user-info">
                                <div class="user-name">${escapeHtml(displayName)}</div>
                                <div class="user-meta">${escapeHtml(condName)} · ${escapeHtml(yearsText)}</div>
                            </div>
                        </div>
                        <div class="user-card-bottom"><span>${escapeHtml(p.country || '')}</span><span>${escapeHtml(mood)}</span></div>
                    </div>
                `;
            }

            function appendCards(profiles) {
                let grid = cardsContainer.querySelector('.cards-grid');
                if (!grid) {
                    grid = document.createElement('div');
                    grid.className = 'cards-grid';
                    cardsContainer.appendChild(grid);
                }

                const fragment = document.createDocumentFragment();
                profiles.forEach(p => {
                    if (p.hasFechaDiagnostico === false) p.yearsSinceDiagnosis = null;
                    const wrapper = document.createElement('div');
                    wrapper.innerHTML = buildCardHtml(p);
                    fragment.appendChild(wrapper.firstElementChild);
                });
                grid.appendChild(fragment);

                Array.from(cardsContainer.querySelectorAll('.user-card')).forEach(el => {
                    if (el.dataset.bound) return;
                    el.dataset.bound = '1';
                    el.addEventListener('click', function () {
                        const id = this.getAttribute('data-id');
                        const m = markers.find(x => String(x._profile.id) === String(id));
                        if (m) {
                            map.setCenter(m.getPosition());
                            map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                            const content = `<div style="min-width:200px"><strong>${escapeHtml(m._profile.displayNameSingle || m._profile.name || '')}</strong><div>${escapeHtml(m._profile.condicionNombre||'')}</div><div style="color:#6b7280;font-size:.9rem;margin-top:6px;">${escapeHtml(m._profile.lastMood||'')}${m._profile.lastMoodText ? ' — ' + escapeHtml(m._profile.lastMoodText) : ''}</div></div>`;
                            new google.maps.InfoWindow({ content }).open(map, m);
                        }
                    });
                });
            }

            function clearCards() { cardsContainer.innerHTML = ''; }
            function clearMarkers() { if (clusterer && typeof clusterer.clearMarkers === 'function') clusterer.clearMarkers(); markers.forEach(m => m.setMap(null)); markers = []; }

            function addMarkersFromLoaded() {
                clearMarkers();
                markers = loadedProfiles.map(p => {
                    const lat = Number(p.lat), lng = Number(p.lng);
                    const jittered = jitterCoord(isFinite(lat) ? lat : 0, isFinite(lng) ? lng : 0);
                    const pos = { lat: jittered.lat, lng: jittered.lng };
                    const size = 14;
                    const iconUrl = smallMarkerSvgDataUrl(size);
                    const m = new google.maps.Marker({ position: pos, title: (p.displayNameSingle || p.name || 'Usuario'), icon: { url: iconUrl, scaledSize: new google.maps.Size(size, size) } });
                    m._profile = p;
                    return m;
                });
                if (markers.length) {
                    clusterer.addMarkers(markers);
                    const bounds = new google.maps.LatLngBounds();
                    markers.forEach(m => bounds.extend(m.getPosition()));
                    try { map.fitBounds(bounds); } catch (e) { /* ignore */ }
                } else {
                    map.setCenter({ lat: 20, lng: 0 });
                    map.setZoom(MIN_ZOOM);
                }
            }

            async function loadNextBatch() {
                if (isLoading) return;
                if (loadedCount >= totalCount && totalCount !== 0) return;
                isLoading = true;
                loaderEl.style.display = 'block';
                if (!firstLoadDone) initialOverlay.style.display = 'flex';

                const country = document.getElementById('filter_country').value || '';
                const cond = document.getElementById('filter_condition').value || '';
                const years = document.getElementById('filter_years').value || '';

                const qs = new URLSearchParams();
                if (country) qs.set('country', country);
                if (cond) qs.set('conditionId', cond);
                if (years) qs.set('yearsRange', years);
                qs.set('skip', String(loadedCount));
                qs.set('take', String(PAGE_SIZE));

                const url = window.location.pathname + '?handler=Profiles&' + qs.toString();
                try {
                    const res = await fetch(url, { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('Network response not ok: ' + res.status);
                    const payload = await res.json();
                    totalCount = payload.total || 0;
                    const items = payload.items || [];
                    appendCards(items);
                    loadedProfiles = loadedProfiles.concat(items);
                    loadedCount += items.length;
                    resultsCountEl.textContent = (totalCount || 0) + ' encontrados / Mostrando ' + loadedCount;

                    addMarkersFromLoaded();
                } catch (e) {
                    console.error('Error loading batch', e);
                } finally {
                    isLoading = false;
                    loaderEl.style.display = 'none';
                    if (!firstLoadDone) {
                        initialOverlay.style.display = 'none';
                        firstLoadDone = true;
                    }
                }
            }

            // Geocoder (kept as in previous version)
            let geocoder = null;
            function centerMapOnCountry(countryText) {
                if (!geocoder || !countryText) return;
                geocoder.geocode({ address: countryText }, function(results, status) {
                    if (status === 'OK' && results && results[0]) {
                        const r = results[0];
                        if (r.geometry && (r.geometry.bounds || r.geometry.viewport)) {
                            const bounds = r.geometry.bounds || r.geometry.viewport;
                            map.fitBounds(bounds);
                            google.maps.event.addListenerOnce(map, 'idle', function() {
                                if (map.getZoom() > MAX_ZOOM_CLUSTER_CLICK) map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                            });
                        } else if (r.geometry && r.geometry.location) {
                            map.setCenter(r.geometry.location);
                            map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                        }
                    } else {
                        console.warn('Geocode failed for', countryText, status);
                    }
                });
            }

            function initMap() {
                geocoder = new google.maps.Geocoder();
                map = new google.maps.Map(mapEl, {
                    center: { lat: 20, lng: 0 },
                    zoom: MIN_ZOOM,
                    minZoom: MIN_ZOOM,
                    maxZoom: MAX_ZOOM,
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true,
                    clickableIcons: false,
                    gestureHandling: 'greedy'
                });
                clusterer = new markerClusterer.MarkerClusterer({ map, renderer: clusterRenderer() });
            }

            function resetAndLoad() {
                loadedCount = 0; totalCount = 0; loadedProfiles = [];
                clearCards(); clearMarkers();
                loadNextBatch();
            }

            function onScroll() {
                if (isLoading) return;
                const el = cardsScroll;
                if (!el) return;
                const remaining = el.scrollHeight - el.scrollTop - el.clientHeight;
                if (remaining <= SCROLL_THRESHOLD_PX) loadNextBatch();
            }

            const debouncedReset = debounce(() => {
                const countryText = document.getElementById('filter_country').selectedOptions[0]?.text || '';
                if (countryText && countryText !== '(Todos)') centerMapOnCountry(countryText);
                resetAndLoad();
            }, DEBOUNCE_MS);

            document.getElementById('btnReload').addEventListener('click', () => {
                const countryText = document.getElementById('filter_country').selectedOptions[0]?.text || '';
                if (countryText && countryText !== '(Todos)') centerMapOnCountry(countryText);
                resetAndLoad();
            });

            ['filter_country','filter_condition','filter_years'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('change', debouncedReset);
            });
            cardsScroll.addEventListener('scroll', onScroll);

            initMap();
            resetAndLoad();
        })();
    </script>
}