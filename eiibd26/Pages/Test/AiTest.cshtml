@page
@model eiibd26.Pages.Test.AiTestPageModel
@{
    ViewData["Title"] = "Test IA - Diagnóstico";
}

<div class="container mt-5">
    <h1>🔧 Panel de Diagnóstico IA</h1>
    <p class="text-muted">Esta página es solo para testing. Eliminar en producción.</p>

    <hr />

    <!-- Estado del Sistema -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5>📊 Estado del Sistema</h5>
        </div>
        <div class="card-body">
            <div id="status-loading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                Cargando estado del sistema...
            </div>
            <div id="status-result" style="display: none;"></div>
        </div>
    </div>

    <!-- Últimas Preguntas -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5>📝 Últimas Preguntas</h5>
        </div>
        <div class="card-body">
            <div id="preguntas-loading">
                <div class="spinner-border text-info" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                Cargando preguntas...
            </div>
            <div id="preguntas-result" style="display: none;"></div>
        </div>
    </div>

    <!-- Forzar Generación -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h5>⚡ Forzar Generación de IA</h5>
        </div>
        <div class="card-body">
            <p>Primero, prueba la conexión directa con la API de Claude:</p>
            <button id="btn-test-connection" class="btn btn-info mb-3" onclick="testConnection()">
                🔍 Probar Conexión con Claude API
            </button>
            <div id="connection-result" class="mt-2 mb-3" style="display: none;"></div>

            <hr />

            <p>Forzar la generación de respuesta IA para la última pregunta creada:</p>
            <button id="btn-force" class="btn btn-warning" onclick="forceGeneration()">
                ⚡ Generar Respuesta IA Ahora
            </button>
            <div id="force-result" class="mt-3" style="display: none;"></div>
        </div>
    </div>

    <!-- Logs en tiempo real -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5>📋 Logs</h5>
        </div>
        <div class="card-body">
            <pre id="logs" style="max-height: 400px; overflow-y: auto; background: #f5f5f5; padding: 15px; border-radius: 5px;">
Esperando acciones...
            </pre>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let logs = [];

    function addLog(message, type = 'info') {
        const timestamp = new Date().toLocaleTimeString();
        const prefix = type === 'error' ? '❌' : type === 'success' ? '✅' : 'ℹ️';
        const logMessage = `[${timestamp}] ${prefix} ${message}`;
        logs.push(logMessage);
        document.getElementById('logs').textContent = logs.join('\n');
    }

    async function loadStatus() {
        try {
            addLog('Cargando estado del sistema...');
            const response = await fetch('/api/test/ai/status');
            const data = await response.json();

            addLog('Estado cargado exitosamente', 'success');

            const html = `
                <h6>Configuración:</h6>
                <ul>
                    <li>Habilitado: <strong>${data.configuration.enabled ? '✅ SÍ' : '❌ NO'}</strong></li>
                    <li>API Key configurada: <strong>${data.configuration.hasApiKey ? '✅ SÍ' : '❌ NO'}</strong></li>
                    <li>Modelo: <strong>${data.configuration.model}</strong></li>
                    <li>System User ID configurado: <strong>${data.configuration.hasSystemUserId ? '✅ SÍ' : '❌ NO'}</strong></li>
                    <li>System User ID: <code>${data.configuration.systemUserId}</code></li>
                </ul>

                <h6>Base de Datos:</h6>
                <ul>
                    <li>Usuario sistema existe: <strong>${data.database.systemUserExists ? '✅ SÍ' : '❌ NO'}</strong></li>
                    <li>Total preguntas: <strong>${data.database.totalPreguntas}</strong></li>
                    <li>Preguntas con respuesta IA: <strong>${data.database.preguntasConIA}</strong></li>
                    <li>Total respuestas IA generadas: <strong>${data.database.respuestasIA}</strong></li>
                </ul>

                ${data.database.ultimaPregunta ? `
                <h6>Última Pregunta:</h6>
                <ul>
                    <li>Título: <strong>${data.database.ultimaPregunta.titulo}</strong></li>
                    <li>Creada: ${new Date(data.database.ultimaPregunta.fechaCreacion).toLocaleString()}</li>
                    <li>Tiene respuesta IA: <strong>${data.database.ultimaPregunta.tieneRespuestaIA ? '✅ SÍ' : '❌ NO'}</strong></li>
                    <li>Total respuestas: <strong>${data.database.ultimaPregunta.totalRespuestas}</strong></li>
                </ul>
                ` : '<p class="text-muted">No hay preguntas en la base de datos.</p>'}
            `;

            document.getElementById('status-loading').style.display = 'none';
            document.getElementById('status-result').innerHTML = html;
            document.getElementById('status-result').style.display = 'block';

        } catch (error) {
            addLog(`Error: ${error.message}`, 'error');
            document.getElementById('status-loading').innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
        }
    }

    async function forceGeneration() {
        const btn = document.getElementById('btn-force');
        const resultDiv = document.getElementById('force-result');

        try {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Generando...';
            resultDiv.style.display = 'none';

            addLog('🚀 Iniciando generación forzada de IA...');

            const response = await fetch('/api/test/ai/force-latest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (response.ok && data.success) {
                addLog('✅ Generación completada exitosamente', 'success');
                resultDiv.innerHTML = `
                    <div class="alert alert-success">
                        <strong>✅ Éxito!</strong><br>
                        Respuesta generada: ${data.respuestaGenerada ? 'SÍ' : 'NO'}<br>
                        ID Respuesta: ${data.respuestaId || 'N/A'}<br>
                        Longitud: ${data.longitudRespuesta || 0} caracteres
                    </div>
                `;
                // Recargar status
                await loadStatus();
            } else {
                addLog(`❌ Error: ${data.error || 'Error desconocido'}`, 'error');
                resultDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <strong>❌ Error</strong><br>
                        ${data.error || 'Error desconocido'}<br>
                        <small>${data.type || ''}</small>
                        ${data.innerError ? `<br><small>Inner: ${data.innerError}</small>` : ''}
                    </div>
                `;
            }

            resultDiv.style.display = 'block';

        } catch (error) {
            addLog(`❌ Error de red: ${error.message}`, 'error');
            resultDiv.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
            resultDiv.style.display = 'block';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '⚡ Generar Respuesta IA Ahora';
        }
    }

    async function testConnection() {
        const btn = document.getElementById('btn-test-connection');
        const resultDiv = document.getElementById('connection-result');

        try {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Probando...';
            resultDiv.style.display = 'none';

            addLog('🔍 Probando conexión directa con Claude API...');

            const response = await fetch('/api/test/ai/test-connection');
            const data = await response.json();

            if (data.success) {
                addLog('✅ Conexión exitosa con Claude API', 'success');
                resultDiv.innerHTML = `
                    <div class="alert alert-success">
                        <strong>✅ Conexión Exitosa</strong><br>
                        Status: ${data.statusCode}<br>
                        La API de Claude responde correctamente.
                    </div>
                `;
            } else {
                addLog(`❌ Error de conexión: ${data.statusCode} ${data.statusText}`, 'error');
                resultDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <strong>❌ Error ${data.statusCode}: ${data.statusText}</strong><br>
                        URL: ${data.requestUrl}<br>
                        Model: ${data.model}<br>
                        <details>
                            <summary>Ver respuesta completa</summary>
                            <pre style="max-height: 200px; overflow-y: auto;">${JSON.stringify(data.error, null, 2)}</pre>
                        </details>
                    </div>
                `;
            }

            resultDiv.style.display = 'block';

        } catch (error) {
            addLog(`❌ Error: ${error.message}`, 'error');
            resultDiv.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
            resultDiv.style.display = 'block';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '🔍 Probar Conexión con Claude API';
        }
    }

    // Cargar al inicio
    document.addEventListener('DOMContentLoaded', () => {
        loadStatus();
    });
</script>
}
