@page
@model eiibd26.Pages.NotFoundModel
@{
    ViewData["Title"] = "Página no encontrada";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card shadow-sm rounded-3 p-4">
        <h1 class="h3 mb-3">404 · Página no encontrada</h1>
        <p class="text-muted">
            Lo sentimos — la página que buscas no existe o fue movida.
        </p>

        <div class="mt-3">
            <a class="btn btn-primary" href="/">Ir al inicio</a>
            <a class="btn btn-outline-secondary" href="/Identity/Account/Login">Ir a iniciar sesión</a>
        </div>

        <div class="mt-4 text-muted small">
            Código de estado: @Model.StatusCode
        </div>
    </div>
</div>