<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eiibd26</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/usuario-condiciones-modern.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <img src="~/img/logo.png" alt="eiibd26 logo" height="38" style="max-height:38px;max-width:140px;object-fit:contain;" />
                </a>
                <button class="navbar-toggler" type="button"
                        title="Abrir menú principal" aria-label="Abrir menú principal"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Menú principal izquierda -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Privacy">Privacidad</a>
                        </li>
                        <!-- Opción directa "Ir a Mi Perfil" -->
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" href="/Identity/Usuario/UsuarioPerfil" title="Ir a mi perfil" aria-label="Ir a mi perfil">
                                <i class="bi bi-person-circle me-1"></i>
                                <span>Ir a Mi Perfil</span>
                            </a>
                        </li>
                        <!-- Perfil desplegable con opciones de gestión -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="perfilDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false" title="Mi Perfil" aria-label="Mi Perfil">
                                <i class="bi bi-person-gear me-1"></i>
                                <span>Mi Perfil (Opciones)</span>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="perfilDropdown">
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage">
                                        <i class="bi bi-person-card"></i> Perfil principal
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/Email">
                                        <i class="bi bi-envelope"></i> Cambiar email
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/ChangePassword">
                                        <i class="bi bi-key"></i> Cambiar contraseña
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/TwoFactorAuthentication">
                                        <i class="bi bi-shield-lock"></i> Doble factor
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/ExternalLogins">
                                        <i class="bi bi-box-arrow-in-right"></i> Logins externos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Menú de usuario derecha: Login & Registro cuando el usuario NO está autenticado -->
                    <ul class="navbar-nav ms-auto">
                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Identity/Account/Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Identity/Account/Register">
                                    <i class="bi bi-person-plus"></i> Registro
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto p-0">
                @await Html.PartialAsync("Shared/_SidebarMenu")
            </div>
            <div class="col ps-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <footer class="border-top footer text-muted mt-3">
        <div class="container">
            &copy; 2025 - eiibd26 - <a href="/Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>