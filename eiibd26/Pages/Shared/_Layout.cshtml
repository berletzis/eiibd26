<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - eiibd26</title>

    <!-- Bootstrap & icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/miSalud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

    <style>
        /* Sidebar/offcanvas tuning and layout niceties */
        .layout-root {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Ensure the content area grows to fill screen (push footer down) */
        .layout-main {
            flex: 1 1 auto;
        }

        /* Sidebar static column (desktop) */
        .sidebar-col {
            width: 260px;
            min-width: 220px;
            max-width: 320px;
            border-right: 0;
        }

        /* Keep offcanvas sidebar full height for scroll if big */
        .offcanvas-sidebar .offcanvas-body {
            padding: 0;
            height: 100%;
            overflow-y: auto;
        }

        /* Container padding tuning for responsive */
        .app-container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        @@media (min-width: 768px) {
            .app-container {
                padding-left: 1.5rem;
                padding-right: 1.5rem;
            }
        }

        /* Floating small-screen toggle button (if you want it visible even when top menu doesn't include) */
        .sidebar-toggle-sm {
            display: none;
            position: fixed;
            z-index: 1100;
            right: 12px;
            bottom: 18px;
            border-radius: 50%;
            width: 48px;
            height: 48px;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 18px rgba(25,45,85,0.08);
        }

        @@media (max-width: 991.98px) {
            .sidebar-toggle-sm {
                display: flex;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="layout-root">
        @* Header / top menu *@
        @await Html.PartialAsync("_TopMenu")

        <main class="layout-main">
            <div class="container-fluid app-container">
                @* Row: sidebar (desktop) + main column. On small screens, show offcanvas instead. *@

                @{
                    // Determine current Razor Page path (e.g. "/Home/Index")
                    var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? "";
                    var currentPageNorm = currentPage?.Trim().ToLowerInvariant() ?? "";

                    // Should we show the sidebar?
                    // Show sidebar only when user is authenticated AND the current page is NOT Home nor Preguntas
                    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

                    // Hide sidebar for Home pages and Preguntas pages
                    var isHomePage = currentPageNorm.StartsWith("/home");
                    var isPreguntasPage = currentPageNorm.StartsWith("/preguntas");
                    var iscontenidosPage = currentPageNorm.StartsWith("/contenidos");
                    var showSidebar = isAuthenticated && !isHomePage && !isPreguntasPage && !iscontenidosPage;
                }

                <div class="row g-0 flex-nowrap">
                    @if (showSidebar)
                    {
                        @* Desktop sidebar column (hidden on small screens) *@
                        <div class="col-auto p-0 d-none d-md-block sidebar-col">
                            @await Html.PartialAsync("Shared/_SidebarMenu")
                        </div>

                        @* Main content column occupies remaining space (full width on small screens) *@
                        <div class="col ps-3">
                            @* Small-screen toggle: opens offcanvas sidebar for mobile *@
                            <div class="d-md-none mb-2 d-flex justify-content-end">
                                <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas" aria-label="Abrir menú">
                                    <i class="bi bi-list"></i>
                                </button>
                            </div>

                            <main role="main" class="pb-3">
                                @RenderBody()
                            </main>
                        </div>

                        @* Offcanvas sidebar used only on small screens (md-) *@
                        <div class="offcanvas offcanvas-start offcanvas-sidebar d-md-none" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
                            <div class="offcanvas-header">
                                <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">Menú</h5>
                                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                            </div>
                            <div class="offcanvas-body p-0">
                                @* reuse the same partial inside offcanvas *@
                                @await Html.PartialAsync("Shared/_SidebarMenu")
                            </div>
                        </div>
                    }
                    else
                    {
                        @* No sidebar: render a single full-width main column *@
                        <div class="col-12 ps-3">
                            <main role="main" class="pb-3">
                                @RenderBody()
                            </main>
                        </div>
                    }
                </div>
            </div>
        </main>

        @* Insert the footer partial (centered, same container width as blog, 4 columns) *@
        @await Html.PartialAsync("/Pages/Shared/_FooterPartial.cshtml")
    </div>

    <!-- Small-screen floating toggle (optional UX helper) -->
    @if (showSidebar)
    {
        <button class="btn btn-primary sidebar-toggle-sm d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas" aria-label="Abrir menú">
            <i class="bi bi-list" style="font-size:1.2rem;color:#fff;"></i>
        </button>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            // Cache for fetched content meta by contentId
            const contentMetaCache = new Map();

            // Delegated handler for +Más buttons (lazy loading)
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.btn-more');
                if (!btn) return;

                const contentId = btn.getAttribute('data-content-id');
                if (!contentId) return;

                const panelId = btn.getAttribute('aria-controls') || ('more-' + contentId);
                const panel = document.getElementById(panelId);
                if (!panel) return;

                const isOpen = panel.getAttribute('data-open') === 'true';

                if (!isOpen) {
                    // open: if not loaded, fetch fragment
                    if (panel.getAttribute('data-loaded') !== 'true') {
                        // show temporary loading indicator
                        const placeholder = panel.querySelector('.more-placeholder');
                        if (placeholder) placeholder.textContent = 'Cargando…';

                        try {
                            // fetch meta fragment
                            const url = '/Contenidos/ContentMeta?id=' + encodeURIComponent(contentId);
                            // prefer no-cache if you want freshest data
                            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                            if (!res.ok) throw new Error('Error ' + res.status);
                            const html = await res.text();
                            panel.innerHTML = html;
                            panel.setAttribute('data-loaded', 'true');
                            contentMetaCache.set(contentId, html);
                        } catch (err) {
                            console.error(err);
                            if (panel) panel.innerHTML = '<div style="color:#c00">Error cargando datos relacionados.</div>';
                        }
                    } else {
                        // already loaded, nothing to do
                    }

                    // show panel
                    panel.style.display = 'block';
                    panel.setAttribute('data-open', 'true');
                    panel.setAttribute('aria-hidden', 'false');
                    btn.setAttribute('aria-expanded', 'true');
                    btn.textContent = btn.textContent.replace(/^\+/, '-').trim();

                } else {
                    // close
                    panel.style.display = 'none';
                    panel.setAttribute('data-open', 'false');
                    panel.setAttribute('aria-hidden', 'true');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.textContent = btn.textContent.replace(/^-/, '+').trim();
                }
            }, false);

            // Accessibility: allow toggling with Enter/Space on focused .btn-more
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                const el = document.activeElement;
                if (el && el.classList && el.classList.contains('btn-more')) {
                    e.preventDefault();
                    el.click();
                }
            }, false);
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @* Removed local /lib/bootstrap/js/bootstrap.bundle.min.js to avoid 404; use CDN above *@

    @* Permitir que páginas y partials inyecten scripts en esta sección *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>