<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eiibd26</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eiibd26.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        /* --------- MINIMALISTA "Mi Salud" --------- */
        .navbar .dropdown-toggle.fw-medium {
            font-weight: 500 !important;
        }

        .navbar .nav-link .bi-heart-pulse {
            font-size: 1.2em;
            vertical-align: -0.05em;
            color: #e64980;
        }

        .navbar .dropdown-toggle .bi-heart-pulse {
            margin-right: 0.3em;
        }

        .dropdown-menu .dropdown-item .bi {
            font-size: 1em;
            opacity: .7;
        }

        @@media (max-width: 991.98px) {
            .navbar .dropdown-menu

        {
            min-width: 100% !important;
        }

        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">eiibd26</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Admin/Usuarios/Index">Usuarios</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Admin/Condiciones/Index">Condiciones</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Admin/Sintomas/Index">Síntomas</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Admin/Tratamientos/Index">Tratamientos</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @* MINIMALISTA: Mi Salud solo paciente logueado *@
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Paciente"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 fw-medium"
                                   href="#" id="pacienteDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   title="Gestión de salud personal">
                                    <i class="bi bi-heart-pulse"></i>
                                    Mi Salud
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="pacienteDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Usuario/UsuarioEstadoAnimo">
                                            <i class="bi bi-person-vcard me-1 text-body-secondary"></i> Mi Mood
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Usuario/UsuarioCondiciones">
                                            <i class="bi bi-person-vcard me-1 text-body-secondary"></i> Mis condiciones
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Usuario/UsuarioSintomas">
                                            <i class="bi bi-emoji-frown me-1 text-body-secondary"></i> Mis síntomas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Usuario/UsuarioSintomasSeguimiento">
                                            <i class="bi bi-emoji-frown me-1 text-body-secondary"></i> Seguimiento de síntomas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Usuario/UsuarioTratamientos">
                                            <i class="bi bi-capsule-pill me-1 text-body-secondary"></i> Mis tratamientos
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - eiibd26 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(function (item) {
            item.addEventListener('click', function () {
                var adminDropdown = document.getElementById('adminDropdown');
                if (adminDropdown) {
                    var dropdown = bootstrap.Dropdown.getInstance(adminDropdown);
                    if (dropdown) dropdown.hide();
                }
                var pacienteDropdown = document.getElementById('pacienteDropdown');
                if (pacienteDropdown) {
                    var dropdown2 = bootstrap.Dropdown.getInstance(pacienteDropdown);
                    if (dropdown2) dropdown2.hide();
                }
            });
        });
    </script>
</body>
</html>