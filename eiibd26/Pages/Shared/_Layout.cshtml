<!DOCTYPE html>
<html lang="es">
<head>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DPH2X6YNQ5"></script>
    @{
        var currentArea = (ViewContext.RouteData.Values["area"] as string) ?? "";
        var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? "";
        bool addSecondGtag = false;
        if (string.Equals(currentArea, "Identity", StringComparison.OrdinalIgnoreCase))
        {
            var p = (currentPage ?? string.Empty).ToLowerInvariant();
            if (p == "/account/register" || p == "/account/login" || p == "/usuario/dashboard")
            {
                addSecondGtag = true;
            }
        }
    }
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Configurar la propiedad principal siempre
      gtag('config', 'G-DPH2X6YNQ5');
      // Google Ads / AW tag requerida
      gtag('config', 'AW-11417573828');
      @if (addSecondGtag)
      {
          <text>gtag('config', 'G-QTD8HR2PJ3');</text>
      }
    </script>

    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Enfermedad Inflamatoria Intestinal</title>

    <!-- ===== PERFORMANCE: DNS Prefetch y Preconnect para CDNs ===== -->
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdn.datatables.net">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdn.datatables.net" crossorigin>

    @RenderSection("Head", required: false)  

    <!-- ===== PWA META TAGS ===== -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#6a4e7a" />
    <style>
        :root {
            --brand-color: #6a4e7a;
        }
    </style>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EIIBD" />
    <link rel="apple-touch-icon" href="/img/icons/icon-192x192.png" />

    <!-- ===== CRITICAL CSS: Inline para LCP ===== -->
    <style>
        /* Critical CSS - Estilos para above-the-fold */
        body{background:#f8f9fa;margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
        .layout-root{min-height:100vh;display:flex;flex-direction:column}
        .layout-main{flex:1 1 auto}
    </style>


    <!-- ===== PERFORMANCE: Preload recursos críticos ===== -->
    @inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
    @{ 
        var bundlePhysical = System.IO.Path.Combine(Env.WebRootPath ?? "wwwroot", "css", "bundle.min.css");
        var bundleExists = System.IO.File.Exists(bundlePhysical);
    }
    @if (bundleExists)
    {
        <link rel="preload" href="~/css/bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" asp-append-version="true" />
        <!-- Fallback / ensure styles are applied quickly for Identity and admin pages -->
        <link rel="stylesheet" href="~/css/bundle.min.css" asp-append-version="true" />
    }
    else
    {
        <!-- If bundle is not present (e.g. not generated in publish), include individual CSS files to avoid 404 returning HTML -->
        <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/miSalud.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site-responsive.css" asp-append-version="true" />
    }
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <!-- Ensure Bootstrap CSS is applied immediately (helps Identity/account pages) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- Fallback para navegadores sin JS -->
    <noscript>
        <link rel="stylesheet" href="~/css/bundle.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    </noscript>

    <!-- ===== ACCESIBILIDAD: focus ring y correcciones base (UI-027) ===== -->
    <link rel="stylesheet" href="~/css/accessibility-fixes.css" asp-append-version="true" />

    <!-- ===== DESIGN SYSTEM: tokens globales eii-* ===== -->
    <link rel="stylesheet" href="~/css/eiibd-tokens.css" asp-append-version="true" />

    <!-- ===== DESIGN SYSTEM: componentes eii-card · eii-btn · eii-input ===== -->
    <link rel="stylesheet" href="~/css/eiibd-components.css" asp-append-version="true" />

    <!-- ===== DESIGN SYSTEM: layout primitivas eii-page · eii-grid · eii-stack ===== -->
    <link rel="stylesheet" href="~/css/eiibd-layout.css" asp-append-version="true" />

    <!-- ===== DESIGN SYSTEM: utilities eii-text-* · eii-gap-* · eii-flex-* ===== -->
    <link rel="stylesheet" href="~/css/eiibd-utilities.css" asp-append-version="true" />

    <!-- ===== CSS NO CRÍTICO: Cargar de forma diferida ===== -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" media="print" onload="this.media='all'" />

    @RenderSection("Styles", required: false)

    <style>
        /* Sidebar/offcanvas tuning and layout niceties */
        .layout-root {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Ensure the content area grows to fill screen (push footer down) */
        .layout-main {
            flex: 1 1 auto;
        }

        /* Sidebar static column (desktop) */
        .sidebar-col {
            width: 260px;
            min-width: 220px;
            max-width: 320px;
            border-right: 1px solid var(--eii-border);
        }

        /* Keep offcanvas sidebar full height for scroll if big */
        .offcanvas-sidebar .offcanvas-body {
            padding: 0;
            height: 100%;
            overflow-y: auto;
        }

        /* Container padding tuning for responsive */
        .app-container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        @@media (min-width: 768px) {
            .app-container {
                padding-left: 1.5rem;
                padding-right: 1.5rem;
            }
        }

        /* ===== FAB SIDEBAR — páginas sin sidebar (home, contenidos, etc.) ===== */
        .sidebar-fab {
            display: none;
        }

        @@media (max-width: 991.98px) {
            .sidebar-fab {
                display: flex;
                position: fixed;
                bottom: 16px;
                right: 16px;
                width: 48px;
                height: 48px;
                border-radius: 12px;
                background: var(--eii-primary);
                color: #fff;
                border: none;
                cursor: pointer;
                align-items: center;
                justify-content: center;
                font-size: 1.35rem;
                z-index: 1050;
                box-shadow: 0 4px 16px rgba(106,78,122,.28);
                transition: box-shadow .2s, transform .15s;
            }

            .sidebar-fab:hover,
            .sidebar-fab:focus-visible {
                box-shadow: 0 6px 20px rgba(106,78,122,.4);
                transform: translateY(-2px);
                color: #fff;
            }

            /* scroll-to-top sube para no tapar el FAB */
            .scroll-to-top {
                bottom: 72px;
                right: 16px;
            }
        }

        /* ===== DASHBOARD MOBILE BAR — trigger contextual en páginas con sidebar ===== */
        .dashboard-mobile-bar {
            display: none;
        }

        @@media (max-width: 767.98px) {
            .dashboard-mobile-bar {
                display: flex;
                align-items: center;
                padding: var(--eii-space-2) 0 var(--eii-space-3) 0;
                margin-bottom: var(--eii-space-3);
                border-bottom: 1px solid var(--eii-border);
            }

            .dashboard-mobile-trigger {
                display: inline-flex;
                align-items: center;
                gap: var(--eii-space-2);
                padding: var(--eii-space-2) var(--eii-space-3);
                background: var(--eii-surface);
                border: 1px solid var(--eii-border);
                border-radius: var(--eii-radius-md);
                color: var(--eii-text-soft);
                font-size: var(--eii-text-sm);
                font-weight: 500;
                cursor: pointer;
                line-height: 1.4;
                transition: background var(--eii-transition-base), color var(--eii-transition-base), border-color var(--eii-transition-base);
            }

            .dashboard-mobile-trigger:hover,
            .dashboard-mobile-trigger:focus-visible {
                background: var(--eii-primary-soft);
                border-color: var(--eii-primary-border);
                color: var(--eii-primary);
                outline: none;
            }

            .dashboard-mobile-trigger i {
                font-size: 1.15rem;
            }
        }

        /* ===== SCROLL TO TOP BUTTON ===== */
        .scroll-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, var(--eii-primary) 100%);
            color: white;
            border: none;
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 4px 12px rgba(106, 78, 122, 0.3);
            transition: all 0.3s ease;
            z-index: 999;
            opacity: 0;
            transform: translateY(100px);
        }

        .scroll-to-top.show {
            display: flex;
            opacity: 1;
            transform: translateY(0);
        }

        .scroll-to-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(118, 75, 162, 0.4);
        }

        .scroll-to-top:active {
            transform: translateY(-1px);
        }

        .scroll-to-top i {
            line-height: 1;
        }

        @@media (max-width: 768px) {
            .scroll-to-top {
                width: 45px;
                height: 45px;
                font-size: 1.3rem;
            }
        }
    </style>


</head>
<body class="bg-light">
    <div class="layout-root">
        @* --- Use explicit desktop + mobile top menus (no duplicate header) --- *@
        @await Html.PartialAsync("~/Pages/Shared/_TopMenuDesktop.cshtml", model: null)
        @await Html.PartialAsync("~/Pages/Shared/_TopMenuMobile.cshtml", model: null)

        <main class="layout-main">
            <div class="container-fluid app-container">
                @{
                    // Determine current Razor Page path (e.g. "/Home/Index")
                    var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? "";
                    var currentPageNorm = currentPage?.Trim().ToLowerInvariant() ?? "";

                    // Should we show the sidebar?
                    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

                    // Hide sidebar for Home, Preguntas, Contenidos, Mapa, and public profile pages
                    var isHomePage = currentPageNorm.StartsWith("/home");
                    var isPreguntasPage = currentPageNorm.StartsWith("/preguntas");
                    var iscontenidosPage = currentPageNorm.StartsWith("/contenidos");
                    var isMapaPage = currentPageNorm.StartsWith("/mapa");
                    var isGlosarioPage = currentPageNorm.StartsWith("/glosario") || currentPageNorm.StartsWith("/termino");
                    var isPublicProfilePage = currentPageNorm.StartsWith("/u/") || currentPageNorm == "/u";
                    var showSidebar = isAuthenticated && !isHomePage && !isPreguntasPage && !iscontenidosPage && !isMapaPage && !isGlosarioPage && !isPublicProfilePage;
                }

                <div class="row g-0 flex-nowrap">
                    @if (showSidebar)
                    {
                        @* Desktop sidebar column (hidden on small screens) *@
                        <div class="col-auto p-0 d-none d-md-block sidebar-col">
                            @await Html.PartialAsync("Shared/_SidebarMenu")
                        </div>

                        @* Main content column occupies remaining space (full width on small screens) *@
                        <div class="col ps-3 align-self-start">

                            @* Mobile: trigger contextual del panel de control *@
                            <div class="dashboard-mobile-bar" role="navigation" aria-label="Navegación del panel">
                                <button class="dashboard-mobile-trigger"
                                        type="button"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#sidebarOffcanvas"
                                        aria-controls="sidebarOffcanvas"
                                        aria-label="Abrir panel de control">
                                    <i class="bi bi-list" aria-hidden="true"></i>
                                    <span>Panel de control</span>
                                </button>
                            </div>

                            <main role="main" class="pb-3">
                                @RenderBody()
                            </main>
                        </div>

                    }
                    else
                    {
                        @* No sidebar: render a single full-width main column *@
                        <div class="col-12 p-0">
                            <main role="main" class="pb-3">
                                @RenderBody()
                            </main>
                        </div>
                    }
                </div>
            </div>
        </main>

        @* Insert the footer partial *@
        @await Html.PartialAsync("/Pages/Shared/_Footer.cshtml")
    </div>

    @* Offcanvas sidebar: siempre disponible para usuarios autenticados (usado por el botón flotante en todas las páginas) *@
    @if (isAuthenticated)
    {
        <div class="offcanvas offcanvas-start offcanvas-sidebar" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">Menú</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body p-0">
                @await Html.PartialAsync("Shared/_SidebarMenu")
            </div>
        </div>
    }

    <!-- ===== PERFORMANCE: JavaScript con defer para no bloquear renderizado ===== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>

    <!-- Clear offcanvas inline width/max-width that some scripts (or bootstrap) may set at runtime -->
    <script defer>
        window.addEventListener('DOMContentLoaded', function() {
          function clearOffcanvasInlineStyles(el) {
            try {
              if (!el || !el.style) return;
              el.style.removeProperty('width');
              el.style.removeProperty('max-width');
            } catch (e) { /* ignore */ }
          }

          document.addEventListener('show.bs.offcanvas', function (ev) {
            var el = ev.target || ev.srcElement;
            // After bootstrap has applied inline styles, remove them so our CSS override wins
            requestAnimationFrame(function(){ clearOffcanvasInlineStyles(el); });
            setTimeout(function(){ clearOffcanvasInlineStyles(el); }, 60);
          });

          // Observe offcanvas elements for inline style changes and clear suspicious widths
          try {
            var mo = new MutationObserver(function (mutations) {
              mutations.forEach(function (m) {
                if (m.type === 'attributes' && m.attributeName === 'style') {
                  var t = m.target;
                  if (t && t.classList && t.classList.contains('offcanvas')) {
                    var w = (t.style.width || t.style.maxWidth || '').toString();
                    if (w && w.length) {
                      var numeric = parseInt(w.replace('px','').replace('vw',''), 10);
                      if (isNaN(numeric) || numeric > 86) {
                        t.style.removeProperty('width');
                        t.style.removeProperty('max-width');
                      }
                    }
                  }
                }
              });
            });

            document.querySelectorAll('.offcanvas').forEach(function(n){ mo.observe(n, { attributes: true, attributeFilter: ['style'] }); });

            // If new offcanvas nodes are added later, observe them too
            var bodyObserver = new MutationObserver(function(muts){
              muts.forEach(function(m){
                if (m.type === 'childList' && m.addedNodes && m.addedNodes.length) {
                  m.addedNodes.forEach(function(n){
                    if (n.nodeType === 1 && n.classList && n.classList.contains('offcanvas')) {
                      try { mo.observe(n, { attributes: true, attributeFilter: ['style'] }); } catch(e) {}
                    }
                  });
                }
              });
            });
            bodyObserver.observe(document.body, { childList: true, subtree: true });
          } catch(e) { /* ignore */ }
        });
    </script>

    <script defer>
        window.addEventListener('DOMContentLoaded', function() {
        // --- Prevent layout shift from Bootstrap's body padding compensation for scrollbar ---
        (function () {
            function clearBodyPadding() {
                try {
                    if (document.body && document.body.style) {
                        // Only clear if an inline paddingRight exists and it's suspiciously large
                        var pr = document.body.style.paddingRight;
                        if (pr) {
                            var val = parseInt(pr.replace('px',''), 10);
                            // if the calculated compensation is large ( > 40px ), remove it
                            if (isNaN(val) || val > 40) {
                                document.body.style.paddingRight = '';
                            }
                        }
                    }
                } catch (e) { /* ignore */ }
            }

            // Listen to Bootstrap offcanvas events and clear the padding after Bootstrap sets it
            document.addEventListener('show.bs.offcanvas', function () {
                requestAnimationFrame(clearBodyPadding);
                setTimeout(clearBodyPadding, 50);
            });
            document.addEventListener('shown.bs.offcanvas', clearBodyPadding);
            document.addEventListener('hide.bs.offcanvas', clearBodyPadding);
            document.addEventListener('hidden.bs.offcanvas', clearBodyPadding);

            // Mutation observer as a safety-net: if some script later writes a very large padding-right,
            // remove it automatically (helps when other scripts toggle body styles)
            try {
                var observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (m) {
                        if (m.type === 'attributes' && m.attributeName === 'style' && m.target === document.body) {
                            var pr = document.body.style.paddingRight;
                            if (pr) {
                                var val = parseInt(pr.replace('px',''), 10);
                                if (!isNaN(val) && val > 40) {
                                    document.body.style.paddingRight = '';
                                }
                            }
                        }
                    });
                });
                observer.observe(document.body, { attributes: true, attributeFilter: ['style'] });
            } catch (e) {
                // ignore (older browsers)
            }
        })();
    });
    </script>

    <script>
        (function () {
            // Cache for fetched content meta by contentId
            const contentMetaCache = new Map();

            // Delegated handler for +Más buttons (lazy loading)
            document.addEventListener('click', async function (e) {
                const btn = e.target.closest('.btn-more');
                if (!btn) return;

                const contentId = btn.getAttribute('data-content-id');
                if (!contentId) return;

                const panelId = btn.getAttribute('aria-controls') || ('more-' + contentId);
                const panel = document.getElementById(panelId);
                if (!panel) return;

                const isOpen = panel.getAttribute('data-open') === 'true';

                if (!isOpen) {
                    // open: if not loaded, fetch fragment
                    if (panel.getAttribute('data-loaded') !== 'true') {
                        // show temporary loading indicator
                        const placeholder = panel.querySelector('.more-placeholder');
                        if (placeholder) placeholder.textContent = 'Cargando…';

                        try {
                            // fetch meta fragment
                            const url = '/Contenidos/ContentMeta?id=' + encodeURIComponent(contentId);
                            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                            if (!res.ok) throw new Error('Error ' + res.status);
                            const html = await res.text();
                            panel.innerHTML = html;
                            panel.setAttribute('data-loaded', 'true');
                            contentMetaCache.set(contentId, html);
                        } catch (err) {
                            console.error(err);
                            if (panel) panel.innerHTML = '<div style="color:#c00">Error cargando datos relacionados.</div>';
                        }
                    }
                    // show panel
                    panel.style.display = 'block';
                    panel.setAttribute('data-open', 'true');
                    panel.setAttribute('aria-hidden', 'false');
                    btn.setAttribute('aria-expanded', 'true');
                    btn.textContent = btn.textContent.replace(/^\+/, '-').trim();
                } else {
                    // close
                    panel.style.display = 'none';
                    panel.setAttribute('data-open', 'false');
                    panel.setAttribute('aria-hidden', 'true');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.textContent = btn.textContent.replace(/^-/, '+').trim();
                }
            }, false);

            // Accessibility: allow toggling with Enter/Space on focused .btn-more
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                const el = document.activeElement;
                if (el && el.classList && el.classList.contains('btn-more')) {
                    e.preventDefault();
                    el.click();
                }
            }, false);
        })();
    </script>
    @* Chart.js se carga bajo demanda en las páginas que lo usan (Dashboard, EstadoAnimo) — UI-019 *@

