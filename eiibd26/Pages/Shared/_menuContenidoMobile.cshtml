@using System
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@inject ApplicationDbContext Db

@{
    // Parent sequence to show in the mobile menu (same as original)
    const int parentSequence = 1;

    // Helper to determine active path
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
    Func<string, bool> IsActivePath = seg =>
    {
        if (string.IsNullOrEmpty(seg)) return false;
        var normSeg = seg.StartsWith("/") ? seg.TrimEnd('/') : ("/" + seg.TrimEnd('/'));
        if (normSeg == "/") return string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase);
        return string.Equals(currentPath, normSeg, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(normSeg + "/", StringComparison.OrdinalIgnoreCase);
    };

    // Load parent (don't require parent.Relevante here)
    var parent = await Db.ContenidosCategorias
        .AsNoTracking()
        .FirstOrDefaultAsync(c => c.Sequence == parentSequence && !c.Borrado);

    // Load only relevant children
    List<dynamic> children = new();
    if (parent != null)
    {
        var childEntities = await Db.ContenidosCategorias
            .AsNoTracking()
            .Where(c => c.CategoriaPadre == (int?)parentSequence && !c.Borrado && c.Relevante == true)
            .OrderBy(c => c.Orden)
            .ThenBy(c => c.Nombre)
            .ToListAsync();

        children = childEntities.Cast<dynamic>().ToList();
    }

    string parentPath = null;
    bool parentIsActive = false;
    bool shouldRenderParent = false;
    if (parent != null)
    {
        var slugParent = !string.IsNullOrWhiteSpace(parent.CategoriaSlug) ? parent.CategoriaSlug : parent.Sequence.ToString();
        parentPath = "/" + slugParent;
        parentIsActive = IsActivePath(parentPath) || (children.Any() && children.Any(ch => IsActivePath("/" + (string.IsNullOrWhiteSpace((string)ch.CategoriaSlug) ? ch.Sequence.ToString() : (string)ch.CategoriaSlug))));
        shouldRenderParent = (parent.Relevante == true) || (children != null && children.Any());
    }
}

@if (parent != null && shouldRenderParent)
{
    <li class="nav-item">
        <a class="nav-link@(parentIsActive ? " active fw-bold text-purple" : "")" href="@Url.Content(parentPath)">
            @parent.Nombre
        ++</a>
    </li>
}