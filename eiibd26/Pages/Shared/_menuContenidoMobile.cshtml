@using System
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@inject ApplicationDbContext Db

@{
    // Parent sequence to show in the mobile menu (same as original)
    const int parentSequence = 1;

    // Helper to determine active path
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
    Func<string, bool> IsActivePath = seg =>
    {
        if (string.IsNullOrEmpty(seg)) return false;
        var normSeg = seg.StartsWith("/") ? seg.TrimEnd('/') : ("/" + seg.TrimEnd('/'));
        if (normSeg == "/") return string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase);
        return string.Equals(currentPath, normSeg, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(normSeg + "/", StringComparison.OrdinalIgnoreCase);
    };

    // Load parent only (mobile should not render children)
    var parent = await Db.ContenidosCategorias
        .AsNoTracking()
        .FirstOrDefaultAsync(c => c.Sequence == parentSequence && !c.Borrado && c.Relevante == true);

    string parentPath = null;
    bool parentIsActive = false;
    if (parent != null)
    {
        var slugParent = !string.IsNullOrWhiteSpace(parent.CategoriaSlug) ? parent.CategoriaSlug : parent.Sequence.ToString();
        parentPath = "/Contenidos/categoria/" + slugParent;
        parentIsActive = IsActivePath(parentPath);
    }
}

@if (parent != null)
{
    <li class="nav-item">
        <a class="nav-link@(parentIsActive ? " active fw-bold text-purple" : "")" href="@Url.Content(parentPath)">
            @parent.Nombre
        </a>
    </li>
}