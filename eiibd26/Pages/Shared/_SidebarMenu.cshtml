@* Shared sidebar menu (corrección final)
   - Mantengo tu markup intacto.
   - Incluyo botón inline (class="sidebar-toggle-inline") dentro del sidebar.
   - Incluyo script que ELIMINA (remove()) cualquier otro botón que abra #sidebarOffcanvas
     siempre que esté fuera de .sidebar-menu o ubicado en la topbar.
*@

@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using eiibd26.Models
@using eiibd26.Data
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var path = ViewContext.HttpContext.Request.Path.ToString();
    // Mustard color for the icon
    var mustard = "#D4A017";

    // Helpers for active states
    bool IsActive(string p) => string.Equals(path, p, StringComparison.OrdinalIgnoreCase);
    bool IsStartingWith(string p) => path.StartsWith(p ?? "", StringComparison.OrdinalIgnoreCase);

    // Content submenu open if any contenidos route is active
    var contenidosRoot = "/Identity/Admin/Contenidos";
    var contenidosOpen = IsStartingWith(contenidosRoot);

    // ✅ NUEVO: Obtener el slug del usuario autenticado
    string userSlug = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = UserManager.GetUserId(User);
        if (Guid.TryParse(userId, out var userGuid))
        {
            userSlug = await DbContext.Perfil
                .AsNoTracking()
                .Where(p => p.idUser == userGuid)
                .Select(p => p.slug)
                .FirstOrDefaultAsync();
        }
    }
}

<style>
    /* Sidebar sizing (desktop) - more width so items don't wrap and reduce white area */
    .sidebar-menu {
        width: 260px;
        min-width: 260px;
        max-width: 320px;
        box-sizing: border-box;
        font-size: .9rem;
        font-weight: 400;
    }

        /* Tighter nav item spacing */
        .sidebar-menu .nav-link {
            padding: .45rem .6rem;
            font-size: .9rem;
            font-weight: 400;
        }

            /* Ensure icons keep consistent space */
            .sidebar-menu .nav-link .me-2 {
                min-width: 30px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

    /* Offcanvas (mobile) width: make it wider and remove big blank margins */
    #sidebarOffcanvas.offcanvas {
        --bs-offcanvas-width: 320px; /* bootstrap 5 variable */
        max-width: 92%;
    }

    /* Slightly reduce padding inside offcanvas body so content fills space */
    #sidebarOffcanvas .offcanvas-body {
        padding-top: .75rem;
        padding-bottom: .75rem;
        padding-left: .6rem;
        padding-right: .6rem;
    }

    /* When sidebar-menu is rendered inside the offcanvas, make it use the full offcanvas width */
    #sidebarOffcanvas .sidebar-menu {
        width: 100%;
        min-height: calc(100vh - 56px);
        border-right: none;
        box-shadow: none;
    }

    /* Remove duplicate inline toggler from inside the offcanvas (visual safety) -
                       script already attempts to remove duplicates, esto evita ver un botón encima */
    #sidebarOffcanvas .sidebar-toggle-inline {
        display: none !important;
    }

    /* Reduce the large blank vertical spacing between items inside offcanvas */
    #sidebarOffcanvas .nav {
        gap: .25rem;
    }

    /* Position close button visually consistent */
    #sidebarOffcanvas .btn-close {
        position: absolute;
        top: .5rem;
        right: .5rem;
    }

    /* Responsive tweaks: on narrow devices, let offcanvas take a bit more width */
    @@media (max-width: 768px) {
        .sidebar-menu {
            width: auto;
            min-width: 0;
        }

        #sidebarOffcanvas.offcanvas {
            --bs-offcanvas-width: 85%;
            max-width: 420px;
        }
    }

    /* Accessibility & small styling */
    .sidebar-menu .nav-link .visually-hidden {
        margin-left: .25rem;
    }
</style>


