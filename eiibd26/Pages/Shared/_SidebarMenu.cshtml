@* Shared sidebar menu *@

@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using eiibd26.Models
@using eiibd26.Data
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var path = ViewContext.HttpContext.Request.Path.ToString();

    // Helpers for active states
    bool IsActive(string p) => string.Equals(path, p, StringComparison.OrdinalIgnoreCase);
    bool IsStartingWith(string p) => path.StartsWith(p ?? "", StringComparison.OrdinalIgnoreCase);

    // Content submenu open if any contenidos route is active
    var contenidosRoot = "/Identity/Admin/Contenidos";
    var contenidosOpen = IsStartingWith(contenidosRoot);

    // ✅ NUEVO: Obtener el slug del usuario autenticado
    string userSlug = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = UserManager.GetUserId(User);
        if (Guid.TryParse(userId, out var userGuid))
        {
            userSlug = await DbContext.Perfil
                .AsNoTracking()
                .Where(p => p.idUser == userGuid)
                .Select(p => p.slug)
                .FirstOrDefaultAsync();
        }
    }

    // Slug del médico para el link de perfil público
    string medicoSlug = null;
    if (User.Identity?.IsAuthenticated == true && User.IsInRole("Medico"))
    {
        var userIdForMedico = UserManager.GetUserId(User);
        if (Guid.TryParse(userIdForMedico, out var medicoUserGuid))
        {
            medicoSlug = await DbContext.MedicosPerfilExtendido
                .AsNoTracking()
                .Where(p => p.UserId == medicoUserGuid)
                .Select(p => p.Slug)
                .FirstOrDefaultAsync();
        }
    }
}

<div class="d-flex flex-column flex-shrink-0 p-3 sidebar-menu" style="min-height:100vh; position:relative;">
    <ul class="nav nav-pills flex-column mb-auto">
        <!-- Admin encabezado (solo escudo rojo en cuadro, palabra normal) -->
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador") && !IsStartingWith("/u/"))
        {
            <li class="nav-item">
                <span class="sidebar-section-label">
                    <span class="sidebar-icon sidebar-icon--admin">
                        <i class="bi bi-shield-shaded"></i>
                    </span>
                    Admin
                </span>
            </li>

            @* Contenidos parent with collapsible submenu *@
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center ms-2 @(contenidosOpen ? "active" : "")"
                       data-bs-toggle="collapse"
                       href="#submenuContenidos"
                       role="button"
                       aria-expanded="@(contenidosOpen.ToString().ToLower())"
                       aria-controls="submenuContenidos">
                    <i class="bi bi-folder2-open me-2"></i>
                    <span>Contenidos</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </a>

                <div class="collapse @(contenidosOpen ? "show" : "")" id="submenuContenidos">
                    <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                        <li>
                            <a href="/Identity/Admin/Contenidos/Index"
                                   class="nav-link ms-4 @(IsActive("/Identity/Admin/Contenidos/Index") ? "active" : "")">
                                <i class="bi bi-file-earmark-text"></i> Contenidos
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Admin/Contenidos/ContenidosCategorias"
                                   class="nav-link ms-4 @(IsActive("/Identity/Admin/Contenidos/ContenidosCategorias") ? "active" : "")">
                                <i class="bi bi-tags"></i> Categorías de Contenido
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Admin/BannersInicio/Index"
                                   class="nav-link ms-4 @(IsActive("/Identity/Admin/BannersInicio/Index") ? "active" : "")">
                                <i class="bi bi-images"></i> Banners Inicio
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="/Identity/Admin/Usuarios/Index" class="nav-link ms-4 @(IsActive("/Identity/Admin/Usuarios/Index") ? "active" : "")">
                    <i class="bi bi-person-vcard"></i> Usuarios
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Condiciones/Index" class="nav-link ms-4 @(IsActive("/Identity/Admin/Condiciones/Index") ? "active" : "")">
                    <i class="bi bi-hospital"></i> Condiciones
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Sintomas/Index" class="nav-link ms-4 @(IsActive("/Identity/Admin/Sintomas/Index") ? "active" : "")">
                    <i class="bi bi-activity"></i> Síntomas
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Tratamientos/Index" class="nav-link ms-4 @(IsActive("/Identity/Admin/Tratamientos/Index") ? "active" : "")">
                    <i class="bi bi-prescription2"></i> Tratamientos
                </a>
            </li>
            <li class="nav-item">
                <button class="nav-link ms-4 w-100 text-start d-flex justify-content-between align-items-center border-0 bg-transparent"
                        data-bs-toggle="collapse" data-bs-target="#labSubmenu"
                        aria-expanded="@(IsStartingWith("/Identity/Admin/Laboratorios") ? "true" : "false")">
                    <span><i class="bi bi-file-earmark-medical"></i> Laboratorios</span>
                    <i class="bi bi-chevron-@(IsStartingWith("/Identity/Admin/Laboratorios") ? "up" : "down")" style="font-size:.75rem;"></i>
                </button>
                <div class="collapse @(IsStartingWith("/Identity/Admin/Laboratorios") ? "show" : "")" id="labSubmenu">
                    <ul class="list-unstyled ms-3" style="font-size:.85rem;">
                        <li>
                            <a href="/Identity/Admin/Laboratorios/Index" class="nav-link @(IsActive("/Identity/Admin/Laboratorios/Index") ? "active" : "")">
                                <i class="bi bi-list-ul"></i> Catálogo
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Admin/Laboratorios/Resultados" class="nav-link @(IsActive("/Identity/Admin/Laboratorios/Resultados") ? "active" : "")">
                                <i class="bi bi-journal-medical"></i> Resultados
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
            <li>
                <a href="/Identity/Admin/DirectorioMedicos/Index"
                   class="nav-link ms-4 @(IsStartingWith("/Identity/Admin/DirectorioMedicos") ? "active" : "")">
                    <i class="bi bi-person-lines-fill"></i> Directorio Médicos
                </a>
            </li>
        }

        @* Solo mostrar bloque paciente si es Paciente Y NO es Administrador (consistente con Identity/_SidebarMenu) *@
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Paciente") && !User.IsInRole("Administrador"))
        {
            <li class="nav-item mb-1">
                @if (!string.IsNullOrWhiteSpace(userSlug))
                {
                    <a href="/u/@userSlug"
                           class="nav-link d-flex align-items-center @(path.StartsWith("/u/", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           target="_blank"
                           title="Ver mi perfil público">
                        <span class="sidebar-icon sidebar-icon--brand me-2">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <span>Mi Perfil Público</span>
                        <i class="bi bi-box-arrow-up-right ms-auto" style="font-size:.8em; opacity:.5;"></i>
                    </a>
                }
                else
                {
                    <a href="/Identity/Account/Manage/Index"
                           class="nav-link d-flex align-items-center @(IsActive("/Identity/Account/Manage/Index") ? "active" : "")"
                           title="Configurar mi perfil">
                        <span class="sidebar-icon sidebar-icon--brand me-2">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <span>Configurar Perfil</span>
                    </a>
                }
            </li>

            <li class="nav-item mb-1">
                <a href="/Identity/Usuario/Dashboard"
                       class="nav-link d-flex align-items-center @(IsActive("/Identity/Usuario/Dashboard") ? "active" : "")">
                    <span class="sidebar-icon sidebar-icon--brand me-2">
                        <i class="bi bi-motherboard"></i>
                    </span>
                    <span>Panel de Control</span>
                </a>
            </li>

            <li class="nav-item mb-1">
                <a href="/Identity/Usuario/usuarioPreguntasRespuestas"
                       class="nav-link d-flex align-items-center @(IsActive("/Identity/Usuario/usuarioPreguntasRespuestas") ? "active" : "")">
                    <span class="sidebar-icon sidebar-icon--brand me-2">
                        <i class="bi bi-chat-left-dots"></i>
                    </span>
                    <span>Mis P&R</span>
                </a>
            </li>

            <li class="nav-item mb-1">
                <a href="/DirectorioMedicos"
                   class="nav-link d-flex align-items-center @(IsStartingWith("/DirectorioMedicos") ? "active" : "")">
                    <span class="sidebar-icon sidebar-icon--brand me-2">
                        <i class="bi bi-hospital"></i>
                    </span>
                    <span>Médicos</span>
                </a>
            </li>

            <!-- Mi Salud encabezado (corazón en cuadro morado, texto normal) -->
            <li class="nav-item">
                <span class="sidebar-section-label">
                    <span class="sidebar-icon sidebar-icon--health">
                        <i class="bi bi-heart-pulse"></i>
                    </span>
                    Mi Salud
                </span>
            </li>

            <li>
                <a href="/Identity/Usuario/UsuarioEstadoAnimo" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioEstadoAnimo") ? "active" : "")">
                    <i class="bi bi-emoji-smile"></i> Estado de Ánimo
                </a>
            </li>
            <li>
                <a href="/Identity/Usuario/UsuarioCondiciones" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioCondiciones") ? "active" : "")">
                    <i class="bi bi-lungs"></i> Mis condiciones
                </a>
            </li>
            <li>
                <a href="/Identity/Usuario/UsuarioSintomas" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioSintomas") ? "active" : "")">
                    <i class="bi bi-heartbreak"></i> Mis síntomas
                </a>
            </li>
            <li>
                <a href="/Identity/Usuario/UsuarioSintomasSeguimiento" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioSintomasSeguimiento") ? "active" : "")">
                    <i class="bi bi-graph-up"></i> Seguimiento de síntomas
                </a>
            </li>
            <li>
                <a href="/Identity/Usuario/UsuarioTratamientos" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioTratamientos") ? "active" : "")">
                    <i class="bi bi-capsule-pill"></i> Mis tratamientos
                </a>
            </li>
            <li>
                <a href="/Identity/Usuario/UsuarioLaboratorios" class="nav-link ms-4 @(IsActive("/Identity/Usuario/UsuarioLaboratorios") ? "active" : "")">
                    <i class="bi bi-file-earmark-medical"></i> Mis laboratorios
                </a>
            </li>
        }

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Medico"))
        {
            <li class="nav-item">
                <span class="sidebar-section-label">
                    Mi espacio médico
                </span>
            </li>
            <li class="nav-item mb-1">
                <a href="/Identity/Medico/Dashboard"
                   class="nav-link d-flex align-items-center @(IsStartingWith("/Identity/Medico") ? "active" : "")">
                    <span class="sidebar-icon sidebar-icon--brand me-2">
                        <i class="bi bi-speedometer2"></i>
                    </span>
                    <span>Mi Dashboard</span>
                </a>
            </li>
            @if (!string.IsNullOrWhiteSpace(medicoSlug))
            {
                <li class="nav-item mb-1">
                    <a href="/medicos/@medicoSlug" target="_blank"
                       class="nav-link d-flex align-items-center">
                        <span class="sidebar-icon sidebar-icon--brand me-2">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </span>
                        <span>Ver mi perfil público</span>
                    </a>
                </li>
            }
        }
    </ul>
</div>
