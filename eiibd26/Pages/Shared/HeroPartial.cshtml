@model eiibd26.Models.HeroViewModel

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="hero-inner">
                <h1>@Model.Title</h1>
                <p class="lead">@Model.Subtitle</p>
                @if (!string.IsNullOrEmpty(Model.CallToAction))
                {
                    <p><a href="~/Identity/Account/Manage" class="btn btn-primary">@Model.CallToAction</a></p>
                }
            </div>
        </div>
    </div>
</div>