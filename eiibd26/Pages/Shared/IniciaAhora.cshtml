@{
    Layout = null;
}

<style>
    /* ===== IniciaAhora Partial ===== */
    .inicia-ahora {
        max-width: 1340px;
        margin: 0 auto 3rem;
        padding: 2.5rem 1rem 1rem;
        text-align: center;
    }

    .inicia-ahora__title {
        font-size: 2rem;
        font-weight: 300;
        color: var(--eii-text-heading);
        margin-bottom: 2rem;
        line-height: 1.2;
        letter-spacing: -0.04em;
    }

    /* ---- Tab bar ---- */
    .inicia-tabs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #eef3f5;
        border-radius: 50px;
        padding: 0.5rem 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 2.5rem;
    }

    .inicia-tabs__label {
        font-weight: var(--eii-fw-semibold);
        color: #546e76;
        font-size: 0.95rem;
        white-space: nowrap;
        padding-right: 0.5rem;
    }

    .inicia-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.25rem;
        border-radius: 50px;
        border: 2px solid transparent;
        background: transparent;
        color: #546e76;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .inicia-tab-btn i {
        font-size: 1.1rem;
    }

    .inicia-tab-btn:hover {
        background: #fff;
        color: var(--eii-primary);
        border-color: #c6b8e0;
    }

    .inicia-tab-btn.active {
        background: linear-gradient(135deg, #667eea 0%, var(--eii-primary) 100%);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(106, 78, 122, 0.35);
    }

    .inicia-tab-btn.active i {
        color: #fff;
    }

    /* ---- Tab panels ---- */
    .inicia-tab-panel {
        display: none;
    }

    .inicia-tab-panel.active {
        display: block;
    }

    /* ---- Steps row (3 columns) ---- */
    .inicia-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        text-align: left;
    }

    .inicia-step {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .inicia-step__number {
        font-size: 3rem;
        font-weight: var(--eii-fw-bold);
        line-height: 1;
        color: #c6b8e0;
        flex-shrink: 0;
        width: 2.5rem;
        background: linear-gradient(160deg, #667eea, var(--eii-primary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .inicia-step__body {
    }

    .inicia-step__heading {
        font-size: 1rem;
        font-weight: var(--eii-fw-semibold);
        color: var(--eii-text);
        margin-bottom: 0.35rem;
    }

    .inicia-step__text {
        font-size: 0.875rem;
        color: #546a70;
        line-height: 1.55;
        margin: 0;
    }

    /* ---- Responsive ---- */
    @@media (max-width: 767.98px) {
        .inicia-ahora__title {
            font-size: 1.5rem;
        }

        .inicia-tabs {
            gap: 0.35rem;
            padding: 0.4rem 0.6rem;
        }

        .inicia-tab-btn {
            font-size: 0.82rem;
            padding: 0.45rem 0.9rem;
        }

        .inicia-steps {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .inicia-step__number {
            font-size: 2.2rem;
            width: 2rem;
        }
    }

    @@media (max-width: 575.98px) {
        .inicia-tabs__label {
            width: 100%;
            padding-right: 0;
            text-align: center;
        }
    }
</style>

<section class="inicia-ahora" aria-labelledby="inicia-ahora-title">
    <h2 class="inicia-ahora__title" id="inicia-ahora-title">¿Por dónde empiezo?</h2>

    <!-- Tab bar -->
    <div class="inicia-tabs" role="tablist" aria-label="Elige lo que deseas hacer">
        @* <span class="inicia-tabs__label" aria-hidden="true">Quiero...</span> *@

        <button class="inicia-tab-btn active"
                id="tab-comunidad"
                role="tab"
                aria-selected="true"
                aria-controls="panel-comunidad"
                type="button">
            <i class="bi bi-people-fill"></i> Conectar con la comunidad
        </button>

        <button class="inicia-tab-btn"
                id="tab-condicion"
                role="tab"
                aria-selected="false"
                aria-controls="panel-condicion"
                type="button">
            <i class="bi bi-journal-medical"></i> Aprender sobre mi condición
        </button>

        <button class="inicia-tab-btn"
                id="tab-salud"
                role="tab"
                aria-selected="false"
                aria-controls="panel-salud"
                type="button">
            <i class="bi bi-heart-pulse"></i> Registrar mi salud
        </button>
    </div>

    <!-- Panel 1: Comunidad -->
    <div class="inicia-tab-panel active"
         id="panel-comunidad"
         role="tabpanel"
         aria-labelledby="tab-comunidad">
        <div class="inicia-steps">
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">1</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Crea tu perfil público</div>
                    <p class="inicia-step__text">Preséntate a la comunidad. Comparte tanto o tan poco como quieras sobre tu camino con la EII y el apoyo que buscas. <a href="/Identity/Account/Manage/UsuarioPerfil>" target="_blank">Aquí</a></p>
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">2</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Encuentra tu comunidad</div>
                    <p class="inicia-step__text">Conecta con personas que viven con Crohn, Colitis Ulcerosa o Colitis Microscópica. Forma parte de una comunidad segura y empática. <a href="/Mapa/">Conócenos</a></p>
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">3</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Participa en la conversación</div>
                    <p class="inicia-step__text">Haz preguntas, comparte experiencias y recibe respuestas personalizadas de personas que entienden lo que estás viviendo. <a href="/Preguntas/">Pregunta o Responde</a></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel 2: Condición -->
    <div class="inicia-tab-panel"
         id="panel-condicion"
         role="tabpanel"
         aria-labelledby="tab-condicion">
        <div class="inicia-steps">
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">1</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Explora el Glosario</div>
                    <p class="inicia-step__text">Consulta términos médicos, procedimientos y conceptos clave relacionados con la Enfermedad Inflamatoria Intestinal en lenguaje claro. <a href="/Glosario/">Revisar</a> </p>
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">2</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Lee Guías y Contenidos</div>
                    <p class="inicia-step__text">Accede a artículos, guías y recursos escritos para pacientes. Información confiable sobre diagnóstico, tratamientos y vida con EII. <a href="/general/">Leer Más</a> </p>
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">3</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Pregunta y Aprende</div>
                    <p class="inicia-step__text">Usa la sección de Preguntas &amp; Respuestas para resolver dudas específicas con la ayuda de la comunidad y recursos verificados. <a href="/Preguntas/">Pregunta o Responde</a></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel 3: Salud -->
    <div class="inicia-tab-panel"
         id="panel-salud"
         role="tabpanel"
         aria-labelledby="tab-salud">
        <div class="inicia-steps">
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">1</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Registra tu Estado de Ánimo</div>
                    <p class="inicia-step__text">Lleva un diario emocional y comparte cómo te sientes cada día. Un simple ¡Hola! contribuye a la comunidad y a tu historial personal.
                        <a href="/como-utilizar-este-sitio-web/estado-de-animo">¿Para qué?</a> / <a href="/Identity/Usuario/UsuarioEstadoAnimo" target="_blank">Agregalo Aquí</a>
                    </p>
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">2</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Monitorea tus Síntomas</div>
                    <p class="inicia-step__text">Registra síntomas día a día y genera reportes visuales. Detecta patrones y lleva información útil a tus consultas médicas. <a href="/como-utilizar-este-sitio-web/mis-sintomas-seguimiento">¿Por qué?</a> / <a href="/Identity/Usuario/UsuarioSintomas/" target="_blank">Agregalo Aquí</a></p>
                    
                </div>
            </div>
            <div class="inicia-step">
                <div class="inicia-step__number" aria-hidden="true">3</div>
                <div class="inicia-step__body">
                    <div class="inicia-step__heading">Controla tus Tratamientos</div>
                    <p class="inicia-step__text">Organiza tus medicamentos y tratamientos actuales. Ten todo en un lugar y comparte lo que funciona con otros pacientes de la comunidad. <a href="/como-utilizar-este-sitio-web/mis-tratamientos/">¿Para qué?</a> / <a href="/Identity/Usuario/UsuarioTratamientos" target="_blank">Agregalos Aquí</a></p>
                    
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const tabs = document.querySelectorAll('.inicia-tab-btn');
        const panels = document.querySelectorAll('.inicia-tab-panel');

        tabs.forEach(function (btn) {
            btn.addEventListener('click', function () {
                const targetId = btn.getAttribute('aria-controls');

                // Deactivate all
                tabs.forEach(function (t) {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                panels.forEach(function (p) {
                    p.classList.remove('active');
                });

                // Activate clicked
                btn.classList.add('active');
                btn.setAttribute('aria-selected', 'true');
                const panel = document.getElementById(targetId);
                if (panel) panel.classList.add('active');
            });
        });
    })();
</script>
