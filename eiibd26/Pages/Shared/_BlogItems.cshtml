@* eiibd26/Pages/Shared/_BlogItems.cshtml (CORREGIDO: solo texto de categoría) *@
@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    string GetContentSeoUrl(int contentId, string contentSlug, string? categorySlugOverride = null)
    {
        if (string.IsNullOrWhiteSpace(contentSlug))
            return $"/Contenidos/Detalle?id={contentId}";

        if (!string.IsNullOrWhiteSpace(categorySlugOverride))
            return $"/{categorySlugOverride}/{contentSlug}";

        return $"/c/{contentSlug}";
    }

    string GetContentMetaUrl(int contentId)
    {
        return $"/Contenidos/ContentMeta?id={contentId}";
    }

    string? GetPropString(object obj, string propName)
    {
        if (obj == null) return null;
        var p = obj.GetType().GetProperty(propName);
        if (p == null) return null;
        var v = p.GetValue(obj);
        return v as string;
    }

    // ✅ NUEVO: Extraer solo el texto de la categoría (sin HTML)
    string ExtractCategoryText(string categoryHtml)
    {
        if (string.IsNullOrWhiteSpace(categoryHtml)) return string.Empty;
        
        // Remover todas las etiquetas HTML
        var textOnly = Regex.Replace(categoryHtml, "<.*?>", string.Empty);
        
        // Decodificar entidades HTML (&amp; → &, etc.)
        textOnly = System.Net.WebUtility.HtmlDecode(textOnly);
        
        return textOnly.Trim();
    }
}

<style>
    /* Estilo del botón + Más / - Menos */
    .btn-blog-more {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: #764ba2;
        font-size: .9rem;
        cursor: pointer;
        text-decoration: none;
        font-weight: 400;
        display: inline-block;
    }

        .btn-blog-more:hover {
            color: #5a2d7a;
            text-decoration: underline;
        }

        .btn-blog-more:disabled {
            opacity: 0.6;
            cursor: default;
            text-decoration: none;
        }

        .btn-blog-more:focus {
            outline: 2px dashed rgba(118, 75, 162, 0.4);
            outline-offset: 3px;
        }

    /* Contenedor de imagen con posición relativa */
    .blog-card .thumb {
        position: relative;
        display: block;
        overflow: hidden;
        width: 100%;
        height: 100%;
    }

        .blog-card .thumb a {
            display: block;
            width: 100%;
            height: 100%;
            position: relative;
        }

        .blog-card .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    /* ✅ Categoría con fondo gris (solo texto, sin link clickeable) */
    .blog-category-overlay {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(80, 80, 80, 0.85);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 6px 12px;
        border-radius: 5px;
        display: inline-block;
        max-width: 66.666%;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        z-index: 10;
        line-height: 1.2;
        pointer-events: none;
        user-select: none;
    }

    /* Placeholder también con position relative */
    .blog-card .thumb > div {
        position: relative;
        width: 100%;
        height: 100%;
    }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var contentSlug = GetPropString(item, "Slug") ?? GetPropString(item, "ContenidoTituloSlug") ?? "";
        var categorySlug = GetPropString(item, "PrimaryCategorySlug")
                           ?? GetPropString(item, "CategorySlug")
                           ?? GetPropString(item, "PrimaryCategory")
                           ?? "";

        var contentUrl = GetContentSeoUrl(item.Id, contentSlug, string.IsNullOrWhiteSpace(categorySlug) ? null : categorySlug);
        var metaUrl = GetContentMetaUrl(item.Id);

        // ✅ Extraer solo el texto de la categoría
        var categoryText = ExtractCategoryText(item.Category);

        <article class="blog-card" data-content-id="@item.Id">
            <div class="thumb">
                <a href="@contentUrl" aria-label="@item.Title">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                    }
                    else
                    {
                        <div style="width:100%;height:100%;background:#f3f6fa;position:relative;"></div>
                    }

                    @* ✅ Mostrar solo el TEXTO de la categoría (sin link) *@
                    @if (!string.IsNullOrWhiteSpace(categoryText))
                    {
                        <span class="blog-category-overlay">@categoryText</span>
                    }
                </a>
            </div>

            <div class="content">
                <h3 class="blog-title">
                    <a href="@contentUrl">
                        @item.Title
                    </a>
                </h3>

                @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                {
                    <p class="blog-excerpt">@item.Excerpt</p>
                }

                <div class="blog-footer">
                    <div class="author">
                        <div class="avatar">
                            <img src="~/img/avatar-placeholder.png" alt="@item.Author" />
                        </div>
                        <span>@item.Author</span>
                    </div>
                    <time datetime="@item.CreatedAt.ToString("yyyy-MM-dd")">
                        @item.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)
                    </time>
                </div>

                <div class="mt-2">
                    <button type="button"
                            class="btn-blog-more"
                            data-meta-url="@metaUrl"
                            data-content-id="@item.Id">
                        + Más
                    </button>
                </div>

                <div class="more-panel" data-meta-url="@metaUrl" aria-hidden="true" style="display:none;"></div>
            </div>
        </article>
    }
}
else
{
    <div style="grid-column: 1 / -1; text-align: center; color: #6b7280; padding: 40px 0;">
        No hay contenidos disponibles.
    </div>
}