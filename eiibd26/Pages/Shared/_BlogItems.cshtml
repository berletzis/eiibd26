@* eiibd26/Pages/Shared/_BlogItems.cshtml (CORREGIDO: solo texto de categoría) *@
@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    string GetContentSeoUrl(int contentId, string contentSlug, string? categorySlugOverride = null)
    {
        if (string.IsNullOrWhiteSpace(contentSlug))
            return $"/Contenidos/Detalle?id={contentId}";

        if (!string.IsNullOrWhiteSpace(categorySlugOverride))
            return $"/{categorySlugOverride}/{contentSlug}";

        return $"/c/{contentSlug}";
    }

    string GetContentMetaUrl(int contentId)
    {
        return $"/Contenidos/ContentMeta?id={contentId}";
    }

    string? GetPropString(object obj, string propName)
    {
        if (obj == null) return null;
        var p = obj.GetType().GetProperty(propName);
        if (p == null) return null;
        var v = p.GetValue(obj);
        return v as string;
    }

    string ExtractCategoryText(string categoryHtml)
    {
        if (string.IsNullOrWhiteSpace(categoryHtml)) return string.Empty;
        var textOnly = Regex.Replace(categoryHtml, "<.*?>", string.Empty);
        textOnly = System.Net.WebUtility.HtmlDecode(textOnly);
        return textOnly.Trim();
    }
}

<style>
    /* Blog card — solo estilos que eii-card no cubre */

    /* Imagen con efecto zoom — break out del padding del eii-card */
    .blog-thumb {
        position: relative;
        width: calc(100% + 2 * var(--eii-space-5));
        margin: calc(-1 * var(--eii-space-5)) calc(-1 * var(--eii-space-5)) var(--eii-space-4);
        height: 180px;
        overflow: hidden;
        border-radius: var(--eii-radius-lg) var(--eii-radius-lg) 0 0;
        flex-shrink: 0;
    }
    .blog-thumb a {
        display: block;
        width: 100%;
        height: 100%;
    }
    .blog-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transform: scale(1.10);
        transition: transform var(--eii-transition-slow);
    }
    .eii-card--link:hover .blog-thumb img { transform: scale(1.15); }

    /* Overlay de categoría en la imagen */
    .blog-category-overlay {
        position: absolute;
        bottom: var(--eii-space-2);
        right: var(--eii-space-2);
        background: rgba(0,0,0,0.72);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        color: #fff;
        font-size: var(--eii-text-xs);
        font-weight: var(--eii-fw-semibold);
        padding: 3px 8px;
        border-radius: var(--eii-radius-sm);
        max-width: 66%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        z-index: 10;
        pointer-events: none;
        user-select: none;
    }

    /* Fila de autor */
    .blog-author {
        display: flex;
        align-items: center;
        gap: var(--eii-space-2);
        font-size: var(--eii-text-sm);
        color: var(--eii-text);
    }
    .blog-author img {
        width: 32px;
        height: 32px;
        border-radius: var(--eii-radius-full);
        object-fit: cover;
        flex-shrink: 0;
    }
    .blog-author a, .blog-author span {
        color: var(--eii-text);
        text-decoration: none;
        transition: color var(--eii-transition-base);
    }
    .blog-author a:hover { color: var(--eii-primary); }

    /* Excerpt: texto oscuro legible */
    .eii-card__body > p {
        color: var(--eii-text) !important;
    }

    /* Evita que la expansión del "Leer más" estire las cards vecinas del mismo renglón.
       height:100% en .eii-card--link resuelve al alto del grid track (el más alto de la fila).
       Con height:auto cada card mide solo lo que necesita; el renglón siguiente se recorre. */
    article.eii-card {
        height: auto;
    }

    @@media (max-width: 575.98px) {
        .blog-thumb { height: 220px; }
    }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
    var contentSlug = GetPropString(item, "Slug") ?? GetPropString(item, "ContenidoTituloSlug") ?? "";
    var categorySegmentFromView = ViewData["categorySegment"] as string;
    var categorySlug = !string.IsNullOrWhiteSpace(categorySegmentFromView)
                       ? categorySegmentFromView
                       : (GetPropString(item, "PrimaryCategorySlug")
                          ?? GetPropString(item, "CategorySlug")
                          ?? GetPropString(item, "PrimaryCategory")
                          ?? "");
    if (!string.IsNullOrWhiteSpace(categorySlug))
    {
        categorySlug = categorySlug.Trim();
        if (categorySlug == "?" || categorySlug == "#") categorySlug = "";
        categorySlug = categorySlug.Trim('/').Split('?')[0].Split('#')[0];
    }

    var contentUrl = GetContentSeoUrl(item.Id, contentSlug, string.IsNullOrWhiteSpace(categorySlug) ? null : categorySlug);
    var metaUrl = GetContentMetaUrl(item.Id);
    var categoryText = ExtractCategoryText(item.Category);

        <article class="eii-card eii-card--link" data-content-id="@item.Id">

            <div class="blog-thumb">
                <a href="@contentUrl" aria-label="@item.Title">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@(item.ImageUrl)" alt="@item.Title" loading="lazy" decoding="async" fetchpriority="low"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")';" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")" alt="@item.Title"
                             loading="lazy" decoding="async" fetchpriority="low" />
                    }
                </a>
                @if (!string.IsNullOrWhiteSpace(categoryText))
                {
                    <span class="blog-category-overlay">@categoryText</span>
                }
            </div>

            <div class="eii-card__body">
                <h3 class="eii-card__title eii-clamp-2">
                    <a href="@contentUrl" style="text-decoration:none;color:inherit;">@item.Title</a>
                </h3>

                @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                {
                    <p class="eii-text-sm eii-clamp-3 mt-1 mb-0">@item.Excerpt</p>
                }
            </div>

            <div class="eii-card__footer">
                <div class="blog-author">
                    @{
                        var authorImg = !string.IsNullOrWhiteSpace(item.AuthorImageUrl) ? item.AuthorImageUrl : Url.Content("~/img/avatar-placeholder.png");
                    }
                    <img src="@authorImg" alt="@item.Author" loading="lazy" decoding="async" width="32" height="32"
                         onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")'" />
                    @if (!string.IsNullOrWhiteSpace(item.AuthorSlug) || item.AuthorId != null)
                    {
                        var profileUrl = !string.IsNullOrWhiteSpace(item.AuthorSlug) ? ("/contenidos/porAutor/" + item.AuthorSlug) : ("/contenidos/autorId/" + (item.AuthorId?.ToString() ?? ""));
                        <a href="@profileUrl">@item.Author</a>
                    }
                    else
                    {
                        <span>@item.Author</span>
                    }
                </div>
                <time datetime="@item.CreatedAt.ToString("yyyy-MM-dd")" class="eii-text-xs eii-text-muted">
                    @item.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)
                </time>
            </div>

            @if (item.Validadores.Any())
            {
                <partial name="_ValidadoresAvatares" model="@item.Validadores" />
            }

            @if (!string.IsNullOrWhiteSpace(metaUrl))
            {
                <div class="mt-2">
                    <button type="button" class="btn-blog-more eii-btn eii-btn--link eii-text-sm"
                            data-meta-url="@metaUrl" data-content-id="@item.Id">
                        Leer más
                    </button>
                </div>
                <div class="more-panel" data-meta-url="@metaUrl" aria-hidden="true" style="display:none;"></div>
            }

        </article>
    }
}
else
{
    <div class="eii-empty" style="grid-column:1/-1">
        <i class="bi bi-file-earmark-text eii-empty__icon"></i>
        <p class="eii-empty__text">No hay contenidos disponibles.</p>
    </div>
}
