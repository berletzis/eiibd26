@* eiibd26/Pages/Shared/_BlogItems.cshtml *@
@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization

@functions {
    string GetContentSeoUrl(int contentId, string contentSlug, int? categoryId = null, string categorySlugOverride = null)
    {
        if (string.IsNullOrWhiteSpace(contentSlug))
            return $"/Contenidos/Detalle?id={contentId}";

        if (!string.IsNullOrWhiteSpace(categorySlugOverride))
            return $"/{categorySlugOverride}/{contentSlug}";

        return $"/c/{contentSlug}";
    }

    string GetContentMetaUrl(int contentId)
    {
        return $"/Contenidos/ContentMeta?id={contentId}";
    }
}

<style>
    /* Estilo del botón + Más / - Menos como link morado sin decoración */

    .blog-category {
        font-size: 12px;
        color: #764ba2;
        margin-bottom: 6px;
        display: inline-block;
        text-decoration: none;
    }


    .btn-blog-more {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: #764ba2;
        font-size: .9rem;
        cursor: pointer;
        text-decoration: none;
        font-weight: 400;
        display: inline-block;
    }

        .btn-blog-more:hover {
            color: #5a2d7a;
            text-decoration: underline;
        }

        .btn-blog-more:disabled {
            opacity: 0.6;
            cursor: default;
            text-decoration: none;
        }

        .btn-blog-more:focus {
            outline: 2px dashed rgba(118, 75, 162, 0.4);
            outline-offset: 3px;
        }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var contentUrl = GetContentSeoUrl(item.Id, item.Slug, item.PrimaryCategoryId, item.PrimaryCategorySlug);
        var metaUrl = GetContentMetaUrl(item.Id);

        <article class="blog-card" data-content-id="@item.Id">
            <a href="@contentUrl" class="thumb" aria-label="@item.Title">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                }
                else
                {
                    <div style="width:100%;height:100%;background:#f3f6fa;"></div>
                }
            </a>

            <div class="content">
                @if (!string.IsNullOrWhiteSpace(item.Category))
                {
                    <div class="blog-category">
                        @Html.Raw(item.Category)
                    </div>
                }

                <h3 class="blog-title">
                    <a href="@contentUrl">
                        @item.Title
                    </a>
                </h3>

                @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                {
                    <p class="blog-excerpt">@item.Excerpt</p>
                }

                <div class="blog-footer">
                    <div class="author">
                        <div class="avatar">
                            <img src="~/img/avatar-placeholder.png" alt="@item.Author" />
                        </div>
                        <span>@item.Author</span>
                    </div>
                    <time datetime="@item.CreatedAt.ToString("yyyy-MM-dd")">
                        @item.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)
                    </time>
                </div>

                <div class="mt-2">
                    <button type="button"
                            class="btn-blog-more"
                            data-meta-url="@metaUrl"
                            data-content-id="@item.Id">
                        + Más
                    </button>
                </div>

                <div class="more-panel" data-meta-url="@metaUrl" aria-hidden="true" style="display:none;"></div>
            </div>
        </article>
    }
}
else
{
    <div style="grid-column: 1 / -1; text-align: center; color: #6b7280; padding: 40px 0;">
        No hay contenidos disponibles.
    </div>
}