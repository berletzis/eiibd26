@* eiibd26/Pages/Shared/_BlogItems.cshtml *@
@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization

@functions {
    string GetContentSeoUrl(int contentId, string contentSlug, int? categoryId = null, string categorySlugOverride = null)
    {
        if (string.IsNullOrWhiteSpace(contentSlug))
            return $"/Contenidos/Detalle?id={contentId}";

        // Si se proporciona categoría explícita
        if (!string.IsNullOrWhiteSpace(categorySlugOverride))
            return $"/{categorySlugOverride}/{contentSlug}";

        // Sin categoría
        return $"/c/{contentSlug}";
    }
}

<style>
    /* Estilos alineados con Pages/Contenidos/Index y porCategoria */

    .blog-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .blog-card .thumb {
            width: 100%;
            height: 220px; /* mismo alto que Index.cshtml */
            background: #f3f6fb;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
        }

            .blog-card .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .blog-card .content {
            background: #fff;
            padding: 16px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Categoría en morado, igual que en Index/porCategoria */
        .blog-card .blog-category,
        .blog-card .category-pill,
        .blog-card .blog-meta a {
            font-size: 12px;
            color: #764ba2;
            text-decoration: none;
        }

            .blog-card .blog-category:hover,
            .blog-card .category-pill a:hover,
            .blog-card .blog-meta a:hover {
                color: #5a2d7a;
                text-decoration: underline;
            }

        .blog-card .blog-meta {
            margin-bottom: 6px;
            font-size: 12px;
        }

        .blog-card .blog-title {
            margin: 0;
            font-size: .9rem;
            font-weight: 400;
            color: #0f172a;
        }

            .blog-card .blog-title a {
                color: inherit;
                text-decoration: none;
            }

        .blog-card .blog-excerpt {
            color: #6b7280;
            font-size: 0.95rem;
            line-height: 1.3;
            margin: 0;
        }

        .blog-card .blog-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: #9ca3af;
            font-size: .9rem;
            margin-top: 4px;
        }

        .blog-card .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #374151;
            font-size: .95rem;
        }

        .blog-card .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            display: inline-block;
        }

            .blog-card .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <article class="blog-card" role="article" aria-labelledby="title-@item.Id">
            <a href="@GetContentSeoUrl(item.Id, item.Slug, item.PrimaryCategoryId, item.PrimaryCategorySlug)"
               class="thumb"
               aria-label="@item.Title">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                }
                else
                {
                    <div style="width:100%;height:100%;background:#f3f6fb;display:flex;align-items:center;justify-content:center;color:#94a3b8;">
                        <svg width="80" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <path d="M21 15l-5-5L5 21"></path>
                        </svg>
                    </div>
                }
            </a>

            <div class="content">
                @if (!string.IsNullOrWhiteSpace(item.Category))
                {
                    <div class="blog-meta">
                        @Html.Raw(item.Category)
                    </div>
                }

                <h3 id="title-@item.Id" class="blog-title">
                    <a href="@GetContentSeoUrl(item.Id, item.Slug, item.PrimaryCategoryId, item.PrimaryCategorySlug)">
                        @item.Title
                    </a>
                </h3>

                @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                {
                    <p class="blog-excerpt">@item.Excerpt</p>
                }

                <div class="blog-footer">
                    <div class="author">
                        <span class="avatar">
                            <img src="~/img/avatar-placeholder.png" alt="@item.Author" />
                        </span>
                        <span>@item.Author</span>
                    </div>
                    <time datetime="@item.CreatedAt.ToString("yyyy-MM-dd")">
                        @item.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)
                    </time>
                </div>
            </div>
        </article>
    }
}
else
{
    <div style="grid-column: 1 / -1; text-align: center; color: #6b7280; padding: 40px 0;">
        No hay contenidos disponibles.
    </div>
}