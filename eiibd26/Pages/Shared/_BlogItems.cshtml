@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization

@if (Model == null || !Model.Any())
{
    @* empty fragment *@
}
else
{
    foreach (var it in Model)
    {
        <article class="blog-card" role="article" aria-labelledby="title-@it.Id">
            <div class="thumb" aria-hidden="true">
                @if (!string.IsNullOrEmpty(it.ImageUrl))
                {
                    <img src="@it.ImageUrl" alt="@it.Title" loading="lazy" style="width:100%; height:220px; object-fit:cover; border-top-left-radius:8px; border-top-right-radius:8px;" />
                }
                else
                {
                    <div style="width:100%; height:220px; background:#f3f6fb; display:flex; align-items:center; justify-content:center; color:#94a3b8; border-top-left-radius:8px; border-top-right-radius:8px;">
                        <svg width="80" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                    </div>
                }
            </div>

            <div class="content" style="background:#fff; padding:16px; border-radius:0 0 8px 8px; box-shadow: 0 1px 0 rgba(0,0,0,0.03);">
                <div>
                    @if (!string.IsNullOrWhiteSpace(it.Category))
                    {
                        <div class="blog-meta" style="font-size:12px; color:#2563eb; margin-bottom:6px;">@it.Category</div>
                    }
                    <h3 id="title-@it.Id" class="blog-title" style="margin:0 0 8px 0; font-size:1.05rem; line-height:1.2;">
                        <a href="~/Contenidos/Detalle?id=@it.Id" style="text-decoration:none;color:inherit;">@it.Title</a>
                    </h3>
                    <div class="blog-excerpt" style="color:#6b7280; font-size:0.95rem; margin-bottom:12px;">@it.Excerpt</div>
                </div>

                <div class="blog-footer" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                    <div class="author" style="display:flex; align-items:center; gap:8px;">
                        <span class="avatar" style="width:32px; height:32px; border-radius:50%; overflow:hidden; display:inline-block;">
                            <img src="~/img/avatar-placeholder.png" alt="@it.Author" style="width:100%; height:100%; object-fit:cover;" />
                        </span>
                        <span style="font-size:0.95rem; color:#374151;">@it.Author</span>
                    </div>
                    <div class="pubdate" style="color:#9ca3af; font-size:0.9rem;">@it.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                </div>
            </div>
        </article>
    }
}