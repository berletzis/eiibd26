@model IEnumerable<eiibd26.Models.BlogItemVm>
@using System.Globalization

@* This partial outputs only the article cards (no surrounding grid) so the page's .items-container controls the layout.
   Keep layout/CSS in the page (Index.cshtml / porCategoria.cshtml) to avoid conflicts that produced very narrow columns. *@

@if (Model == null || !Model.Any())
{
    @* empty fragment *@
}
else
{
    @foreach (var it in Model)
    {
        <article class="blog-card" role="article" aria-labelledby="title-@it.Id" data-id="@it.Id" style="position:relative;">
            <div class="thumb" aria-hidden="true">
                @if (!string.IsNullOrEmpty(it.ImageUrl))
                {
                    <img src="@it.ImageUrl" alt="@it.Title" loading="lazy" style="width:100%; height:220px; object-fit:cover; display:block;" />
                }
                else
                {
                    <div style="width:100%; height:220px; background:#f3f6fb; display:flex; align-items:center; justify-content:center; color:#94a3b8;">
                        <svg width="80" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                    </div>
                }
            </div>

            <div class="content" style="background:#fff; padding:16px; box-sizing:border-box;">
                <div>
                    @* CATEGORY: render HTML anchor stored in it.Category or fallback to first condition *@
                    @if (!string.IsNullOrWhiteSpace(it.Category))
                    {
                        <div class="blog-meta" style="font-size:12px; color:#2563eb; margin-bottom:6px;">@Html.Raw(it.Category)</div>
                    }
                    else if (it.Conditions != null && it.Conditions.Any())
                    {
                        <div class="blog-meta" style="font-size:12px; color:#2563eb; margin-bottom:6px;">@it.Conditions.First()</div>
                    }

                    <h3 id="title-@it.Id" class="blog-title" style="margin:0 0 8px 0; font-size:1.05rem; line-height:1.2;">
                        <a href="@Url.Page("/Contenidos/Detalle", new { id = it.Id })" style="text-decoration:none;color:inherit;">@it.Title</a>
                    </h3>

                    <div class="blog-excerpt" style="color:#6b7280; font-size:0.95rem; margin-bottom:12px;">@it.Excerpt</div>
                </div>

                <div class="blog-footer" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                    <div class="author" style="display:flex; align-items:center; gap:8px;">
                        <span class="avatar" style="width:32px; height:32px; border-radius:50%; overflow:hidden; display:inline-block;">
                            <img src="~/img/avatar-placeholder.png" alt="@it.Author" style="width:100%; height:100%; object-fit:cover;" />
                        </span>
                        <span style="font-size:0.95rem; color:#374151;">@it.Author</span>
                    </div>
                    <div class="pubdate" style="color:#9ca3af; font-size:0.9rem;">@it.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                </div>

                <div style="margin-top:12px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-more"
                            data-content-id="@it.Id"
                            aria-expanded="false"
                            aria-controls="more-@it.Id"
                            aria-label="Mostrar más información relacionada">
                        + Más
                    </button>
                </div>

                <div id="more-@it.Id" class="more-panel" style="display:none; margin-top:12px; border-top:1px dashed #e6eef6; padding-top:12px;" aria-hidden="true" data-loaded="false">
                    <div class="more-placeholder" style="color:#6b7280;">Contenido relacionado no cargado. Haz clic en "+ Más" para ver más.</div>
                </div>
            </div>
        </article>
    }
}