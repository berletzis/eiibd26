@using eiibd26.Services.Platillos
@model MonedaAlimentoVm
@inject IIconoAlimentoService Iconos
@*
    Moneda de alimento: círculo con el color de su grupo + glifo tono-sobre-tono.
    El glifo va INLINE para que herede currentColor del grupo; decorativo (aria-hidden), porque el
    nombre y el grupo siempre viven como texto real junto a la moneda.
    Grupo desconocido → los colores de .eii-moneda (los de "otro") quedan sin sobrescribir.
*@
<span class="eii-moneda eii-grupo-@Iconos.GrupoSlug(Model.Grupo) @Model.ExtraClass">
    @Iconos.Icono(Model.Nombre, Model.Grupo)
</span>
