@using eiibd26.Models
@using eiibd26.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _db

@{
    // Cargar categorías directamente desde la vista
    var categorias12 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 12 || c.CategoriaPadre == 12))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    var categorias47 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 47 || c.CategoriaPadre == 47))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    var categorias3 = await _db.ContenidosCategorias
            .AsNoTracking()
            .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 3 || c.CategoriaPadre == 3))
            .OrderBy(c => c.Orden)
            .ThenBy(c => c.Nombre)
            .ToListAsync();

    // Procesar categorías 12
    var cat12Parent = categorias12?.FirstOrDefault(c => c.Sequence == 12);
    var cat12Children = categorias12?.Where(c => c.CategoriaPadre == 12).ToList();
    var cat12Slug = !string.IsNullOrWhiteSpace(cat12Parent?.CategoriaSlug)
        ? cat12Parent.CategoriaSlug
        : "12";
    var cat12Name = cat12Parent?.Nombre ?? "Soporte Técnico";

    // Procesar categorías 47
    var cat47Parent = categorias47?.FirstOrDefault(c => c.Sequence == 47);
    var cat47Children = categorias47?.Where(c => c.CategoriaPadre == 47).ToList();
    var cat47Slug = !string.IsNullOrWhiteSpace(cat47Parent?.CategoriaSlug)
        ? cat47Parent.CategoriaSlug
        : "47";
    var cat47Name = cat47Parent?.Nombre ?? "Recursos";

    // Procesar categorías 3
    var cat3Parent = categorias3?.FirstOrDefault(c => c.Sequence == 3);
    var cat3Children = categorias3?.Where(c => c.CategoriaPadre == 3).ToList();
    var cat3Slug = !string.IsNullOrWhiteSpace(cat3Parent?.CategoriaSlug)
        ? cat3Parent.CategoriaSlug
        : "3";
    var cat3Name = cat3Parent?.Nombre ?? "Legales";
}

<footer class="site-footer bg-white border-top" role="contentinfo" aria-label="Pie de página">
    <div class="container">
        <div class="footer-inner py-4">

            <!-- Top row: logo left, center spacer (no social icons here for desktop) -->
            <div class="row align-items-start footer-top mb-4">
                <div class="col-12 col-md-3 mb-3 mb-md-0">
                    <a href="/" class="d-inline-flex align-items-center" aria-label="Ir al inicio">
                        <img src="~/img/logo.png" alt="eiibd" class="footer-logo" />
                    </a>
                </div>

                <div class="col-12 col-md-6 d-none d-md-block"></div>

                <div class="col-12 col-md-3"></div>
            </div>

            <!-- Main columns: parents shown as full-width on mobile (col-12), lists visible on md+ -->
            <div class="row footer-main align-items-start g-3 mb-4">

                <!-- Column 1: Nosotros (static links) -->
                <div class="col-12 col-md-3">
                    <h6 class="footer-heading mb-2">
                        <a href="/@cat47Slug" class="footer-heading-link">@cat47Name</a>
                    </h6>

                    <!-- list hidden on mobile -->
                    @if (cat47Children != null && cat47Children.Any())
                    {
                        <ul class="list-unstyled footer-list">
                            @foreach (var c in cat47Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug)
                                ? c.CategoriaSlug
                                : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
  

                </div>

                <!-- Column 2: Categorías 12 (dynamic from DB) -->
                <div class="col-12 col-md-3">
                    <h6 class="footer-heading mb-2">
                        <a href="/@cat12Slug" class="footer-heading-link">@cat12Name</a>
                    </h6>

                    <!-- list hidden on mobile -->
                    @if (cat12Children != null && cat12Children.Any())
                    {
                        <ul class="list-unstyled footer-list d-none d-md-block">
                            @foreach (var c in cat12Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug)
                                ? c.CategoriaSlug
                                : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 3: Categorías 3 (dynamic from DB) -->
                <div class="col-12 col-md-3">
                    <h6 class="footer-heading mb-2">
                        <a href="/@cat3Slug" class="footer-heading-link">@cat3Name</a>
                    </h6>

                    <!-- list hidden on mobile -->
                    @if (cat3Children != null && cat3Children.Any())
                    {
                        <ul class="list-unstyled footer-list d-none d-md-block">
                            @foreach (var c in cat3Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug)
                                ? c.CategoriaSlug
                                : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 3: Desktop social icons & desktop action buttons (centered in column) -->
                <div class="col-12 col-md-3 d-none d-md-flex flex-column align-items-center justify-content-center footer-desktop-actions">

                    <nav aria-label="Redes sociales (escritorio)" class="footer-social-desktop d-flex gap-2 mb-3">
                        <a class="social-link" href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="social-link" href="#" aria-label="Twitter"><i class="bi bi-twitter"></i></a>
                        <a class="social-link" href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a class="social-link" href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </nav>

                    <div class="d-flex gap-2 footer-desktop-squares">
                        <a href="https://wa.me/1234567890" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>

                        <a href="/Contacto" class="btn square-btn btn-light border" aria-label="Contacto" title="Contacto">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>

                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <!-- Column 4: Categorías 47 (desktop) / Mobile social icons -->
                <div class="col-12 col-md-3">

                    <!-- Mobile: Social icons (visible only on mobile) -->
                    <div class="mobile-icons-row d-flex gap-2 mb-3 d-md-none">
                        <nav aria-label="Redes sociales (móvil)" class="d-flex gap-2">
                            <a class="social-link" href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a class="social-link" href="#" aria-label="Twitter"><i class="bi bi-twitter"></i></a>
                            <a class="social-link" href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a class="social-link" href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        </nav>
                    </div>

                    <!-- Mobile: Action buttons (visible only on mobile) -->
                    <div class="d-flex gap-2 mb-0 d-md-none footer-action-buttons">
                        <a href="https://wa.me/1234567890" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>

                        <a href="/Contacto" class="btn square-btn btn-light border" aria-label="Contacto" title="Contacto">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>

                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Copyright / disclaimer -->
            <div class="row">
                <div class="col-12">
                    <small class="text-muted d-block" style="line-height:1.35;">
                        © @DateTime.UtcNow.Year eiibd. Todos los derechos reservados.
                        eiibd es un sitio de referencia y no recomienda ni respalda a ningún proveedor o tratamiento médico en particular. Ninguna información en eiibd debe interpretarse como consejo médico y/o de salud.
                    </small>
                </div>
            </div>

        </div>
    </div>
</footer>