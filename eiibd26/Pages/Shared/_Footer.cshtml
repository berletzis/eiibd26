@using eiibd26.Models
@using eiibd26.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _db

@{
    // Cargar categorías 12 y 47 (como antes)
    var categorias12 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 12 || c.CategoriaPadre == 12))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    var categorias47 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 47 || c.CategoriaPadre == 47))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    // Procesar categorías 12
    var cat12Parent = categorias12?.FirstOrDefault(c => c.Sequence == 12);
    var cat12Children = categorias12?.Where(c => c.CategoriaPadre == 12).ToList();
    var cat12Slug = !string.IsNullOrWhiteSpace(cat12Parent?.CategoriaSlug)
        ? cat12Parent.CategoriaSlug
        : "12";
    var cat12Name = cat12Parent?.Nombre ?? "Soporte Técnico";

    // Procesar categorías 47
    var cat47Parent = categorias47?.FirstOrDefault(c => c.Sequence == 47);
    var cat47Children = categorias47?.Where(c => c.CategoriaPadre == 47).ToList();
    var cat47Slug = !string.IsNullOrWhiteSpace(cat47Parent?.CategoriaSlug)
        ? cat47Parent.CategoriaSlug
        : "47";
    var cat47Name = cat47Parent?.Nombre ?? "Recursos";

    // Cargar CONTENIDOS relacionados con la categoría 3
    var cat3Parent = await _db.ContenidosCategorias
        .AsNoTracking()
        .FirstOrDefaultAsync(c => c.Sequence == 3 && !c.Borrado);

    var cat3Slug = !string.IsNullOrWhiteSpace(cat3Parent?.CategoriaSlug)
        ? cat3Parent.CategoriaSlug
        : "3";
    var cat3Name = cat3Parent?.Nombre ?? "Legales";

    // Obtener IDs de contenidos relacionados con categoría 3
    var contenidosIds = await _db.ContenidosCategoriasRelacion
        .AsNoTracking()
        .Where(r => !r.Borrado && r.IdCategoria == 3)
        .Select(r => r.IdContenido)
        .Distinct()
        .ToListAsync();

    // Cargar los contenidos
    var contenidosLegales = await _db.Contenidos
        .AsNoTracking()
        .Where(c => contenidosIds.Contains(c.Id) && !c.Eliminado)
        .OrderBy(c => c.ContenidoTitulo)
        .Select(c => new
        {
            c.Id,
            c.ContenidoTitulo,
            c.ContenidoTituloSlug
        })
        .ToListAsync();
}

<style>
    /* Footer base */
    .site-footer {
        font-size: .9rem;
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-logo {
        height: 36px;
        object-fit: contain;
    }

    /* Heading (títulos de columna) */
    .footer-heading {
        font-size: .9rem !important;
        font-weight: 600;
        margin-bottom: .5rem !important;
    }

    .footer-heading-link {
        color: #0f172a !important;
        text-decoration: none !important;
    }

        .footer-heading-link:hover {
            color: #6a4e7a !important;
            text-decoration: none !important;
        }

    /* Links de lista */
    .footer-list {
        font-size: .9rem !important;
        line-height: 1.6;
        padding-left: 0;
        margin-bottom: 0;
    }

        .footer-list li {
            margin-bottom: 6px;
        }

    .footer-link {
        color: #6b7280 !important;
        text-decoration: none !important;
        transition: color .2s ease;
    }

        .footer-link:hover {
            color: #6a4e7a !important;
            text-decoration: none !important;
        }

    /* Social icons */
    .footer-social-desktop .social-link,
    .mobile-icons-row .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #6b7280;
        text-decoration: none !important;
        transition: all .2s ease;
    }

        .footer-social-desktop .social-link:hover,
        .mobile-icons-row .social-link:hover {
            background: #6a4e7a;
            color: #fff;
            text-decoration: none !important;
        }

    /* Square buttons */
    .square-btn {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        transition: all .2s ease;
    }

        .square-btn:hover {
            text-decoration: none !important;
        }

    /* Grid de footer: 3 columnas estrechas + 1 ancha para redes */
    .footer-main {
        display: grid;
        grid-template-columns: 18% 18% 18% 46%;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 767.98px) {
        .footer-main {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>

<footer class="site-footer bg-white border-top" role="contentinfo" aria-label="Pie de página">
    <div class="container">
        <div class="footer-inner py-4">

            <!-- Top row: logo -->
            <div class="row align-items-start footer-top mb-4">
                <div class="col-12 col-md-3 mb-3 mb-md-0">
                    <a href="/" class="d-inline-flex align-items-center" aria-label="Ir al inicio">
                        <img src="~/img/logo.png" alt="eiibd" class="footer-logo" />
                    </a>
                </div>
            </div>

            <!-- Main columns usando CSS Grid -->
            <div class="footer-main mb-4">

                <!-- Column 1: Categorías 47 -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat47Slug" class="footer-heading-link">@cat47Name</a>
                    </h6>

                    @if (cat47Children != null && cat47Children.Any())
                    {
                        <ul class="list-unstyled footer-list d-none d-md-block">
                            @foreach (var c in cat47Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug)
                                ? c.CategoriaSlug
                                : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 2: Categorías 12 -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat12Slug" class="footer-heading-link">@cat12Name</a>
                    </h6>

                    @if (cat12Children != null && cat12Children.Any())
                    {
                        <ul class="list-unstyled footer-list d-none d-md-block">
                            @foreach (var c in cat12Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug)
                                ? c.CategoriaSlug
                                : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 3: CONTENIDOS relacionados con categoría 3 (Legales) -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat3Slug" class="footer-heading-link">@cat3Name</a>
                    </h6>

                    @if (contenidosLegales != null && contenidosLegales.Any())
                    {
                        <ul class="list-unstyled footer-list d-none d-md-block">
                            @foreach (var contenido in contenidosLegales)
                            {
                                if (!string.IsNullOrWhiteSpace(contenido.ContenidoTituloSlug))
                                {
                                    // Friendly URL using the parent category slug + content slug
                                    <li>
                                        <a href="/@cat3Slug/@contenido.ContenidoTituloSlug" class="footer-link">
                                            @contenido.ContenidoTitulo
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    // Fallback to the detail page with id if we don't have a content slug
                                    <li>
                                        <a href="@Url.Page("/Contenidos/Detalle", new { id = contenido.Id })" class="footer-link">
                                            @contenido.ContenidoTitulo
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </div>

                <!-- Column 4: Desktop social icons & action buttons (más ancha) -->
                <div class="d-none d-md-flex flex-column align-items-center justify-content-center footer-desktop-actions">

                    <nav aria-label="Redes sociales (escritorio)" class="footer-social-desktop d-flex gap-2 mb-3">
                        <a class="social-link" href="https://facebook.com/eiiibd" aria-label="Facebook" target="_blank"><i class="bi bi-facebook"></i></a>
                        <a class="social-link" href="https://x.com/eiibd" aria-label="Twitter" target="_blank"><i class="bi bi-twitter"></i></a>
                        <a class="social-link" href="https://instagram.com/eiiibd" aria-label="Instagram" target="_blank"><i class="bi bi-instagram"></i></a>
                        <a class="social-link" href="http://linkedin.com/company/eiibd" aria-label="LinkedIn" target="_blank"><i class="bi bi-linkedin"></i></a>
                    </nav>

                    <div class="d-flex gap-2 footer-desktop-squares">
                        <a href="https://wa.me/525531539621" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>

                        <a href="Tel:5531539621" class="btn square-btn btn-light border" aria-label="Contacto" title="Contacto" target="_blank">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>

                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar" target="_blank">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Mobile: Social icons & action buttons (fuera del grid en móvil) -->
            <div class="row d-md-none mb-3">
                <div class="col-12">
                    <div class="mobile-icons-row d-flex gap-2 mb-3 justify-content-center">
                        <nav aria-label="Redes sociales (móvil)" class="d-flex gap-2">
                            <a class="social-link" href="https://facebook.com/eiiibd" aria-label="Facebook" target="_blank"><i class="bi bi-facebook"></i></a>
                            <a class="social-link" href="https://x.com/eiibd" aria-label="Twitter" target="_blank"><i class="bi bi-twitter"></i></a>
                            <a class="social-link" href="https://instagram.com/eiibd" aria-label="Instagram" target="_blank"><i class="bi bi-instagram"></i></a>
                            <a class="social-link" href="http://linkedin.com/company/eiibd" aria-label="LinkedIn" target="_blank"><i class="bi bi-linkedin"></i></a>
                        </nav>
                    </div>

                    <div class="d-flex gap-2 justify-content-center footer-action-buttons">
                        <a href="https://wa.me/5531539621" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>

                        <a href="Tel:5531539621" class="btn square-btn btn-light border" aria-label="Contacto" title="Contacto" target="_blank">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>

                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar" target="_blank">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright / disclaimer -->
            <div class="row">
                <div class="col-12">
                    <small class="text-muted d-block" style="line-height:1.35; font-size: .85rem;">
                        © @DateTime.UtcNow.Year eiibd. Todos los derechos reservados.
                        Ninguna información en eiibd debe interpretarse como consejo médico, diagnóstico o tratamiento. El contenido se proporciona solo con fines informativos y no debe utilizarse para sustituir la consulta con un profesional de la salud calificado.
                    </small>
                </div>
            </div>

        </div>
    </div>
</footer>