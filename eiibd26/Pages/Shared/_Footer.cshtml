@using eiibd26.Models
@using eiibd26.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _db

@{
    // Cargar categorías 12 y 47
    var categorias12 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 12 || c.CategoriaPadre == 12))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    var categorias47 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 47 || c.CategoriaPadre == 47))
        .OrderBy(c => c.Orden)
        .ThenBy(c => c.Nombre)
        .ToListAsync();

    var cat12Parent   = categorias12?.FirstOrDefault(c => c.Sequence == 12);
    var cat12Children = categorias12?.Where(c => c.CategoriaPadre == 12).ToList();
    var cat12Slug     = !string.IsNullOrWhiteSpace(cat12Parent?.CategoriaSlug) ? cat12Parent.CategoriaSlug : "12";
    var cat12Name     = cat12Parent?.Nombre ?? "Soporte Técnico";

    var cat47Parent   = categorias47?.FirstOrDefault(c => c.Sequence == 47);
    var cat47Children = categorias47?.Where(c => c.CategoriaPadre == 47).ToList();
    var cat47Slug     = !string.IsNullOrWhiteSpace(cat47Parent?.CategoriaSlug) ? cat47Parent.CategoriaSlug : "47";
    var cat47Name     = cat47Parent?.Nombre ?? "Recursos";

    var cat3Parent = await _db.ContenidosCategorias
        .AsNoTracking()
        .FirstOrDefaultAsync(c => c.Sequence == 3 && !c.Borrado);

    var cat3Slug = !string.IsNullOrWhiteSpace(cat3Parent?.CategoriaSlug) ? cat3Parent.CategoriaSlug : "3";
    var cat3Name = cat3Parent?.Nombre ?? "Legales";

    var contenidosIds = await _db.ContenidosCategoriasRelacion
        .AsNoTracking()
        .Where(r => !r.Borrado && r.IdCategoria == 3)
        .Select(r => r.IdContenido)
        .Distinct()
        .ToListAsync();

    var contenidosLegales = await _db.Contenidos
        .AsNoTracking()
        .Where(c => contenidosIds.Contains(c.Id) && !c.Eliminado)
        .OrderBy(c => c.ContenidoTitulo)
        .Select(c => new { c.Id, c.ContenidoTitulo, c.ContenidoTituloSlug })
        .ToListAsync();
}
<style>
    /* ── FOOTER ─────────────────────────────────────────────────────────── */
    .site-footer {
        background: var(--eii-surface-soft);
        border-top: 1px solid var(--eii-border);
        font-size: .875rem;
        color: var(--eii-text-soft);
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-logo {
        height: 36px;
        object-fit: contain;
    }

    /* Column headings — override Bootstrap h6 without !important */
    .site-footer .footer-heading {
        font-size: .875rem;
        font-weight: 600;
        color: var(--eii-text);
        margin-bottom: 1rem;
        line-height: 1.4;
    }

    .footer-heading-link {
        color: var(--eii-text);
        text-decoration: none;
        transition: color var(--eii-transition-base);
    }

    .footer-heading-link:hover {
        color: var(--eii-primary);
        text-decoration: none;
    }

    /* Link list */
    .footer-list {
        list-style: none;
        padding-left: 0;
        margin: 0;
        line-height: 1.8;
    }

    .footer-list li {
        margin-bottom: 6px;
    }

    .footer-list li:last-child {
        margin-bottom: 0;
    }

    .footer-link {
        color: var(--eii-text-soft);
        text-decoration: none;
        transition: color var(--eii-transition-base);
    }

    .footer-link:hover {
        color: var(--eii-primary);
        text-decoration: none;
    }

    /* Social icon circles */
    .footer-social-desktop .social-link,
    .mobile-icons-row .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--eii-surface);
        border: 1px solid var(--eii-border);
        color: var(--eii-text-soft);
        text-decoration: none;
        transition: background var(--eii-transition-base), border-color var(--eii-transition-base), color var(--eii-transition-base);
    }

    .footer-social-desktop .social-link:hover,
    .mobile-icons-row .social-link:hover {
        background: var(--eii-primary);
        border-color: var(--eii-primary);
        color: #fff;
        text-decoration: none;
    }

    /* Square action buttons */
    .square-btn {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--eii-radius-md);
        text-decoration: none;
        transition: all var(--eii-transition-base);
    }

    .square-btn:hover {
        text-decoration: none;
    }

    /* Footer main grid */
    .footer-main {
        display: grid;
        grid-template-columns: 18% 18% 18% 46%;
        gap: 2rem;
        align-items: start;
    }

    /* Copyright row */
    .footer-copyright {
        font-size: .8rem;
        color: var(--eii-text-soft);
        line-height: 1.5;
    }

    @@media (max-width: 767.98px) {
        .footer-main {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>

<footer class="site-footer" role="contentinfo" aria-label="Pie de página">
    <div class="container">
        <div class="footer-inner py-4">

            <!-- Logo -->
            <div class="row align-items-start footer-top mb-4">
                <div class="col-12 col-md-3 mb-3 mb-md-0">
                    <a href="/" class="d-inline-flex align-items-center" aria-label="Ir al inicio">
                        <img src="~/img/logo.png" alt="EIIBD" class="footer-logo" />
                    </a>
                </div>
            </div>

            <!-- Columnas principales -->
            <div class="footer-main mb-4">

                <!-- Columna 1: Categorías 47 -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat47Slug" class="footer-heading-link">@cat47Name</a>
                    </h6>
                    @if (cat47Children != null && cat47Children.Any())
                    {
                        <ul class="footer-list d-none d-md-block">
                            @foreach (var c in cat47Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug) ? c.CategoriaSlug : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Columna 2: Categorías 12 -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat12Slug" class="footer-heading-link">@cat12Name</a>
                    </h6>
                    @if (cat12Children != null && cat12Children.Any())
                    {
                        <ul class="footer-list d-none d-md-block">
                            @foreach (var c in cat12Children)
                            {
                                var childSlug = !string.IsNullOrWhiteSpace(c.CategoriaSlug) ? c.CategoriaSlug : c.Sequence.ToString();
                                <li><a href="/@childSlug" class="footer-link">@c.Nombre</a></li>
                            }
                        </ul>
                    }
                </div>

                <!-- Columna 3: Legales -->
                <div>
                    <h6 class="footer-heading">
                        <a href="/@cat3Slug" class="footer-heading-link">@cat3Name</a>
                    </h6>
                    @if (contenidosLegales != null && contenidosLegales.Any())
                    {
                        <ul class="footer-list d-none d-md-block">
                            @foreach (var contenido in contenidosLegales)
                            {
                                if (!string.IsNullOrWhiteSpace(contenido.ContenidoTituloSlug))
                                {
                                    <li>
                                        <a href="/@cat3Slug/@contenido.ContenidoTituloSlug" class="footer-link">@contenido.ContenidoTitulo</a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="@Url.Page("/Contenidos/Detalle", new { id = contenido.Id })" class="footer-link">@contenido.ContenidoTitulo</a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </div>

                <!-- Columna 4: Redes sociales + botones de acción (desktop) -->
                <div class="d-none d-md-flex flex-column align-items-center justify-content-center footer-desktop-actions">
                    <nav aria-label="Redes sociales" class="footer-social-desktop d-flex gap-2 mb-3">
                        <a class="social-link" href="https://facebook.com/eiiibd" aria-label="Facebook" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                        <a class="social-link" href="https://x.com/eiibd" aria-label="Twitter / X" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i></a>
                        <a class="social-link" href="https://instagram.com/eiiibd" aria-label="Instagram" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a>
                        <a class="social-link" href="http://linkedin.com/company/eiibd" aria-label="LinkedIn" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                    </nav>

                    <div class="d-flex gap-2">
                        <a href="https://wa.me/525531539621" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>
                        <a href="Tel:5531539621" class="btn square-btn btn-light border" aria-label="Contacto telefónico" title="Contacto">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>
                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Móvil: redes sociales + botones -->
            <div class="row d-md-none mb-3">
                <div class="col-12">
                    <div class="mobile-icons-row d-flex gap-2 mb-3 justify-content-center">
                        <nav aria-label="Redes sociales" class="d-flex gap-2">
                            <a class="social-link" href="https://facebook.com/eiiibd" aria-label="Facebook" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                            <a class="social-link" href="https://x.com/eiibd" aria-label="Twitter / X" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i></a>
                            <a class="social-link" href="https://instagram.com/eiibd" aria-label="Instagram" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a>
                            <a class="social-link" href="http://linkedin.com/company/eiibd" aria-label="LinkedIn" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                        </nav>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="https://wa.me/5531539621" class="btn square-btn btn-success" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        </a>
                        <a href="Tel:5531539621" class="btn square-btn btn-light border" aria-label="Contacto telefónico" title="Contacto">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </a>
                        <a href="/Donar" class="btn square-btn btn-outline-success" aria-label="Donar" title="Donar">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="row pt-3" style="border-top: 1px solid var(--eii-border);">
                <div class="col-12">
                    <p class="footer-copyright mb-0">
                        © @DateTime.UtcNow.Year EIIBD. Todos los derechos reservados.
                        Ninguna información en EIIBD debe interpretarse como consejo médico, diagnóstico o tratamiento. El contenido se proporciona solo con fines informativos y no debe utilizarse para sustituir la consulta con un profesional de la salud calificado.
                    </p>
                </div>
            </div>

        </div>
    </div>
</footer>
