@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@using eiibd26.Models
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject ApplicationDbContext Db
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var avatarSrc = Url.Content("~/img/default-avatar.png");
    var userName  = User?.Identity?.Name ?? "";
    string displayNameMob = null;
    // Avatar y nombre: prioridad Perfil.Avatar / Perfil.Nombre; fallback filesystem
    try
    {
        var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            eiibd26.Models.Perfil perfilMob = null;
            if (Guid.TryParse(userId, out var guidMob))
                perfilMob = await Db.Set<eiibd26.Models.Perfil>().AsNoTracking().FirstOrDefaultAsync(p => p.idUser == guidMob);

            if (perfilMob != null)
            {
                if (!string.IsNullOrWhiteSpace(perfilMob.Avatar) && perfilMob.Avatar.StartsWith("/uploads/"))
                    avatarSrc = Url.Content("~" + perfilMob.Avatar);
                else
                {
                    var physicalPath = System.IO.Path.Combine(Env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                    if (System.IO.File.Exists(physicalPath)) avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
                }

                if (!string.IsNullOrWhiteSpace(perfilMob.Nombre))
                    displayNameMob = perfilMob.Nombre + (string.IsNullOrWhiteSpace(perfilMob.Apellidos) ? "" : " " + perfilMob.Apellidos);
            }
            else
            {
                var physicalPath = System.IO.Path.Combine(Env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                if (System.IO.File.Exists(physicalPath)) avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
            }

            // Para médicos: nombre viene de MedicosDirectorio (Perfil.Nombre está vacío)
            if (string.IsNullOrWhiteSpace(displayNameMob) && User.IsInRole("Medico") && Guid.TryParse(userId, out var medicoGuidMob))
            {
                var medicoNombreMob = await Db.MedicosPerfilExtendido
                    .AsNoTracking()
                    .Where(m => m.UserId == medicoGuidMob)
                    .Select(m => m.Medico != null ? m.Medico.NombreCompleto : null)
                    .FirstOrDefaultAsync();
                if (!string.IsNullOrWhiteSpace(medicoNombreMob))
                    displayNameMob = medicoNombreMob;
            }
        }
    }
    catch { /* ignore */ }
    var displayNameMobFinal = displayNameMob ?? userName;
}

<nav class="navbar topbar d-lg-none" role="navigation" aria-label="Navegación móvil">
    <div class="container-fluid">
        <a class="navbar-brand" href="/"><img src="~/img/logo.png" alt="eiibd26" style="height:38px;object-fit:contain;" /></a>

        @* Show small avatar as cue if logged-in *@
        @if (isAuth)
        {
            <div class="d-flex align-items-center me-2">
                <img src="@avatarSrc" alt="Avatar" class="mobile-avatar" style="position:relative; z-index:1200;" />
            </div>
        }

        @* Toggler opens offcanvas drawer (overlay) *@
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#topbarOffcanvasMobile" aria-controls="topbarOffcanvasMobile" aria-expanded="false" aria-label="Abrir menú móvil">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="topbarOffcanvasMobile" aria-labelledby="topbarOffcanvasMobileLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="topbarOffcanvasMobileLabel"><img src="~/img/logo.png" alt="eiibd26" style="height:34px;object-fit:contain;" /></h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>

            <div class="offcanvas-body">
                <nav class="offcanvas-nav mb-3" aria-label="Menú principal (móvil)">
                    <ul>
                        <li><a class="nav-link" href="/">Inicio</a></li>
                        <li><a class="nav-link" href="/Contenidos">Buscador</a></li>
                        <li><a class="nav-link" href="/Preguntas">Preguntas y Respuestas</a></li>

                        @* ⭐ NUEVO: Glosario Médico *@
                        <li>
                            <a class="nav-link d-flex align-items-center" href="/Glosario" title="Ir a Glosario Médico" aria-label="Glosario">
                                <i class="bi bi-book me-1" aria-hidden="true"></i>
                                <span>Glosario</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link d-flex align-items-center" href="/Mapa" title="Ir a Comunidad" aria-label="Comunidad">
                                <i class="bi bi-people me-1" aria-hidden="true"></i>
                                <span>Comunidad</span>
                            </a>
                        </li>

                        @* Include parent-only partials (they emit <li> items) *@
                        <partial name="~/Pages/Shared/_CategoryMenuMobile.cshtml" />
                        <partial name="~/Pages/Shared/_menuContenidoMobile.cshtml" />

                        @* Dashboard link for authenticated users (last item in mobile menu) *@
                        @if (isAuth)
                        {
                            var panelHrefMobile = User.IsInRole("Medico")
                                ? "/Identity/Medico/Dashboard"
                                : "/Identity/Usuario/Dashboard";
                            <li><a class="nav-link" href="@panelHrefMobile">Panel de Control</a></li>
                        }
                    </ul>
                </nav>

                <div class="offcanvas-user">
                    @if (!isAuth)
                    {
                        <div class="mb-2">
                            <a class="btn btn-outline-primary w-100 mb-2" href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Iniciar sesión</a>
                            <a class="btn btn-outline-secondary w-100" href="/Identity/Account/Register?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Registro</a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img src="@avatarSrc" alt="Avatar" class="avatar" />
                            <div>
                                <div class="fw-semibold">@displayNameMobFinal</div>
                            </div>
                        </div>

                        <div>
                            <a class="d-block py-1" href="/Identity/Account/Manage/UsuarioPerfil">Editar - Perfil público</a>
                            <a class="d-block py-1" href="/Identity/Account/Manage">Usuario/Registro</a>
                            <a class="d-block py-1" href="/Identity/Account/Manage/Email">Cambiar email</a>
                            <a class="d-block py-1" href="/Identity/Account/Manage/ChangePassword">Cambiar contraseña</a>
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="mt-2">
                                <button type="submit" class="btn btn-outline-danger w-100">Cerrar sesión</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>