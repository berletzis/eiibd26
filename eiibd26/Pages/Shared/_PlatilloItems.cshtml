@using eiibd26.Helpers
@model IEnumerable<eiibd26.Pages.Platillos.PlatilloFilter.CardVm>
@* Solo las tarjetas de platillo. Compartido por Pages/Platillos/Index (1ra página) y
   Pages/Platillos/Mas (Cargar más). El root .eii-card lo usa el JS para contar resultados. *@
@foreach (var p in Model)
{
    var slug = SlugHelper.GenerateSlug(p.Nombre);
    <article class="eii-card">
        <div class="eii-card__body">
            <div class="plat-card__meta">
                @if (!string.IsNullOrWhiteSpace(p.Categoria))
                {
                    <span class="eii-badge">@p.Categoria</span>
                }
                <span class="eii-help-text">@p.NumIngredientes ingredientes</span>
            </div>
            <h2 class="eii-card__title h6 mb-1"><a href="/Platillos/@slug">@p.Nombre</a></h2>
            @if (!string.IsNullOrWhiteSpace(p.PasosResumidos))
            {
                <p class="plat-card__pasos">@p.PasosResumidos</p>
            }
            @if (!string.IsNullOrWhiteSpace(p.FuenteNombre))
            {
                <div class="plat-card__fuente">
                    Fuente:
                    @if (!string.IsNullOrWhiteSpace(p.FuenteUrl))
                    {
                        <a href="@p.FuenteUrl" target="_blank" rel="noopener nofollow">@p.FuenteNombre</a>
                    }
                    else
                    {
                        @p.FuenteNombre
                    }
                </div>
            }
        </div>
    </article>
}
