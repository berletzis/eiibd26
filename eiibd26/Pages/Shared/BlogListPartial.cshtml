@model eiibd26.Models.BlogListViewModel
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    string ExtractCategoryText(string categoryHtml)
    {
        if (string.IsNullOrWhiteSpace(categoryHtml)) return string.Empty;
        var textOnly = Regex.Replace(categoryHtml, "<.*?>", string.Empty);
        textOnly = System.Net.WebUtility.HtmlDecode(textOnly);
        return textOnly.Trim();
    }
}

<style>
    /* Estilos para mejorar la calidad visual de las imágenes con zoom sutil */
    .blog-card .thumb {
        position: relative;
        overflow: hidden;
        display: block;
    }

    .blog-card .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
        transform: scale(1.20);
        transition: transform 0.3s ease;
    }

    /* Efecto hover suave */
    .blog-card .thumb:hover img {
        transform: scale(1.25);
    }

    /* Ensure author text is visible */
    .blog-footer .author a,
    .blog-footer .author span {
        color: var(--eii-text);
        font-size: var(--eii-text-sm);
        line-height: 1;
        display: inline-block;
        transition: color 0.2s ease;
    }

    .blog-footer .author a:hover {
        color: var(--eii-primary);
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-12">
            @if (!Model.Items.Any())
            {
                <p class="text-muted">No hay artículos aún.</p>
            }
            else
            {
                foreach (var it in Model.Items)
                {
                    <article class="blog-card" role="article" aria-labelledby="title-@it.Id">
                        <div class="thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(it.ImageUrl))
                            {
                                <img src="@(it.ImageUrl)" alt="@it.Title" loading="lazy" decoding="async" fetchpriority="low" onerror="this.onerror=null;this.src='@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")'" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")" alt="@it.Title" loading="lazy" decoding="async" fetchpriority="low" />
                            }
                        </div>

                        <div class="content">
                            <div>
                                <div class="blog-meta">@ExtractCategoryText(it.Category)</div>
                                <h3 id="title-@it.Id" class="blog-title">
                                    <a href="~/Preguntas/Detalles/@it.Id" style="text-decoration:none;color:inherit;">@it.Title</a>
                                </h3>
                                <div class="blog-excerpt">@it.Excerpt</div>
                            </div>

                            <div class="blog-footer">
                                <div class="author">
                                    @{ var authorImg = !string.IsNullOrWhiteSpace(it.AuthorImageUrl) ? it.AuthorImageUrl : Url.Content("~/img/avatar-placeholder.png"); }
                                    <span class="avatar"><img src="@authorImg" alt="@it.Author" loading="lazy" decoding="async" width="32" height="32" onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")'" /></span>
                                    @if (!string.IsNullOrWhiteSpace(it.AuthorSlug) || it.AuthorId != null)
                                    {
                                        var profileUrl = !string.IsNullOrWhiteSpace(it.AuthorSlug) ? ("/contenidos/porAutor/" + it.AuthorSlug) : ("/contenidos/autorId/" + (it.AuthorId?.ToString() ?? ""));
                                        <a href="@profileUrl" class="ms-1">@it.Author</a>
                                    }
                                    else
                                    {
                                        <span class="ms-1">@it.Author</span>
                                    }
                                </div>
                                <div class="pubdate">@it.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>