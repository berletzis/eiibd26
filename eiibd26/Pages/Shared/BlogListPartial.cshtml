@model eiibd26.Models.BlogListViewModel
@using System.Globalization

<style>
    /* Estilos para mejorar la calidad visual de las imágenes con zoom sutil */
    .blog-card .thumb {
        position: relative;
        overflow: hidden;
        display: block;
    }

    .blog-card .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
        transform: scale(1.20);
        transition: transform 0.3s ease;
    }

    /* Efecto hover suave */
    .blog-card .thumb:hover img {
        transform: scale(1.25);
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-12">
            @if (!Model.Items.Any())
            {
                <p class="text-muted">No hay artículos aún.</p>
            }
            else
            {
                foreach (var it in Model.Items)
                {
                    <article class="blog-card" role="article" aria-labelledby="title-@it.Id">
                        <div class="thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(it.ImageUrl))
                            {
                                <img src="@it.ImageUrl" alt="@it.Title" loading="lazy" />
                            }
                            else
                            {
                                <div style="width:100%; height:100%; background:#f3f6fb; display:flex; align-items:center; justify-content:center; color:#94a3b8;">
                                    <svg width="80" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                                </div>
                            }
                        </div>

                        <div class="content">
                            <div>
                                <div class="blog-meta">@it.Category</div>
                                <h3 id="title-@it.Id" class="blog-title">
                                    <a href="~/Preguntas/Detalles/@it.Id" style="text-decoration:none;color:inherit;">@it.Title</a>
                                </h3>
                                <div class="blog-excerpt">@it.Excerpt</div>
                            </div>

                            <div class="blog-footer">
                                <div class="author">
                                    <span class="avatar"><img src="~/img/avatar-placeholder.png" alt="@it.Author" /></span>
                                    <span>@it.Author</span>
                                </div>
                                <div class="pubdate">@it.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>