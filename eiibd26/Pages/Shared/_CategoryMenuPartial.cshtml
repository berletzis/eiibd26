@using System.Linq
@using Microsoft.EntityFrameworkCore
@using eiibd26.Models
@inject ApplicationDbContext Db

@{
    // Parent sequence to show in menu
    const int parentSequence = 11;

    ContenidoCategoria parent = null;
    List<ContenidoCategoria> children = new();

    try
    {
        parent = await Db.ContenidosCategorias
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.Sequence == parentSequence && !c.Borrado);

        if (parent != null)
        {
            children = await Db.ContenidosCategorias
                .AsNoTracking()
                .Where(c => c.CategoriaPadre == parentSequence && !c.Borrado)
                .OrderBy(c => c.Nombre)
                .ToListAsync();
        }
    }
    catch
    {
        // fail silently — partial should not break the page
        parent = null;
        children = new List<ContenidoCategoria>();
    }
}

@if (parent != null)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center"
           href="#"
           id="cat@parent.Sequence-Dropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            <i class="bi bi-list-ul me-1" aria-hidden="true"></i>
            <span>@(parent.Nombre ?? "Categoría")</span>
        </a>

        <ul class="dropdown-menu" aria-labelledby="cat@parent.Sequence-Dropdown">
            @if (children != null && children.Any())
            {
                foreach (var ch in children)
                {
                    var slug = string.IsNullOrWhiteSpace(ch.CategoriaSlug) ? ch.Sequence.ToString() : ch.CategoriaSlug;
                    var url = $"/Contenidos/Categoria/{slug}";
                    <li><a class="dropdown-item" href="@url">@ch.Nombre</a></li>
                }
            }
            else
            {
                var slugParent = string.IsNullOrWhiteSpace(parent.CategoriaSlug) ? parent.Sequence.ToString() : parent.CategoriaSlug;
                var urlParent = $"/Contenidos/Categoria/{slugParent}";
                <li><a class="dropdown-item" href="@urlParent">Ver categoría</a></li>
            }
        </ul>
    </li>
}