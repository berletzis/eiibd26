@if (User?.Identity?.IsAuthenticated ?? false)
{
    <script>
    (function () {
      var FH_ID = 'fhb-01';
      var TARGET = '#sidebarOffcanvas';
      var MOBILE_MAX = 767.98;

      function createOrGetBtn() {
        var existing = document.querySelector('button[data-fhb-id="' + FH_ID + '"]');
        if (existing) return existing;
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('data-fhb-id', FH_ID);
        b.setAttribute('data-fhb-target', TARGET);
        b.setAttribute('aria-label', 'Abrir menú lateral');
        b.title = 'Menú';
        b.className = 'fhb-toggle fhb-injected';
        b.innerHTML = '<span class="fhb-icon"><span></span></span>';
        return b;
      }

      function insertAtRoot(btn) {
        try {
          if (document.documentElement && btn.parentElement !== document.documentElement) {
            document.documentElement.appendChild(btn);
            return true;
          }
        } catch (e) {}
        try { document.body.appendChild(btn); return true; } catch (e) {}
        return false;
      }

      function removeExternalTogglers() {
        try {
          var sel = 'button[data-bs-target="' + TARGET + '"], button[aria-controls="' + TARGET.replace('#','') + '"]';
          document.querySelectorAll(sel).forEach(function (b) {
            if (b.getAttribute && b.getAttribute('data-fhb-id') === FH_ID) return;
            if (b.closest && b.closest('.sidebar-menu')) return;
            try { b.remove(); } catch (e) {}
          });
        } catch (e) {}
      }

      function enforceStyles(btn) {
        try {
          var vw = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
          if (vw > MOBILE_MAX) btn.style.setProperty('display', 'none', 'important');
          else btn.style.setProperty('display', 'inline-flex', 'important');

          btn.style.setProperty('position', 'fixed', 'important');
          btn.style.setProperty('bottom', '18px', 'important');
          btn.style.setProperty('right', '18px', 'important');
          btn.style.setProperty('z-index', '2147483647', 'important');
          btn.style.setProperty('width', '56px', 'important');
          btn.style.setProperty('height', '56px', 'important');
          btn.style.setProperty('min-width', '56px', 'important');
          btn.style.setProperty('min-height', '56px', 'important');
          btn.style.setProperty('border-radius', '12px', 'important');
          btn.style.setProperty('align-items', 'center', 'important');
          btn.style.setProperty('justify-content', 'center', 'important');
          btn.style.setProperty('padding', '0', 'important');
          btn.style.setProperty('cursor', 'pointer', 'important');
          btn.style.setProperty('background-color', 'var(--brand-color, #6a4e7a)', 'important');
          btn.style.setProperty('border', '2px solid rgba(0,0,0,0.08)', 'important');
          btn.style.setProperty('box-shadow', '0 8px 24px rgba(16,24,40,0.12)', 'important');
          btn.style.setProperty('color', '#fff', 'important');
          btn.style.setProperty('pointer-events', 'auto', 'important');
          btn.style.setProperty('transform', 'none', 'important');
        } catch (e) {}
      }

      function attachBehavior(btn) {
        function openOffcanvas() {
          try {
            var targetSelector = btn.getAttribute('data-fhb-target') || TARGET;
            var targetEl = document.querySelector(targetSelector);
            if (targetEl && window.bootstrap && bootstrap.Offcanvas) {
              var inst = bootstrap.Offcanvas.getInstance(targetEl) || new bootstrap.Offcanvas(targetEl);
              inst.toggle(); return;
            }
            var toggler = document.querySelector('button[data-bs-target="' + targetSelector + '"], button[aria-controls="' + targetSelector.replace('#','') + '"]');
            if (toggler) { toggler.click(); return; }
            if (targetEl) {
              targetEl.classList.toggle('show');
              targetEl.style.visibility = targetEl.classList.contains('show') ? 'visible' : 'hidden';
            }
          } catch (e) { console.warn(e); }
        }
        try { btn.removeEventListener && btn.removeEventListener('click', openOffcanvas); } catch(e){}
        btn.addEventListener('click', function(ev){ ev && ev.preventDefault && ev.preventDefault(); openOffcanvas(); }, { passive: false });
      }

      function doInsertAndProtect() {
        var btn = createOrGetBtn();
        insertAtRoot(btn);
        removeExternalTogglers();
        enforceStyles(btn);
        attachBehavior(btn);

        var tries = 0;
        var t = setInterval(function(){
          removeExternalTogglers();
          enforceStyles(btn);
          tries++;
          if (tries > 10) clearInterval(t);
        }, 300);

        try {
          var mo = new MutationObserver(function(){ removeExternalTogglers(); enforceStyles(btn); });
          mo.observe(document.documentElement || document.body, { childList: true, subtree: true, attributes: true });
          window.__fhb_mo = mo;
        } catch(e){}

        window.__fhb = { btn: btn, enforceStyles: function(){ enforceStyles(btn); }, removeExternalTogglers: removeExternalTogglers };
      }

      if (document.readyState === 'complete') {
        setTimeout(doInsertAndProtect, 120);
      } else {
        window.addEventListener('load', function(){ setTimeout(doInsertAndProtect, 120); });
      }
    })();
    </script>
}
