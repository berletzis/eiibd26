@model IEnumerable<eiibd26.Models.Medico.MedicoBadgeDto>

@{
    var mostrarRevision = ViewData["mostrarRevision"] as bool? ?? false;

    // Clasificación: primarios (críticos para paciente) vs secundarios (complementarios)
    var primaryCodes = new[] { "perfil_reclamado", "verificado", "activo_comunidad" };
    var secondaryCodes = new[] { "participante_qa", "validador_terminos", "validador_contenido", "creador_contenido" };

    var primaries = Model?.Where(b => primaryCodes.Contains(b.Codigo)).OrderBy(b => Array.IndexOf(primaryCodes, b.Codigo)).ToList() ?? new List<eiibd26.Models.Medico.MedicoBadgeDto>();
    var secondaries = Model?.Where(b => secondaryCodes.Contains(b.Codigo)).OrderBy(b => Array.IndexOf(secondaryCodes, b.Codigo)).ToList() ?? new List<eiibd26.Models.Medico.MedicoBadgeDto>();

    // Mapa de colores por badge (patrón outlined con fondo suave)
    var badgeColors = new Dictionary<string, (string Primary, string BgSoft, string Border)>
    {
        { "perfil_reclamado",    ("#6366f1", "#ede9fe", "#6366f1") },
        { "verificado",          ("#0ea5e9", "#dbeafe", "#0ea5e9") },
        { "activo_comunidad",    ("#16a34a", "#d1fae5", "#16a34a") },
        { "participante_qa",     ("#f59e0b", "#fef3c7", "#f59e0b") },
        { "validador_terminos",  ("#8b5cf6", "#f3e8ff", "#8b5cf6") },
        { "validador_contenido", ("#0d9488", "#ccfbf1", "#0d9488") },
        { "creador_contenido",   ("#ec4899", "#fce7f3", "#ec4899") }
    };

    // Estado: obtenido vs no-obtenido (greyed out)
    string GetBadgeStyle(eiibd26.Models.Medico.MedicoBadgeDto badge)
    {
        if (badge.Obtenido && badgeColors.TryGetValue(badge.Codigo, out var colors))
        {
            return $"background:{colors.BgSoft};color:{colors.Primary};border-color:{colors.Border};";
        }
        return "background:#f9fafb;color:#9ca3af;border-color:#d1d5db;";
    }
}

@if (primaries.Any())
{
    <div class="medico-badges-primary d-flex flex-wrap gap-2 mb-2">
        @foreach (var badge in primaries)
        {
            <span class="badge-medico-pill badge-primary @(badge.Obtenido ? "obtained" : "not-obtained")"
                  data-badge-code="@badge.Codigo"
                  style="@GetBadgeStyle(badge)"
                  title="@badge.Descripcion"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top">
                <i class="bi @badge.Icono"></i>
                <span class="badge-label d-none d-md-inline">@badge.Nombre</span>
            </span>
            @if (mostrarRevision && badge.Obtenido && badge.EnRevision)
            {
                <i class="bi bi-hourglass-split text-warning"
                   title="En revisión"
                   style="font-size:.85rem;align-self:center;"></i>
            }
        }
    </div>
}

@if (secondaries.Any())
{
    <div class="medico-badges-secondary d-flex flex-wrap gap-2">
        @foreach (var badge in secondaries)
        {
            <span class="badge-medico-pill badge-secondary @(badge.Obtenido ? "obtained" : "not-obtained")"
                  data-badge-code="@badge.Codigo"
                  style="@GetBadgeStyle(badge)"
                  title="@badge.Descripcion"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top">
                <i class="bi @badge.Icono"></i>
                <span class="badge-label d-none d-md-inline">@badge.Nombre</span>
            </span>
            @if (mostrarRevision && badge.Obtenido && badge.EnRevision)
            {
                <i class="bi bi-hourglass-split text-warning"
                   title="En revisión"
                   style="font-size:.85rem;align-self:center;"></i>
            }
        }
    </div>
}

@if (mostrarRevision)
{
    var enRevisionConMotivo = (Model ?? Enumerable.Empty<eiibd26.Models.Medico.MedicoBadgeDto>())
        .Where(b => b.Obtenido && b.EnRevision && !string.IsNullOrWhiteSpace(b.RevisionMotivo))
        .ToList();
    if (enRevisionConMotivo.Any())
    {
        <div class="medico-badges-revision mt-2">
            @foreach (var b in enRevisionConMotivo)
            {
                <p class="badge-revision-motivo mb-1">
                    <i class="bi bi-hourglass-split text-warning me-1"></i>
                    <strong>@b.Nombre:</strong> @b.RevisionMotivo
                </p>
            }
        </div>
    }
}
