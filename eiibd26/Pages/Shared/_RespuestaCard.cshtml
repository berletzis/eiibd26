@model dynamic
@{
    // expected model properties: Id, Cuerpo, UsuarioId, AutorNombre, AutorAvatarUrl, FechaCreacion, Score, UsuarioVoto
    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace((string?)avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (((string)avatar).StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return (string)avatar;
        if (((string)avatar).StartsWith("/")) return (string)avatar;
        return Url.Content("~/" + ((string)avatar).TrimStart('/'));
    }

    string FormatFecha(object fechaObj)
    {
        if (fechaObj == null) return "";
        try
        {
            if (fechaObj is DateTimeOffset dto) return dto.ToLocalTime().ToString("d");
            if (fechaObj is DateTime dt) return new DateTimeOffset(dt).ToLocalTime().ToString("d");
            var s = fechaObj.ToString();
            if (DateTimeOffset.TryParse(s, out var parsedDto)) return parsedDto.ToLocalTime().ToString("d");
            if (DateTime.TryParse(s, out var parsedDt)) return new DateTimeOffset(parsedDt).ToLocalTime().ToString("d");
            return s;
        }
        catch { return fechaObj.ToString(); }
    }

    var authenticated = User.Identity.IsAuthenticated;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAuthor = !string.IsNullOrEmpty(currentUserId) && Guid.TryParse(currentUserId, out var cuid) && cuid == (Guid)Model.UsuarioId;
    var scoreValInit = (int?)(Model.Score ?? 0);
    var userVoteInit = (int?)(Model.UsuarioVoto ?? 0);
}
<style>
    .ans-card {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 12px rgba(20,40,80,0.04);
        position: relative;
        margin-bottom: 12px;
    }

    .ans-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 5px rgba(0,0,0,0.06);
    }

    .ans-content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .ans-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ans-meta-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ans-actions {
        flex: 0 0 120px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        min-width: 100px;
    }

    .btn-delete-inline {
        margin-left: 8px;
        border: none;
        background: transparent;
        color: #dc2741;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-delete-inline:hover {
            background: #fff0f2;
        }
</style>

<div class="ans-card" data-id="@Model.Id" data-authenticated="@(authenticated ? "true" : "false")" data-is-mine="@(isAuthor ? "true" : "false")" data-user-vote="@userVoteInit" data-score="@scoreValInit">
    <div>
        <img class="ans-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")" data-src="@ResolveAvatar((string)Model.AutorAvatarUrl)" alt="@Model.AutorNombre" width="44" height="44" decoding="async" onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
    </div>

    <div class="ans-content">
        <div class="ans-header">
            <div class="ans-meta-left">
                <strong>@Model.AutorNombre</strong>
                <small class="text-muted">· @FormatFecha(Model.FechaCreacion)</small>
            </div>

            @* delete button inline - only visible to author *@
            <div>
                @if (isAuthor)
                {
                    <button class="btn-delete-inline btn-delete-respuesta" data-id="@Model.Id" title="Eliminar respuesta" type="button">🗑</button>
                }
            </div>
        </div>

        <div class="ans-body" style="margin-top:8px;">@Html.Raw(Model.Cuerpo)</div>
    </div>

    <div class="ans-actions">
        <div class="vote-container">
            @if (!User.Identity.IsAuthenticated)
            {
                <div class="vote-login-hint">Inicia sesión para ver/realizar votos. <a href="/Account/Login">Iniciar sesión</a></div>
            }
            else if (isAuthor)
            {
                <span class="text-muted small">No puedes votar tu propia respuesta</span>
            }
            else
            {
                if (userVoteInit == 1)
                {
                    <button class="btn btn-outline-danger btn-voto-ans" data-id="@Model.Id" data-valor="-1" title="Quitar voto">-1</button>
                }
                else
                {
                    <button class="btn btn-outline-success btn-voto-ans" data-id="@Model.Id" data-valor="1" title="+1">+1</button>
                }
            }
        </div>

        <div class="badge bg-light text-dark" id="ascore-@Model.Id">Score: @((int)(Model.Score ?? 0))</div>
    </div>
</div>