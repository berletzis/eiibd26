@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@using eiibd26.Models
@using System
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var avatarSrc = Url.Content("~/img/default-avatar.png");
    string userId = null; string displayName = null; string userName = null;

    if (isAuth)
    {
        userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            try { var identityUser = await UserManager.FindByIdAsync(userId); if (identityUser != null) userName = identityUser.UserName; }
            catch { userName = userName ?? User?.Identity?.Name; }
        }
        else { userName = User?.Identity?.Name; }

        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                Perfil perfil = null;
                if (Guid.TryParse(userId, out var userGuid)) perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser == userGuid);
                else perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser.ToString() == userId);

                if (perfil != null && !string.IsNullOrWhiteSpace(perfil.Nombre))
                {
                    displayName = perfil.Nombre + (string.IsNullOrWhiteSpace(perfil.Apellidos) ? "" : " " + perfil.Apellidos);
                }
            }
            catch { }
        }

        displayName = displayName ?? User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "Usuario";

        var env = Context.RequestServices.GetService(typeof(IWebHostEnvironment)) as IWebHostEnvironment;
        if (!string.IsNullOrEmpty(userId) && env != null)
        {
            try
            {
                var physicalPath = System.IO.Path.Combine(env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                if (System.IO.File.Exists(physicalPath)) avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
            }
            catch { avatarSrc = Url.Content("~/img/default-avatar.png"); }
        }
    }

    // helper to mark active item
    var rawPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(rawPath)) rawPath = "/";
    string GetFirstSegment(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "/") return "/";
        var trimmed = path.Trim('/');
        var parts = trimmed.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? "/" + parts[0].ToLowerInvariant() : "/";
    }
    var currentFirst = GetFirstSegment(rawPath);
    Func<string, bool> IsActivePath = seg =>
    {
        if (string.IsNullOrEmpty(seg)) return false;
        var normSeg = seg.StartsWith("/") ? seg.TrimEnd('/') : ("/" + seg.TrimEnd('/'));
        if (normSeg == "/") return currentFirst == "/";
        var segFirst = GetFirstSegment(normSeg);
        return string.Equals(segFirst, currentFirst, StringComparison.OrdinalIgnoreCase);
    };
    Func<string, string> ActiveClass = seg => IsActivePath(seg) ? " active" : "";
}
<header>
    <style>
        .topbar {
            background: #f8fafc;
            border-bottom: 1px solid #e9ecef;
            z-index: 1100;
            width: 100%;
            position: relative;
        }

            /* Contenedor principal alineado con footer */
            .topbar .container {
                display: flex;
                align-items: center;
                position: relative;
            }

        /* Logo */
        .topbar-brand {
            flex-shrink: 0;
            margin-right: 2rem;
        }

        .brand-img {
            height: 38px;
            object-fit: contain;
        }

        /* Menú principal centrado */
        .topbar-nav-center {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        /* Menú de usuario FUERA del container, pegado a la derecha absoluta */
        .topbar-nav-right {
            position: fixed;
            right: 15px;
            top: 0;
            display: flex;
            align-items: center;
            height: 58px;
            z-index: 1101;
        }

        /* Dropdowns se muestran encima sin desplazar contenido */
        .topbar .dropdown-menu {
            position: absolute;
            z-index: 1050;
        }

        .mobile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(0,0,0,0.06);
        }

        .offcanvas-menu .offcanvas-body {
            padding: 1rem;
        }

        .offcanvas-user {
            border-top: 1px solid #e9ecef;
            padding-top: 12px;
            margin-top: 12px;
        }

            .offcanvas-user .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }

        .offcanvas-nav .nav-link {
            padding: 6px 0;
            display: block;
            color: #0f172a;
            font-size: .9rem;
        }

        /* Desktop menu links */
        .topbar .navbar-nav .nav-link {
            font-size: .9rem;
        }

        .topbar .nav-link.active {
            color: #6a4e7a;
            font-weight: 600;
        }

        /* Dropdown items */
        .dropdown-menu .dropdown-item {
            font-size: .9rem;
        }

        /* Tree / submenu styling for offcanvas */
        .offcanvas-nav ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .offcanvas-nav li {
            margin: 4px 0;
        }

        .offcanvas-nav .submenu {
            padding-left: 14px;
            margin-top: 6px;
        }

        .offcanvas-nav .has-children > .nav-link::after {
            content: '▾';
            float: right;
            font-size: 0.9rem;
            color: #6b7280;
        }

        .offcanvas-nav .collapse-sub {
            display: block;
        }

        .offcanvas-nav a {
            text-decoration: none;
            color: inherit;
        }

        .offcanvas {
            width: 320px;
            max-width: 86%;
        }
    </style>

    @* Desktop topbar: visible only on lg+ *@
    <nav class="navbar topbar d-none d-lg-flex">
        <div class="container">
            <a class="topbar-brand" href="/">
                <img src="~/img/logo.png" class="brand-img" alt="eiibd26 logo" />
            </a>

            <div class="topbar-nav-center">
                <ul class="navbar-nav d-flex flex-row align-items-center mb-0">
                    <li class="nav-item"><a class="nav-link@(ActiveClass("/"))" href="/"><i class="bi bi-house-door-fill"></i>&nbsp;Inicio</a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center@(ActiveClass("/Contenidos"))" href="/Contenidos"><i class="bi bi-search"></i><span>&nbsp;Buscador+</span></a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center@(ActiveClass("/Preguntas"))" href="/Preguntas"><i class="bi bi-view-stacked"></i><span>&nbsp;Preguntas y Respuestas</span></a></li>

                    @* Existing partial menus *@
                    <partial name="~/Pages/Shared/_CategoryMenuPartial.cshtml" />
                    <partial name="~/Pages/Shared/_menuContenidoPartial.cshtml" />
                    <li class="nav-item"><a class="nav-link d-flex align-items-center@(ActiveClass("/Mapa"))" href="/Mapa"><i class="bi bi-globe"></i><span>&nbsp;Comunidad</span></a></li>
                    @if (isAuth)
                    {
                        <li><a class="nav-link" href="@Url.Page("/Usuario/Dashboard", new { area = "Identity" })">Dashboard</a></li>
                    }
                </ul>
            </div>
        </div>

        @* Menú de usuario FUERA del container *@
        <div class="topbar-nav-right">
            <ul class="navbar-nav d-flex flex-row align-items-center mb-0">
                @if (!isAuth)
                {
                    <li class="nav-item"><a class="nav-link@(ActiveClass("/Identity/Account/Login"))" href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión</a></li>
                    <li class="nav-item"><a class="nav-link@(ActiveClass("/Identity/Account/Register"))" href="/Identity/Account/Register"><i class="bi bi-person-plus me-1"></i> Registro</a></li>
                }
                else
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center@(ActiveClass("/Identity/Account/Manage"))" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@avatarSrc" alt="Mi avatar" class="rounded-circle me-2" style="height:28px;width:28px;object-fit:cover;border:1px solid rgba(0,0,0,0.06);" />
                            <span class="me-1">@displayName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                            <li class="px-3 py-2">
                                <div class="d-flex align-items-start">
                                    <img src="@avatarSrc" alt="Avatar" class="rounded-circle me-2" style="height:36px;width:36px;object-fit:cover;border:1px solid rgba(0,0,0,0.06);" />
                                    <div>
                                        <div class="fw-semibold">@displayName</div>
                                        @if (!string.IsNullOrEmpty(userName))
                                        {
                                            <div class="small text-muted">Usuario: @userName</div>
                                        }
                                        else if (!string.IsNullOrEmpty(userId))
                                        {
                                            <div class="small text-muted">Usuario: @userId</div>
                                        }
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Identity/Account/Manage/UsuarioPerfil">Perfil público</a></li>
                            <li><a class="dropdown-item" href="/Identity/Account/Manage">Usuario/Registro</a></li>
                            <li><a class="dropdown-item" href="/Identity/Account/Manage/Email">Cambiar email</a></li>
                            <li><a class="dropdown-item" href="/Identity/Account/Manage/ChangePassword">Cambiar contraseña</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="dropdown-item d-flex align-items-center"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </nav>
</header>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('click', function (e) {
                var h = e.target.closest('.has-children > .nav-link');
                if (!h) return;
                var li = h.parentElement;
                var submenu = li.querySelector('.submenu');
                if (!submenu) return;
                if (submenu.classList.contains('collapse-sub')) {
                    submenu.classList.remove('collapse-sub');
                } else {
                    submenu.classList.add('collapse-sub');
                }
                e.preventDefault();
            });
        })();
    </script>
}