@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@using eiibd26.Models
@using System
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var avatarSrc = Url.Content("~/img/default-avatar.png");
    string userId = null; string displayName = null; string userName = null;

    if (isAuth)
    {
        userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            try { var identityUser = await UserManager.FindByIdAsync(userId); if (identityUser != null) userName = identityUser.UserName; }
            catch { userName = userName ?? User?.Identity?.Name; }
        }
        else { userName = User?.Identity?.Name; }

        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                Perfil perfil = null;
                if (Guid.TryParse(userId, out var userGuid)) perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser == userGuid);
                else perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser.ToString() == userId);

                if (perfil != null)
                {
                    if (!string.IsNullOrWhiteSpace(perfil.Nombre))
                        displayName = perfil.Nombre + (string.IsNullOrWhiteSpace(perfil.Apellidos) ? "" : " " + perfil.Apellidos);

                    if (!string.IsNullOrWhiteSpace(perfil.Avatar) && perfil.Avatar.StartsWith("/uploads/"))
                        avatarSrc = Url.Content("~" + perfil.Avatar);
                }
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(displayName) && User.IsInRole("Medico") && Guid.TryParse(userId, out var medicoGuidTop))
        {
            try
            {
                var medicoNombre = await Db.MedicosPerfilExtendido
                    .AsNoTracking()
                    .Where(m => m.UserId == medicoGuidTop)
                    .Select(m => m.Medico != null ? m.Medico.NombreCompleto : null)
                    .FirstOrDefaultAsync();
                if (!string.IsNullOrWhiteSpace(medicoNombre))
                    displayName = medicoNombre;
            }
            catch { }
        }

        displayName = displayName ?? User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "Usuario";

        if (avatarSrc == Url.Content("~/img/default-avatar.png"))
        {
            var env = Context.RequestServices.GetService(typeof(IWebHostEnvironment)) as IWebHostEnvironment;
            if (!string.IsNullOrEmpty(userId) && env != null)
            {
                try
                {
                    var physicalPath = System.IO.Path.Combine(env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                    if (System.IO.File.Exists(physicalPath)) avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
                }
                catch { avatarSrc = Url.Content("~/img/default-avatar.png"); }
            }
        }
    }

    var rawPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(rawPath)) rawPath = "/";
    string GetFirstSegment(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "/") return "/";
        var trimmed = path.Trim('/');
        var parts = trimmed.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? "/" + parts[0].ToLowerInvariant() : "/";
    }
    var currentFirst = GetFirstSegment(rawPath);
    Func<string, bool> IsActivePath = seg =>
    {
        if (string.IsNullOrEmpty(seg)) return false;
        var normSeg = seg.StartsWith("/") ? seg.TrimEnd('/') : ("/" + seg.TrimEnd('/'));
        if (normSeg == "/") return currentFirst == "/";
        var segFirst = GetFirstSegment(normSeg);
        return string.Equals(segFirst, currentFirst, StringComparison.OrdinalIgnoreCase);
    };
    Func<string, string> ActiveClass = seg => IsActivePath(seg) ? " active" : "";
}
<header>
    <style>
        /* ── TOPBAR DESKTOP ─────────────────────────────────────────────── */
        .topbar {
            background: var(--eii-surface);
            border-bottom: 1px solid var(--eii-border);
            box-shadow: 0 1px 6px rgba(0,0,0,.04);
            z-index: 1100;
            width: 100%;
        }

        .topbar .container {
            display: flex;
            align-items: center;
            height: 56px;
            position: relative;
        }

        .topbar-brand {
            flex-shrink: 0;
            margin-right: 1.5rem;
        }

        .brand-img {
            height: 36px;
            object-fit: contain;
        }

        .topbar-nav-center {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        /* FIX: user menu is now part of normal flex flow (was position:fixed — caused sticky avatar bug) */
        .topbar-nav-right {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            margin-left: auto;
        }

        .topbar .dropdown-menu {
            position: absolute;
            z-index: 1050;
        }

        /* Nav links */
        .topbar .navbar-nav .nav-link {
            font-size: .875rem;
            color: var(--eii-text-soft);
            transition: color var(--eii-transition-base);
            padding: 0.35rem 0.55rem;
        }

        .topbar .navbar-nav .nav-link:hover {
            color: var(--eii-primary);
        }

        .topbar .nav-link.active {
            color: var(--eii-primary);
            font-weight: 600;
        }

        .topbar .dropdown-menu .dropdown-item {
            font-size: .875rem;
        }

        /* Avatar sizes */
        .topbar-avatar-sm {
            height: 28px;
            width: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--eii-border);
        }

        .topbar-avatar-md {
            height: 36px;
            width: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--eii-border);
        }

        .topbar-panel-icon {
            color: var(--eii-primary);
        }

        /* ── MOBILE TOPBAR (shared styles, rendered alongside desktop) ─── */
        .mobile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--eii-border);
        }

        /* ── OFFCANVAS (mobile drawer) ──────────────────────────────────── */
        .offcanvas {
            width: 300px;
            max-width: 85%;
        }

        .offcanvas-menu .offcanvas-body {
            padding: 1rem;
        }

        .offcanvas-user {
            border-top: 1px solid var(--eii-border);
            padding-top: 12px;
            margin-top: 12px;
        }

        .offcanvas-user .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--eii-border);
        }

        .offcanvas-nav .nav-link {
            padding: 7px 0;
            display: block;
            color: var(--eii-text);
            font-size: .9rem;
        }

        .offcanvas-nav ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .offcanvas-nav li {
            margin: 2px 0;
        }

        .offcanvas-nav .submenu {
            padding-left: 14px;
            margin-top: 4px;
        }

        .offcanvas-nav .has-children > .nav-link::after {
            content: '▾';
            float: right;
            font-size: 0.9rem;
            color: var(--eii-text-soft);
        }

        .offcanvas-nav .collapse-sub { display: block; }

        .offcanvas-nav a {
            text-decoration: none;
            color: inherit;
        }
    </style>

    @* Desktop topbar: visible only on lg+ *@
    <nav class="navbar topbar d-none d-lg-flex" role="banner">
        <div class="container">
            <a class="topbar-brand" href="/">
                <img src="~/img/logo.png" class="brand-img" alt="EIIBD logo" />
            </a>

            <div class="topbar-nav-center">
                <ul class="navbar-nav d-flex flex-row align-items-center mb-0">
                    <li class="nav-item"><a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Contenidos"))" href="/Contenidos" @(IsActivePath("/Contenidos") ? "aria-current=\"page\"" : "")><i class="bi bi-search"></i><span>Buscador</span></a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Preguntas"))" href="/Preguntas" @(IsActivePath("/Preguntas") ? "aria-current=\"page\"" : "")><i class="bi bi-view-stacked"></i><span>Preguntas y Respuestas</span></a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Glosario"))" href="/Glosario" @(IsActivePath("/Glosario") ? "aria-current=\"page\"" : "")><i class="bi bi-book"></i><span>Glosario</span></a></li>
                    <partial name="~/Pages/Shared/_CategoryMenuPartial.cshtml" />
                    <partial name="~/Pages/Shared/_menuContenidoPartial.cshtml" />
                    <li class="nav-item"><a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Mapa"))" href="/Mapa" @(IsActivePath("/Mapa") ? "aria-current=\"page\"" : "")><i class="bi bi-globe"></i><span>Comunidad</span></a></li>
                    @if (isAuth)
                    {
                        var panelHref = User.IsInRole("Administrador")
                            ? "/Identity/Admin/Dashboard"
                            : User.IsInRole("Medico")
                                ? "/Identity/Medico/Dashboard"
                                : "/Identity/Usuario/Dashboard";
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-1" href="@panelHref"><i class="bi bi-motherboard topbar-panel-icon"></i><span>Panel</span></a></li>
                    }
                </ul>
            </div>

            @* User menu now INSIDE container — fixes sticky/floating avatar bug *@
            <div class="topbar-nav-right">
                <ul class="navbar-nav d-flex flex-row align-items-center mb-0">
                    @if (!isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Identity/Account/Login"))" href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1@(ActiveClass("/Identity/Account/Register"))" href="/Identity/Account/Register?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"><i class="bi bi-person-plus"></i> Registro</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2@(ActiveClass("/Identity/Account/Manage"))" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarSrc" alt="Mi avatar" class="topbar-avatar-sm" />
                                <span>@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@avatarSrc" alt="Avatar" class="topbar-avatar-md" />
                                        <div>
                                            <div class="fw-semibold" style="font-size:.9rem;">@displayName</div>
                                            @if (!string.IsNullOrEmpty(userName))
                                            {
                                                <div class="small text-muted">@@@userName</div>
                                            }
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/UsuarioPerfil">Editar perfil público</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage">Mi cuenta</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/Email">Cambiar email</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/ChangePassword">Cambiar contraseña</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-1"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('click', function (e) {
                var h = e.target.closest('.has-children > .nav-link');
                if (!h) return;
                var li = h.parentElement;
                var submenu = li.querySelector('.submenu');
                if (!submenu) return;
                if (submenu.classList.contains('collapse-sub')) {
                    submenu.classList.remove('collapse-sub');
                } else {
                    submenu.classList.add('collapse-sub');
                }
                e.preventDefault();
            });
        })();
    </script>
}
