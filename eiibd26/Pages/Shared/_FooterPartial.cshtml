@using System.Linq
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@using eiibd26.Models
@inject ApplicationDbContext _db

@{
    // Datos
    var categorias12 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 12 || c.CategoriaPadre == 12))
        .OrderBy(c => c.Nombre)
        .ToListAsync();

    var categorias47 = await _db.ContenidosCategorias
        .AsNoTracking()
        .Where(c => !c.Borrado && c.Relevante == true && (c.Sequence == 47 || c.CategoriaPadre == 47))
        .OrderBy(c => c.Nombre)
        .ToListAsync();

    string Escape(string s) => string.IsNullOrEmpty(s) ? "" : System.Net.WebUtility.HtmlEncode(s);

    IEnumerable<ContenidoCategoria> GetChildren(IEnumerable<ContenidoCategoria> list, int parentSeq) =>
        list.Where(x => x.CategoriaPadre == parentSeq).OrderBy(x => x.Nombre);

    ContenidoCategoria? GetParent(IEnumerable<ContenidoCategoria> list, int parentSeq) =>
        list.FirstOrDefault(x => x.Sequence == parentSeq);

    // Helper para crear ruta de categoría (usa slug si existe, si no sequence)
    string CategoryUrl(ContenidoCategoria c)
    {
        if (c == null) return "#";
        var segment = !string.IsNullOrWhiteSpace(c.CategoriaSlug) ? c.CategoriaSlug : c.Sequence.ToString();
        // Url.Content asegura la raíz correcta (~)
        return Url.Content($"/Contenidos/categoria/{segment}");
    }
}

<style>
    /* (mantén aquí tu CSS del footer tal como ya lo tienes en producción) */
    /* No modifiqué estilos, solo los enlaces */
    .site-footer {
        background: #f8fafc;
        padding: 28px 16px;
        box-sizing: border-box;
        width: 100%;
    }

    .footer-row {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        width: 100%;
        box-sizing: border-box;
    }

    .footer-left-block {
        width: 1190px;
        display: flex;
        gap: 20px;
        box-sizing: border-box;
        align-items: stretch;
    }

    .footer-col-first {
        width: 250px;
        box-sizing: border-box;
        padding-right: 16px;
        border-right: 1px solid #ececec;
    }

        .footer-col-first img {
            max-width: 160px;
            height: auto;
            display: block;
            margin-bottom: 12px;
        }

    .footer-first-text {
        color: #6b7280;
        font-size: .95rem;
        margin-bottom: 8px;
    }

    .footer-center {
        width: 940px;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: 320px 320px 240px;
        column-gap: 20px;
        align-items: start;
    }

        .footer-center > div {
            min-width: 0;
            word-break: break-word;
        }

    .footer-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .footer-list > li {
            margin-bottom: .5rem;
        }

    .footer-list-children {
        margin-left: 1rem;
        margin-top: .5rem;
    }

    .footer-actions .btn {
        min-height: 42px;
        white-space: nowrap;
    }

    .footer-far {
        width: 220px;
        box-sizing: border-box;
        align-self: flex-start;
        margin-left: auto;
        text-align: right;
    }

        .footer-far .copyright {
            color: #6b7280;
            font-size: .95rem;
        }

    @@media (max-width:1409px) {
        .footer-row {
            display: block;
        }

        .footer-left-block {
            width: 100%;
            display: block;
            margin-bottom: 16px;
        }

        .footer-col-first {
            width: 100%;
            padding-right: 0;
            margin-bottom: 12px;
            border-right: none;
        }

        .footer-center {
            width: 100%;
            grid-template-columns: 1fr;
            column-gap: 0;
            row-gap: 12px;
        }

        .footer-far {
            width: 100%;
            margin-left: 0;
            text-align: left;
            margin-top: 12px;
        }

        .site-footer {
            padding-left: 12px;
            padding-right: 12px;
        }
    }

    @@media (max-width:767.98px) {
        .footer-center {
            grid-template-columns: 1fr;
        }
    }
</style>

<footer class="site-footer" role="contentinfo" aria-label="Footer">
    <div class="footer-row">
        <div class="footer-left-block">
            <!-- Column 1 -->
            <div class="footer-col-first" aria-label="Footer brand column">
                <a href="~/" class="footer-brand" aria-label="Ir al inicio">
                    <img src="~/img/logo.png" alt="eiibd26 logo" />
                </a>

                <div class="footer-first-text small">
                    Breve descripción del sitio. Reemplaza este texto con lo que prefieras.
                </div>

                <div class="footer-social d-flex align-items-center" aria-label="Redes sociales">
                    <a href="https://www.facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="text-dark me-2"><i class="bi bi-facebook"></i></a>
                    <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="Twitter" class="text-dark me-2"><i class="bi bi-twitter"></i></a>
                    <a href="https://www.instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="text-dark me-2"><i class="bi bi-instagram"></i></a>
                    <a href="https://www.linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-dark me-2"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>

            <!-- Center: 320px, 320px, 240px -->
            <div class="footer-center" role="navigation" aria-label="Footer links">
                <!-- Col 2: categories (320px) -->
                <div>
                    @{
                        var parent12 = GetParent(categorias12, 12);
                        var children12 = GetChildren(categorias12, 12).ToList();

                        if (parent12 != null)
                        {
                            <ul class="footer-list small" aria-label="Categorías destacadas">
                                <li>
                                    <a class="text-dark fw-bold" href="@CategoryUrl(parent12)">
                                        @Html.Raw(Escape(parent12.Nombre ?? "(sin nombre)"))
                                    </a>
                                </li>
                                @if (children12.Any())
                                {
                                    <ul class="footer-list footer-list-children" aria-label="Subcategorías">
                                        @foreach (var c in children12)
                                        {
                                            <li>
                                                <a class="text-dark" href="@CategoryUrl(c)">
                                                    @Html.Raw(Escape(c.Nombre ?? "(sin nombre)"))
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </ul>
                        }
                        else if (children12.Any())
                        {
                            <ul class="footer-list small" aria-label="Categorías destacadas">
                                <li class="text-muted">(Categoría padre no encontrada)</li>
                                <ul class="footer-list footer-list-children" aria-label="Subcategorías">
                                    @foreach (var c in children12)
                                    {
                                        <li>
                                            <a class="text-dark" href="@CategoryUrl(c)">
                                                @Html.Raw(Escape(c.Nombre ?? "(sin nombre)"))
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </ul>
                        }
                        else
                        {
                            <div class="small text-muted">No hay categorías relevantes.</div>
                        }
                    }
                </div>

                <!-- Col 3: contenido (320px) -->
                <div>
                    @{
                        var parent47 = GetParent(categorias47, 47);
                        var children47 = GetChildren(categorias47, 47).ToList();

                        if (parent47 != null)
                        {
                            <ul class="footer-list small" aria-label="Contenido destacado">
                                <li>
                                    <a class="text-dark fw-bold" href="@CategoryUrl(parent47)">
                                        @Html.Raw(Escape(parent47.Nombre ?? "(sin nombre)"))
                                    </a>
                                </li>
                                @if (children47.Any())
                                {
                                    <ul class="footer-list footer-list-children" aria-label="Subcategorías">
                                        @foreach (var c in children47)
                                        {
                                            <li>
                                                <a class="text-dark" href="@CategoryUrl(c)">
                                                    @Html.Raw(Escape(c.Nombre ?? "(sin nombre)"))
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </ul>
                        }
                        else if (children47.Any())
                        {
                            <ul class="footer-list small">
                                <li class="text-muted">(Categoría padre no encontrada)</li>
                                <ul class="footer-list footer-list-children">
                                    @foreach (var c in children47)
                                    {
                                        <li>
                                            <a class="text-dark" href="@CategoryUrl(c)">
                                                @Html.Raw(Escape(c.Nombre ?? "(sin nombre)"))
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </ul>
                        }
                        else
                        {
                            <div class="small text-muted">No hay contenidos relevantes.</div>
                        }
                    }
                </div>

                <!-- Col 4: acciones (240px) -->
                <div class="footer-actions" aria-label="Acciones">
                    <div class="d-flex flex-column gap-2">
                        <form method="post" action="/Contacto/Subscribe" class="d-inline" aria-label="Suscribirse">
                            <button type="submit" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center">
                                <i class="bi bi-envelope-fill me-2" aria-hidden="true"></i> Suscribirse
                            </button>
                        </form>

                        <a href="@Url.Page("/Contacto/Index")" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center" aria-label="Contacto">
                            <i class="bi bi-telephone-fill me-2" aria-hidden="true"></i> Contacto
                        </a>

                        <a href="@Url.Page("/Donar/Index")" class="btn btn-outline-success w-100 d-flex align-items-center justify-content-center" aria-label="Donar">
                            <i class="bi bi-currency-dollar me-2" aria-hidden="true"></i> Donar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quinta columna: separada a la derecha -->
        <div class="footer-far" aria-label="Footer right column">
            <div class="mb-2">
                <strong>Derechos</strong>
            </div>
            <div class="small text-muted copyright">
                &copy; @(DateTime.UtcNow.Year) - eiibd26<br />
                Todos los derechos reservados.
            </div>
        </div>
    </div>
</footer>