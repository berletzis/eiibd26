@model eiibd26.Models.Directorio.MedicoCardVm

@{
    var _badgeComunidad = ViewData["BadgeComunidad"] as bool? ?? false;
    var _badgeVerificado = ViewData["BadgeVerificado"] as bool? ?? false;
    var _badgeMedico = ViewData["BadgeMedico"] as bool? ?? false;
    var _ubicacion = string.Join(", ", new[] { Model.Ciudad, Model.Estado }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<article class="eii-card eii-card--link medico-card">
    <div class="medico-card__header">
        <div class="medico-card__avatar">
            <i class="bi bi-person-badge-fill"></i>
        </div>
        <div class="medico-card__info">
            <h3 class="medico-card__nombre">
                <a asp-page="/DirectorioMedicos/Detalle" asp-route-id="@Model.Id">@Model.NombreCompleto</a>@if (Model.CedulaValidada)
                {<span class="medico-card__verified-inline" title="Cédula verificada"><i class="bi bi-patch-check-fill"></i></span>}
            </h3>
            @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
            {
                <p class="medico-card__especialidad">@Model.Especialidad
                    @if (!string.IsNullOrWhiteSpace(Model.Subespecialidad))
                    {<span class="text-muted"> · @Model.Subespecialidad</span>}
                </p>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_ubicacion))
    {
        <div class="medico-card__ubicacion">
            <i class="bi bi-geo-alt text-muted"></i>
            <span>@_ubicacion</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.HospitalClinica))
    {
        <div class="medico-card__hospital text-muted">
            <i class="bi bi-hospital"></i> @Model.HospitalClinica
        </div>
    }

    @if (Model.AreasExperiencia.Any())
    {
        <div class="medico-card__areas">
            @foreach (var area in Model.AreasExperiencia.Take(4))
            { <span class="se-rel-badge">@area</span> }
            @if (Model.AreasExperiencia.Count > 4)
            { <span class="se-rel-badge text-muted">+@(Model.AreasExperiencia.Count - 4) más</span> }
        </div>
    }

    <div class="medico-card__footer">
        <span class="medico-nivel-badge @Model.NivelConfianzaBadgeClass">@Model.NivelConfianzaLabel</span>
        @if (Model.TotalPacientesUnicos > 0)
        {
            <span class="medico-card__confirmaciones text-muted">
                @Model.TotalPacientesUnicos paciente@(Model.TotalPacientesUnicos == 1 ? "" : "s") de la comunidad lo ha@(Model.TotalPacientesUnicos == 1 ? "" : "n") identificado
            </span>
        }
    </div>

    <div class="medico-card__status-badges">
        <span class="medico-status-badge @(_badgeComunidad ? "badge-status-comunidad" : "badge-status-inactivo")">
            <i class="bi bi-people-fill"></i> Comunidad
        </span>
        <span class="medico-status-badge @(_badgeVerificado ? "badge-status-verificado" : "badge-status-inactivo")">
            <i class="bi bi-patch-check"></i> Verificado
        </span>
        <span class="medico-status-badge @(_badgeMedico ? "badge-status-medico" : "badge-status-inactivo")">
            <i class="bi bi-patch-check-fill"></i> Médico
        </span>
    </div>

    @if (Model.BadgesGanados.Any())
    {
        var badgeDefs = new[]
        {
            new { Clave = "perfil_reclamado",    Icono = "bi-shield-check",      Color = "#4f46e5", Label = "Perfil Reclamado" },
            new { Clave = "verificado",          Icono = "bi-patch-check-fill",  Color = "#0ea5e9", Label = "Verificado" },
            new { Clave = "activo_comunidad",    Icono = "bi-people-fill",       Color = "#22c55e", Label = "Activo en Comunidad" },
            new { Clave = "participante_qa",     Icono = "bi-chat-dots-fill",    Color = "#f59e0b", Label = "Participa en Q&A" },
            new { Clave = "validador_contenido", Icono = "bi-check2-circle",     Color = "#8b5cf6", Label = "Valida Contenido" },
            new { Clave = "creador_contenido",   Icono = "bi-pencil-square",     Color = "#ec4899", Label = "Crea Contenido" },
        };
        <div class="d-flex flex-wrap gap-1 mt-2">
            @foreach (var bd in badgeDefs.Where(b => Model.BadgesGanados.Contains(b.Clave)))
            {
                <span class="badge-medico-pill badge-compact"
                      style="background:@(bd.Color)20; border:1.5px solid @(bd.Color); color:@(bd.Color);"
                      title="@bd.Label" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="bi @bd.Icono"></i>
                </span>
            }
        </div>
    }
</article>
