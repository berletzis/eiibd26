@page
@model eiibd26.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 bg-white rounded shadow-sm">
                <h1 class="h4 mb-0">Bienvenido</h1>
                <p class="text-muted mb-0">Panel resumen rápido</p>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Block 1 -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Usuarios y estados de ánimo</h5>

                    <div class="row mt-3">
                        <div class="col-12 col-md-6">
                            <div class="mb-3">
                                <div class="small text-muted">Usuarios registrados (email confirmado)</div>
                                <div class="h3">@Model.RegisteredUsersCount</div>
                            </div>

                            <div>
                                <div class="small text-muted">Usuarios con condición dada de alta</div>
                                <div class="h4">@Model.UsersWithConditionCount</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="small text-muted mb-2">Estados de ánimo (total)</div>

                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>Muy bien</span>
                                    <span class="badge bg-primary rounded-pill">@Model.MoodCounts["MuyBien"]</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>Bien</span>
                                    <span class="badge bg-primary rounded-pill">@Model.MoodCounts["Bien"]</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>Neutral</span>
                                    <span class="badge bg-primary rounded-pill">@Model.MoodCounts["Neutral"]</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>Mal</span>
                                    <span class="badge bg-primary rounded-pill">@Model.MoodCounts["Mal"]</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>Muy mal</span>
                                    <span class="badge bg-primary rounded-pill">@Model.MoodCounts["MuyMal"]</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <small class="text-muted">Última actualización: @DateTime.UtcNow.ToString("g") (UTC)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Block 2: Top 5 Preguntas -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Top 5 preguntas</h5>

                    @if (Model.TopQuestions?.Any() != true)
                    {
                        <div class="text-muted">No hay preguntas disponibles.</div>
                    }
                    else
                    {
                        <ol class="list-group list-group-numbered mt-3">
                            @foreach (var q in Model.TopQuestions)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-semibold text-truncate" style="max-width: 220px;">
                                            <a href="/Preguntas/Detalles/@q.Id" title="@q.Titulo" style="text-decoration:none;">
                                                @q.Titulo
                                            </a>
                                        </div>
                                        <small class="text-muted">Respuestas: @q.RespuestasCount · Votos: @q.VotesSum</small>
                                    </div>
                                    <span class="badge bg-success rounded-pill">@q.Score</span>
                                </li>
                            }
                        </ol>
                    }

                    <div class="mt-auto">
                        <small class="text-muted">Clasificación: votos + 2×respuestas</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Block 3: placeholder empty -->
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Bloque 3</h5>
                    <p class="text-muted">Contenido pendiente — reservado para futuras métricas o widgets.</p>

                    <div class="mt-auto">
                        <small class="text-muted">Espacio disponible</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // small enhancement: truncate long titles on hover with tooltip (Bootstrap tooltip)
        (function () {
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('.text-truncate a'));
                tooltipTriggerList.forEach(function (el) {
                    new bootstrap.Tooltip(el, { title: el.getAttribute('title'), placement: 'top' });
                });
            }
        })();
    </script>
}