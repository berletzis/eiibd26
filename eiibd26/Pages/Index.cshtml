@page
@model eiibd26.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
}
<div class="crm-container">
    <h2 class="crm-title mb-4">Panel de inicio</h2>
    <div class="crm-card p-4 mb-4">
        <div class="crm-form-row">
            <div class="crm-col-8">
                <label class="crm-label">
                    <i class="bi bi-speedometer2 crm-icon"></i> Resumen rápido
                </label>
                <div class="crm-search-horizontal">
                    <div class="crm-input" style="display:flex;align-items:center;gap:12px;padding:12px;">
                        <div>
                            <div class="small text-muted">Usuarios registrados (email confirmado)</div>
                            <div class="h3 mb-0">@Model.RegisteredUsersCount</div>
                            <div class="small text-muted mt-2">Con condición dada de alta</div>
                            <div class="h5 mb-0">@Model.UsersWithConditionCount</div>
                        </div>

                        <div style="margin-left:auto;text-align:right;">
                            <div class="small text-muted">Última actualización</div>
                            <div class="h6 mb-0">@DateTime.UtcNow.ToString("g") (UTC)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="crm-card mb-3 crm-header-block">
        <h3>
            <i class="bi bi-kanban text-danger me-1"></i> Información principal
        </h3>
    </div>

    <div class="crm-card-row">
        <!-- Column 1: Usuarios y Estados (left card) -->
        <div class="crm-card-condicion">
            <div class="crm-card-inner">
                <div class="crm-card-header">
                    <span class="crm-card-title">
                        <i class="bi bi-people text-success me-1"></i>
                        Usuarios & Estados
                    </span>
                </div>

                <div class="crm-card-section mb-2">
                    <div class="crm-card-subtitle fw-semibold" style="font-size:.98em; color:#315686;">
                        Totales
                    </div>
                    <div class="mt-2">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="text-muted">Registrados (confirmados)</div>
                            <div class="fw-semibold">@Model.RegisteredUsersCount</div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="text-muted">Con condición</div>
                            <div class="fw-semibold">@Model.UsersWithConditionCount</div>
                        </div>
                    </div>
                </div>

                <div class="crm-card-section mb-2">
                    <div class="crm-card-subtitle fw-semibold" style="font-size:.98em; color:#315686;">
                        Estados de ánimo
                    </div>
                    <div class="crm-card-badges mt-2">
                        <span class="crm-badge bg-info mb-1 d-inline-flex align-items-center">
                            Muy bien
                            <span class="badge bg-white text-dark ms-2">@Model.MoodCounts["MuyBien"]</span>
                        </span>
                        <span class="crm-badge bg-info mb-1 d-inline-flex align-items-center">
                            Bien
                            <span class="badge bg-white text-dark ms-2">@Model.MoodCounts["Bien"]</span>
                        </span>
                        <span class="crm-badge bg-secondary mb-1 d-inline-flex align-items-center">
                            Neutral
                            <span class="badge bg-white text-dark ms-2">@Model.MoodCounts["Neutral"]</span>
                        </span>
                        <span class="crm-badge bg-warning mb-1 d-inline-flex align-items-center">
                            Mal
                            <span class="badge bg-white text-dark ms-2">@Model.MoodCounts["Mal"]</span>
                        </span>
                        <span class="crm-badge bg-danger mb-1 d-inline-flex align-items-center">
                            Muy mal
                            <span class="badge bg-white text-dark ms-2">@Model.MoodCounts["MuyMal"]</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Column 2: Top 5 Preguntas (middle card) -->
        <div class="crm-card-condicion">
            <div class="crm-card-inner">
                <div class="crm-card-header">
                    <span class="crm-card-title">
                        <i class="bi bi-star text-success me-1"></i>
                        Top 5 Preguntas
                    </span>
                </div>

                <div class="crm-card-section mb-2">
                    <div class="crm-card-subtitle fw-semibold" style="font-size:.98em; color:#315686;">
                        Más activas / votadas
                    </div>

                    <div class="mt-2">
                        @if (Model.TopQuestions == null || !Model.TopQuestions.Any())
                        {
                            <div class="text-muted small">No hay preguntas para mostrar.</div>
                        }
                        else
                        {
                            <ol class="list-group list-group-numbered mt-2">
                                @foreach (var q in Model.TopQuestions)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start" style="background:transparent;border:0;padding:.5rem 0;">
                                        <div class="ms-2 me-auto" style="max-width:320px;">
                                            <div class="fw-semibold text-truncate" style="max-width: 100%;">
                                                <a href="/Preguntas/Detalles/@q.Id" title="@q.Titulo" style="text-decoration:none;color:inherit;">
                                                    @q.Titulo
                                                </a>
                                            </div>
                                            <small class="text-muted">Respuestas: @q.RespuestasCount · Votos: @q.VotesSum</small>
                                        </div>
                                        <span class="crm-badge bg-success rounded-pill">@q.Score</span>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Column 3: Placeholder (right card) -->
        <div class="crm-card-condicion">
            <div class="crm-card-inner">
                <div class="crm-card-header">
                    <span class="crm-card-title">
                        <i class="bi bi-graph-up text-success me-1"></i>
                        Bloque 3
                    </span>
                </div>

                <div class="crm-card-section mb-2">
                    <div class="crm-card-subtitle fw-semibold" style="font-size:.98em; color:#315686;">
                        Reservado
                    </div>
                    <div class="mt-2">
                        <p class="text-muted small">Espacio para métricas, alertas o widgets personalizados.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" />
}

@section Scripts {
    <script>
        // Inicializar tooltips en títulos truncados
        (function () {
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                document.querySelectorAll('.crm-card-inner .fw-semibold a').forEach(function (el) {
                    new bootstrap.Tooltip(el, { title: el.getAttribute('title') || '', placement: 'top' });
                });
            }
        })();
    </script>
}