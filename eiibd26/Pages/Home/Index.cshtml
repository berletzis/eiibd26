@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/preguntas.css" asp-append-version="true" />
    <style>
        /* Contenedor máx 1340px (específico de Home) */
        .row-small, .blog-list {
            max-width: 1340px;
            margin: 0 auto var(--eii-space-8);
            padding: 0 var(--eii-space-4);
        }

        #usersMapRoot {
            border-radius: var(--eii-radius-md);
            padding: var(--eii-space-3);
            min-height: 220px;
        }

        /* "Ver más" inline */
        .load-more-wrap {
            display: flex;
            justify-content: center;
            margin-top: var(--eii-space-5);
        }
        .more-toggle {
            background: none;
            border: none;
            padding: 0;
            color: var(--eii-primary);
            font-size: var(--eii-text-sm);
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 2px;
        }
        .more-toggle:disabled { opacity: .6; cursor: default; }
        .more-toggle:focus-visible { outline: 2px solid var(--eii-primary); outline-offset: 3px; }

        /* Título de sección — mismo estilo que IniciaAhora */
        .home-section-title {
            font-size: 2rem;
            font-weight: 300;
            color: var(--eii-text-heading);
            line-height: 1.2;
            letter-spacing: -0.04em;
            margin-bottom: var(--eii-space-5);
        }

        @@media (max-width: 767.98px) {
            .home-section-title { font-size: 1.5rem; }
        }
    </style>
}

