@page
@model eiibd26.Pages.Home.IndexModel
@using System.Linq
@using System.Text.Json
@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/preguntas.css" asp-append-version="true" />
    <style>
        /* Container widths - MISMO ANCHO QUE CONTENIDOS/DETALLE */
        .row-small,
        .blog-list {
            max-width: 1340px; /* Actualizado de 1140px a 1340px */
            margin: 0 auto var(--space-xl);
            padding: 0 16px; /* Mismo padding que conte-detail */
        }

        /* Grid de items: 3 columnas en desktop */
        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-lg);
            align-items: start;
        }

            .items-container.featured-1042,
            .items-container.featured-1043 {
                margin-bottom: var(--space-sm);
            }

        /* Card vertical */
        .blog-card {
            display: flex;
            flex-direction: column;
            background: var(--color-bg);
            border-radius: 0.75rem;
            border: 1px solid var(--color-border);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            min-height: 100%;
            transition: all 0.3s ease;
        }

            .blog-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-lg);
                border-color: var(--color-primary-light);
            }

            .blog-card .thumb {
                width: 100%;
                height: 180px;
                background: var(--color-bg-subtle);
                overflow: hidden;
                display: block;
                position: relative;
            }

                /* ✅ MEJORADO: Imagen con zoom y mejor centrado */
                .blog-card .thumb img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    object-position: center center;
                    display: block;
                    transform: scale(1.20);
                    transition: transform 0.3s ease;
                }

            /* ✅ NUEVO: Efecto hover suave */
            .blog-card .thumb:hover img {
                transform: scale(1.25);
            }

            .blog-card .content {
                padding: var(--space-md);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: var(--space-sm);
            }

        .blog-meta {
            font-size: var(--font-size-xs);
            color: var(--color-primary);
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            font-weight: 600;
        }

        .blog-title {
            font-size: var(--font-size-xl);
            margin: var(--space-xs) 0;
            font-weight: 700;
            color: var(--color-heading);
            line-height: var(--line-height-heading);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

            .blog-title a {
                color: inherit;
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .blog-title a:hover {
                    color: var(--color-primary);
                }

        .blog-excerpt {
            color: var(--color-text-secondary);
            line-height: 1.6;
            flex: 1 1 auto;
            font-size: var(--font-size-sm);
            margin: 0 0 var(--space-md) 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .blog-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--space-sm);
            margin-top: var(--space-xs);
            font-size: var(--font-size-sm);
        }

        .author {
            display: flex;
            align-items: center;
            gap: var(--space-xs);
            color: var(--color-text-primary);
        }

            .author .avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--color-bg-subtle);
                overflow: hidden;
                flex: 0 0 32px;
            }

                .author .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }

            .blog-card .thumb {
                height: 220px;
            }
        }

        .section-title {
            font-size: var(--font-size-4xl);
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--color-heading);
            padding-bottom: var(--space-lg);
            line-height: var(--line-height-heading);
        }

        #usersMapRoot {
            border-radius: 8px;
            padding: 12px;
            min-height: 220px;
        }

        /* Load more section */
        .load-more-wrap {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            padding-top: 4px;
            width: 100%;
        }

        .more-toggle {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #2563eb;
            font-size: .95rem;
            cursor: pointer;
            text-decoration: underline;
            display: inline-block;
        }

            .more-toggle:disabled {
                opacity: .7;
                cursor: default;
            }

            .more-toggle:focus {
                outline: 2px dashed rgba(37,99,235,0.25);
                outline-offset: 3px;
            }
    </style>
}

<main>
