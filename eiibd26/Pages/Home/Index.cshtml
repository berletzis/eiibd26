@page
@model eiibd26.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        /* Hero */
        .home-hero {
            padding: 60px 0 40px;
            text-align: center;
            /* background: linear-gradient(180deg,#fafbfd,#fff); */
        }

            .home-hero h1 {
                font-size: 3rem;
                margin-bottom: .6rem;
                font-weight: 700;
            }

            .home-hero p.lead {
                color: #6b7280;
                max-width: 760px;
                margin: 0 auto 1rem;
            }

        /* Blog list container: ancho estándar (ajustable) */
        .blog-list {
            padding: 30px 0 80px;
            max-width: 1140px; /* estándar de diseño */
            margin: 0 auto;
        }

        /* Grid de items: 3 columnas en desktop */
        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
        }

        /* Card vertical (imagen arriba, contenido abajo) */
        .blog-card {
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #eef2f7;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(16,24,40,0.04);
            min-height: 100%;
        }

            .blog-card .thumb {
                width: 100%;
                height: 180px;
                background: #f3f6fa;
                overflow: hidden;
                display: block;
            }

                .blog-card .thumb img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

            .blog-card .content {
                padding: 16px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 12px;
            }

        .blog-meta {
            font-size: .82rem;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .blog-title {
            font-size: 1.05rem;
            margin: 6px 0;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.2;
        }

        .blog-excerpt {
            color: #6b7280;
            line-height: 1.5;
            flex: 1 1 auto;
            font-size: .95rem;
        }

        .blog-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 6px;
            font-size: .9rem;
        }

        .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #334155;
        }

            .author .avatar {
                width: 32px;
                height: 32px;
                border-radius: 999px;
                background: #e6eef9;
                overflow: hidden;
                flex: 0 0 32px;
            }

                .author .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

        .pubdate {
            color: #94a3b8;
            font-size: .9rem;
        }

        /* Responsive: 2 columns en tablet, 1 en móvil */
        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }

            .blog-card .thumb {
                height: 220px;
            }
        }

        .load-more-wrap {
            text-align: center;
            margin-top: 18px;
        }

        /* Mapa: margen/ajuste para la sección del mapa parcial */
        .mapa {
            max-width: 1140px;
            margin: 0 auto 24px;
        }
    </style>
}

<main>
    <section class="home-hero">
        @* Hero partial *@
        <partial name="~/Pages/Shared/HeroPartial.cshtml" model="Model.Hero" />
    </section>

    <!-- MAP PARTIAL INSERTION -->
    <section class="mapa" aria-label="Mapa de usuarios">
        <div id="usersMapRoot">Cargando mapa…</div>

        <script>
            (function () {
                // Fetch the partial (this executes UsersMapPartialModel.OnGetAsync)
                fetch('@Url.Page("/Home/UsersMapPartial")', { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('Error fetching UsersMapPartial: ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        var root = document.getElementById('usersMapRoot');
                        if (!root) return;
                        // Parse the returned HTML into a temporary container
                        var temp = document.createElement('div');
                        temp.innerHTML = html;

                        // Extract all script tags from the temp content
                        var scripts = Array.prototype.slice.call(temp.querySelectorAll('script'));
                        // Separate external (src) and inline scripts
                        var externalScripts = scripts.filter(function (s) { return s.src && s.src.trim().length > 0; });
                        var inlineScripts = scripts.filter(function (s) { return !s.src || s.src.trim().length === 0; });

                        // Remove script tags from temp so we can safely insert HTML without duplicate execution
                        scripts.forEach(function (s) { if (s.parentNode) s.parentNode.removeChild(s); });

                        // Insert the HTML fragment (without scripts) into the page
                        root.innerHTML = temp.innerHTML;

                        // Helper to load external scripts sequentially and wait for each to load
                        function loadExternalSequentially(sources) {
                            return sources.reduce(function (prev, scriptTag) {
                                return prev.then(function () {
                                    return new Promise(function (resolve) {
                                        var s = document.createElement('script');
                                        s.src = scriptTag.src;
                                        s.async = false;
                                        s.onload = function () { resolve(); };
                                        s.onerror = function () {
                                            console.error('Failed to load script: ' + scriptTag.src);
                                            // still resolve to continue loading others
                                            resolve();
                                        };
                                        document.body.appendChild(s);
                                    });
                                });
                            }, Promise.resolve());
                        }

                        // After external scripts loaded, execute inline scripts in order
                        loadExternalSequentially(externalScripts).then(function () {
                            inlineScripts.forEach(function (oldScript) {
                                try {
                                    var s = document.createElement('script');
                                    // preserve type if present
                                    if (oldScript.type) s.type = oldScript.type;
                                    s.text = oldScript.textContent || oldScript.innerText || '';
                                    document.body.appendChild(s);
                                    // remove to keep DOM clean
                                    document.body.removeChild(s);
                                } catch (e) {
                                    console.error('Error executing inline script from partial:', e);
                                }
                            });
                        });
                    })
                    .catch(function (err) {
                        console.error('Error cargando UsersMapPartial:', err);
                        var root = document.getElementById('usersMapRoot');
                        if (root) root.textContent = 'Error al cargar el mapa.';
                    });
            })();
        </script>
    </section>
    <!-- END MAP PARTIAL INSERTION -->

    <section class="blog-list" aria-label="Artículos recientes">
        <div class="items-container">
            @* Render initial items via shared partial that accepts IEnumerable<BlogItemVm> *@
            <partial name="~/Pages/Shared/_BlogItems.cshtml" model="Model.BlogList.Items" />
        </div>

        <div class="load-more-wrap">
            <button id="loadMoreBtn"
                    class="btn btn-outline-primary"
                    data-nextpage="2"
                    data-pagesize="@Model.BlogList.PageSize"
                    data-total="@Model.BlogList.TotalCount">
                Cargar más
            </button>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        (function () {
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (!loadMoreBtn) return;

            const pageSize = parseInt(loadMoreBtn.getAttribute('data-pagesize') || '3', 10);
            const total = parseInt(loadMoreBtn.getAttribute('data-total') || '0', 10);

            // initial: count cards already rendered
            let loadedCount = document.querySelectorAll('.blog-card').length;

            function setLoading(on) {
                loadMoreBtn.disabled = on;
                loadMoreBtn.textContent = on ? 'Cargando...' : 'Cargar más';
            }

            function checkHide() {
                if (total > 0 && loadedCount >= total) {
                    loadMoreBtn.style.display = 'none';
                }
            }

            // initial hide check
            checkHide();

            loadMoreBtn.addEventListener('click', async function () {
                const next = parseInt(loadMoreBtn.getAttribute('data-nextpage') || '2', 10);
                setLoading(true);
                try {
                    const url = new URL('@Url.Page("/Home/BlogMore")', window.location.origin);
                    url.searchParams.set('pageNumber', String(next));
                    url.searchParams.set('pageSize', String(pageSize));

                    const res = await fetch(url.toString(), { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) {
                        console.error('Error loading more:', res.status);
                        alert('Error cargando más artículos.');
                        setLoading(false);
                        return;
                    }

                    const html = await res.text();
                    if (!html || html.trim().length === 0) {
                        loadMoreBtn.style.display = 'none';
                        setLoading(false);
                        return;
                    }

                    const container = document.querySelector('.items-container');

                    // Temporarily parse to count items to be added
                    const temp = document.createElement('div');
                    temp.innerHTML = html;
                    const added = temp.querySelectorAll('.blog-card').length;

                    // Move parsed nodes into the real container
                    while (temp.firstChild) {
                        container.appendChild(temp.firstChild);
                    }

                    // update counters and next page
                    loadedCount += added;
                    loadMoreBtn.setAttribute('data-nextpage', String(next + 1));

                    // hide button if all loaded
                    checkHide();

                } catch (e) {
                    console.error(e);
                    alert('Error de red al cargar más artículos.');
                } finally {
                    setLoading(false);
                }
            });
        })();
    </script>
}