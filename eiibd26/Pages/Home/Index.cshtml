@page
@model eiibd26.Pages.Home.IndexModel
@using System.Linq
@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>


        /* Container widths */
        .row-small,
        .blog-list {
            max-width: 1140px;
            margin: 0 auto 24px;
            padding: 0 8px;
        }

        /* Grid de items: 3 columnas en desktop */
        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
        }

            .items-container.featured-1042,
            .items-container.featured-1043 {
                margin-bottom: 8px;
            }

        /* Card vertical */
        .blog-card {
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #eef2f7;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(16,24,40,0.04);
            min-height: 100%;
        }

            .blog-card .thumb {
                width: 100%;
                height: 180px;
                background: #f3f6fa;
                overflow: hidden;
                display: block;
                position: relative;
            }

                /* ✅ MEJORADO: Imagen con zoom y mejor centrado */
                .blog-card .thumb img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    object-position: center center;
                    display: block;
                    transform: scale(1.20);
                    transition: transform 0.3s ease;
                }

            /* ✅ NUEVO: Efecto hover suave */
            .blog-card .thumb:hover img {
                transform: scale(1.25);
            }

            .blog-card .content {
                padding: 16px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 12px;
            }

        .blog-meta {
            font-size: .82rem;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }


        .blog-title {
            font-size: .9rem;
            margin: 6px 0;
            font-weight: 400;
            color: #0f172a;
            line-height: 1.5;
        }

            .blog-title a {
                color: inherit; /* hereda el color de .blog-title */
                text-decoration: none;
            }

                .blog-title a:hover {
                    color: inherit; /* o un color diferente para hover si quieres */
                }

        .blog-excerpt {
            color: #6b7280;
            line-height: 1.5;
            flex: 1 1 auto;
            font-size: .95rem;
        }

        .blog-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 6px;
            font-size: .9rem;
        }

        .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #334155;
        }

            .author .avatar {
                width: 32px;
                height: 32px;
                border-radius: 999px;
                background: #e6eef9;
                overflow: hidden;
                flex: 0 0 32px;
            }

                .author .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }

            .blog-card .thumb {
                height: 220px;
            }
        }

        .section-title {
            font-size: 2.1rem;
            font-weight: 250;
            letter-spacing: -0.06em;
            color: #172849;
            padding-bottom: 20px;
        }

        #usersMapRoot {
            border-radius: 8px;
            padding: 12px;
            min-height: 220px;
        }

        /* Load more section */
        .load-more-wrap {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            padding-top: 4px;
            width: 100%;
        }

        .more-toggle {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #2563eb;
            font-size: .95rem;
            cursor: pointer;
            text-decoration: underline;
            display: inline-block;
        }

            .more-toggle:disabled {
                opacity: .7;
                cursor: default;
            }

            .more-toggle:focus {
                outline: 2px dashed rgba(37,99,235,0.25);
                outline-offset: 3px;
            }
    </style>
}

<main>
    <section class="home-hero">
        <partial name="~/Pages/Shared/HeroPartial.cshtml" />
    </section>
    <!-- Destacados -->
    <section class="row-small" aria-label="Destacados">
        <div class="section-title">Destacados</div>
        <div class="items-container featured-1042">
            <partial name="~/Pages/Shared/_BlogItems.cshtml" model="Model.Featured1042?.Take(3)" />
        </div>
    </section>


    <!-- MAP PARTIAL INSERTION -->
    <section class="row-small" aria-label="Mapa de usuarios">
        <div id="usersMapRoot">Cargando mapa…</div>

        <script>
            (function () {
                fetch('@Url.Page("/Home/UsersMapPartial")', { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('Error fetching UsersMapPartial: ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        var root = document.getElementById('usersMapRoot');
                        if (!root) return;
                        var temp = document.createElement('div');
                        temp.innerHTML = html;

                        var scripts = Array.prototype.slice.call(temp.querySelectorAll('script'));
                        var externalScripts = scripts.filter(function (s) { return s.src && s.src.trim().length > 0; });
                        var inlineScripts = scripts.filter(function (s) { return !s.src || s.src.trim().length === 0; });

                        scripts.forEach(function (s) { if (s.parentNode) s.parentNode.removeChild(s); });

                        root.innerHTML = temp.innerHTML;

                        // Improved sequential loader: fetch scripts first to validate they are JS (avoid executing HTML/empty responses)
                        function loadExternalSequentially(sources) {
                            return sources.reduce(function (prev, scriptTag) {
                                return prev.then(function () {
                                    return new Promise(function (resolve) {
                                        var src = scriptTag.src;
                                        if (!src) return resolve();

                                        // Try fetching the script to validate content-type and avoid executing non-JS responses
                                        fetch(src, { credentials: 'same-origin', cache: 'no-cache' }).then(function (resp) {
                                            if (!resp.ok) {
                                                console.warn('Script fetch failed, falling back to tag:', src, resp.status);
                                                // Fallback: append script tag so browser can attempt to load/execute (for cross-origin without CORS)
                                                var s = document.createElement('script');
                                                s.src = src; s.async = false;
                                                s.onload = resolve;
                                                s.onerror = function () { console.error('Failed to load script (tag fallback): ' + src); resolve(); };
                                                document.body.appendChild(s);
                                                return;
                                            }

                                            var ct = (resp.headers.get('content-type') || '').toLowerCase();
                                            if (ct.indexOf('javascript') === -1 && ct.indexOf('text/') === -1 && ct.indexOf('application/') === -1) {
                                                console.warn('Script response content-type not javascript, skipping execution:', src, ct);
                                                return resolve();
                                            }

                                            return resp.text().then(function (text) {
                                                // Basic sanity: if response contains '<!DOCTYPE' or '<html' it's not JS
                                                var bodySample = (text || '').trim().slice(0, 200).toLowerCase();
                                                if (!text || bodySample.indexOf('<!doctype') !== -1 || bodySample.indexOf('<html') !== -1) {
                                                    console.warn('Script appears to be HTML or empty; skipping:', src);
                                                    return resolve();
                                                }

                                                try {
                                                    var blob = new Blob([text], { type: 'application/javascript' });
                                                    var url = URL.createObjectURL(blob);
                                                    var s = document.createElement('script');
                                                    s.src = url; s.async = false;
                                                    s.onload = function () { try { URL.revokeObjectURL(url); } catch (e) {} ; resolve(); };
                                                    s.onerror = function () { try { URL.revokeObjectURL(url); } catch (e) {} ; console.error('Failed executing script blob:', src); resolve(); };
                                                    document.body.appendChild(s);
                                                } catch (e) {
                                                    console.error('Error creating blob for script', src, e);
                                                    // fallback to tag append
                                                    var s2 = document.createElement('script');
                                                    s2.src = src; s2.async = false;
                                                    s2.onload = resolve;
                                                    s2.onerror = function () { console.error('Failed to load script (fallback append): ' + src); resolve(); };
                                                    document.body.appendChild(s2);
                                                }
                                            }).catch(function (err) {
                                                console.warn('Error reading script response, appending tag fallback:', src, err);
                                                var s = document.createElement('script');
                                                s.src = src; s.async = false;
                                                s.onload = resolve;
                                                s.onerror = function () { console.error('Failed to load script (fallback after read error): ' + src); resolve(); };
                                                document.body.appendChild(s);
                                            });
                                        }).catch(function (err) {
                                            // Network/CORS error; fallback to tag so browser can attempt loading
                                            console.warn('Fetch for script failed (network/CORS), appending tag fallback:', src, err);
                                            var s = document.createElement('script');
                                            s.src = src; s.async = false;
                                            s.onload = resolve;
                                            s.onerror = function () { console.error('Failed to load script (tag fallback after fetch error): ' + src); resolve(); };
                                            document.body.appendChild(s);
                                        });
                                    });
                                });
                            }, Promise.resolve());
                        }

                        loadExternalSequentially(externalScripts).then(function () {
                            inlineScripts.forEach(function (oldScript) {
                                try {
                                    var s = document.createElement('script');
                                    if (oldScript.type) s.type = oldScript.type;
                                    var code = oldScript.textContent || oldScript.innerText || '';
                                    if (!code || code.trim().length === 0) return;
                                    // Basic sanity check: skip if looks like HTML
                                    var sample = code.trim().slice(0, 200).toLowerCase();
                                    if (sample.indexOf('<!doctype') !== -1 || sample.indexOf('<html') !== -1) {
                                        console.warn('Skipping inline script that appears to contain HTML from partial.');
                                        return;
                                    }
                                    // Append as text node to avoid issues with s.text assignment in some browsers
                                    s.appendChild(document.createTextNode(code));
                                    document.body.appendChild(s);
                                    // Optionally remove to avoid clutter
                                    try { document.body.removeChild(s); } catch (e) { /* ignore */ }
                                } catch (e) {
                                    console.error('Error executing inline script from partial:', e);
                                }
                            });
                        });
                    })
                    .catch(function (err) {
                        console.error('Error cargando UsersMapPartial:', err);
                        var root = document.getElementById('usersMapRoot');
                        if (root) root.textContent = 'Error al cargar el mapa.';
                    });
            })();
        </script>
    </section>

    <!-- Populares -->
    <section class="row-small" aria-label="Populares">
        <div class="section-title">Populares</div>
        <div class="items-container featured-1043">
            <partial name="~/Pages/Shared/_BlogItems.cshtml" model="Model.Featured1043?.Take(3)" />
        </div>
    </section>


</main>

@section Scripts {
    <!-- Load more de BlogMore -->
    <script>
        (function () {
            var page = 0;
            var pageSize = 3;
            var btn = document.getElementById('loadMoreBtn');
            var container = document.getElementById('moreItemsContainer');
            if (!btn || !container) return;

            function loadMore() {
                page++;

                var url = '@Url.Page("/Home/BlogMore")' +
                          '?PageNumber=' + encodeURIComponent(page) +
                          '&PageSize=' + encodeURIComponent(pageSize);

                btn.disabled = true;
                btn.textContent = 'Cargando…';

                fetch(url, { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('HTTP ' + r.status);

                        var totalCountHeader = r.headers.get('X-Total-Count');
                        var totalCount = totalCountHeader ? parseInt(totalCountHeader, 10) : NaN;

                        return r.text().then(function (html) {
                            return { html: html, totalCount: totalCount };
                        });
                    })
                    .then(function (result) {
                        if (!result.html) {
                            btn.style.display = 'none';
                            return;
                        }

                        var temp = document.createElement('div');
                        temp.innerHTML = result.html;

                        Array.prototype.forEach.call(temp.children, function (child) {
                            container.appendChild(child);
                        });

                        if (!isNaN(result.totalCount)) {
                            if ((page * pageSize) >= result.totalCount) {
                                btn.style.display = 'none';
                            }
                        }
                    })
                    .catch(function (err) {
                        console.error('Error cargando más contenidos:', err);
                    })
                    .finally(function () {
                        if (btn.style.display !== 'none') {
                            btn.disabled = false;
                            btn.textContent = 'Ver más contenidos';
                        }
                    });
            }

            // primera tanda automática
            loadMore();
            btn.addEventListener('click', loadMore);
        })();
    </script>

    <!-- Comportamiento del botón "+ Más" en cada card (ContentMeta) -->
    <script>
        (function () {
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-blog-more');
                if (!btn) return;

                e.preventDefault();

                var card = btn.closest('.blog-card');
                if (!card) return;

                var panel = card.querySelector('.more-panel');
                if (!panel) return;

                var metaUrl = btn.getAttribute('data-meta-url') || panel.getAttribute('data-meta-url');
                if (!metaUrl) return;

                if (panel.style.display === 'block') {
                    panel.style.display = 'none';
                    panel.setAttribute('aria-hidden', 'true');
                    btn.textContent = '+ Más';
                    return;
                }

                if (panel.getAttribute('data-loaded') === 'true') {
                    panel.style.display = 'block';
                    panel.setAttribute('aria-hidden', 'false');
                    btn.textContent = '− Menos';
                    return;
                }

                btn.disabled = true;
                btn.textContent = 'Cargando…';

                fetch(metaUrl, { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        panel.innerHTML = html;
                        panel.style.display = 'block';
                        panel.setAttribute('aria-hidden', 'false');
                        panel.setAttribute('data-loaded', 'true');
                        btn.textContent = '− Menos';
                    })
                    .catch(function (err) {
                        console.error('Error cargando ContentMeta:', err);
                        btn.textContent = '+ Más';
                    })
                    .finally(function () {
                        btn.disabled = false;
                    });
            });
        })();
    </script>
}