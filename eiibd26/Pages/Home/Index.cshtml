@page
@model eiibd26.Pages.Home.IndexModel
@using System.Linq
@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        /* Hero */
        .home-hero {
            padding: 60px 0 40px;
            text-align: center;
        }

            .home-hero h1 {
                font-size: 3rem;
                margin-bottom: .6rem;
                font-weight: 700;
            }

            .home-hero p.lead {
                color: #6b7280;
                max-width: 760px;
                margin: 0 auto 1rem;
            }

        /* Container widths */
        .row-small,
        .blog-list {
            max-width: 1140px;
            margin: 0 auto 24px;
            padding: 0 8px;
        }

        /* Grid de items: 3 columnas en desktop */
        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
        }

            /* Featured specific containers (visual separation if needed) */
            .items-container.featured-1042,
            .items-container.featured-1043 {
                margin-bottom: 8px;
            }

        /* Card vertical (imagen arriba, contenido abajo) */
        .blog-card {
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #eef2f7;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(16,24,40,0.04);
            min-height: 100%;
        }

            .blog-card .thumb {
                width: 100%;
                height: 180px;
                background: #f3f6fa;
                overflow: hidden;
                display: block;
            }

                .blog-card .thumb img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

            .blog-card .content {
                padding: 16px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 12px;
            }

        .blog-meta {
            font-size: .82rem;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .blog-title {
            font-size: 1.05rem;
            margin: 6px 0;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.2;
        }

        .blog-excerpt {
            color: #6b7280;
            line-height: 1.5;
            flex: 1 1 auto;
            font-size: .95rem;
        }

        .blog-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 6px;
            font-size: .9rem;
        }

        .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #334155;
        }

            .author .avatar {
                width: 32px;
                height: 32px;
                border-radius: 999px;
                background: #e6eef9;
                overflow: hidden;
                flex: 0 0 32px;
            }

                .author .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }

        /* Responsive: 2 columns en tablet, 1 en móvil */
        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }

            .blog-card .thumb {
                height: 220px;
            }
        }

        .section-title {
            margin: 24px 0 12px;
            font-size: 1.25rem;
            font-weight: 600;
            color: #172849;
        }

        /* Map root */
        #usersMapRoot {
            /* background: #fff;
            border: 1px solid #eef2f7; */
            border-radius: 8px;
            padding: 12px;
            min-height: 220px;
        }
    </style>
}

<main>
    <section class="home-hero">
        @* Hero partial *@
        <partial name="~/Pages/Shared/HeroPartial.cshtml" model="Model.Hero" />
    </section>

    <!-- MAP PARTIAL INSERTION -->
    <section class="row-small" aria-label="Mapa de usuarios">
        <div id="usersMapRoot">Cargando mapa…</div>

        <script>
            (function () {
                // Fetch the partial (this executes UsersMapPartialModel.OnGetAsync)
                fetch('@Url.Page("/Home/UsersMapPartial")', { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('Error fetching UsersMapPartial: ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        var root = document.getElementById('usersMapRoot');
                        if (!root) return;
                        var temp = document.createElement('div');
                        temp.innerHTML = html;

                        var scripts = Array.prototype.slice.call(temp.querySelectorAll('script'));
                        var externalScripts = scripts.filter(function (s) { return s.src && s.src.trim().length > 0; });
                        var inlineScripts = scripts.filter(function (s) { return !s.src || s.src.trim().length === 0; });

                        scripts.forEach(function (s) { if (s.parentNode) s.parentNode.removeChild(s); });

                        root.innerHTML = temp.innerHTML;

                        function loadExternalSequentially(sources) {
                            return sources.reduce(function (prev, scriptTag) {
                                return prev.then(function () {
                                    return new Promise(function (resolve) {
                                        var s = document.createElement('script');
                                        s.src = scriptTag.src;
                                        s.async = false;
                                        s.onload = function () { resolve(); };
                                        s.onerror = function () {
                                            console.error('Failed to load script: ' + scriptTag.src);
                                            resolve();
                                        };
                                        document.body.appendChild(s);
                                    });
                                });
                            }, Promise.resolve());
                        }

                        loadExternalSequentially(externalScripts).then(function () {
                            inlineScripts.forEach(function (oldScript) {
                                try {
                                    var s = document.createElement('script');
                                    if (oldScript.type) s.type = oldScript.type;
                                    s.text = oldScript.textContent || oldScript.innerText || '';
                                    document.body.appendChild(s);
                                    document.body.removeChild(s);
                                } catch (e) {
                                    console.error('Error executing inline script from partial:', e);
                                }
                            });
                        });
                    })
                    .catch(function (err) {
                        console.error('Error cargando UsersMapPartial:', err);
                        var root = document.getElementById('usersMapRoot');
                        if (root) root.textContent = 'Error al cargar el mapa.';
                    });
            })();
        </script>
    </section>
    <!-- END MAP PARTIAL INSERTION -->
    <!-- Featured for category 1042 (Top 3) -->
    <section class="row-small" aria-label="Destacados">
        <div class="section-title">Destacados (1042)</div>
        <div class="items-container featured-1042">
            @* Force at most 3 in the view as defense-in-depth *@
            <partial name="~/Pages/Shared/_BlogItems.cshtml" model="Model.Featured1042?.Take(3)" />
        </div>
    </section>

    <!-- Featured for category 1043 (Top 3) -->
    <section class="row-small" aria-label="Populares">
        <div class="section-title">Destacados (1043)</div>
        <div class="items-container featured-1043">
            @* Force at most 3 in the view as defense-in-depth *@
            <partial name="~/Pages/Shared/_BlogItems.cshtml" model="Model.Featured1043?.Take(3)" />
        </div>
    </section>
</main>

@section Scripts {
    <script>
        // No load-more script here anymore (we only show the two featured rows + map)
    </script>
}