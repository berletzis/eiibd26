@page
@model eiibd26.Pages.Home.UsersMapPartialModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null; // partial must not render the site layout
}

<link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500" />

<style>
    .section-title {
        font-size: var(--eii-text-2xl);
        font-weight: 300;
        letter-spacing: -0.04em;
        color: var(--eii-text-heading);
        padding-bottom: var(--eii-space-5);
        line-height: 1.2;
    }

    .users-map-root {
        max-width: 1340px;
        margin: 0 auto var(--eii-space-6);
    }

    .users-map-controls {
        background: var(--eii-surface);
        border: 1px solid var(--eii-border);
        border-radius: 0.5rem;
        padding: var(--eii-space-3) var(--eii-space-4);
        margin-bottom: var(--eii-space-4);
        display: flex;
        gap: var(--eii-space-4);
        align-items: center;
        flex-wrap: wrap;
    }

    .ums-left {
        min-width: 220px;
        flex: 1 1 320px;
        margin-bottom: 0;
        padding-bottom: var(--eii-space-4);
    }

        /* Etiquetas con tipografía estándar */
        .ums-left h4 {
            margin: 0 0 var(--eii-space-2) 0;
            font-size: var(--eii-text-lg);
            color: var(--eii-text);
            font-weight: var(--eii-fw-semibold);
            font-family: var(--eii-font);
            line-height: 1.2;
        }

        .ums-left label {
            display: block;
            margin-bottom: var(--eii-space-2);
            color: var(--eii-text);
            font-size: var(--eii-text-sm);
            font-family: var(--eii-font);
            font-weight: 500;
        }

    .ums-country-row {
        display: flex;
        gap: var(--eii-space-3);
        align-items: center;
    }

        /* Select con tipografía estándar */
        .ums-country-row select.form-select {
            flex: 1 1 auto;
            padding: var(--eii-space-3) var(--eii-space-4);
            border-radius: 0.375rem;
            border: 1px solid var(--eii-border);
            background: var(--eii-surface);
            font-family: var(--eii-font);
            font-size: var(--eii-text-base);
            font-weight: 400;
            color: var(--eii-text);
            line-height: 1.5;
            margin-bottom: 0;
            transition: all 0.2s ease;
        }

            .ums-country-row select.form-select:focus {
                outline: 2px solid var(--eii-primary);
                outline-offset: 2px;
            }

    .ums-actions {
        display: flex;
        gap: var(--eii-space-3);
        align-items: center;
    }

    /* Contador con tipografía estándar */
    .ums-count {
        color: var(--eii-text-soft);
        font-size: var(--eii-text-sm);
        font-family: var(--eii-font);
        font-weight: 400;
    }

    .users-map-canvas {
        width: 100%;
        min-height: 420px;
        height: 560px;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid var(--eii-border);
        margin-top: 0;
    }

    @@media (max-width: 991.98px) {
        .users-map-controls {
            flex-direction: column;
            align-items: stretch;
            padding: var(--eii-space-3);
            gap: var(--eii-space-3);
            margin-bottom: var(--eii-space-3);
        }

        .ums-left {
            flex: 1 1 100%;
            min-width: auto;
            margin-bottom: 0;
        }

        .ums-country-row {
            gap: var(--eii-space-2);
            align-items: center;
        }

            .ums-country-row select.form-select {
                width: 100%;
                margin-bottom: 0;
            }

        .ums-actions {
            justify-content: flex-start;
            margin-top: 0;
        }

        .users-map-canvas {
            height: 360px;
        }
    }
</style>

<div class="users-map-root">
    <h2 class="section-title">Comunidad</h2>
    <div class="users-map-controls" role="region" aria-label="Controles del mapa">
        <div class="ums-left" aria-label="Filtro por país">
            <label><span id="ums_count"><b>0</b> ubicaciones de usuarios registrados</span></label>
            <div class="ums-country-row">
                <label class="visually-hidden" for="ums_country">Selecciona tu País</label>
                <select id="ums_country" class="form-select" aria-label="Selecciona tu País">
                    <option value="">---Selecciona tu país---</option>
                    @* IMPORTANT: add data-name with the country display name (without code) to avoid parsing option text *@
                    @foreach (var c in Model.Countries)
                    {
                        <option value="@c.Code" data-name="@c.Name">@c.Name (@c.Code)</option>
                    }
                </select>
            </div>
        </div>

        <div class="ums-actions" aria-hidden="true"></div>
    </div>
</div>
<div id="ums_map" class="users-map-canvas" role="application" aria-label="Mapa de usuarios"></div>
<!-- Google Maps JS API -->
<script src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]"></script>
@* MarkerClusterer URL contains '@' — emit it via Html.Raw so Razor no lo interprete *@
@Html.Raw("<script src=\"https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js\"></script>")

<script>
    (function () {
        const profiles = @Html.Raw(Model.ProfilesJson ?? "[]");
        const mapEl = document.getElementById('ums_map');
        const countrySel = document.getElementById('ums_country');
        const countEl = document.getElementById('ums_count');
        if (!mapEl) return;

        const MIN_ZOOM = 2;
        const MAX_ZOOM = 8;
        const MAX_ZOOM_CLUSTER_CLICK = 7;
        const JITTER_MAX_DEG = 0.02;

        let geocoder = new google.maps.Geocoder();
        const map = new google.maps.Map(mapEl, {
            center: { lat: 20, lng: 0 }, zoom: 2, minZoom: MIN_ZOOM, maxZoom: MAX_ZOOM,
            mapTypeControl: false, streetViewControl: false, fullscreenControl: true,
            clickableIcons: false, disableDoubleClickZoom: true
        });

        function jitterCoord(lat, lng) {
            const f = JITTER_MAX_DEG;
            return { lat: lat + (Math.random() - 0.5) * f, lng: lng + (Math.random() - 0.5) * f };
        }

        function smallMarkerSvgDataUrl(size = 14, label = '') {
            const stroke = 2;
            const cx = size/2, cy = size/2, r = Math.max(4, Math.round((size - stroke*2)/2));
            const fill = '#6a4e7a';
            const strokeColor = '#ffffff';
            let textSvg = '';
            if (label !== null && String(label).length) {
                const fontSize = Math.max(8, Math.round(size * 0.5));
                textSvg = `<text x="50%" y="50%" font-size="${fontSize}" fill="#fff" text-anchor="middle" dominant-baseline="central" font-family="Arial, sans-serif">${String(label)}</text>`;
            }
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${cx}" cy="${cy}" r="${r}" fill="${fill}" stroke="${strokeColor}" stroke-width="${stroke}" />${textSvg}</svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }

        function createClusterSvg(count, size) {
            const strokeFactor = 0.04, fontFactor = 0.34;
            const stroke = Math.max(1, Math.round(size * strokeFactor));
            const radius = (size - stroke * 2) / 2;
            const cx = size/2, cy = size/2;
            const fill = '#6a4e7a', strokeColor = '#ffffff';
            const fontSize = Math.max(10, Math.round(size * fontFactor));
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><circle cx="${cx}" cy="${cy}" r="${radius}" fill="${fill}" stroke="${strokeColor}" stroke-width="${stroke}" /><text x="50%" y="50%" font-size="${fontSize}" fill="#fff" text-anchor="middle" dominant-baseline="central" font-family="Arial, sans-serif">${count}</text></svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }

        function sizeForCount(count) {
            const min = 30, max = 76;
            if (count <= 1) return 32;
            const t = Math.min(1, Math.log10(count) / 3);
            return Math.round(min + (max - min) * t);
        }

        const renderer = {
            render({ count, position }) {
                const size = sizeForCount(count);
                const svg = createClusterSvg(count || 0, size);
                return new google.maps.Marker({
                    position,
                    icon: { url: svg, scaledSize: new google.maps.Size(size, size) },
                    zIndex: Number(google.maps.Marker.MAX_ZINDEX) + count
                });
            }
        };

        let MarkerClustererCtor = window.MarkerClusterer || (window.markerClusterer && window.markerClusterer.MarkerClusterer) || (window.markerclusterer && window.markerclusterer.MarkerClusterer) || null;
        if (!MarkerClustererCtor && window.markerClusterer && window.markerClusterer.default) MarkerClustererCtor = window.markerClusterer.default;
        if (!MarkerClustererCtor && window.markerclusterer && window.markerclusterer.default) MarkerClustererCtor = window.markerclusterer.default;

        let clusterer = null;
        if (MarkerClustererCtor) {
            try { clusterer = new MarkerClustererCtor({ map, renderer }); }
            catch (e) { console.warn('clusterer ctor failed:', e); clusterer = null; }
        } else {
            console.warn('MarkerClusterer constructor not found — using fallback markers');
        }

        // Create markers from profiles
        const markers = profiles.map(p => {
            const lat = Number(p.lat), lng = Number(p.lng);
            const pos = isFinite(lat) && isFinite(lng) ? jitterCoord(lat, lng) : { lat: 0, lng: 0 };
            const iconUrl = smallMarkerSvgDataUrl(14, '1'); // show "1" inside single circle
            const m = new google.maps.Marker({ position: pos, title: p.name, icon: { url: iconUrl, scaledSize: new google.maps.Size(14, 14) } });
            m._umsInfo = p;
            return m;
        });

        // fallback visible markers if clusterer absent
        let visibleFallbackMarkers = [];
        function showFallbackMarkers(list) {
            visibleFallbackMarkers.forEach(vm => vm.setMap(null));
            visibleFallbackMarkers = [];
            const iconUrl = smallMarkerSvgDataUrl(18, '1');
            list.forEach(mProto => {
                const vm = new google.maps.Marker({
                    position: mProto.getPosition(), map, title: mProto.getTitle(),
                    icon: { url: iconUrl, scaledSize: new google.maps.Size(18, 18) }
                });
                vm._umsInfo = mProto._umsInfo;
                vm.addListener('click', function() {
                    const p = vm._umsInfo || {};
                    const infoHtml = `<div style="min-width:200px;font-family:Roboto,Arial,sans-serif"><div style="font-weight:700;margin-bottom:6px;">${escapeHtml(p.name)}</div><div style="color:#6b7280;font-size:.9rem;">${escapeHtml(p.country || '')}</div></div>`;
                    new google.maps.InfoWindow({ content: infoHtml }).open(map, vm);
                });
                visibleFallbackMarkers.push(vm);
            });
        }

        // attach click info window to markers
        markers.forEach(m => {
            m.addListener('click', function() {
                const p = m._umsInfo || {};
                const infoHtml = `<div style="min-width:200px;font-family:Roboto,Arial,sans-serif"><div style="font-weight:700;margin-bottom:6px;">${escapeHtml(p.name)}</div><div style="color:#6b7280;font-size:.9rem;">${escapeHtml(p.country || '')}</div></div>`;
                new google.maps.InfoWindow({ content: infoHtml }).open(map, m);
            });
        });

        // Keep track of currently visible markers for count
        let currentVisibleMarkers = [];

        function updateCount() {
            const count = currentVisibleMarkers.length;
            if (countEl) countEl.innerHTML = `Mostrando <b>${count}</b> ubicaciones de usuarios registrados`;
        }

        // applyFilter: show only markers matching selected country (use data-name attribute to avoid option text noise)
        function applyFilter() {
            const code = (countrySel.value || '').trim().toUpperCase();
            const selName = (countrySel.selectedOptions[0]?.dataset?.name || '').toLowerCase(); // clean name only
            // Debug helper: will collect any matches that don't look right
            const unexpected = [];

            const visible = markers.filter(m => {
                const p = m._umsInfo || {};
                const mcode = (p.countryCode || '').toString().toUpperCase(); // prefer explicit countryCode if provided by server
                const mcountry = (p.country || '').toString().toLowerCase();

                if (!code) return true; // no filter -> all

                // 1) exact country code match (most reliable)
                if (mcode && mcode === code) return true;

                // 2) match by country name (use selName, which is just the display name)
                if (selName && mcountry && mcountry.indexOf(selName) !== -1) return true;

                // otherwise not a match
                // collect for debug if it was included by some other logic later
                return false;
            });

            // Debugging: log markers that would be included but don't match by code/name (should be none)
            // (This helps spot entries with missing/incorrect countryCode or country fields)
            markers.forEach(m => {
                const p = m._umsInfo || {};
                const mcode = (p.countryCode || '').toString().toUpperCase();
                const mcountry = (p.country || '').toString().toLowerCase();
                const included = visible.indexOf(m) !== -1;
                if (included && code) {
                    const byCode = mcode && mcode === code;
                    const byName = selName && mcountry && mcountry.indexOf(selName) !== -1;
                    if (!byCode && !byName) {
                        unexpected.push({ id: p.id || p.idUser || null, name: p.name, country: p.country, countryCode: p.countryCode, lat: p.lat, lng: p.lng });
                    }
                }
            });
            if (unexpected.length) {
                console.warn('Unexpected markers included for country filter', code, selName, unexpected);
            }

            // clear previous display
            if (clusterer && typeof clusterer.clearMarkers === 'function') clusterer.clearMarkers();
            else if (visibleFallbackMarkers.length) { visibleFallbackMarkers.forEach(vm => vm.setMap(null)); visibleFallbackMarkers = []; }

            if (visible.length) {
                if (clusterer && typeof clusterer.addMarkers === 'function') clusterer.addMarkers(visible);
                else showFallbackMarkers(visible);

                currentVisibleMarkers = visible.slice();
                const bounds = new google.maps.LatLngBounds();
                visible.forEach(m => bounds.extend(m.getPosition()));
                map.fitBounds(bounds);
                google.maps.event.addListenerOnce(map, 'idle', function() {
                    if (map.getZoom() > MAX_ZOOM_CLUSTER_CLICK) map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                });
            } else {
                // if no visible markers, center on the country selected (use selName for geocoding)
                if (code || selName) {
                    const textToUse = selName || code;
                    geocoder.geocode({ address: textToUse }, function(results, status) {
                        if (status === 'OK' && results && results[0]) {
                            const r = results[0];
                            const bounds = r.geometry && (r.geometry.bounds || r.geometry.viewport) ? (r.geometry.bounds || r.geometry.viewport) : null;
                            if (bounds) {
                                map.fitBounds(bounds);
                                google.maps.event.addListenerOnce(map, 'idle', function() {
                                    if (map.getZoom() > MAX_ZOOM_CLUSTER_CLICK) map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                                });
                            } else if (r.geometry && r.geometry.location) {
                                map.setCenter(r.geometry.location);
                                map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
                            }
                        } else {
                            // no geocode result: show everything (fallback)
                            if (clusterer && typeof clusterer.addMarkers === 'function') clusterer.addMarkers(markers);
                            else showFallbackMarkers(markers);
                            currentVisibleMarkers = markers.slice();
                            map.setCenter({ lat: 20, lng: 0 });
                            map.setZoom(2);
                        }
                    });
                } else {
                    // no selection: show all
                    if (clusterer && typeof clusterer.addMarkers === 'function') clusterer.addMarkers(markers);
                    else showFallbackMarkers(markers);
                    currentVisibleMarkers = markers.slice();
                    const bounds = new google.maps.LatLngBounds();
                    markers.forEach(m => bounds.extend(m.getPosition()));
                    try { map.fitBounds(bounds); } catch (e) { map.setCenter({ lat: 20, lng: 0 }); map.setZoom(2); }
                }
            }

            updateCount();
        }

        // wire change event
        countrySel.addEventListener('change', applyFilter);

        // initial population (show all)
        if (clusterer && typeof clusterer.addMarkers === 'function') clusterer.addMarkers(markers);
        else showFallbackMarkers(markers);

        currentVisibleMarkers = markers.slice();
        updateCount();

        if (markers.length) {
            const bounds = new google.maps.LatLngBounds();
            markers.forEach(m => bounds.extend(m.getPosition()));
            map.fitBounds(bounds);
            google.maps.event.addListenerOnce(map, 'idle', function() {
                if (map.getZoom() > MAX_ZOOM_CLUSTER_CLICK) map.setZoom(MAX_ZOOM_CLUSTER_CLICK);
            });
        }

        function escapeHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>"'`=\/]/g, function (c) {
                return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#47;','`':'&#96;','=':'&#61;'}[c];
            });
        }
    })();
</script>