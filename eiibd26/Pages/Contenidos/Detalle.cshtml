@page "{slug?}"
@model eiibd26.Pages.Contenidos.DetalleModel
@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions;
@using eiibd26.Services.Validacion

@{
    ViewData["Title"] = (Model.Item?.Title != null ? Model.Item.Title + " - #HazViralLoQueImporta" : "Contenido");

    // Determine site root (map localhost to production domain for rendered structured data)
    var siteRoot = (Request.Host.HasValue && Request.Host.Value.IndexOf("localhost", StringComparison.OrdinalIgnoreCase) >= 0)
        ? "https://eiibd.com"
        : $"{Request.Scheme}://{Request.Host.Value}";

    // ===== FUNCIÓN PARA RESOLVER AVATAR (IGUAL QUE EN PREGUNTAS) =====
    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        avatar = avatar.Replace("\\", "/").Trim();
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("~/")) avatar = avatar.TrimStart('~', '/');
        if (avatar.StartsWith("/")) avatar = avatar.TrimStart('/');
        return Url.Content("~/" + avatar);
    }

    // Build share URL using the SEO path when available (Model.SeoUrl expected to be like "/categoria/slug")
    // Fallback to the current request URL if SeoUrl is null/empty.
    string seoPath = Model?.SeoUrl ?? string.Empty;
    string shareUrl;
    var seoRaw = (Model?.SeoUrl ?? "").Trim();

    if (!string.IsNullOrEmpty(seoRaw))
    {
        // Si es absoluta (http:// o https://) la usamos tal cual
        if (Uri.IsWellFormedUriString(seoRaw, UriKind.Absolute))
        {
            // If absolute but points to localhost, rewrite host to canonical siteRoot
            try {
                var u = new Uri(seoRaw);
                if (u.Host.IndexOf("localhost", StringComparison.OrdinalIgnoreCase) >= 0) {
                    shareUrl = siteRoot.TrimEnd('/') + u.PathAndQuery;
                } else {
                    shareUrl = seoRaw;
                }
            } catch { shareUrl = seoRaw; }
        }
        else
        {
            // Si es relativa (ej. "/categoria/slug" o "categoria/slug") la normalizamos y la hacemos absoluta
            var path = seoRaw.StartsWith("/") ? seoRaw : "/" + seoRaw;
            shareUrl = siteRoot.TrimEnd('/') + path;
        }
    }
    else
    {
        // Fallback a la URL actual de la petición
        // Use siteRoot + request path to avoid localhost in rendered outputs
        try {
            var req = HttpContext.Request;
            shareUrl = siteRoot.TrimEnd('/') + req.Path + req.QueryString;
        } catch {
            shareUrl = HttpContext.Request.GetDisplayUrl();
        }
    }

    var shareTitle = Model?.Item?.Title ?? (ViewData["Title"]?.ToString() ?? "Contenido");
    var shareImage = !string.IsNullOrWhiteSpace(Model?.Item?.ImageUrl)
        ? (Model.Item.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? (Model.Item.ImageUrl.IndexOf("localhost", StringComparison.OrdinalIgnoreCase) >= 0 ? siteRoot.TrimEnd('/') + new Uri(Model.Item.ImageUrl).PathAndQuery : Model.Item.ImageUrl)
            : siteRoot.TrimEnd('/') + (Model.Item.ImageUrl.StartsWith("/") ? Model.Item.ImageUrl : "/" + Model.Item.ImageUrl))
        : null;

    // Serializamos para JS (si lo usas)
    var shareUrlJson = System.Text.Json.JsonSerializer.Serialize(shareUrl);
    var shareTitleJson = System.Text.Json.JsonSerializer.Serialize(shareTitle);
}


<!-- Open Graph / Twitter meta tags for better sharing -->
@if (!string.IsNullOrWhiteSpace(shareUrl))
{
    <link rel="canonical" href="@shareUrl" />
    <meta property="og:url" content="@shareUrl" />
    <meta property="og:title" content="@shareTitle" />
    @if (!string.IsNullOrWhiteSpace(shareImage))
    {
        <meta property="og:image" content="@shareImage" />
    }
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@shareTitle" />
    @if (!string.IsNullOrWhiteSpace(shareImage))
    {
        <meta name="twitter:image" content="@shareImage" />
    }
}

@section Head {
    @if (Model.Item != null)
    {
        // Determine if this is the 'Recién diagnosticado' article (slug or title heuristics)
        var isRecien = false;
        try {
            isRecien = (!string.IsNullOrWhiteSpace(Model.Item.Slug) && Model.Item.Slug.Equals("recien-diagnosticado", System.StringComparison.OrdinalIgnoreCase))
                      || (!string.IsNullOrWhiteSpace(Model.Item.Title) && (Model.Item.Title.IndexOf("Reci", System.StringComparison.OrdinalIgnoreCase) >= 0 || Model.Item.Title.IndexOf("Recien", System.StringComparison.OrdinalIgnoreCase) >= 0));
        } catch { isRecien = false; }

        var ldOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

        // Always emit a BreadcrumbList JSON-LD derived from available category crumbs (fallback to Contenidos)
        var itemList = new System.Collections.Generic.List<object>();
        int pos = 1;
        // Home
        itemList.Add(new System.Collections.Generic.Dictionary<string, object> {
            ["@type"] = "ListItem",
            ["position"] = pos++,
            ["name"] = "EIIBD",
            ["item"] = siteRoot.TrimEnd('/') + "/"
        });

        // Info y Ayuda (recommended parent for this section)
        itemList.Add(new System.Collections.Generic.Dictionary<string, object> {
            ["@type"] = "ListItem",
            ["position"] = pos++,
            ["name"] = "Info y Ayuda",
            ["item"] = siteRoot.TrimEnd('/') + "/info-y-ayuda"
        });

        // Category crumbs (if any) - avoid duplicating the "Info y Ayuda" level
        if (Model.CategoryCrumbs != null && Model.CategoryCrumbs.Any())
        {
            foreach (var c in Model.CategoryCrumbs)
            {
                try {
                    var title = (c.Title ?? "").Trim();
                    if (string.IsNullOrWhiteSpace(title)) continue;
                    // Skip if it duplicates the generic Info y Ayuda level
                    if (title.Equals("Info y Ayuda", System.StringComparison.OrdinalIgnoreCase)) continue;
                    if (title.Equals("Recién diagnosticado", System.StringComparison.OrdinalIgnoreCase) || title.Equals("Recien diagnosticado", System.StringComparison.OrdinalIgnoreCase)) continue;

                    var urlPart = (c.Url ?? "").Trim();
                    if (string.IsNullOrWhiteSpace(urlPart)) continue;
                    var href = siteRoot.TrimEnd('/') + (urlPart.StartsWith("/") ? urlPart : "/" + urlPart);
                    itemList.Add(new System.Collections.Generic.Dictionary<string, object> {
                        ["@type"] = "ListItem",
                        ["position"] = pos++,
                        ["name"] = title,
                        ["item"] = href
                    });
                } catch { }
            }
        }

        // If this article belongs to the "Recién diagnosticado" section, insert a dedicated section item
        if (isRecien)
        {
            var sectionUrl = siteRoot.TrimEnd('/') + "/info-y-ayuda/recien-diagnosticado";
            itemList.Add(new System.Collections.Generic.Dictionary<string, object> {
                ["@type"] = "ListItem",
                ["position"] = pos++,
                ["name"] = "Recién diagnosticado",
                ["item"] = sectionUrl
            });
        }

        // Current page as last item - ensure absolute and not pointing to localhost
        string currentUrl;
        if (!string.IsNullOrWhiteSpace(Model.SeoUrl))
        {
            var seo = Model.SeoUrl.Trim();
            if (Uri.IsWellFormedUriString(seo, UriKind.Absolute))
            {
                try {
                    var u = new Uri(seo);
                    if (u.Host.IndexOf("localhost", System.StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        currentUrl = siteRoot.TrimEnd('/') + u.PathAndQuery;
                    }
                    else
                    {
                        currentUrl = seo;
                    }
                } catch { currentUrl = seo; }
            }
            else
            {
                currentUrl = siteRoot.TrimEnd('/') + (seo.StartsWith("/") ? seo : "/" + seo);
            }
        }
        else
        {
            try {
                var req = HttpContext.Request;
                currentUrl = siteRoot.TrimEnd('/') + req.Path + req.QueryString;
            } catch { currentUrl = HttpContext.Request.GetDisplayUrl(); }
        }

        itemList.Add(new System.Collections.Generic.Dictionary<string, object> {
            ["@type"] = "ListItem",
            ["position"] = pos++,
            ["name"] = Model.Item.Title ?? "",
            ["item"] = currentUrl
        });

        var bc = new System.Collections.Generic.Dictionary<string, object> {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = itemList
        };

        var bcJson = System.Text.Json.JsonSerializer.Serialize(bc, ldOptions);
        <text>
            <script type="application/ld+json">
                @Html.Raw(bcJson)
            </script>
        </text>

        if (isRecien)
        {
            // Emit MedicalWebPage JSON-LD using the values requested and enhanced for YMYL
            var medAuthorName = !string.IsNullOrWhiteSpace(Model.Item?.Author) ? Model.Item.Author : "Autor";
            var medAuthorUrl = !string.IsNullOrWhiteSpace(Model.Item?.AuthorSlug)
                ? siteRoot.TrimEnd('/') + "/u/" + Model.Item.AuthorSlug
                : (Model.Item?.AuthorId != null ? siteRoot.TrimEnd('/') + "/u/" + Model.Item.AuthorId.ToString() : null);

            var med = new System.Collections.Generic.Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "MedicalWebPage",
                ["name"] = "Guía para el Recién Diagnosticado con EII",
                ["description"] = "Recibir un diagnóstico de Crohn o Colitis Ulcerosa es difícil. Aquí te explicamos los primeros pasos, tratamientos y cómo manejar el impacto emocional.",
                ["medicalAudience"] = "Patient",
                ["relevantSpecialty"] = new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "MedicalSpecialty", ["name"] = "Gastroenterology" },
                ["lastReviewed"] = "2026-02-13",
                ["isAccessibleForFree"] = true,
                ["inLanguage"] = "es-ES",
                ["mainContentOfPage"] = new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "WebPageElement", ["cssSelector"] = ".contenido-html" },
                ["author"] = (medAuthorUrl != null)
                    ? new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "Person", ["name"] = medAuthorName, ["url"] = medAuthorUrl }
                    : new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "Person", ["name"] = medAuthorName },
                ["about"] = new System.Collections.Generic.Dictionary<string, object> {
                    ["@type"] = "MedicalCondition",
                    ["name"] = "Enfermedad Inflamatoria Intestinal",
                    ["alternateName"] = new string[] { "EII", "Crohn", "Colitis Ulcerosa" },
                    ["associatedAnatomy"] = new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "AnatomicalStructure", ["name"] = "Sistema Digestivo" }
                }
            };

            var medJson = System.Text.Json.JsonSerializer.Serialize(med, ldOptions);
            <text>
                <script type="application/ld+json">
                    @Html.Raw(medJson)
                </script>
            </text>
        }

        // --- BlogPosting JSON-LD (enhanced) ---
        try {
            var descRaw = !string.IsNullOrWhiteSpace(Model.Item.Excerpt) ? Model.Item.Excerpt : (Model.Item.ContentHtml ?? "");
            // strip tags for description fallback
            descRaw = System.Text.RegularExpressions.Regex.Replace(descRaw, "<[^>]+>", " ");
            descRaw = System.Net.WebUtility.HtmlDecode(descRaw ?? "");
            var description = descRaw.Length > 300 ? descRaw.Substring(0, 297) + "..." : descRaw;

            var imageUrlForSchema = !string.IsNullOrWhiteSpace(shareImage) ? shareImage : (siteRoot.TrimEnd('/') + "/img/logo.png");
            var authorName2 = Model.Item?.Author ?? "Autor";
            var authorUrl2 = (authorName2.IndexOf("Carlos", System.StringComparison.OrdinalIgnoreCase) >= 0) ? "https://eiibd.com/u/berletzis" : null;

            // Use clean ISO 8601 UTC timestamps without fractional seconds
            string datePublished;
            try {
                if (Model.Item != null && Model.Item.CreatedAt != default(DateTime))
                {
                    var dp = DateTime.SpecifyKind(Model.Item.CreatedAt, DateTimeKind.Utc).ToUniversalTime();
                    datePublished = dp.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
                }
                else
                {
                    datePublished = DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
                }
            } catch {
                datePublished = DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
            }

            var dateModified = DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");

            var keywordsArr = (Model.Item?.Categories != null && Model.Item.Categories.Any()) ? Model.Item.Categories.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray() : new string[0];

            var blog = new System.Collections.Generic.Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "BlogPosting",
                ["headline"] = Model.Item?.Title ?? "",
                ["description"] = description ?? "",
                ["image"] = imageUrlForSchema,
                ["mainEntityOfPage"] = currentUrl,
                ["author"] = new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "Person", ["name"] = authorName2, ["url"] = authorUrl2 ?? siteRoot.TrimEnd('/') },
                ["publisher"] = new System.Collections.Generic.Dictionary<string, object> {
                    ["@type"] = "Organization",
                    ["name"] = "EIIBD",
                    ["logo"] = new System.Collections.Generic.Dictionary<string, object> { ["@type"] = "ImageObject", ["url"] = siteRoot.TrimEnd('/') + "/img/logo.png" }
                },
                ["datePublished"] = datePublished,
                ["dateModified"] = dateModified,
                ["isAccessibleForFree"] = true,
                ["inLanguage"] = "es-ES",
                ["keywords"] = (keywordsArr.Length > 0) ? string.Join(", ", keywordsArr) : null
            };

            var blogJson = System.Text.Json.JsonSerializer.Serialize(blog, ldOptions);
            <text>
                <script type="application/ld+json">
                    @Html.Raw(blogJson)
                </script>
            </text>
        } catch { }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalle.css" asp-append-version="true" />
}

<div class="conte-detail">
@*     <div class="categories-list" aria-labelledby="left-panel-heading">
        @if (Model.Item?.Categories?.Any() == true)
        {
            foreach (var c in Model.Item.Categories)
            {
                <span class="badge-cat">@c</span>
            }
        }
        else
        {
            <div class="text-muted" style="font-size:.9rem;">Sin categorías</div>
        }
    </div> *@

    <div class="eii-page-header">
        <div class="eii-page-header__content">
            <h1 class="eii-page-title">@Model.Item?.Title</h1>
        </div>
        @* Link de edición para administradores *@
        @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
        {
            <div class="eii-page-header__actions">
                <a href="@($"/Identity/Admin/Contenidos/Detalle?id={Model.Item?.Id}")"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-sm btn-outline-warning"
                   title="Editar este contenido">
                    <i class="bi bi-pencil-square"></i> Editar Contenido
                </a>
            </div>
        }
    </div>

    @* Breadcrumb: Home -> category -> current content title *@
    <nav class="breadcrumbs" aria-label="breadcrumbs">
        <a href="@Url.Content("~/")">Inicio</a>
        @{
            var lastCat = (Model.CategoryCrumbs != null && Model.CategoryCrumbs.Count > 0) ? Model.CategoryCrumbs.Last() : null;
        }
        @if (lastCat != null)
        {
            <span class="sep">›</span>
            <a href="@(lastCat.Url ?? "/contenidos")">@lastCat.Title</a>
        }
        <span class="sep">›</span>
        <span>@Model.Item?.Title</span>
    </nav>

    <div class="detail-grid" role="main">
        <article class="content-panel" aria-labelledby="article-title">
            @if (!string.IsNullOrWhiteSpace(Model.Item?.ImageUrl))
            {
                <div class="detail-image" role="img" aria-label="@Model.Item.Title">
                    <div class="img-fallback"></div>
                    <img src="@Model.Item.ImageUrl" alt="@Model.Item.Title" loading="lazy" decoding="async" fetchpriority="low"
                         onerror="this.onerror=null;this.src='@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")';" />
                </div>
            }

            @* Meta: autor, fecha, tiempo de lectura — alineado a la derecha *@
            <div class="meta-card" role="complementary" aria-label="Meta del artículo">
                <div class="author">
                    @{
                        var authorName = Model.Item?.Author ?? "Autor";
                        var authorUrl = "";
                        if (!string.IsNullOrWhiteSpace(Model.Item?.AuthorSlug))
                        {
                            authorUrl = "/contenidos/porAutor/" + Model.Item.AuthorSlug;
                        }
                        else if (Model.Item?.AuthorId != null)
                        {
                            authorUrl = "/contenidos/autorId/" + Model.Item.AuthorId.ToString();
                        }
                        var authorImg = ResolveAvatar(Model.Item?.AuthorImageUrl);
                    }
                    <img src="@authorImg"
                         alt="@authorName"
                         loading="lazy"
                         decoding="async"
                         width="32"
                         height="32"
                         onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                    <div class="meta-byline">
                        por
                        @if (!string.IsNullOrWhiteSpace(authorUrl))
                        {
                            <a href="@authorUrl">@authorName</a>
                        }
                        else
                        {
                            @authorName
                        }
                        <span class="meta-sep">·</span>
                        <i class="bi bi-calendar"></i>
                        @if (Model.Item != null && Model.Item.CreatedAt != default(DateTime))
                        {
                            <time datetime="@Model.Item.CreatedAt.ToString("yyyy-MM-dd")">@Model.Item.CreatedAt.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</time>
                        }
                        <span class="meta-sep">·</span>
                        <i class="bi bi-clock"></i> @Model.Item?.ReadMinutes min de lectura
                    </div>
                </div>
            </div>

            @* Índice inline: visible solo en responsive *@
            <div class="article-index-inline article-index-sidebar" id="articleIndexInline" role="navigation" aria-label="Índice del artículo">
                <div class="sidebar-section-header" onclick="toggleSidebarSection('articleIndexContentInline')">
                    <h4 class="sidebar-section-title">
                        <i class="bi bi-list-ul"></i> En este artículo
                    </h4>
                    <i class="bi bi-chevron-down sidebar-section-icon"></i>
                </div>
                <div class="sidebar-section-content partial-open" id="articleIndexContentInline">
                    <ul class="article-index-list" id="articleIndexListInline">
                        @* Clonado dinámicamente desde articleIndexList *@
                    </ul>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Item?.Excerpt))
            {
                <p class="detail-sub" style="margin-bottom:12px;">@Model.Item.Excerpt</p>
            }

            <div class="contenido-html-wrapper">
                <div class="contenido-html" id="contenido-html">
                    @Html.Raw(Model.Item?.ContentHtml ?? "<p>Sin contenido disponible.</p>")
                </div>
                <div class="contenido-fade" id="contenido-fade" style="display:none;"></div>
                <div class="contenido-readmore-container" id="contenido-readmore-container" style="display:none;">
                    <button type="button" class="btn-continuar-leyendo" id="btn-continuar-leyendo">
                        <i class="bi bi-chevron-down"></i> Continuar leyendo
                    </button>
                </div>
            </div>


            @* ===== Contenido relacionado PROPIO: 2 bloques apilados (sin tabs) ===== *@
            @{
                Func<eiibd26.Models.RelatedContenidoVm, string> hrefDe = r =>
                    !string.IsNullOrWhiteSpace(r.SeoUrl) ? r.SeoUrl
                    : ("/c/" + (string.IsNullOrWhiteSpace(r.Slug) ? r.Id.ToString() : r.Slug));
            }

            @* Bloque 1: Relacionados (manual, curado) *@
            @if (Model.Item?.ManualRelated?.Any() == true)
            {
                <section class="rel-block" aria-label="Artículos relacionados">
                    <div class="rel-block-head">
                        <span class="rel-ico"><i class="bi bi-pin-angle-fill"></i></span>
                        <h2 class="rel-title">Relacionados</h2>
                        <span class="rel-count">@Model.Item.ManualRelated.Count()</span>
                    </div>
                    <p class="rel-sub">Artículos que enlazamos a mano con este tema.</p>
                    <div class="related-grid">
                        @foreach (var r in Model.Item.ManualRelated)
                        {
                            <a class="related-card" href="@hrefDe(r)" title="@r.Note">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Title" loading="lazy" decoding="async" fetchpriority="low"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")';" />
                                }
                                else
                                {
                                    <div class="related-card__ph"><i class="bi bi-file-text"></i></div>
                                }
                                <div>
                                    <div class="r-title">@r.Title</div>
                                    <div class="r-meta">@r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                    @if (!string.IsNullOrWhiteSpace(r.Note))
                                    {
                                        <div class="r-note">@r.Note</div>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }

            @* Bloque 2: Similares de EIIBD (embeddings propio↔propio) *@
            @if (Model.Item?.SimilaresEiibd?.Any() == true)
            {
                <section class="rel-block" aria-label="Similares de EIIBD">
                    <div class="rel-block-head">
                        <span class="rel-ico"><i class="bi bi-stars"></i></span>
                        <h2 class="rel-title">Similares de EIIBD</h2>
                        <span class="rel-count">@Model.Item.SimilaresEiibd.Count()</span>
                    </div>
                    <p class="rel-sub">Otros artículos nuestros parecidos a este, por significado.</p>
                    <div class="related-grid">
                        @foreach (var r in Model.Item.SimilaresEiibd)
                        {
                            <a class="related-card" href="@hrefDe(r)">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Title" loading="lazy" decoding="async" fetchpriority="low"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/img/Enfermedad-Inflamatoria-Intestinal-BLOG.jpg")';" />
                                }
                                else
                                {
                                    <div class="related-card__ph"><i class="bi bi-file-text"></i></div>
                                }
                                <div>
                                    <div class="r-title">@r.Title</div>
                                    <div class="r-meta">
                                        @if (r.MatchPercent.HasValue)
                                        {
                                            <span class="r-match">@r.MatchPercent%</span> <span>de coincidencia</span>
                                        }
                                        else
                                        {
                                            @r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)
                                        }
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.Item?.ManualPreguntas?.Any() == true)
            {
                <section style="margin-top:24px;">
                    <h4 style="margin:0 0 12px 0;color:#374151; font-weight:100;  font-size: 1.1rem;">Preguntas relacionadas</h4>
                    @foreach (var q in Model.Item.ManualPreguntas)
                    {
                        <div class="pregunta-card">
                            <a href="@(Url.Page("/Preguntas/Detalles", new { id = q.Id }))">
                                <div>@q.Title</div>
                                <div style="font-size:.85rem;color:#6b7280;">@q.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                            </a>
                        </div>
                    }
                </section>
            }
            @if (Model.ValidacionesPublicas.Any())
            {
                <section class="validaciones-profesionales mt-4" aria-label="Validado por profesionales médicos">
                    <div class="validaciones-profesionales__header">
                        <div class="validaciones-profesionales__header-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h4 class="validaciones-profesionales__title">Validado por Profesionales de la Salud</h4>
                    </div>
                    <div class="validaciones-profesionales__body">
                        @foreach (var v in Model.ValidacionesPublicas)
                        {
                            <div class="validacion-item">
                                @if (!string.IsNullOrWhiteSpace(v.AvatarUrl))
                                {
                                    <img src="@v.AvatarUrl" alt="@v.UserDisplay" class="validacion-avatar">
                                }
                                else
                                {
                                    <div class="validacion-avatar-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }
                                <div>
                                    <div class="validacion-name">@v.UserDisplay</div>
                                    @if (!string.IsNullOrWhiteSpace(v.Comentario))
                                    {
                                        <p class="validacion-comment mb-1">"@v.Comentario"</p>
                                    }
                                    <span class="validacion-date">@v.CreadoEn.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-MX"))</span>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </article>
        <aside class="right-panel" aria-labelledby="related-heading">
            @* ===== ÍNDICE AUTOMÁTICO DE SECCIONES (ARRIBA DEL SIDEBAR, solo desktop) ===== *@
            <div class="article-index-sidebar" id="articleIndex" role="navigation" aria-label="Índice del artículo">
                <div class="sidebar-section-header" onclick="toggleSidebarSection('articleIndexContent')">
                    <h4 class="sidebar-section-title">
                        <i class="bi bi-list-ul"></i> En este artículo
                    </h4>
                    <i class="bi bi-chevron-down sidebar-section-icon"></i>
                </div>
                <div class="sidebar-section-content partial-open" id="articleIndexContent">
                    <ul class="article-index-list" id="articleIndexList">
                        @* Generado dinámicamente por JavaScript *@
                    </ul>
                </div>
            </div>

            @* ===== VALIDAR CONTENIDO (solo médicos/admins) ===== *@
            @if (Model.CanValidate)
            {
                @await Html.PartialAsync("_ValidacionContenidoMedico", new ValidacionContenidoPartialVm
                {
                    ContenidoId = Model.Item.Id,
                    Slug        = Model.Item.Slug,
                    PageHandler = "GuardarValidacion",
                    Existente   = Model.MiValidacionDesc
                })
            }

            @* ===== CALIFICAR ARTÍCULO (SIEMPRE VISIBLE) ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">
                        Calificar artículo
                    </h4>
                </div>
                <div class="sidebar-section-content-static">
                    <div class="article-rating" id="articleRating" data-article-id="@Model.Item.Id">
                        <div class="rating-buttons">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <button type="button" class="rating-btn rating-like" data-rating="like" title="Me fue útil">
                                    <i class="bi bi-hand-thumbs-up"></i>
                                    <span class="rating-text">Me fue útil</span>
                                    <span class="rating-count" id="likeCount">...</span>
                                </button>
                                <button type="button" class="rating-btn rating-dislike" data-rating="dislike" title="No me fue útil">
                                    <i class="bi bi-hand-thumbs-down"></i>
                                    <span class="rating-text">No me fue útil</span>
                                    <span class="rating-count" id="dislikeCount">...</span>
                                </button>
                            }
                            else
                            {

                                <div class="rating-login-hint">
                                    <a href="/Identity/Account/Login?ReturnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)">Inicia sesión</a> para calificar este artículo
                                </div>
                            }
                        </div>
                        <div class="rating-message" id="ratingMessage" style="display: none;"></div>
                    </div>
                </div>
            </div>

            @* ===== COMPARTIR ARTÍCULO (SIEMPRE VISIBLE, SIN TOGGLE) ===== *@
            <div class="sidebar-section sidebar-static">
                <div class="sidebar-section-header-static">
                    <h4 class="sidebar-section-title">
                        Compartir artículo
                    </h4>
                </div>
                <div class="sidebar-section-content-static">
                    <div class="share-icons" aria-label="Compartir">
                        @{
                            var encUrl = System.Net.WebUtility.UrlEncode(shareUrl ?? "");
                            var encTitle = System.Net.WebUtility.UrlEncode(shareTitle ?? "");
                            var waHref = $"https://api.whatsapp.com/send?text={encTitle}%20{encUrl}";
                            var fbHref = $"https://www.facebook.com/sharer/sharer.php?u={encUrl}";
                            var twHref = $"https://twitter.com/intent/tweet?text={encTitle}&url={encUrl}";
                            var mailHref = $"mailto:?subject={encTitle}&body={encUrl}";
                        }

                        <a class="share-btn" href="#" data-href="@waHref" title="Compartir en WhatsApp" aria-label="Compartir en WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        <a class="share-btn" href="#" data-href="@fbHref" title="Compartir en Facebook" aria-label="Compartir en Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="share-btn" href="#" data-href="@twHref" title="Compartir en X" aria-label="Compartir en X"><i class="bi bi-twitter"></i></a>
                        <a class="share-btn" href="@mailHref" title="Enviar por email" aria-label="Enviar por email"><i class="bi bi-envelope"></i></a>
                    </div>
                    <script>
                        (function(){
                            function openPopup(url){
                                try{
                                    var w = 600, h = 600;
                                    var left = (screen.width/2)-(w/2);
                                    var top = (screen.height/2)-(h/2);
                                    window.open(url, '_blank', `scrollbars=yes,resizable=yes,toolbar=no,location=no,width=${w},height=${h},top=${top},left=${left}`);
                                }catch(e){ window.location.href = url; }
                            }
                            document.addEventListener('click', function(e){
                                var a = e.target.closest && e.target.closest('.share-btn');
                                if(!a) return;
                                e.preventDefault();
                                var href = a.getAttribute('data-href') || a.getAttribute('href');
                                if(!href) return;
                                // For mailto keep default behavior
                                if(href.indexOf('mailto:') === 0){ window.location.href = href; return; }
                                openPopup(href);
                            }, {passive:false});
                        })();
                    </script>
                </div>
            </div>

            @* ===== DATOS RELACIONADOS (TOGGLE ABIERTO POR DEFECTO) ===== *@
            <div class="sidebar-section">
                <div class="sidebar-section-header" onclick="toggleSidebarSection('datosContent')">
                    <h4 class="sidebar-section-title">
                        Datos Relacionados
                    </h4>
                    <i class="bi bi-chevron-down sidebar-section-icon"></i>
                </div>
                <div class="sidebar-section-content open" id="datosContent">
                    @* Condiciones *@
                    <div class="sidebar-subsection">
                        <h5 class="sidebar-subsection-title">Condiciones</h5>
                        <div class="sidebar-badges-compact">
                            @if (Model.Item?.ManualCondiciones?.Any() == true)
                            {
                                foreach (var n in Model.Item.ManualCondiciones)
                                {
                                    <span class="badge-cat-compact" title="@n">@n</span>
                                }
                            }
                            else
                            {
                                <div class="text-muted-small">Sin datos</div>
                            }
                        </div>
                    </div>

            @* Síntomas *@
            <div class="sidebar-subsection">
                <h5 class="sidebar-subsection-title">Síntomas</h5>
                <div class="sidebar-badges-compact">
                    @if (Model.Item?.ManualSintomas?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualSintomas)
                        {
                            <span class="badge-cat-compact" title="@n">@n</span>
                        }
                    }
                    else
                    {
                        <div class="text-muted-small">Sin datos</div>
                    }
                </div>
            </div>

            @* Tratamientos *@
            <div class="sidebar-subsection tratamientos-section">
                <h5 class="sidebar-subsection-title">Tratamientos</h5>
                <div class="sidebar-badges-compact">
                    @if (Model.Item?.ManualTratamientos?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualTratamientos)
                        {
                            <span class="badge-cat-compact" title="@n">@n</span>
                        }
                    }
                    else
                    {
                        <div class="text-muted-small">Sin datos</div>
                    }
                </div>
            </div>

                    @* Categorías *@
                    <div class="sidebar-subsection">
                        <h5 class="sidebar-subsection-title">Categorías</h5>
                        <div class="sidebar-badges-compact">
                            @if (Model.Item?.Categories?.Any() == true)
                            {
                                var principal = Model.CategoryCrumbs?.LastOrDefault()?.Title;
                                foreach (var cat in Model.Item.Categories)
                                {
                                    var isPrincipal = !string.IsNullOrWhiteSpace(principal) && cat == principal;
                                    string url = null;
                                    if (Model.CategoryCrumbs != null && Model.CategoryCrumbs.Any())
                                    {
                                        var crumb = Model.CategoryCrumbs.LastOrDefault(c => c.Title != null && c.Title.Equals(cat, System.StringComparison.OrdinalIgnoreCase));
                                        if (crumb != null && !string.IsNullOrWhiteSpace(crumb.Url))
                                        {
                                            url = crumb.Url.StartsWith("/") ? crumb.Url : "/" + crumb.Url;
                                        }
                                    }
                                    if (string.IsNullOrWhiteSpace(url))
                                    {
                                        url = "/" + (cat.ToLower().Replace(" ", "-").Replace("á","a").Replace("é","e").Replace("í","i").Replace("ó","o").Replace("ú","u").Replace("ñ","n"));
                                    }
                                    var isSintomas = cat.Equals("Sintomas", StringComparison.OrdinalIgnoreCase) || cat.Equals("Síntomas", StringComparison.OrdinalIgnoreCase);
                                    <a class="badge-cat-compact @(isPrincipal ? "badge-cat-principal" : "") @(isSintomas ? "sintomas-badge" : "")" href="@url" title="@cat">@cat</a>
                                }
                            }
                            else
                            {
                                <div class="text-muted-small">Sin datos</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ===== EN OTROS SITIOS (externos, embeddings) — solo artículos del árbol General ===== *@
            @if (Model.EsArticuloCobertura && Model.ExternosItems.Any())
            {
                <div class="sidebar-section">
                    <div class="side-ext">
                        <div class="side-ext__head">
                            <span class="side-ext__ico"><i class="bi bi-compass"></i></span>
                            <h4 class="side-ext__title">En otros sitios</h4>
                        </div>
                        <p class="side-ext__sub">Qué tan relacionado está con lo que lees. Abre el original.</p>
                        <div class="ext-legend">
                            <span class="ext-legend__item"><span class="ext-legend__dot ext-legend__dot--strong"></span>Muy relacionado (≥80%)</span>
                            <span class="ext-legend__item"><span class="ext-legend__dot ext-legend__dot--soft"></span>Relacionado (60–79%)</span>
                        </div>
                        <div class="ext-list" id="lista-externos" data-tab="externos">
                            <partial name="_ExternosSimilares" model="Model.ExternosItems" />
                        </div>
                        @if (Model.ExternosHasMore)
                        {
                            <button type="button" class="ext-vermas js-ver-mas"
                                    data-aid="@Model.ArticuloId" data-tab="externos"
                                    data-offset="@Model.ExternosNextOffset" data-target="#lista-externos">
                                Ver más
                            </button>
                        }
                        <div class="ext-legend ext-legend--foot">
                            <span class="ext-legend__item"><span class="ext-legend__dot ext-legend__dot--strong"></span>Muy relacionado (≥80%)</span>
                            <span class="ext-legend__item"><span class="ext-legend__dot ext-legend__dot--soft"></span>Relacionado (60–79%)</span>
                        </div>
                    </div>
                </div>
            }

            @if ((Model.Item?.ManualRelated?.Any() != true) && (Model.Item?.SimilaresEiibd?.Any() != true) && (Model.Item?.ManualPreguntas?.Any() != true))
            {
                <div class="text-muted" style="font-size:.9rem; margin-top:12px;">No hay artículos o preguntas relacionadas.</div>
            }
        </aside>
        </aside>
    </div><!-- /detail-grid -->
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Tabs behavior — aplica a TODOS los bloques .tabs (Relacionados + Radar "Explora el tema").
            document.querySelectorAll('.tabs').forEach(function (tabContainer) {
                const buttons = tabContainer.querySelectorAll('.tab-btn');
                const panels = tabContainer.querySelectorAll('.tab-panel');
                if (!buttons.length) return;

                function activate(panelId, btn) {
                    panels.forEach(p => {
                        if (p.id === panelId) {
                            p.classList.add('active');
                            p.setAttribute('aria-hidden', 'false');
                        } else {
                            p.classList.remove('active');
                            p.setAttribute('aria-hidden', 'true');
                        }
                    });
                    buttons.forEach(b => {
                        if (b === btn) {
                            b.classList.add('active');
                            b.setAttribute('aria-selected', 'true');
                        } else {
                            b.classList.remove('active');
                            b.setAttribute('aria-selected', 'false');
                        }
                    });
                }

                buttons.forEach(btn => {
                    btn.addEventListener('click', () => activate(btn.getAttribute('data-panel'), btn));

                    btn.addEventListener('keydown', (e) => {
                        // left/right navigation
                        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                            e.preventDefault();
                            const idx = Array.from(buttons).indexOf(btn);
                            const nextIdx = e.key === 'ArrowRight' ? (idx + 1) % buttons.length : (idx - 1 + buttons.length) % buttons.length;
                            buttons[nextIdx].focus();
                        }
                    });
                });

                // set initial (first) active
                const first = buttons[0];
                activate(first.getAttribute('data-panel'), first);
            });
        })();

        // "Ver más" AJAX del Radar (embeddings): carga el siguiente bloque sin recargar la página.
        (function () {
            function onClick(btn) {
                return async function () {
                    const target = document.querySelector(btn.dataset.target);
                    if (!target) return;
                    const aid = btn.dataset.aid;
                    const tab = btn.dataset.tab;
                    const offset = btn.dataset.offset;
                    btn.disabled = true;
                    const original = btn.textContent;
                    btn.textContent = 'Cargando…';
                    try {
                        // Importante: apuntar al PATH REAL de la pagina (/Contenidos/Detalle), NO a la
                        // URL SEO actual: el middleware de reescritura (Program.cs) reescribe el query
                        // string de las URLs con slug y borraria ?handler=&aid=. El path /Contenidos/
                        // esta excluido del middleware, asi el handler se invoca y devuelve solo el partial.
                        const url = '/Contenidos/Detalle?handler=MasExternos&aid=' + encodeURIComponent(aid) +
                                    '&tab=' + encodeURIComponent(tab) + '&offset=' + encodeURIComponent(offset);
                        const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (!resp.ok) { btn.disabled = false; btn.textContent = original; return; }
                        const html = await resp.text();
                        target.insertAdjacentHTML('beforeend', html.trim());
                        if (resp.headers.get('X-Has-More') === '1') {
                            btn.dataset.offset = resp.headers.get('X-Next-Offset');
                            btn.disabled = false;
                            btn.textContent = original;
                        } else {
                            btn.remove();  // no quedan más → ocultar el botón
                        }
                    } catch (e) {
                        btn.disabled = false;
                        btn.textContent = original;
                    }
                };
            }
            document.querySelectorAll('.js-ver-mas').forEach(function (btn) {
                btn.addEventListener('click', onClick(btn));
            });
        })();

        // "Continuar leyendo" logic
        (function () {
            const contenidoHtml = document.getElementById('contenido-html');
            const fade = document.getElementById('contenido-fade');
            const readmoreContainer = document.getElementById('contenido-readmore-container');
            const readmoreBtn = document.getElementById('btn-continuar-leyendo');

            if (!contenidoHtml || !fade || !readmoreContainer || !readmoreBtn) return;

            const MAX_HEIGHT = 600;
            let isExpanded = false;

            function checkContentHeight() {
                const contentHeight = contenidoHtml.scrollHeight;

                if (contentHeight > MAX_HEIGHT && !isExpanded) {
                    contenidoHtml.style.maxHeight = MAX_HEIGHT + 'px';
                    contenidoHtml.style.overflow = 'hidden';
                    fade.style.display = 'block';
                    readmoreContainer.style.display = 'block';
                } else if (contentHeight <= MAX_HEIGHT) {
                    fade.style.display = 'none';
                    readmoreContainer.style.display = 'none';
                }
            }

            readmoreBtn.addEventListener('click', function() {
                if (!isExpanded) {
                    contenidoHtml.style.maxHeight = 'none';
                    contenidoHtml.style.overflow = 'visible';
                    fade.style.display = 'none';
                    readmoreContainer.style.display = 'none';
                    isExpanded = true;

                    contenidoHtml.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });

            checkContentHeight();
            window.addEventListener('resize', checkContentHeight);
        })();

        // ===== SIDEBAR COLLAPSIBLE SECTIONS =====
        window.toggleSidebarSection = function(contentId) {
            const content = document.getElementById(contentId);
            if (!content) return;

            // Check if it's transitioning from partial-open
            const wasPartialOpen = content.classList.contains('partial-open');

            if (wasPartialOpen) {
                // Transition from partial-open to open
                content.classList.remove('partial-open');
                content.classList.add('open');
                const header = content.previousElementSibling;
                if (header) {
                    const icon = header.querySelector('.sidebar-section-icon');
                    if (icon) {
                        icon.style.transform = 'rotate(180deg)';
                    }
                }
                console.log('[Sidebar] Section', contentId, 'expanded from partial to full');
            } else {
                // Normal toggle behavior
                const isOpen = content.classList.toggle('open');
                const header = content.previousElementSibling;
                if (header) {
                    const icon = header.querySelector('.sidebar-section-icon');
                    if (icon) {
                        icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                    }
                }
                console.log('[Sidebar] Section', contentId, isOpen ? 'opened' : 'closed');
            }
        };

        // Initialize sidebar states on load
        document.addEventListener('DOMContentLoaded', function() {
            // Índice: partial-open (ya tiene la clase en HTML)
            const indexContent = document.getElementById('articleIndexContent');
            if (indexContent) {
                console.log('[Sidebar] Index initialized as partial-open');
            }

            // Datos Relacionados: open por defecto
            const datosContent = document.getElementById('datosContent');
            if (datosContent) {
                datosContent.classList.add('open');
                const header = datosContent.previousElementSibling;
                if (header) {
                    const icon = header.querySelector('.sidebar-section-icon');
                    if (icon) {
                        icon.style.transform = 'rotate(180deg)';
                    }
                }
                console.log('[Sidebar] Datos Relacionados initialized as open');
            }
        });

        // ===== AUTO-GENERATED TABLE OF CONTENTS =====
        (function () {
            const articleContent = document.getElementById('contenido-html');
            const indexContainer = document.getElementById('articleIndex');
            const indexList = document.getElementById('articleIndexList');
            const indexToggle = document.getElementById('articleIndexToggle');
            const indexContent = document.getElementById('articleIndexContent');

            if (!articleContent || !indexContainer || !indexList) {
                console.warn('[TOC] Required elements not found');
                return;
            }

            console.log('[TOC] Initializing table of contents generator');

            // ===== STEP 1: Generate unique IDs for all H2 and H3 headers =====
            function slugify(text) {
                return text
                    .toString()
                    .toLowerCase()
                    .trim()
                    .normalize('NFD') // Normalize accented characters
                    .replace(/[\u0300-\u036f]/g, '') // Remove diacritics
                    .replace(/[^\w\s-]/g, '') // Remove non-word chars
                    .replace(/\s+/g, '-') // Replace spaces with -
                    .replace(/--+/g, '-'); // Replace multiple - with single -
            }

            const headers = articleContent.querySelectorAll('h2, h3');
            console.log('[TOC] Found', headers.length, 'headers (H2 + H3)');

            if (headers.length < 3) {
                console.log('[TOC] Less than 3 headers, hiding index');
                indexContainer.style.display = 'none';
                return;
            }

            // Assign unique IDs to all headers
            const usedIds = new Set();
            headers.forEach((header, index) => {
                let baseId = slugify(header.textContent);
                let uniqueId = baseId;
                let counter = 1;

                // Ensure ID is unique
                while (usedIds.has(uniqueId)) {
                    uniqueId = `${baseId}-${counter}`;
                    counter++;
                }

                usedIds.add(uniqueId);
                header.id = uniqueId;
                console.log('[TOC] Assigned ID:', uniqueId, 'to', header.tagName, ':', header.textContent.substring(0, 40));
            });

            // ===== STEP 2: Build the index list =====
            const indexItems = [];

            headers.forEach((header) => {
                const level = header.tagName === 'H2' ? 2 : 3;
                const text = header.textContent;
                const id = header.id;

                const li = document.createElement('li');
                if (level === 3) {
                    li.classList.add('sub');
                }

                const link = document.createElement('a');
                link.href = `#${id}`;
                link.textContent = text;
                link.setAttribute('data-section-id', id);

                li.appendChild(link);
                indexItems.push({ li, link, id });
            });

            // Append all items to the index list
            indexItems.forEach(({ li }) => indexList.appendChild(li));

            console.log('[TOC] Generated', indexItems.length, 'index links');

            // ===== INLINE INDEX (mobile): clone items into the inline TOC above breadcrumb =====
            const inlineList = document.getElementById('articleIndexListInline');
            const inlineContainer = document.getElementById('articleIndexInline');
            if (inlineList && inlineContainer) {
                if (indexItems.length < 3) {
                    inlineContainer.style.display = 'none';
                } else {
                    indexItems.forEach(({ li }) => {
                        const clone = li.cloneNode(true);
                        // Wire scroll on cloned links
                        clone.querySelector('a')?.addEventListener('click', (e) => {
                            e.preventDefault();
                            const targetId = e.currentTarget.getAttribute('href').substring(1);
                            const targetEl = document.getElementById(targetId);
                            if (targetEl) {
                                const offset = 100;
                                window.scrollTo({ top: targetEl.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
                            }
                        });
                        inlineList.appendChild(clone);
                    });
                }
            }

            // ===== STEP 3: Mobile accordion toggle =====
            if (indexToggle && indexContent) {
                indexToggle.addEventListener('click', function () {
                    const isOpen = indexContent.classList.toggle('open');
                    indexToggle.classList.toggle('open', isOpen);
                    indexToggle.setAttribute('aria-expanded', isOpen);
                    console.log('[TOC] Mobile toggle:', isOpen ? 'opened' : 'closed');
                });
            }

            // ===== STEP 4: Intersection Observer for active section highlighting =====
            const observerOptions = {
                root: null,
                rootMargin: '-20% 0px -60% 0px',
                threshold: 0
            };

            let activeLink = null;

            function setActiveLink(id) {
                if (activeLink) {
                    activeLink.classList.remove('active');
                }

                const newActive = indexList.querySelector(`a[data-section-id="${id}"]`);
                if (newActive) {
                    newActive.classList.add('active');
                    activeLink = newActive;
                    console.log('[TOC] Active section:', id);
                }
            }

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        setActiveLink(entry.target.id);
                    }
                });
            }, observerOptions);

            // Observe all headers
            headers.forEach((header) => observer.observe(header));

            // ===== STEP 5: Smooth scroll on click + AUTO-EXPAND ARTICLE =====
            indexList.addEventListener('click', (e) => {
                if (e.target.tagName === 'A') {
                    e.preventDefault();
                    const targetId = e.target.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);

                    if (targetElement) {
                        // ✅ AUTO-EXPAND: Trigger "Continue Reading" button if article is collapsed
                        const readmoreBtn = document.getElementById('btn-continuar-leyendo');
                        const contenidoHtml = document.getElementById('contenido-html');
                        const fade = document.getElementById('contenido-fade');
                        const readmoreContainer = document.getElementById('contenido-readmore-container');

                        if (readmoreBtn && contenidoHtml && fade && readmoreContainer) {
                            const isCollapsed = contenidoHtml.style.maxHeight && contenidoHtml.style.maxHeight !== 'none';

                            if (isCollapsed) {
                                console.log('[TOC] Article is collapsed, expanding automatically...');
                                contenidoHtml.style.maxHeight = 'none';
                                contenidoHtml.style.overflow = 'visible';
                                fade.style.display = 'none';
                                readmoreContainer.style.display = 'none';
                            }
                        }

                        // Scroll to section with offset
                        const offset = 100; // Account for sticky header
                        const elementPosition = targetElement.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - offset;

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: 'smooth'
                        });

                        // Update active link immediately
                        setActiveLink(targetId);

                        console.log('[TOC] Scrolled to:', targetId);
                    }
                }
            });

            console.log('[TOC] Table of contents initialized successfully');
        })();

        // ===== ARTICLE RATING SYSTEM =====
        (function() {
            const ratingContainer = document.getElementById('articleRating');
            if (!ratingContainer) return;

            const articleId = ratingContainer.getAttribute('data-article-id');
            const likeBtn = ratingContainer.querySelector('.rating-like');
            const dislikeBtn = ratingContainer.querySelector('.rating-dislike');
            const likeCount = document.getElementById('likeCount');
            const dislikeCount = document.getElementById('dislikeCount');
            const ratingMessage = document.getElementById('ratingMessage');

            console.log('🎯 [Article Rating] Inicializando sistema de calificación para artículo:', articleId);

            // Cargar estado inicial
            async function loadRatingState() {
                try {
                    const response = await fetch(`/api/articles/${articleId}/rating`);
                    const data = await response.json();

                    if (data.ok && data.estadisticas) {
                        // Actualizar contadores
                        if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                        if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;

                        // Si el usuario ya votó, marcar botón activo
                        if (data.ratingUsuario) {
                            const ratingType = data.ratingUsuario.tipo;
                            if (ratingType === 'like' && likeBtn) {
                                likeBtn.classList.add('active');
                            } else if (ratingType === 'dislike' && dislikeBtn) {
                                dislikeBtn.classList.add('active');
                            }
                            console.log('✅ [Article Rating] Estado cargado:', data.ratingUsuario);
                        }
                    }
                } catch (err) {
                    console.error('❌ [Article Rating] Error al cargar estado:', err);
                    // Valores por defecto en caso de error
                    if (likeCount) likeCount.textContent = '0';
                    if (dislikeCount) dislikeCount.textContent = '0';
                }
            }

            // Enviar calificación
            async function sendRating(ratingType) {
                try {
                    showMessage('Guardando...', 'info');

                    const response = await fetch(`/api/articles/${articleId}/rating`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            ratingType: ratingType
                        })
                    });

                    const data = await response.json();

                    if (data.ok) {
                        // Actualizar contadores
                        if (data.estadisticas) {
                            if (likeCount) likeCount.textContent = data.estadisticas.likes || 0;
                            if (dislikeCount) dislikeCount.textContent = data.estadisticas.dislikes || 0;
                        }

                        // Actualizar botones activos
                        if (likeBtn) likeBtn.classList.toggle('active', ratingType === 'like');
                        if (dislikeBtn) dislikeBtn.classList.toggle('active', ratingType === 'dislike');

                        showMessage('✅ ¡Gracias por tu opinión!', 'success');
                        console.log('✅ [Article Rating] Calificación guardada:', ratingType);

                        // Auto-hide mensaje después de 3 segundos
                        setTimeout(() => hideMessage(), 3000);
                    } else {
                        showMessage('❌ ' + (data.error || 'Error al guardar'), 'error');
                    }
                } catch (err) {
                    console.error('❌ [Article Rating] Error al guardar:', err);
                    showMessage('❌ Error de conexión', 'error');
                }
            }

            // Event listeners
            if (likeBtn) {
                likeBtn.addEventListener('click', function() {
                    if (likeBtn.classList.contains('active')) {
                        console.log('ℹ️ [Article Rating] Ya votaste like anteriormente');
                        return;
                    }
                    sendRating('like');
                });
            }

            if (dislikeBtn) {
                dislikeBtn.addEventListener('click', function() {
                    if (dislikeBtn.classList.contains('active')) {
                        console.log('ℹ️ [Article Rating] Ya votaste dislike anteriormente');
                        return;
                    }
                    sendRating('dislike');
                });
            }

            function showMessage(text, type = 'info') {
                if (!ratingMessage) return;
                ratingMessage.textContent = text;
                ratingMessage.className = 'rating-message ' + type;
                ratingMessage.style.display = 'block';
            }

            function hideMessage() {
                if (ratingMessage) {
                    ratingMessage.style.display = 'none';
                }
            }

            // Inicializar
            loadRatingState();

            console.log('✅ [Article Rating] Sistema inicializado correctamente');
        })();
    </script>
}
