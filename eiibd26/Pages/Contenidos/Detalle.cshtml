@page "{slug?}"
@model eiibd26.Pages.Contenidos.DetalleModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Item?.Title ?? "Contenido";
}

@section Styles {
    <style>
        .conte-detail {
            max-width: 1140px;
            margin: 0 auto;
            padding: 28px 16px;
        }

        .breadcrumbs {
            font-size: .9rem;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .detail-header {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: flex-start;
            margin-bottom: 18px;
        }

        .detail-title {
            flex: 1 1 auto;
        }

            .detail-title h1 {
                font-size: 2.2rem;
                margin: 0 0 8px;
                line-height: 1.05;
                font-weight: 700;
                color: #0f172a;
            }

        .detail-sub {
            color: #6b7280;
            margin-bottom: 6px;
        }

        .meta-right {
            flex: 0 0 220px;
            text-align: right;
            font-size: .95rem;
            color: #374151;
        }

            .meta-right .author {
                display: flex;
                align-items: center;
                gap: 8px;
                justify-content: flex-end;
            }

                .meta-right .author img {
                    width: 40px;
                    height: 40px;
                    border-radius: 999px;
                    object-fit: cover;
                }

            .meta-right .date {
                color: #94a3b8;
                font-size: .85rem;
                margin-top: 6px;
            }

        .share-icons {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .detail-image {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            background: #f3f6fa;
            aspect-ratio: 16 / 7;
            position: relative;
        }

            .detail-image .img-fallback {
                display: block;
                width: 100%;
                padding-top: calc(100% * 7 / 16);
                position: relative;
            }

            .detail-image img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                display: block;
            }

        .detail-grid {
            display: grid;
            grid-template-columns: 280px 1fr 320px;
            gap: 24px;
            align-items: start;
        }

        .read-time {
            background: #fff;
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #eef2f7;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .read-time .minutes {
                font-weight: 700;
                font-size: 1.05rem;
            }

        .categories-list {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #eef2f7;
            padding: 12px;
        }

            .categories-list .badge-cat {
                display: inline-block;
                background: #eef5ff;
                color: #24527a;
                padding: 6px 10px;
                border-radius: 999px;
                font-size: .85rem;
                margin: 6px 6px 0 0;
            }

        .content-panel .contenido-html {
            background: #fff;
            border-radius: 10px;
            padding: 18px;
            border: 1px solid #eef2f7;
        }

        .related-card {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 12px;
            background: #fff;
            border-radius: 10px;
            padding: 10px;
            border: 1px solid #eef2f7;
        }

            .related-card img {
                width: 64px;
                height: 48px;
                object-fit: cover;
                border-radius: 8px;
                flex: 0 0 64px;
            }

            .related-card .r-title {
                font-size: .95rem;
                font-weight: 600;
                color: #0f172a;
            }

            .related-card .r-meta {
                font-size: .82rem;
                color: #94a3b8;
            }

        .manual-block {
            margin-top: 28px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
        }

        .manual-box {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #eef2f7;
            padding: 12px;
        }

            .manual-box h5 {
                margin-top: 0;
                font-size: 1rem;
                color: #374151;
            }

        .pregunta-card {
            background: #fff;
            border-radius: 8px;
            border: 1px solid #eef2f7;
            padding: 10px;
            margin-bottom: 10px;
        }

            .pregunta-card a {
                text-decoration: none;
                color: inherit;
            }

        @@media (max-width:991.98px) {
            .detail-grid {
                grid-template-columns: 1fr;
            }

            .meta-right {
                text-align: left;
                order: 2;
            }

            .detail-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .manual-block {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="conte-detail">
    <nav class="breadcrumbs" aria-label="breadcrumbs">
        <a href="/">Home</a> ›
        @if (Model.Item?.Categories?.Any() == true)
        {
            <text> @Model.Item.Categories.First() </text>
        }
        else
        {
            <text> Contenidos </text>
        }
        › <span>@Model.Item?.Title</span>
    </nav>

    <header class="detail-header" role="banner">
        <div class="detail-title">
            <div class="detail-sub">@Model.Item?.Categories?.FirstOrDefault()</div>
            <h1>@Model.Item?.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Item?.Excerpt))
            {
                <p class="detail-sub">@Model.Item.Excerpt</p>
            }
        </div>

        <div class="meta-right" aria-hidden="false">
            <div class="author">
                <img src="~/img/avatar-placeholder.png" alt="@Model.Item?.Author" />
                <div style="text-align:right;">
                    <div style="font-weight:700;">@Model.Item?.Author</div>
                    <div class="date">@Model.Item?.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                </div>
            </div>

            <div class="share-icons" aria-label="Share">
                <a title="Share on X" href="#" aria-label="Share on X">X</a>
                <a title="Share on Facebook" href="#" aria-label="Share on Facebook">f</a>
                <a title="Share on LinkedIn" href="#" aria-label="Share on LinkedIn">in</a>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Item?.ImageUrl))
    {
        <div class="detail-image" role="img" aria-label="@Model.Item.Title">
            <div class="img-fallback"></div>
            <img src="@Model.Item.ImageUrl" alt="@Model.Item.Title" />
        </div>
    }

    <div class="detail-grid">
        <aside class="left-panel" aria-labelledby="left-panel-heading">
            <div class="read-time" role="status" aria-live="polite">
                <div>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                </div>
                <div>
                    <div class="minutes">@Model.Item?.ReadMinutes min read</div>
                    <div style="font-size:.85rem;color:#6b7280;">Approx.</div>
                </div>
            </div>

            <div class="categories-list" aria-labelledby="left-panel-heading">
                <h4 style="margin:0 0 8px 0;font-size:.95rem;color:#374151;">Categorías</h4>
                @if (Model.Item?.Categories?.Any() == true)
                {
                    foreach (var c in Model.Item.Categories)
                    {
                        <span class="badge-cat">@c</span>
                    }
                }
                else
                {
                    <div class="text-muted" style="font-size:.9rem;">Sin categorías</div>
                }
            </div>
        </aside>

        <article class="content-panel" aria-labelledby="article-title">
            <div class="contenido-html">
                @Html.Raw(Model.Item?.ContentHtml ?? "<p>Sin contenido disponible.</p>")
            </div>

            <div class="manual-block" aria-label="Relaciones manuales">
                <div class="manual-box">
                    <h5>Condiciones relacionadas</h5>
                    @if (Model.Item?.ManualCondiciones?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualCondiciones)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay condiciones relacionadas.</div>
                    }
                </div>

                <div class="manual-box">
                    <h5>Síntomas relacionados</h5>
                    @if (Model.Item?.ManualSintomas?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualSintomas)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay síntomas relacionados.</div>
                    }
                </div>

                <div class="manual-box">
                    <h5>Tratamientos relacionados</h5>
                    @if (Model.Item?.ManualTratamientos?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualTratamientos)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay tratamientos relacionados.</div>
                    }
                </div>
            </div>
        </article>

        <aside class="right-panel" aria-labelledby="related-heading">
            <h4 id="related-heading" style="margin-top:0;font-size:1rem;color:#374151;">Relacionados</h4>

            @* 1) Manual related contents *@
            @if (Model.Item?.ManualRelated?.Any() == true)
            {
                foreach (var r in Model.Item.ManualRelated)
                {
                    <a href="@(Url.Page("/Contenidos/Detalle", new { slug = string.IsNullOrWhiteSpace(r.Slug) ? (object)r.Id : r.Slug }))" style="text-decoration:none;color:inherit;">
                        <div class="related-card" title="@r.Note">
                            @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                            {
                                <img src="@r.ImageUrl" alt="@r.Title" />
                            }
                            else
                            {
                                <div style="width:64px;height:48px;background:#f3f6fa;border-radius:8px;flex:0 0 64px;"></div>
                            }
                            <div>
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <div class="r-title">@r.Title</div>
                                    <span style="background:#eef5ff;color:#24527a;padding:4px 8px;border-radius:999px;font-size:.72rem;margin-left:8px;">Manual</span>
                                </div>
                                <div class="r-meta">@r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                @if (!string.IsNullOrWhiteSpace(r.Note))
                                {
                                    <div style="font-size:.78rem;color:#6b7280;margin-top:4px;">@r.Note</div>
                                }
                            </div>
                        </div>
                    </a>
                }
            }

            @* 2) Automatic related by categories *@
            @if (Model.Item?.RelatedByCategories?.Any() == true)
            {
                <div style="margin-top:12px;">
                    <h5 style="margin:6px 0 8px 0;color:#374151;font-size:.95rem;">Recomendados</h5>
                    @foreach (var r in Model.Item.RelatedByCategories)
                    {
                        <a href="@(Url.Page("/Contenidos/Detalle", new { slug = string.IsNullOrWhiteSpace(r.Slug) ? (object)r.Id : r.Slug }))" style="text-decoration:none;color:inherit;">
                            <div class="related-card" title="@r.Note">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Title" />
                                }
                                else
                                {
                                    <div style="width:64px;height:48px;background:#f3f6fa;border-radius:8px;flex:0 0 64px;"></div>
                                }
                                <div>
                                    <div class="r-title">@r.Title</div>
                                    <div class="r-meta">@r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

            @* 3) Manual related questions *@
            @if (Model.Item?.ManualPreguntas?.Any() == true)
            {
                <div style="margin-top:14px;">
                    <h5 style="margin:6px 0 8px 0;color:#374151;font-size:.95rem;">Preguntas relacionadas</h5>
                    @foreach (var q in Model.Item.ManualPreguntas)
                    {
                        <div class="pregunta-card">
                            <a href="@(Url.Page("/Preguntas/Detalles", new { id = q.Id }))">
                                <div style="font-weight:700;color:#0b5cff;">@q.Title</div>
                                <div style="font-size:.85rem;color:#6b7280;">@q.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                            </a>
                        </div>
                    }
                </div>
            }

            @if ((Model.Item?.ManualRelated?.Any() != true) && (Model.Item?.RelatedByCategories?.Any() != true) && (Model.Item?.ManualPreguntas?.Any() != true))
            {
                <div class="text-muted" style="font-size:.9rem;">No hay artículos o preguntas relacionadas.</div>
            }
        </aside>
    </div>
</div>