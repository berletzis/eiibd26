@page "{slug?}"
@model eiibd26.Pages.Contenidos.DetalleModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Item?.Title ?? "Contenido";
}

@section Styles {
    <style>
        .conte-detail {
            max-width: 1140px;
            margin: 0 auto;
            padding: 28px 16px;
        }

        .breadcrumbs {
            font-size: .9rem;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .page-title {
            margin: 8px 0 18px 0;
        }

            .page-title h1 {
                font-size: 2.2rem;
                margin: 0;
                line-height: 1.05;
                font-weight: 200;
                color: #0f172a;
            }

        .detail-sub {
            color: #6b7280;
            margin-top: 6px;
        }

        .detail-image {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            background: #f3f6fa;
            aspect-ratio: 16 / 7;
            position: relative;
            margin-bottom: 18px;
        }

            .detail-image .img-fallback {
                display: block;
                width: 100%;
                padding-top: calc(100% * 7 / 16);
                position: relative;
            }

            .detail-image img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                display: block;
            }

        /* Main content + right sidebar */
        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 24px;
            align-items: start;
        }

        .content-panel .contenido-html {
            background: #fff;
            border-radius: 10px;
            padding: 18px;
            border: 1px solid #eef2f7;
        }

        .read-time {
            background: #fff;
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #eef2f7;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .read-time .minutes {
                font-weight: 700;
                font-size: 1.05rem;
            }

        .categories-list {
             /* background: #fff; */
             border-radius: 2px;
            /*border: 1px solid #eef2f7;  */
/*             padding: 6px;
            margin-bottom: 12px; */
        }

            .categories-list .badge-cat {
                display: inline-block;
                background: #f4edfc;
                color: #24527a;

                padding: 6px 10px;
                border-radius: 10px;
                font-size: .85rem;
                
            }

        .social-list {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #eef2f7;
            padding: 12px;
            margin-bottom: 12px;
        }

            .social-list .badge-cat {
                display: inline-block;
                background: #eef5ff;
                color: #24527a;
                padding: 6px 10px;
                border-radius: 999px;
                font-size: .85rem;
                margin: 6px 6px 0 0;
            }


        .meta-card {
            /* background: #fff; */
            /* border-radius: 5px;
            border: 1px solid #eef2f7; */
            padding: 12px;
            margin-bottom: 12px;
            text-align: left;
            font-weight:100;
        }

            .meta-card .author {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .meta-card .author img {
                    width: 30px;
                    height: 30px;
                    border-radius: 999px;
                    object-fit: cover;
                }

            .meta-card .meta-row {
                color: #6b7280;
                font-size: .9rem;
                margin-top: 8px;
            }

        .share-icons {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .related-card {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 12px;
            background: #fff;
            border-radius: 10px;
            padding: 10px;
            border: 1px solid #eef2f7;
        }

            .related-card img {
                width: 64px;
                height: 48px;
                object-fit: cover;
                border-radius: 8px;
                flex: 0 0 64px;
            }

            .related-card .r-title {
                font-size: .95rem;
                font-weight: 600;
                color: #0f172a;
            }

            .related-card .r-meta {
                font-size: .82rem;
                color: #94a3b8;
            }

        .manual-block {
            margin-top: 28px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
        }

        .manual-box {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #eef2f7;
            padding: 12px;
        }

            .manual-box h5 {
                margin-top: 0;
                font-size: 1rem;
                color: #374151;
            }

        .pregunta-card {
            background: #fff;
            border-radius: 8px;
            border: 1px solid #eef2f7;
            padding: 10px;
            margin-bottom: 10px;
        }

            .pregunta-card a {
                text-decoration: none;
                color: inherit;
            }

        @@media (max-width:991.98px) {
            .detail-grid {
                grid-template-columns: 1fr;
            }

            .manual-block {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="conte-detail">
    <div class="categories-list" aria-labelledby="left-panel-heading">
        @if (Model.Item?.Categories?.Any() == true)
        {
            foreach (var c in Model.Item.Categories)
            {
                <span class="badge-cat">@c</span>
            }
        }
        else
        {
            <div class="text-muted" style="font-size:.9rem;">Sin categorías</div>
        }
    </div>


    <div class="page-title">
        @* <div class="detail-sub">@Model.Item?.Categories?.FirstOrDefault()</div> *@
        <h1>@Model.Item?.Title</h1>
    </div>
    <div class="meta-card" role="complementary" aria-label="Meta del artículo">
        <div class="author">
            <img src="~/img/avatar-placeholder.png" alt="@Model.Item?.Author" />
            <div>
                <div style="font-weight:100;">por @Model.Item?.Author | <i class="bi bi-calendar"></i> @Model.Item?.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) | <i class="bi bi-clock"></i> @Model.Item?.ReadMinutes min read (aprox).</div>
            </div>
        </div>

        
    </div>


    @* Main grid: left article, right sidebar with meta and widgets *@
    <div class="detail-grid" role="main">
        <article class="content-panel" aria-labelledby="article-title">
            @* Image placed inside main content *@
            @if (!string.IsNullOrWhiteSpace(Model.Item?.ImageUrl))
            {
                <div class="detail-image" role="img" aria-label="@Model.Item.Title">
                    <div class="img-fallback"></div>
                    <img src="@Model.Item.ImageUrl" alt="@Model.Item.Title" />
                </div>
            }
         
            @* Breadcrumb and title only at top *@
            <nav class="breadcrumbs" aria-label="breadcrumbs">
                <a href="/">Inicio</a> ›
                @if (Model.Item?.Categories?.Any() == true)
                {
                    <text> @Model.Item.Categories.First() </text>
                }
                else
                {
                    <text>Contenidos </text>
                }
                › <span>@Model.Item?.Title</span>
            </nav>


            @* Excerpt under the image (moved from header) *@
            @if (!string.IsNullOrWhiteSpace(Model.Item?.Excerpt))
            {
                <p class="detail-sub" style="margin-bottom:12px;">@Model.Item.Excerpt</p>
            }

            <div class="contenido-html">
                @Html.Raw(Model.Item?.ContentHtml ?? "<p>Sin contenido disponible.</p>")
            </div>

            @* Manual relation boxes (conditions, symptoms, treatments) *@
            
            <section style="margin-top:26px;">
                <h4 style="margin:0 0 12px 0;color:#374151;">Datos relacionados</h4>
            <div class="manual-block" aria-label="Relaciones manuales">
                <div class="manual-box">
                    <h5>Condiciones</h5>
                    @if (Model.Item?.ManualCondiciones?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualCondiciones)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay condiciones relacionadas.</div>
                    }
                </div>

                <div class="manual-box">
                    <h5>Síntomas</h5>
                    @if (Model.Item?.ManualSintomas?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualSintomas)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay síntomas relacionados.</div>
                    }
                </div>

                <div class="manual-box">
                    <h5>Tratamientos</h5>
                    @if (Model.Item?.ManualTratamientos?.Any() == true)
                    {
                        foreach (var n in Model.Item.ManualTratamientos)
                        {
                            <div style="margin:6px 0;">• @n</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay tratamientos relacionados.</div>
                    }
                </div>
            </div>
            </section>
            @* Related contents (manual) placed after main content and manual boxes *@
            @if (Model.Item?.ManualRelated?.Any() == true)
            {
                <section style="margin-top:26px;">
                    <h4 style="margin:0 0 12px 0;color:#374151;">Artículos relacionados</h4>
                    @foreach (var r in Model.Item.ManualRelated)
                    {
                        <a href="@(Url.Page("/Contenidos/Detalle", new { slug = string.IsNullOrWhiteSpace(r.Slug) ? (object)r.Id : r.Slug }))" style="text-decoration:none;color:inherit;">
                            <div class="related-card" title="@r.Note">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Title" />
                                }
                                else
                                {
                                    <div style="width:64px;height:48px;background:#f3f6fa;border-radius:8px;flex:0 0 64px;"></div>
                                }
                                <div>
                                    <div style="display:flex;gap:8px;align-items:center;">
                                        <div class="r-title">@r.Title</div>
                                        <span style="background:#eef5ff;color:#24527a;padding:4px 8px;border-radius:999px;font-size:.72rem;margin-left:8px;">Manual</span>
                                    </div>
                                    <div class="r-meta">@r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                    @if (!string.IsNullOrWhiteSpace(r.Note))
                                    {
                                        <div style="font-size:.78rem;color:#6b7280;margin-top:4px;">@r.Note</div>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </section>
            }

            @* Related by categories *@
            @if (Model.Item?.RelatedByCategories?.Any() == true)
            {
                <section style="margin-top:24px;">
                    <h4 style="margin:0 0 12px 0;color:#374151;">Recomendados</h4>
                    @foreach (var r in Model.Item.RelatedByCategories)
                    {
                        <a href="@(Url.Page("/Contenidos/Detalle", new { slug = string.IsNullOrWhiteSpace(r.Slug) ? (object)r.Id : r.Slug }))" style="text-decoration:none;color:inherit;">
                            <div class="related-card" title="@r.Note">
                                @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Title" />
                                }
                                else
                                {
                                    <div style="width:64px;height:48px;background:#f3f6fa;border-radius:8px;flex:0 0 64px;"></div>
                                }
                                <div>
                                    <div class="r-title">@r.Title</div>
                                    <div class="r-meta">@r.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                        </a>
                    }
                </section>
            }

            @* Related questions *@
            @if (Model.Item?.ManualPreguntas?.Any() == true)
            {
                <section style="margin-top:24px;">
                    <h4 style="margin:0 0 12px 0;color:#374151;">Preguntas relacionadas</h4>
                    @foreach (var q in Model.Item.ManualPreguntas)
                    {
                        <div class="pregunta-card">
                            <a href="@(Url.Page("/Preguntas/Detalles", new { id = q.Id }))">
                                <div style="font-weight:700;color:#0b5cff;">@q.Title</div>
                                <div style="font-size:.85rem;color:#6b7280;">@q.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                            </a>
                        </div>
                    }
                </section>
            }
        </article>

        @* Right sidebar: author, date, share, read-time, categories, social, fallback message *@
        <aside class="right-panel" aria-labelledby="related-heading">
        

   

            <div class="social-list" aria-labelledby="social-heading">
                <h4 id="social-heading" style="margin:0 0 8px 0;font-size:.95rem;color:#374151;">Redes sociales</h4>
                <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px;">
                    <a class="badge-cat" href="#" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">Instagram</a>
                    <a class="badge-cat" href="#" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">Twitter</a>
                    <a class="badge-cat" href="#" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">Facebook</a>
                    <a class="badge-cat" href="#" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">YouTube</a>
                </div>
            </div>

            @* If there is no related content moved to main, show a fallback message here *@
            @if ((Model.Item?.ManualRelated?.Any() != true) && (Model.Item?.RelatedByCategories?.Any() != true) && (Model.Item?.ManualPreguntas?.Any() != true))
            {
                <div class="text-muted" style="font-size:.9rem; margin-top:12px;">No hay artículos o preguntas relacionadas.</div>
            }
        </aside>
    </div>
</div>