@model IReadOnlyList<eiibd26.Services.Cobertura.ExternoSimilarDto>
@*
    Motor de Cobertura (Fase 4) — vista paciente.
    Sitios externos con contenido similar a ESTE artículo. Enlaza SIEMPRE al original
    (nueva pestaña, rel="noopener nofollow"); nunca republica el contenido externo.
    La etiqueta de relación es protagonista; el % va discreto (transparencia).
*@
@if (Model != null && Model.Count > 0)
{
    <section class="eii-section" aria-label="Contenido similar en otros sitios">
        <h3 class="eii-section-title">Sobre este tema en otros sitios</h3>
        <p class="eii-text-muted eii-text-sm">
            Otros sitios de salud tratan este mismo tema. Enlazamos al sitio original —
            el contenido vive allí, no lo reproducimos aquí.
        </p>

        <div class="d-flex flex-column gap-3">
            @foreach (var e in Model)
            {
                <a class="eii-card eii-card--link eii-card--compact"
                   href="@e.Url" target="_blank" rel="noopener nofollow"
                   title="Abrir en @e.SitioNombre (nueva pestaña)">
                    <div class="eii-card__body d-flex flex-column gap-2">
                        <span class="eii-tag eii-bg-primary-soft eii-text-primary eii-fw-semibold">
                            <i class="bi bi-link-45deg"></i>&nbsp;@e.Etiqueta
                        </span>
                        <span class="eii-card__title">@e.Titulo</span>
                    </div>
                    <div class="eii-card__footer">
                        <span class="eii-card__meta">
                            <i class="bi bi-globe"></i>&nbsp;@e.SitioNombre
                        </span>
                        <span class="eii-text-muted eii-text-xs">@e.Porcentaje% de coincidencia</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
