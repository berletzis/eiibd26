@model IReadOnlyList<eiibd26.Services.Cobertura.ExternoSimilarDto>
@*
    Motor de Cobertura (Fase 6) — items de externos similares (embeddings).
    Renderiza SOLO las tarjetas <a> (sin contenedor): sirve tanto en el render inicial
    (dentro de su lista) como en la respuesta AJAX de "Ver más" (se agregan al final).
    Enlaza SIEMPRE al original (nueva pestaña, rel="noopener nofollow"); nunca republica.
    Señal única de score: "% de coincidencia" discreto (el nombre del tab comunica el rol).
*@
@if (Model != null)
{
    foreach (var e in Model)
    {
        <a class="eii-card eii-card--link eii-card--compact"
           href="@e.Url" target="_blank" rel="noopener nofollow"
           title="Abrir en @e.SitioNombre (nueva pestaña)">
            <div class="eii-card__body">
                <span class="eii-card__title">@e.Titulo</span>
            </div>
            <div class="eii-card__footer">
                <span class="eii-card__meta">
                    <i class="bi bi-globe"></i>&nbsp;@e.SitioNombre
                </span>
                <span class="eii-text-muted eii-text-xs">@e.Porcentaje% de coincidencia</span>
            </div>
        </a>
    }
}
