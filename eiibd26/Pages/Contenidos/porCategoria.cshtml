@page "/{categorySegment?}"
@model eiibd26.Pages.Contenidos.PorCategoriaModel
@using System.Globalization
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Contenidos por categoría";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        /* Page layout */

        .h1, .h2, .h3, .h4, .h5, .h6, h1, h2, h3, h4, h5, h6 {
            margin-top: 0;
            margin-bottom: var(--space-sm);
            font-weight: 700;
            line-height: var(--line-height-heading);
            color: var(--color-heading);
        }

        .conte-page {
            padding-top: var(--space-lg);
            padding-bottom: var(--space-xl);
        }

        .se-page-title {
            font-size: var(--font-size-4xl);
            font-weight: 800;
            color: var(--color-heading);
            padding-bottom: var(--space-lg);
        }

        /* Card header for filters */
        .se-header {
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            padding: 18px;
            box-sizing: border-box;
            margin-bottom: 12px;
        }

        /* Toggle header for filters */
        .filters-toggle-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0 8px 0;
            cursor: pointer;
            user-select: none;
        }

            .filters-toggle-header h3 {
                margin: 0;
                font-size: 0.9rem;
                font-weight: 400;
                color: #0f172a;
            }

            .filters-toggle-header .toggle-icon {
                font-size: 1.1rem;
                color: #6b7280;
                transition: transform .2s ease, color .2s ease;
            }

            .filters-toggle-header:hover .toggle-icon {
                color: #6a4e7a;
            }

            .filters-toggle-header[aria-expanded="true"] .toggle-icon {
                transform: rotate(180deg);
            }

        /* 3 columnas horizontales en desktop */
        .tags-blocks {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding-top: 12px;
        }

        /* Responsive: móvil mantiene 1 columna apilada */
        @@media (max-width: 991.98px) {
            .tags-blocks {
                grid-template-columns: 1fr;
            }
        }

        .tag-group {
            padding: 0px;
            border-radius: 8px;
            box-sizing: border-box;
            min-height: 36px;
        }

            .tag-group .group-title {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 6px 10px;
                color: #0f172a;
                font-size: 0.9rem;
                font-weight: 400;
            }

        .group-tags {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #f3f4f6;
            color: #0f172a;
            font-size: 0.9rem;
            cursor: pointer;
            border: 1px solid transparent;
            text-decoration: none;
            font-weight: 400;
        }

            .tag:focus {
                outline: 2px dashed rgba(106,78,122,0.35);
                outline-offset: 3px;
            }

            .tag.active {
                background: #f4edfc;
                color: #6a4e7a;
                border-color: #6a4e7a;
            }

        .more-tags-toggle {
            background: transparent;
            border: none;
            color: #6a4e7a;
            cursor: pointer;
            padding: 0;
            margin-left: 4px;
            font-size: .9rem;
        }

        /* Sección de login mejorada y compacta */
        .login-hint-box {
            padding: 0.875rem 1rem;
            margin-top: 0.75rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .login-hint-header {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .login-hint-icon {
            font-size: 1.5rem;
            color: #764ba2;
            flex-shrink: 0;
        }

        .login-hint-text {
            color: #4b5563;
            font-size: 0.9rem;
            font-weight: 400;
            line-height: 1.4;
        }

        .login-hint-actions {
            display: flex;
            gap: 0.65rem;
        }

        .btn-login-hint {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 400;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .btn-login-hint-primary {
            background: #7c3aed;
            color: white;
            border-color: #7c3aed;
        }

            .btn-login-hint-primary:hover {
                background: #6d28d9;
                border-color: #6d28d9;
                color: white;
            }

        .btn-login-hint-secondary {
            background: white;
            color: #7c3aed;
            border-color: #7c3aed;
        }

            .btn-login-hint-secondary:hover {
                background: #f3eeff;
                color: #6d28d9;
                border-color: #6d28d9;
            }

        @@media (max-width: 640px) {
            .login-hint-box {
                padding: 0.75rem;
            }

            .login-hint-header {
                gap: 0.5rem;
            }

            .login-hint-icon {
                font-size: 1.3rem;
            }

            .login-hint-text {
                font-size: 0.85rem;
            }

            .login-hint-actions {
                flex-direction: column;
                gap: 0.5rem;
            }

            .btn-login-hint {
                width: 100%;
                font-size: 0.85rem;
                padding: 0.45rem 0.875rem;
            }
        }

        /* Grid / cards */
        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
        }

        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }
        }

        .blog-card {
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ✅ ACTUALIZADO: Contenedor de imagen con posición relativa */
        .thumb {
            width: 100%;
            height: 160px;
            background: #f3f6fb;
            display: block;
            position: relative;
            overflow: hidden;
        }

            /* ✅ MEJORADO: Imagen con zoom y mejor centrado */
            .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center center;
                display: block;
                transform: scale(1.20);
                transition: transform 0.3s ease;
            }

            /* ✅ NUEVO: Efecto hover suave en la imagen */
            .thumb:hover img {
                transform: scale(1.25);
            }

        /* ✅ NUEVO: Categoría sobre la imagen con fondo gris */
        .blog-category-overlay {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(80, 80, 80, 0.85);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            max-width: 66.666%;
            box-sizing: border-box;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            z-index: 10;
            line-height: 1.2;
            pointer-events: none;
            user-select: none;
        }

        .content {
            background: #fff;
            padding: 16px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .blog-title {
            margin: var(--space-xs) 0;
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-heading);
            line-height: var(--line-height-heading);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

            .blog-title a {
                color: inherit;
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .blog-title a:hover {
                    color: var(--color-primary);
                }

        .blog-excerpt {
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
            line-height: 1.6;
            margin: 0 0 var(--space-md) 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .blog-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-sm);
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
        }

        .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #374151;
            font-size: .95rem;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            display: inline-block;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        /* Asegurar visibilidad del nombre del autor */
        .blog-footer .author span,
        .blog-footer .author a {
            color: #374151;
            font-size: .95rem;
            line-height: 1;
            display: inline-block;
        }

        .more-panel {
            display: none;
            margin-top: 12px;
            border-top: 1px dashed #e6eef6;
            padding-top: 12px;
            color: #6b7280;
        }

        .btn-more {
            font-size: .85rem;
        }

        .results-spinner {
            display: none;
            padding: 12px 0;
            color: #6b7280;
            text-align: center;
        }

        .no-results {
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            padding: 18px;
            color: #6b7280;
            text-align: center;
        }

        .load-more-wrap {
            display: flex;
            justify-content: center;
            margin-top: 28px;
            padding-top: 8px;
            width: 100%;
        }

        .more-toggle {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #2563eb;
            font-size: .95rem;
            cursor: pointer;
            text-decoration: underline;
            display: inline-block;
        }

            .more-toggle:focus {
                outline: 2px dashed #764ba2;
                outline-offset: 3px;
            }

        /* Breadcrumbs */
        nav[aria-label="breadcrumb"] ol {
            list-style: none;
            padding: 0;
            margin: 0 0 12px 0;
            display: inline-flex;
            align-items: center;
            gap: 0;
            flex-wrap: wrap;
            font-size: 0.95rem;
        }

            nav[aria-label="breadcrumb"] ol li {
                display: inline-flex;
                align-items: center;
                color: #6b7280;
                margin: 0;
            }

                nav[aria-label="breadcrumb"] ol li + li::before {
                    content: "›";
                    display: inline-block;
                    margin: 0 10px;
                    color: #cbd5e1;
                    font-size: 0.95rem;
                    line-height: 1;
                }

                nav[aria-label="breadcrumb"] ol li a {
                    color: #764ba2;
                    text-decoration: none;
                    transition: color .15s ease;
                }

                    nav[aria-label="breadcrumb"] ol li a:hover,
                    nav[aria-label="breadcrumb"] ol li a:focus {
                        text-decoration: underline;
                        color: #5a2d7a;
                        outline: none;
                    }

                nav[aria-label="breadcrumb"] ol li[aria-current="page"] {
                    color: #0f172a;
                    font-weight: 400;
                }

                    nav[aria-label="breadcrumb"] ol li[aria-current="page"] a {
                        color: inherit;
                        text-decoration: none;
                        pointer-events: none;
                    }

        @@media (max-width: 575.98px) {
            nav[aria-label="breadcrumb"] ol {
                font-size: 0.9rem;
                gap: 0;
            }

                nav[aria-label="breadcrumb"] ol li + li::before {
                    margin: 0 6px;
                }
        }
    </style>
}

<main class="conte-page" role="main" aria-label="Listado por categoría">
    <div class="container py-4">
        <h1 class="se-page-title">@Model.CategoryName</h1>

        <nav aria-label="breadcrumb">
            <ol>
                @foreach (var b in Model.Breadcrumbs)
                {
                    if (!b.IsCurrent)
                    {
                        <li><a href="@b.Url">@b.Title</a></li>
                    }
                    else
                    {
                        <li aria-current="page">@b.Title</li>
                    }
                }
            </ol>
        </nav>

        <div class="se-header" role="region" aria-label="Filtros de categoría">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <div class="filters-toggle-header" id="filtersToggle" role="button" tabindex="0" aria-expanded="false" aria-controls="tagsBlocksCollapse">
                    <h3>Filtro por tus datos agregados</h3>
                    <i class="bi bi-chevron-down toggle-icon"></i>
                </div>

                <div class="collapse" id="tagsBlocksCollapse">
                    <div class="tags-blocks" aria-label="Filtros por etiquetas">
                        @if (Model.AvailableConditions != null && Model.AvailableConditions.Any())
                        {
                            <div class="tag-group" aria-label="Condiciones">
                                <div class="group-title">Condiciones</div>
                                <div class="group-tags" data-group="conditions">
                                    @foreach (var tc in Model.AvailableConditions)
                                    {
                                        var active = Model.FilterConditionIds?.Contains(tc.Id) ?? false;
                                        <button type="button" class="tag @(active ? "active" : "")" data-filter-type="condition" data-id="@tc.Id">@tc.Name</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.AvailableSintomas != null && Model.AvailableSintomas.Any())
                        {
                            <div class="tag-group" aria-label="Síntomas">
                                <div class="group-title">Síntomas</div>
                                <div class="group-tags" data-group="sintomas">
                                    @foreach (var s in Model.AvailableSintomas)
                                    {
                                        var active = Model.FilterSintomaIds?.Contains(s.Id) ?? false;
                                        <button type="button" class="tag @(active ? "active" : "")" data-filter-type="sintoma" data-id="@s.Id">@s.Name</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.AvailableTratamientos != null && Model.AvailableTratamientos.Any())
                        {
                            <div class="tag-group" aria-label="Tratamientos">
                                <div class="group-title">Tratamientos</div>
                                <div class="group-tags" data-group="tratamientos">
                                    @foreach (var t in Model.AvailableTratamientos)
                                    {
                                        var active = Model.FilterTratamientoIds?.Contains(t.Id) ?? false;
                                        <button type="button" class="tag @(active ? "active" : "")" data-filter-type="tratamiento" data-id="@t.Id">@t.Name</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="login-hint-box">
                    <div class="login-hint-header">
                        <i class="bi bi-unlock login-hint-icon"></i>
                        <div class="login-hint-text">
                            Inicia sesión para filtrar contenidos por tus condiciones, síntomas y tratamientos agregados.
                        </div>
                    </div>
                    <div class="login-hint-actions">
                        <a href="/Identity/Account/Register?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-login-hint btn-login-hint-primary">
                            <i class="bi bi-person-plus"></i> Crear cuenta gratis
                        </a>
                        <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)" class="btn-login-hint btn-login-hint-secondary">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                        </a>
                    </div>
                </div>
            }
        </div>

        <section aria-label="Artículos por categoría">
            <div id="resultsSpinner" class="results-spinner">Cargando…</div>

            <div id="noResults" class="no-results" style="display:@((Model.Items == null || !Model.Items.Any()) ? "block" : "none")">
                <span style="font-weight:400;">No se encontro información</span><br />
                <span style="font-weight:300;"> Estamos trabajando para ofrecerte el mejor contenido relacionado a Condiciones, Sintomas, Tratamientos y complementos en la Comunidad Pacientes para Pacientes</span><br />
                <span style="font-weight:300;">Por el momento te invitamos a <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path + HttpContext.Request.QueryString)">registrarte o iniciar sesión</a> en la plataforma y utilizar las herramientas en la sección <a href="/Identity/Usuario/UsuarioEstadoAnimo">Mi Salud</a></span>
            </div>

            <div id="itemsContainer" class="items-container" style="display:@((Model.Items == null || !Model.Items.Any()) ? "none" : "grid")">
                @if (Model.Items != null && Model.Items.Any())
                {
                    @await Html.PartialAsync("~/Pages/Shared/_BlogItems.cshtml", Model.Items, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["categorySegment"] = (Model.CategorySegment ?? "") })
                }
            </div>

            <div class="load-more-wrap" id="loadMoreWrap" style="display:@(Model.TotalCount > (Model.Items?.Count ?? 0) ? "block" : "none")">
                <button id="loadMoreBtn" class="btn btn-outline-primary" data-nextpage="2" data-pagesize="@Model.PageSize" data-total="@Model.TotalCount">Cargar más</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            const pageSize = @Model.PageSize;
            const selectedIds = { condition: new Set(), sintoma: new Set(), tratamiento: new Set() };
            const spinner = document.getElementById('resultsSpinner');
            const itemsContainer = document.getElementById('itemsContainer');
            const noResultsEl = document.getElementById('noResults');
            const loadMoreWrap = document.getElementById('loadMoreWrap');

            const blogMoreUrl = '@Url.Page("/Home/BlogMore")';
            const categorySlugForAjax = encodeURIComponent('@(Model.CategorySegment ?? "")');

            // Funciones para manejar cookies
            function setCookie(name, value, days) {
                const d = new Date();
                d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
                document.cookie = name + "=" + value + ";expires=" + d.toUTCString() + ";path=/";
            }

            function getCookie(name) {
                const nameEQ = name + "=";
                const ca = document.cookie.split(';');
                for (let i = 0; i < ca.length; i++) {
                    let c = ca[i];
                    while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                    if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
                }
                return null;
            }

            // Initialize Bootstrap collapse with persistence, retrying until bootstrap is available
            document.addEventListener('DOMContentLoaded', function () {
                const collapseEl = document.getElementById('tagsBlocksCollapse');
                const toggleBtn = document.getElementById('filtersToggle');
                if (!collapseEl || !toggleBtn) return;

                function initCollapse() {
                    if (typeof bootstrap === 'undefined' || !bootstrap.Collapse) {
                        setTimeout(initCollapse, 50);
                        return;
                    }

                    const bsCollapse = new bootstrap.Collapse(collapseEl, { toggle: false });

                    // Restore saved state
                    const savedState = getCookie('categoria_filters_expanded');
                    if (savedState === 'true') {
                        bsCollapse.show();
                        toggleBtn.setAttribute('aria-expanded', 'true');
                    } else if (savedState === 'false') {
                        bsCollapse.hide();
                        toggleBtn.setAttribute('aria-expanded', 'false');
                    }

                    function toggleAction() {
                        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
                        if (isExpanded) {
                            bsCollapse.hide();
                            toggleBtn.setAttribute('aria-expanded', 'false');
                            setCookie('categoria_filters_expanded', 'false', 30);
                        } else {
                            bsCollapse.show();
                            toggleBtn.setAttribute('aria-expanded', 'true');
                            setCookie('categoria_filters_expanded', 'true', 30);
                        }
                    }

                    toggleBtn.addEventListener('click', toggleAction);
                    // keyboard accessibility: toggle with Enter or Space
                    toggleBtn.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleAction(); }
                    });

                    collapseEl.addEventListener('shown.bs.collapse', function() {
                        toggleBtn.setAttribute('aria-expanded', 'true');
                        setCookie('categoria_filters_expanded', 'true', 30);
                    });

                    collapseEl.addEventListener('hidden.bs.collapse', function() {
                        toggleBtn.setAttribute('aria-expanded', 'false');
                        setCookie('categoria_filters_expanded', 'false', 30);
                    });
                }

                initCollapse();
            });

            document.querySelectorAll('.tag.active').forEach(btn => {
                const type = btn.getAttribute('data-filter-type');
                const id = btn.getAttribute('data-id');
                if (type && id) selectedIds[type].add(id);
            });

            function showSpinner(show) { if (!spinner) return; spinner.style.display = show ? 'block' : 'none'; }

            function updateNoResultsAndContainer(hasItems) {
                if (hasItems) {
                    noResultsEl.style.display = 'none';
                    itemsContainer.style.display = 'grid';
                } else {
                    noResultsEl.style.display = 'block';
                    itemsContainer.style.display = 'none';
                    if (loadMoreWrap) loadMoreWrap.style.display = 'none';
                }
            }

            function resetLoadMoreUI() {
                const loadMoreBtn = document.getElementById('loadMoreBtn');
                if (!loadMoreBtn || !loadMoreWrap) return;
                loadMoreBtn.disabled = false;
                loadMoreBtn.textContent = 'Cargar más';
                loadMoreBtn.removeAttribute('aria-disabled');
                loadMoreWrap.style.display = 'block';
            }

            function markLoadMoreEnded() {
                const loadMoreBtn = document.getElementById('loadMoreBtn');
                if (!loadMoreBtn || !loadMoreWrap) return;
                loadMoreBtn.disabled = true;
                loadMoreBtn.textContent = 'No hay más registros que mostrar';
                loadMoreBtn.setAttribute('aria-disabled', 'true');
                loadMoreWrap.style.display = 'block';
            }

            async function loadItemsAjax(pageNumber = 1, append = false, pushToHistory = true) {
                try {
                    showSpinner(true);
                    const params = new URLSearchParams();
                    if (selectedIds.condition.size) params.set('conditionIds', Array.from(selectedIds.condition).join(','));
                    if (selectedIds.sintoma.size) params.set('sintomaIds', Array.from(selectedIds.sintoma).join(','));
                    if (selectedIds.tratamiento.size) params.set('tratamientoIds', Array.from(selectedIds.tratamiento).join(','));
                    params.set('pageNumber', String(pageNumber));
                    params.set('pageSize', String(pageSize));

                    const url = blogMoreUrl + '?CategorySlug=' + categorySlugForAjax + '&' + params.toString();
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) throw new Error('Error cargando items: ' + res.status);
                    const html = await res.text();

                    const totalHeader = res.headers.get('X-Total-Count');
                    const total = totalHeader ? parseInt(totalHeader, 10) : null;

                    // Parse returned HTML and extract only .blog-card nodes to avoid
                    // inserting a full document (which may include scripts or layout)
                    // that can cause SyntaxError/Unexpected end of input when browsers
                    // attempt to parse inline scripts. Use a temporary container and
                    // move only the .blog-card elements.
                    const temp = document.createElement('div');
                    // Use innerHTML but do NOT assign returned HTML wholesale to
                    // itemsContainer. We'll extract cards safely below.
                    temp.innerHTML = html;
                    const cards = temp.querySelectorAll('.blog-card');
                    const itemsFound = cards.length;

                    if (!append) {
                        // Replace current items with the returned cards only
                        itemsContainer.innerHTML = '';
                        if (itemsFound > 0) {
                            cards.forEach(function (c) { itemsContainer.appendChild(c); });
                        }
                        updateNoResultsAndContainer(itemsFound > 0);
                        resetLoadMoreUI();
                    } else {
                        if (itemsFound === 0) {
                            markLoadMoreEnded();
                        } else {
                            // Append only the card nodes
                            cards.forEach(function (c) { itemsContainer.appendChild(c); });
                        }
                    }

                    if (total !== null && loadMoreWrap) {
                        const loadMoreBtn = document.getElementById('loadMoreBtn');
                        const loadedCount = document.querySelectorAll('.blog-card').length;
                        if (loadMoreBtn) {
                            loadMoreBtn.setAttribute('data-total', String(total));
                            loadMoreBtn.setAttribute('data-nextpage', String(pageNumber + 1));
                            if (loadedCount >= total) loadMoreWrap.style.display = 'none'; else resetLoadMoreUI();
                        }
                    } else {
                        if (append) {
                            if (itemsFound > 0 && itemsFound < pageSize) markLoadMoreEnded();
                        } else {
                            if (itemsFound > 0 && itemsFound < pageSize && loadMoreWrap) loadMoreWrap.style.display = 'none';
                        }
                    }

                    if (pushToHistory) {
                        const stateUrl = new URL(window.location.href);
                        let basePath = stateUrl.pathname || '/';
                        const modelSeg = '@(Model.CategorySegment ?? "")'.trim();
                        if ((/\/Contenidos\/categoria\/?$/.test(basePath)) && modelSeg) {
                            basePath = basePath.replace(/\/+$/, '') + '/' + encodeURIComponent(modelSeg);
                        }
                        const q = params.toString();
                        const finalUrl = basePath + (q ? ('?' + q) : '');
                        history.pushState({}, '', finalUrl);
                    }
                } catch (e) {
                    console.error(e);
                } finally { showSpinner(false); }
            }

            document.addEventListener('click', function (e) {
                const tag = e.target.closest('.tag');
                if (tag) {
                    const type = tag.getAttribute('data-filter-type');
                    const id = tag.getAttribute('data-id');
                    if (!type || !id) return;
                    if (tag.classList.contains('active')) { tag.classList.remove('active'); selectedIds[type].delete(id); }
                    else { tag.classList.add('active'); selectedIds[type].add(id); }
                    loadItemsAjax(1, false, true);
                    return;
                }

                // NOTE: per-page '.more-toggle' handler removed in favor of centralized
                // `wwwroot/js/content-meta-loader.js` which handles '.btn-blog-more' via
                // delegated click events. This keeps behavior consistent for initial and
                // AJAX-loaded items.
            });

            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', async function () {
                    const next = parseInt(loadMoreBtn.getAttribute('data-nextpage') || '2', 10);
                    await loadItemsAjax(next, true, true);
                });
            }

            (function initNoResults() {
                const initialHasItems = document.querySelectorAll('.blog-card').length > 0;
                updateNoResultsAndContainer(initialHasItems);
                const initialCount = document.querySelectorAll('.blog-card').length;
                if (initialCount > 0 && initialCount < pageSize && loadMoreWrap) loadMoreWrap.style.display = 'none';
            })();
        })();
    </script>
    <script src="~/js/content-meta-loader.js" asp-append-version="true"></script>
}