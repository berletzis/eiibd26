@page "/Contenidos"
@model eiibd26.Pages.Contenidos.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Contenidos";
    var nextPage = (Model.PageNumber < 1) ? 2 : (Model.PageNumber + 1);
    const int TAG_PREVIEW = 12;
}

@section Styles {
    <style>
        /* Make layout match BlogMore/_BlogItems: image + content card with category above title */
        .conte-page {
            padding-top: 16px;
            padding-bottom: 24px;
        }

        .se-page-title {
            font-size: 2.1rem;
            font-weight: 250;
            letter-spacing: -0.06em;
            color: #172849;
            padding-bottom: 20px;
        }

        .se-header {
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            padding: 18px;
            box-sizing: border-box;
            margin-bottom: 12px;
        }

        .se-search {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding-bottom: 15px;
        }

        .se-search-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid #e6eef6;
            background: #f8fafc;
            color: #0f172a;
            box-sizing: border-box;
        }

            .se-search-input:focus {
                outline: 2px solid var(--se-link-hover);
                outline-offset: 2px;
            }

        .se-search-label {
            margin: 4px 0 0px 0;
            font-weight: 100;
            font-size: .9rem;
            padding-bottom: 15px;
        }

        .se-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            cursor: pointer;
            background: transparent;
            border: none;
            color: inherit;
        }

            .se-btn.se-btn-primary {
                background: #fff;
                color: #6a4e7a;
                border: 2px solid #e3e6e8;
                width: 48px;
                height: 48px;
                border-radius: 50%;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                box-shadow: none;
                transition: background .12s ease, border-color .12s ease, color .12s ease;
                line-height: 0;
            }

                .se-btn.se-btn-primary:hover {
                    background: #ecd9f7;
                    border-color: #6a4e7a;
                    color: #6a4e7a;
                }

        .tags-blocks {
            display: grid;
            grid-template-rows: 1fr 1fr 1fr;
            gap: 12px;
            align-items: start;
            margin-bottom: 16px;
            text-align: left;
        }

        @@media (min-width: 992px) {
            .tags-blocks {
                grid-template-rows: 1fr 1fr 1fr;
            }
        }

        .tag-group {
            padding: 0px;
            border-radius: 8px;
            box-sizing: border-box;
            min-height: 36px;
        }

            .tag-group .group-title {
                display: inline-flex;
                align-items: left;
                gap: 8px;
                padding: 6px 10px;
                color: #0f172a;
                font-size: 1rem;
            }

        .group-tags {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: flex-start;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #f3f4f6;
            color: #0f172a;
            font-size: .9rem;
            cursor: pointer;
            border: 1px solid transparent;
        }

            .tag:focus {
                outline: 2px dashed rgba(106,78,122,0.35);
                outline-offset: 3px;
            }

            .tag.active {
                background: #f4edfc;
                color: #6a4e7a;
                border-color: #6a4e7a;
            }

        .more-tags-toggle {
            background: transparent;
            border: none;
            color: #6a4e7a;
            cursor: pointer;
            padding: 0;
            margin-left: 4px;
            font-size: .9rem;
        }

        .items-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
            margin-bottom: 24px; /* add breathing room before load-more */
        }

        @@media (max-width: 991.98px) {
            .items-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .items-container {
                grid-template-columns: 1fr;
            }
        }

        .blog-card {
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .thumb {
            width: 100%;
            height: 220px;
            background: #f3f6fb;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
        }

            .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .content {
            background: #fff;
            padding: 16px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .category-pill {
            font-size: 12px;
            color: #2563eb;
            margin-bottom: 6px;
            display: inline-block;
            text-decoration: none;
        }

            .category-pill a {
                color: #2563eb;
                text-decoration: none;
            }

        .blog-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
        }

            .blog-title a {
                color: inherit;
                text-decoration: none;
            }

        .blog-excerpt {
            color: #6b7280;
            font-size: 0.95rem;
            line-height: 1.3;
        }

        .blog-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: #9ca3af;
            font-size: .9rem;
        }

        .author {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #374151;
            font-size: .95rem;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            display: inline-block;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .more-panel {
            display: none;
            margin-top: 12px;
            border-top: 1px dashed #e6eef6;
            padding-top: 12px;
            color: #6b7280;
        }

        .btn-more {
            font-size: .85rem;
        }

        /* Spinner: hide by default (prevents persistent "Cargando..." on load) */
        .results-spinner {
            display: none;
            padding: 12px 0;
            color: #6b7280;
            text-align: center;
        }

        /* Load more wrapper: center the button and add spacing from the grid */
        .load-more-wrap {
            display: flex;
            justify-content: center;
            margin-top: 28px;
            padding-top: 8px;
            width: 100%;
        }

        /* NEW: plain text toggle for + Más / - Menos (not a capsule) */
        .more-toggle {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #2563eb;
            font-size: .95rem;
            cursor: pointer;
            text-decoration: underline;
            display: inline-block;
        }

            .more-toggle:focus {
                outline: 2px dashed rgba(37,99,235,0.25);
                outline-offset: 3px;
            }
    </style>
}

<main class="conte-page" role="main" aria-label="Listado de contenidos">
    <div class="container py-4">
        <h1 class="se-page-title">Contenidos</h1>

        <div class="se-header" role="region" aria-label="Buscador de contenidos">
            <label for="cpcontenidoBuscar" class="se-search-label">
                Haz tu mejor pregunta; entre más específico seas, mayor será la probabilidad de encontrar resultados.
            </label>
            <form id="searchForm" class="se-search" onsubmit="event.preventDefault();" role="search" aria-label="Buscar contenidos">
                <input id="cpcontenidoBuscar" name="q" class="se-search-input no-right-border" placeholder="Ej: ¿Por qué duele el lado izquierdo?" aria-label="Buscar contenidos" value="@(Model.SearchQuery ?? "")" />
                <div style="display:flex; gap:8px; align-items:center;">
                    <button id="btnSearch" class="se-btn se-btn-primary" type="button" title="Buscar" aria-label="Buscar">
                        <i class="bi bi-search" style="font-size:1.05rem;"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- TAG GROUPS -->
        <div class="tags-blocks" role="region" aria-label="Filtros por etiquetas">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <div class="tag-group" aria-label="Condiciones">
                    <div class="group-tags" data-group="conditions">
                        <label class="group-title">Condiciones</label>
                        @if (Model.AvailableConditions != null && Model.AvailableConditions.Any())
                        {
                            var idx = 0;
                            foreach (var tc in Model.AvailableConditions)
                            {
                                var active = Model.FilterConditionIds?.Contains(tc.Id) ?? false;
                                var hiddenAttr = idx >= TAG_PREVIEW ? "data-hidden='true'" : "";
                                <button type="button" class="tag @(active ? "active" : "")" data-filter-type="condition" data-id="@tc.Id" tabindex="0" @Html.Raw(hiddenAttr)>@tc.Name</button>
                                idx++;
                            }
                            if (Model.AvailableConditions.Count > TAG_PREVIEW)
                            {
                                <button type="button" class="more-tags-toggle" data-toggle-group="conditions" aria-expanded="false">Ver más</button>
                            }
                        }
                        else
                        {
                            <span class="tag" aria-hidden="true">No hay condiciones</span>
                        }
                    </div>
                </div>

                <div class="tag-group" aria-label="Síntomas">
                    <div class="group-tags" data-group="sintomas">
                        <label class="group-title">Síntomas</label>
                        @if (Model.AvailableSintomas != null && Model.AvailableSintomas.Any())
                        {
                            var idx = 0;
                            foreach (var s in Model.AvailableSintomas)
                            {
                                var active = Model.FilterSintomaIds?.Contains(s.Id) ?? false;
                                var hiddenAttr = idx >= TAG_PREVIEW ? "data-hidden='true'" : "";
                                <button type="button" class="tag @(active ? "active" : "")" data-filter-type="sintoma" data-id="@s.Id" tabindex="0" @Html.Raw(hiddenAttr)>@s.Name</button>
                                idx++;
                            }
                            if (Model.AvailableSintomas.Count > TAG_PREVIEW)
                            {
                                <button type="button" class="more-tags-toggle" data-toggle-group="sintomas" aria-expanded="false">Ver más</button>
                            }
                        }
                        else
                        {
                            <span class="tag" aria-hidden="true">No hay síntomas</span>
                        }
                    </div>
                </div>

                <div class="tag-group" aria-label="Tratamientos">
                    <div class="group-tags" data-group="tratamientos">
                        <label class="group-title">Tratamientos</label>
                        @if (Model.AvailableTratamientos != null && Model.AvailableTratamientos.Any())
                        {
                            var idx = 0;
                            foreach (var t in Model.AvailableTratamientos)
                            {
                                var active = Model.FilterTratamientoIds?.Contains(t.Id) ?? false;
                                var hiddenAttr = idx >= TAG_PREVIEW ? "data-hidden='true'" : "";
                                <button type="button" class="tag @(active ? "active" : "")" data-filter-type="tratamiento" data-id="@t.Id" tabindex="0" @Html.Raw(hiddenAttr)>@t.Name</button>
                                idx++;
                            }
                            if (Model.AvailableTratamientos.Count > TAG_PREVIEW)
                            {
                                <button type="button" class="more-tags-toggle" data-toggle-group="tratamientos" aria-expanded="false">Ver más</button>
                            }
                        }
                        else
                        {
                            <span class="tag" aria-hidden="true">No hay tratamientos</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="vote-login-hint">
                    Inicia sesión para filtrar por tus condiciones, síntomas y tratamientos.
                    <a href="/Account/Login">Iniciar sesión</a>
                </div>
            }
        </div>

        <section aria-label="Artículos">
            <div id="resultsSpinner" class="results-spinner">Cargando…</div>

            <div id="noResults" class="no-results" style="display:@((Model.Items == null || !Model.Items.Any()) ? "block" : "none")">
                No se encontraron contenidos con los criterios especificados.
            </div>

            <div class="items-container" id="itemsContainer" style="display:@((Model.Items == null || !Model.Items.Any()) ? "none" : "grid")">
                @* Render cards matching the BlogMore/_BlogItems style: category above title, then excerpt, then footer *@
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <article class="blog-card" role="article" aria-labelledby="title-@item.Id" data-id="@item.Id">
                            <div class="thumb" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                                }
                                else
                                {
                                    <svg width="80" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                                }
                            </div>

                            <div class="content">
                                <div>
                                    @* category as small blue pill/link, inside the .category-pill div *@
                                    @if (!string.IsNullOrWhiteSpace(item.Category))
                                    {
                                        <div class="category-pill">@Html.Raw(item.Category)</div>
                                    }
                                    else if (item.Conditions != null && item.Conditions.Any())
                                    {
                                        var fallback = item.Conditions.First();
                                        <div class="category-pill">
                                            <a href="@Url.Page("/Contenidos/porCategoria", new { categorySegment = fallback })">@fallback</a>
                                        </div>
                                    }

                                    <h3 id="title-@item.Id" class="blog-title">
                                        <a href="@Url.Page("/Contenidos/Detalle", new { id = item.Id })">@item.Title</a>
                                    </h3>

                                    <div class="blog-excerpt">@item.Excerpt</div>
                                </div>

                                <div class="blog-footer" aria-hidden="false">
                                    <div class="author">
                                        <span class="avatar">
                                            <img src="~/img/avatar-placeholder.png" alt="@item.Author" />
                                        </span>
                                        <span>@item.Author</span>
                                    </div>
                                    <div class="pubdate">@item.CreatedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
                                </div>

                                <div style="margin-top:8px;">
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-more"
                                            data-content-id="@item.Id"
                                            aria-expanded="false"
                                            aria-controls="more-@item.Id"
                                            aria-label="Mostrar más información relacionada">
                                        + Más
                                    </button>
                                </div>

                                <div id="more-@item.Id" class="more-panel" data-loaded="false" aria-hidden="true">
                                    <div class="more-placeholder">Contenido relacionado no cargado. Haz clic en "+ Más" para ver más.</div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>

            <div class="load-more-wrap" id="loadMoreWrap" style="display:@(Model.TotalCount > (Model.Items?.Count ?? 0) ? "block" : "none")">
                <button id="loadMoreBtn" class="btn btn-outline-primary" data-nextpage="@nextPage" data-pagesize="@Model.PageSize" data-total="@Model.TotalCount">
                    Cargar más
                </button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            const pageSize = @Model.PageSize;
            const selectedIds = { condition: new Set(), sintoma: new Set(), tratamiento: new Set() };
            const spinner = document.getElementById('resultsSpinner');
            const searchInput = document.querySelector('.se-search-input');
            const btnSearch = document.getElementById('btnSearch');
            const noResultsEl = document.getElementById('noResults');
            const itemsContainer = document.getElementById('itemsContainer');
            const loadMoreWrap = document.getElementById('loadMoreWrap');

            // Initialize selected from server-rendered active tags
            document.querySelectorAll('.tag.active').forEach(btn => {
                const type = btn.getAttribute('data-filter-type');
                const id = btn.getAttribute('data-id');
                if (type && id) selectedIds[type].add(id);
            });

            function debounce(fn, wait) {
                let t;
                return function (...args) { clearTimeout(t); t = setTimeout(() => fn.apply(this, args), wait); };
            }

            function showSpinner(show) { if (!spinner) return; spinner.style.display = show ? 'block' : 'none'; }

            function updateNoResultsAndContainer(hasItems) {
                if (hasItems) {
                    noResultsEl.style.display = 'none';
                    itemsContainer.style.display = 'grid';
                } else {
                    noResultsEl.style.display = 'block';
                    itemsContainer.style.display = 'none';
                    if (loadMoreWrap) loadMoreWrap.style.display = 'none';
                }
            }

            async function loadItemsAjax(pageNumber = 1, append = false, pushToHistory = true) {
                try {
                    showSpinner(true);
                    const params = new URLSearchParams();
                    const q = (searchInput && searchInput.value) ? searchInput.value.trim() : '';
                    if (q) params.set('q', q);
                    if (selectedIds.condition.size) params.set('conditionIds', Array.from(selectedIds.condition).join(','));
                    if (selectedIds.sintoma.size) params.set('sintomaIds', Array.from(selectedIds.sintoma).join(','));
                    if (selectedIds.tratamiento.size) params.set('tratamientoIds', Array.from(selectedIds.tratamiento).join(','));
                    params.set('pageNumber', String(pageNumber));
                    params.set('pageSize', String(pageSize));

                    const url = '@Url.Page("/Home/BlogMore")' + '?' + params.toString();
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) throw new Error('Error cargando items: ' + res.status);
                    const html = await res.text();
                    const totalHeader = res.headers.get('X-Total-Count');
                    const total = totalHeader ? parseInt(totalHeader, 10) : null;

                    const temp = document.createElement('div');
                    temp.innerHTML = html;
                    const itemsFound = temp.querySelectorAll('.blog-card').length;

                    if (!append) {
                        if (itemsContainer) itemsContainer.innerHTML = html;
                    } else {
                        if (itemsContainer) {
                            while (temp.firstChild) itemsContainer.appendChild(temp.firstChild);
                        }
                    }

                    if (total !== null) {
                        const loadedCount = document.querySelectorAll('.blog-card').length;
                        const loadMoreBtn = document.getElementById('loadMoreBtn');
                        if (loadMoreBtn) {
                            loadMoreBtn.setAttribute('data-total', String(total));
                            if (loadedCount >= total) loadMoreWrap.style.display = 'none'; else loadMoreWrap.style.display = 'flex';
                        }
                    }

                    if (pushToHistory) {
                        const stateUrl = new URL(window.location.href);
                        stateUrl.searchParams.delete('q'); stateUrl.searchParams.delete('conditionIds'); stateUrl.searchParams.delete('sintomaIds'); stateUrl.searchParams.delete('tratamientoIds');
                        if (q) stateUrl.searchParams.set('q', q);
                        if (selectedIds.condition.size) stateUrl.searchParams.set('conditionIds', Array.from(selectedIds.condition).join(','));
                        if (selectedIds.sintoma.size) stateUrl.searchParams.set('sintomaIds', Array.from(selectedIds.sintoma).join(','));
                        if (selectedIds.tratamiento.size) stateUrl.searchParams.set('tratamientoIds', Array.from(selectedIds.tratamiento).join(','));
                        history.pushState({ q: q, cond: Array.from(selectedIds.condition), sint: Array.from(selectedIds.sintoma), trat: Array.from(selectedIds.tratamiento) }, '', stateUrl.toString());
                    }
                } catch (e) {
                    console.error(e);
                    alert('Error cargando contenidos.');
                } finally { showSpinner(false); }
            }

            const debouncedLoad = debounce(() => loadItemsAjax(1, false, true), 400);

            document.addEventListener('click', function (e) {
                const tag = e.target.closest('.tag');
                if (tag) {
                    const type = tag.getAttribute('data-filter-type');
                    const id = tag.getAttribute('data-id');
                    if (!type || !id) return;
                    if (tag.classList.contains('active')) { tag.classList.remove('active'); selectedIds[type].delete(id); }
                    else { tag.classList.add('active'); selectedIds[type].add(id); }
                    loadItemsAjax(1, false, true);
                }

                const mt = e.target.closest('.more-tags-toggle');
                if (mt) {
                    const group = mt.getAttribute('data-toggle-group');
                    const container = document.querySelector('.group-tags[data-group="' + group + '"]');
                    if (container) {
                        const hiddenBtns = container.querySelectorAll('[data-hidden="true"]');
                        const expanded = mt.getAttribute('aria-expanded') === 'true';
                        if (!expanded) { hiddenBtns.forEach(b => b.removeAttribute('data-hidden')); mt.setAttribute('aria-expanded', 'true'); mt.textContent = 'Ver menos'; }
                        else { hiddenBtns.forEach(b => b.setAttribute('data-hidden', 'true')); mt.setAttribute('aria-expanded', 'false'); mt.textContent = 'Ver más'; }
                    }
                }

                const moreBtn = e.target.closest('.btn-more');
                if (moreBtn) {
                    const contentId = moreBtn.getAttribute('data-content-id');
                    const panel = document.getElementById('more-' + contentId);
                    if (!panel) return;
                    const loaded = panel.getAttribute('data-loaded') === 'true';
                    if (loaded) { panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; moreBtn.setAttribute('aria-expanded', panel.style.display === 'block'); return; }

                    // load content meta fragment via fetch
                    fetch('@Url.Page("/Contenidos/ContentMeta")' + '?id=' + encodeURIComponent(contentId), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(r => r.text())
                        .then(html => {
                            panel.innerHTML = html;
                            panel.setAttribute('data-loaded', 'true');
                            panel.style.display = 'block';
                            moreBtn.setAttribute('aria-expanded', 'true');
                        }).catch(err => {
                            console.error(err);
                            panel.innerHTML = '<div style="color:#6b7280">Error cargando información relacionada.</div>';
                            panel.style.display = 'block';
                            panel.setAttribute('data-loaded', 'true');
                        });
                }
            });

            if (searchInput) { searchInput.addEventListener('input', debouncedLoad); searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); loadItemsAjax(1, false, true); } }); }
            if (btnSearch) btnSearch.addEventListener('click', () => loadItemsAjax(1, false, true));

            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', async function () {
                    const next = parseInt(loadMoreBtn.getAttribute('data-nextpage') || '2', 10);
                    try {
                        loadMoreBtn.disabled = true;
                        loadMoreBtn.textContent = 'Cargando...';
                        await loadItemsAjax(next, true, true);
                        loadMoreBtn.setAttribute('data-nextpage', String(next + 1));
                    } finally {
                        loadMoreBtn.disabled = false;
                        loadMoreBtn.textContent = 'Cargar más';
                    }
                });
            }

            window.addEventListener('popstate', function (e) {
                const state = e.state || {};
                // keep the UI consistent when navigating history
                loadItemsAjax(1, false, false);
            });

            // initial UI state
            (function initNoResults() {
                const initialHasItems = document.querySelectorAll('.blog-card').length > 0;
                updateNoResultsAndContainer(initialHasItems);
                // ensure spinner hidden on initial paint
                showSpinner(false);
            })();
        })();
    </script>
}