@page "/contenidos/porAutor/{slug}"
@model eiibd26.Pages.Contenidos.PorAutorModel
@using System.Globalization
@{
    ViewData["Title"] = $"Artículos de {Model.AutorNombre}";
    var avatarSrc = !string.IsNullOrWhiteSpace(Model.AutorAvatar) ? Model.AutorAvatar : Url.Content("~/img/avatar-placeholder.png");
}

@section Styles {
    <link rel="stylesheet" href="~/css/contenidos-cards.css" asp-append-version="true" />
    <style>
        .autor-items-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            align-items: start;
        }
        @@media (max-width: 991.98px) { .autor-items-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 575.98px) { .autor-items-grid { grid-template-columns: 1fr; } }
    </style>
}

<main class="container py-4" role="main" aria-label="Artículos por autor">

    <div class="eii-card mb-4 p-3 d-flex align-items-center gap-3">
        <img src="@avatarSrc"
             alt="@Model.AutorNombre"
             width="56" height="56"
             style="border-radius:50%; object-fit:cover; flex-shrink:0;"
             onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")'" />
        <div>
            <h1 class="eii-page-title mb-0">Artículos de @Model.AutorNombre</h1>
            <span class="eii-text-sm" style="color:var(--eii-text-disabled);">
                @Model.TotalCount artículo@(Model.TotalCount == 1 ? "" : "s") publicado@(Model.TotalCount == 1 ? "" : "s")
            </span>
        </div>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="eii-card text-center py-4">
            <p class="mb-0" style="color:var(--eii-text-soft);">Este autor aún no tiene artículos publicados.</p>
        </div>
    }
    else
    {
        <div class="autor-items-grid">
            @await Html.PartialAsync("~/Pages/Shared/_BlogItems.cshtml", Model.Items)
        </div>

        <div class="load-more-wrap text-center mt-4" id="loadMoreWrap"
             style="display:@(Model.TotalCount > (Model.Items?.Count ?? 0) ? "block" : "none")">
            <button id="loadMoreBtn" class="eii-btn eii-btn--primary"
                    data-pagesize="@Model.PageSize" data-total="@Model.TotalCount">
                Cargar más
            </button>
        </div>
    }

</main>

@section Scripts {
    <script src="~/js/content-meta-loader.js" asp-append-version="true"></script>
    <script>
    (function () {
        var page = 1;
        var pageSize = @Model.PageSize;
        var total = @Model.TotalCount;
        var btn = document.getElementById('loadMoreBtn');
        var container = document.querySelector('.autor-items-grid');
        if (!btn || !container) return;
        btn.addEventListener('click', function () {
            page++;
            var url = '?handler=Items&slug=@Model.AutorSlug&pageNumber=' + page + '&pageSize=' + pageSize;
            btn.disabled = true; btn.textContent = 'Cargando…';
            fetch(url, { credentials: 'same-origin' })
                .then(function (r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    var totalHeader = r.headers.get('X-Total-Count');
                    var serverTotal = totalHeader ? parseInt(totalHeader, 10) : NaN;
                    return r.text().then(function (html) { return { html: html, serverTotal: serverTotal }; });
                })
                .then(function (result) {
                    var temp = document.createElement('div');
                    temp.innerHTML = result.html;
                    Array.prototype.forEach.call(temp.children, function (c) { container.appendChild(c); });
                    var effectiveTotal = isNaN(result.serverTotal) ? total : result.serverTotal;
                    if (page * pageSize >= effectiveTotal) btn.style.display = 'none';
                })
                .catch(function (e) { console.error('Error cargando más artículos:', e); })
                .finally(function () {
                    if (btn.style.display !== 'none') {
                        btn.disabled = false; btn.textContent = 'Cargar más';
                    }
                });
        });
    })();
    </script>
}
