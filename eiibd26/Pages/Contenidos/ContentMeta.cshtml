
@page
@model eiibd26.Pages.Contenidos.ContentMetaModel
@{
    Layout = null; // fragment
}

@if (Model == null || Model.Item == null)
{
    <div style="color:#6b7280;">No hay información relacionada.</div>
}
else
{
    <div class="content-meta-fragment">
        <div style="margin-bottom:8px;">
            <strong>Condiciones:</strong>
            @if (Model.Item.Conditions.Any())
            {
                <span>@string.Join(", ", Model.Item.Conditions)</span>
            }
            else
            {
                <span class="text-muted">No hay condiciones relacionadas</span>
            }
        </div>

        <div style="margin-bottom:8px;">
            <strong>Síntomas:</strong>
            @if (Model.Item.Symptoms.Any())
            {
                <span>@string.Join(", ", Model.Item.Symptoms)</span>
            }
            else
            {
                <span class="text-muted">No hay síntomas relacionados</span>
            }
        </div>

        <div style="margin-bottom:8px;">
            <strong>Tratamientos:</strong>
            @if (Model.Item.Treatments.Any())
            {
                <span>@string.Join(", ", Model.Item.Treatments)</span>
            }
            else
            {
                <span class="text-muted">No hay tratamientos relacionados</span>
            }
        </div>

        <div style="margin-top:6px;">
            <strong>Preguntas relacionadas:</strong>
            <span>@Model.Item.RelatedQuestionsCount</span>
        </div>
    </div>
}