@page
@model eiibd26.Pages.Contenidos.ContentMetaModel
@{
    // This is a fragment returned to AJAX requests - no layout
    Layout = null;
}

<style>
    /* Estilos para el fragmento de información relacionada (scoped dentro del fragmento) */
    .content-meta-fragment {
        color: #374151;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        font-size: 0.95rem;
    }

        .content-meta-fragment .meta-row {
            display: block;
            margin-top: 8px;
        }

        .content-meta-fragment .meta-label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            color: #0f172a;
        }

        /* Listado de palabras (no cápsulas): palabras simples, separadas por guiones o comas visuales */
        .content-meta-fragment .meta-list {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .content-meta-fragment .meta-word {
            display: inline-block;
            color: #334155; /* texto principal */
            background: transparent; /* sin fondo */
            border: none; /* sin borde */
            padding: 0;
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Si quieres una distinción de color por tipo (opcional, sutil) */
        .content-meta-fragment .meta-conditions .meta-word {
            color: #0f5bd9;
        }
        /* azul para condiciones */
        .content-meta-fragment .meta-symptoms .meta-word {
            color: #c05621;
        }
        /* naranja para sintomas */
        .content-meta-fragment .meta-treatments .meta-word {
            color: #15803d;
        }
        /* verde para tratamientos */

        /* Pequeño muting para la fecha */
        .content-meta-fragment .meta-date {
            color: #6b7280;
            font-size: 0.85rem;
            margin-left: 8px;
        }

        /* Lista de preguntas relacionadas: simple, con bullets pero sin enlaces */
        .content-meta-fragment .related-questions {
            margin-top: 8px;
            padding-left: 18px;
            color: #374151;
        }

            .content-meta-fragment .related-questions li {
                margin-bottom: 6px;
                line-height: 1.25;
            }

            .content-meta-fragment .related-questions .q-title {
                color: #0f172a;
                font-weight: 500;
            }

            .content-meta-fragment .related-questions .q-date {
                color: #6b7280;
                font-size: 0.85rem;
                margin-left: 6px;
            }
</style>

<div class="content-meta-fragment" role="region" aria-label="Información relacionada">
    @if (Model.NotFound)
    {
        <div style="color:#6b7280">No se encontró información relacionada.</div>
    }
    else
    {
        <div style="display:block; margin-bottom:8px;">
            @if (Model.Conditions?.Any() ?? false)
            {
                <div class="meta-row meta-conditions" aria-label="Condiciones">
                    <div class="meta-label">Condiciones:</div>
                    <div class="meta-list" role="list">
                        @foreach (var c in Model.Conditions)
                        {
                            @* Render as plain word (no link, no capsule) *@
                            <span role="listitem" class="meta-word">@c</span>
                        }
                    </div>
                </div>
            }

            @if (Model.Symptoms?.Any() ?? false)
            {
                <div class="meta-row meta-symptoms" aria-label="Síntomas">
                    <div class="meta-label">Síntomas:</div>
                    <div class="meta-list" role="list">
                        @foreach (var s in Model.Symptoms)
                        {
                            <span role="listitem" class="meta-word">@s</span>
                        }
                    </div>
                </div>
            }

            @if (Model.Treatments?.Any() ?? false)
            {
                <div class="meta-row meta-treatments" aria-label="Tratamientos">
                    <div class="meta-label">Tratamientos:</div>
                    <div class="meta-list" role="list">
                        @foreach (var t in Model.Treatments)
                        {
                            <span role="listitem" class="meta-word">@t</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div style="margin-top:6px;">
            <strong>Preguntas relacionadas:</strong>
            @if (Model.RelatedQuestions != null && Model.RelatedQuestions.Any())
            {
                <ul class="related-questions" role="list">
                    @foreach (var q in Model.RelatedQuestions)
                    {
                        <li>
                            @* Render as plain text (no link) *@
                            <span class="q-title">@q.Title</span>
                            <small class="q-date">(@q.CreatedAt.ToString("yyyy-MM-dd"))</small>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div style="color:#6b7280; margin-top:6px;">No hay preguntas relacionadas.</div>
            }
        </div>
    }
</div>