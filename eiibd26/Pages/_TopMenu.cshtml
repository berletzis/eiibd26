@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using eiibd26.Data
@using eiibd26.Models
@using System
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var avatarSrc = Url.Content("~/img/default-avatar.png");
    string userId = null; string displayName = null; string userName = null;

    if (isAuth)
    {
        userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            try { var identityUser = await UserManager.FindByIdAsync(userId); if (identityUser != null) userName = identityUser.UserName; }
            catch { userName = userName ?? User?.Identity?.Name; }
        }
        else { userName = User?.Identity?.Name; }

        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                Perfil perfil = null;
                if (Guid.TryParse(userId, out var userGuid)) perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser == userGuid);
                else perfil = await Db.Set<Perfil>().FirstOrDefaultAsync(p => p.idUser.ToString() == userId);

                if (perfil != null && !string.IsNullOrWhiteSpace(perfil.Nombre))
                {
                    displayName = perfil.Nombre + (string.IsNullOrWhiteSpace(perfil.Apellidos) ? "" : " " + perfil.Apellidos);
                }
            }
            catch { }
        }

        displayName = displayName ?? User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "Usuario";

        var env = Context.RequestServices.GetService(typeof(IWebHostEnvironment)) as IWebHostEnvironment;
        if (!string.IsNullOrEmpty(userId) && env != null)
        {
            try
            {
                var physicalPath = System.IO.Path.Combine(env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                if (System.IO.File.Exists(physicalPath)) avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
            }
            catch { avatarSrc = Url.Content("~/img/default-avatar.png"); }
        }
    }

    // helper to mark active item
    var rawPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    if (string.IsNullOrEmpty(rawPath)) rawPath = "/";
    string GetFirstSegment(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "/") return "/";
        var trimmed = path.Trim('/');
        var parts = trimmed.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? "/" + parts[0].ToLowerInvariant() : "/";
    }
    var currentFirst = GetFirstSegment(rawPath);
    Func<string, bool> IsActivePath = seg =>
    {
        if (string.IsNullOrEmpty(seg)) return false;
        var normSeg = seg.StartsWith("/") ? seg.TrimEnd('/') : ("/" + seg.TrimEnd('/'));
        if (normSeg == "/") return currentFirst == "/";
        var segFirst = GetFirstSegment(normSeg);
        return string.Equals(segFirst, currentFirst, StringComparison.OrdinalIgnoreCase);
    };
    Func<string, string> ActiveClass = seg => IsActivePath(seg) ? " active" : "";
}
<header>
    <style>
        /* local styles; prefer moving to site-responsive.css later */
        .topbar {
            background: #f8fafc;
            border-bottom: 1px solid #e9ecef;
            z-index: 1100;
        }

        .brand-img {
            height: 38px;
            object-fit: contain;
        }

        .mobile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(0,0,0,0.06);
        }

        .offcanvas-menu .offcanvas-body {
            padding: 1rem;
        }

        .offcanvas-user {
            border-top: 1px solid #e9ecef;
            padding-top: 12px;
            margin-top: 12px;
        }

            .offcanvas-user .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }

        .offcanvas-nav .nav-link {
            padding: 6px 0;
            display: block;
            color: #0f172a;
        }

        .topbar .nav-link.active {
            color: #6a4e7a;
            font-weight: 600;
        }

        /* Tree / submenu styling for offcanvas: no bullets, indented open lists */
        .offcanvas-nav ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .offcanvas-nav li {
            margin: 4px 0;
        }

        .offcanvas-nav .submenu {
            padding-left: 14px;
            margin-top: 6px;
        }

        .offcanvas-nav .has-children > .nav-link::after {
            content: '▾';
            float: right;
            font-size: 0.9rem;
            color: #6b7280;
        }

        .offcanvas-nav .collapse-sub {
            display: block;
        }
        /* default expanded */
        .offcanvas-nav a {
            text-decoration: none;
            color: inherit;
        }

        /* visual improvements */
        .offcanvas {
            width: 320px;
            max-width: 86%;
        }
    </style>

    <nav class="navbar navbar-expand-lg topbar">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/"><img src="~/img/logo.png" class="brand-img" alt="eiibd26 logo" /></a>

            @* mobile avatar for quick session visual (left of toggler) *@
            @if (isAuth)
            {
                <div class="d-lg-none me-2 d-flex align-items-center">
                    <img src="@avatarSrc" alt="Avatar" class="mobile-avatar" />
                </div>
            }

            @* Hamburger toggler -> inline SVG fallback if Bootstrap icon unavailable *@
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#topbarOffcanvas" aria-controls="topbarOffcanvas" aria-label="Abrir menú">
                @* Prefer built-in icon, but include inline SVG fallback to ensure visibility *@
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
                <svg class="d-inline-block d-lg-none" width="22" height="16" viewBox="0 0 22 16" aria-hidden="true" focusable="false" style="vertical-align:middle;">
                    <rect width="22" height="2" y="0" rx="1" fill="#222"></rect>
                    <rect width="22" height="2" y="7" rx="1" fill="#222"></rect>
                    <rect width="22" height="2" y="14" rx="1" fill="#222"></rect>
                </svg>
            </button>

            @* Desktop inline menu (visible lg+) *@
            <div class="collapse navbar-collapse d-none d-lg-flex" id="topbarCenterCollapse">
                <ul class="navbar-nav me-auto align-items-center">
                    <li class="nav-item"><a class="nav-link@(ActiveClass("/"))" href="/"><i class="bi bi-house-door-fill"></i>&nbsp;Inicio</a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center@(ActiveClass("/Contenidos"))" href="/Contenidos"><i class="bi bi-search"></i><span>&nbsp;Buscador</span></a></li>
                    <li class="nav-item"><a class="nav-link d-flex align-items-center@(ActiveClass("/Preguntas"))" href="/Preguntas"><i class="bi bi-view-stacked"></i><span>&nbsp;Preguntas y Respuestas</span></a></li>

                    @* Existing partial menus (kept) *@
                    <partial name="~/Pages/Shared/_CategoryMenuPartial.cshtml" />
                    <partial name="~/Pages/Shared/_menuContenidoPartial.cshtml" />
                </ul>

                @* Desktop right side user area *@
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (!isAuth)
                    {
                        <li class="nav-item"><a class="nav-link@(ActiveClass("/Identity/Account/Login"))" href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión</a></li>
                        <li class="nav-item"><a class="nav-link@(ActiveClass("/Identity/Account/Register"))" href="/Identity/Account/Register"><i class="bi bi-person-plus me-1"></i> Registro</a></li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center@(ActiveClass("/Identity/Account/Manage"))" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarSrc" alt="Mi avatar" class="rounded-circle me-2" style="height:28px;width:28px;object-fit:cover;border:1px solid rgba(0,0,0,0.06);" />
                                <span class="me-1">@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-start">
                                        <img src="@avatarSrc" alt="Avatar" class="rounded-circle me-2" style="height:36px;width:36px;object-fit:cover;border:1px solid rgba(0,0,0,0.06);" />
                                        <div>
                                            <div class="fw-semibold">@displayName</div>
                                            @if (!string.IsNullOrEmpty(userName))
                                            {
                                                <div class="small text-muted">Usuario: @userName</div>
                                            }
                                            else if (!string.IsNullOrEmpty(userId))
                                            {
                                                <div class="small text-muted">Usuario: @userId</div>
                                            }
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/UsuarioPerfil">Perfil público</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage">Usuario/Registro</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/Email">Cambiar email</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Manage/ChangePassword">Cambiar contraseña</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item d-flex align-items-center"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>

            @* Offcanvas for mobile (contains same menu + user area) *@
            @* Offcanvas for mobile (contains same menu + user area) *@
            <div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="topbarOffcanvas" aria-labelledby="topbarOffcanvasLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="topbarOffcanvasLabel"><img src="~/img/logo.png" alt="eiibd26" style="height:34px;object-fit:contain;" /></h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                </div>

                <div class="offcanvas-body offcanvas-menu">
                    <nav class="offcanvas-nav mb-3">
                        <ul>
                            <li><a class="nav-link@(ActiveClass("/"))" href="/">Inicio</a></li>
                            <li><a class="nav-link@(ActiveClass("/Contenidos"))" href="/Contenidos">Buscador</a></li>
                            <li><a class="nav-link@(ActiveClass("/Preguntas"))" href="/Preguntas">Preguntas y Respuestas</a></li>

                            @* Insert partials directly for mobile — avoid adding an extra header that duplicates the partial content *@
                            <li class="mobile-partial">
                                <partial name="~/Pages/Shared/_CategoryMenuPartial.cshtml" />
                            </li>

                            <li class="mobile-partial">
                                <partial name="~/Pages/Shared/_menuContenidoPartial.cshtml" />
                            </li>
                        </ul>
                    </nav>

                    <div class="offcanvas-user">
                        @if (!isAuth)
                        {
                            <div class="mb-2">
                                <a class="btn btn-outline-primary w-100 mb-2" href="/Identity/Account/Login">Iniciar sesión</a>
                                <a class="btn btn-outline-secondary w-100" href="/Identity/Account/Register">Registro</a>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="@avatarSrc" alt="Avatar" class="avatar" />
                                <div>
                                    <div class="fw-semibold">@displayName</div>
                                    <div class="small text-muted">@userName</div>
                                </div>
                            </div>

                            <div>
                                <a class="d-block py-1" href="/Identity/Account/Manage/UsuarioPerfil">Perfil público</a>
                                <a class="d-block py-1" href="/Identity/Account/Manage">Usuario/Registro</a>
                                <a class="d-block py-1" href="/Identity/Account/Manage/Email">Cambiar email</a>
                                <a class="d-block py-1" href="/Identity/Account/Manage/ChangePassword">Cambiar contraseña</a>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="mt-2">
                                    <button type="submit" class="btn btn-outline-danger w-100">Cerrar sesión</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

@section Scripts {
    <script>
        (function () {
            // Auto-expand or collapse children in offcanvas: toggle on header click.
            document.addEventListener('click', function (e) {
                var h = e.target.closest('.has-children > .nav-link');
                if (!h) return;
                var li = h.parentElement;
                var submenu = li.querySelector('.submenu');
                if (!submenu) return;
                // toggle class to collapse (we show by default)
                if (submenu.classList.contains('collapse-sub')) {
                    submenu.classList.remove('collapse-sub');
                    h.querySelector && (h.querySelector('::after'));
                } else {
                    submenu.classList.add('collapse-sub');
                }
                e.preventDefault();
            });

            // Ensure toggler icon visible if Bootstrap provides no background
            // (Bootstrap normally sets .navbar-toggler-icon background; our SVG fallback ensures visibility)
            // No-op here; kept for future enhancements.
        })();
    </script>
}