@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;

    // Default avatar (virtual path)
    var avatarSrc = Url.Content("~/img/default-avatar.png");

    if (isAuth)
    {
        // Intentamos obtener el id del usuario (GUID) desde el claim NameIdentifier
        var userId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            // Intentamos resolver si el archivo físico existe en wwwroot/uploads/avatars/{userId}/avatar-64.png
            var env = Context.RequestServices.GetService(typeof(IWebHostEnvironment)) as IWebHostEnvironment;
            if (env != null)
            {
                try
                {
                    var physicalPath = System.IO.Path.Combine(env.WebRootPath ?? "wwwroot", "uploads", "avatars", userId, "avatar-64.png");
                    if (System.IO.File.Exists(physicalPath))
                    {
                        // Usamos la ruta virtual para mostrar el avatar en la vista
                        avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
                    }
                }
                catch
                {
                    // en caso de error dejamos avatar por defecto
                    avatarSrc = Url.Content("~/img/default-avatar.png");
                }
            }
            else
            {
                // Si no tenemos IWebHostEnvironment, intentamos construir la ruta virtual de todos modos
                avatarSrc = Url.Content($"~/uploads/avatars/{userId}/avatar-64.png");
            }
        }
    }
}
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="~/img/logo.png" alt="eiibd26 logo" height="38"
                     style="max-height:38px;max-width:140px;object-fit:contain;" />
            </a>

            <button class="navbar-toggler" type="button"
                    title="Abrir menú principal" aria-label="Abrir menú principal"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Menú principal izquierda -->
                <ul class="navbar-nav me-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Inicio</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Privacy">Privacidad</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" href="/Preguntas" title="Ir a Preguntas y Respuestas" aria-label="Preguntas y Respuestas">
                            <i class="bi bi-person-circle me-1"></i>
                            <span>Preguntas y Respuestas</span>
                        </a>
                    </li>

                    @* "Ir a Mi Perfil" se mantiene a la izquierda y sólo se muestra si está autenticado.
                       Ahora el ícono es la fotografía almacenada en wwwroot/uploads/avatars/{GUID}/avatar-64.png *@
                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" href="/Identity/Usuario/UsuarioPerfil" title="Ir a mi perfil" aria-label="Ir a mi perfil">
                                <img src="@avatarSrc"
                                     alt="Mi avatar"
                                     class="rounded-circle me-2"
                                     style="height:28px;width:28px;object-fit:cover;border:1px solid rgba(0,0,0,0.06);" />
                                <span>Ir a Mi Perfil</span>
                            </a>
                        </li>
                    }
                </ul>

                <!-- Menú de usuario derecha: Login & Registro (cuando NO está autenticado)
                     y el dropdown "Mis datos de inicio de sesión" (cuando SÍ está autenticado) -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (!isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Register">
                                <i class="bi bi-person-plus me-1"></i> Registro
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="perfilDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false"
                               title="Mis datos de inicio de sesión" aria-label="Mis datos de inicio de sesión">
                                @* Icono cambiado a engranaje *@
                                <i class="bi bi-gear-fill me-1" aria-hidden="true"></i>
                                <span>Mis datos de inicio de sesión</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Identity/Account/Manage">
                                        <i class="bi bi-person-card me-1"></i>
                                        <span>Perfil principal</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Identity/Account/Manage/Email">
                                        <i class="bi bi-envelope me-1"></i> Cambiar email
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Identity/Account/Manage/ChangePassword">
                                        <i class="bi bi-key me-1"></i> Cambiar contraseña
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Identity/Account/Manage/TwoFactorAuthentication">
                                        <i class="bi bi-shield-lock me-1"></i> Doble factor
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Identity/Account/Manage/ExternalLogins">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Logins externos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>