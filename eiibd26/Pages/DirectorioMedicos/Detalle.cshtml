@page "{id:int}"
@model eiibd26.Pages.DirectorioMedicos.DetalleModel
@using eiibd26.Models.Directorio.Enums
@{
    ViewData["Title"] = $"{Model.Medico!.NombreCompleto} — Directorio EII";
    Layout = "_Layout";

    var ogTitle   = Model.Medico.NombreCompleto;
    var ogDesc    = string.IsNullOrWhiteSpace(Model.Medico.Especialidad)
        ? $"Perfil del especialista {Model.Medico.NombreCompleto} en el directorio de médicos de EIIBD."
        : $"{Model.Medico.Especialidad} · {Model.Medico.NombreCompleto} — Directorio de médicos EIIBD.";
    var ogImage   = !string.IsNullOrWhiteSpace(Model.Medico.Foto)
        ? $"{Request.Scheme}://{Request.Host}{Model.Medico.Foto}"
        : $"{Request.Scheme}://{Request.Host}/img/logo.png";
    var ogUrl     = $"{Request.Scheme}://{Request.Host}{Request.Path}";
}

@section Head {
    <meta name="description" content="@ogDesc" />
    <meta property="og:type"        content="profile" />
    <meta property="og:title"       content="@ogTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:image"       content="@ogImage" />
    <meta property="og:url"         content="@ogUrl" />
    <meta name="twitter:card"       content="summary" />
    <meta name="twitter:title"      content="@ogTitle" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image"      content="@ogImage" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/directorio-medicos.css" asp-append-version="true" />
}

<div class="container py-4">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <h1 class="eii-page-title">@Model.Medico.NombreCompleto</h1>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="crm-card mb-4">
                <div class="d-flex gap-3 align-items-start">
                    <div class="medico-card__avatar" style="width:64px;height:64px;font-size:2rem;overflow:hidden;">
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.Foto))
                        {
                            <img src="@Model.Medico.Foto" alt="@Model.Medico.NombreCompleto"
                                 style="width:64px;height:64px;object-fit:cover;border-radius:50%;" loading="lazy" />
                        }
                        else
                        {
                            <i class="bi bi-person-badge-fill"></i>
                        }
                    </div>
                    <div class="flex-grow-1">
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.Especialidad))
                        {
                            <p class="text-muted mb-1">@Model.Medico.Especialidad
                                @if (!string.IsNullOrWhiteSpace(Model.Medico.Subespecialidad))
                                {<span> · @Model.Medico.Subespecialidad</span>}
                            </p>
                        }
                        @if (Model.BadgesDirectorio.Any())
                        {
                            <div class="mb-2">
                                <partial name="_MedicoBadges" model="Model.BadgesDirectorio" />
                            </div>
                        }
                        @{
                            bool _comunidadOk = Model.Medico.NivelConfianza >= NivelConfianzaEnum.Confirmado;
                            bool _verificadoOk = Model.Medico.NivelConfianza >= NivelConfianzaEnum.Reconocido
                                                 || Model.Medico.EstatusValidacion == EstatusValidacionCedula.Validado;
                            bool _reclamadoOk  = Model.Medico.NivelConfianza == NivelConfianzaEnum.Establecido;
                        }
                        <div class="d-flex flex-wrap gap-2 mt-2 mb-1">

                            @if (_comunidadOk)
                            {
                                <span class="badge" style="background-color:var(--eii-primary);font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-people-fill me-1"></i> Validado por la comunidad
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border" style="font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-people me-1"></i> Validado por la comunidad
                                    <small class="ms-1">(@Model.TotalConfirmaciones/3)</small>
                                </span>
                            }

                            @if (_verificadoOk)
                            {
                                <span class="badge bg-primary" style="font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-patch-check me-1"></i> Verificado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border" style="font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-patch-check me-1"></i> Verificado
                                </span>
                            }

                            @if (_reclamadoOk)
                            {
                                <span class="badge bg-success" style="font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-patch-check-fill me-1"></i> Médico verificado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border" style="font-size:.8rem;padding:5px 10px;">
                                    <i class="bi bi-patch-check-fill me-1"></i> Médico verificado
                                </span>
                            }

                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="crm-card h-100">
                        <h6 class="crm-label mb-3"><i class="bi bi-geo-alt me-1"></i>Ubicación</h6>
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.Estado))
                        { <p class="mb-1"><strong>Estado:</strong> @Model.Medico.Estado</p> }
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.Ciudad))
                        { <p class="mb-1"><strong>Ciudad:</strong> @Model.Medico.Ciudad</p> }
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.MunicipioAlcaldia))
                        { <p class="mb-1"><strong>Municipio/Alcaldía:</strong> @Model.Medico.MunicipioAlcaldia</p> }

                        @if (Model.UbicacionesCombinadas.Any())
                        {
                            <h6 class="crm-label mt-3 mb-2"><i class="bi bi-hospital me-1"></i>Consultorios / Hospitales</h6>
                            @foreach (var ub in Model.UbicacionesCombinadas)
                            {
                                <div class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-geo-alt-fill text-primary mt-1" style="flex-shrink:0;"></i>
                                    <div>
                                        <div class="fw-semibold small">@ub.Hospital</div>
                                        @if (!string.IsNullOrWhiteSpace(ub.Ciudad) || !string.IsNullOrWhiteSpace(ub.Estado))
                                        {
                                            <div class="text-muted" style="font-size:.78rem;">@string.Join(", ", new[]{ub.Ciudad, ub.Estado}.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                                        }
                                        @if (ub.Fuente == "medico")
                                        {
                                            <span class="badge bg-success-subtle text-success" style="font-size:.65rem;">✓ Confirmado por médico</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size:.65rem;">
                                                Reportado por @ub.Reportes paciente@(ub.Reportes != 1 ? "s" : "")
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.Medico.HospitalClinica))
                        {
                            <p class="mb-0"><strong>Hospital/Clínica:</strong> @Model.Medico.HospitalClinica</p>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="crm-card h-100">
                        <h6 class="crm-label mb-3"><i class="bi bi-clipboard2-pulse me-1"></i>Confirmaciones comunitarias</h6>
                        <p class="mb-2">
                            <strong>@Model.Medico.TotalPacientesUnicos</strong>
                            paciente@(Model.Medico.TotalPacientesUnicos != 1 ? "s" : "") de la comunidad
                            @(Model.Medico.TotalPacientesUnicos != 1 ? "han" : "ha") reportado atención.
                        </p>
                        @if (Model.Medico.ConfirmacionesAgregadas.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var conf in Model.Medico.ConfirmacionesAgregadas.OrderByDescending(c => c.Total))
                                {
                                    <li class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                        <span class="text-muted">@conf.NombreTipo</span>
                                        <span class="badge bg-primary">@conf.Total</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            @if (Model.Medico.AreasExperiencia.Any())
            {
                <div class="crm-card mb-4">
                    <h6 class="crm-label mb-3"><i class="bi bi-tags me-1"></i>Áreas de experiencia EII reportadas</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var area in Model.Medico.AreasExperiencia)
                        { <span class="se-rel-badge">@area.Nombre</span> }
                    </div>
                    <p class="text-muted mt-2 mb-0">
                        Áreas reportadas por pacientes. No implican especialización certificada.
                    </p>
                </div>
            }

            @* Biografía — solo si el médico la ingresó *@
            @if (!string.IsNullOrWhiteSpace(Model.Medico.Biografia))
            {
                <div class="crm-card mb-4">
                    <h6 class="crm-label mb-3"><i class="bi bi-file-person me-1"></i>Acerca del médico</h6>
                    <p class="mb-0" style="white-space:pre-line;">@Model.Medico.Biografia</p>
                </div>
            }

            @* Horarios de atención — solo si los ingresó *@
            @if (!string.IsNullOrWhiteSpace(Model.Medico.HorariosAtencion))
            {
                <div class="crm-card mb-4">
                    <h6 class="crm-label mb-3"><i class="bi bi-clock me-1"></i>Horarios de atención</h6>
                    <p class="mb-0" style="white-space:pre-line;">@Model.Medico.HorariosAtencion</p>
                </div>
            }

            @* Contacto y redes — solo si hay al menos un dato *@
            @if (!string.IsNullOrWhiteSpace(Model.Medico.SitioWeb) ||
                 !string.IsNullOrWhiteSpace(Model.Medico.Instagram) ||
                 !string.IsNullOrWhiteSpace(Model.Medico.LinkedIn))
            {
                <div class="crm-card mb-4">
                    <h6 class="crm-label mb-3"><i class="bi bi-link-45deg me-1"></i>Contacto y redes</h6>
                    <div class="d-flex flex-column gap-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.SitioWeb))
                        {
                            <a href="@Model.Medico.SitioWeb" target="_blank" rel="noopener noreferrer"
                               class="d-flex align-items-center gap-2 text-decoration-none">
                                <i class="bi bi-globe text-primary"></i>
                                <span class="small">@Model.Medico.SitioWeb</span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.Instagram))
                        {
                            <a href="https://instagram.com/@Model.Medico.Instagram.TrimStart('@')"
                               target="_blank" rel="noopener noreferrer"
                               class="d-flex align-items-center gap-2 text-decoration-none">
                                <i class="bi bi-instagram" style="color:#e1306c;"></i>
                                <span class="small">@@@Model.Medico.Instagram.TrimStart('@')</span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Medico.LinkedIn))
                        {
                            <a href="@Model.Medico.LinkedIn" target="_blank" rel="noopener noreferrer"
                               class="d-flex align-items-center gap-2 text-decoration-none">
                                <i class="bi bi-linkedin" style="color:#0077b5;"></i>
                                <span class="small">LinkedIn</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.CanInteractAsPaciente)
            {
                <div class="crm-card mb-4 medico-confirm-card">
                    <h6 class="crm-label mb-3"><i class="bi bi-person-check me-1"></i>¿Recibiste atención de este médico?</h6>
                    @if (Model.Medico.UsuarioYaConfirmo)
                    {
                        <p class="text-muted mb-2">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                            Ya aportaste tu experiencia. Puedes agregar más tipos de atención.
                        </p>
                    }
                    <form method="post" asp-page-handler="Confirmar" class="d-flex gap-2 align-items-end flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ConfirmarVm.MedicoDirectorioId" />
                        <div class="flex-grow-1">
                            <label class="crm-label mb-1">Tipo de atención recibida</label>
                            <select asp-for="ConfirmarVm.TipoConfirmacionId" class="form-select form-select-sm" required>
                                <option value="">Selecciona…</option>
                                @foreach (var tipo in Model.TiposConfirmacion)
                                {
                                    var yaConfirmado = Model.Medico.TiposConfirmadosPorUsuario.Contains(tipo.Id);
                                    if (yaConfirmado)
                                    {
                                        <option value="@tipo.Id" disabled>@tipo.Nombre ✓</option>
                                    }
                                    else
                                    {
                                        <option value="@tipo.Id">@tipo.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="submit"
                                title="Confirmar"
                                style="width:38px;height:38px;border-radius:50%;background-color:var(--eii-primary);border:none;color:#fff;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </form>
                    <p class="text-muted mt-2 mb-0">
                        Tu identidad no será visible públicamente. Solo el total agregado se muestra.
                    </p>
                </div>
            }
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <div class="vote-auth-notice mb-4">
                    <span>¿Recibiste atención de este médico?</span>
                    <a asp-area="Identity" asp-page="/Account/Login">Inicia sesión para confirmarlo</a>
                </div>
            }

            @* Confirmación simple — nueva tabla DirectorioMedicoConfirmacion *@
            @if (Model.CanInteractAsPaciente)
            {
                <div class="crm-card mt-3">
                    @if (Model.YaConfirme)
                    {
                        <p class="text-success mb-1">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Ya confirmaste a este médico. Gracias por ayudar a la comunidad.
                        </p>
                    }
                    else
                    {
                        <h6 class="crm-label mb-2">¿Conoces o fuiste paciente de este médico?</h6>
                        <form method="post" asp-page-handler="ConfirmarSimple">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="medicoId" value="@Model.Medico.Id" />
                            <button type="submit" class="btn btn-brand">
                                <i class="bi bi-person-check me-1"></i> Confirmar médico
                            </button>
                        </form>
                    }
                    <small class="text-muted d-block mt-2">
                        @Model.TotalConfirmaciones confirmación(es) de pacientes
                    </small>
                </div>
            }

            @* Claim del perfil *@
            @if (!Model.PerfilYaVinculado && (Model.IsMedico || Model.IsAdmin))
            {
                <div class="mt-3">
                    <a href="/directorio/reclamar/@Model.Medico.Id" class="btn btn-outline-primary">
                        <i class="bi bi-person-check me-1"></i> ¿Eres este médico? Reclamar perfil
                    </a>
                </div>
            }

            @if (Model.IsOwnerMedico)
            {
                <div class="mt-3">
                    <a asp-area="Identity" asp-page="/Medico/Dashboard" class="btn btn-brand">
                        <i class="bi bi-speedometer2 me-1"></i> Ir a mi dashboard
                    </a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="crm-card mb-3">
                <h6 class="crm-label mb-2"><i class="bi bi-plus-circle me-1"></i> ¿Conoces otro médico?</h6>
                <p class="text-muted mb-3">Ayuda a la comunidad EII agregando médicos con experiencia.</p>
                <a href="/DirectorioMedicos/Proponer" class="text-decoration-none" style="color:var(--eii-primary);font-weight:500;">
                    <i class="bi bi-plus-lg me-1"></i> Agregar médico
                </a>
            </div>
            <div class="crm-card">
                <h6 class="crm-label mb-2"><i class="bi bi-info-circle me-1"></i> Aviso</h6>
                <p class="text-muted mb-0">
                    Este directorio es comunitario y basado en experiencias reportadas por pacientes.
                    No constituye una recomendación médica oficial ni avala diagnósticos.
                </p>
            </div>
        </div>
    </div>
</div>
