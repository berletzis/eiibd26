@page
@model eiibd26.Pages.DirectorioMedicos.ProponerModel
@{
    ViewData["Title"] = "Agregar médico al directorio EII";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/directorio-medicos.css" asp-append-version="true" />
}

<div class="container py-4">

    <h1 class="crm-title mb-2">Agregar médico al directorio</h1>
    <p class="text-muted mb-3">Ayuda a la comunidad EII compartiendo información de médicos con experiencia</p>
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Solo comparte información que ya sea pública (nombre, especialidad, hospital).
        Tu identidad como aportante <strong>no será visible</strong> públicamente.
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <form method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none mb-3"></div>

                <div class="crm-card mb-3">
                    <h6 class="crm-label mb-3"><span class="proponer-step-badge me-1">1</span> Datos profesionales</h6>
                    <div class="mb-3">
                        <label asp-for="Input.NombreCompleto" class="crm-label"></label>
                        <input asp-for="Input.NombreCompleto" class="crm-input"
                               placeholder="Ej: Dr. Juan García López" />
                        <span asp-validation-for="Input.NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CedulaProfesional" class="crm-label"></label>
                            <input asp-for="Input.CedulaProfesional" class="crm-input"
                                   placeholder="Ej: 1234567" />
                            <div class="form-text">Opcional — si la conoces</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Especialidad" class="crm-label"></label>
                            <input asp-for="Input.Especialidad" class="crm-input"
                                   placeholder="Ej: Gastroenterología" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Input.Subespecialidad" class="crm-label"></label>
                        <input asp-for="Input.Subespecialidad" class="crm-input"
                               placeholder="Ej: Enfermedad Inflamatoria Intestinal" />
                        <div class="form-text">Opcional</div>
                    </div>
                </div>

                <div class="crm-card mb-3">
                    <h6 class="crm-label mb-3"><span class="proponer-step-badge me-1">2</span> Ubicación</h6>

                    <div class="mb-3">
                        <label asp-for="Input.NombrePais" class="crm-label"></label>
                        <select asp-for="Input.NombrePais"
                                id="dir-pais-select"
                                class="form-select crm-input"
                                asp-items="Model.PaisesSelectList">
                            <option value="">Selecciona un país...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="crm-label">Ciudad o Municipio</label>
                        <input asp-for="Input.Ciudad"
                               id="dir-ciudad-input"
                               class="crm-input"
                               autocomplete="off"
                               placeholder="Ej: Tultitlán, Guadalajara, Monterrey..." />
                        <input type="hidden" id="dir-estado-input" name="Input.Estado" />
                        <input asp-for="Input.Latitud" id="dir-latitud-input" type="hidden" />
                        <input asp-for="Input.Longitud" id="dir-longitud-input" type="hidden" />
                        <small class="text-muted">Escribe y selecciona del autocompletado para fijar la ubicación exacta</small>
                    </div>

                    <div class="alert alert-info py-2 mt-2" style="font-size:.875rem;">
                        <i class="bi bi-info-circle me-1"></i>
                        La dirección exacta del consultorio u hospital podrá ser completada
                        por el médico cuando reclame su perfil.
                    </div>
                </div>

                @if (Model.Input.AreasDisponibles.Any())
                {
                    <div class="crm-card mb-3">
                        <h6 class="crm-label mb-3"><span class="proponer-step-badge me-1">3</span> Experiencia EII que reportas</h6>
                        <p class="text-muted mb-3">
                            Selecciona las áreas donde este médico tiene experiencia según tu vivencia.
                            Puedes marcar una o varias.
                        </p>
                        <div class="row g-2">
                            @foreach (var area in Model.Input.AreasDisponibles)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="form-check proponer-check-item">
                                        <input class="form-check-input" type="checkbox"
                                               name="Input.AreasSeleccionadas"
                                               value="@area.Id"
                                               id="area-@area.Id"
                                               @(Model.Input.AreasSeleccionadas.Contains(area.Id) ? "checked" : "") />
                                        <label class="form-check-label" for="area-@area.Id">
                                            @area.Nombre
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="crm-card mb-3">
                    <p class="text-muted mb-3">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Al agregar este médico confirmas que la información es correcta según tu experiencia.
                        El perfil podrá ser verificado o reclamado por el titular en el futuro.
                    </p>
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="/DirectorioMedicos/Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary" style="white-space:nowrap">
                            <i class="bi bi-plus-lg me-1"></i> Agregar al directorio
                        </button>
                    </div>
                </div>

            </form>
        </div>

        <div class="col-lg-4">

            <div class="crm-card mb-3">
                <h6 class="crm-label mb-2"><i class="bi bi-question-circle me-1"></i> ¿Cómo funciona?</h6>
                <ul class="proponer-sidebar-list">
                    <li>
                        <i class="bi bi-1-circle-fill text-primary"></i>
                        Completa los datos del médico que conoces
                    </li>
                    <li>
                        <i class="bi bi-2-circle-fill text-primary"></i>
                        Indica su ubicación para que otros pacientes lo encuentren
                    </li>
                    <li>
                        <i class="bi bi-3-circle-fill text-primary"></i>
                        Marca las áreas EII en las que tiene experiencia
                    </li>
                    <li>
                        <i class="bi bi-4-circle-fill text-primary"></i>
                        Otros pacientes pueden confirmar o agregar su experiencia
                    </li>
                </ul>
            </div>

            <div class="crm-card mb-3">
                <h6 class="crm-label mb-2"><i class="bi bi-shield-lock me-1"></i> Privacidad</h6>
                <p class="text-muted mb-0">
                    Tu identidad como aportante nunca será visible públicamente.
                    Solo se muestra el total agregado de confirmaciones.
                    La información del médico es de carácter público.
                </p>
            </div>

            <div class="crm-card">
                <h6 class="crm-label mb-2"><i class="bi bi-arrow-left-circle me-1"></i> Directorio</h6>
                <a asp-page="/DirectorioMedicos/Index" class="btn btn-primary w-100">
                    Ver directorio completo
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var apiKey = '@Html.Raw(Model.GoogleMapsApiKey)';

            function initAutocomplete() {
                var input    = document.getElementById('dir-ciudad-input');
                var paisSel  = document.getElementById('dir-pais-select');
                var latEl    = document.getElementById('dir-latitud-input');
                var lngEl    = document.getElementById('dir-longitud-input');
                var estadoEl = document.getElementById('dir-estado-input');

                if (!input || !window.google || !google.maps.places) return;

                var autocomplete = new google.maps.places.Autocomplete(input, { types: ['(cities)'] });

                function getCountryCode(val) {
                    if (!val) return null;
                    var m = String(val).trim().split(/\s|-/)[0].match(/[A-Za-z]{2,3}/);
                    return m ? m[0].toLowerCase() : null;
                }

                if (paisSel && paisSel.value) {
                    var code = getCountryCode(paisSel.value);
                    if (code) autocomplete.setComponentRestrictions({ country: code });
                }

                paisSel && paisSel.addEventListener('change', function () {
                    var code = getCountryCode(paisSel.value);
                    autocomplete.setComponentRestrictions(code ? { country: code } : {});
                    input.value = '';
                    if (latEl)    latEl.value = '';
                    if (lngEl)    lngEl.value = '';
                    if (estadoEl) estadoEl.value = '';
                });

                autocomplete.addListener('place_changed', function () {
                    var place = autocomplete.getPlace();
                    if (place && place.geometry && place.geometry.location) {
                        if (latEl) latEl.value = place.geometry.location.lat();
                        if (lngEl) lngEl.value = place.geometry.location.lng();

                        var comps = place.address_components || [];
                        var estadoComp = comps.find(function (c) {
                            return c.types.includes('administrative_area_level_1');
                        });
                        if (estadoEl) estadoEl.value = estadoComp ? estadoComp.long_name : '';
                    } else {
                        if (latEl)    latEl.value = '';
                        if (lngEl)    lngEl.value = '';
                        if (estadoEl) estadoEl.value = '';
                    }
                });
            }

            // Mismo patrón que /Mapa/Index: carga dinámica sin libraries= en la URL.
            // Luego importa Places bajo demanda con importLibrary (API nueva, sin cargar mapa).
            function loadMapsAndInit() {
                if (window.google && window.google.maps) {
                    google.maps.importLibrary('places').then(initAutocomplete);
                    return;
                }
                var existing = document.querySelector('script[data-gmaps="1"]');
                if (existing) return;

                var script = document.createElement('script');
                script.src = 'https://maps.googleapis.com/maps/api/js?key=' + apiKey;
                script.async = true;
                script.defer = true;
                script.dataset.gmaps = '1';
                script.onload = function () {
                    if (google.maps.importLibrary) {
                        google.maps.importLibrary('places').then(initAutocomplete);
                    } else if (google.maps.places) {
                        initAutocomplete();
                    }
                };
                document.head.appendChild(script);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadMapsAndInit);
            } else {
                loadMapsAndInit();
            }
        })();
    </script>
}
