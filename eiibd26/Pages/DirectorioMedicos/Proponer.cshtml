@page
@model eiibd26.Pages.DirectorioMedicos.ProponerModel
@{
    ViewData["Title"] = "Agregar médico al directorio EII";
}

@section Styles {
    <link rel="stylesheet" href="~/css/directorio-medicos.css" asp-append-version="true" />
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/DirectorioMedicos/Index">Directorio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Agregar médico</li>
        </ol>
    </nav>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm mb-4 proponer-header-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="proponer-header-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <div>
                            <h1 class="h4 mb-1">Agregar médico al directorio</h1>
                            <p class="text-muted mb-0" style="font-size:var(--font-size-sm);">
                                Ayuda a la comunidad EII compartiendo información de médicos con experiencia
                            </p>
                        </div>
                    </div>
                    <div class="alert alert-info mb-0 py-2">
                        <i class="bi bi-info-circle me-2"></i>
                        <span style="font-size:var(--font-size-sm);">
                            Solo comparte información que ya sea pública (nombre, especialidad, hospital).
                            Tu identidad como aportante <strong>no será visible</strong> públicamente.
                        </span>
                    </div>
                </div>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none mb-3"></div>

                <div class="card shadow-sm mb-3">
                    <div class="card-header proponer-card-header">
                        <span class="proponer-step-badge">1</span>
                        <h6 class="mb-0">Datos profesionales</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.NombreCompleto" class="form-label fw-semibold"></label>
                            <input asp-for="Input.NombreCompleto" class="form-control"
                                   placeholder="Ej: Dr. Juan García López" />
                            <span asp-validation-for="Input.NombreCompleto" class="text-danger small"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.CedulaProfesional" class="form-label fw-semibold"></label>
                                <input asp-for="Input.CedulaProfesional" class="form-control"
                                       placeholder="Ej: 1234567" />
                                <div class="form-text">Opcional — si la conoces</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Especialidad" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Especialidad" class="form-control"
                                       placeholder="Ej: Gastroenterología" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label asp-for="Input.Subespecialidad" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Subespecialidad" class="form-control"
                                   placeholder="Ej: Enfermedad Inflamatoria Intestinal" />
                            <div class="form-text">Opcional</div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-header proponer-card-header">
                        <span class="proponer-step-badge">2</span>
                        <h6 class="mb-0">Ubicación</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Estado" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Estado" class="form-control"
                                       placeholder="Ej: Ciudad de México" />
                                <span asp-validation-for="Input.Estado" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Ciudad" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Ciudad" class="form-control"
                                       placeholder="Ej: Benito Juárez" />
                            </div>
                        </div>
                        <div class="row g-3 mt-0">
                            <div class="col-md-6">
                                <label asp-for="Input.MunicipioAlcaldia" class="form-label fw-semibold"></label>
                                <input asp-for="Input.MunicipioAlcaldia" class="form-control"
                                       placeholder="Opcional" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.HospitalClinica" class="form-label fw-semibold"></label>
                                <input asp-for="Input.HospitalClinica" class="form-control"
                                       placeholder="Ej: Hospital Ángeles" />
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Input.AreasDisponibles.Any())
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-header proponer-card-header">
                            <span class="proponer-step-badge">3</span>
                            <h6 class="mb-0">Experiencia EII que reportas</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3" style="font-size:var(--font-size-sm);">
                                Selecciona las áreas donde este médico tiene experiencia según tu vivencia.
                                Puedes marcar una o varias.
                            </p>
                            <div class="row g-2">
                                @foreach (var area in Model.Input.AreasDisponibles)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check proponer-check-item">
                                            <input class="form-check-input" type="checkbox"
                                                   name="Input.AreasSeleccionadas"
                                                   value="@area.Id"
                                                   id="area-@area.Id"
                                                   @(Model.Input.AreasSeleccionadas.Contains(area.Id) ? "checked" : "") />
                                            <label class="form-check-label" for="area-@area.Id">
                                                @area.Nombre
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="card shadow-sm mb-3 proponer-submit-card">
                    <div class="card-body">
                        <p class="text-muted mb-3" style="font-size:var(--font-size-sm);">
                            <i class="bi bi-shield-check me-1 text-success"></i>
                            Al agregar este médico confirmas que la información es correcta según tu experiencia.
                            El perfil podrá ser verificado o reclamado por el titular en el futuro.
                        </p>
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="/DirectorioMedicos/Index" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i> Agregar al directorio
                            </button>
                        </div>
                    </div>
                </div>

            </form>
        </div>

        <div class="col-lg-4">

            <div class="sidebar-section sidebar-static">
                <h4><i class="bi bi-question-circle me-1"></i> ¿Cómo funciona?</h4>
                <ul class="proponer-sidebar-list">
                    <li>
                        <i class="bi bi-1-circle-fill text-primary"></i>
                        Completa los datos del médico que conoces
                    </li>
                    <li>
                        <i class="bi bi-2-circle-fill text-primary"></i>
                        Indica su ubicación para que otros pacientes lo encuentren
                    </li>
                    <li>
                        <i class="bi bi-3-circle-fill text-primary"></i>
                        Marca las áreas EII en las que tiene experiencia
                    </li>
                    <li>
                        <i class="bi bi-4-circle-fill text-primary"></i>
                        Otros pacientes pueden confirmar o agregar su experiencia
                    </li>
                </ul>
            </div>

            <div class="sidebar-section sidebar-static mt-3">
                <h4><i class="bi bi-shield-lock me-1"></i> Privacidad</h4>
                <p style="font-size:var(--font-size-xs); color:var(--color-text-secondary); margin:0;">
                    Tu identidad como aportante nunca será visible públicamente.
                    Solo se muestra el total agregado de confirmaciones.
                    La información del médico es de carácter público.
                </p>
            </div>

            <div class="sidebar-section sidebar-static mt-3">
                <h4><i class="bi bi-arrow-left-circle me-1"></i> Directorio</h4>
                <a asp-page="/DirectorioMedicos/Index" class="btn btn-outline-primary btn-sm w-100">
                    Ver directorio completo
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
