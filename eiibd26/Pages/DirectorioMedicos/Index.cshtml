@page
@model eiibd26.Pages.DirectorioMedicos.IndexModel
@using eiibd26.Models.Directorio.Enums
@{
    ViewData["Title"] = "Directorio de médicos con experiencia en EII";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/directorio-medicos.css" asp-append-version="true" />
}

<div class="container py-4">

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="d-flex justify-content-between align-items-start mb-2">
        <h1 class="crm-title mb-0">Directorio de médicos</h1>
        <a asp-page="/DirectorioMedicos/Proponer" class="btn btn-primary flex-shrink-0" style="white-space:nowrap">
            <i class="bi bi-plus-lg me-1"></i> Agregar médico
        </a>
    </div>
    <p class="text-muted mb-4">Médicos identificados por pacientes con EII en México</p>

    <div class="alert alert-info mb-4" role="note">
        <i class="bi bi-info-circle me-2"></i>
        Este directorio es construido por la comunidad EII. La información refleja experiencias
        reportadas por pacientes y <strong>no constituye una recomendación médica oficial.</strong>
    </div>

    <form method="get" class="directorio-filtros mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="crm-label">Buscar médico</label>
                <div class="input-group">
                    <input type="text" name="Busqueda" value="@Model.Directorio.FiltroBusqueda"
                           class="form-control" placeholder="Nombre, especialidad, hospital…" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="crm-label">Estado</label>
                <select name="Estado" class="form-select" onchange="this.form.submit()">
                    <option value="">Todos los estados</option>
                    @foreach (var e in Model.Directorio.EstadosDisponibles)
                    {
                        if (Model.Directorio.FiltroEstado == e)
                        {
                            <option value="@e" selected>@e</option>
                        }
                        else
                        {
                            <option value="@e">@e</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="crm-label">Área EII</label>
                <select name="AreaId" class="form-select" onchange="this.form.submit()">
                    <option value="">Todas las áreas</option>
                    @foreach (var a in Model.Directorio.AreasDisponibles)
                    {
                        if (Model.Directorio.FiltroAreaId == a.Id)
                        {
                            <option value="@a.Id" selected>@a.Nombre</option>
                        }
                        else
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <a asp-page="/DirectorioMedicos/Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i> Limpiar
                </a>
            </div>
        </div>
    </form>

    <div class="mb-3">
        <span class="text-muted" style="font-size: var(--font-size-sm);">
            @Model.Directorio.TotalResultados médico@(Model.Directorio.TotalResultados != 1 ? "s" : "") encontrado@(Model.Directorio.TotalResultados != 1 ? "s" : "")
        </span>
    </div>

    @if (Model.Directorio.Medicos.Any())
    {
        <div class="directorio-grid">
            @foreach (var medico in Model.Directorio.Medicos)
            {
                <div style="display:flex;flex-direction:column;">
                    @{
                        bool _gComunidad = medico.TotalConfirmaciones >= 3 && Model.MedicosConEII.ContainsKey(medico.Id);
                        bool _gVerificado = medico.CedulaValidada || medico.TotalConfirmaciones >= 5;
                        bool _gMedico     = medico.NivelConfianza == NivelConfianzaEnum.Establecido;
                    }
                    @await Html.PartialAsync("_MedicoCard", medico)

                    @* Badges al fondo del card *@
                    <div class="d-flex flex-wrap gap-1 px-3 py-2"
                         style="background:#fff;border:1px solid var(--color-border,#e5e7eb);border-top:none;border-radius:0 0 .75rem .75rem;margin-top:-1px;">
                        <span class="badge @(_gComunidad ? "" : "bg-light text-secondary border")"
                              style="font-size:.75rem;@(_gComunidad ? "background-color:#7c3aed;color:#fff;" : "")">
                            <i class="bi bi-people-fill"></i> Comunidad
                        </span>
                        <span class="badge @(_gVerificado ? "bg-primary" : "bg-light text-secondary border")" style="font-size:.75rem;">
                            <i class="bi bi-patch-check"></i> Verificado
                        </span>
                        <span class="badge @(_gMedico ? "bg-success" : "bg-light text-secondary border")" style="font-size:.75rem;">
                            <i class="bi bi-patch-check-fill"></i> Médico
                        </span>
                    </div>
                </div>
            }
        </div>

        @if (Model.Directorio.TotalPaginas > 1)
        {
            <div class="preguntas-paginacion mt-4">
                <div class="pag-bar">
                    @if (Model.Directorio.PaginaActual > 1)
                    {
                        <a class="pag-btn"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@(Model.Directorio.PaginaActual - 1)">‹</a>
                    }
                    @for (int p = 1; p <= Model.Directorio.TotalPaginas; p++)
                    {
                        <a class="pag-num @(p == Model.Directorio.PaginaActual ? "active" : "")"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@p">@p</a>
                    }
                    @if (Model.Directorio.PaginaActual < Model.Directorio.TotalPaginas)
                    {
                        <a class="pag-btn"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@(Model.Directorio.PaginaActual + 1)">›</a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search" style="font-size: 3rem; color: var(--color-text-secondary);"></i>
            <p class="mt-3 text-muted">No se encontraron médicos con esos filtros.</p>
            <a asp-page="/DirectorioMedicos/Proponer" class="btn btn-primary mt-2" style="white-space:nowrap">
                <i class="bi bi-plus-lg me-1"></i> Agregar el primero
            </a>
        </div>
    }
</div>
