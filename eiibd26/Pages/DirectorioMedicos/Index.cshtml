@page
@model eiibd26.Pages.DirectorioMedicos.IndexModel
@using eiibd26.Models.Directorio.Enums
@{
    ViewData["Title"] = "Directorio de médicos con experiencia en EII";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/directorio-medicos.css" asp-append-version="true" />
}

<div class="container py-4">

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.MisPropuestas.Any())
{
    <div class="alert alert-warning mb-4" role="alert">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-hourglass-split"></i>
            <strong>Mis propuestas pendientes de revisión (@Model.MisPropuestas.Count)</strong>
        </div>
        <ul class="mb-0 ps-3" style="font-size:0.9rem">
            @foreach (var p in Model.MisPropuestas)
            {
                <li>
                    <strong>@p.Nombre</strong>
                    @if (!string.IsNullOrWhiteSpace(p.Especialidad)) { <span class="text-muted"> · @p.Especialidad</span> }
                    @if (!string.IsNullOrWhiteSpace(p.Estado)) { <span class="text-muted"> · @p.Estado</span> }
                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.72rem">En revisión</span>
                    <small class="text-muted ms-1">@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</small>
                </li>
            }
        </ul>
        <p class="mb-0 mt-2" style="font-size:0.82rem;color:#664d03">
            <i class="bi bi-info-circle me-1"></i>Estará visible en el directorio una vez que el equipo de EIIBD lo revise. Gracias por tu aporte.
        </p>
    </div>
}

    <div class="d-flex justify-content-between align-items-start mb-2">
        <h1 class="eii-page-title mb-0">Directorio de médicos</h1>
        <a asp-page="/DirectorioMedicos/Proponer" class="eii-btn eii-btn--primary flex-shrink-0" style="white-space:nowrap">
            <i class="bi bi-plus-lg me-1"></i> Agregar médico
        </a>
    </div>
    <p class="text-muted mb-4">Médicos identificados por pacientes con EII en México</p>

    <div class="eii-card directorio-busqueda-card mb-4">
        <div class="directorio-aviso mb-3">
            <i class="bi bi-info-circle"></i>
            <span>Este directorio es construido por la comunidad EII. La información refleja experiencias reportadas por pacientes y <strong>no constituye una recomendación médica oficial.</strong></span>
        </div>
        <form method="get">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <input type="text" name="Busqueda" value="@Model.Directorio.FiltroBusqueda"
                               class="form-control" placeholder="Nombre, especialidad, hospital..." />
                        <button type="submit" class="eii-btn directorio-btn-buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="Estado" class="form-select" onchange="this.form.submit()">
                        <option value="">Todos los estados</option>
                        @foreach (var e in Model.Directorio.EstadosDisponibles)
                        {
                            <option value="@e" selected="@(Model.Directorio.FiltroEstado == e ? "selected" : null)">@e</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="AreaId" class="form-select" onchange="this.form.submit()">
                        <option value="">Todas las áreas EII</option>
                        @foreach (var a in Model.Directorio.AreasDisponibles)
                        {
                            <option value="@a.Id" selected="@(Model.Directorio.FiltroAreaId == a.Id ? "selected" : null)">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <a asp-page="/DirectorioMedicos/Index" class="eii-btn eii-btn--neutral w-100">
                        <i class="bi bi-x-lg"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="mb-3">
        <span class="eii-text-sm eii-text-muted">
            @Model.Directorio.TotalResultados médico@(Model.Directorio.TotalResultados != 1 ? "s" : "") encontrado@(Model.Directorio.TotalResultados != 1 ? "s" : "")
        </span>
    </div>

    @if (Model.Directorio.Medicos.Any())
    {
        <div class="eii-grid">
            @foreach (var medico in Model.Directorio.Medicos)
            {
                ViewData["BadgeComunidad"] = medico.TotalConfirmaciones >= 3 && Model.MedicosConEII.ContainsKey(medico.Id);
                ViewData["BadgeVerificado"] = medico.CedulaValidada || medico.TotalConfirmaciones >= 5;
                ViewData["BadgeMedico"]     = medico.NivelConfianza == NivelConfianzaEnum.Establecido;
                @await Html.PartialAsync("_MedicoCard", medico)
            }
        </div>

        @if (Model.Directorio.TotalPaginas > 1)
        {
            <div class="eii-pagination mt-4">
                <div class="eii-pagination__bar">
                    @if (Model.Directorio.PaginaActual > 1)
                    {
                        <a class="eii-pagination__btn"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@(Model.Directorio.PaginaActual - 1)">‹</a>
                    }
                    @for (int p = 1; p <= Model.Directorio.TotalPaginas; p++)
                    {
                        <a class="eii-pagination__num @(p == Model.Directorio.PaginaActual ? "is-active" : "")"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@p">@p</a>
                    }
                    @if (Model.Directorio.PaginaActual < Model.Directorio.TotalPaginas)
                    {
                        <a class="eii-pagination__btn"
                           asp-page="/DirectorioMedicos/Index"
                           asp-route-Busqueda="@Model.Directorio.FiltroBusqueda"
                           asp-route-Estado="@Model.Directorio.FiltroEstado"
                           asp-route-AreaId="@Model.Directorio.FiltroAreaId"
                           asp-route-Pagina="@(Model.Directorio.PaginaActual + 1)">›</a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search eii-text-muted" style="font-size: 3rem;"></i>
            <p class="mt-3 text-muted">No se encontraron médicos con esos filtros.</p>
            <a asp-page="/DirectorioMedicos/Proponer" class="eii-btn eii-btn--primary mt-2" style="white-space:nowrap">
                <i class="bi bi-plus-lg me-1"></i> Agregar el primero
            </a>
        </div>
    }
</div>
