@page
@model eiibd26.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmación de correo";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-3">@ViewData["Title"]</h2>

                    @* Mostrar mensaje de estado: primero TempData (PRG), si no existe usar Model.StatusMessage *@
                    @{
                        var status = TempData["StatusMessage"]?.ToString();
                        if (string.IsNullOrEmpty(status))
                        {
                            status = Model?.StatusMessage ?? "";
                        }
                    }

                    @if (!string.IsNullOrEmpty(status))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" id="confirm-success">
                            @Html.Raw(status)
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <a asp-page="/Account/Login" class="btn btn-primary">Ir a iniciar sesión</a>
                        <a asp-page="/Index" class="btn btn-link">Volver al inicio</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide success message after 3s, if present
        (function() {
            try {
                const suc = document.getElementById('confirm-success');
                if (suc) {
                    setTimeout(() => {
                        suc.classList.remove('show');
                        suc.classList.add('fade');
                        setTimeout(() => { if (suc.parentNode) suc.parentNode.removeChild(suc); }, 400);
                    }, 3000);
                }
            } catch (e) { console.warn(e); }
        })();
    </script>
}