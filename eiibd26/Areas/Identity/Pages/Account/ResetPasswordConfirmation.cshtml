@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña Restablecida";
}

<div class="account-page-root">
    <div class="account-card">
        <h2>@ViewData["Title"]</h2>
        <p>
            Tu contraseña ha sido restablecida. Por favor <a asp-page="./Login">haz clic aquí para iniciar sesión</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

