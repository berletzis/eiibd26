@page
@model eiibd26.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";

    // Helper para añadir clase is-invalid cuando el campo tiene errores en el ModelState
    Func<string, string> invalidClass = fieldName =>
    {
        var ms = ViewData.ModelState[fieldName];
        return (ms != null && ms.Errors != null && ms.Errors.Count > 0) ? "is-invalid" : "";
    };
}
@section Styles {
    @* No custom background styles here — inputs keep their default appearance *@
}

<div class="account-page-root">
    
    @if (TempData["ResetPasswordMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["ResetPasswordMessage"]
        </div>
    }

    <div class="eii-card">
        <form id="account" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <h2>Inicio de Sesión.</h2>
            <hr />

            @* Mostrar resumen de validación solamente si hay errores globales *@
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
            {
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            }

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control @invalidClass("Input.Email")"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Correo / Usuario</label>
                @* validación debajo del input (Bootstrap invalid-feedback) *@
                <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       class="form-control @invalidClass("Input.Password")"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="password" />
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <span asp-validation-for="Input.Password" class="invalid-feedback d-block"></span>
            </div>

            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <div>
                <button id="login-submit" type="submit" class="eii-btn eii-btn--solid eii-btn--full eii-btn--lg">Iniciar Sesión</button>
            </div>

            <div class="mt-3">
                <p>
                    <a id="forgot-password" asp-page="./ForgotPassword">¿Olvidaste tu Contraseña?</a>
                </p>
                <p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">¿No tienes cuenta?, ¡Registrate!</a>
                </p>
            </div>
        </form>
    </div>  @* .eii-card *@
</div>  @* .account-page-root *@

@section Scripts {
    @* Asegurarnos de cargar jQuery antes de jquery.validate y jquery.validate.unobtrusive.
       Muchos errores "jQuery is not defined" vienen de que la página no carga jQuery en el layout.
       Aquí incluimos un fallback robusto que solo carga jQuery si no existe y luego carga los plugins de validación *@

    <script>
        (function() {
            function loadScript(src, onload) {
                var s = document.createElement('script');
                s.src = src;
                s.async = false;
                s.onload = onload;
                s.onerror = function(){ console.warn('Error loading script', src); if(onload) onload(); };
                document.head.appendChild(s);
            }

            function ensureValidation() {
                // Si jquery.validate o unobtrusive no están, cargarlos
                if (typeof jQuery === 'undefined') {
                    console.warn('jQuery still undefined when attempting to ensure validation.');
                    return;
                }

                if (typeof jQuery.validator === 'undefined') {
                    loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js', function() {
                        // after validator loaded, load unobtrusive
                        if (typeof jQuery.validator.unobtrusive === 'undefined') {
                            loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js', function() {
                                // re-parse the form for unobtrusive validation
                                try { jQuery.validator.unobtrusive.parse('#account'); } catch(e){ console.warn(e); }
                            });
                        } else {
                            try { jQuery.validator.unobtrusive.parse('#account'); } catch(e){ console.warn(e); }
                        }
                    });
                } else {
                    if (typeof jQuery.validator.unobtrusive === 'undefined') {
                        loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js', function() {
                            try { jQuery.validator.unobtrusive.parse('#account'); } catch(e){ console.warn(e); }
                        });
                    } else {
                        try { jQuery.validator.unobtrusive.parse('#account'); } catch(e){ console.warn(e); }
                    }
                }
            }

            // If jQuery is already present (e.g., loaded by layout), just ensure validation plugins are present
            if (typeof jQuery !== 'undefined') {
                ensureValidation();
            } else {
                // load jQuery from CDN, then validation libs
                loadScript('https://code.jquery.com/jquery-3.6.0.min.js', function() {
                    // after jQuery loaded, ensure validation libs
                    ensureValidation();
                });
            }
        })();
    </script>
}