@page
@model eiibd26.Areas.Identity.Pages.Account.Manage.ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar Correo de Confirmación de Cuenta";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-3">@ViewData["Title"]</h2>

                    @* Success message (TempData-backed by the PageModel) *@
                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" id="resend-success">
                            @Html.Raw(Model.StatusMessage)
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @* If the email is already confirmed, show info and hide the form *@
                    @if (Model.EmailConfirmed)
                    {
                        <div class="alert alert-info" role="alert" id="resend-already">
                            Tu correo ya está confirmado. No es necesario reenviar el correo de confirmación.
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <a asp-page="./Identity/Account/Manage/UsuarioPerfil" class="btn btn-primary">Volver a administración de cuenta</a>
                            <a asp-page="./Identity/Account/Manage/UsuarioPerfil" class="btn btn-link">Ir al inicio</a>
                        </div>
                    }
                    else
                    {
                        @* Render validation summary only if there are actual errors *@
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
                        {
                            <div class="alert alert-danger" role="alert" id="resend-errors">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <form method="post" novalidate>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email"
                                       class="form-control @(ViewData.ModelState[nameof(Model.Input.Email)]?.Errors.Any() == true ? "is-invalid" : "")"
                                       placeholder="name@example.com"
                                       aria-required="true" />
                                <label asp-for="Input.Email">Correo electrónico</label>
                                <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                            </div>

                            <button type="submit" class="w-100 btn btn-lg btn-primary mb-2" @(Model.IsRateLimited ? "disabled" : "")>
                                Reenviar correo de confirmación
                            </button>

                            @if (Model.IsRateLimited && Model.RateLimitRemainingSeconds > 0)
                            {
                                <div class="text-muted small text-center">Puedes volver a solicitar el reenvío en @Model.RateLimitRemainingSeconds segundos.</div>
                            }

                            <a asp-page="./Identity/Account/Manage/UsuarioPerfi" class="d-block text-center mt-2">Volver a administración de cuenta</a>
                        </form>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-hide success message after 3s, if present
        (function () {
            try {
                const suc = document.getElementById('resend-success');
                if (suc) {
                    setTimeout(() => {
                        suc.classList.remove('show');
                        suc.classList.add('fade');
                        setTimeout(() => { if (suc.parentNode) suc.parentNode.removeChild(suc); }, 400);
                    }, 3000);
                }
            } catch (e) { console.warn(e); }
        })();
    </script>
}