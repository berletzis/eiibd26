@page
@model eiibd26.Areas.Identity.Pages.Account.Manage.ConfirmPhoneNumberModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Confirmación del teléfono";
}

<h2>@ViewData["Title"]</h2>

<div class="card p-3 mt-3">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label"></label>
            <input asp-for="Input.PhoneNumber" class="form-control" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label"></label>
            <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Confirmar teléfono</button>

            @* Botón para enviar el código por SMS. Utiliza handler SendCode (OnPostSendCodeAsync) *@
            <button class="btn btn-outline-secondary" type="submit" asp-page-handler="SendCode">Enviar código por SMS</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mt-3">@Model.StatusMessage</div>
    }

    @* Dev helpers: mostrar token/URL en Development para pruebas rápidas *@
    @if (Env.IsDevelopment())
    {
        if (TempData["DebugSmsCode"] != null)
        {
            <div class="alert alert-warning mt-3">
                <div class="fw-semibold">DEBUG (dev): token enviado por SMS</div>
                <div class="mt-2"><strong>Token:</strong> <code>@TempData["DebugSmsCode"]</code></div>
            </div>
        }
        if (TempData["DebugCallbackUrl"] != null)
        {
            <div class="alert alert-warning mt-3">
                <div class="fw-semibold">DEBUG (dev): callbackUrl generado</div>
                <div class="mt-2">
                    <a href="@TempData["DebugCallbackUrl"]" target="_blank">Abrir callbackUrl en ventana nueva</a>
                </div>
                <pre style="word-break:break-all;background:#f8f9fb;padding:8px;border-radius:4px;">@TempData["DebugCallbackUrl"]</pre>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}