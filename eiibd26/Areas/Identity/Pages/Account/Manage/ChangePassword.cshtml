@page
@model eiibd26.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    .manage-page-root {
        padding-top: 16px;
        padding-bottom: 24px;
    }

        /* LEGACY — manage-title migrado a eii-page-title 2026-05 */

    .manage-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #eef2f7;
        padding: 1.25rem 1.25rem 1.5rem 1.25rem;
        box-shadow: 0 2px 10px rgba(15,23,42,0.04);
        font-weight: 400;
        font-size: .9rem;
    }

    .manage-nav-col {
        border-right: 1px solid #eef2f7;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .manage-nav-col {
            border-right: none;
            border-bottom: 1px solid #eef2f7;
            margin-bottom: 1rem;
            padding-bottom: .75rem;
        }
    }

    .manage-actions .btn {
        font-weight: 400;
        font-size: .9rem;
    }
</style>

<div class="manage-page-root">
    <div class="container py-4">
        <h1 class="eii-page-title">@ViewData["Title"]</h1>

        <div class="manage-card">
            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="row mt-2">
                <div class="col-md-4 manage-nav-col">
                    <partial name="_ManageNav" />
                </div>

                <div class="col-md-8">
                    <form id="change-password-form" method="post" novalidate class="manage-actions">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Ingresa tu contraseña actual" />
                            <label asp-for="Input.OldPassword" class="form-label">Contraseña actual</label>
                            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ingresa tu nueva contraseña" />
                            <label asp-for="Input.NewPassword" class="form-label">Nueva contraseña</label>
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirma tu nueva contraseña" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar nueva contraseña</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <button type="submit" class="btn btn-primary w-100">Actualizar contraseña</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}