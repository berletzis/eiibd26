@{
    // Detect current Razor page path (e.g. "/Account/Manage/PerfilMedico")
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool IsPage(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
}

<style>
    /* Manage nav card - responsive */
    .manage-nav-card {
        background: #fff;
        border-radius: 12px;
        padding: 0.75rem;
        box-shadow: 0 6px 18px rgba(21,32,64,0.04);
        box-sizing: border-box;
        margin-bottom: 1rem;
        font-size: .9rem;
        font-weight: 400;
    }

    .manage-nav-list {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0;
        display: flex;
        flex-direction: row;
        gap: 0.25rem;
        flex-wrap: wrap;
    }

    .manage-nav-item {
        margin: 0;
    }

    .manage-nav-link {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        padding: 0.55rem 0.9rem;
        border-radius: 8px;
        color: #2b3440;
        text-decoration: none;
        font-weight: 400;
        font-size: .9rem;
        background: transparent;
        border: 1px solid transparent;
        transition: all .12s ease-in-out;
        white-space: nowrap;
    }

        .manage-nav-link:hover,
        .manage-nav-link:focus {
            background: #f3f6fb;
            color: #1f2d4a;
            text-decoration: none;
            transform: translateY(-1px);
        }

        /* Active state: purple (morado) theme */
        .manage-nav-link.active {
            background: #F3E8FF; /* very light purple background */
            color: #5B21B6 !important; /* darker purple text */
            font-weight: 400;
            border-left: 4px solid #7C3AED; /* purple border */
            padding-left: 0.8rem; /* account for left border */
            transform: none;
        }

    /* Also style any bootstrap .nav-link that may receive 'active' via helpers */
    .manage-nav-card .nav-link.active {
        background: #F3E8FF !important;
        color: #5B21B6 !important;
        font-weight: 400;
        border-left: 4px solid #7C3AED !important;
        padding-left: 0.8rem !important;
    }

    /* Title-as-link styling */
    .manage-nav-title-link {
        display: inline-block;
        font-size: .9rem;
        font-weight: 400;
        color: #2b3b5a;
        padding: 0.25rem 0.6rem;
        margin-bottom: 0.35rem;
        text-decoration: none;
        border-radius: 6px;
    }

        .manage-nav-title-link:hover,
        .manage-nav-title-link:focus {
            background: #f3f6fb;
            color: #1f2d4a;
            text-decoration: none;
        }

        /* Title active state matching purple theme */
        .manage-nav-title-link.active {
            background: #F3E8FF;
            color: #5B21B6;
            border-left: 4px solid #7C3AED;
            padding-left: 0.8rem;
        }

    /* Better spacing for longer lists on mobile: show them stacked */
    @@media (max-width: 767.98px) {
        .manage-nav-list {
            flex-direction: column;
            gap: 0.25rem;
        }

        .manage-nav-link {
            width: 100%;
            padding: 0.75rem 1rem;
        }

        .manage-nav-card {
            padding: 0.6rem;
            margin-bottom: 1.15rem;
        }

        .manage-nav-title-link {
            display: block;
            width: 100%;
            padding: 0.6rem 0.9rem;
            margin-bottom: .5rem;
        }
    }

    /* Desktop: left column navigation (sticky) and content to the right */
    @@media (min-width: 768px) {
        .manage-nav-wrapper {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
        }

        .manage-nav-card {
            flex: 0 0 240px;
            width: 240px;
            position: sticky;
            top: 20px;
            height: fit-content;
            margin-bottom: 0;
        }

        .manage-nav-list {
            flex-direction: column;
            gap: 0.35rem;
            padding: 0.6rem;
        }

        .manage-nav-link {
            display: flex;
            justify-content: flex-start;
            padding: 0.6rem 0.9rem;
            width: 100%;
        }

        .manage-nav-title-link {
            margin-bottom: .6rem;
            padding-left: .6rem;
            padding-right: .6rem;
        }
    }

    .manage-nav-content {
        flex: 1 1 auto;
    }

        .manage-nav-content h2,
        .manage-page-header h2 {
            font-size: 2.1rem;
            font-weight: 300;
            letter-spacing: -0.06em;
            color: #172849;
            padding-bottom: 20px;
            margin-top: 1.5rem;
            margin-bottom: 0.6rem;
            line-height: 1.05;
        }

    @@media (max-width: 575.98px) {
        .manage-nav-content h2,
        .manage-page-header h2 {
            margin-top: 1rem;
            font-size: 1.9rem;
        }
    }
</style>

<div class="manage-nav-wrapper">
    <nav class="manage-nav-card" aria-label="Medico navigation">
        <ul class="manage-nav-list" role="list">
            <span class="manage-nav-title-link" style="pointer-events:none;opacity:.6;font-size:.8rem;">Mi espacio médico</span>
            <li class="manage-nav-item" role="listitem">
                <a class="manage-nav-link @(IsPage("/Medico/Dashboard") ? "active" : "")"
                   asp-area="Identity" asp-page="/Medico/Dashboard">
                    <i class="bi bi-speedometer2 me-1"></i> Mi Dashboard
                </a>
            </li>
            <li class="manage-nav-item" role="listitem">
                <a class="manage-nav-link @(IsPage("/Account/Manage/PerfilMedico") ? "active" : "")"
                   asp-area="Identity" asp-page="/Account/Manage/PerfilMedico">
                    <i class="bi bi-person-badge me-1"></i> Perfil Médico
                </a>
            </li>

            <span class="manage-nav-title-link" style="pointer-events:none;opacity:.6;font-size:.8rem;display:block;margin-top:.5rem;">Cuenta</span>
            <li class="manage-nav-item" role="listitem">
                <a class="manage-nav-link @(IsPage("/Account/Manage/Index") ? "active" : "")"
                   asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-key me-1"></i> Datos de acceso
                </a>
            </li>
            <li class="manage-nav-item" role="listitem">
                <a class="manage-nav-link @(IsPage("/Account/Manage/ChangePassword") ? "active" : "")"
                   asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                    <i class="bi bi-lock me-1"></i> Contraseña
                </a>
            </li>
            <li class="manage-nav-item" role="listitem">
                <a class="manage-nav-link @(IsPage("/Account/Manage/Email") ? "active" : "")"
                   asp-area="Identity" asp-page="/Account/Manage/Email">
                    <i class="bi bi-envelope me-1"></i> Correo
                </a>
            </li>
        </ul>
    </nav>
    <div class="manage-nav-content" aria-hidden="true"></div>
</div>
