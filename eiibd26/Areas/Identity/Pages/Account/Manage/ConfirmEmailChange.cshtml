@page
@model eiibd26.Areas.Identity.Pages.Account.Manage.ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmación de cambio de correo";
}

<h2>@ViewData["Title"]</h2>

<div class="card p-3 mt-3">
    <div>
        <p>@Model.StatusMessage</p>
    </div>

    <div class="mt-3">
        <a asp-page="/Account/Manage/Index" class="btn btn-primary">Ir a la configuración</a>
        <a asp-page="/Index" class="btn btn-link">Volver al inicio</a>
    </div>
</div>