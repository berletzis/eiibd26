@page
@model eiibd26.Areas.Identity.Pages.Account.Manage.EmailModel
@{
    ViewData["Title"] = "Cambiar correo";
    ViewData["ActivePage"] = ManageNavPages.Email;
}


<div class="crm-container-admin">
    <h2>@ViewData["Title"]</h2>

    <div class="card-block-modern">

        <div class="row">
            <div class="col-md-4 manage-nav-col">
                <partial name="_ManageNav" />
            </div>

            <div class="col-md-8">
                <div class="mb-1">
                    Correo actual: <span style="font-weight:200;">@Model.CurrentEmail</span>
                    <small class="form-text text-muted d-block mt-1">
                        Importante. Tu Correo tambien es tu nombre de usuario, Al cambiar el correo, cambiaras tambien tu Usuario con el que inicias sesión.
                    </small>
                </div>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* Floating label para el input de correo, igual que en el perfil *@
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewEmail" class="form-control" placeholder="Correo electrónico Nuevo" />
                        <label asp-for="Input.NewEmail">Correo electrónico Nuevo</label>
                        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                    </div>

                    <button type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Enviar enlace de confirmación</button>
                    <a asp-page="./Index" class="btn btn-link">Volver</a>
                </form>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-info mt-3">@Model.StatusMessage</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}