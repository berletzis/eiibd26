@page
@model eiibd26.Areas.Identity.Pages.Admin.Usuarios.UsuariosIndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }

        .crm-title-admin {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #14253f;
            margin-bottom: .7em;
        }

        .table-container-admin {
            max-width: 1320px;
            margin: 0 auto 0 auto;
        }

        .table-centered-admin {
            max-width: 1320px;
            margin: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            border: none;
            padding: 20px 22px 9px 22px;
        }

        #usersGrid {
            width: 100% !important;
            margin: 0;
        }

            #usersGrid th, #usersGrid td {
                border: none !important;
            }

            #usersGrid th {
                background: #eef4fa !important;
                color: #3d436c !important;
                font-weight: 600 !important;
                border-bottom: 2.7px solid #ddeaf7 !important;
                font-size: 1.07em;
            }

            #usersGrid tbody tr {
                border-bottom: 1.2px solid #e7ebf4 !important;
                box-shadow: 0 1px 18px #e6edfa0c;
            }

            #usersGrid tbody td {
                background: #fff !important;
                border-top: none !important;
                border-bottom: 1.1px solid #f2f7fd !important;
                font-size: 1.03em;
                padding-top: 13px !important;
                padding-bottom: 13px !important;
            }

            #usersGrid tbody tr:nth-child(even) td {
                background: #f9fbfc !important;
            }

        .badge-grid-gray {
            background: #ededed !important;
            color: #191919 !important;
            font-weight: 600;
            font-size: .92em;
            border-radius: 9px;
            border: 1px solid #dddddd;
            padding: 6px 12px;
            letter-spacing: .01em;
            box-shadow: 0 1px 7px #dde2eb22;
        }

        .btn-action-user {
            background: #f3f8fd !important;
            color: #315686 !important;
            border: 1.1px solid #dde3ee !important;
            font-weight: 500;
            margin-right: 0.10em;
            border-radius: 9px !important;
            box-shadow: 0 2px 8px #dde2eb18;
            padding: 6px 13px !important;
            font-size: .98em;
        }

            .btn-action-user:hover,
            .btn-action-user:focus {
                background: #e5ecf7 !important;
                color: #222 !important;
            }
        @@media (max-width: 1100px) {
            .crm-container-admin, .table-container-admin, .table-centered-admin

        {
            max-width: 99vw;
        }

        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Usuarios registrados</h2>
    <div class="table-centered-admin">
        <table id="usersGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Usuario</th>
                    <th>¿Hash válido?</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function() {
            $('#usersGrid').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'GET'
                },
                columns: [
                    { data: 'email', orderable: true },
                    { data: 'userName', orderable: true },
                    {
                        data: 'hashIsValid',
                        orderable: true,
                        render: function (data) {
                            return data
                                ? `<span class="badge bg-success">Sí</span>`
                                : `<span class="badge bg-danger">NO</span>`;
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        render: function(data){
                            return `<a class='btn btn-sm btn-action-user' href='/Identity/Admin/Usuarios/Detalles/${data}'><i class="bi bi-person-lines-fill me-1"></i>Detalles</a>`;
                        }
                    }
                ],
                order: [[0, "asc"]],
                columnDefs: [
                    { targets: 2, type: "num" }
                ]
            });
        });
    </script>
}