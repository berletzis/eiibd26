@page
@model eiibd26.Areas.Identity.Pages.Admin.Usuarios.UsuariosIndexModel
@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@attribute [Authorize(Roles = "Administrador")]

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .table-container-admin {
            max-width: 1320px;
            margin: 0 auto 0 auto;
        }

        .table-centered-admin {
            max-width: 1320px;
            margin: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            border: none;
            padding: 20px 22px 9px 22px;
        }

        #usersGrid {
            width: 100% !important;
            margin: 0;
        }

            #usersGrid th, #usersGrid td {
                border: none !important;
            }

            #usersGrid th {
                background: #eef4fa !important;
                color: #3d436c !important;
                font-weight: 600 !important;
                border-bottom: 2.7px solid #ddeaf7 !important;
                font-size: 1.07em;
            }

            #usersGrid tbody tr {
                border-bottom: 1.2px solid #e7ebf4 !important;
                box-shadow: 0 1px 18px #e6edfa0c;
            }

            #usersGrid tbody td {
                background: #fff !important;
                border-top: none !important;
                border-bottom: 1.1px solid #f2f7fd !important;
                font-size: 1.03em;
                padding-top: 13px !important;
                padding-bottom: 13px !important;
            }

            #usersGrid tbody tr:nth-child(even) td {
                background: #f9fbfc !important;
            }

        .badge-grid-gray {
            background: #ededed !important;
            color: #191919 !important;
            font-weight: 600;
            font-size: .92em;
            border-radius: 9px;
            border: 1px solid #dddddd;
            padding: 6px 12px;
            letter-spacing: .01em;
            box-shadow: 0 1px 7px #dde2eb22;
        }

        .btn-action-user {
            background: #f3f8fd !important;
            color: #315686 !important;
            border: 1.1px solid #dde3ee !important;
            font-weight: 500;
            margin-right: 0.10em;
            border-radius: 9px !important;
            box-shadow: 0 2px 8px #dde2eb18;
            padding: 6px 13px !important;
            font-size: .98em;
        }

            .btn-action-user:hover,
            .btn-action-user:focus {
                background: #e5ecf7 !important;
                color: #222 !important;
            }
        @@media (max-width: 1100px) {
            .table-container-admin, .table-centered-admin { max-width: 99vw; }
        }

        /* Cards de indicadores */
        .stats-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            border: 1px solid #e3e8ef;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .stats-card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }

        .stats-card.active {
            border-color: var(--eii-primary);
            box-shadow: 0 4px 20px rgba(106,78,122,0.2);
        }

        .stats-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1e293b;
            line-height: 1;
            margin-bottom: 8px;
        }

        .stats-label {
            font-size: 0.9rem;
            color: #64748b;
            font-weight: 500;
        }

        .stats-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
}

<div class="eii-page eii-page--wide">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
    <div class="d-flex align-items-center mb-3">
        <h2 class="eii-page-title eii-page-title--sm mb-0">Usuarios registrados</h2>
        <div class="ms-3 d-flex gap-2 align-items-center">
            <button id="btnFillUserSlugs" class="btn btn-sm btn-primary">Generar SLUGs vacíos</button>
            <span id="fillSlugsStatus" class="ms-2 text-muted" style="display:none"></span>
            <button id="btnAbrirCampana" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-envelope-paper me-1"></i>Campaña de reactivación
            </button>
        </div>
    </div>

    <!-- ⭐ NUEVO: Indicadores basados en SCORING de perfiles -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stats-card" id="cardTotal">
                <div class="stats-icon">👥</div>
                <div class="stats-value" id="statTotal">-</div>
                <div class="stats-label">Total usuarios</div>
                <small style="color:#64748b;font-size:0.75rem;">Todos los usuarios registrados</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" data-filter="completos" id="cardCompletos">
                <div class="stats-icon">🏆</div>
                <div class="stats-value" id="statCompletos">-</div>
                <div class="stats-label">Perfiles Completos (≥180 pts)</div>
                <small style="color:#64748b;font-size:0.75rem;">Diagnóstico + Avatar + Ánimo + Condición + País + Ubicación</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" data-filter="basicos" id="cardBasicos">
                <div class="stats-icon">📊</div>
                <div class="stats-value" id="statBasicos">-</div>
                <div class="stats-label">Perfiles Básicos (80-179 pts)</div>
                <small style="color:#64748b;font-size:0.75rem;">Diagnóstico + algunos datos adicionales</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" data-filter="minimos" id="cardMinimos">
                <div class="stats-icon">⚠️</div>
                <div class="stats-value" id="statMinimos">-</div>
                <div class="stats-label">Perfiles Mínimos (<80 pts)</div>
                <small style="color:#64748b;font-size:0.75rem;">Solo ubicación o datos incompletos</small>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="mb-3 p-3" style="background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <!-- ⭐ Hidden input para filtro de scoring -->
        <input type="hidden" id="filterScoring" value="" />

        <div class="row g-3 align-items-center">
            <div class="col-md-2" style="display:none;">
                <label class="form-label mb-1" style="font-size:0.9rem;font-weight:500;color:#555;">Filtrar por Hash:</label>
                <select id="filterHash" class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1" style="font-size:0.9rem;font-weight:500;color:#555;">Filtrar por Estado:</label>
                <select id="filterLockout" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="true">🔒 Bloqueados</option>
                    <option value="false">✅ Activos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1" style="font-size:0.9rem;font-weight:500;color:#555;">Filtrar por Condición:</label>
                <select id="filterCondicion" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    <!-- Se llenará dinámicamente -->
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1" style="font-size:0.9rem;font-weight:500;color:#555;">Filtrar por País:</label>
                <select id="filterPais" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <!-- Se llenará dinámicamente -->
                </select>
            </div>
            <div class="col-md-3">
                <button id="btnApplyFilters" class="btn btn-sm btn-primary mt-4">Aplicar Filtros</button>
                <button id="btnClearFilters" class="btn btn-sm btn-outline-secondary mt-4 ms-2">Limpiar</button>
            </div>
        </div>
    </div>

    <div class="table-centered-admin">
        <table id="usersGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Usuario</th>
                    <th>Fecha Registro</th>
                    <th>Condición</th>
                    <th>País</th>
                    <th>¿Hash válido?</th>
                    <th>¿Bloqueado?</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal Enviar Correo -->
<div class="modal fade" id="modalEnviarCorreo" tabindex="-1" aria-labelledby="modalEnviarCorreoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 4px 32px rgba(70,80,120,0.13);">
            <div class="modal-header" style="background:linear-gradient(135deg, var(--eii-primary-hover) 0%, var(--eii-primary) 100%);border-radius:14px 14px 0 0;">
                <h5 class="modal-title text-white fw-semibold" id="modalEnviarCorreoLabel"><i class="bi bi-envelope-fill me-2"></i>Enviar correo al usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-3" style="font-size:.95rem;">Se enviará un correo con enlace de configuración de contraseña.</p>
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:.85rem;font-weight:600;">NOMBRE</label>
                    <input type="text" id="modalNombre" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:.85rem;font-weight:600;">CORREO ELECTRÓNICO</label>
                    <input type="text" id="modalCorreo" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:.85rem;font-weight:600;">CONDICIÓN</label>
                    <input type="text" id="modalCondicion" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size:.85rem;font-weight:600;">TEMPLATE DE CORREO</label>
                    <div id="modalTemplatesContainer">
                        <div class="text-center py-2"><span class="spinner-border spinner-border-sm text-secondary"></span> <span class="text-muted" style="font-size:.85rem;">Cargando templates...</span></div>
                    </div>
                </div>
                <div id="modalEnviarStatus" class="alert d-none mt-3 mb-0" role="alert"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #eee;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEnvio" class="btn btn-primary"><i class="bi bi-send me-1"></i>Enviar correo</button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- Modal Campaña por Fases                                    -->
<!-- ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalCampana" tabindex="-1" aria-labelledby="modalCampanaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 4px 32px rgba(70,80,120,0.13);">
            <div class="modal-header" style="background:linear-gradient(135deg,#1a7abf 0%,#0d4f7c 100%);border-radius:14px 14px 0 0;">
                <h5 class="modal-title text-white fw-semibold" id="modalCampanaLabel">
                    <i class="bi bi-envelope-paper-fill me-2"></i>Campaña de reactivación por fases
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">

                <!-- Resumen de fases -->
                <div class="mb-4">
                    <h6 class="fw-semibold mb-3 text-muted" style="font-size:.85rem;letter-spacing:.05em;">ESTADO ACTUAL DE LA CAMPAÑA</h6>
                    <div id="campanaResumen" class="text-center py-3">
                        <span class="spinner-border spinner-border-sm text-secondary"></span>
                        <span class="text-muted ms-2" style="font-size:.85rem;">Cargando...</span>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Selector de fase -->
                <h6 class="fw-semibold mb-3 text-muted" style="font-size:.85rem;letter-spacing:.05em;">SELECCIONA LA FASE A ENVIAR (BATCH DE 10)</h6>
                <div class="row g-2 mb-3" id="campanaFaseSelector">
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded campana-fase-card" style="cursor:pointer;background:#f0f7ff;">
                            <input class="form-check-input" type="radio" name="campanaFase" id="fase1Radio" value="1" checked>
                            <label class="form-check-label w-100" for="fase1Radio" style="cursor:pointer;">
                                <span class="fw-semibold d-block" style="font-size:.9rem;"><i class="bi bi-1-circle me-1 text-primary"></i>Fase 1 — Reactivación</span>
                                <span class="text-muted d-block" style="font-size:.78rem;">Primer contacto. Sin pedir datos.</span>
                                <span class="badge bg-primary mt-1" id="badgeFase1">— elegibles</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded campana-fase-card" style="cursor:pointer;background:#f0fff4;">
                            <input class="form-check-input" type="radio" name="campanaFase" id="fase2Radio" value="2">
                            <label class="form-check-label w-100" for="fase2Radio" style="cursor:pointer;">
                                <span class="fw-semibold d-block" style="font-size:.9rem;"><i class="bi bi-2-circle me-1 text-success"></i>Fase 2 — Activación</span>
                                <span class="text-muted d-block" style="font-size:.78rem;">Acceso listo. Invitar a entrar.</span>
                                <span class="badge bg-success mt-1" id="badgeFase2">— elegibles</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded campana-fase-card" style="cursor:pointer;background:#fff8f0;">
                            <input class="form-check-input" type="radio" name="campanaFase" id="fase3Radio" value="3">
                            <label class="form-check-label w-100" for="fase3Radio" style="cursor:pointer;">
                                <span class="fw-semibold d-block" style="font-size:.9rem;"><i class="bi bi-3-circle me-1 text-warning"></i>Fase 3 — Recordatorio</span>
                                <span class="text-muted d-block" style="font-size:.78rem;">Fricción honesta. Último aviso.</span>
                                <span class="badge bg-warning text-dark mt-1" id="badgeFase3">— elegibles</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Aviso de template no configurado -->
                <div id="campanaTemplateAviso" class="alert alert-warning d-none py-2" style="font-size:.85rem;">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <span id="campanaTemplateAvisoText"></span>
                </div>

                <!-- Log de resultados -->
                <div id="campanaLogContainer" class="d-none mt-3">
                    <h6 class="fw-semibold mb-2 text-muted" style="font-size:.85rem;letter-spacing:.05em;">RESULTADO DEL BATCH</h6>
                    <div id="campanaLog" class="border rounded p-2" style="max-height:200px;overflow-y:auto;background:#f8f9ff;font-size:.82rem;font-family:monospace;"></div>
                    <div id="campanaResumenBatch" class="mt-2 fw-semibold" style="font-size:.88rem;"></div>
                </div>

                <div id="campanaStatus" class="alert d-none mt-3 mb-0" role="alert"></div>
            </div>
            <div class="modal-footer flex-column align-items-stretch" style="border-top:1px solid #eee;gap:.5rem;">
                <div class="d-flex align-items-center flex-wrap gap-2 w-100" style="background:#f8fff8;border:1px solid #c3e6cb;border-radius:.375rem;padding:.5rem .75rem;">
                    <span class="text-muted fw-semibold" style="font-size:.8rem;white-space:nowrap;">Prueba:</span>
                    <select id="campanaTemplatePrueba" class="form-select form-select-sm" style="max-width:220px;">
                        <option value="">Cargando templates...</option>
                    </select>
                    <input type="email" id="campanaCorreoPrueba" class="form-control form-control-sm" placeholder="correo@prueba.com" style="max-width:230px;" />
                    <button type="button" id="btnEnviarPrueba" class="btn btn-sm btn-outline-success text-nowrap">
                        <i class="bi bi-envelope-check me-1"></i>Enviar correo de prueba
                    </button>
                    <div id="campanaPruebaStatus" style="font-size:.82rem;"></div>
                </div>
                <div class="d-flex justify-content-end gap-2 w-100">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" id="btnEnviarBatch" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Enviar batch de 100
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        function avatarError(img) {
            var span = document.createElement('span');
            span.className = 'user-avatar-sm d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 rounded-circle';
            span.style.cssText = 'width:36px;height:36px;';
            span.innerHTML = '<i class="bi bi-person-fill text-secondary" style="font-size:1.2rem;"></i>';
            img.parentNode.replaceChild(span, img);
        }

        $(function() {
            // ⭐ NUEVO: Cargar estadísticas basadas en SCORING de perfiles
            function loadStats() {
                $.ajax({
                    url: '@Url.Page(null, "Estadisticas")',
                    type: 'GET',
                    dataType: 'json',
                    success: function(data) {
                        $('#statTotal').text(data.totalUsuarios || 0);
                        $('#statCompletos').text(data.perfilesCompletos || 0);
                        $('#statBasicos').text(data.perfilesBasicos || 0);
                        $('#statMinimos').text(data.perfilesMinimos || 0);
                    },
                    error: function(xhr, status, error) {
                        console.error('Error cargando estadísticas:', error);
                        console.error('Status:', xhr.status);
                        console.error('Response:', xhr.responseText);
                    }
                });
            }

            loadStats(); // Cargar al inicio

            // Cargar condiciones y países para filtros
            $.ajax({
                url: '@Url.Page(null, "CondicionesPadre")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    data.forEach(function(c) {
                        $('#filterCondicion').append(`<option value="${c.id}">${c.nombre}</option>`);
                    });
                },
                error: function(xhr, status, error) {
                    console.error('Error cargando condiciones:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                }
            });

            $.ajax({
                url: '@Url.Page(null, "Paises")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    data.forEach(function(p) {
                        $('#filterPais').append(`<option value="${p}">${p}</option>`);
                    });
                },
                error: function(xhr, status, error) {
                    console.error('Error cargando países:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                }
            });

            var table = $('#usersGrid').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content')
                    },
                    data: function(d) {
                        // Agregar filtros personalizados
                        d.filterHash = $('#filterHash').val();
                        d.filterLockout = $('#filterLockout').val();
                        d.filterCondicion = $('#filterCondicion').val();
                        d.filterPais = $('#filterPais').val();
                        d.filterScoring = $('#filterScoring').val(); // ⭐ NUEVO
                    }
                },
                columns: [
                    {
                        data: 'avatar',
                        orderable: false,
                        render: function(data) {
                            if (!data) return '<span class="user-avatar-sm d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 rounded-circle" style="width:36px;height:36px;"><i class="bi bi-person-fill text-secondary" style="font-size:1.2rem;"></i></span>';
                            return '<img src="' + data + '" class="user-avatar-sm" alt="Avatar" style="width:36px;height:36px;object-fit:cover;border-radius:50%;" loading="lazy" decoding="async" onerror="avatarError(this)" />';
                        }
                    },
                    {
                        data: 'nombre',
                        orderable: true,
                        render: function(data) {
                            if (!data) return '<span style="color:#999;">Sin nombre</span>';
                            return data;
                        }
                    },
                    { data: 'email', orderable: true },
                    { data: 'userName', orderable: true },
                    {
                        data: 'fechaRegistro',
                        orderable: true,
                        render: function(data) {
                            if (!data) return '<span style="color:#999;">-</span>';
                            var d = new Date(data);
                            return d.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' });
                        }
                    },
                    {
                        data: 'condicion',
                        orderable: false,
                        render: function(data) {
                            if (!data) return '<span style="color:#999;">Sin condición</span>';
                            return `<span class="badge bg-info">${data}</span>`;
                        }
                    },
                    {
                        data: 'pais',
                        orderable: true,
                        render: function(data) {
                            if (!data) return '<span style="color:#999;">-</span>';
                            return data;
                        }
                    },
                    {
                        data: 'hashIsValid',
                        orderable: false,
                        render: function () {
                            return `<span class="badge badge-grid-gray">Usar "Olvidé contraseña"</span>`;
                        }
                    },
                    {
                        data: 'isLockedOut',
                        orderable: true,
                        render: function(data) {
                            return data
                                ? `<span class="badge bg-warning text-dark">🔒 Bloqueado</span>`
                                : `<span class="badge bg-success">✅ Activo</span>`;
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        render: function(data, type, row){
                            var nombre = (row.nombre || '').replace(/'/g, "&#39;");
                            var correo = (row.email || '').replace(/'/g, "&#39;");
                            var condicion = (row.condicion || '').replace(/'/g, "&#39;");
                            return `<a class='btn btn-sm btn-action-user' href='/Identity/Admin/Usuarios/Detalles/${data}'><i class="bi bi-person-lines-fill me-1"></i>Detalles</a>` +
                                `<button class='btn btn-sm btn-action-user btn-enviar-correo ms-1' ` +
                                    `data-userid='${data}' ` +
                                    `data-nombre='${nombre}' ` +
                                    `data-correo='${correo}' ` +
                                    `data-condicion='${condicion}'>` +
                                    `<i class="bi bi-envelope me-1"></i>Enviar correo` +
                                `</button>`;
                        }
                    }
                ],
                order: [[4, "desc"]], // Ordenar por Fecha Registro DESC por defecto
                columnDefs: [
                    { targets: 4, type: "date" },
                    { targets: 7, type: "num" },
                    { targets: 8, type: "num" }
                ],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ usuarios",
                    infoEmpty: "No hay registros",
                    infoFiltered: "(filtrado de _MAX_ usuarios totales)",
                    zeroRecords: "No se encontraron usuarios",
                    emptyTable: "No hay datos disponibles",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    },
                    processing: "Procesando..."
                }
            });

            // ⭐ NUEVO: Click en cards de indicadores (AHORA CON FILTRADO REAL)
            $('.stats-card').on('click', function() {
                var filter = $(this).data('filter');

                // Remover clase active de todos
                $('.stats-card').removeClass('active');

                // Marcar como activo
                $(this).addClass('active');

                // Limpiar filtros manuales
                $('#filterHash').val('');
                $('#filterLockout').val('');
                $('#filterCondicion').val('');
                $('#filterPais').val('');

                // Establecer filtro de scoring
                $('#filterScoring').val(filter);

                // Recargar tabla con el filtro
                table.ajax.reload();
            });

            // Aplicar filtros
            $('#btnApplyFilters').on('click', function() {
                $('.stats-card').removeClass('active'); // Quitar active de cards
                $('#filterScoring').val(''); // Limpiar filtro de scoring
                table.ajax.reload();
            });

            // Limpiar filtros
            $('#btnClearFilters').on('click', function() {
                $('#filterHash').val('');
                $('#filterLockout').val('');
                $('#filterCondicion').val('');
                $('#filterPais').val('');
                $('#filterScoring').val(''); // ⭐ NUEVO
                $('.stats-card').removeClass('active');
                table.ajax.reload();
            });

            // Handler for generating missing slugs
            $('#btnFillUserSlugs').on('click', function () {
                if (!confirm('¿Generar slugs para usuarios que no los tienen y actualizar su fecha de modificación?')) return;
                var $btn = $(this);
                $btn.prop('disabled', true).text('Procesando...');
                $('#fillSlugsStatus').hide().text('');

                fetch(window.location.pathname + '?handler=FillMissingSlugs', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    }
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        $btn.prop('disabled', false).text('Generar SLUGs vacíos');
                        if (data && data.modified !== undefined) {
                            $('#fillSlugsStatus').show().text('SLUGs generados: ' + data.modified);
                        } else if (data && data.error) {
                            $('#fillSlugsStatus').show().text('Error: ' + data.error);
                        } else {
                            $('#fillSlugsStatus').show().text('Operación completada.');
                        }
                    })
                    .catch(function (err) {
                        $btn.prop('disabled', false).text('Generar SLUGs vacíos');
                        $('#fillSlugsStatus').show().text('Error: ' + err);
                    });
            });

            // Enviar correo — abrir modal con datos de la fila
            $(document).on('click', '.btn-enviar-correo', function () {
                var $btn = $(this);
                $('#modalNombre').val($btn.data('nombre') || 'Sin nombre');
                $('#modalCorreo').val($btn.data('correo') || '');
                $('#modalCondicion').val($btn.data('condicion') || 'Sin condición');
                $('#modalEnviarStatus').addClass('d-none').text('');
                $('#btnConfirmarEnvio')
                    .prop('disabled', true)
                    .html('<i class="bi bi-send me-1"></i>Enviar correo')
                    .data('userid', $btn.data('userid'));

                // Cargar templates desde el servidor
                $('#modalTemplatesContainer').html('<div class="text-center py-2"><span class="spinner-border spinner-border-sm text-secondary"></span> <span class="text-muted" style="font-size:.85rem;">Cargando templates...</span></div>');

                fetch(window.location.pathname + '?handler=TemplatesCorreo')
                    .then(function (r) { return r.json(); })
                    .then(function (templates) {
                        if (!templates || templates.length === 0) {
                            $('#modalTemplatesContainer').html('<p class="text-muted" style="font-size:.85rem;">No hay templates configurados.</p>');
                            $('#btnConfirmarEnvio').prop('disabled', false);
                            return;
                        }
                        var html = '';
                        templates.forEach(function (t, i) {
                            var checked = i === 0 ? 'checked' : '';
                            html += '<div class="form-check mb-2 p-3 border rounded" style="cursor:pointer;background:#f8f9ff;">' +
                                '<input class="form-check-input" type="radio" name="templateRadio" id="tpl_' + i + '" value="' + t.id + '" ' + checked + '>' +
                                '<label class="form-check-label w-100" for="tpl_' + i + '" style="cursor:pointer;">' +
                                '<span class="fw-semibold d-block" style="font-size:.9rem;">' + $('<span>').text(t.nombre).html() + '</span>' +
                                '<span class="text-muted d-block" style="font-size:.8rem;">' + $('<span>').text(t.descripcion).html() + '</span>' +
                                '</label></div>';
                        });
                        $('#modalTemplatesContainer').html(html);
                        $('#btnConfirmarEnvio').prop('disabled', false);
                    })
                    .catch(function () {
                        $('#modalTemplatesContainer').html('<p class="text-danger" style="font-size:.85rem;">Error al cargar templates.</p>');
                        $('#btnConfirmarEnvio').prop('disabled', false);
                    });

                var modal = new bootstrap.Modal(document.getElementById('modalEnviarCorreo'));
                modal.show();
            });

            // Confirmar envío desde el modal
            $('#btnConfirmarEnvio').on('click', function () {
                var $btn = $(this);
                var userId = $btn.data('userid');
                if (!userId) return;

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Enviando...');
                $('#modalEnviarStatus').addClass('d-none').text('');

                var selectedTemplateId = $('input[name="templateRadio"]:checked').val() || '';

                fetch(window.location.pathname + '?handler=EnviarCorreo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content') || ''
                    },
                    body: JSON.stringify({ userId: userId, templateId: selectedTemplateId })
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            $('#modalEnviarStatus')
                                .removeClass('d-none alert-danger')
                                .addClass('alert-success')
                                .html('<i class="bi bi-check-circle me-1"></i>Correo enviado correctamente.');
                            $btn.prop('disabled', true).html('<i class="bi bi-check me-1"></i>Enviado');
                        } else {
                            $('#modalEnviarStatus')
                                .removeClass('d-none alert-success')
                                .addClass('alert-danger')
                                .html('<i class="bi bi-exclamation-triangle me-1"></i>' + (data.error || 'Error al enviar el correo.'));
                            $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i>Enviar correo');
                        }
                    })
                    .catch(function (err) {
                        $('#modalEnviarStatus')
                            .removeClass('d-none alert-success')
                            .addClass('alert-danger')
                            .html('<i class="bi bi-exclamation-triangle me-1"></i>Error de conexión. Intenta de nuevo.');
                        $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i>Enviar correo');
                    });
            });

            // ──────────────────────────────────────────────────────────────────
            // CAMPAÑA POR FASES
            // ──────────────────────────────────────────────────────────────────

            var campanaResumenData = null;

            function cargarCampanaResumen() {
                $('#campanaResumen').html('<span class="spinner-border spinner-border-sm text-secondary"></span><span class="text-muted ms-2" style="font-size:.85rem;">Cargando...</span>');
                fetch(window.location.pathname + '?handler=CampanaResumen')
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        campanaResumenData = d;
                        $('#badgeFase1').text(d.elegiblesFase1 + ' elegibles');
                        $('#badgeFase2').text(d.elegiblesFase2 + ' elegibles');
                        $('#badgeFase3').text(d.elegiblesFase3 + ' elegibles');
                        $('#campanaResumen').html(
                            '<div class="row text-center g-2">' +
                            '<div class="col">' +
                                '<div class="border rounded p-2" style="background:#f8f9ff;">' +
                                '<div class="fw-bold text-primary" style="font-size:1.4rem;">' + d.totalUsuarios + '</div>' +
                                '<div class="text-muted" style="font-size:.78rem;">Total usuarios</div></div></div>' +
                            '<div class="col">' +
                                '<div class="border rounded p-2" style="background:#f0f7ff;">' +
                                '<div class="fw-bold text-primary" style="font-size:1.4rem;">' + d.conFase1 + '</div>' +
                                '<div class="text-muted" style="font-size:.78rem;">Recibieron F1</div></div></div>' +
                            '<div class="col">' +
                                '<div class="border rounded p-2" style="background:#f0fff4;">' +
                                '<div class="fw-bold text-success" style="font-size:1.4rem;">' + d.conFase2 + '</div>' +
                                '<div class="text-muted" style="font-size:.78rem;">Recibieron F2</div></div></div>' +
                            '<div class="col">' +
                                '<div class="border rounded p-2" style="background:#fff8f0;">' +
                                '<div class="fw-bold text-warning" style="font-size:1.4rem;">' + d.conFase3 + '</div>' +
                                '<div class="text-muted" style="font-size:.78rem;">Recibieron F3</div></div></div>' +
                            '<div class="col">' +
                                '<div class="border rounded p-2" style="background:#f0fdf0;">' +
                                '<div class="fw-bold text-success" style="font-size:1.4rem;">' + d.completados + '</div>' +
                                '<div class="text-muted" style="font-size:.78rem;">Completados</div></div></div>' +
                            '</div>'
                        );
                    })
                    .catch(function() {
                        $('#campanaResumen').html('<span class="text-danger" style="font-size:.85rem;">Error al cargar resumen.</span>');
                    });
            }

            $('#btnAbrirCampana').on('click', function() {
                $('#campanaLogContainer').addClass('d-none');
                $('#campanaLog').html('');
                $('#campanaResumenBatch').html('');
                $('#campanaStatus').addClass('d-none');
                $('#campanaTemplateAviso').addClass('d-none');
                $('#btnEnviarBatch').prop('disabled', false).html('<i class="bi bi-send me-1"></i>Enviar batch de 10');
                // Poblar select de templates para prueba
                $('#campanaTemplatePrueba').html('<option value="">Cargando...</option>').prop('disabled', true);
                fetch(window.location.pathname + '?handler=TemplatesCorreo')
                    .then(function(r) { return r.json(); })
                    .then(function(templates) {
                        var opts = '<option value="">-- Selecciona template --</option>';
                        if (templates && templates.length) {
                            templates.forEach(function(t) {
                                var label = t.nombre + (t.fase > 0 ? ' (Fase ' + t.fase + ')' : '');
                                opts += '<option value="' + t.id + '">' + label + '</option>';
                            });
                        }
                        $('#campanaTemplatePrueba').html(opts).prop('disabled', false);
                    })
                    .catch(function() {
                        $('#campanaTemplatePrueba').html('<option value="">Error al cargar</option>').prop('disabled', false);
                    });
                cargarCampanaResumen();
                new bootstrap.Modal(document.getElementById('modalCampana')).show();
            });

            $('#btnEnviarBatch').on('click', function() {
                var fase = parseInt($('input[name="campanaFase"]:checked').val());
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Enviando...');
                $('#campanaStatus').addClass('d-none');
                $('#campanaTemplateAviso').addClass('d-none');
                $('#campanaLogContainer').addClass('d-none');
                $('#campanaLog').html('');

                fetch(window.location.pathname + '?handler=CampanaEnviarBatch', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('meta[name="csrf-token"]').attr('content') || ''
                    },
                    body: JSON.stringify({ fase: fase })
                })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i>Enviar batch de 10');
                        if (!data.success) {
                            $('#campanaTemplateAviso').removeClass('d-none');
                            $('#campanaTemplateAvisoText').text(data.error || 'Error desconocido.');
                            return;
                        }
                        if (data.procesados === 0) {
                            $('#campanaStatus')
                                .removeClass('d-none alert-danger').addClass('alert-info')
                                .html('<i class="bi bi-info-circle me-1"></i>' + (data.mensaje || 'No hay usuarios elegibles para esta fase.'));
                            cargarCampanaResumen();
                            return;
                        }
                        // Mostrar log
                        var logHtml = '';
                        data.resultados.forEach(function(r) {
                            var icon = r.exito
                                ? '<i class="bi bi-check-circle-fill text-success me-1"></i>'
                                : '<i class="bi bi-x-circle-fill text-danger me-1"></i>';
                            var err = r.error ? ' <span class="text-danger">— ' + $('<span>').text(r.error).html() + '</span>' : '';
                            logHtml += '<div>' + icon + $('<span>').text(r.email).html() + err + '</div>';
                        });
                        $('#campanaLog').html(logHtml);
                        $('#campanaResumenBatch').html(
                            '<span class="text-success"><i class="bi bi-check-circle me-1"></i>' + data.exitosos + ' enviados</span>' +
                            (data.fallidos > 0 ? ' &nbsp; <span class="text-danger"><i class="bi bi-x-circle me-1"></i>' + data.fallidos + ' fallidos</span>' : '')
                        );
                        $('#campanaLogContainer').removeClass('d-none');
                        cargarCampanaResumen();
                    })
                    .catch(function() {
                        $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i>Enviar batch de 10');
                        $('#campanaStatus')
                            .removeClass('d-none alert-success alert-info').addClass('alert-danger')
                            .html('<i class="bi bi-exclamation-triangle me-1"></i>Error de conexión. Intenta de nuevo.');
                    });
            });

        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btnEnviarPrueba').addEventListener('click', function () {
                var emailInput = document.getElementById('campanaCorreoPrueba');
                var email = emailInput.value.trim();
                var templateSelect = document.getElementById('campanaTemplatePrueba');
                var templateId = templateSelect ? templateSelect.value : '';
                var statusEl = document.getElementById('campanaPruebaStatus');
                var btn = this;

                if (!templateId) {
                    statusEl.innerHTML = '<span class="text-warning">Selecciona un template.</span>';
                    return;
                }
                if (!emailInput.checkValidity() || !email) {
                    statusEl.innerHTML = '<span class="text-danger">Ingresa un correo válido.</span>';
                    return;
                }

                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando...';
                statusEl.innerHTML = '';

                var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
                fetch(window.location.pathname + '?handler=CampanaEnviarPrueba', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ email: email, templateId: templateId })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-envelope-check me-1"></i>Enviar correo de prueba';
                    if (data.success) {
                        statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Enviado</span>';
                    } else {
                        var msg = document.createElement('span');
                        msg.textContent = data.error || 'Error';
                        statusEl.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>' + msg.textContent + '</span>';
                    }
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-envelope-check me-1"></i>Enviar correo de prueba';
                    statusEl.innerHTML = '<span class="text-danger">Error de conexión.</span>';
                });
            });
        });
    </script>
}