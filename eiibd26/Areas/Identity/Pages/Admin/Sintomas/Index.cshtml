@page
@model eiibd26.Areas.Identity.Pages.Admin.Sintomas.IndexModel
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize(Roles = "Administrador")] *@

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        /* ===== NUEVO LAYOUT CON PANEL LATERAL ===== */
        .admin-layout-flex {
            display: flex;
            gap: 24px;
            min-height: calc(100vh - 200px);
            margin-top: 20px;
            transition: all 0.3s ease-out;
        }

        .grid-wrapper {
            flex: 1 1 auto;
            min-width: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            padding: 20px;
            transition: all 0.3s ease-out;
        }

        .side-panel {
            width: 0;
            min-width: 0;
            flex-shrink: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            padding: 0;
            max-height: calc(100vh - 200px);
            overflow: hidden;
            opacity: 0;
            transition: all 0.3s ease-out;
            position: sticky;
            top: 20px;
            z-index: 10;
        }

        .side-panel.active {
            width: 35%;
            min-width: 400px;
            padding: 24px;
            opacity: 1;
            overflow-y: auto;
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .side-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 16px;
            margin-bottom: 24px;
        }

        .side-panel-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            color: #14253f;
        }

        .btn-close-panel {
            background: #f3f4f6;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #6b7280;
            transition: all 0.2s;
        }

        .btn-close-panel:hover {
            background: #e5e7eb;
            color: #374151;
        }

        /* ===== BOTÓN GENERAR IA ===== */
        .btn-generar-ia {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 12px;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-generar-ia:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-generar-ia:disabled {
            background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
            cursor: not-allowed;
            transform: none;
        }

        .loading-spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spinner 0.8s linear infinite;
        }

        @@keyframes spinner {
            to { transform: rotate(360deg); }
        }

        /* ===== ESTILOS EXISTENTES ADAPTADOS ===== */
        .table-centered-admin {
            background: transparent;
            border-radius: 0;
            box-shadow: none;
            padding: 0;
            overflow-x: auto;
        }

        /* Asegurar que el DataTable sea responsive */
        .dataTables_wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table.dataTable {
            width: 100% !important;
        }

        .dt-controls-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }

        .btn-action-sintoma {
            padding: 6px 14px;
            font-size: 0.875rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-editar-sintoma {
            background: #3b82f6;
            color: white;
        }

        .btn-editar-sintoma:hover {
            background: #2563eb;
            transform: translateY(-1px);
        }

        .btn-borrar-sintoma {
            background: #ef4444;
            color: white;
        }

        .btn-borrar-sintoma:hover {
            background: #dc2626;
        }

        .btn-restaurar-sintoma {
            background: #10b981;
            color: white;
        }

        .btn-restaurar-sintoma:hover {
            background: #059669;
        }

        .sint-padre {
            font-weight: 600;
            color: #14253f;
        }

        .sint-hijo {
            color: #6b7280;
            padding-left: 20px;
        }

        .badge-grid-gray {
            background: #e5e7eb;
            color: #374151;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
        }

        .alert-success {
            background: #d1fae5;
            border: 1px solid #10b981;
            color: #065f46;
            border-radius: 8px;
            padding: 12px;
        }

        @@media (max-width: 1200px) {
            .admin-layout-flex {
                flex-direction: column;
            }
            .grid-wrapper, .side-panel {
                flex: 1 1 100%;
                max-width: 100%;
            }
            .side-panel {
                position: static;
                max-height: none;
            }
        }
    </style>
}

<div class="eii-page eii-page--wide">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="eii-page-title eii-page-title--sm mb-0">Síntomas</h2>

        <!-- ⭐ NUEVO: Botón Actualización Masiva -->
        <button type="button" class="btn btn-primary btn-lg" id="btnActualizacionMasiva">
            <i class="bi bi-magic"></i> Actualización Masiva con IA
        </button>
    </div>

    <div class="admin-layout-flex">
        <!-- ===== GRID (LADO IZQUIERDO 65%) ===== -->
        <div class="grid-wrapper">
            <div class="dt-controls-flex">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchEliminadosSintomas">
                    <label class="form-check-label" for="switchEliminadosSintomas">Mostrar eliminados</label>
                </div>
            </div>

            <div class="table-centered-admin">
                <table id="sintomasGrid" class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Tipo Seguimiento</th>
                            <th>ID Padre</th>
                            <th>Idioma</th>
                            <th><i class="bi bi-robot" title="Validado por IA"></i> IA</th>
                            <th><i class="bi bi-person-check" title="Validado por Humano"></i> Humano</th>
                            <th>EII</th>
                            <th>Eliminado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- ===== PANEL LATERAL (LADO DERECHO 35%) ===== -->
        <div class="side-panel" id="panelEditarSintoma">
            <div class="side-panel-header">
                <h3>Editar Síntoma</h3>
                <button type="button" class="btn-close-panel" id="btnCerrarPanel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="formEditarSintoma">
                <input type="hidden" name="id" id="editSintoma_id">

                <div class="mb-3">
                    <label for="editSintoma_nombre" class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control" id="editSintoma_nombre" name="nombre" required>
                </div>

                <!-- Otros campos colapsados -->
                <div class="accordion accordion-flush mb-3" id="acordeonOtrosSintoma">
                    <div class="accordion-item border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2 px-3"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#otrosCamposSintoma"
                                    aria-expanded="false"
                                    style="background:#f9fafb;font-size:.875rem;">
                                <i class="bi bi-three-dots me-2 text-muted"></i>
                                <span class="text-muted">Otros campos</span>
                            </button>
                        </h2>
                        <div id="otrosCamposSintoma" class="accordion-collapse collapse">
                            <div class="accordion-body py-2 px-3">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <label class="form-label small mb-1">ID Padre</label>
                                        <input type="number" class="form-control form-control-sm"
                                               id="editSintoma_idPadre" name="idPadre">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1">ID Idioma</label>
                                        <input type="number" class="form-control form-control-sm"
                                               id="editSintoma_idIdioma" name="idIdioma">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1">Ícono</label>
                                        <input type="text" class="form-control form-control-sm"
                                               id="editSintoma_icono" name="icono">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== NUEVO: DESCRIPCIÓN IA ===== -->
                <div class="mb-3">
                    <label for="editSintoma_descripcionIA" class="form-label fw-semibold">
                        <i class="bi bi-magic"></i> Descripción IA
                    </label>
                    <textarea class="form-control" id="editSintoma_descripcionIA" name="descripcionIA" rows="6" 
                              placeholder="Genera una descripción automática con IA..."></textarea>
                    <button type="button" class="btn-generar-ia" id="btnGenerarIA">
                        <i class="bi bi-stars"></i>
                        <span>Generar con IA</span>
                    </button>
                </div>

                <!-- ===== NUEVO: VALIDACIÓN HUMANA ===== -->
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="editSintoma_validadoHumano" name="validadoHumano">
                    <label class="form-check-label" for="editSintoma_validadoHumano">
                        <i class="bi bi-person-check-fill text-primary"></i> Validado por Humano
                    </label>
                </div>

                <!-- ===== NUEVO: RELACIÓN CON EII (SOLO LECTURA) ===== -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-info-circle-fill text-primary"></i> Relación con EII
                    </label>
                    <div class="alert alert-info mb-0" id="editSintoma_relacionEIIContainer" style="display: none;">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                            <div>
                                <strong>Este síntoma está relacionado con la EII</strong>
                                <p class="mb-0 mt-2" id="editSintoma_relacionEIITexto"></p>

                                <!-- ⭐ MOSTRAR FUENTES SOLO SI EXISTEN -->
                                <div class="mt-2 pt-2 border-top" id="editSintoma_fuentesContainer" style="display: none;">
                                    <small class="text-muted">
                                        <i class="bi bi-link-45deg"></i> <strong>Fuentes verificadas:</strong> 
                                        <span id="editSintoma_fuentes"></span>
                                    </small>
                                </div>

                                <!-- ⭐ DISCLAIMER CUANDO NO HAY FUENTES -->
                                <div class="mt-2 pt-2 border-top" id="editSintoma_noFuentesDisclaimer" style="display: none;">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle"></i> 
                                        <em>Información generada por IA. Consulta fuentes médicas confiables o tu médico para verificar.</em>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-secondary mb-0" id="editSintoma_noRelacionEIIContainer" style="display: none;">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-x-circle text-muted me-2 mt-1"></i>
                            <div>
                                <strong>Sin relación documentada con EII</strong>
                                <p class="mb-0 mt-2 text-muted">No se encontró evidencia de relación con Enfermedad Inflamatoria Intestinal</p>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">Esta información la determina la IA automáticamente</small>
                </div>

                <!-- ===== BLOQUE GLOSARIO ===== -->
                <div class="card mb-3 border-0" id="editSintoma_glosarioBlock" style="display:none;">
                    <div class="card-header text-white py-2 rounded-top"
                         style="background:linear-gradient(135deg,#3b82f6,#6366f1);">
                        <i class="bi bi-journal-medical me-1"></i>
                        <span class="fw-semibold">Glosario Médico</span>
                        <small class="ms-2 opacity-75" id="editSintoma_glosarioTermId"></small>
                    </div>
                    <div class="card-body p-3" style="background:#f8faff;">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <p class="text-muted mb-1" style="font-size:.75rem;">Sugerido por NINA:</p>
                                <div id="editSintoma_nivelIA"><span class="text-muted small fst-italic">No determinado</span></div>
                            </div>
                            <div class="col-6">
                                <p class="text-muted mb-1" style="font-size:.75rem;">Confirmado (admin):</p>
                                <div id="editSintoma_nivelConfirmado"><span class="text-muted small fst-italic">Sin confirmar</span></div>
                            </div>
                        </div>
                        <div id="editSintoma_reasoningBlock" class="mb-3 p-2 rounded"
                             style="background:#fff;border:1px solid #e0e7ff;display:none;">
                            <p class="mb-1" style="font-size:.72rem;color:#6366f1;">
                                <i class="bi bi-robot me-1"></i><strong>Razonamiento NINA:</strong>
                            </p>
                            <p class="mb-0 small" id="editSintoma_reasoning"></p>
                        </div>
                        <hr class="my-2">
                        <p class="fw-semibold mb-2" style="font-size:.8rem;">
                            <i class="bi bi-people me-1"></i> Historial de validaciones:
                        </p>
                        <div id="editSintoma_validaciones">
                            <p class="text-muted small mb-0 fst-italic">Sin validaciones registradas</p>
                        </div>
                    </div>
                </div>

                <!-- Activo / Eliminado -->
                <!-- ===== TIPO DE SÍNTOMA ===== -->
                <div class="mb-3">
                    <label for="editSintoma_tipoSintoma" class="form-label fw-semibold">
                        <i class="bi bi-tag-fill text-info"></i> Tipo de síntoma
                    </label>
                    <select class="form-select" id="editSintoma_tipoSintoma" name="tipoSintoma">
                        <option value="0">Subjetivo (acné, fatiga, ansiedad, dolor articular)</option>
                        <option value="1">Medible GI (diarrea, evacuaciones, sangrado)</option>
                    </select>
                    <div class="form-text">Controla qué campos se capturan en el seguimiento.</div>
                </div>

                <div class="mb-3 d-flex align-items-center gap-2 p-2 rounded border">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="editSintoma_activo" style="cursor:pointer;">
                        <label class="form-check-label fw-semibold" for="editSintoma_activo">
                            Registro activo
                        </label>
                    </div>
                    <small class="text-muted">(desmarcar = eliminar registro)</small>
                </div>

                <div class="alert alert-success d-none" id="msgEditSintomaSuccess">
                    <i class="bi bi-check-circle-fill"></i> ¡Guardado exitosamente!
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-lg"></i> Guardar Cambios
                    </button>
                    <button type="button" class="btn btn-secondary" id="btnCancelar">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ⭐ MODAL DE ACTUALIZACIÓN MASIVA -->
<div class="modal fade" id="modalActualizacionMasiva" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-magic"></i> Actualización Masiva con IA
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" id="btnCerrarModal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Este proceso generará descripciones IA automáticamente</strong>
                    <p class="mb-0 mt-2">Procesa registros en lotes. Selecciona cuántos registros procesar en total y el sistema hará sub-lotes de 10 con pausa entre cada sub-lote para evitar saturación.</p>
                    <div class="mt-2">
                        <label class="form-label small mb-1">Registros a procesar:</label>
                        <select id="selectBatchSize" class="form-select form-select-sm" style="width:120px;display:inline-block;">
                            <option value="10">10</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500">500</option>
                            <option value="1000">1000</option>
                        </select>
                        <small class="text-muted ms-2">Sub-lotes de 10, pausa 5s entre cada sub-lote</small>
                    </div>
                </div>

                <!-- Progreso -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span><strong>Progreso:</strong></span>
                        <span id="progresoTexto">0 / 0 procesados</span>
                    </div>
                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                             id="progressBar" 
                             role="progressbar" 
                             style="width: 0%">
                            0%
                        </div>
                    </div>
                </div>

                <!-- Estadísticas -->
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="card bg-success text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="exitososCount">0</h3>
                                <small>Exitosos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-danger text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="fallidosCount">0</h3>
                                <small>Fallidos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="pendientesCount">0</h3>
                                <small>Pendientes</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Log de resultados -->
                <div class="card">
                    <div class="card-header bg-light">
                        <strong>Registro de procesamiento:</strong>
                    </div>
                    <div class="card-body" style="max-height: 300px; overflow-y: auto;" id="logResultados">
                        <p class="text-muted">Presiona "Iniciar Actualización" para comenzar...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="btnCerrar">Cerrar</button>
                <div>
                    <button type="button" class="btn btn-primary btn-lg" id="btnIniciarBatch">
                        <i class="bi bi-play-fill"></i> Iniciar Actualización
                    </button>
                    <button type="button" class="btn btn-success btn-lg d-none" id="btnContinuarBatch">
                        <i class="bi bi-arrow-right-circle-fill"></i> Continuar (Siguientes 10)
                    </button>
                    <button type="button" class="btn btn-warning d-none" id="btnPausarBatch">
                        <i class="bi bi-pause-fill"></i> Pausar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var urlEditarSintoma = Url.Page(null, "EditarSintoma");
}
<script>console.log("URL EditarSintoma:", "@urlEditarSintoma");</script>
@section Scripts {
    <div style="display:none">@Html.AntiForgeryToken()</div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let sintomasTabla;
        let hijosSintPorPadre = {};

        // ===== HELPERS GLOSARIO SINTOMAS =====
        function nivelBadgeSint(level) {
            if (!level && level !== 0) return '<span class="text-muted small fst-italic">—</span>';
            const map = { 1: ['\uD83D\uDFE2', 'Directa', 'success'], 2: ['\uD83D\uDFE1', 'Indirecta', 'warning'], 3: ['\uD83D\uDD35', 'Secundaria', 'info'] };
            const [icon, label, color] = map[level] || ['\u26AA', 'Desconocido', 'secondary'];
            return `<span class="badge bg-${color}">${icon} ${label}</span>`;
        }

        function renderValidacionesSint(validations) {
            if (!validations || validations.length === 0)
                return '<p class="text-muted small mb-0 fst-italic">Sin validaciones registradas</p>';
            const typeLabels = { 1: 'Descripci\u00f3n', 2: 'Relaci\u00f3n' };
            return validations.map(v => {
                const date = new Date(v.createdAt).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: '2-digit' });
                const typeLabel = typeLabels[v.validationType] || 'Validaci\u00f3n';
                const levelHtml = v.relationTypeId ? nivelBadgeSint(v.relationTypeId) : '';
                const commentHtml = v.comment ? `<p class="mb-0 small text-dark mt-1">&ldquo;${v.comment}&rdquo;</p>` : '';
                return `<div class="d-flex gap-2 align-items-start mb-2 p-2 rounded" style="background:#fff;border:1px solid #e5e7eb;">
                    <i class="bi bi-person-circle text-secondary flex-shrink-0 mt-1" aria-label="privado" title="privado" style="font-size:1.1rem;"></i>
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                            <span class="fw-semibold small">${v.userDisplay}</span>
                            <span class="badge bg-secondary" style="font-size:.65rem;">${typeLabel}</span>
                            ${levelHtml}
                            <small class="text-muted ms-auto">${date}</small>
                        </div>
                        ${commentHtml}
                    </div>
                </div>`;
            }).join('');
        }

        function cargarGlosarioSintoma(id) {
            $('#editSintoma_glosarioBlock').hide();
            $.get('/api/admin/sintomas/' + id + '/glossary', function (g) {
                if (!g || !g.ok || !g.hasGlossaryTerm) return;
                $('#editSintoma_glosarioTermId').text('#' + g.glossaryTermId);
                $('#editSintoma_nivelIA').html(nivelBadgeSint(g.nivelSugerido));
                $('#editSintoma_nivelConfirmado').html(nivelBadgeSint(g.nivelConfirmado));
                if (g.aiReasoning) {
                    $('#editSintoma_reasoning').text(g.aiReasoning);
                    $('#editSintoma_reasoningBlock').show();
                } else {
                    $('#editSintoma_reasoningBlock').hide();
                }
                $('#editSintoma_validaciones').html(renderValidacionesSint(g.validations));
                $('#editSintoma_glosarioBlock').show();
            });
        }

        function actualizarDiccionarioHijosSintomas(data) {
            hijosSintPorPadre = {};
            data.forEach(item => {
                if (item.idPadre && item.idPadre !== 0) {
                    if (!hijosSintPorPadre[item.idPadre]) {
                        hijosSintPorPadre[item.idPadre] = [];
                    }
                    hijosSintPorPadre[item.idPadre].push(item.id);
                }
            });
        }

        $(function () {
            $.ajaxSetup({
                beforeSend: function(xhr, settings) {
                    if (settings.type === 'POST' || settings.type === 'PUT' || settings.type === 'DELETE') {
                        xhr.setRequestHeader('RequestVerificationToken',
                            $('input[name="__RequestVerificationToken"]').val());
                    }
                }
            });
            sintomasTabla = $('#sintomasGrid').DataTable({
                processing: true,
                serverSide: true,
                scrollX: true,
                scrollCollapse: true,
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'POST',
                    cache: false,
                    data: function (d) {
                        d.mostrarEliminados = $('#switchEliminadosSintomas').is(':checked');
                    },
                    dataSrc: function (json) {
                        console.log('Datos recibidos del servidor:', json);
                        actualizarDiccionarioHijosSintomas(json.data);
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'nombre',
                        orderable: false,
                        render: function (data, type, row) {
                            if (!row.esPadre && row.idPadre) {
                                return `<span class="sint-hijo">- ${data}</span>`;
                            }
                            return `<span class="sint-padre">${data}</span>`;
                        }
                    },
                    {
                        data: 'esPadre',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Padre</span>`
                                : `<span class="badge badge-grid-gray">Hijo</span>`;
                        }
                    },
                    { data: 'idPadre', orderable: false, defaultContent: '' },
                    { data: 'idIdioma', orderable: false },
                    // ⭐ NUEVA COLUMNA: Validado IA
                    {
                        data: 'validadoIA',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<i class="bi bi-check-circle-fill text-success" title="Validado por IA"></i>' 
                                : '<i class="bi bi-dash-circle text-muted" title="No validado por IA"></i>';
                        }
                    },
                    // ⭐ NUEVA COLUMNA: Validado Humano
                    {
                        data: 'validadoHumano',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<i class="bi bi-person-check-fill text-primary" title="Validado por Humano"></i>' 
                                : '<i class="bi bi-dash-circle text-muted" title="No validado por Humano"></i>';
                        }
                    },
                    // ⭐ NUEVA COLUMNA: Relación EII
                    {
                        data: 'relacionEII',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<span class="badge bg-success">Sí</span>' 
                                : '<span class="badge bg-secondary">No</span>';
                        }
                    },
                    // ⭐ NUEVA COLUMNA: Tipo Seguimiento
                    {
                        data: 'tipoSintoma',
                        orderable: false,
                        render: function (data) {
                            const labels = { 0: ['secondary', 'Subjetivo'], 1: ['info', 'Medible GI'] };
                                const [color, label] = labels[data] || labels[0];
                            return `<span class="badge bg-${color}">${label}</span>`;
                        }
                    },
                    {
                        data: 'eliminado',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Sí</span>`
                                : `<span class="badge badge-grid-gray">No</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let editBtn = `<button class='btn btn-sm btn-action-sintoma btn-editar-sintoma' title='Editar' data-id='${row.id}'><i class="bi bi-pencil-square"></i> Editar</button>`;
                            let eliminarBtn = '', restaurarBtn = '';
                            const esPadre = row.esPadre;
                            const tieneHijos = hijosSintPorPadre[row.id] && hijosSintPorPadre[row.id].length > 0;
                            if (row.eliminado) {
                                restaurarBtn = `<button class='btn btn-sm btn-success btn-restaurar-sintoma ms-1' title='Restaurar' data-id='${row.id}'><i class="bi bi-arrow-counterclockwise"></i> Restaurar</button>`;
                            } else {
                                // Solo permitir eliminar si NO es padre o si (es padre Y no tiene hijos)
                                if (!(esPadre && tieneHijos)) {
                                    eliminarBtn = `<button class='btn btn-sm btn-danger btn-borrar-sintoma ms-1' title='Eliminar' data-id='${row.id}'><i class="bi bi-trash"></i> Eliminar</button>`;
                                }
                            }
                            return editBtn + eliminarBtn + restaurarBtn;
                        }
                    }
                ],
                order: [],
                language: {
                    emptyTable: "No hay síntomas registrados."
                }
            });

            $('#switchEliminadosSintomas').change(function () {
                sintomasTabla.ajax.reload();
            });

            $('#sintomasGrid').on('click', '.btn-editar-sintoma', function () {
                const id = $(this).data('id');

                // Cargar datos del síntoma usando la API nueva
                $.get('/api/admin/sintomas/' + id, function (data) {
                    console.log('API response:', data);

                    if (!data || !data.ok) {
                        alert('Error: ' + (data?.error || 'No se pudo obtener el síntoma.'));
                        return;
                    }

                    // Rellenar formulario
                    $('#editSintoma_id').val(data.id);
                    $('#editSintoma_nombre').val(data.nombre || '');
                    $('#editSintoma_idPadre').val(data.idPadre || "");
                    $('#editSintoma_idIdioma').val(data.idIdioma || '');
                    $('#editSintoma_icono').val(data.icono || "");
                    $('#editSintoma_descripcionIA').val(data.descripcionIA || "");
                    $('#editSintoma_validadoHumano').prop('checked', data.validadoHumano || false);

                    // ⭐ MOSTRAR RELACIÓN EII CON EXPLICACIÓN
                    if (data.relacionEII) {
                        $('#editSintoma_relacionEIIContainer').show();
                        $('#editSintoma_noRelacionEIIContainer').hide();
                        $('#editSintoma_relacionEIITexto').text(data.relacionEIIDescripcion || 'Síntoma documentado en pacientes con EII');

                        // ⭐ MOSTRAR FUENTES SOLO SI EXISTEN Y SON REALES
                        if (data.fuentes && data.fuentes.trim() !== '') {
                            $('#editSintoma_fuentes').text(data.fuentes);
                            $('#editSintoma_fuentesContainer').show();
                            $('#editSintoma_noFuentesDisclaimer').hide();
                        } else {
                            $('#editSintoma_fuentesContainer').hide();
                            $('#editSintoma_noFuentesDisclaimer').show();
                        }
                    } else {
                        $('#editSintoma_relacionEIIContainer').hide();
                        $('#editSintoma_noRelacionEIIContainer').show();
                    }

                    $('#editSintoma_activo').prop('checked', !data.eliminado);
                    $('#editSintoma_tipoSintoma').val((data.tipoSintoma ?? 0).toString());
                    $('#msgEditSintomaSuccess').addClass('d-none');

                    // Mostrar panel lateral
                    $('#panelEditarSintoma').addClass('active');
                    cargarGlosarioSintoma(data.id);

                    // ⭐ NUEVO: Recalcular DataTable después de abrir el panel
                    setTimeout(function() {
                        sintomasTabla.columns.adjust().draw(false);
                    }, 350);
                }).fail(function (xhr, status, error) {
                    console.error('API failed:', status, error, xhr.responseText);
                    alert('Error al obtener el síntoma: ' + (xhr.responseJSON?.error || error));
                });
            });

            // ⭐ NUEVO: Cerrar panel lateral
            $('#btnCerrarPanel, #btnCancelar').on('click', function () {
                $('#panelEditarSintoma').removeClass('active');
                $('#msgEditSintomaSuccess').addClass('d-none');

                // ⭐ NUEVO: Recalcular DataTable después de cerrar el panel
                setTimeout(function() {
                    sintomasTabla.columns.adjust().draw(false);
                }, 350);
            });

            // ⭐ NUEVO: Botón Generar IA
            $('#btnGenerarIA').on('click', function () {
                const id = $('#editSintoma_id').val();
                const $btn = $(this);
                const $icon = $btn.find('i');
                const $span = $btn.find('span');

                if (!id) {
                    alert('Error: No hay síntoma seleccionado');
                    return;
                }

                // Deshabilitar botón y mostrar loading
                $btn.prop('disabled', true);
                $icon.removeClass('bi-stars').addClass('d-none');
                $btn.prepend('<span class="loading-spinner"></span>');
                $span.text('Generando...');

                // Llamar a la API
                $.ajax({
                    url: `/api/admin/sintomas/${id}/generate-ia-description`,
                    type: 'POST',
                    contentType: 'application/json',
                    success: function (data) {
                        if (data.ok) {
                            // Llenar el textarea con la descripción generada
                            $('#editSintoma_descripcionIA').val(data.descripcion);

                            // ⭐ ACTUALIZAR RELACIÓN EII CON EXPLICACIÓN
                            if (data.relacionEII) {
                                $('#editSintoma_relacionEIIContainer').show();
                                $('#editSintoma_noRelacionEIIContainer').hide();
                                $('#editSintoma_relacionEIITexto').text(data.relacionEIITexto || 'Síntoma documentado en pacientes con EII');

                                // ⭐ MOSTRAR FUENTES SOLO SI EXISTEN Y SON REALES
                                if (data.fuentes && data.fuentes.trim() !== '') {
                                    $('#editSintoma_fuentes').text(data.fuentes);
                                    $('#editSintoma_fuentesContainer').show();
                                    $('#editSintoma_noFuentesDisclaimer').hide();
                                } else {
                                    $('#editSintoma_fuentesContainer').hide();
                                    $('#editSintoma_noFuentesDisclaimer').show();
                                }
                            } else {
                                $('#editSintoma_relacionEIIContainer').hide();
                                $('#editSintoma_noRelacionEIIContainer').show();
                            }

                            // Mostrar mensaje de éxito
                            alert('✅ Descripción generada exitosamente por IA');

                            // Recargar el grid para mostrar el checkmark de ValidadoIA
                            sintomasTabla.ajax.reload(null, false);
                            const sid = $('#editSintoma_id').val();
                            if (sid) cargarGlosarioSintoma(parseInt(sid));
                        } else {
                            alert('Error: ' + (data.error || 'No se pudo generar la descripción'));
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error generando IA:', error, xhr.responseText);
                        alert('Error al generar descripción: ' + (xhr.responseJSON?.error || error));
                    },
                    complete: function () {
                        // Restaurar botón
                        $btn.prop('disabled', false);
                        $btn.find('.loading-spinner').remove();
                        $icon.removeClass('d-none').addClass('bi-stars');
                        $span.text('Generar con IA');
                    }
                });
            });

            $('#formEditarSintoma').on('submit', function (e) {
                e.preventDefault();
                const id = $('#editSintoma_id').val();

                // Preparar datos para enviar usando la API
                const requestData = {
                    nombre: $('#editSintoma_nombre').val(),
                    idPadre: $('#editSintoma_idPadre').val() ? parseInt($('#editSintoma_idPadre').val()) : null,
                    idIdioma: parseInt($('#editSintoma_idIdioma').val()),
                    icono: $('#editSintoma_icono').val(),
                    eliminado: !$('#editSintoma_activo').is(':checked'),
                    descripcionIA: $('#editSintoma_descripcionIA').val(),
                    validadoHumano: $('#editSintoma_validadoHumano').is(':checked'),
                    tipoSintoma: parseInt($('#editSintoma_tipoSintoma').val() || '0')
                };

                $.ajax({
                    url: `/api/admin/sintomas/${id}`,
                    type: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        console.log('Respuesta del servidor al guardar:', response);
                        if (response.ok) {
                            $('#msgEditSintomaSuccess').removeClass('d-none');

                            console.log('Recargando grid de síntomas...');

                            // ⭐ RECARGAR GRID INMEDIATAMENTE sin resetear paginación
                            sintomasTabla.ajax.reload(function(json) {
                                console.log('Grid recargado. Registros:', json.recordsTotal);
                                console.log('Datos recibidos:', json.data);
                            }, false);

                            setTimeout(function () {
                                $('#panelEditarSintoma').removeClass('active');
                                $('#msgEditSintomaSuccess').addClass('d-none');

                                // ⭐ RECARGA ADICIONAL después de cerrar panel
                                console.log('Recarga adicional del grid...');
                                sintomasTabla.ajax.reload(function() {
                                    console.log('Segunda recarga completada');
                                }, false);

                                // ⭐ FORZAR REDIBUJADO COMPLETO
                                sintomasTabla.columns.adjust().draw(false);
                            }, 1500);
                        } else {
                            alert('Error: ' + (response.error || 'No se pudo guardar.'));
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al guardar:', error, xhr.responseText);
                        alert('Error al guardar: ' + (xhr.responseJSON?.error || error));
                    }
                });
            });

            $('#sintomasGrid').on('click', '.btn-borrar-sintoma', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea eliminar este síntoma? Esta acción no se puede deshacer.')) {
                    $.ajax({
                        url: '@Url.Page(null, "EliminarSintoma")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                sintomasTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo eliminar.'));
                            }
                        }
                    });
                }
            });

            $('#sintomasGrid').on('click', '.btn-restaurar-sintoma', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea restaurar este síntoma?')) {
                    $.ajax({
                        url: '@Url.Page(null, "RestaurarSintoma")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                sintomasTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo restaurar.'));
                            }
                        }
                    });
                }
            });

            // ⭐⭐⭐ ACTUALIZACIÓN MASIVA CON IA ⭐⭐⭐
            let batchSkip = 0;
            let batchRequestedTotal = 10; // total records user wants to process in this run
            let batchRequestedRemaining = 0;
            const batchChunk = 10; // sub-lote de 10
            const delayMsBetweenChunks = 5000; // 5 segundos
            let chunkTimeoutId = null;
            let totalExitosos = 0;
            let totalFallidos = 0;
            let batchEnProgreso = false;
            let batchPaused = false;

            // Abrir modal
            $('#btnActualizacionMasiva').on('click', function() {
                console.log('Abriendo modal de actualización masiva');
                batchSkip = 0;
                totalExitosos = 0;
                totalFallidos = 0;
                batchPaused = false;
                resetearEstadisticas();
                $('#modalActualizacionMasiva').modal('show');
            });

            // Iniciar procesamiento
            $('#btnIniciarBatch').on('click', function() {
                console.log('Click en Iniciar Batch');
                if (!confirm('¿Desea iniciar la actualización masiva? Este proceso puede tardar varios minutos.')) return;

                // Leer selección del combo
                batchRequestedTotal = parseInt($('#selectBatchSize').val() || '10', 10);
                batchRequestedRemaining = batchRequestedTotal;
                batchSkip = 0;
                totalExitosos = 0;
                totalFallidos = 0;
                batchPaused = false;
                $('#btnIniciarBatch').addClass('d-none');
                $('#btnPausarBatch').removeClass('d-none').prop('disabled', false);
                $('#btnContinuarBatch').addClass('d-none');
                procesarBatchChunk();
            });

            // Continuar (cuando estaba pausado o se desea procesar siguientes lotes en DB)
            $('#btnContinuarBatch').on('click', function() {
                console.log('Click en Continuar Batch');
                if (batchRequestedRemaining > 0) {
                    batchPaused = false;
                    $('#btnContinuarBatch').addClass('d-none');
                    $('#btnPausarBatch').removeClass('d-none').prop('disabled', false);
                    procesarBatchChunk();
                } else {
                    batchRequestedRemaining = batchChunk;
                    $('#btnContinuarBatch').addClass('d-none');
                    procesarBatchChunk();
                }
            });

            // Pausar
            $('#btnPausarBatch').on('click', function() {
                console.log('Click en Pausar Batch');
                batchPaused = true;
                if (chunkTimeoutId) {
                    clearTimeout(chunkTimeoutId);
                    chunkTimeoutId = null;
                }
                $('#btnPausarBatch').addClass('d-none');
                $('#btnContinuarBatch').removeClass('d-none').prop('disabled', false);
                agregarLog('info', '⏸️ Proceso en pausa por el usuario');
            });

            // Cerrar modal
            $('#btnCerrar, #btnCerrarModal').on('click', function() {
                console.log('Click en Cerrar modal');
                if (batchEnProgreso) {
                    if (!confirm('Hay un proceso en curso. ¿Desea cancelarlo?')) {
                        return false;
                    }
                }
                batchPaused = true;
                if (chunkTimeoutId) { clearTimeout(chunkTimeoutId); chunkTimeoutId = null; }
                $('#modalActualizacionMasiva').modal('hide');
                sintomasTabla.ajax.reload();
            });

            function resetearEstadisticas() {
                $('#progresoTexto').text('0 / 0 procesados');
                $('#progressBar').css('width', '0%').text('0%');
                $('#exitososCount').text('0');
                $('#fallidosCount').text('0');
                $('#pendientesCount').text('0');
                $('#logResultados').html('<p class="text-muted">Presiona "Iniciar Actualización" para comenzar...</p>');
                $('#btnIniciarBatch').removeClass('d-none');
                $('#btnContinuarBatch').addClass('d-none');
                $('#btnPausarBatch').addClass('d-none');
            }

            function procesarBatchChunk() {
                if (batchPaused) {
                    batchEnProgreso = false;
                    return;
                }

                batchEnProgreso = true;
                $('#btnContinuarBatch').prop('disabled', true).addClass('d-none');
                $('#btnPausarBatch').removeClass('d-none');
                $('#btnCerrar').prop('disabled', true);

                const takeNow = Math.min(batchChunk, batchRequestedRemaining > 0 ? batchRequestedRemaining : batchChunk);
                agregarLog('info', `\uD83D\uDE80 Procesando registros ${batchSkip + 1} a ${batchSkip + takeNow}...`);

                $.ajax({
                    url: '/api/admin/sintomas/batch-generate-ia',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ skip: batchSkip, take: takeNow }),
                    success: function(data) {
                        console.log('Respuesta del servidor:', data);
                        if (data.ok) {
                            const processed = data.procesados || (data.resultados ? data.resultados.length : 0);
                            totalExitosos += data.exitosos || 0;
                            totalFallidos += data.fallidos || 0;

                            $('#exitososCount').text(totalExitosos);
                            $('#fallidosCount').text(totalFallidos);
                            $('#pendientesCount').text(data.pendientes);

                            const totalProcesados = totalExitosos + totalFallidos;
                            // Mostrar progreso: procesados / solicitados
                            if (batchRequestedTotal > 0) {
                                $('#progresoTexto').text(`${totalProcesados} / ${batchRequestedTotal} procesados`);
                                const pct = Math.min(100, Math.round((totalProcesados / batchRequestedTotal) * 100));
                                $('#progressBar').css('width', pct + '%').text(pct + '%');
                            } else {
                                $('#progresoTexto').text(`${totalProcesados} procesados`);
                            }

                            (data.resultados || []).forEach(function(item) {
                                if (item.success) {
                                    const eiiIcon = item.relacionEII ? '🔗' : '○';
                                    agregarLog('success', `✅ ${item.nombre} ${eiiIcon}`);
                                } else {
                                    agregarLog('error', `❌ ${item.nombre} - ${item.error}`);
                                }
                            });

                            batchSkip += processed;

                            if (batchRequestedRemaining > 0) {
                                batchRequestedRemaining -= processed;
                            }

                            if (batchRequestedRemaining > 0) {
                                agregarLog('info', `✋ Sub-lote completado. Quedan ${batchRequestedRemaining} registros de los ${batchRequestedTotal} solicitados.`);
                                // schedule next chunk
                                chunkTimeoutId = setTimeout(function() {
                                    if (!batchPaused) procesarBatchChunk();
                                    chunkTimeoutId = null;
                                }, delayMsBetweenChunks);
                            } else if (data.pendientes > 0) {
                                agregarLog('info', `✋ Lote completado. Quedan ${data.pendientes} registros pendientes.`);
                                $('#btnContinuarBatch').prop('disabled', false).removeClass('d-none');
                                $('#btnPausarBatch').addClass('d-none');
                            } else {
                                agregarLog('success', `🎉 ¡Proceso completado! Total: ${totalExitosos} exitosos, ${totalFallidos} fallidos.`);
                                $('#btnContinuarBatch').addClass('d-none');
                                $('#btnPausarBatch').addClass('d-none');
                                $('#progressBar').removeClass('progress-bar-animated').addClass('bg-success').css('width', '100%').text('100%');
                            }
                        } else {
                            agregarLog('error', `❌ Error: ${data.error}`);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error en batch:', error, xhr.responseText);
                        agregarLog('error', `❌ Error al procesar lote: ${xhr.responseJSON?.error || error}`);
                        $('#btnContinuarBatch').prop('disabled', false).removeClass('d-none');
                        $('#btnPausarBatch').addClass('d-none');
                    },
                    complete: function() {
                        batchEnProgreso = false;
                        $('#btnCerrar').prop('disabled', false);
                    }
                });
            }

            function agregarLog(tipo, mensaje) {
                const timestamp = new Date().toLocaleTimeString();
                let clase = '';
                switch(tipo) {
                    case 'success': clase = 'text-success'; break;
                    case 'error': clase = 'text-danger'; break;
                    case 'info': clase = 'text-primary'; break;
                }

                const logEntry = `<p class="${clase} mb-1"><small>[${timestamp}]</small> ${mensaje}</p>`;
                $('#logResultados').append(logEntry);
                $('#logResultados').scrollTop($('#logResultados')[0].scrollHeight);
            }
        });
    </script>
}