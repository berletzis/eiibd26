@page
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.FirmasExternasModel
@{
    ViewData["Title"] = "Firmas de externos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">🌐 Firmas de externos</h1>
            <p class="text-muted mb-0">
                Motor de Cobertura · Fase 2 — estado de las firmas de artículos externos (las calcula el Worker).
                Solo lectura; no activa el Worker.
            </p>
        </div>
    </div>

    @if (!Model.TablaDisponible)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.Aviso
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">Externos (total)</p>
                        <h3 class="mb-0">@Model.Total</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">Firmados</p>
                        <h3 class="mb-0 text-success">@Model.Firmados</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">Pendientes</p>
                        <h3 class="mb-0 text-warning">@Model.Pendientes</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1 small">Última firma</p>
                        <h6 class="mb-0">@(Model.UltimaFirma?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</h6>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Progreso global</h5>
                    <span class="badge bg-primary">@Model.Firmados / @Model.Total</span>
                </div>
                <div class="progress" style="height: 22px;" role="progressbar" aria-label="Progreso de firmas de externos">
                    <div class="progress-bar bg-success" style="width: @Model.PorcentajeFirmado%;">@Model.PorcentajeFirmado%</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Por idioma</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Idioma</th>
                                <th>Total</th>
                                <th>Firmados</th>
                                <th class="pe-4">Pendientes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4"><span class="badge bg-success">Español</span> <span class="text-muted small">firma activa (2B)</span></td>
                                <td>@Model.EsTotal</td>
                                <td class="text-success fw-bold">@Model.EsFirmados</td>
                                <td class="text-warning">@(Model.EsTotal - Model.EsFirmados)</td>
                            </tr>
                            <tr>
                                <td class="ps-4"><span class="badge bg-secondary">Inglés</span> <span class="text-muted small">pendiente de traducción (2C)</span></td>
                                <td>@Model.EnTotal</td>
                                <td class="text-success fw-bold">@Model.EnFirmados</td>
                                <td class="text-warning">@(Model.EnTotal - Model.EnFirmados)</td>
                            </tr>
                            <tr>
                                <td class="ps-4"><span class="badge bg-light text-dark">Otros</span></td>
                                <td>@Model.OtrosTotal</td>
                                <td class="text-success fw-bold">@Model.OtrosFirmados</td>
                                <td class="text-warning">@(Model.OtrosTotal - Model.OtrosFirmados)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <p class="text-muted small mt-3 mb-0">
            <i class="bi bi-info-circle"></i>
            El detalle en vivo (qué URL se descarga/firma, errores) se ve en el log del Worker, que corre desde terminal.
        </p>
    }
</div>
