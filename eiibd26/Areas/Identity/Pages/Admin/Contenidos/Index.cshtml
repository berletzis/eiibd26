@page
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.IndexModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px;
            padding: 0 10px;
        }

        .crm-title-admin {
            font-size: 2.08rem;
            font-weight: 600;
            color: #14253f;
            margin-bottom: .7em;
        }

        .block-admin-uniform {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #dde6f1;
        }

        .table-centered-admin {
            background: #fff;
            border-radius: 12px;
            padding: 12px;
            border: 1px solid #eef4fa;
        }

        .dt-controls-flex {
            display: flex;
            justify-content: space-between;
            gap: 1.5em;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .btn-action-grid {
            background: #f6f8fd;
            border-radius: 8px;
            padding: 6px 10px;
            border: 0;
        }

        .filter-inline {
            display: inline-flex;
            gap: .5rem;
            align-items: center;
            margin-right: 1rem;
        }

            .filter-inline select {
                min-width: 220px;
            }

        /* map container spacing */
        #usersMapRoot {
            margin-top: 20px;
        }

        /* Small image thumbnail inside grid */
        .grid-thumb {
            width: 80px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e6eef6;
        }

        /* Description cell: allow wrapping and full text */
        .td-desc {
            white-space: normal;
            max-width: 360px;
            overflow: hidden;
            word-break: break-word;
        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Gestión de Contenidos</h2>

    <div class="block-admin-uniform mb-3 d-flex justify-content-between align-items-center">
        <div>
            <div class="mb-2 fs-4">
                <i class="bi bi-journal-text me-2" style="font-size:1.2em;color:#3196fa"></i>Contenidos
            </div>
            <div class="text-muted">Administra artículos y contenidos del sistema.</div>
        </div>
        <div>
            <button id="btnNuevoContenido" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nuevo contenido
            </button>
        </div>
    </div>

    <div class="dt-controls-flex">
        <div id="gridLengthWrapper"></div>
        <div class="dt-controls-right">
            <div class="filter-inline">
                <label for="filterCategoriaPadre" class="form-label mb-0">Categoría padre</label>
                <select id="filterCategoriaPadre" class="form-select form-select-sm">
                    <option value="">(Todas)</option>
                    @foreach (var p in Model.ParentCategories)
                    {
                        <option value="@p.seq">@p.name</option>
                    }
                </select>
            </div>
            <div class="filter-inline">
                <label for="filterSubcategoria" class="form-label mb-0">Subcategoría</label>
                <select id="filterSubcategoria" class="form-select form-select-sm" disabled>
                    <option value="">(Todas)</option>
                </select>
            </div>

            <div class="form-check form-switch d-inline-block align-middle me-3">
                <input class="form-check-input" type="checkbox" id="switchEliminados">
                <label class="form-check-label" for="switchEliminados">Mostrar eliminados</label>
            </div>

            <!-- New switch: show drafts (borradores) -->
            <div class="form-check form-switch d-inline-block align-middle me-3">
                <input class="form-check-input" type="checkbox" id="switchShowDrafts">
                <label class="form-check-label" for="switchShowDrafts">Mostrar borradores</label>
            </div>

            <!-- New switch: show images in grid -->
            <div class="form-check form-switch d-inline-block align-middle me-3">
                <input class="form-check-input" type="checkbox" id="switchShowImages">
                <label class="form-check-label" for="switchShowImages">Mostrar imágenes</label>
            </div>

            <div id="gridSearchWrapper" style="display:inline-block;"></div>
        </div>
    </div>

    <div class="table-centered-admin">
        <table id="contenidosGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:90px">Imagen</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th>Relevante</th>
                    <th>Categoría</th>
                    <th>Autor</th>
                    <th>Publicado</th>
                    <th>Fecha creado</th>
                    <th>Eliminado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- PLACE TO INSERT MAP PARTIAL -->
    <div id="usersMapRoot">Cargando mapa…</div>
    <!-- end map container -->
</div>

<!-- Modal Detalle: agregamos select para cambiar estatus y hidden id -->
<div class="modal fade" id="modalVerDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content crm-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del Contenido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalContentId" />
                <dl class="row">
                    <dt class="col-sm-3">Título</dt>
                    <dd class="col-sm-9" id="view_Titulo"></dd>
                    <dt class="col-sm-3">Slug</dt>
                    <dd class="col-sm-9" id="view_Slug"></dd>
                    <dt class="col-sm-3">Autor</dt>
                    <dd class="col-sm-9" id="view_Autor"></dd>
                    <dt class="col-sm-3">Publicado</dt>
                    <dd class="col-sm-9" id="view_Publicado"></dd>
                    <dt class="col-sm-3">Fecha inicio / fin</dt>
                    <dd class="col-sm-9" id="view_Fechas"></dd>
                    <dt class="col-sm-3">País</dt>
                    <dd class="col-sm-9" id="view_Pais"></dd>
                    <dt class="col-sm-3">Categoría</dt>
                    <dd class="col-sm-9" id="view_Categoria"></dd>
                    <dt class="col-sm-3">Resumen</dt>
                    <dd class="col-sm-9" id="view_TextoC"></dd>
                    <dt class="col-sm-3">Contenido</dt>
                    <dd class="col-sm-9" id="view_TextoL"></dd>
                </dl>

                <div class="mt-3">
                    <label for="modalStatusSelect" class="form-label">Cambiar estatus</label>
                    <div class="d-flex gap-2 align-items-center">
                        <select id="modalStatusSelect" class="form-select" style="max-width:360px;">
                            <option value="0">Borrador</option>
                            <option value="1">Publicado</option>
                            <option value="2">Publicado y Pagina de Inicio</option>
                            <option value="3">Publicado y Popular</option>
                        </select>
                        <button id="btnChangeStatus" class="btn btn-primary">Guardar estatus</button>
                        <div id="statusChangeResult" style="margin-left:12px;"></div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

@{
    var detalleUrl = Url.Page("./Detalle");
    var gridUrl = Url.Page(null, "GridData");
    var getUrl = Url.Page(null, "GetContenido");
    var eliminarUrl = Url.Page(null, "EliminarContenido");
    var restaurarUrl = Url.Page(null, "RestaurarContenido");
    var changeStatusUrl = Url.Page(null, "ChangeStatus");
}
<script>
    const detallePageUrl = '@detalleUrl';
    const gridDataUrl = '@gridUrl';
    const getContenidoUrl = '@getUrl';
    const postEliminarUrl = '@eliminarUrl';
    const postRestaurarUrl = '@restaurarUrl';
    const postChangeStatusUrl = '@changeStatusUrl';
    // Lista completa de categorías para poblar subcategorías dinámicamente
    const categoriasFlat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                Model.CategoriesFlat.Select(c => new { seq = c.seq, parent = c.parent, name = c.name })
                                ));
</script>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            let grid;

            function populateSubcategories(parentId) {
                const subSel = $('#filterSubcategoria');
                subSel.empty().append('<option value="">(Todas)</option>');
                if (!parentId) {
                    subSel.prop('disabled', true);
                    return;
                }
                const subs = categoriasFlat.filter(c => c.parent !== null && Number(c.parent) === Number(parentId));
                if (subs.length === 0) {
                    subSel.prop('disabled', true);
                    return;
                }
                subs.forEach(s => {
                    subSel.append(`<option value="${s.seq}">${s.name}</option>`);
                });
                subSel.prop('disabled', false);
            }

            function initGrid() {
                grid = $('#contenidosGrid').DataTable({
                    processing: true,
                    serverSide: true,
                    dom: 'lfrtip',
                    ajax: {
                        url: gridDataUrl,
                        type: 'GET',
                        cache: false,
                        dataType: 'json',
                        data: function (d) {
                            d.mostrarEliminados = $('#switchEliminados').is(':checked') ? '1' : '0';
                            d.mostrarBorradores = $('#switchShowDrafts').is(':checked') ? '1' : '0';
                            d.showImages = $('#switchShowImages').is(':checked') ? '1' : '0';
                            d.idCategoriaPadre = $('#filterCategoriaPadre').val() || '';
                            d.idSubcategoria = $('#filterSubcategoria').val() || '';
                            d._ts = Date.now();
                        },
                        dataSrc: function (json) {
                            if (!json || !Array.isArray(json.data)) return [];
                            return json.data;
                        },
                        error: function (xhr, status, err) {
                            console.error('DataTable AJAX error', xhr, status, err);
                            alert('Error cargando datos del grid.');
                        }
                    },
                    columns: [
                        // Image column (index 0)
                        {
                            data: 'uRLImagenPrincipal',
                            orderable: false,
                            render: function (data, type, row) {
                                var hasImage = (data && data.length) || row.hasImage;
                                if ($('#switchShowImages').is(':checked')) {
                                    if (hasImage) {
                                        var src = data && data.length ? (data.startsWith('http') ? data : ('/uploads/contenidos/' + data)) : '/img/avatar-placeholder.png';
                                        return '<img src="' + src + '" alt="Imagen" class="grid-thumb" />';
                                    } else {
                                        return '<span class="badge bg-light text-dark">No</span>';
                                    }
                                } else {
                                    return hasImage ? '<span class="badge bg-success">Sí</span>' : '<span class="badge bg-light text-dark">No</span>';
                                }
                            }
                        },
                        // Title (index 1)
                        { data: 'contenidoTitulo', orderable: false },
                        // Description (index 2) — full descripcion
                        {
                            data: 'descripcion',
                            orderable: false,
                            render: function (d) {
                                if (!d) return '';
                                return '<div class="td-desc">' + $('<div>').text(d).html() + '</div>';
                            }
                        },
                        // Tipo (index 3)
                        {
                            data: 'tipo',
                            orderable: false,
                            render: function (d) {
                                return d != null ? String(d) : '';
                            }
                        },
                        // Categoria nombre (index 4)
                        {
                            data: 'categoriaNombre',
                            orderable: false,
                            render: function (d) {
                                return d ? d : '';
                            }
                        },
                        // Author (index 5) => only first word
                        {
                            data: 'autor',
                            orderable: false,
                            render: function (d) {
                                if (!d) return '';
                                var first = (d + '').trim().split(/\s+/)[0];
                                return first;
                            }
                        },
                        // Published (index 6)
                        {
                            data: 'estadoPublicacion',
                            orderable: false,
                            render: function (d) { return d != 0 ? '<span class="badge bg-success">Publicado</span>' : '<span class="badge bg-secondary">Borrador</span>'; }
                        },
                        // Created date (index 7) - only date
                        {
                            data: 'fechaCreado',
                            orderable: true,
                            render: function (d) {
                                if (!d) return '';
                                var dt = new Date(d);
                                try {
                                    return dt.toLocaleDateString();
                                } catch (e) {
                                    return dt.toISOString().slice(0, 10);
                                }
                            }
                        },
                        // Eliminado (index 8)
                        {
                            data: 'eliminado',
                            orderable: false,
                            render: function (d) { return d ? '<span class="badge bg-danger">Sí</span>' : '<span class="badge bg-light text-dark">No</span>'; }
                        },
                        // Actions (index 9)
                        {
                            data: null, orderable: false, render: function (data, type, row) {
                                const id = row.id;
                                const editBtn = '<a href="' + detallePageUrl + '?id=' + id + '" class="btn btn-sm btn-action-grid me-1" title="Editar"><i class="bi bi-pencil-square"></i></a>';
                                const viewBtn = '<button class="btn btn-sm btn-action-grid btn-view me-1" data-id="' + id + '" title="Ver"><i class="bi bi-eye"></i></button>';
                                const delBtn = '<button class="btn btn-sm btn-action-grid btn-delete me-1" data-id="' + id + '" title="Eliminar"><i class="bi bi-trash"></i></button>';
                                const restoreBtn = '<button class="btn btn-sm btn-action-grid btn-restore me-1" data-id="' + id + '" title="Restaurar"><i class="bi bi-arrow-counterclockwise"></i></button>';
                                return row.eliminado ? editBtn + restoreBtn + viewBtn : editBtn + delBtn + viewBtn;
                            }
                        }
                    ],
                    order: [[7, 'desc']], // fechaCreado column index
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    initComplete: function () {
                        if ($('#contenidosGrid_length').length) {
                            $("#gridLengthWrapper").empty().append($('#contenidosGrid_length').children());
                        }
                        if ($('#contenidosGrid_filter').length) {
                            $("#gridSearchWrapper").empty().append($('#contenidosGrid_filter').children());
                        }
                    }
                });
            }

            $('#btnNuevoContenido').on('click', () => window.location.href = detallePageUrl);

            // View button: load dto and populate modal, including setting modalContentId and status select
            $('#contenidosGrid').on('click', '.btn-view', function () {
                const id = $(this).data('id');
                if (!id) return;
                const url = new URL(getContenidoUrl, window.location.origin);
                url.searchParams.set('id', id);
                $.getJSON(url.toString())
                    .done(dto => {
                        $('#modalContentId').val(dto.id);
                        $('#view_Titulo').text(dto.contenidoTitulo || '');
                        $('#view_Slug').text(dto.contenidoTituloSlug || '');
                        $('#view_Autor').text(dto.autor || '');
                        $('#view_Publicado').html(dto.estadoPublicacion != 0 ? '<span class="badge bg-success">Publicado</span>' : '<span class="badge bg-secondary">Borrador</span>');
                        let fechas = '';
                        if (dto.contenidoFechaInicio) fechas += new Date(dto.contenidoFechaInicio).toLocaleString();
                        fechas += ' — ';
                        if (dto.contenidoFechaFin) fechas += new Date(dto.contenidoFechaFin).toLocaleString();
                        $('#view_Fechas').text(fechas);
                        $('#view_Pais').text(dto.paisClave || '');
                        $('#view_Categoria').text(dto.categoriaNombre || '');
                        $('#view_TextoC').text(dto.contenidoTextoC || '');
                        $('#view_TextoL').html(dto.contenidoTextoL || '');
                        // set status select
                        $('#modalStatusSelect').val(dto.estadoPublicacion ?? 0);
                        // clear result message
                        $('#statusChangeResult').html('');
                        // show modal
                        new bootstrap.Modal(document.getElementById('modalVerDetalle')).show();
                    })
                    .fail(xhr => {
                        console.error('Error obteniendo contenido', xhr);
                        alert('Error obteniendo detalle.');
                    });
            });

            // Change status button in modal
            $('#btnChangeStatus').on('click', function (e) {
                e.preventDefault();
                const id = $('#modalContentId').val();
                const status = $('#modalStatusSelect').val();
                if (!id) return alert('ID inválido');
                // get anti-forgery token if present
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                const headers = tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {};
                // Use fetch to POST form data
                const fd = new FormData();
                fd.append('id', id);
                fd.append('status', status);
                fetch(postChangeStatusUrl, {
                    method: 'POST',
                    body: fd,
                    headers: headers
                }).then(r => r.json())
                    .then(j => {
                        if (j && j.success) {
                            $('#statusChangeResult').html('<span class="text-success">Estatus actualizado</span>');
                            // update modal badge and select (already selected)
                            $('#view_Publicado').html(status != 0 ? '<span class="badge bg-success">Publicado</span>' : '<span class="badge bg-secondary">Borrador</span>');
                            // refresh grid row(s) without full page reload
                            if (grid) grid.ajax.reload(null, false);
                        } else {
                            $('#statusChangeResult').html('<span class="text-danger">Error: ' + (j.message || 'no se pudo actualizar') + '</span>');
                        }
                    })
                    .catch(err => {
                        console.error('Error change status', err);
                        $('#statusChangeResult').html('<span class="text-danger">Error de red</span>');
                    });
            });

            $(document).on('click', '.btn-delete', function () {
                const id = $(this).data('id');
                if (!id) return;
                if (!confirm('¿Eliminar contenido?')) return;
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                const headers = tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {};
                $.post({
                    url: postEliminarUrl,
                    data: { id },
                    headers
                }).done(res => {
                    if (res && res.success) grid.ajax.reload(null, false);
                    else alert('No se pudo eliminar: ' + (res.message || 'error'));
                }).fail(xhr => {
                    console.error('Error eliminando', xhr); alert('Error eliminando.');
                });
            });

            $(document).on('click', '.btn-restore', function () {
                const id = $(this).data('id');
                if (!id) return;
                if (!confirm('¿Restaurar contenido?')) return;
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                const headers = tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {};
                $.post({
                    url: postRestaurarUrl,
                    data: { id },
                    headers
                }).done(res => {
                    if (res && res.success) grid.ajax.reload(null, false);
                    else alert('No se pudo restaurar: ' + (res.message || 'error'));
                }).fail(xhr => {
                    console.error('Error restaurando', xhr); alert('Error restaurando.');
                });
            });

            $('#switchEliminados').change(() => { if (grid) grid.ajax.reload(null, false); });
            $('#switchShowDrafts').change(() => { if (grid) grid.ajax.reload(null, false); });
            $('#switchShowImages').change(() => { if (grid) grid.ajax.reload(null, false); });

            $('#filterCategoriaPadre').change(function () {
                const val = $(this).val();
                populateSubcategories(val);
                $('#filterSubcategoria').val('');
                if (grid) grid.ajax.reload(null, false);
            });

            $('#filterSubcategoria').change(function () {
                if (grid) grid.ajax.reload(null, false);
            });

            $(function () {
                initGrid();
            });
        })();
    </script>

    <!-- FETCH & INSERT partial de mapa (UsersMapPartial). Asegúrate Pages/Home/UsersMapPartial.cshtml tiene Layout = null -->
    <script>
        (function () {
            const usersMapUrl = '@Url.Page("/Home/UsersMapPartial")';
            const root = document.getElementById('usersMapRoot');
            if (!root) return;

            fetch(usersMapUrl, { credentials: 'same-origin' })
                .then(r => {
                    if (!r.ok) throw new Error('Network response was not ok: ' + r.status);
                    return r.text();
                })
                .then(html => {
                    root.innerHTML = html;
                    const scripts = root.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const s = document.createElement('script');
                        if (oldScript.src) {
                            s.src = oldScript.src;
                            s.defer = oldScript.defer || false;
                            document.body.appendChild(s);
                        } else {
                            s.text = oldScript.textContent;
                            document.body.appendChild(s);
                            document.body.removeChild(s);
                        }
                    });
                })
                .catch(err => {
                    console.error('Error cargando UsersMapPartial:', err);
                    if (root) root.textContent = 'Error al cargar el mapa.';
                });
        })();
    </script>
}