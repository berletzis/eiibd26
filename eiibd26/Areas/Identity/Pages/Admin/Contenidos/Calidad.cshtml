@page
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.CalidadModel
@using eiibd26.Services.Calidad

@{
    ViewData["Title"] = "Calidad de Contenido";

    bool tieneGuardados = Model.ResultadosGuardados != null;
    int totalCriticos   = Model.ResultadosGuardados?.Count(r => r.NivelSemaforo == NivelSemaforo.Critico) ?? 0;
    int totalMejorables = Model.ResultadosGuardados?.Count(r => r.NivelSemaforo == NivelSemaforo.Mejorable) ?? 0;
    int totalOk         = Model.ResultadosGuardados?.Count(r => r.NivelSemaforo == NivelSemaforo.Ok) ?? 0;
    int totalGuardados  = Model.ResultadosGuardados?.Count ?? 0;
}

@section Styles {
    <style>
        body { background: #f5f7fb; }

        .block-admin-uniform {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(40,60,120,0.08);
            padding: 30px 32px 18px 32px;
            margin: 0 0 24px 0;
            border: 1px solid #dde6f1;
        }

        .semaforo-critico   { color: #dc3545; font-size: 1.3rem; }
        .semaforo-mejorable { color: #ffc107; font-size: 1.3rem; }
        .semaforo-ok        { color: #198754; font-size: 1.3rem; }

        .counter-card {
            border-radius: 12px;
            padding: 18px 28px;
            text-align: center;
            min-width: 140px;
        }
        .counter-card.critico    { background: #fff5f5; border: 2px solid #f5c2c7; }
        .counter-card.mejorable  { background: #fffbf0; border: 2px solid #ffd966; }
        .counter-card.ok         { background: #f0fff4; border: 2px solid #a8d5b5; }
        .counter-card.total-card { background: #f8f9fa; border: 2px solid #dee2e6; }
        .counter-card .numero    { font-size: 2.2rem; font-weight: 700; line-height: 1; }
        .counter-card .etiqueta  { font-size: 0.85rem; color: #6b7280; margin-top: 4px; }

        .senal-badge {
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 20px;
            margin: 2px;
            display: inline-block;
            font-weight: 600;
        }
        .senal-critica   { background: #fde8e8; color: #b91c1c; border: 1px solid #fca5a5; }
        .senal-mejorable { background: #fef9c3; color: #92400e; border: 1px solid #fde68a; }

        .tabla-calidad td { vertical-align: middle; }
        .titulo-contenido  { font-weight: 500; font-size: 0.92rem; }
        .dup-link          { font-size: 0.78rem; color: #6c757d; }
        .ultimo-analisis   { font-size: 0.82rem; color: #6b7280; }

        .gris-score { font-size: 1.1rem; font-weight: 700; }
        .btn-gris   { font-size: 0.75rem; padding: 2px 8px; }
        .aspecto-bar { height: 5px; border-radius: 3px; }
        .aspecto-row { margin-bottom: 10px; }
        .aspecto-row .label { font-size: 0.8rem; font-weight: 600; }
        .aspecto-row .obs   { font-size: 0.77rem; color: #6b7280; margin-top: 2px; }
    </style>
}

<div class="container-fluid px-4 py-4">

    <!-- Encabezado -->
    <div class="block-admin-uniform d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="bi bi-bar-chart-line me-2 text-primary"></i>Calidad de Contenido
            </h4>
            <div class="text-muted mb-2">
                Analiza duplicados y señales de calidad — procesa en batches de 10 para no congelar la página.
            </div>
            <a asp-page="./Contenidos" class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Volver a Contenidos
            </a>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
            <!-- Token antiforgery para los fetch de batch -->
            <form id="formToken" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
            <button id="btnAnalizar" onclick="iniciarAnalisis()" class="btn btn-primary">
                @if (tieneGuardados)
                {
                    <i class="bi bi-arrow-repeat me-1"></i><text>Re-analizar</text>
                }
                else
                {
                    <i class="bi bi-search me-1"></i><text>Analizar contenido</text>
                }
            </button>
            @if (tieneGuardados && Model.UltimoAnalisis.HasValue)
            {
                <span class="ultimo-analisis">
                    <i class="bi bi-clock me-1"></i>Último análisis: @Model.UltimoAnalisis.Value.ToString("dd MMM yyyy, HH:mm") UTC
                </span>
            }
        </div>
    </div>

    <!-- Estado inicial — solo si no hay guardados -->
    <div id="estadoInicial" class="block-admin-uniform text-center py-5" @(tieneGuardados ? "style=display:none;" : "")>
        <i class="bi bi-bar-chart-line" style="font-size:3rem;color:#adb5bd;"></i>
        <div class="mt-3 text-muted">
            Haz clic en <strong>Analizar contenido</strong> para iniciar el diagnóstico por batches.
        </div>
    </div>

    <!-- Barra de progreso (oculta al inicio) -->
    <div id="barraProgresoContainer" class="block-admin-uniform py-3" style="display:none;">
        <div class="d-flex justify-content-between mb-2">
            <span id="textoProgreso" class="text-muted small fw-semibold"></span>
            <span id="pctProgreso" class="text-muted small">0%</span>
        </div>
        <div class="progress" style="height:10px; border-radius:8px;">
            <div id="barraInterna"
                 class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                 role="progressbar"
                 style="width:0%; border-radius:8px;"
                 aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
        <div id="alertaBatchFallido" class="alert alert-warning mt-2 py-2 small" style="display:none;">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <span id="mensajeBatchFallido"></span>
        </div>
    </div>

    <!-- Resumen contadores -->
    <div id="resumenContadores" @(tieneGuardados ? "" : "style=display:none;")>
        <div class="d-flex gap-3 flex-wrap mb-4">
            <div class="counter-card critico">
                <div class="numero semaforo-critico" id="numCriticos">🔴 @totalCriticos</div>
                <div class="etiqueta">Críticos</div>
            </div>
            <div class="counter-card mejorable">
                <div class="numero semaforo-mejorable" id="numMejorables">🟡 @totalMejorables</div>
                <div class="etiqueta">Mejorables</div>
            </div>
            <div class="counter-card ok">
                <div class="numero semaforo-ok" id="numOk">🟢 @totalOk</div>
                <div class="etiqueta">OK</div>
            </div>
            <div class="counter-card total-card">
                <div class="numero" id="numTotal">@totalGuardados</div>
                <div class="etiqueta">Total analizados</div>
            </div>
        </div>

        <!-- Filtro rápido -->
        <div class="mb-3 d-flex gap-2 flex-wrap align-items-center">
            <span class="text-muted small fw-semibold me-1">Filtrar:</span>
            <button class="btn btn-sm btn-outline-secondary btn-filtro active" data-nivel="todos">Todos</button>
            <button class="btn btn-sm btn-outline-danger btn-filtro" data-nivel="Critico">🔴 Críticos</button>
            <button class="btn btn-sm btn-outline-warning btn-filtro" data-nivel="Mejorable">🟡 Mejorables</button>
            <button class="btn btn-sm btn-outline-success btn-filtro" data-nivel="Ok">🟢 OK</button>
        </div>
    </div>

    <!-- Tabla de resultados -->
    <div id="tablaContainer" @(tieneGuardados ? "" : "style=display:none;") class="block-admin-uniform p-0 overflow-hidden">
        <table class="table table-hover mb-0 tabla-calidad" id="tablaCalidad">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;" class="text-center">Estado</th>
                    <th>Título</th>
                    <th style="width:80px;" class="text-center">Pub.</th>
                    <th>Señales detectadas</th>
                    <th style="width:90px;" class="text-center" title="GRIS: evaluación editorial con IA">
                        <i class="bi bi-stars text-primary me-1"></i>GRIS
                    </th>
                    <th style="width:70px;" class="text-center">Editar</th>
                </tr>
            </thead>
            <tbody id="tablaCalidadBody">
                @if (Model.ResultadosGuardados != null)
                {
                    foreach (var item in Model.ResultadosGuardados)
                    {
                        var nivelStr = item.NivelSemaforo.ToString();
                        var nivelClass = item.NivelSemaforo switch
                        {
                            NivelSemaforo.Critico   => "critico",
                            NivelSemaforo.Mejorable => "mejorable",
                            _                       => "ok"
                        };
                        var emoji = item.NivelSemaforo switch
                        {
                            NivelSemaforo.Critico   => "🔴",
                            NivelSemaforo.Mejorable => "🟡",
                            _                       => "🟢"
                        };
                        <tr data-nivel="@nivelStr">
                            <td class="text-center semaforo-@nivelClass" title="@nivelStr">@emoji</td>
                            <td>
                                <div class="titulo-contenido">@item.Titulo</div>
                                @if (!string.IsNullOrWhiteSpace(item.Slug))
                                {
                                    <div class="text-muted" style="font-size:0.75rem;">/@item.Slug</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.EstadoPublicacion == 0)
                                {
                                    <span class="badge bg-secondary">Borrador</span>
                                }
                                else if (item.EstadoPublicacion == 1)
                                {
                                    <span class="badge bg-success">Publicado</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">@(item.EstadoPublicacion?.ToString() ?? "-")</span>
                                }
                            </td>
                            <td>
                                @foreach (var senal in item.Senales)
                                {
                                    var badgeClass = senal.Gravedad == GravedadSenal.Critica ? "senal-critica" : "senal-mejorable";
                                    <span class="senal-badge @badgeClass" title="@senal.Descripcion">@senal.Codigo</span>
                                }
                                @if (item.DuplicadoDeIds.Any())
                                {
                                    <div class="dup-link mt-1">
                                        Similares:
                                        @foreach (var dupId in item.DuplicadoDeIds)
                                        {
                                            <a href="./Detalle?id=@dupId" target="_blank" class="me-1">#@dupId</a>
                                        }
                                    </div>
                                }
                                @if (!item.Senales.Any())
                                {
                                    <span class="text-muted small">Sin problemas detectados</span>
                                }
                            </td>
                            @{
                                var grisScore = item.GrisPuntajeGlobal;
                                var grisBgClass = grisScore >= 70 ? "success"
                                    : grisScore >= 50 ? "warning"
                                    : "danger";
                            }
                            <td class="text-center">
                                @if (item.GrisEvaluado && grisScore.HasValue)
                                {
                                    <span class="badge bg-@grisBgClass gris-score mb-1">@grisScore</span><br/>
                                    <button class="btn btn-link btn-gris p-0 text-muted"
                                            onclick="evaluarConGris(@item.Id, '@Html.Raw(item.Titulo.Replace("'", "\\'").Replace("\"", "&quot;"))')"
                                            title="Re-evaluar con GRIS">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary btn-gris"
                                            onclick="evaluarConGris(@item.Id, '@Html.Raw(item.Titulo.Replace("'", "\\'").Replace("\"", "&quot;"))')"
                                            title="Evaluar con GRIS">
                                        <i class="bi bi-stars"></i>
                                    </button>
                                }
                            </td>
                            <td class="text-center">
                                <a href="./Detalle?id=@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

<partial name="_GrisModal" />

@section Scripts {
<script>
    const TAKE = 10;
    let allItems = [];
    let filtroActivo = 'todos';

    function getToken() {
        return document.querySelector('#formToken [name="__RequestVerificationToken"]').value;
    }

    async function fetchBatch(skip) {
        const fd = new FormData();
        fd.append('__RequestVerificationToken', getToken());
        fd.append('skip', skip);
        fd.append('take', TAKE);
        const res = await fetch('?handler=AnalizarBatch', { method: 'POST', body: fd });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return await res.json();
    }

    async function iniciarAnalisis() {
        const btn = document.getElementById('btnAnalizar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Analizando...';

        // Reset estado
        allItems = [];
        document.getElementById('estadoInicial').style.display = 'none';
        document.getElementById('resumenContadores').style.display = 'none';
        document.getElementById('tablaContainer').style.display = 'none';
        document.getElementById('tablaCalidadBody').innerHTML = '';
        document.getElementById('alertaBatchFallido').style.display = 'none';
        document.getElementById('barraInterna').className = 'progress-bar progress-bar-striped progress-bar-animated bg-primary';
        document.getElementById('barraProgresoContainer').style.display = 'block';
        actualizarBarra(0, 1, 'Iniciando análisis...');

        // Reset filtro
        filtroActivo = 'todos';
        document.querySelectorAll('.btn-filtro').forEach(function(b) {
            b.classList.toggle('active', b.dataset.nivel === 'todos');
        });

        try {
            const primerBatch = await fetchBatch(0);
            const total = primerBatch.total;

            if (total === 0) {
                actualizarBarra(1, 1, 'Sin contenidos para analizar.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Analizar contenido';
                return;
            }

            appendItems(primerBatch.items);
            actualizarBarra(Math.min(TAKE, total), total,
                'Analizando ' + Math.min(TAKE, total) + ' de ' + total + '...');

            for (let i = TAKE; i < total; i += TAKE) {
                let batch;
                try {
                    batch = await fetchBatch(i);
                } catch {
                    try { batch = await fetchBatch(i); } catch (e2) {
                        document.getElementById('mensajeBatchFallido').textContent =
                            'El batch ' + (i + 1) + '-' + Math.min(i + TAKE, total) + ' falló dos veces y se omitió.';
                        document.getElementById('alertaBatchFallido').style.display = 'block';
                        continue;
                    }
                }
                appendItems(batch.items);
                const analizados = Math.min(i + TAKE, total);
                actualizarBarra(analizados, total, 'Analizando ' + analizados + ' de ' + total + '...');
            }

            actualizarBarra(total, total, 'Análisis completo — ' + total + ' contenidos revisados.');
            mostrarResumen(total);

        } catch (e) {
            actualizarBarra(0, 1, 'Error al iniciar: ' + e.message);
            document.getElementById('barraInterna').className = 'progress-bar bg-danger';
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Re-analizar';
    }

    function actualizarBarra(hecho, total, texto) {
        const pct = total > 0 ? Math.round((hecho / total) * 100) : 0;
        document.getElementById('textoProgreso').textContent = texto;
        document.getElementById('pctProgreso').textContent = pct + '%';
        const barra = document.getElementById('barraInterna');
        barra.style.width = pct + '%';
        barra.setAttribute('aria-valuenow', pct);
        if (pct >= 100) barra.classList.remove('progress-bar-animated');
    }

    function appendItems(items) {
        allItems = allItems.concat(items);
        const tbody = document.getElementById('tablaCalidadBody');
        document.getElementById('tablaContainer').style.display = 'block';
        items.forEach(function(item) {
            const tr = crearFila(item);
            if (filtroActivo !== 'todos' && item.nivelSemaforo !== filtroActivo) {
                tr.style.display = 'none';
            }
            tbody.appendChild(tr);
        });
    }

    function crearFila(item) {
        const nivel = item.nivelSemaforo;
        const emoji = { Critico: '🔴', Mejorable: '🟡', Ok: '🟢' }[nivel] || '❓';
        const nivelClass = { Critico: 'critico', Mejorable: 'mejorable', Ok: 'ok' }[nivel] || '';

        const senalesBadges = item.senales.map(function(s) {
            const cls = s.gravedad === 'Critica' ? 'senal-critica' : 'senal-mejorable';
            return '<span class="senal-badge ' + cls + '" title="' + esc(s.descripcion) + '">' + esc(s.codigo) + '</span>';
        }).join('');

        const dupLinks = item.duplicadoDeIds.length > 0
            ? '<div class="dup-link mt-1">Similares: ' +
              item.duplicadoDeIds.map(function(id) {
                  return '<a href="./Detalle?id=' + id + '" target="_blank" class="me-1">#' + id + '</a>';
              }).join('') + '</div>'
            : '';

        const pubBadge = item.estadoPublicacion === 0
            ? '<span class="badge bg-secondary">Borrador</span>'
            : item.estadoPublicacion === 1
                ? '<span class="badge bg-success">Publicado</span>'
                : '<span class="badge bg-light text-muted">' + (item.estadoPublicacion != null ? item.estadoPublicacion : '-') + '</span>';

        const sinSenales = item.senales.length === 0
            ? '<span class="text-muted small">Sin problemas detectados</span>'
            : '';

        const tr = document.createElement('tr');
        tr.dataset.nivel = nivel;
        tr.innerHTML =
            '<td class="text-center semaforo-' + nivelClass + '" title="' + nivel + '">' + emoji + '</td>' +
            '<td>' +
                '<div class="titulo-contenido">' + esc(item.titulo) + '</div>' +
                (item.slug ? '<div class="text-muted" style="font-size:0.75rem;">/' + esc(item.slug) + '</div>' : '') +
            '</td>' +
            '<td class="text-center">' + pubBadge + '</td>' +
            '<td>' + senalesBadges + dupLinks + sinSenales + '</td>' +
            '<td class="text-center">' +
                '<button class="btn btn-sm btn-outline-secondary btn-gris" ' +
                    'onclick="evaluarConGris(' + item.id + ',\'' + esc(item.titulo).replace(/'/g, "\\'") + '\')" ' +
                    'title="Evaluar con GRIS">' +
                    '<i class="bi bi-stars"></i>' +
                '</button>' +
            '</td>' +
            '<td class="text-center">' +
                '<a href="./Detalle?id=' + item.id + '" class="btn btn-sm btn-outline-primary" title="Editar">' +
                    '<i class="bi bi-pencil-square"></i>' +
                '</a>' +
            '</td>';
        return tr;
    }

    // ── GRIS ─────────────────────────────────────────────────────────────
    let grisModal = null;

    async function evaluarConGris(id, titulo) {
        if (!grisModal) grisModal = new bootstrap.Modal(document.getElementById('modalGris'));
        document.getElementById('modalGrisLabel').textContent = '⭐ GRIS — ' + (titulo || 'Evaluación Editorial');
        document.getElementById('modalGrisBody').innerHTML =
            '<div class="text-center py-5">' +
            '<div class="spinner-border text-primary" role="status"></div>' +
            '<div class="mt-3 text-muted">GRIS está evaluando el artículo...</div>' +
            '</div>';
        grisModal.show();

        try {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', getToken());
            fd.append('id', id);
            const res = await fetch('?handler=EvaluarGris', { method: 'POST', body: fd });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            renderGrisModal(data, id, titulo);
        } catch (e) {
            document.getElementById('modalGrisBody').innerHTML =
                '<div class="alert alert-danger">' +
                '<i class="bi bi-exclamation-triangle me-2"></i>Error: ' + esc(e.message) +
                '</div>';
        }
    }

    function renderGrisModal(data, id, titulo) {
        if (!data.ok) {
            document.getElementById('modalGrisBody').innerHTML =
                '<div class="alert alert-warning">' +
                '<i class="bi bi-exclamation-triangle me-2"></i>' + esc(data.error || 'Error desconocido') +
                '</div>' +
                '<button class="btn btn-sm btn-outline-secondary mt-1" onclick="evaluarConGris(' + id + ',\'' + esc(titulo) + '\')">' +
                '<i class="bi bi-arrow-repeat me-1"></i>Reintentar</button>';
            return;
        }

        const p = data.puntajeGlobal;
        const colorClass = p >= 70 ? 'success' : p >= 50 ? 'warning' : 'danger';
        const colorHex   = p >= 70 ? '#198754' : p >= 50 ? '#856404' : '#842029';

        let html = '<div class="text-center mb-3">' +
            '<div style="font-size:3.5rem;font-weight:700;color:' + colorHex + ';">' + p + '</div>' +
            '<div class="text-muted small">Puntaje global (0-100)</div>';
        if (data.fechaEvaluacion) {
            html += '<div class="text-muted" style="font-size:0.76rem;">' +
                new Date(data.fechaEvaluacion).toLocaleString('es-AR') + ' UTC</div>';
        }
        html += '</div><hr class="my-2"/>' +
            '<h6 class="fw-bold mb-3"><i class="bi bi-list-check me-1"></i>7 Aspectos Editoriales</h6>';

        (data.aspectos || []).forEach(function(a) {
            const barColor = a.puntaje >= 7 ? 'success' : a.puntaje >= 5 ? 'warning' : 'danger';
            html += '<div class="aspecto-row">' +
                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                '<span class="label">' + esc(a.nombre) + '</span>' +
                '<span class="badge bg-' + barColor + '">' + a.puntaje + '/10</span>' +
                '</div>' +
                '<div class="progress aspecto-bar mb-1"><div class="progress-bar bg-' + barColor +
                '" style="width:' + (a.puntaje * 10) + '%;"></div></div>' +
                '<div class="obs">' + esc(a.observacion) + '</div>' +
                '</div>';
        });

        const sugs = data.sugerencias || [];
        if (sugs.length > 0) {
            html += '<hr class="my-2"/><h6 class="fw-bold mb-2"><i class="bi bi-lightbulb me-1 text-warning"></i>Sugerencias de mejora</h6><ul class="mb-0 ps-3">';
            sugs.forEach(function(s) { html += '<li class="mb-1 small">' + esc(s) + '</li>'; });
            html += '</ul>';
        }

        html += renderGrisCategorias(data, esc);

        html += '<div class="mt-3 text-end">' +
            '<button class="btn btn-sm btn-outline-secondary" onclick="evaluarConGris(' + id + ',\'' + esc(titulo).replace(/'/g, "\\'") + '\')">' +
            '<i class="bi bi-arrow-repeat me-1"></i>Re-evaluar</button></div>';

        document.getElementById('modalGrisBody').innerHTML = html;
    }

    function renderGrisCategorias(data, escFn) {
        const alts = data.categoriasAlerta || [];
        const sugs = data.categoriasSugeridas || [];
        if (alts.length === 0 && sugs.length === 0) return '';

        let html = '<hr class="my-2"/><h6 class="fw-bold mb-2"><i class="bi bi-tag me-1 text-primary"></i>Categorías</h6>';

        if (alts.length > 0) {
            html += '<div class="small fw-semibold text-danger mb-1">⚠ Posible mala clasificación</div>';
            alts.forEach(function(c) {
                html += '<div class="mb-2">' +
                    '<span class="badge bg-danger-subtle text-danger-emphasis me-1" style="white-space:normal">' + escFn(c.nombre) + '</span>' +
                    '<span class="text-muted small">' + escFn(c.razon) + '</span></div>';
            });
        } else {
            html += '<div class="small text-success mb-2">✓ Categorías coherentes con el contenido</div>';
        }

        if (sugs.length > 0) {
            html += '<div class="small text-muted fw-semibold mb-1">Sugeridas:</div>' +
                '<div class="d-flex flex-wrap gap-1 mb-1">';
            sugs.forEach(function(c) {
                html += '<span class="badge bg-primary-subtle text-primary-emphasis" title="' + escFn(c.razon) + '">' + escFn(c.nombre) + '</span>';
            });
            html += '</div>';
        }

        return html;
    }

    function mostrarResumen(total) {
        const criticos   = allItems.filter(function(i) { return i.nivelSemaforo === 'Critico'; }).length;
        const mejorables = allItems.filter(function(i) { return i.nivelSemaforo === 'Mejorable'; }).length;
        const ok         = allItems.filter(function(i) { return i.nivelSemaforo === 'Ok'; }).length;
        document.getElementById('numCriticos').textContent   = '🔴 ' + criticos;
        document.getElementById('numMejorables').textContent = '🟡 ' + mejorables;
        document.getElementById('numOk').textContent         = '🟢 ' + ok;
        document.getElementById('numTotal').textContent      = total;
        document.getElementById('resumenContadores').style.display = 'block';
    }

    function esc(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Filtro por nivel
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.btn-filtro');
        if (!btn) return;
        document.querySelectorAll('.btn-filtro').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        filtroActivo = btn.dataset.nivel;
        document.querySelectorAll('#tablaCalidadBody tr').forEach(function(tr) {
            tr.style.display = (filtroActivo === 'todos' || tr.dataset.nivel === filtroActivo) ? '' : 'none';
        });
    });
</script>
}
