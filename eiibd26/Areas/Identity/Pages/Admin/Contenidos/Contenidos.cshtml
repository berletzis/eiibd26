@page
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.ContenidosModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }

        .crm-title-admin {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #14253f;
            margin-bottom: .7em;
        }

        .block-admin-uniform {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(40,60,120,0.08);
            padding: 30px 32px 18px 32px;
            margin: 0 0 36px 0;
            border: 1px solid #dde6f1;
            max-width: 100%;
        }

        .table-centered-admin {
            max-width: 1320px;
            margin: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            border: none;
            padding: 20px 22px 9px 22px;
        }

        .dt-controls-flex {
            max-width: 1320px;
            margin: 0 auto 8px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .dt-controls-left {
            display: flex;
            align-items: center;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .dt-controls-right {
            display: flex;
            align-items: center;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .form-switch,
        #gridLengthWrapper,
        #gridSearchWrapper {
            margin-bottom: 0 !important;
        }

            #gridLengthWrapper label {
                margin-right: .5em;
            }

        .dataTables_length {
            display: inline-flex !important;
            align-items: center !important;
            vertical-align: middle !important;
            gap: 11px;
            margin-bottom: 0 !important;
            white-space: nowrap;
        }

            .dataTables_length label {
                display: flex !important;
                align-items: center !important;
                gap: 0.25em;
                margin-bottom: 0 !important;
                white-space: nowrap;
            }

                .dataTables_length label > select {
                    margin: 0 4px;
                    min-width: 52px;
                }

                .dataTables_length label > span,
                .dataTables_length label > select,
                .dataTables_length label > input {
                    display: inline-block !important;
                    vertical-align: middle !important;
                }

            .dataTables_length label {
                white-space: nowrap;
            }

                .dataTables_length label select,
                .dataTables_length label {
                    margin-bottom: 0 !important;
                }

        .dataTables_filter,
        .form-check.form-switch {
            display: inline-flex !important;
            align-items: center !important;
            vertical-align: middle !important;
            margin-bottom: 0 !important;
        }

            .dataTables_filter input {
                width: 200px;
                border-radius: 7px;
                border: 1px solid #dbe3f2;
                padding: 0.38em 1em;
                background: #f8fafd;
                margin-left: 0.4em;
            }

        /* Category cell text truncation */
        .categoria-text {
            display: inline-block;
            max-width: 240px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

        #contenidosGrid {
            width: 100% !important;
            margin: 0;
        }

            #contenidosGrid th, #contenidosGrid td {
                border: none !important;
            }

            #contenidosGrid th {
                background: #eef4fa !important;
                color: #3d436c !important;
                font-weight: 600 !important;
                border-bottom: 2.7px solid #ddeaf7 !important;
                font-size: 1.07em;
            }

            #contenidosGrid tbody tr {
                border-bottom: 1.2px solid #e7ebf4 !important;
                box-shadow: 0 1px 18px #e6edfa0c;
            }

            #contenidosGrid tbody td {
                background: #fff !important;
                border-top: none !important;
                border-bottom: 1.1px solid #f2f7fd !important;
                font-size: 1.03em;
                padding-top: 13px !important;
                padding-bottom: 13px !important;
            }

            #contenidosGrid tbody tr:nth-child(even) td {
                background: #f9fbfc !important;
            }

        .btn-action-grid {
            background: #f6f8fd !important;
            color: #222 !important;
            border: 0px solid #dee2e6 !important;
            font-weight: 500;
            margin-right: 0.16em;
            transition: box-shadow .08s;
            border-radius: 9px !important;
            box-shadow: 0 1px 6px #dae4f377;
            padding: 6px 15px !important;
        }

            .btn-action-grid i {
                font-size: 1.09em;
                vertical-align: middle;
            }

        .btn-action-edit i {
            color: #ffbe17 !important;
        }

        .btn-action-delete i {
            color: #c92a2a !important;
        }

        .badge-grid-gray {
            background: #ededed !important;
            color: #191919 !important;
            font-weight: 600;
            font-size: .94em;
            border-radius: 9px;
            border: 1px solid #dddddd;
            padding: 6px 12px;
            letter-spacing: .01em;
            box-shadow: 0 1px 7px #dde2eb22;
        }

        .badge-publicado {
            background: #d1f4e0 !important;
            color: #0f5132 !important;
        }

        .badge-borrador {
            background: #fff3cd !important;
            color: #664d03 !important;
        }

        .badge-eliminado {
            background: #f8d7da !important;
            color: #842029 !important;
        }

        .grid-thumb {
            width: 80px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e6eef6;
        }

        .modal-header .btn-close {
            position: absolute;
            right: 1.1rem;
            top: 1.1rem;
        }

        .crm-modal-header {
            background: #f7f9fd;
            border-bottom: 1px solid #e5e8ef;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            padding: 1.1rem 1.5rem;
            color: #315686;
        }

        .crm-modal-title {
            font-size: 1.34rem;
            font-weight: 600;
            color: #315686;
        }

        .crm-modal-content {
            border-radius: 20px;
            box-shadow: 0 13px 32px 0 #b7c3f859;
            background: #fff;
        }

        .crm-modal-footer {
            border-top: 1px solid #ebecf1;
            padding: 1rem 1.5rem;
            background: #f7f9fd;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            text-align: right;
        }

        .crm-modal-body {
            padding: 1.3rem 1.5rem 1.3rem 1.5rem;
        }

        .dataTables_paginate {
            padding: 0.55em 0.25em;
            font-size: 1em;
            display: flex;
            justify-content: flex-end;
        }

        .modal-lg .crm-modal-content {
            max-width: 730px;
            margin: 0 auto;
        }

        @@media (max-width: 1100px) {
            .crm-container-admin, .table-centered-admin, .block-admin-uniform, .dt-controls-flex {
                max-width: 99vw;
            }
        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Gestión de contenidos</h2>

    <div class="block-admin-uniform mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center block-title-admin-x">
            <div>
                <div class="mb-2 fs-4">
                    <i class="bi bi-journal-text me-2" style="font-size:1.4em;color:#3196fa;vertical-align:middle"></i>
                    Gestión de contenidos
                </div>
                <div class="text-muted mb-2">
                    Administre, edite y publique todos los contenidos del sistema.
                </div>
            </div>
            <div>
                <a asp-page="./Detalle" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Nuevo contenido
                </a>
                <button id="btnFillSlugs" type="button" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-slash-circle me-1"></i> Rellenar SLUGs faltantes
                </button>
                <span id="fillSlugsCount" class="ms-2 text-muted">Modificados: <strong>0</strong></span>
                <button id="btnRefreshSitemapContents" type="button" class="btn btn-outline-info ms-3">Actualizar XML de Contenidos</button>
                <button id="btnRefreshSitemapPreguntas" type="button" class="btn btn-outline-info ms-2">Actualizar XML de Preguntas</button>
                <span id="refreshSitemapStatus" class="ms-2 text-muted">&nbsp;</span>
            </div>
        </div>
    </div>

    <div class="dt-controls-flex">
        <div class="dt-controls-left">
            <div id="gridLengthWrapper"></div>
            <!-- category selects -->
            <div class="ms-3">
                <label for="selectCategoriaPadre" class="small me-2">Categoría padre</label>
                <select id="selectCategoriaPadre" class="form-select d-inline-block" style="width:220px">
                    <option value="">(Todas)</option>
                </select>
                <label for="selectCategoriaHijo" class="small ms-3 me-2">Hijo</label>
                <select id="selectCategoriaHijo" class="form-select d-inline-block" style="width:220px" disabled>
                    <option value="">(Todos)</option>
                </select>
            </div>
        </div>
        <div class="dt-controls-right">
            <!-- switches on the right so they are visible and consistent with previous layout -->
            <div class="form-check form-switch d-inline-block align-middle me-3">
                <input class="form-check-input" type="checkbox" role="switch" id="switchEliminados">
                <label class="form-check-label" for="switchEliminados">Mostrar eliminados</label>
            </div>
            <div class="form-check form-switch d-inline-block align-middle me-3">
                <input class="form-check-input" type="checkbox" role="switch" id="switchBorradores">
                <label class="form-check-label" for="switchBorradores">Mostrar borradores</label>
            </div>
            <div id="gridSearchWrapper"></div>
        </div>
    </div>

    <div class="table-centered-admin">
        <table id="contenidosGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th style="width:90px">Imagen</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Categoría</th>
                    <th>Fecha creado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form id="formEditar" class="crm-modal-content modal-content">
                <div class="crm-modal-header modal-header">
                    <h5 class="crm-modal-title modal-title" id="modalEditarLabel">Editar Contenido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="crm-modal-body modal-body">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="mb-3">
                        <label for="edit_titulo" class="form-label">Título</label>
                        <input type="text" class="form-control" id="edit_titulo" name="titulo" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit_descripcion" class="form-label">Descripción</label>
                        <textarea class="form-control" id="edit_descripcion" name="descripcion" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="edit_tipo" class="form-label">Tipo</label>
                        <input type="number" class="form-control" id="edit_tipo" name="tipo" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit_publicado" class="form-label">Estado publicación</label>
                        <select class="form-select" id="edit_publicado" name="publicado">
                            <option value="0">Borrador</option>
                            <option value="1">Publicado</option>
                        </select>
                    </div>
                    <div class="alert alert-success d-none" id="msgEditSuccess">¡Edición realizada correctamente!</div>
                </div>
                <div class="crm-modal-footer modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Aceptar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let contenidosTabla;

        $(function() {
        console.log('✅ Inicializando DataTable para Contenidos (POST con switches)');
            
        // register switches change handler early so toggling immediately triggers reload
        $('#switchEliminados, #switchBorradores').on('change', function() {
            try { if (typeof contenidosTabla !== 'undefined' && contenidosTabla) contenidosTabla.ajax.reload(); } catch(e) { console.warn(e); }
        });

        // Refresh sitemap XML for contents
        $('#btnRefreshSitemapContents').on('click', function() {
            if (!confirm('¿Desea regenerar y actualizar el sitemap de contenidos?')) return;
            var $btn = $(this);
            $btn.prop('disabled', true).text('Actualizando...');
            $('#refreshSitemapStatus').text('Procesando...');
            $.ajax({
                url: '/sitemap/refresh',
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: $.param({ scope: 'contents' }),
                success: function(res) {
                    console.log('Sitemap contenidos actualizado:', res);
                    $('#refreshSitemapStatus').text('OK');
                },
                error: function(xhr) {
                    console.error('Error actualizando sitemap contenidos:', xhr.status, xhr.responseText);
                    if (xhr.status === 403) {
                        $('#refreshSitemapStatus').text('Forbidden');
                        alert('No autorizado. Necesitas permisos de administrador para regenerar el sitemap.');
                    } else {
                        $('#refreshSitemapStatus').text('Error');
                        alert('Error actualizando sitemap de contenidos. Revisa la consola.');
                    }
                },
                complete: function() {
                    $btn.prop('disabled', false).html('Actualizar XML de Contenidos');
                }
            });
        });

        // Refresh sitemap XML for preguntas
        $('#btnRefreshSitemapPreguntas').on('click', function() {
            if (!confirm('¿Desea regenerar y actualizar el sitemap de preguntas?')) return;
            var $btn = $(this);
            $btn.prop('disabled', true).text('Actualizando...');
            $('#refreshSitemapStatus').text('Procesando...');
            $.ajax({
                url: '/sitemap-preguntas/refresh',
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: $.param({ scope: 'preguntas' }),
                success: function(res) {
                    console.log('Sitemap preguntas actualizado:', res);
                    $('#refreshSitemapStatus').text('OK');
                },
                error: function(xhr) {
                    console.error('Error actualizando sitemap preguntas:', xhr.status, xhr.responseText);
                    if (xhr.status === 403) {
                        $('#refreshSitemapStatus').text('Forbidden');
                        alert('No autorizado. Necesitas permisos de administrador para regenerar el sitemap.');
                    } else {
                        $('#refreshSitemapStatus').text('Error');
                        alert('Error actualizando sitemap de preguntas. Revisa la consola.');
                    }
                },
                complete: function() {
                    $btn.prop('disabled', false).html('Actualizar XML de Preguntas');
                }
            });
        });

        contenidosTabla = $('#contenidosGrid').DataTable({
        processing: true,
        serverSide: true,
        // show the DataTables "info" (e.g. "Mostrando 1 a 10 de 100 entradas") at the top of the grid
        dom: 'i lfrtip',
        ajax: {
        url: '/Identity/Admin/Contenidos/Contenidos?handler=GridData',
        type: 'POST',
        data: function(d) {
        // send as 1/0 to be unambiguous
        d.mostrarEliminados = $('#switchEliminados').is(':checked') ? '1' : '0';
        d.mostrarBorradores = $('#switchBorradores').is(':checked') ? '1' : '0';
        d.categoriaPadre = $('#selectCategoriaPadre').val();
        d.categoriaHijo = $('#selectCategoriaHijo').val();
        console.log('📤 Parámetros (POST):', {
        eliminados: d.mostrarEliminados,
        borradores: d.mostrarBorradores,
        categoriaPadre: d.categoriaPadre,
        categoriaHijo: d.categoriaHijo
        });
        },
        error: function(xhr, error, code) {
        console.error('❌ Error AJAX:', { status: xhr.status, error: error, code: code });
        console.error('❌ Response:', xhr.responseText);
        },
        dataSrc: function(json) {
        console.log('✅ Datos recibidos:', json);
        return json.data;
        }
        },
        columns: [
        {
        data: null,
        orderable: false,
        render: function(data, type, row, meta) {
        return meta.row + meta.settings._iDisplayStart + 1;
        }
        },
        {
        data: 'imagenUrl',
        orderable: false,
        render: function(data) {
        if (data) return `<img src="${data}" class="grid-thumb" alt="" loading="lazy" decoding="async" width="80" height="50" fetchpriority="low">`;
        return `<div class="text-muted small">Sin IMG</div>`;
        }
        },
        { data: 'titulo', orderable: false },
        {
        data: 'descripcion',
        orderable: false,
        render: function(d) {
        if (!d) return '';
        return d.length > 100 ? d.substring(0, 100) + '...' : d;
        }
        },
        {
        data: 'tipo',
        orderable: false,
        render: function(d) {
        const tipos = { 1: 'Artículo', 2: 'Noticia', 3: 'Guía' };
        return tipos[d] || d;
        }
        },
        {
        data: null,
        orderable: false,
        render: function(row) {
        // mostrar tres capsulas: publicado, borrador, eliminado dependiendo del estado
        var pub = row.publicado === 0 ? '<span class="badge badge-grid-gray badge-borrador">Borrador</span>' : '<span class="badge badge-grid-gray badge-publicado">Publicado</span>';
        var elim = row.eliminado ? '<span class="badge badge-grid-gray badge-eliminado">Eliminado</span>' : '';
        return pub + (elim ? ' ' + elim : '');
        }
        },
        { data: 'categorias', orderable: false, render: function(d) {
            if (!d) return '';
            try {
                // d already contains HTML-encoded names and <strong> for parents; just render
                return `<div class="categoria-text" title="${d.replace(/<[^>]*>?/gm, '')}">${d}</div>`;
            } catch(e) { return `<span class="categoria-text" title="${d}">${d}</span>`; }
        } },
        {
        data: 'fechaCreado',
        render: function(d) {
        if (!d) return '';
        const dt = new Date(d);
        try { return dt.toLocaleDateString(); } catch (e) { return dt.toISOString().slice(0, 10); }
        }
        },
        // columna eliminado eliminada (estado ahora en columna Estado)
        {
        data: null,
        orderable: false,
        render: function(data, type, row) {
        const detalleUrl = '@Url.Page("./Detalle")';
        let editBtn = `<a class='btn btn-sm btn-action-grid btn-action-edit' href='${detalleUrl}?id=${row.id}' title='Editar'><i class="bi bi-pencil-square"></i> Editar</a>`;
        let actionBtn = "";

        if (row.eliminado) {
        actionBtn = ` <button class='btn btn-sm btn-action-grid btn-action-edit btn-restaurar' title='Restaurar' data-id='${row.id}'><i class="bi bi-arrow-counterclockwise" style="color:#3196fa"></i> Restaurar</button>`;
        } else {
        let eliminarBtn = `<button class='btn btn-sm btn-action-grid btn-action-delete btn-borrar' title='Eliminar' data-id='${row.id}'><i class="bi bi-trash"></i> Eliminar</button>`;
        actionBtn = eliminarBtn;
        }

        return editBtn + actionBtn;
        }
        }
        ],
        order: [],
        language: {
        emptyTable: "No hay contenidos registrados.",
        search: "Buscar:",
        lengthMenu: "Mostrar _MENU_ registros",
        info: "Mostrando _START_ a _END_ de _TOTAL_ entradas",
        infoFiltered: "(filtrado de _MAX_ entradas total)",
        processing: "Procesando...",
        loadingRecords: "Cargando...",
        zeroRecords: "No se encontraron resultados"
        },
        initComplete: function(settings, json) {
        console.log('✅ DataTable inicializado correctamente');
                    
        if ($('#contenidosGrid_length').length) {
        const $length = $('#contenidosGrid_length');
        $length.css({ display: 'inline-flex', 'align-items': 'center', margin: '0', 'white-space': 'nowrap' });
        $("#gridLengthWrapper").empty().append($length.children());
        }
        if ($('#contenidosGrid_filter').length) {
        const $filter = $('#contenidosGrid_filter');
        $filter.css({ display: 'inline-flex', 'align-items': 'center', margin: '0', 'white-space': 'nowrap' });
        $("#gridSearchWrapper").empty().append($filter.children());
        }
        // Load parent categories into select
        $.get('/Identity/Admin/Contenidos/Contenidos?handler=CategoriesList', function(items){
            const $p = $('#selectCategoriaPadre');
            $p.find('option:gt(0)').remove();
            items.forEach(i=>{
                $p.append(`<option value="${i.sequence}">${i.label}</option>`);
            });
        }).fail(function(){ console.warn('No se pudieron cargar categorias padres'); });

        // when parent changes, load children
        $('#selectCategoriaPadre').on('change', function(){
            const val = $(this).val();
            const $child = $('#selectCategoriaHijo');
            $child.prop('disabled', true);
            $child.find('option:gt(0)').remove();
            if (!val) { contenidosTabla.ajax.reload(); return; }
            $.get('/Identity/Admin/Contenidos/Contenidos?handler=ChildrenList', { parent: val }, function(items){
                if (!items || items.length===0) { $child.prop('disabled', true); }
                else {
                    items.forEach(i=> $child.append(`<option value="${i.sequence}">${i.nombre}</option>`));
                    $child.prop('disabled', false);
                }
                contenidosTabla.ajax.reload();
            }).fail(function(){ $child.prop('disabled', true); contenidosTabla.ajax.reload(); });
        });

        $('#selectCategoriaHijo').on('change', function(){ contenidosTabla.ajax.reload(); });
        }
        });

        $('#switchEliminados, #switchBorradores').change(function() {
        console.log('🔄 Recargando grid con switches:', {
        eliminados: $('#switchEliminados').is(':checked'),
        borradores: $('#switchBorradores').is(':checked')
        });
        contenidosTabla.ajax.reload();
        });

        $('#contenidosGrid').on('click', '.btn-borrar', function() {
        const id = $(this).data('id');
        console.log('🗑️ Eliminando contenido:', id);
                
        if (confirm('¿Seguro que desea eliminar este contenido?')) {
        $.ajax({
        url: '/Identity/Admin/Contenidos/Contenidos?handler=EliminarContenido',
        type: "POST",
        data: $.param({ id: id }),
        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
        success: function(response) {
        console.log('✅ Respuesta eliminar:', response);
        if (response.success) {
        contenidosTabla.ajax.reload(null, false);
        } else {
        alert('Error: ' + (response.message || 'No se pudo eliminar.'));
        }
        },
        error: function(xhr, status, error) {
        console.error('❌ Error:', { status: xhr.status, error: error });
        alert('Error al eliminar: ' + error);
        }
        });
        }
        });

        $('#contenidosGrid').on('click', '.btn-restaurar', function() {
        const id = $(this).data('id');
        console.log('♻️ Restaurando contenido:', id);
                
        if (confirm('¿Seguro que desea restaurar este contenido?')) {
        $.ajax({
        url: '/Identity/Admin/Contenidos/Contenidos?handler=RestaurarContenido',
        type: "POST",
        data: $.param({ id: id }),
        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
        success: function(response) {
        console.log('✅ Respuesta restaurar:', response);
        if (response.success) {
        contenidosTabla.ajax.reload(null, false);
        } else {
        alert('Error: ' + (response.message || 'No se pudo restaurar.'));
        }
        },
        error: function(xhr, status, error) {
        console.error('❌ Error:', { status: xhr.status, error: error });
        alert('Error al restaurar: ' + error);
        }
        });
        }
        });

        // Handler: Fill missing slugs
        $('#btnFillSlugs').on('click', function() {
            if (!confirm('¿Desea rellenar los slugs faltantes para contenidos publicados? Esto actualizará la base de datos.')) return;
            var $btn = $(this);
            $btn.prop('disabled', true).text('Procesando...');
            $.ajax({
                url: '/Identity/Admin/Contenidos/Contenidos?handler=FillMissingSlugs',
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: $.param({ }),
                success: function(res) {
                    console.log('Rellenado SLUGs respuesta:', res);
                    if (res && typeof res.modified === 'number') {
                        $('#fillSlugsCount strong').text(res.modified);
                        contenidosTabla.ajax.reload();
                    } else {
                        alert('Respuesta inesperada del servidor. Revisa la consola.');
                    }
                },
                error: function(xhr) {
                    console.error('Error rellenando slugs:', xhr.responseText);
                    alert('Error al rellenar slugs. Revisa la consola.');
                },
                complete: function() {
                    $btn.prop('disabled', false).html('<i class="bi bi-slash-circle me-1"></i> Rellenar SLUGs faltantes');
                }
            });
        });
        });
    </script>
}