@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.DetalleModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Contenido" : "Nuevo Contenido";
    Layout = "_Layout";

    // Prepare grouped condition lists here so they are available in the template
    var parentsList = Model.AllCondiciones?.Where(x => x.padre == null).OrderBy(x => x.nombre).ToList() ?? new List<(int id, string nombre, int? padre)>();
    var childrenList = Model.AllCondiciones?.Where(x => x.padre != null).OrderBy(x => x.nombre).ToList() ?? new List<(int id, string nombre, int? padre)>();
    var childrenByParentMap = childrenList
        .Where(ch => ch.padre.HasValue && parentsList.Any(p => p.id == ch.padre.Value))
        .GroupBy(ch => ch.padre.Value)
        .ToDictionary(g => g.Key, g => g.ToList());
    var orphanChildrenList = childrenList
        .Where(ch => !ch.padre.HasValue || !parentsList.Any(p => p.id == ch.padre.Value))
        .ToList();
}
@section Styles {
    <style>
        .form-wrapper-flex {
            display: flex;
            gap: 24px;
            align-items: flex-start;
        }

        .form-section {
            flex: 1 1 auto;
            max-width: 1100px;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #e8eef6;
        }

        .right-rel-panel {
            width: 340px;
            flex: 0 0 340px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .rel-box {
            background: #fff;
            border: 1px solid #d9e3ec;
            border-radius: 10px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
        }

            .rel-box h5 {
                font-size: 1rem;
                font-weight: 600;
                margin: 0 0 8px 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .rel-search-row {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 6px;
        }

            .rel-search-row input, .rel-search-row select {
                width: 100%;
                padding: 6px 8px;
                border: 1px solid #c9d6e6;
                border-radius: 6px;
                font-size: .85rem;
            }

        .rel-selected-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 72px;
            overflow-y: auto;
            padding: 2px 0;
        }

        .rel-badge-sel {
            background: #eef5ff;
            color: #24527a;
            border: 1px solid #c9d6e6;
            border-radius: 999px;
            padding: 3px 8px;
            font-size: .65rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .rel-badge-sel button {
                background: transparent;
                border: 0;
                cursor: pointer;
                color: #24527a;
                padding: 0;
                font-size: .7rem;
                line-height: 1;
            }

        .rel-scroll {
            flex: 1 1 auto;
            min-height: 120px;
            max-height: 200px;
            overflow: auto;
            border: 1px solid #e1e7ef;
            border-radius: 6px;
            background: #fafbfd;
            padding: 6px;
        }

        .rel-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 6px;
            border-radius: 4px;
            font-size: .82rem;
            line-height: 1.2;
        }

            .rel-item:hover {
                background: #eef5ff;
            }

        .rel-empty {
            font-size: .72rem;
            color: #6a737c;
            padding: 4px;
        }

        /* Conditions grouping */
        .cond-parent {
            font-weight: 700;
            padding: 6px 4px;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cond-parent .parent-title {
                flex: 1;
            }

        .cond-children {
            padding-left: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .cond-group {
            margin-bottom: 6px;
            border-bottom: 1px dashed rgba(0,0,0,0.03);
            padding-bottom: 6px;
        }

        .cond-parent-checkbox {
            width: 18px;
            height: 18px;
            display: inline-block;
        }

        .seo-block {
            background: #f8f9fb;
            border: 1px solid #e1e7ef;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: .9rem;
        }

        .toggle-debug-btn {
            margin-bottom: 8px;
        }

        /* small inline slug status styles (span next to input) */
        .slug-status {
            margin-left: 10px;
            font-weight: 600;
            font-size: .85rem;
            vertical-align: middle;
        }

            .slug-status.ok {
                color: #198754;
            }
            /* bootstrap success */
            .slug-status.fail {
                color: #dc3545;
            }
        /* bootstrap danger */

        @@media (max-width:1200px) {
            .form-wrapper-flex {
                flex-direction: column
            }

            .right-rel-panel {
                width: 100%;
                flex: 1 1 auto
            }
        }
    </style>
}

<div class="container my-4">
    <form method="post" asp-page-handler="Save" enctype="multipart/form-data" id="detalleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" id="contenidoIdHidden" />

        @* SEO URL block at the top *@
        <div class="seo-block">
            <strong>URL SEO pública:</strong>
            @if (!string.IsNullOrWhiteSpace(Model.SeoUrl))
            {
                <a href="@Model.SeoUrl" target="_blank" rel="noopener noreferrer">@Model.SeoUrl</a>
            }
            else
            {
                <span class="text-muted">(Aún no disponible: slug vacío o contenido no relacionado)</span>
            }
        </div>

        <div class="form-wrapper-flex">
            <div class="form-section">
                <h3>@ViewData["Title"]</h3>

                @if (!string.IsNullOrWhiteSpace(Model.DebugInfoHtml))
                {
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary toggle-debug-btn" id="btnToggleDebug">Mostrar debug</button>
                        <div id="debugBlock" style="display:none" class="mb-3">
                            <label class="form-label">DEBUG</label>
                            <pre class="debug">@Html.Raw(Model.DebugInfoHtml)</pre>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.WarningMessage))
                {
                    <div class="alert alert-warning">@Model.WarningMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div id="successBanner" class="alert alert-success text-center">@Model.SuccessMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label">Título</label>
                    <input class="form-control" asp-for="ContenidoTitulo" id="titulo" autocomplete="off" />
                </div>

                <div class="mb-3 d-flex align-items-center">
                    <div style="flex:1">
                        <label class="form-label">Slug</label>
                        <input class="form-control" asp-for="ContenidoTituloSlug" id="slug" autocomplete="off" />
                    </div>
                    <div style="margin-left:12px;">
                        <span id="slugStatus" class="slug-status" aria-live="polite"></span>
                    </div>
                </div>
                <small class="text-muted d-block mb-2">Se genera y valida en tiempo real. Puedes editarlo manualmente.</small>

                <div class="mb-3">
                    <label class="form-label">Resumen</label>
                    <textarea class="form-control" asp-for="ContenidoTextoC" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contenido (HTML)</label>
                    <textarea class="form-control" asp-for="ContenidoTextoL" id="contenidoHtml" rows="15">@Html.Raw(Model.ContenidoTextoL)</textarea>
                </div>

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" asp-for="EstadoPublicacion">
                            <option value="0">Borrador</option>
                            <option value="1">Publicado</option>
                            <option value="2">Publicado y Pagina de Inicio</option>
                            <option value="3">Publicado y Popular</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Inicio</label>
                        <input type="datetime-local" class="form-control" asp-for="ContenidoFechaInicio" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fin</label>
                        <input type="datetime-local" class="form-control" asp-for="ContenidoFechaFin" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">País</label>
                        <select class="form-select" name="PaisClave" id="paisSelect">
                            <option value="">(Seleccionar país)</option>
                            @foreach (var p in Model.PaisesLista)
                            {
                                if (p.code == Model.PaisClave)
                                {
                                    <option value="@p.code" selected>@p.name (@p.code)</option>
                                }
                                else
                                {
                                    <option value="@p.code">@p.name (@p.code)</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 mt-3">
                    <div class="col-md-6">
                        <label class="form-label">Autor</label>
                        <select name="SelectedAutorId" id="SelectedAutorId" class="form-select">
                            <option value="">(Seleccionar autor)</option>
                            @foreach (var a in Model.AdminAuthors)
                            {
                                if (Model.SelectedAutorId == a.id)
                                {
                                    <option value="@a.id" selected>@a.name</option>
                                }
                                else
                                {
                                    <option value="@a.id">@a.name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Imagen principal</label>
                        <input type="file" class="form-control" name="UploadedImage" />
                        @if (!string.IsNullOrWhiteSpace(Model.URLImagenPrincipal))
                        {
                            <div class="mt-2">
                                <img src="~/uploads/contenidos/@Model.URLImagenPrincipal" style="max-width:220px;max-height:140px;" />
                            </div>
                        }
                    </div>
                </div>

                <div class="row g-2 mt-3">
                    <div class="col-md-6">
                        <label class="form-label">Categoría (padre)</label>
                        <select id="categoriaPadre" name="IdCategoriaPadre" class="form-select">
                            <option value="">(Seleccionar categoría)</option>
                            @foreach (var c in Model.CategoryItems.Where(c => c.CategoriaPadre == null))
                            {
                                if (Model.IdCategoriaPadre == c.Sequence)
                                {
                                    <option value="@c.Sequence" selected>@c.Nombre</option>
                                }
                                else
                                {
                                    <option value="@c.Sequence">@c.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Subcategoría</label>
                        <select id="subcategoria" name="IdCategoria" class="form-select">
                            <option value="">(Seleccionar subcategoría)</option>
                            @foreach (var s in Model.Subcategories)
                            {
                                if (Model.IdCategoria == s.seq)
                                {
                                    <option value="@s.seq" selected>@s.name</option>
                                }
                                else
                                {
                                    <option value="@s.seq">@s.name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a class="btn btn-secondary me-2" href="@Url.Page("./Index")">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="btnGuardar">Guardar</button>
                </div>
            </div>

            <aside class="right-rel-panel">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="location.href='@Url.Page("/Admin/Contenidos/Contenidos", new { area = "Identity" })'">Regresar a Ver todos</button>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-primary mb-2" onclick="window.open('/Identity/Admin/Contenidos/Detalle','_blank')">Agregar nuevo</button>
                </div>
                </div>

                <div class="rel-box">
                    <h5>Contenidos generales <span class="badge bg-light text-dark">@Model.AllGeneralContenidos.Count</span></h5>

                    <div class="rel-search-row">
                        <label class="form-label small mb-0">Filtrar por padre</label>
                        <select id="filterByParent" class="form-select">
                            <option value="">— Todos —</option>
                            @foreach (var p in Model.ParentCategories)
                            {
                                <option value="@p.Sequence">@p.Nombre</option>
                            }
                        </select>

                        <input type="text" id="searchGeneralCont" placeholder="Filtrar por título..." autocomplete="off" />
                        <div id="generalContSelectedBadges" class="rel-selected-badges">
                            @foreach (var c in Model.AllGeneralContenidos.Where(x => Model.SelectedManualContenidoIds.Contains(x.Id)))
                            {
                                <span class="rel-badge-sel" data-id="@c.Id">@c.Title <button type="button" class="badge-remove btn-close" data-target-name="SelectedManualContenidoIds" data-id="@c.Id" aria-label="Eliminar"></button></span>
                            }
                        </div>
                    </div>

                    <div class="rel-scroll" id="listGeneralCont" role="list">
                        @if (!Model.AllGeneralContenidos.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var c in Model.AllGeneralContenidos)
                            {
                                var checkedAttr = Model.SelectedManualContenidoIds.Contains(c.Id) ? "checked" : "";
                                var parentSeqAttr = c.ParentCategorySeq.HasValue ? c.ParentCategorySeq.Value.ToString() : "";
                                <label class="rel-item" data-filter="@((c.Title ?? "").ToLowerInvariant())" data-parent="@parentSeqAttr" role="listitem">
                                    <input type="checkbox" name="SelectedManualContenidoIds" value="@c.Id" class="rel-check-generalcont" @checkedAttr />
                                    <span>@c.Title</span>
                                    @if (!string.IsNullOrEmpty(c.ParentCategoryName))
                                    {
                                        <small class="text-muted ms-2">· @c.ParentCategoryName</small>
                                    }
                                </label>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box">
                    <h5>Preguntas (con respuestas o votos) <span class="badge bg-light text-dark">@Model.AllPreguntasCandidate.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchPreguntas" placeholder="Filtrar..." autocomplete="off" />
                        <div id="pregSelectedBadges" class="rel-selected-badges">
                            @foreach (var q in Model.AllPreguntasCandidate.Where(x => Model.SelectedManualPreguntasIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@q.id">@q.title <button type="button" class="badge-remove" data-target-name="SelectedManualPreguntasIds" data-id="@q.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="listPreguntas">
                        @if (!Model.AllPreguntasCandidate.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var q in Model.AllPreguntasCandidate)
                            {
                                var checkedAttr = Model.SelectedManualPreguntasIds.Contains(q.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@((q.title ?? "").ToLowerInvariant())">
                                    <input type="checkbox" name="SelectedManualPreguntasIds" value="@q.id" class="rel-check-pregunta" @checkedAttr />
                                    <span>@q.title</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box" id="panelCondiciones">
                    <h5>Condiciones <span class="badge bg-light text-dark">@Model.AllCondiciones.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchCondiciones" placeholder="Filtrar..." autocomplete="off" />
                        <div id="condSelectedBadges" class="rel-selected-badges">
                            @foreach (var c in Model.AllCondiciones.Where(x => Model.SelectedCondicionesIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@c.id">@c.nombre <button type="button" class="badge-remove" data-target-list="SelectedCondicionesIds" data-id="@c.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>

                    <div class="rel-scroll" id="listCondiciones" role="list">
                        @if (!Model.AllCondiciones.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            @* parents with their children *@
                            @foreach (var parent in parentsList)
                            {
                                <div class="cond-group" data-parent="@parent.id">
                                    <div class="cond-parent">
                                    <input type="checkbox" name="SelectedCondicionesIds" value="@parent.id" class="cond-parent-checkbox" data-parent-id="@parent.id" id="parentchk_@parent.id" @(Model.SelectedCondicionesIds.Contains(parent.id) ? "checked" : "") />
                                        <div class="parent-title">@parent.nombre</div>
                                    </div>
                                    <div class="cond-children">
                                        @{
                                            if (childrenByParentMap.TryGetValue(parent.id, out var chs) && chs.Any())
                                            {
                                                foreach (var ch in chs)
                                                {
                                                    var checkedAttr = Model.SelectedCondicionesIds.Contains(ch.id) ? "checked" : "";
                                                    <label class="rel-item" data-filter="@ch.nombre.ToLowerInvariant()">
                                                        <input type="checkbox" name="SelectedCondicionesIds" value="@ch.id" class="rel-check-condicion" @checkedAttr />
                                                        <span>@ch.nombre</span>
                                                    </label>
                                                }
                                            }
                                            else
                                            {
                                                <div class="rel-item rel-empty">No hay subcondiciones</div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @* orphan children under "Otros" *@
                            @if (orphanChildrenList.Any())
                            {
                                <div class="cond-group" data-parent="0">
                                    <div class="cond-parent">
                                        <input type="checkbox" class="cond-parent-checkbox" data-parent-id="0" id="parentchk_0" />
                                        <div class="parent-title">Otros</div>
                                    </div>
                                    <div class="cond-children">
                                        @foreach (var ch in orphanChildrenList)
                                        {
                                            var checkedAttr = Model.SelectedCondicionesIds.Contains(ch.id) ? "checked" : "";
                                            <label class="rel-item" data-filter="@ch.nombre.ToLowerInvariant()">
                                                <input type="checkbox" name="SelectedCondicionesIds" value="@ch.id" class="rel-check-condicion" @checkedAttr />
                                                <span>@ch.nombre</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box" id="panelSintomas">
                    <h5>Síntomas <span class="badge bg-light text-dark">@Model.AllSintomas.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchSintomas" placeholder="Filtrar..." autocomplete="off" />
                        <div id="sintSelectedBadges" class="rel-selected-badges">
                            @foreach (var s in Model.AllSintomas.Where(x => Model.SelectedSintomasIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@s.id">@s.nombre <button type="button" class="badge-remove" data-target-list="SelectedSintomasIds" data-id="@s.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="listSintomas">
                        @if (!Model.AllSintomas.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var s in Model.AllSintomas)
                            {
                                var checkedAttr = Model.SelectedSintomasIds.Contains(s.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@s.nombre?.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedSintomasIds" value="@s.id" class="rel-check-sintoma" @checkedAttr />
                                    <span>@s.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box" id="panelTratamientos">
                    <h5>Tratamientos <span class="badge bg-light text-dark">@Model.AllTratamientos.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchTratamientos" placeholder="Filtrar..." autocomplete="off" />
                        <div id="tratSelectedBadges" class="rel-selected-badges">
                            @foreach (var t in Model.AllTratamientos.Where(x => Model.SelectedTratamientosIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@t.id">@t.nombre <button type="button" class="badge-remove" data-target-list="SelectedTratamientosIds" data-id="@t.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="listTratamientos">
                        @if (!Model.AllTratamientos.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var t in Model.AllTratamientos)
                            {
                                var checkedAttr = Model.SelectedTratamientosIds.Contains(t.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@t.nombre?.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedTratamientosIds" value="@t.id" class="rel-check-tratamiento" @checkedAttr />
                                    <span>@t.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </aside>
        </div>

        @* SEO URL block at the bottom *@
        <div class="seo-block mt-3">
            <strong>URL SEO pública:</strong>
            @if (!string.IsNullOrWhiteSpace(Model.SeoUrl))
            {
                <a href="@Model.SeoUrl" target="_blank" rel="noopener noreferrer">@Model.SeoUrl</a>
            }
            else
            {
                <span class="text-muted">(Aún no disponible: slug vacío o contenido no relacionado)</span>
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/c1xlulcw2ayqu8bq58edh8qjshj6yruj6g2linjofz9rw369/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        // ---------- TinyMCE (WYSIWYG) ----------
        tinymce.init({
            selector:'#contenidoHtml',
            height:520,
            menubar:'file edit view insert format tools table help',
            plugins:'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount fullscreen preview code advlist autoresize autosave',
            toolbar:'undo redo | blocks | bold italic underline strikethrough forecolor backcolor removeformat | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media table | charmap emoticons | blockquote codesample | fullscreen preview code',
            toolbar_mode:'wrap',
            branding:false,
            promotion:false,
            statusbar:true,
            autosave_interval:'30s',
            autosave_retention:'10m',
            image_caption:true,
            convert_urls:false,
            default_link_target:'_blank',
            content_style:'body { font-family: system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial,sans-serif; font-size:14px; }',
            images_upload_handler:(blobInfo)=>new Promise((resolve,reject)=>{
                try{resolve("data:"+blobInfo.blob().type+";base64,"+blobInfo.base64());}catch(e){reject('Error imagen: '+e);}
            }),
            setup:(ed)=>ed.on('change keyup undo redo',()=>ed.save())
        });

        // ---------- Slug logic with visual feedback on the input ----------
        const tituloInput=document.getElementById('titulo');
        const slugInput=document.getElementById('slug');
        const slugStatus=document.getElementById('slugStatus');
        const contenidoId=document.getElementById('contenidoIdHidden')?.value;
        let slugDirty=false, slugTimer=null, lastValidated='';

        function slugify(text){
            if(!text) return '';
            return text.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
                .replace(/[^a-z0-9\s-]/g,'')
                .trim().replace(/\s+/g,'-')
                .replace(/-+/g,'-');
        }
        function applySlugAuto(){
            if(!slugDirty){
                slugInput.value=slugify(tituloInput.value);
            }
        }
        function setSlugStatus(state){
            // clear previous classes
            slugStatus.className = 'slug-status';
            if(slugInput){
                slugInput.classList.remove('is-valid','is-invalid');
                slugInput.removeAttribute('aria-invalid');
            }

            if(state === 'ok'){
                slugStatus.textContent = 'aprobado';
                slugStatus.classList.add('ok');
                if(slugInput) slugInput.classList.add('is-valid');
            } else if(state === 'fail'){
                slugStatus.textContent = 'rechazado';
                slugStatus.classList.add('fail');
                if(slugInput){
                    slugInput.classList.add('is-invalid');
                    slugInput.setAttribute('aria-invalid','true');
                }
            } else if(state === 'error'){
                slugStatus.textContent = 'error';
                slugStatus.classList.add('fail');
                if(slugInput){
                    slugInput.classList.add('is-invalid');
                    slugInput.setAttribute('aria-invalid','true');
                }
            } else {
                slugStatus.textContent = '';
            }
        }
        function validateSlug(){
            const val=(slugInput.value||'').trim();
            if(val.length===0){ setSlugStatus(''); return; }
            if(val===lastValidated) return;
            lastValidated=val;
            const url=`${location.pathname}?handler=CheckSlug&slug=${encodeURIComponent(val)}${contenidoId? '&id='+contenidoId:''}`;
            fetch(url,{headers:{'Accept':'application/json'}})
                .then(r=>r.json())
                .then(j=>{
                    if(!j || typeof j.ok === 'undefined'){ setSlugStatus('error'); return; }
                    setSlugStatus(j.exists ? 'fail' : 'ok');
                })
                .catch(()=>setSlugStatus('error'));
        }
        tituloInput?.addEventListener('input',()=>{
            applySlugAuto();
            clearTimeout(slugTimer);
            slugTimer=setTimeout(validateSlug,300);
        });
        slugInput?.addEventListener('input',()=>{
            slugDirty=true;
            clearTimeout(slugTimer);
            slugTimer=setTimeout(validateSlug,250);
        });
        if(tituloInput){ applySlugAuto(); validateSlug(); }

        // ---------- Categories dynamic ----------
        const categories=@Html.Raw(JsonSerializer.Serialize(Model.CategoryItems.Select(c => new { seq = c.Sequence, parent = c.CategoriaPadre, name = c.Nombre })));
        const parentSel=document.getElementById('categoriaPadre');
        const subSel=document.getElementById('subcategoria');

        function populateSub(parentId, selectedValue){
            if(!subSel){return;}
            subSel.innerHTML='<option value="">(Seleccionar subcategoría)</option>';
            if(!parentId){return;}
            categories.filter(c => c.parent !== null && String(c.parent) === String(parentId))
                .forEach(c=>{
                    const opt=document.createElement('option');
                    opt.value=c.seq;
                    opt.textContent=c.name;
                    if(selectedValue && String(selectedValue)===String(c.seq)) opt.selected=true;
                    subSel.appendChild(opt);
                });
        }
        parentSel?.addEventListener('change',()=>{
            subSel.value='';
            populateSub(parentSel.value,null);
        });
        // Initialize with Model values (not DOM values, to avoid timing issues)
        const initialParentRaw = '@(Model.IdCategoriaPadre?.ToString() ?? "")';
        const initialSubRaw = '@(Model.IdCategoria?.ToString() ?? "")';
        const initialParent = initialParentRaw ? initialParentRaw.toString().trim() : '';
        const initialSub = initialSubRaw ? initialSubRaw.toString().trim() : '';
        // Try to initialize selects immediately (script is at bottom so elements exist)
        try {
            if (initialParent) {
                if (parentSel) parentSel.value = initialParent;
                populateSub(initialParent, initialSub);
                if (initialSub && subSel) subSel.value = initialSub;
            } else if (initialSub) {
                // If server provided only the subcategory, infer its parent from the categories list
                const found = categories.find(c => String(c.seq) === String(initialSub));
                const inferredParent = found && found.parent ? String(found.parent) : '';
                if (inferredParent && parentSel) {
                    parentSel.value = inferredParent;
                }
                populateSub(inferredParent || initialParent, initialSub);
                if (initialSub && subSel) subSel.value = initialSub;
            }
            // Also preselect sub if present (populateSub will mark it)
        } catch(e) { /* ignore */ }

        // Debug: log initial values and selects state
        try {
            console.debug('DETALLE: initialParent=', initialParent, 'initialSub=', initialSub);
            console.debug('DETALLE: categories=', categories);
            console.debug('DETALLE: parentSel value=', parentSel ? parentSel.value : null);
            console.debug('DETALLE: subSel value=', subSel ? subSel.value : null);
        } catch (e) { /* ignore */ }

        // ---------- Filters & badges ----------
        const searchInput = document.getElementById('searchGeneralCont');
        const parentSelect = document.getElementById('filterByParent');
        const list = document.getElementById('listGeneralCont');

        function applyGeneralFilter() {
            const q = (searchInput && searchInput.value || '').trim().toLowerCase();
            const parent = (parentSelect && parentSelect.value) || '';

            if (!list) return;
            const items = list.querySelectorAll('.rel-item');
            items.forEach(item => {
                const text = (item.getAttribute('data-filter') || '').toLowerCase();
                const itemParent = (item.getAttribute('data-parent') || '');
                const matchText = !q || text.indexOf(q) !== -1;
                const matchParent = !parent || itemParent === parent;
                item.style.display = (matchText && matchParent) ? '' : 'none';
            });
        }

        if (searchInput) searchInput.addEventListener('input', applyGeneralFilter);
        if (parentSelect) parentSelect.addEventListener('change', applyGeneralFilter);

        function initFilter(inputId,listId){
            const input=document.getElementById(inputId);
            const list=document.getElementById(listId);
            if(!input||!list)return;
            input.addEventListener('input',()=>{
                const term=input.value.trim().toLowerCase();

                if(listId === 'listCondiciones') {
                    const groups = list.querySelectorAll('.cond-group');
                    groups.forEach(g=>{
                        let anyVisible = false;
                        const children = g.querySelectorAll('.rel-item');
                        children.forEach(item=>{
                            const txt = (item.getAttribute('data-filter')||'').toLowerCase();
                            const visible = term==='' || txt.includes(term);
                            item.style.display = visible ? '' : 'none';
                            if(visible) anyVisible = true;
                        });
                        const header = g.querySelector('.cond-parent');
                        if(header) header.style.display = anyVisible ? '' : 'none';
                    });
                    updateAllParentCheckboxStates();
                } else {
                    list.querySelectorAll('.rel-item').forEach(item=>{
                        const txt=item.getAttribute('data-filter')||'';
                        item.style.display=term===''||txt.includes(term)?'':'none';
                    });
                }
            });
        }

        initFilter('searchPreguntas','listPreguntas');
        initFilter('searchCondiciones','listCondiciones');
        initFilter('searchSintomas','listSintomas');
        initFilter('searchTratamientos','listTratamientos');

        function refreshBadges(containerId, checkboxSelector){
            const container=document.getElementById(containerId);
            if(!container)return;
            const checks=document.querySelectorAll(checkboxSelector);
            const fr=document.createDocumentFragment();
            checks.forEach(ch=>{
                if(ch.checked){
                    const span=document.createElement('span');
                    span.className='rel-badge-sel';
                    span.dataset.id=ch.value;
                    const labelText = (ch.nextElementSibling && ch.nextElementSibling.textContent) ? ch.nextElementSibling.textContent.trim() : ch.value;
                    span.textContent = labelText + ' ';
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'badge-remove';
                    btn.dataset.id = ch.value;
                    btn.setAttribute('data-target-list', ch.name);
                    btn.innerHTML = '✕';
                    span.appendChild(btn);
                    fr.appendChild(span);
                }
            });
            container.innerHTML='';
            container.appendChild(fr);
        }

        function attachBadgeEvents(){
            document.addEventListener('change',e=>{
                if(e.target.matches('.rel-check-generalcont')){
                    refreshBadges('generalContSelectedBadges','.rel-check-generalcont');
                }else if(e.target.matches('.rel-check-pregunta')){
                    refreshBadges('pregSelectedBadges','.rel-check-pregunta');
                }else if(e.target.matches('.rel-check-condicion') || e.target.matches('.cond-parent-checkbox')){
                    // include parent checkboxes (standalone parents without children)
                    refreshBadges('condSelectedBadges','.rel-check-condicion, .cond-parent-checkbox');
                    const parentGroup = e.target.closest('.cond-group');
                    if(parentGroup) updateParentCheckboxState(parentGroup);
                }else if(e.target.matches('.rel-check-sintoma')){
                    refreshBadges('sintSelectedBadges','.rel-check-sintoma');
                }else if(e.target.matches('.rel-check-tratamiento')){
                    refreshBadges('tratSelectedBadges','.rel-check-tratamiento');
                }
            });
            document.addEventListener('click',e=>{
                const btn=e.target.closest('.badge-remove');
                if(!btn)return;
                const id=btn.getAttribute('data-id');
                const name = btn.getAttribute('data-target-list');
                if(name){
                    const ck = document.querySelector(`input[name="${name}"][value="${CSS.escape(id)}"]`);
                    if(ck){ ck.checked=false; ck.dispatchEvent(new Event('change')); return; }
                }
                const ck2 = document.querySelector(`input[value="${CSS.escape(id)}"]`);
                if(ck2){ ck2.checked=false; ck2.dispatchEvent(new Event('change')); }
            });
        }
        attachBadgeEvents();
        refreshBadges('generalContSelectedBadges','.rel-check-generalcont');
        refreshBadges('pregSelectedBadges','.rel-check-pregunta');
        refreshBadges('condSelectedBadges','.rel-check-condicion');
        refreshBadges('sintSelectedBadges','.rel-check-sintoma');
        refreshBadges('tratSelectedBadges','.rel-check-tratamiento');

        // Parent checkbox behaviour
        function updateParentCheckboxState(parentGroup){
            if(!parentGroup) return;
            const parentCheckbox = parentGroup.querySelector('.cond-parent-checkbox');
            const childChecks = Array.from(parentGroup.querySelectorAll('.rel-check-condicion'));
            if (!parentCheckbox) return;

            // If there are no child checkboxes, treat the parent as a standalone selectable item
            if (childChecks.length === 0) {
                parentCheckbox.indeterminate = false;
                // Keep the checked state as-is (server may have preselected it)
                return;
            }

            const allChecked = childChecks.every(ch => ch.checked);
            const noneChecked = childChecks.every(ch => !ch.checked);
            parentCheckbox.checked = allChecked;
            parentCheckbox.indeterminate = (!allChecked && !noneChecked);
        }

        function updateAllParentCheckboxStates(){
            document.querySelectorAll('.cond-group').forEach(g => updateParentCheckboxState(g));
        }

        function wireUpParentCheckboxes(){
            document.querySelectorAll('.cond-parent-checkbox').forEach(cb => {
                const parentId = cb.getAttribute('data-parent-id');
                const parentGroup = cb.closest(`.cond-group[data-parent="${parentId}"]`);
                updateParentCheckboxState(parentGroup);

                cb.addEventListener('change', function(e){
                    const checked = !!this.checked;
                    const parentId = this.getAttribute('data-parent-id');
                    const group = this.closest(`.cond-group[data-parent="${parentId}"]`);
                    if(!group) return;
                    const childChecks = Array.from(group.querySelectorAll('.rel-check-condicion'));
                    // If there are child checkboxes, propagate the parent's state to them.
                    if (childChecks.length > 0) {
                        childChecks.forEach(ch => {
                            ch.checked = checked;
                            ch.dispatchEvent(new Event('change'));
                        });
                    }
                    updateParentCheckboxState(group);
                });
            });
        }

        // Debug toggle
        document.addEventListener('DOMContentLoaded', function(){
            const btnDbg = document.getElementById('btnToggleDebug');
            const dbgBlock = document.getElementById('debugBlock');
            if(btnDbg && dbgBlock){
                btnDbg.addEventListener('click', function(){
                    if(dbgBlock.style.display === 'none' || dbgBlock.style.display === ''){
                        dbgBlock.style.display = 'block';
                        btnDbg.textContent = 'Ocultar debug';
                    } else {
                        dbgBlock.style.display = 'none';
                        btnDbg.textContent = 'Mostrar debug';
                    }
                });
            }

            wireUpParentCheckboxes();
            updateAllParentCheckboxStates();

            // Ensure category parent/subcategory UI reflects server-side selection
            try {
                if (initialParent && parentSel) {
                    parentSel.value = initialParent;
                    populateSub(initialParent, initialSub);
                }
                // Preselect country based on server model
                const paisSelect = document.querySelector('select[name="PaisClave"]');
                const initialPais = '@(Model.PaisClave ?? "")';
                if (paisSelect && initialPais) {
                    paisSelect.value = initialPais;
                }
                // Ensure the parent option is visibly selected and populate subcategories
                if (parentSel) {
                    const opt = parentSel.querySelector(`option[value="${initialParent}"]`);
                    if (opt) opt.selected = true;
                    if (initialParent) parentSel.value = initialParent;
                    // Trigger change to populate subcategories; populateSub will select sub if present
                    parentSel.dispatchEvent(new Event('change'));
                    // After a short delay ensure subSel gets selected (timing race with populateSub)
                    setTimeout(()=>{
                        try {
                            if (initialSub && subSel) {
                                // If subSel has options, set selected; otherwise repopulate and set
                                if (subSel.querySelector(`option[value="${initialSub}"]`)) {
                                    subSel.value = initialSub;
                                } else {
                                    populateSub(initialParent, initialSub);
                                    if (subSel.querySelector(`option[value="${initialSub}"]`)) subSel.value = initialSub;
                                }
                            }
                        } catch(e) {}
                    }, 60);
                }
            } catch (e) {
                // ignore
            }

            // fade success
            const success=document.getElementById('successBanner');
            if(success){
                setTimeout(()=>{
                    success.style.transition='opacity .6s';
                    success.style.opacity='0';
                    setTimeout(()=>success.remove(),800);
                },4000);
            }
        });

        // Submit handler (TinyMCE save)
        document.getElementById('detalleForm')?.addEventListener('submit',()=>{
            if(typeof tinymce!=='undefined'){tinymce.triggerSave();}
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}