@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Admin.Contenidos.DetalleModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Contenido" : "Nuevo Contenido";
    Layout = "_Layout";

    // Prepare grouped condition lists here so they are available in the template
    var parentsList = Model.AllCondiciones?.Where(x => x.padre == null).OrderBy(x => x.nombre).ToList() ?? new List<(int id, string nombre, int? padre)>();
    var childrenList = Model.AllCondiciones?.Where(x => x.padre != null).OrderBy(x => x.nombre).ToList() ?? new List<(int id, string nombre, int? padre)>();
    var childrenByParentMap = childrenList
        .Where(ch => ch.padre.HasValue && parentsList.Any(p => p.id == ch.padre.Value))
        .GroupBy(ch => ch.padre.Value)
        .ToDictionary(g => g.Key, g => g.ToList());
    var orphanChildrenList = childrenList
        .Where(ch => !ch.padre.HasValue || !parentsList.Any(p => p.id == ch.padre.Value))
        .ToList();
}
@section Styles {
    <style>
        /* ── Franja superior ── */
        .detalle-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: #fff;
            border: 1px solid #e8eef6;
            border-radius: 10px;
            padding: 10px 16px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .detalle-top-seo { flex: 1; min-width: 0; font-size: .9rem; }

        .detalle-top-nav { display: flex; gap: 8px; flex-shrink: 0; }

        /* ── Grid principal ── */
        .detalle-main-grid {
            display: grid;
            grid-template-columns: 1fr 280px 1fr;
            gap: 20px;
            align-items: start;
        }

        .detalle-col-form {
            background: #fff;
            border: 1px solid #e8eef6;
            border-radius: 10px;
            padding: 20px;
        }

        .detalle-col-gris {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .detalle-col-rel {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            align-items: start;
        }

        .detalle-rel-left,
        .detalle-rel-right {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* Renglón 2 ocupa col1+col2 */
        .detalle-row2 {
            grid-column: 1 / 3;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            align-items: start;
        }

        /* Renglón 3 full-width */
        .detalle-row3 {
            grid-column: 1 / -1;
            background: #fff;
            border: 1px solid #e8eef6;
            border-radius: 10px;
            padding: 14px 20px;
        }

        /* ── Responsive ── */
        @@media (max-width: 1400px) {
            .detalle-main-grid { grid-template-columns: 1fr 1fr; }
            .detalle-col-form  { grid-column: 1 / -1; }
            .detalle-col-gris  { grid-column: 1; }
            .detalle-col-rel   { grid-column: 2; }
            .detalle-row2,
            .detalle-row3      { grid-column: 1 / -1; }
        }

        @@media (max-width: 900px) {
            .detalle-main-grid { grid-template-columns: 1fr; }
            .detalle-col-form,
            .detalle-col-gris,
            .detalle-col-rel,
            .detalle-row2,
            .detalle-row3      { grid-column: 1 / -1; }
            .detalle-col-rel   { grid-template-columns: 1fr; }
            .detalle-row2      { grid-template-columns: 1fr; }
        }

        .gris-card {
            background: #fff;
            border: 1px solid #d9e3ec;
            border-radius: 10px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
        }

        .gris-aspecto-bar {
            height: 5px;
            border-radius: 3px;
            background: #e5e7eb;
            margin: 3px 0 2px;
            overflow: hidden;
        }

        .comparador-panel {
            background: #fff;
            border: 1px solid #d9e3ec;
            border-radius: 10px;
            padding: 16px 18px;
        }

        .comparador-panel h6 {
            font-size: 0.84rem;
            font-weight: 700;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 5px;
            margin-bottom: 10px;
        }

        .comp-item {
            background: #fafbfd;
            border: 1px solid #e1e7ef;
            border-radius: 6px;
            padding: 8px 10px;
            margin-bottom: 6px;
            font-size: 0.82rem;
        }

        .comp-item-title {
            font-weight: 600;
            color: #1a1a2e;
            display: block;
            margin-bottom: 2px;
        }

        .comp-item-motivo {
            color: #6b7280;
            font-size: 0.76rem;
        }

        .rel-box {
            background: #fff;
            border: 1px solid #d9e3ec;
            border-radius: 10px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
        }

            .rel-box h5 {
                font-size: 1rem;
                font-weight: 600;
                margin: 0 0 8px 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

        .rel-search-row {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 6px;
        }

            .rel-search-row input, .rel-search-row select {
                width: 100%;
                padding: 6px 8px;
                border: 1px solid #c9d6e6;
                border-radius: 6px;
                font-size: .85rem;
            }

        .rel-selected-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 72px;
            overflow-y: auto;
            padding: 2px 0;
        }

        .rel-badge-sel {
            background: #eef5ff;
            color: #24527a;
            border: 1px solid #c9d6e6;
            border-radius: 999px;
            padding: 3px 8px;
            font-size: .65rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* Principal category appearance */
        .rel-badge-sel.principal {
            background: #fff4e6; /* warm highlight */
            color: #9a5300;
            border-color: #ffd8b5;
        }

        .badge-principal {
            display: inline-block;
            background: #9a5300;
            color: #fff;
            font-size: 0.6rem;
            line-height: 1;
            padding: 2px 5px;
            border-radius: 999px;
            margin-left: 6px;
        }

            .rel-badge-sel button {
                background: transparent;
                border: 0;
                cursor: pointer;
                color: #24527a;
                padding: 0;
                font-size: .7rem;
                line-height: 1;
            }

        .rel-scroll {
            flex: 1 1 auto;
            min-height: 120px;
            max-height: 200px;
            overflow: auto;
            border: 1px solid #e1e7ef;
            border-radius: 6px;
            background: #fafbfd;
            padding: 6px;
        }

        .rel-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 6px;
            border-radius: 4px;
            font-size: .82rem;
            line-height: 1.2;
        }

            .rel-item:hover {
                background: #eef5ff;
            }

        .rel-empty {
            font-size: .72rem;
            color: #6a737c;
            padding: 4px;
        }

        /* Conditions grouping */
        .cond-parent {
            font-weight: 700;
            padding: 6px 4px;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cond-parent .parent-title {
                flex: 1;
            }

        .cond-children {
            padding-left: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .cond-group {
            margin-bottom: 6px;
            border-bottom: 1px dashed rgba(0,0,0,0.03);
            padding-bottom: 6px;
        }

        .cond-parent-checkbox {
            width: 18px;
            height: 18px;
            display: inline-block;
        }

        .seo-block {
            background: #f8f9fb;
            border: 1px solid #e1e7ef;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: .9rem;
        }

        .toggle-debug-btn {
            margin-bottom: 8px;
        }

        /* small inline slug status styles (span next to input) */
        .slug-status {
            margin-left: 10px;
            font-weight: 600;
            font-size: .85rem;
            vertical-align: middle;
        }

            .slug-status.ok {
                color: #198754;
            }
            /* bootstrap success */
            .slug-status.fail {
                color: #dc3545;
            }
        /* bootstrap danger */

    </style>
}

<div class="container my-4">
    <form method="post" asp-page-handler="Save" enctype="multipart/form-data" id="detalleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" id="contenidoIdHidden" />

        <div class="detalle-top-bar">
            <div class="detalle-top-seo">
                <strong>URL SEO pública:</strong>
                @if (!string.IsNullOrWhiteSpace(Model.SeoUrl))
                {
                    <a href="@Model.SeoUrl" target="_blank" rel="noopener noreferrer">@Model.SeoUrl</a>
                    // Show principal category (if available)
                    var pc = Model.PrincipalCategoryId.HasValue ? Model.CategoryItems.FirstOrDefault(c => c.Sequence == Model.PrincipalCategoryId.Value) : null;
                    if (pc != null)
                    {
                        var seg = !string.IsNullOrWhiteSpace(pc.CategoriaSlug) ? pc.CategoriaSlug.Trim('/') : pc.Sequence.ToString();
                        <div class="small text-muted mt-1">Categoría principal: <a href="/@seg" target="_blank">@pc.Nombre</a></div>
                    }
                }
                else
                {
                    <span class="text-muted">(Aún no disponible: slug vacío o contenido no relacionado)</span>
                }
            </div>
            <div class="detalle-top-nav">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.href='@Url.Page("/Admin/Contenidos/Contenidos", new { area = "Identity" })'">Regresar a Ver todos</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="window.open('/Identity/Admin/Contenidos/Detalle','_blank')">Agregar nuevo</button>
            </div>
        </div>

        <div class="detalle-main-grid">

            <div class="detalle-col-form">
                <h3>@ViewData["Title"]</h3>

                @if (!string.IsNullOrWhiteSpace(Model.DebugInfoHtml))
                {
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary toggle-debug-btn" id="btnToggleDebug">Mostrar debug</button>
                        <div id="debugBlock" style="display:none" class="mb-3">
                            <label class="form-label">DEBUG</label>
                            <pre class="debug">@Html.Raw(Model.DebugInfoHtml)</pre>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.WarningMessage))
                {
                    <div class="alert alert-warning">@Model.WarningMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div id="successBanner" class="alert alert-success text-center">@Model.SuccessMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label">Título</label>
                    <input class="form-control" asp-for="ContenidoTitulo" id="titulo" autocomplete="off" />
                </div>

                <div class="mb-3 d-flex align-items-center">
                    <div style="flex:1">
                        <label class="form-label">Slug</label>
                        <input class="form-control" asp-for="ContenidoTituloSlug" id="slug" autocomplete="off" />
                    </div>
                    <div style="margin-left:12px;">
                        <span id="slugStatus" class="slug-status" aria-live="polite"></span>
                    </div>
                </div>
                <small class="text-muted d-block mb-2">Se genera y valida en tiempo real. Puedes editarlo manualmente.</small>

                <div class="mb-3">
                    <label class="form-label">Resumen</label>
                    <textarea class="form-control" asp-for="ContenidoTextoC" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Contenido (HTML)</label>
                    <textarea class="form-control" asp-for="ContenidoTextoL" id="contenidoHtml" rows="15">@Html.Raw(Model.ContenidoTextoL)</textarea>
                </div>

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" asp-for="EstadoPublicacion">
                            <option value="0">Borrador</option>
                            <option value="1">Publicado</option>
                            <option value="2">Publicado y Pagina de Inicio</option>
                            <option value="3">Publicado y Popular</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Inicio</label>
                        <input type="datetime-local" class="form-control" asp-for="ContenidoFechaInicio" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fin</label>
                        <input type="datetime-local" class="form-control" asp-for="ContenidoFechaFin" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">País</label>
                        <select class="form-select" name="PaisClave" id="paisSelect">
                            <option value="">(Seleccionar país)</option>
                            @foreach (var p in Model.PaisesLista)
                            {
                                if (p.code == Model.PaisClave)
                                {
                                    <option value="@p.code" selected>@p.name (@p.code)</option>
                                }
                                else
                                {
                                    <option value="@p.code">@p.name (@p.code)</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 mt-3">
                    <div class="col-md-6">
                        <label class="form-label">Autor</label>
                        <select name="SelectedAutorId" id="SelectedAutorId" class="form-select">
                            <option value="">(Seleccionar autor)</option>
                            @foreach (var a in Model.AdminAuthors)
                            {
                                if (Model.SelectedAutorId == a.id)
                                {
                                    <option value="@a.id" selected>@a.name</option>
                                }
                                else
                                {
                                    <option value="@a.id">@a.name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Imagen principal</label>
                        <input type="file" class="form-control" name="UploadedImage" />
                        @if (!string.IsNullOrWhiteSpace(Model.URLImagenPrincipal))
                        {
                            <div class="mt-2">
                                <img src="~/uploads/contenidos/@Model.URLImagenPrincipal" style="max-width:220px;max-height:140px;" />
                            </div>
                        }
                    </div>
                </div>

            </div>

            <div class="detalle-col-gris" id="grisPanel">
                @if (Model.Id.HasValue)
                {
                    <div class="gris-card">
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:12px;">
                            <i class="bi bi-stars text-primary" style="font-size:1.05rem;"></i>
                            <span style="font-weight:600;font-size:0.9rem;">GRIS</span>
                            <span style="font-size:0.72rem;font-weight:400;color:#6b7280;">evaluación editorial</span>
                        </div>
                        <div id="grisResultadoDetalle">
                            @if (Model.GrisEvaluado && Model.GrisPuntajeGlobal.HasValue)
                            {
                                var gScore = Model.GrisPuntajeGlobal.Value;
                                var gBg = gScore >= 70 ? "success" : gScore >= 50 ? "warning" : "danger";
                                <div class="text-center mb-3">
                                    <span class="badge bg-@gBg" style="font-size:2rem;padding:10px 24px;">@gScore</span>
                                    <div class="text-muted mt-1" style="font-size:0.76rem;">Puntaje editorial (0-100)</div>
                                    @if (Model.GrisFechaEvaluacion.HasValue)
                                    {
                                        <div class="text-muted" style="font-size:0.72rem;">@Model.GrisFechaEvaluacion.Value.ToString("dd MMM yyyy") UTC</div>
                                    }
                                </div>
                                @if (Model.GrisAspectos != null && Model.GrisAspectos.Any())
                                {
                                    <div style="font-size:0.78rem;font-weight:600;color:#374151;border-bottom:1px solid #e5e7eb;padding-bottom:4px;margin-bottom:10px;">Aspectos</div>
                                    foreach (var a in Model.GrisAspectos)
                                    {
                                        var aBg = a.Puntaje >= 7 ? "success" : a.Puntaje >= 5 ? "warning" : "danger";
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span style="font-size:0.8rem;font-weight:600;">@a.Nombre</span>
                                                <span class="badge bg-@aBg" style="font-size:0.72rem;">@a.Puntaje/10</span>
                                            </div>
                                            <div class="gris-aspecto-bar">
                                                <div class="bg-@aBg" style="width:@(a.Puntaje * 10)%;height:100%;border-radius:3px;"></div>
                                            </div>
                                            <div style="font-size:0.76rem;color:#4b5563;margin-top:3px;line-height:1.4;">@a.Observacion</div>
                                        </div>
                                    }
                                }
                                @if (Model.GrisSugerencias != null && Model.GrisSugerencias.Any())
                                {
                                    <div style="font-size:0.78rem;font-weight:600;color:#374151;border-bottom:1px solid #e5e7eb;padding-bottom:4px;margin-bottom:8px;">Sugerencias</div>
                                    <ul style="font-size:0.78rem;color:#4b5563;padding-left:18px;line-height:1.5;margin-bottom:12px;">
                                        @foreach (var s in Model.GrisSugerencias)
                                        {
                                            <li>@s</li>
                                        }
                                    </ul>
                                }
                                <button class="btn btn-sm btn-outline-secondary w-100" onclick="evaluarConGrisDetalle(@Model.Id.Value)">
                                    <i class="bi bi-arrow-repeat me-1"></i>Re-evaluar con GRIS
                                </button>
                            }
                            else
                            {
                                <div class="text-muted mb-3" style="font-size:0.82rem;line-height:1.5;">
                                    Analiza la calidad editorial del artículo: claridad, utilidad, credibilidad, lenguaje, originalidad, engagement y SEO.
                                </div>
                                <button class="btn btn-sm btn-primary w-100" onclick="evaluarConGrisDetalle(@Model.Id.Value)">
                                    <i class="bi bi-stars me-1"></i>Evaluar con GRIS
                                </button>
                            }
                        </div>
                        <div id="grisSpinnerDetalle" style="display:none;" class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <div class="text-muted small mt-1">GRIS evaluando...</div>
                        </div>
                    </div>
                }
            </div>

            <div class="detalle-col-rel">
                <div class="detalle-rel-left">

                    <div class="rel-box">
                        <h5>Contenidos generales <span class="badge bg-light text-dark">@Model.AllGeneralContenidos.Count</span></h5>

                        <div class="rel-search-row">
                            <label class="form-label small mb-0">Filtrar por padre</label>
                            <select id="filterByParent" class="form-select">
                                <option value="">— Todos —</option>
                                @foreach (var p in Model.ParentCategories)
                                {
                                    <option value="@p.Sequence">@p.Nombre</option>
                                }
                            </select>

                            <input type="text" id="searchGeneralCont" placeholder="Filtrar por título..." autocomplete="off" />
                            <div id="generalContSelectedBadges" class="rel-selected-badges">
                                @foreach (var c in Model.AllGeneralContenidos.Where(x => Model.SelectedManualContenidoIds.Contains(x.Id)))
                                {
                                    <span class="rel-badge-sel" data-id="@c.Id">@c.Title <button type="button" class="badge-remove btn-close" data-target-name="SelectedManualContenidoIds" data-id="@c.Id" aria-label="Eliminar"></button></span>
                                }
                            </div>
                        </div>

                        <div class="rel-scroll" id="listGeneralCont" role="list">
                            @if (!Model.AllGeneralContenidos.Any())
                            {
                                <div class="rel-empty">Sin registros</div>
                            }
                            else
                            {
                                foreach (var c in Model.AllGeneralContenidos)
                                {
                                    var checkedAttr = Model.SelectedManualContenidoIds.Contains(c.Id) ? "checked" : "";
                                    var parentSeqAttr = c.ParentCategorySeq.HasValue ? c.ParentCategorySeq.Value.ToString() : "";
                                    <label class="rel-item" data-filter="@((c.Title ?? "").ToLowerInvariant())" data-parent="@parentSeqAttr" role="listitem">
                                        <input type="checkbox" name="SelectedManualContenidoIds" value="@c.Id" class="rel-check-generalcont" @checkedAttr />
                                        <span>@c.Title</span>
                                        @if (!string.IsNullOrEmpty(c.ParentCategoryName))
                                        {
                                            <small class="text-muted ms-2">· @c.ParentCategoryName</small>
                                        }
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <div class="rel-box">
                        <h5>Preguntas (con respuestas o votos) <span class="badge bg-light text-dark">@Model.AllPreguntasCandidate.Count</span></h5>
                        <div class="rel-search-row">
                            <input type="text" id="searchPreguntas" placeholder="Filtrar..." autocomplete="off" />
                            <div id="pregSelectedBadges" class="rel-selected-badges">
                                @foreach (var q in Model.AllPreguntasCandidate.Where(x => Model.SelectedManualPreguntasIds.Contains(x.id)))
                                {
                                    <span class="rel-badge-sel" data-id="@q.id">@q.title <button type="button" class="badge-remove" data-target-name="SelectedManualPreguntasIds" data-id="@q.id" aria-label="Quitar">✕</button></span>
                                }
                            </div>
                        </div>
                        <div class="rel-scroll" id="listPreguntas">
                            @if (!Model.AllPreguntasCandidate.Any())
                            {
                                <div class="rel-empty">Sin registros</div>
                            }
                            else
                            {
                                foreach (var q in Model.AllPreguntasCandidate)
                                {
                                    var checkedAttr = Model.SelectedManualPreguntasIds.Contains(q.id) ? "checked" : "";
                                    <label class="rel-item" data-filter="@((q.title ?? "").ToLowerInvariant())">
                                        <input type="checkbox" name="SelectedManualPreguntasIds" value="@q.id" class="rel-check-pregunta" @checkedAttr />
                                        <span>@q.title</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>

                </div>
                <div class="detalle-rel-right">
                    @if (Model.Id.HasValue)
                    {
                        <div class="rel-box" id="panelGrisCategorias"@(!Model.GrisEvaluado ? " style=\"display:none\"" : "")>
                            <h5 style="font-size:0.88rem;">
                                <span><i class="bi bi-stars text-primary me-1"></i>GRIS · Categorías</span>
                            </h5>
                            <div id="panelGrisCategoriasContent">
                                @if (Model.GrisEvaluado)
                                {
                                    @if (Model.GrisCategoriasAlerta != null && Model.GrisCategoriasAlerta.Any())
                                    {
                                        <div style="font-size:0.71rem;color:#dc2626;font-weight:600;margin-bottom:4px;">⚠ Posible mala clasificación</div>
                                        foreach (var ca in Model.GrisCategoriasAlerta)
                                        {
                                            <div style="margin-bottom:5px;">
                                                <span class="badge bg-danger-subtle text-danger-emphasis" style="font-size:0.68rem;">@ca.Nombre</span>
                                                <div style="font-size:0.67rem;color:#6b7280;margin-top:1px;">@ca.Razon</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="font-size:0.71rem;color:#16a34a;margin-bottom:4px;">✓ Categorización coherente</div>
                                    }
                                    @if (Model.GrisCategoriasSugeridas != null && Model.GrisCategoriasSugeridas.Any())
                                    {
                                        <div style="font-size:0.71rem;color:#6b7280;margin-bottom:3px;">Sugeridas (solo informativo):</div>
                                        <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                            @foreach (var cs in Model.GrisCategoriasSugeridas)
                                            {
                                                <span class="badge bg-primary-subtle text-primary-emphasis"
                                                      style="font-size:0.68rem;cursor:default;"
                                                      title="@cs.Razon">@cs.Nombre</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    <div class="rel-box">
                        <h5>Categorías seleccionadas <span class="badge bg-light text-dark">@Model.SelectedCategoryIds.Count</span></h5>
                    <div id="selectedCategoryBadges" class="rel-selected-badges mb-2">
                        @foreach (var seq in Model.SelectedCategoryIds)
                        {
                            var cat = Model.CategoryItems.FirstOrDefault(c => c.Sequence == seq);
                            if (cat != null)
                            {
                                var isPrincipal = Model.PrincipalCategoryId.HasValue && Model.PrincipalCategoryId.Value == cat.Sequence;
                                <span class="rel-badge-sel@(isPrincipal ? " principal" : "")" data-id="@cat.Sequence">@cat.Nombre
                                    @if (isPrincipal)
                                    {
                                        <span class="badge-principal">Principal</span>
                                    }
                                    <button type="button" class="badge-remove btn-close" data-target-name="SelectedCategoryIds" data-id="@cat.Sequence" aria-label="Eliminar"></button>
                                </span>
                            }
                        }
                    </div>
                    <div class="rel-search-row mb-2">
                        <input type="text" id="filterCategories" placeholder="Filtrar categorías..." autocomplete="off" />
                        @* Secondary container removed. JS will update the primary #selectedCategoryBadges to avoid duplicates. *@
                    </div>
                    <div class="rel-scroll" id="categoriesPanel">
                        @* Render grouped checkboxes here (parents with children) *@
                        @{
                            var parents = Model.CategoryItems.Where(ci => ci.CategoriaPadre == null).OrderBy(ci => ci.Nombre).ToList();
                            var children = Model.CategoryItems.Where(ci => ci.CategoriaPadre != null).OrderBy(ci => ci.Nombre).ToList();
                            var childrenByParent = children.GroupBy(c => c.CategoriaPadre).ToDictionary(g => g.Key, g => g.ToList());
                            var orphanChildren = children.Where(c => c.CategoriaPadre.HasValue && !parents.Any(p => p.Sequence == c.CategoriaPadre.Value)).ToList();
                        }
                        @foreach (var p in parents)
                        {
                            <div class="cond-group" data-filter="@p.Nombre.ToLowerInvariant()">
                                <div class="cond-parent">
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <input type="checkbox" name="SelectedCategoryIds" class="cat-parent-checkbox" id="cat_parent_@p.Sequence" data-seq="@p.Sequence" value="@p.Sequence" @(Model.SelectedCategoryIds.Contains(p.Sequence) ? "checked" : "") />
                                        <input type="radio" name="PrincipalCategoryId" value="@p.Sequence" @(Model.PrincipalCategoryId.HasValue && Model.PrincipalCategoryId.Value == p.Sequence ? "checked" : "") title="Marcar como principal" />
                                        <span class="parent-title ms-2">@p.Nombre</span>
                                    </div>
                                </div>
                                <div class="cond-children ms-3">
                                    @if (childrenByParent.TryGetValue(p.Sequence, out var chs))
                                    {
                                        foreach (var ch in chs)
                                        {
                                            <label class="rel-item" data-filter="@ch.Nombre.ToLowerInvariant()">
                                                <input type="checkbox" name="SelectedCategoryIds" class="cat-child-checkbox ms-1" data-parent="@p.Sequence" value="@ch.Sequence" @(Model.SelectedCategoryIds.Contains(ch.Sequence) ? "checked" : "") />
                                                <input type="radio" name="PrincipalCategoryId" value="@ch.Sequence" @(Model.PrincipalCategoryId.HasValue && Model.PrincipalCategoryId.Value == ch.Sequence ? "checked" : "") title="Marcar como principal" />
                                                <span class="ms-2">@ch.Nombre</span>
                                            </label>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        @if (orphanChildren.Any())
                        {
                            <div class="cond-group" data-filter="otras">
                                <div class="cond-parent"><strong>Otras categorías</strong></div>
                                <div class="cond-children ms-3">
                                    @foreach (var oc in orphanChildren)
                                    {
                                        <label class="rel-item" data-filter="@oc.Nombre.ToLowerInvariant()">
                                            <input type="checkbox" name="SelectedCategoryIds" class="cat-child-checkbox ms-1" value="@oc.Sequence" @(Model.SelectedCategoryIds.Contains(oc.Sequence) ? "checked" : "") />
                                            <input type="radio" name="PrincipalCategoryId" value="@oc.Sequence" @(Model.PrincipalCategoryId.HasValue && Model.PrincipalCategoryId.Value == oc.Sequence ? "checked" : "") title="Marcar como principal" />
                                            <span class="ms-2">@oc.Nombre</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                    @if (Model.Id.HasValue)
                    {
                        <div class="mb-2">
                            <button type="button" class="btn btn-sm btn-outline-info w-100" id="btnCompararRelacionados" onclick="compararRelacionados()">
                                <i class="bi bi-diagram-3 me-1"></i>Comparar artículos relacionados
                            </button>
                            <div id="spinnerComparar" style="display:none;" class="text-center py-1">
                                <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                                <span class="text-muted small ms-1">Analizando...</span>
                            </div>
                        </div>
                    }
                    @if (Model.Id.HasValue)
                    {
                        <div class="rel-box" id="panelSugerirRelacionados">
                            <h5><i class="bi bi-link-45deg text-primary me-1"></i>Sugerencias para relacionar</h5>
                            <div id="sugerirRelContent">
                                <div class="text-muted small text-center py-2">
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>Cargando...
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="detalle-row2">
                <div class="rel-box" id="panelCondiciones">
                    <h5>Condiciones <span class="badge bg-light text-dark">@Model.AllCondiciones.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchCondiciones" placeholder="Filtrar..." autocomplete="off" />
                        <div id="condSelectedBadges" class="rel-selected-badges">
                            @foreach (var c in Model.AllCondiciones.Where(x => Model.SelectedCondicionesIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@c.id">@c.nombre <button type="button" class="badge-remove" data-target-list="SelectedCondicionesIds" data-id="@c.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>

                    <div class="rel-scroll" id="listCondiciones" role="list">
                        @if (!Model.AllCondiciones.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            @* parents with their children *@
                            @foreach (var parent in parentsList)
                            {
                                <div class="cond-group" data-parent="@parent.id">
                                    <div class="cond-parent">
                                    <input type="checkbox" name="SelectedCondicionesIds" value="@parent.id" class="cond-parent-checkbox" data-parent-id="@parent.id" id="parentchk_@parent.id" @(Model.SelectedCondicionesIds.Contains(parent.id) ? "checked" : "") />
                                        <div class="parent-title">@parent.nombre</div>
                                    </div>
                                    <div class="cond-children">
                                        @{
                                            if (childrenByParentMap.TryGetValue(parent.id, out var chs) && chs.Any())
                                            {
                                                foreach (var ch in chs)
                                                {
                                                    var checkedAttr = Model.SelectedCondicionesIds.Contains(ch.id) ? "checked" : "";
                                                    <label class="rel-item" data-filter="@ch.nombre.ToLowerInvariant()">
                                                        <input type="checkbox" name="SelectedCondicionesIds" value="@ch.id" class="rel-check-condicion" @checkedAttr />
                                                        <span>@ch.nombre</span>
                                                    </label>
                                                }
                                            }
                                            else
                                            {
                                                <div class="rel-item rel-empty">No hay subcondiciones</div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @* orphan children under "Otros" *@
                            @if (orphanChildrenList.Any())
                            {
                                <div class="cond-group" data-parent="0">
                                    <div class="cond-parent">
                                        <input type="checkbox" class="cond-parent-checkbox" data-parent-id="0" id="parentchk_0" />
                                        <div class="parent-title">Otros</div>
                                    </div>
                                    <div class="cond-children">
                                        @foreach (var ch in orphanChildrenList)
                                        {
                                            var checkedAttr = Model.SelectedCondicionesIds.Contains(ch.id) ? "checked" : "";
                                            <label class="rel-item" data-filter="@ch.nombre.ToLowerInvariant()">
                                                <input type="checkbox" name="SelectedCondicionesIds" value="@ch.id" class="rel-check-condicion" @checkedAttr />
                                                <span>@ch.nombre</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box" id="panelTratamientos">
                    <h5>Tratamientos <span class="badge bg-light text-dark">@Model.AllTratamientos.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchTratamientos" placeholder="Filtrar..." autocomplete="off" />
                        <div id="tratSelectedBadges" class="rel-selected-badges">
                            @foreach (var t in Model.AllTratamientos.Where(x => Model.SelectedTratamientosIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@t.id">@t.nombre <button type="button" class="badge-remove" data-target-list="SelectedTratamientosIds" data-id="@t.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="listTratamientos">
                        @if (!Model.AllTratamientos.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var t in Model.AllTratamientos)
                            {
                                var checkedAttr = Model.SelectedTratamientosIds.Contains(t.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@t.nombre?.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedTratamientosIds" value="@t.id" class="rel-check-tratamiento" @checkedAttr />
                                    <span>@t.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <div class="rel-box" id="panelSintomas">
                    <h5>Síntomas <span class="badge bg-light text-dark">@Model.AllSintomas.Count</span></h5>
                    <div class="rel-search-row">
                        <input type="text" id="searchSintomas" placeholder="Filtrar..." autocomplete="off" />
                        <div id="sintSelectedBadges" class="rel-selected-badges">
                            @foreach (var s in Model.AllSintomas.Where(x => Model.SelectedSintomasIds.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@s.id">@s.nombre <button type="button" class="badge-remove" data-target-list="SelectedSintomasIds" data-id="@s.id" aria-label="Quitar">✕</button></span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="listSintomas">
                        @if (!Model.AllSintomas.Any())
                        {
                            <div class="rel-empty">Sin registros</div>
                        }
                        else
                        {
                            foreach (var s in Model.AllSintomas)
                            {
                                var checkedAttr = Model.SelectedSintomasIds.Contains(s.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@s.nombre?.ToLowerInvariant()">
                                    <input type="checkbox" name="SelectedSintomasIds" value="@s.id" class="rel-check-sintoma" @checkedAttr />
                                    <span>@s.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="detalle-row3">
                @if (Model.Id.HasValue)
                {
                    <div id="resultadoComparar" class="comparador-panel mb-3" style="display:none;"></div>
                }
                <div class="text-end">
                    <a class="btn btn-secondary me-2" href="@Url.Page("./Index")">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="btnGuardar">Guardar</button>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/c1xlulcw2ayqu8bq58edh8qjshj6yruj6g2linjofz9rw369/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
    // Category selection UX: when a child is checked, auto-check parent; when parent toggled, toggle children
    (function () {
        function toggleParentForChild(childEl) {
            var parentId = childEl.dataset.parent;
            if (!parentId) return;
            var parentCheckbox = document.querySelector('#cat_parent_' + parentId);
            if (!parentCheckbox) return;
            if (childEl.checked) parentCheckbox.checked = true;
            else {
                // if no other child checked, uncheck parent
                var siblings = document.querySelectorAll('.cond-child-checkbox[data-parent="' + parentId + '"]');
                var any = false;
                siblings.forEach(s => { if (s.checked) any = true; });
                if (!any) parentCheckbox.checked = false;
            }
        }

        // wire category child/parent checkboxes
        document.querySelectorAll('.cat-child-checkbox').forEach(ch => {
            ch.addEventListener('change', function () { toggleParentForChild(ch); updateSelectedBadges(); });
        });
        document.querySelectorAll('.cat-parent-checkbox').forEach(pc => {
            pc.addEventListener('change', function () {
                var pid = pc.getAttribute('data-seq');
                var children = document.querySelectorAll('.cat-child-checkbox[data-parent="' + pid + '"]');
                children.forEach(c => { c.checked = pc.checked; });
                updateSelectedBadges();
            });
        });

        // legacy conditioners handled above
    })();

    // Principal radio: ensure principal is always part of SelectedCategoryIds when selected
    document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (e.target.name === 'PrincipalCategoryId' && e.target.type === 'radio') {
            var val = e.target.value;
            if (!val) return;
            var chk = document.querySelector('input[name="SelectedCategoryIds"][value="' + CSS.escape(val) + '"]');
            if (chk && !chk.checked) {
                chk.checked = true;
                chk.dispatchEvent(new Event('change'));
            }
        }
    });

    function updateSelectedBadges(){
        var container = document.getElementById('selectedCategoryBadgesContainer');
        if(!container) return;
        var checks = document.querySelectorAll('input[name="SelectedCategoryIds"]:checked');
        var principalRadio = document.querySelector('input[name="PrincipalCategoryId"]:checked');
        var principalVal = principalRadio ? principalRadio.value : null;
        container.innerHTML = '';
        checks.forEach(ch => {
            var id = ch.value;
            var label = ch.nextElementSibling ? ch.nextElementSibling.textContent.trim() : id;
            var span = document.createElement('span');
            var isPrincipal = (principalVal && String(principalVal) === String(id));
            span.className = 'rel-badge-sel' + (isPrincipal ? ' principal' : '');
            span.dataset.id = id;
            // build inner HTML: label, optional principal badge, remove button
            span.innerHTML = '';
            var textNode = document.createTextNode(label + ' ');
            span.appendChild(textNode);
            if (isPrincipal) {
                var bp = document.createElement('span');
                bp.className = 'badge-principal';
                bp.textContent = 'Principal';
                span.appendChild(bp);
            }
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'badge-remove btn-close'; btn.dataset.id = id; btn.setAttribute('data-target-name','SelectedCategoryIds'); btn.setAttribute('aria-label','Eliminar'); btn.innerHTML = '';
            span.appendChild(btn);
            container.appendChild(span);
        });
    }

    // Initial badges populate
    updateSelectedBadges();
        // ---------- TinyMCE (WYSIWYG) ----------
        tinymce.init({
            selector:'#contenidoHtml',
            height:520,
            menubar:'file edit view insert format tools table help',
            plugins:'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount fullscreen preview code advlist autoresize autosave',
            toolbar:'undo redo | blocks | bold italic underline strikethrough forecolor backcolor removeformat | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media table | charmap emoticons | blockquote codesample | fullscreen preview code',
            toolbar_mode:'wrap',
            branding:false,
            promotion:false,
            statusbar:true,
            autosave_interval:'30s',
            autosave_retention:'10m',
            image_caption:true,
            convert_urls:false,
            default_link_target:'_blank',
            content_style:'body { font-family: system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial,sans-serif; font-size:14px; }',
            images_upload_handler:(blobInfo)=>new Promise((resolve,reject)=>{
                try{resolve("data:"+blobInfo.blob().type+";base64,"+blobInfo.base64());}catch(e){reject('Error imagen: '+e);}
            }),
            setup:(ed)=>ed.on('change keyup undo redo',()=>ed.save())
        });

        // ---------- Slug logic with visual feedback on the input ----------
        const tituloInput=document.getElementById('titulo');
        const slugInput=document.getElementById('slug');
        const slugStatus=document.getElementById('slugStatus');
        const contenidoId=document.getElementById('contenidoIdHidden')?.value;
        let slugDirty=false, slugTimer=null, lastValidated='';

        function slugify(text){
            if(!text) return '';
            return text.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
                .replace(/[^a-z0-9\s-]/g,'')
                .trim().replace(/\s+/g,'-')
                .replace(/-+/g,'-');
        }
        function applySlugAuto(){
            if(!slugDirty){
                slugInput.value=slugify(tituloInput.value);
            }
        }
        function setSlugStatus(state){
            // clear previous classes
            slugStatus.className = 'slug-status';
            if(slugInput){
                slugInput.classList.remove('is-valid','is-invalid');
                slugInput.removeAttribute('aria-invalid');
            }

            if(state === 'ok'){
                slugStatus.textContent = 'aprobado';
                slugStatus.classList.add('ok');
                if(slugInput) slugInput.classList.add('is-valid');
            } else if(state === 'fail'){
                slugStatus.textContent = 'rechazado';
                slugStatus.classList.add('fail');
                if(slugInput){
                    slugInput.classList.add('is-invalid');
                    slugInput.setAttribute('aria-invalid','true');
                }
            } else if(state === 'error'){
                slugStatus.textContent = 'error';
                slugStatus.classList.add('fail');
                if(slugInput){
                    slugInput.classList.add('is-invalid');
                    slugInput.setAttribute('aria-invalid','true');
                }
            } else {
                slugStatus.textContent = '';
            }
        }
        function validateSlug(){
            const val=(slugInput.value||'').trim();
            if(val.length===0){ setSlugStatus(''); return; }
            if(val===lastValidated) return;
            lastValidated=val;
            const url=`${location.pathname}?handler=CheckSlug&slug=${encodeURIComponent(val)}${contenidoId? '&id='+contenidoId:''}`;
            fetch(url,{headers:{'Accept':'application/json'}})
                .then(r=>r.json())
                .then(j=>{
                    if(!j || typeof j.ok === 'undefined'){ setSlugStatus('error'); return; }
                    setSlugStatus(j.exists ? 'fail' : 'ok');
                })
                .catch(()=>setSlugStatus('error'));
        }
        tituloInput?.addEventListener('input',()=>{
            applySlugAuto();
            clearTimeout(slugTimer);
            slugTimer=setTimeout(validateSlug,300);
        });
        slugInput?.addEventListener('input',()=>{
            slugDirty=true;
            clearTimeout(slugTimer);
            slugTimer=setTimeout(validateSlug,250);
        });
        if(tituloInput){ applySlugAuto(); validateSlug(); }

        // ---------- Categories dynamic ----------
        const categories=@Html.Raw(JsonSerializer.Serialize(Model.CategoryItems.Select(c => new { seq = c.Sequence, parent = c.CategoriaPadre, name = c.Nombre })));
        const parentSel=document.getElementById('categoriaPadre');
        const subSel=document.getElementById('subcategoria');

        function populateSub(parentId, selectedValue){
            if(!subSel){return;}
            subSel.innerHTML='<option value="">(Seleccionar subcategoría)</option>';
            if(!parentId){return;}
            categories.filter(c => c.parent !== null && String(c.parent) === String(parentId))
                .forEach(c=>{
                    const opt=document.createElement('option');
                    opt.value=c.seq;
                    opt.textContent=c.name;
                    if(selectedValue && String(selectedValue)===String(c.seq)) opt.selected=true;
                    subSel.appendChild(opt);
                });
        }
        parentSel?.addEventListener('change',()=>{
            subSel.value='';
            populateSub(parentSel.value,null);
        });
        // Initialize with Model values (not DOM values, to avoid timing issues)
        const initialParentRaw = '@(Model.IdCategoriaPadre?.ToString() ?? "")';
        const initialSubRaw = '@(Model.IdCategoria?.ToString() ?? "")';
        const initialParent = initialParentRaw ? initialParentRaw.toString().trim() : '';
        const initialSub = initialSubRaw ? initialSubRaw.toString().trim() : '';
        // Try to initialize selects immediately (script is at bottom so elements exist)
        try {
            if (initialParent) {
                if (parentSel) parentSel.value = initialParent;
                populateSub(initialParent, initialSub);
                if (initialSub && subSel) subSel.value = initialSub;
            } else if (initialSub) {
                // If server provided only the subcategory, infer its parent from the categories list
                const found = categories.find(c => String(c.seq) === String(initialSub));
                const inferredParent = found && found.parent ? String(found.parent) : '';
                if (inferredParent && parentSel) {
                    parentSel.value = inferredParent;
                }
                populateSub(inferredParent || initialParent, initialSub);
                if (initialSub && subSel) subSel.value = initialSub;
            }
            // Also preselect sub if present (populateSub will mark it)
        } catch(e) { /* ignore */ }

        // Debug: log initial values and selects state
        try {
            console.debug('DETALLE: initialParent=', initialParent, 'initialSub=', initialSub);
            console.debug('DETALLE: categories=', categories);
            console.debug('DETALLE: parentSel value=', parentSel ? parentSel.value : null);
            console.debug('DETALLE: subSel value=', subSel ? subSel.value : null);
        } catch (e) { /* ignore */ }

        // ---------- Filters & badges ----------
        const searchInput = document.getElementById('searchGeneralCont');
        const parentSelect = document.getElementById('filterByParent');
        const list = document.getElementById('listGeneralCont');

        function applyGeneralFilter() {
            const q = (searchInput && searchInput.value || '').trim().toLowerCase();
            const parent = (parentSelect && parentSelect.value) || '';

            if (!list) return;
            const items = list.querySelectorAll('.rel-item');
            items.forEach(item => {
                const text = (item.getAttribute('data-filter') || '').toLowerCase();
                const itemParent = (item.getAttribute('data-parent') || '');
                const matchText = !q || text.indexOf(q) !== -1;
                const matchParent = !parent || itemParent === parent;
                item.style.display = (matchText && matchParent) ? '' : 'none';
            });
        }

        if (searchInput) searchInput.addEventListener('input', applyGeneralFilter);
        if (parentSelect) parentSelect.addEventListener('change', applyGeneralFilter);

        function initFilter(inputId,listId){
            const input=document.getElementById(inputId);
            const list=document.getElementById(listId);
            if(!input||!list)return;
            input.addEventListener('input',()=>{
                const term=input.value.trim().toLowerCase();

                if(listId === 'listCondiciones') {
                    const groups = list.querySelectorAll('.cond-group');
                    groups.forEach(g=>{
                        let anyVisible = false;
                        const children = g.querySelectorAll('.rel-item');
                        children.forEach(item=>{
                            const txt = (item.getAttribute('data-filter')||'').toLowerCase();
                            const visible = term==='' || txt.includes(term);
                            item.style.display = visible ? '' : 'none';
                            if(visible) anyVisible = true;
                        });
                        const header = g.querySelector('.cond-parent');
                        if(header) header.style.display = anyVisible ? '' : 'none';
                    });
                    updateAllParentCheckboxStates();
                } else {
                    list.querySelectorAll('.rel-item').forEach(item=>{
                        const txt=item.getAttribute('data-filter')||'';
                        item.style.display=term===''||txt.includes(term)?'':'none';
                    });
                }
            });
        }

        initFilter('searchPreguntas','listPreguntas');
        initFilter('searchCondiciones','listCondiciones');
        initFilter('searchSintomas','listSintomas');
        initFilter('searchTratamientos','listTratamientos');

        function refreshBadges(containerId, checkboxSelector){
            const container=document.getElementById(containerId);
            if(!container)return;
            const checks=document.querySelectorAll(checkboxSelector);
            const fr=document.createDocumentFragment();
            checks.forEach(ch=>{
                if(ch.checked){
                    const span=document.createElement('span');
                    span.className='rel-badge-sel';
                    span.dataset.id=ch.value;
                    const labelText = (ch.nextElementSibling && ch.nextElementSibling.textContent) ? ch.nextElementSibling.textContent.trim() : ch.value;
                    span.textContent = labelText + ' ';
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'badge-remove';
                    btn.dataset.id = ch.value;
                    btn.setAttribute('data-target-list', ch.name);
                    btn.innerHTML = '✕';
                    span.appendChild(btn);
                    fr.appendChild(span);
                }
            });
            container.innerHTML='';
            container.appendChild(fr);
        }

        function attachBadgeEvents(){
            document.addEventListener('change',e=>{
                if(e.target.matches('.rel-check-generalcont')){
                    refreshBadges('generalContSelectedBadges','.rel-check-generalcont');
                }else if(e.target.matches('.rel-check-pregunta')){
                    refreshBadges('pregSelectedBadges','.rel-check-pregunta');
                }else if(e.target.matches('.rel-check-condicion') || e.target.matches('.cond-parent-checkbox')){
                    // include parent checkboxes (standalone parents without children)
                    refreshBadges('condSelectedBadges','.rel-check-condicion, .cond-parent-checkbox');
                    const parentGroup = e.target.closest('.cond-group');
                    if(parentGroup) updateParentCheckboxState(parentGroup);
                }else if(e.target.matches('.rel-check-sintoma')){
                    refreshBadges('sintSelectedBadges','.rel-check-sintoma');
                }else if(e.target.matches('.rel-check-tratamiento')){
                    refreshBadges('tratSelectedBadges','.rel-check-tratamiento');
                }
            });
            document.addEventListener('click',e=>{
                const btn=e.target.closest('.badge-remove');
                if(!btn)return;
                const id=btn.getAttribute('data-id');
                const name = btn.getAttribute('data-target-list');
                if(name){
                    const ck = document.querySelector(`input[name="${name}"][value="${CSS.escape(id)}"]`);
                    if(ck){ ck.checked=false; ck.dispatchEvent(new Event('change')); return; }
                }
                const ck2 = document.querySelector(`input[value="${CSS.escape(id)}"]`);
                if(ck2){ ck2.checked=false; ck2.dispatchEvent(new Event('change')); }
            });
        }
        attachBadgeEvents();
        refreshBadges('generalContSelectedBadges','.rel-check-generalcont');
        refreshBadges('pregSelectedBadges','.rel-check-pregunta');
        refreshBadges('condSelectedBadges','.rel-check-condicion');
        refreshBadges('sintSelectedBadges','.rel-check-sintoma');
        refreshBadges('tratSelectedBadges','.rel-check-tratamiento');

        // Parent checkbox behaviour
        function updateParentCheckboxState(parentGroup){
            if(!parentGroup) return;
            const parentCheckbox = parentGroup.querySelector('.cond-parent-checkbox');
            const childChecks = Array.from(parentGroup.querySelectorAll('.rel-check-condicion'));
            if (!parentCheckbox) return;

            // If there are no child checkboxes, treat the parent as a standalone selectable item
            if (childChecks.length === 0) {
                parentCheckbox.indeterminate = false;
                // Keep the checked state as-is (server may have preselected it)
                return;
            }

            const allChecked = childChecks.every(ch => ch.checked);
            const noneChecked = childChecks.every(ch => !ch.checked);
            parentCheckbox.checked = allChecked;
            parentCheckbox.indeterminate = (!allChecked && !noneChecked);
        }

        function updateAllParentCheckboxStates(){
            document.querySelectorAll('.cond-group').forEach(g => updateParentCheckboxState(g));
        }

        function wireUpParentCheckboxes(){
            document.querySelectorAll('.cond-parent-checkbox').forEach(cb => {
                const parentId = cb.getAttribute('data-parent-id');
                const parentGroup = cb.closest(`.cond-group[data-parent="${parentId}"]`);
                updateParentCheckboxState(parentGroup);

                cb.addEventListener('change', function(e){
                    const checked = !!this.checked;
                    const parentId = this.getAttribute('data-parent-id');
                    const group = this.closest(`.cond-group[data-parent="${parentId}"]`);
                    if(!group) return;
                    const childChecks = Array.from(group.querySelectorAll('.rel-check-condicion'));
                    // If there are child checkboxes, propagate the parent's state to them.
                    if (childChecks.length > 0) {
                        childChecks.forEach(ch => {
                            ch.checked = checked;
                            ch.dispatchEvent(new Event('change'));
                        });
                    }
                    updateParentCheckboxState(group);
                });
            });
        }

        // Debug toggle
        document.addEventListener('DOMContentLoaded', function(){
            const btnDbg = document.getElementById('btnToggleDebug');
            const dbgBlock = document.getElementById('debugBlock');
            if(btnDbg && dbgBlock){
                btnDbg.addEventListener('click', function(){
                    if(dbgBlock.style.display === 'none' || dbgBlock.style.display === ''){
                        dbgBlock.style.display = 'block';
                        btnDbg.textContent = 'Ocultar debug';
                    } else {
                        dbgBlock.style.display = 'none';
                        btnDbg.textContent = 'Mostrar debug';
                    }
                });
            }

            wireUpParentCheckboxes();
            updateAllParentCheckboxStates();

            // Ensure category parent/subcategory UI reflects server-side selection
            try {
                if (initialParent && parentSel) {
                    parentSel.value = initialParent;
                    populateSub(initialParent, initialSub);
                }
                // Preselect country based on server model
                const paisSelect = document.querySelector('select[name="PaisClave"]');
                const initialPais = '@(Model.PaisClave ?? "")';
                if (paisSelect && initialPais) {
                    paisSelect.value = initialPais;
                }
                // Ensure the parent option is visibly selected and populate subcategories
                if (parentSel) {
                    const opt = parentSel.querySelector(`option[value="${initialParent}"]`);
                    if (opt) opt.selected = true;
                    if (initialParent) parentSel.value = initialParent;
                    // Trigger change to populate subcategories; populateSub will select sub if present
                    parentSel.dispatchEvent(new Event('change'));
                    // After a short delay ensure subSel gets selected (timing race with populateSub)
                    setTimeout(()=>{
                        try {
                            if (initialSub && subSel) {
                                // If subSel has options, set selected; otherwise repopulate and set
                                if (subSel.querySelector(`option[value="${initialSub}"]`)) {
                                    subSel.value = initialSub;
                                } else {
                                    populateSub(initialParent, initialSub);
                                    if (subSel.querySelector(`option[value="${initialSub}"]`)) subSel.value = initialSub;
                                }
                            }
                        } catch(e) {}
                    }, 60);
                }
            } catch (e) {
                // ignore
            }

            // fade success
            const success=document.getElementById('successBanner');
            if(success){
                setTimeout(()=>{
                    success.style.transition='opacity .6s';
                    success.style.opacity='0';
                    setTimeout(()=>success.remove(),800);
                },4000);
            }

            cargarSugerirRelacionados();
        });

        // Submit handler (TinyMCE save)
        document.getElementById('detalleForm')?.addEventListener('submit',()=>{
            if(typeof tinymce!=='undefined'){tinymce.triggerSave();}
        });

        // ── GRIS — Evaluación editorial ────────────────────────────────────
        async function evaluarConGrisDetalle(id) {
            const spinner = document.getElementById('grisSpinnerDetalle');
            const result  = document.getElementById('grisResultadoDetalle');
            const btns    = document.querySelectorAll('#grisPanel button');
            btns.forEach(b => b.disabled = true);
            spinner.style.display = 'block';
            result.style.display  = 'none';

            try {
                const fd = new FormData();
                const tokenEl = document.querySelector('[name="__RequestVerificationToken"]');
                if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);
                fd.append('id', id);

                const res = await fetch('?handler=EvaluarGris', { method: 'POST', body: fd });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                renderGrisDetalle(data, id, result);
            } catch (e) {
                result.innerHTML =
                    '<div class="alert alert-danger py-2 small">' +
                    '<i class="bi bi-exclamation-triangle me-1"></i>' + (e.message || 'Error desconocido') + '</div>' +
                    '<button class="btn btn-sm btn-outline-secondary w-100 mt-1" onclick="evaluarConGrisDetalle(' + id + ')">' +
                    '<i class="bi bi-arrow-repeat me-1"></i>Reintentar</button>';
            } finally {
                spinner.style.display = 'none';
                result.style.display  = 'block';
                btns.forEach(b => b.disabled = false);
            }
        }

        function escGd(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Sugerencias para relacionar (similitud de texto) ─────────────────
        function cargarSugerirRelacionados() {
            var contenidoId = @(Model.Id ?? 0);
            if (!contenidoId) return;
            var fd = new FormData();
            var tok = document.querySelector('[name="__RequestVerificationToken"]');
            if (tok) fd.append('__RequestVerificationToken', tok.value);
            fd.append('id', contenidoId);
            fetch('?handler=SugerirRelacionados', { method: 'POST', body: fd })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var el = document.getElementById('sugerirRelContent');
                    if (!el) return;
                    if (!data.ok || !data.items || !data.items.length) {
                        el.innerHTML = '<div class="text-muted small text-center py-2">Sin sugerencias disponibles</div>';
                        return;
                    }
                    var html = '';
                    data.items.forEach(function(item) {
                        html += '<div class="d-flex align-items-center gap-1 mb-2">' +
                            '<span style="font-size:0.78rem;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + escGd(item.titulo) + '">' + escGd(item.titulo) + '</span>' +
                            '<span class="badge bg-secondary-subtle text-secondary-emphasis" style="font-size:0.7rem;white-space:nowrap;">' + item.pct + '%</span>' +
                            '<button type="button" class="btn btn-sm btn-outline-success" style="font-size:0.72rem;padding:1px 7px;flex-shrink:0;" onclick="relacionarSugerido(' + item.id + ')" title="Agregar a relacionados">&#x2795;</button>' +
                            '</div>';
                    });
                    el.innerHTML = html;
                })
                .catch(function() {
                    var el = document.getElementById('sugerirRelContent');
                    if (el) el.innerHTML = '<div class="text-danger small text-center">Error al cargar</div>';
                });
        }

        function relacionarSugerido(id) {
            var chk = document.querySelector('input[name="SelectedManualContenidoIds"][value="' + id + '"]');
            if (chk && !chk.checked) {
                chk.checked = true;
                chk.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }

        // ── Comparador de artículos relacionados ──────────────────────────────
        async function compararRelacionados() {
            const btn = document.getElementById('btnCompararRelacionados');
            const spinner = document.getElementById('spinnerComparar');
            const panel = document.getElementById('resultadoComparar');
            if (!btn || !panel) return;

            btn.disabled = true;
            spinner.style.display = 'block';
            panel.style.display = 'none';

            try {
                const fd = new FormData();
                const tok = document.querySelector('[name="__RequestVerificationToken"]');
                if (tok) fd.append('__RequestVerificationToken', tok.value);
                fd.append('id', '@(Model.Id?.ToString() ?? "")');

                const res = await fetch('?handler=CompararRelacionados', { method: 'POST', body: fd });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                if (!data.ok) throw new Error(data.error || 'Error al comparar');

                renderComparacion(data, panel);
            } catch (e) {
                panel.innerHTML = '<div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>' + escGd(e.message) + '</div>';
            } finally {
                spinner.style.display = 'none';
                panel.style.display = 'block';
                btn.disabled = false;
            }
        }

        function renderComparacion(data, panel) {
            var catList = data.porCategoria || [];
            var simList = data.porSimilitud || [];

            function renderItem(item, withScore) {
                var scoreHtml = '';
                if (withScore && typeof item.score !== 'undefined') {
                    var pct = Math.round(item.score * 100);
                    var cls = pct >= 50 ? 'success' : pct >= 25 ? 'warning' : 'secondary';
                    scoreHtml = ' <span class="badge bg-' + cls + ' ms-1">' + pct + '%</span>';
                }
                return '<div class="comp-item">' +
                    '<span class="comp-item-title">' + escGd(item.titulo) + scoreHtml + '</span>' +
                    '<span class="comp-item-motivo">' + escGd(item.motivo) + '</span>' +
                    (item.url ? ' &nbsp;<a href="' + escGd(item.url) + '" target="_blank" class="text-primary small text-decoration-none">editar →</a>' : '') +
                    '</div>';
            }

            var html = '<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">' +
                '<i class="bi bi-diagram-3 text-info" style="font-size:1rem;"></i>' +
                '<span style="font-weight:700;font-size:0.9rem;">Comparación de artículos relacionados</span>' +
                '<span style="font-size:0.75rem;color:#6b7280;">(diagnóstico — no modifica el frontend)</span>' +
                '</div>';
            html += '<div class="row g-3">';

            // Col 1: por categoría
            html += '<div class="col-md-6">';
            html += '<h6><i class="bi bi-tag me-1"></i>Por categoría (método actual)</h6>';
            if (catList.length === 0) {
                html += '<div class="text-muted small">Sin resultados — artículo sin categorías asignadas.</div>';
            } else {
                catList.forEach(function(item) { html += renderItem(item, false); });
            }
            html += '</div>';

            // Col 2: por similitud
            html += '<div class="col-md-6">';
            html += '<h6><i class="bi bi-search me-1"></i>Por similitud de texto</h6>';
            if (simList.length === 0) {
                html += '<div class="text-muted small">Sin resultados con similitud suficiente.</div>';
            } else {
                simList.forEach(function(item) { html += renderItem(item, true); });
            }
            html += '</div>';

            html += '</div>';
            panel.innerHTML = html;
        }

        function renderGrisDetalle(data, id, container) {
            if (!data.ok) {
                container.innerHTML =
                    '<div class="alert alert-warning py-2 small">' + escGd(data.error || 'Error al evaluar') + '</div>' +
                    '<button class="btn btn-sm btn-outline-secondary w-100 mt-1" onclick="evaluarConGrisDetalle(' + id + ')">' +
                    '<i class="bi bi-arrow-repeat me-1"></i>Reintentar</button>';
                return;
            }
            const p  = data.puntajeGlobal;
            const bg = p >= 70 ? 'success' : p >= 50 ? 'warning' : 'danger';
            let html = '<div class="text-center mb-2">' +
                '<span class="badge bg-' + bg + '" style="font-size:1.5rem;padding:8px 18px;">' + p + '</span>' +
                '<div class="text-muted" style="font-size:0.74rem;">Puntaje editorial (0-100)</div></div>';

            (data.aspectos || []).forEach(function(a) {
                const aBg = a.puntaje >= 7 ? 'success' : a.puntaje >= 5 ? 'warning' : 'danger';
                html += '<div style="margin-bottom:8px;">' +
                    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;">' +
                    '<span style="font-size:0.74rem;font-weight:600;">' + escGd(a.nombre) + '</span>' +
                    '<span class="badge bg-' + aBg + '" style="font-size:0.68rem;">' + a.puntaje + '/10</span></div>' +
                    '<div class="progress" style="height:4px;border-radius:2px;">' +
                    '<div class="progress-bar bg-' + aBg + '" style="width:' + (a.puntaje * 10) + '%;"></div></div>' +
                    '<div style="font-size:0.69rem;color:#6b7280;margin-top:2px;">' + escGd(a.observacion) + '</div></div>';
            });

            // Categorías
            html += '<hr style="margin:8px 0;"/>' +
                '<div style="font-size:0.73rem;font-weight:600;color:#374151;margin-bottom:4px;">' +
                '<i class="bi bi-tag me-1 text-primary"></i>Categorías</div>';
            const alts = data.categoriasAlerta || [];
            if (alts.length > 0) {
                html += '<div style="font-size:0.71rem;color:#dc2626;font-weight:600;margin-bottom:3px;">⚠ Posible mala clasificación</div>';
                alts.forEach(function(c) {
                    html += '<div style="margin-bottom:4px;">' +
                        '<span class="badge bg-danger-subtle text-danger-emphasis" style="font-size:0.68rem;">' + escGd(c.nombre) + '</span>' +
                        '<div style="font-size:0.67rem;color:#6b7280;margin-top:1px;">' + escGd(c.razon) + '</div></div>';
                });
            } else {
                html += '<div style="font-size:0.71rem;color:#16a34a;margin-bottom:4px;">✓ Categorías coherentes</div>';
            }
            const sugs = data.categoriasSugeridas || [];
            if (sugs.length > 0) {
                html += '<div style="font-size:0.71rem;color:#6b7280;margin-bottom:3px;">Sugeridas:</div>' +
                    '<div style="display:flex;flex-wrap:wrap;gap:3px;margin-bottom:4px;">';
                sugs.forEach(function(c) {
                    html += '<span class="badge bg-primary-subtle text-primary-emphasis" style="font-size:0.67rem;" title="' + escGd(c.razon) + '">' + escGd(c.nombre) + '</span>';
                });
                html += '</div>';
            }

            html += '<button class="btn btn-sm btn-outline-secondary w-100 mt-2" onclick="evaluarConGrisDetalle(' + id + ')">' +
                '<i class="bi bi-arrow-repeat me-1"></i>Re-evaluar con GRIS</button>';
            container.innerHTML = html;

            // Sync aside categories panel
            var asideCatPanel = document.getElementById('panelGrisCategorias');
            var asideCatContent = document.getElementById('panelGrisCategoriasContent');
            if (asideCatPanel && asideCatContent) {
                asideCatPanel.style.display = '';
                var alts2 = data.categoriasAlerta || [];
                var sugs2 = data.categoriasSugeridas || [];
                var catAsideHtml = '';
                if (alts2.length > 0) {
                    catAsideHtml += '<div style="font-size:0.71rem;color:#dc2626;font-weight:600;margin-bottom:4px;">⚠ Posible mala clasificación</div>';
                    alts2.forEach(function(c) {
                        catAsideHtml += '<div style="margin-bottom:5px;"><span class="badge bg-danger-subtle text-danger-emphasis" style="font-size:0.68rem;">' + escGd(c.nombre) + '</span><div style="font-size:0.67rem;color:#6b7280;margin-top:1px;">' + escGd(c.razon) + '</div></div>';
                    });
                } else {
                    catAsideHtml += '<div style="font-size:0.71rem;color:#16a34a;margin-bottom:4px;">✓ Categorización coherente</div>';
                }
                if (sugs2.length > 0) {
                    catAsideHtml += '<div style="font-size:0.71rem;color:#6b7280;margin-bottom:3px;">Sugeridas (solo informativo):</div><div style="display:flex;flex-wrap:wrap;gap:4px;">';
                    sugs2.forEach(function(c) {
                        catAsideHtml += '<span class="badge bg-primary-subtle text-primary-emphasis" style="font-size:0.68rem;cursor:default;" title="' + escGd(c.razon) + '">' + escGd(c.nombre) + '</span>';
                    });
                    catAsideHtml += '</div>';
                }
                asideCatContent.innerHTML = catAsideHtml;
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}