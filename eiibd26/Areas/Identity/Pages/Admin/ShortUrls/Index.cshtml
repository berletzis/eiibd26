@page
@model eiibd26.Areas.Identity.Pages.Admin.ShortUrls.IndexModel
@{
    ViewData["Title"] = "Short URLs";
}

@section Styles {
<style>
    .su-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(40,60,120,.08); padding: 28px 30px; margin-bottom: 28px; border: 1px solid #dde6f1; }
    #suTable th { background: #eef4fa; color: #3d436c; font-weight: 600; }
    #suTable td { vertical-align: middle; }
    .badge-clicks { background: #e8f4ff; color: #1a6db5; font-weight: 600; border-radius: 20px; padding: 3px 10px; font-size: .88em; }
</style>
}

<div class="eii-page eii-page--wide">
    <h2 class="eii-page-title eii-page-title--sm mb-4">
        <i class="bi bi-link-45deg me-2"></i> Short URLs
    </h2>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@ok
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@err
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="su-card">
        <h5 class="mb-3">Crear short-URL</h5>
        <form method="post" asp-page-handler="Crear" class="row g-3 align-items-end">
            <div class="col-lg-7">
                <label class="form-label">URL destino</label>
                <input name="urlDestino" class="form-control" placeholder="https://eiibd.com/..." required />
            </div>
            <div class="col-lg-3">
                <label class="form-label">Origen (opcional)</label>
                <input name="origen" class="form-control" placeholder="pregunta, contenido…" maxlength="50" />
            </div>
            <div class="col-lg-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-lg me-1"></i> Crear
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.NuevoCodigo))
        {
            <div class="alert alert-success mt-3 mb-0">
                Código creado: <strong>@Model.NuevoCodigo</strong> &nbsp;→&nbsp;
                <a href="/r/@Model.NuevoCodigo" target="_blank" class="alert-link">/r/@Model.NuevoCodigo</a>
            </div>
        }
    </div>

    <div class="su-card">
        <h5 class="mb-3">Listado (@Model.Items.Count)</h5>
        <div class="table-responsive">
            <table id="suTable" class="table table-hover table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>URL destino</th>
                        <th>Origen</th>
                        <th>Clicks</th>
                        <th>Creado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a href="/r/@item.Codigo" target="_blank" class="fw-semibold text-decoration-none">
                                    <i class="bi bi-box-arrow-up-right me-1 text-muted" style="font-size:.8em"></i>@item.Codigo
                                </a>
                            </td>
                            <td class="text-truncate" style="max-width:320px" title="@item.UrlDestino">
                                <a href="@item.UrlDestino" target="_blank" class="text-muted small">@item.UrlDestino</a>
                            </td>
                            <td><span class="text-muted small">@(item.Origen ?? "—")</span></td>
                            <td><span class="badge-clicks">@item.ClickCount</span></td>
                            <td class="text-muted small">@item.FechaCreado.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Eliminar /r/@item.Codigo?')"
                                            title="Eliminar">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Sin short-URLs aún.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
