@model eiibd26.Services.Platillos.PlatNotaEstado
@*
    Badge de estado de la nota clínica de un destino. Usado en la columna "Nota" de la lista
    (Ingredientes / Grupos) y en la cabecera del panel lateral. Un solo lugar = un solo look.
*@
@{
    var (txt, cls) = Model switch
    {
        eiibd26.Services.Platillos.PlatNotaEstado.Publicada => ("Publicada", "eii-nota-estado--publicada"),
        eiibd26.Services.Platillos.PlatNotaEstado.Borrador => ("Borrador", "eii-nota-estado--borrador"),
        _ => ("Sin nota", "eii-nota-estado--sinnota")
    };
}
<span class="eii-nota-estado @cls">@txt</span>
