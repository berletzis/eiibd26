@page
@using eiibd26.Models.Platillos
@using eiibd26.Services.Platillos
@model eiibd26.Areas.Identity.Pages.Admin.Platillos.IngredientesModel
@{
    ViewData["Title"] = "Platillos · Ingredientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-grid.css" asp-append-version="true" />
    @* Solo por el badge de estado de la nota en la columna. *@
    <link rel="stylesheet" href="~/css/admin-nota.css" asp-append-version="true" />
}

<div class="eii-page eii-page--wide">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 class="eii-page-title eii-page-title--sm mb-0">Ingredientes</h1>
        <a class="eii-btn eii-btn--primary" asp-page="IngredienteDetalle" target="_blank" rel="noopener">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo ingrediente
        </a>
    </div>
    <p class="eii-form-text mb-4">
        El alimento base, limpio, genérico y en singular. El paciente filtra por ingrediente:
        si cada platillo escribe "cebolla" distinto, el filtro no lo relaciona.
        <strong>Antes de crear uno, revisa que no exista ya.</strong>
    </p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="eii-admin-grid-wrap">
        <table id="gridIngredientes"
               class="table table-hover align-middle mb-0"
               data-eii-grid
               data-eii-grid-empty="Aún no hay ingredientes."
               data-eii-grid-order="0:asc">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Grupo</th>
                    <th>Atributos</th>
                    <th>Nota clínica</th>
                    <th>Estado</th>
                    <th data-no-sort class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    var estadoNota = Model.NotaEstados.TryGetValue(i.Id, out var en) ? en : PlatNotaEstado.SinNota;
                    <tr>
                        <td>@i.Nombre</td>
                        <td>@(i.Grupo?.Nombre ?? "—")</td>
                        <td>
                            @foreach (var a in i.Atributos)
                            {
                                <span class="eii-badge">@(a.Atributo?.Nombre)</span>
                            }
                        </td>
                        <td>
                            <a class="text-decoration-none"
                               asp-page="NotaClinicaDetalle" asp-route-tipo="Ingrediente" asp-route-destinoId="@i.Id"
                               target="_blank" rel="noopener"
                               title="Editar nota clínica de @i.Nombre">
                                <partial name="_NotaEstadoBadge" model="estadoNota" />
                            </a>
                        </td>
                        <td>
                            @if (i.Activo)
                            {
                                <span class="eii-badge">Activo</span>
                            }
                            else
                            {
                                <span class="text-muted">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="eii-btn eii-btn--ghost eii-btn--sm"
                               asp-page="NotaClinicaDetalle" asp-route-tipo="Ingrediente" asp-route-destinoId="@i.Id"
                               target="_blank" rel="noopener">Nota</a>
                            <a class="eii-btn eii-btn--ghost eii-btn--sm"
                               asp-page="IngredienteDetalle" asp-route-id="@i.Id"
                               target="_blank" rel="noopener">Editar</a>
                            <form method="post" asp-page-handler="ToggleActivo" asp-route-id="@i.Id" class="d-inline">
                                <button type="submit" class="eii-btn eii-btn--link eii-btn--sm">@(i.Activo ? "Desactivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/admin-grid.js" asp-append-version="true"></script>
}
