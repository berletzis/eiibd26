@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Admin.Platillos.GrupoDetalleModel
@{
    var editing = Model.Id.HasValue && Model.Id.Value > 0;
    ViewData["Title"] = editing ? "Editar grupo" : "Nuevo grupo";
    var listaUrl = Url.Page("Grupos");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">@(editing ? "Editar grupo" : "Nuevo grupo")</h1>
        <a class="eii-btn eii-btn--ghost" href="@listaUrl">← Volver al listado</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
            <a href="@listaUrl" class="alert-link ms-2">Volver al listado</a>
        </div>
        @* Solo tras un guardado exitoso: avisa a la pestaña del grid, que mostrará
           su píldora "Actualizar". No recarga ni cierra nada de esta pestaña. *@
        <div data-eii-grid-notify="grupo" hidden></div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="eii-card">
        <div class="eii-card__body">
            <form method="post" asp-page-handler="Guardar" class="row g-3">
                <input type="hidden" asp-for="Id" />
                <div class="col-md-7">
                    <label class="eii-label eii-label--required" asp-for="Nombre">Nombre</label>
                    <input class="eii-input" asp-for="Nombre" maxlength="100" autocomplete="off" required autofocus />
                </div>
                <div class="col-md-3">
                    <label class="eii-label" asp-for="Orden">Orden</label>
                    <input class="eii-input" type="number" asp-for="Orden" />
                </div>
                <div class="col-12">
                    <label class="eii-label" asp-for="NotasEII">Nota interna (EII)</label>
                    <textarea class="eii-textarea" asp-for="NotasEII" rows="2" maxlength="1000"
                              placeholder="Apuntes rápidos para el equipo."></textarea>
                    <span class="eii-form-text">
                        <strong>Interna: no se muestra al paciente.</strong> Referencia del equipo admin.
                        El contenido que ve el paciente va en la <strong>Nota clínica</strong>, que tiene su
                        propia página y se publica aparte.
                    </span>
                    @if (editing)
                    {
                        <div>
                            <button type="button" class="btn-generar-ia" data-ia-btn data-ia-kind="texto"
                                    data-ia-endpoint="/api/admin/platillos/grupo/@Model.Id/generate-notaseii"
                                    data-ia-target="#NotasEII">
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                <span>Generar con IA</span>
                            </button>
                        </div>
                    }
                </div>
                <div class="col-12">
                    <label class="eii-label" asp-for="RiesgoTipo">Grupo de riesgo (seguridad alimentaria)</label>
                    <input class="eii-input" asp-for="RiesgoTipo" maxlength="30" autocomplete="off"
                           list="riesgoTipoOpciones"
                           placeholder="Vacío = sin riesgo. Ej. marisco-crudo, carne-poco-cocida, sin-pasteurizar" />
                    <datalist id="riesgoTipoOpciones">
                        <option value="marisco-crudo"></option>
                        <option value="pescado-crudo"></option>
                        <option value="carne-poco-cocida"></option>
                        <option value="huevo-crudo"></option>
                        <option value="sin-pasteurizar"></option>
                        <option value="embutido"></option>
                        <option value="germinados"></option>
                    </datalist>
                    <span class="eii-form-text">
                        Solo si el grupo tiene riesgo de <strong>infección</strong> con defensas bajas (crudo/poco cocido).
                        Al marcarlo, el grupo puede tener una <strong>nota de precaución</strong> (aparte de la de tolerancia).
                    </span>
                    @if (editing && !string.IsNullOrWhiteSpace(Model.RiesgoTipo))
                    {
                        <div class="mt-2">
                            <a class="eii-btn eii-btn--ghost eii-btn--sm"
                               asp-page="NotaClinicaDetalle" asp-route-tipo="Grupo" asp-route-destinoId="@Model.Id"
                               asp-route-tipoNota="Precaucion" target="_blank" rel="noopener">
                                <i class="bi bi-shield-exclamation" aria-hidden="true"></i> Editar nota de precaución
                            </a>
                            <span class="eii-form-text ms-1">Guarda primero el tipo de riesgo si acabas de cambiarlo.</span>
                        </div>
                    }
                </div>
                @if (editing && !Model.Activo)
                {
                    <div class="col-12">
                        <span class="eii-form-text">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            Este grupo está inactivo. Se reactiva desde el listado.
                        </span>
                    </div>
                }
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="eii-btn eii-btn--primary">@(editing ? "Guardar cambios" : "Crear")</button>
                    <a class="eii-btn eii-btn--ghost" href="@listaUrl">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin-ia.css" asp-append-version="true" />
}

@section Scripts {
    @* Sin DataTables: acá admin-grid.js solo hace el aviso de guardado. *@
    <script src="~/js/admin-grid.js" asp-append-version="true"></script>
    <script src="~/js/admin-platillos-ia.js" asp-append-version="true"></script>
}
