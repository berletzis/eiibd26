@page
@using eiibd26.Models.Platillos
@using eiibd26.Services.Platillos
@model eiibd26.Areas.Identity.Pages.Admin.Platillos.GruposModel
@{
    ViewData["Title"] = "Platillos · Grupos";
    var editing = Model.Id > 0;
}

<div class="container py-4">
    <h1 class="h4 mb-1">Grupos de alimentos</h1>
    <p class="eii-form-text mb-4">Qué <strong>ES</strong> el alimento (lácteo, verdura, pescado…). El paciente casi siempre filtra por grupo.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="eii-card mb-4">
        <div class="eii-card__body">
            <h2 class="eii-card__title h6 mb-3">@(editing ? "Editar grupo" : "Nuevo grupo")</h2>
            <form method="post" asp-page-handler="Guardar" class="row g-3">
                <input type="hidden" asp-for="Id" />
                <div class="col-md-7">
                    <label class="eii-label eii-label--required" asp-for="Nombre">Nombre</label>
                    <input class="eii-input" asp-for="Nombre" maxlength="100" autocomplete="off" required />
                </div>
                <div class="col-md-3">
                    <label class="eii-label" asp-for="Orden">Orden</label>
                    <input class="eii-input" type="number" asp-for="Orden" />
                </div>
                <div class="col-12">
                    <label class="eii-label" asp-for="NotasEII">Contexto clínico (EII)</label>
                    <textarea class="eii-textarea" asp-for="NotasEII" rows="3" maxlength="2000"
                              placeholder="Ej. en lácteos: son tu principal fuente de calcio; restringirlos sin motivo aumenta el riesgo de osteoporosis…"></textarea>
                    <span class="eii-form-text">Se muestra al paciente en la vista del ingrediente. Es <strong>contenido médico</strong>: revísalo con un médico antes de publicarlo. Déjalo vacío si aún no está revisado.</span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="eii-btn eii-btn--primary">@(editing ? "Guardar cambios" : "Crear")</button>
                    @if (editing)
                    {
                        <a class="eii-btn eii-btn--ghost" asp-page="Grupos">Cancelar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="eii-card">
        <div class="eii-card__body">
            <div class="eii-list-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="eii-input" data-nota-filter autocomplete="off"
                       placeholder="Buscar grupo…" aria-label="Buscar grupo" />
            </div>
            <table class="table align-middle mb-0" data-nota-filterable>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Orden</th>
                        <th>Nota clínica</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.Items)
                    {
                        var estadoNota = Model.NotaEstados.TryGetValue(g.Id, out var en) ? en : PlatNotaEstado.SinNota;
                        <tr>
                            <td data-nombre>@g.Nombre</td>
                            <td>@g.Orden</td>
                            <td>
                                <a class="text-decoration-none" asp-page="Grupos" asp-route-notaId="@g.Id"
                                   title="Editar nota clínica de @g.Nombre">
                                    <partial name="_NotaEstadoBadge" model="estadoNota" />
                                </a>
                            </td>
                            <td>
                                @if (g.Activo)
                                {
                                    <span class="eii-badge">Activo</span>
                                }
                                else
                                {
                                    <span class="text-muted">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="eii-btn eii-btn--ghost eii-btn--sm" asp-page="Grupos" asp-route-notaId="@g.Id">Nota</a>
                                <a class="eii-btn eii-btn--ghost eii-btn--sm" asp-page="Grupos" asp-route-editId="@g.Id">Editar</a>
                                <form method="post" asp-page-handler="ToggleActivo" asp-route-id="@g.Id" class="d-inline">
                                    <button type="submit" class="eii-btn eii-btn--link eii-btn--sm">@(g.Activo ? "Desactivar" : "Reactivar")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr data-nota-empty><td colspan="5" class="text-center text-muted py-3">Aún no hay grupos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.NotaEdit != null)
{
    <partial name="_NotaClinicaPanel" model="Model.NotaEdit" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-nota-panel.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-nota-panel.js" asp-append-version="true"></script>
}
