@page
@using eiibd26.Models.Platillos
@model eiibd26.Areas.Identity.Pages.Admin.Platillos.UnidadesModel
@{
    ViewData["Title"] = "Platillos · Unidades";
    var editing = Model.Id > 0;
}

<div class="container py-4">
    <h1 class="h4 mb-1">Unidades de medida</h1>
    <p class="eii-form-text mb-4">pieza, taza, g, kg, ml, l, cda, cdta, al gusto, paquete, bandeja, tarro.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="eii-card mb-4">
        <div class="eii-card__body">
            <h2 class="eii-card__title h6 mb-3">@(editing ? "Editar unidad" : "Nueva unidad")</h2>
            <form method="post" asp-page-handler="Guardar" class="row g-3">
                <input type="hidden" asp-for="Id" />
                <div class="col-md-8">
                    <label class="eii-label eii-label--required" asp-for="Nombre">Nombre</label>
                    <input class="eii-input" asp-for="Nombre" maxlength="100" autocomplete="off" required />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="eii-btn eii-btn--primary">@(editing ? "Guardar cambios" : "Crear")</button>
                    @if (editing)
                    {
                        <a class="eii-btn eii-btn--ghost" asp-page="Unidades">Cancelar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="eii-card">
        <div class="eii-card__body">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td>@u.Nombre</td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="eii-badge">Activo</span>
                                }
                                else
                                {
                                    <span class="text-muted">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="eii-btn eii-btn--ghost eii-btn--sm" asp-page="Unidades" asp-route-editId="@u.Id">Editar</a>
                                <form method="post" asp-page-handler="ToggleActivo" asp-route-id="@u.Id" class="d-inline">
                                    <button type="submit" class="eii-btn eii-btn--link eii-btn--sm">@(u.Activo ? "Desactivar" : "Reactivar")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Aún no hay unidades.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
