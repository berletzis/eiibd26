@page
@using eiibd26.Models.Platillos
@model eiibd26.Areas.Identity.Pages.Admin.Platillos.UnidadesModel
@{
    ViewData["Title"] = "Platillos · Unidades";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-grid.css" asp-append-version="true" />
}

<div class="eii-page eii-page--wide">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 class="eii-page-title eii-page-title--sm mb-0">Unidades de medida</h1>
        <a class="eii-btn eii-btn--primary" asp-page="UnidadDetalle" target="_blank" rel="noopener">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nueva unidad
        </a>
    </div>
    <p class="eii-form-text mb-4">pieza, taza, g, kg, ml, l, cda, cdta, al gusto, paquete, bandeja, tarro.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="eii-admin-grid-wrap">
        @* El id es obligatorio: stateSave lo usa como llave. Nada de fila "no hay
           registros" — DataTables la pone vía data-eii-grid-empty (si fuera una
           <tr> real, la contaría como registro). *@
        <table id="gridUnidades"
               class="table table-hover align-middle mb-0"
               data-eii-grid
               data-eii-grid-empty="Aún no hay unidades."
               data-eii-grid-order="0:asc">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th data-no-sort class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td>@u.Nombre</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="eii-badge">Activo</span>
                            }
                            else
                            {
                                <span class="text-muted">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="eii-btn eii-btn--ghost eii-btn--sm"
                               asp-page="UnidadDetalle" asp-route-id="@u.Id"
                               target="_blank" rel="noopener">Editar</a>
                            <form method="post" asp-page-handler="ToggleActivo" asp-route-id="@u.Id" class="d-inline">
                                <button type="submit" class="eii-btn eii-btn--link eii-btn--sm">@(u.Activo ? "Desactivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/admin-grid.js" asp-append-version="true"></script>
}
