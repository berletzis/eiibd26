@page
@model eiibd26.Areas.Identity.Pages.Admin.Tratamientos.IndexModel
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize(Roles = "Administrador")] *@

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }

        .crm-title-admin {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #14253f;
            margin-bottom: .7em;
        }

        .table-centered-admin {
            max-width: 1320px;
            margin: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            border: none;
            padding: 20px 22px 9px 22px;
        }

        .dt-controls-flex {
            max-width: 1320px;
            margin: 0 auto 8px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .form-switch {
            padding-left: 2.5em;
            margin-bottom: 0 !important;
        }

        .switch-label {
            font-weight: normal;
            margin-left: 0.5em;
            margin-right: 2em;
        }

        #tratamientosGrid {
            width: 100% !important;
            margin: 0;
        }

            #tratamientosGrid th, #tratamientosGrid td {
                border: none !important;
            }

            #tratamientosGrid th {
                background: #eef4fa !important;
                color: #3d436c !important;
                font-weight: 600 !important;
                border-bottom: 2.7px solid #ddeaf7 !important;
                font-size: 1.07em;
            }

            #tratamientosGrid tbody tr {
                border-bottom: 1.2px solid #e7ebf4 !important;
                box-shadow: 0 1px 18px #e6edfa0c;
            }

            #tratamientosGrid tbody td {
                background: #fff !important;
                border-top: none !important;
                border-bottom: 1.1px solid #f2f7fd !important;
                font-size: 1.05em;
                padding-top: 13px !important;
                padding-bottom: 13px !important;
            }

            #tratamientosGrid tbody tr:nth-child(even) td {
                background: #f9fbfc !important;
            }

        .badge-grid-gray {
            background: #ededed !important;
            color: #191919 !important;
            font-weight: 600;
            font-size: .94em;
            border-radius: 9px;
            border: 1px solid #dddddd;
            padding: 6px 12px;
            letter-spacing: .01em;
            box-shadow: 0 1px 7px #dde2eb22;
        }

        .btn-action-tratamiento {
            background: #f3f8fd !important;
            color: #315686 !important;
            border: 1.1px solid #dde3ee !important;
            font-weight: 500;
            margin-right: 0.10em;
            border-radius: 9px !important;
            box-shadow: 0 2px 8px #dde2eb18;
            padding: 6px 13px !important;
            font-size: .98em;
        }

            .btn-action-tratamiento:hover,
            .btn-action-tratamiento:focus {
                background: #e5ecf7 !important;
                color: #222 !important;
            }

        .modal-header .btn-close {
            position: absolute;
            right: 1rem;
            top: 1rem;
        }

        .crm-modal-header {
            background: #f7f9fd;
            border-bottom: 1px solid #e5e8ef;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            padding: 1.1rem 1.5rem;
            color: #315686;
        }

        .crm-modal-title {
            font-size: 1.34rem;
            font-weight: 600;
            color: #315686;
        }

        .crm-modal-content {
            border-radius: 20px;
            box-shadow: 0 13px 32px 0 #b7c3f859;
            background: #fff;
        }

        .crm-modal-footer {
            border-top: 1px solid #ebecf1;
            padding: 1rem 1.5rem;
            background: #f7f9fd;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            text-align: right;
        }

        .crm-modal-body {
            padding: 1.3rem 1.5rem 1.3rem 1.5rem;
        }

        .trat-hijo {
            padding-left: 2em;
            color: #717485;
        }

        .trat-padre {
            font-weight: bold;
        }

        .table-container-admin {
            max-width: 1320px;
            margin: 0 auto;
        }
        @@media (max-width: 1100px) {
            .crm-container-admin, .table-container-admin, .table-centered-admin, .dt-controls-flex

        {
            max-width: 99vw;
        }

        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Tratamientos</h2>
    <div class="mb-2 table-centered-admin dt-controls-flex">
        <div class="form-check form-switch d-inline-block align-middle">
            <input class="form-check-input" type="checkbox" role="switch" id="switchEliminadosTratamientos">
            <label class="form-check-label switch-label" for="switchEliminadosTratamientos">Mostrar eliminados</label>
        </div>
    </div>
    <div class="table-centered-admin">
        <table id="tratamientosGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>ID Padre</th>
                    <th>Idioma</th>
                    <th>Eliminado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
    <!-- Modal Editar -->
    <div class="modal fade" id="modalEditarTratamiento" tabindex="-1" aria-labelledby="modalEditarTratamientoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form id="formEditarTratamiento" class="crm-modal-content modal-content">
                <div class="crm-modal-header modal-header">
                    <h5 class="crm-modal-title modal-title" id="modalEditarTratamientoLabel">Editar Tratamiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="crm-modal-body modal-body">
                    <input type="hidden" name="id" id="editTratamiento_id">
                    <div class="mb-3">
                        <label for="editTratamiento_nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="editTratamiento_nombre" name="nombre" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTratamiento_idPadre" class="form-label">ID Padre (dejar vacío si es padre)</label>
                        <input type="number" class="form-control" id="editTratamiento_idPadre" name="idPadre">
                    </div>
                    <div class="mb-3">
                        <label for="editTratamiento_idIdioma" class="form-label">ID Idioma</label>
                        <input type="number" class="form-control" id="editTratamiento_idIdioma" name="idIdioma" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTratamiento_icono" class="form-label">Ícono</label>
                        <input type="text" class="form-control" id="editTratamiento_icono" name="icono">
                    </div>
                    <div class="mb-3">
                        <label for="editTratamiento_eliminado" class="form-label">¿Eliminado?</label>
                        <select class="form-select" id="editTratamiento_eliminado" name="eliminado">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>
                    </div>
                    <div class="alert alert-success d-none" id="msgEditTratamientoSuccess">¡Edición realizada correctamente!</div>
                </div>
                <div class="crm-modal-footer modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Aceptar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let tratamientosTabla;
        let hijosTratPorPadre = {};

        function actualizarDiccionarioHijosTratamientos(data) {
            hijosTratPorPadre = {};
            data.forEach(item => {
                if (item.idPadre && item.idPadre !== 0) {
                    if (!hijosTratPorPadre[item.idPadre]) {
                        hijosTratPorPadre[item.idPadre] = [];
                    }
                    hijosTratPorPadre[item.idPadre].push(item.id);
                }
            });
        }

        $(function () {
            tratamientosTabla = $('#tratamientosGrid').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'GET',
                    data: function (d) {
                        d.mostrarEliminados = $('#switchEliminadosTratamientos').is(':checked');
                    },
                    dataSrc: function (json) {
                        actualizarDiccionarioHijosTratamientos(json.data);
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'nombre',
                        orderable: false,
                        render: function (data, type, row) {
                            if (!row.esPadre && row.idPadre) {
                                return `<span class="trat-hijo">- ${data}</span>`;
                            }
                            return `<span class="trat-padre">${data}</span>`;
                        }
                    },
                    {
                        data: 'esPadre',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Padre</span>`
                                : `<span class="badge badge-grid-gray">Hijo</span>`;
                        }
                    },
                    { data: 'idPadre', orderable: false, defaultContent: '' },
                    { data: 'idIdioma', orderable: false },
                    {
                        data: 'eliminado',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Sí</span>`
                                : `<span class="badge badge-grid-gray">No</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let editBtn = `<button class='btn btn-sm btn-action-tratamiento btn-editar-tratamiento' title='Editar' data-id='${row.id}'><i class="bi bi-pencil-square"></i> Editar</button>`;
                            let eliminarBtn = '', restaurarBtn = '';
                            const esPadre = row.esPadre;
                            const tieneHijos = hijosTratPorPadre[row.id] && hijosTratPorPadre[row.id].length > 0;
                            if (row.eliminado) {
                                restaurarBtn = `<button class='btn btn-sm btn-success btn-restaurar-tratamiento ms-1' title='Restaurar' data-id='${row.id}'><i class="bi bi-arrow-counterclockwise"></i> Restaurar</button>`;
                            } else {
                                if (!(esPadre && tieneHijos)) {
                                    eliminarBtn = `<button class='btn btn-sm btn-danger btn-borrar-tratamiento ms-1' title='Eliminar' data-id='${row.id}'><i class="bi bi-trash"></i> Eliminar</button>`;
                                }
                            }
                            return editBtn + eliminarBtn + restaurarBtn;
                        }
                    }
                ],
                order: [],
                language: {
                    emptyTable: "No hay tratamientos registrados."
                }
            });

            $('#switchEliminadosTratamientos').change(function () {
                tratamientosTabla.ajax.reload();
            });

            $('#tratamientosGrid').on('click', '.btn-editar-tratamiento', function () {
                const id = $(this).data('id');
                $.get('@Url.Page(null, "GetTratamiento")', { id: id }, function (data) {
                    $('#editTratamiento_id').val(data.id);
                    $('#editTratamiento_nombre').val(data.nombre);
                    $('#editTratamiento_idPadre').val(data.idPadre || "");
                    $('#editTratamiento_idIdioma').val(data.idIdioma);
                    $('#editTratamiento_icono').val(data.icono || "");
                    $('#editTratamiento_eliminado').val(data.eliminado ? "true" : "false");
                    $('#msgEditTratamientoSuccess').addClass('d-none');
                    $('#modalEditarTratamiento').modal('show');
                });
            });

            $('#formEditarTratamiento').on('submit', function (e) {
                e.preventDefault();
                var serialized = $(this).serialize();
                $.ajax({
                    url: '@Url.Page(null, "EditarTratamiento")',
                    type: "POST",
                    data: serialized,
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    success: function (response) {
                        if (response.success) {
                            $('#msgEditTratamientoSuccess').removeClass('d-none');
                            tratamientosTabla.ajax.reload(null, false);
                            setTimeout(function () {
                                $('#modalEditarTratamiento').modal('hide');
                            }, 1000);
                        } else {
                            alert('Error: ' + (response.message || 'No se pudo guardar.') );
                        }
                    }
                });
            });

            $('#tratamientosGrid').on('click', '.btn-borrar-tratamiento', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea eliminar este tratamiento? Esta acción no se puede deshacer.')) {
                    $.ajax({
                        url: '@Url.Page(null, "EliminarTratamiento")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                tratamientosTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo eliminar.'));
                            }
                        }
                    });
                }
            });

            $('#tratamientosGrid').on('click', '.btn-restaurar-tratamiento', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea restaurar este tratamiento?')) {
                    $.ajax({
                        url: '@Url.Page(null, "RestaurarTratamiento")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                tratamientosTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo restaurar.'));
                            }
                        }
                    });
                }
            });
        });
    </script>
}