@page
@model eiibd26.Areas.Identity.Pages.Admin.Tratamientos.IndexModel
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize(Roles = "Administrador")] *@

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        /* ===== NUEVO LAYOUT CON PANEL LATERAL ===== */
        .admin-layout-flex {
            display: flex;
            gap: 24px;
            min-height: calc(100vh - 200px);
            margin-top: 20px;
            transition: all 0.3s ease-out;
        }

        .grid-wrapper {
            flex: 1 1 auto;
            min-width: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            padding: 20px;
            transition: all 0.3s ease-out;
        }

        .side-panel {
            width: 0;
            min-width: 0;
            flex-shrink: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            padding: 0;
            max-height: calc(100vh - 200px);
            overflow: hidden;
            opacity: 0;
            transition: all 0.3s ease-out;
            position: sticky;
            top: 20px;
            z-index: 10;
        }

        .side-panel.active {
            width: 35%;
            min-width: 400px;
            padding: 24px;
            opacity: 1;
            overflow-y: auto;
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .side-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 16px;
            margin-bottom: 24px;
        }

        .side-panel-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            color: #14253f;
        }

        .btn-close-panel {
            background: #f3f4f6;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #6b7280;
            transition: all 0.2s;
        }

        .btn-close-panel:hover {
            background: #e5e7eb;
            color: #374151;
        }

        /* ===== BOTÓN GENERAR IA ===== */
        .btn-generar-ia {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 12px;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-generar-ia:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-generar-ia:disabled {
            background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
            cursor: not-allowed;
            transform: none;
        }

        .loading-spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spinner 0.8s linear infinite;
        }

        @@keyframes spinner {
            to { transform: rotate(360deg); }
        }

        /* ===== ESTILOS EXISTENTES ADAPTADOS ===== */
        .table-centered-admin {
            background: transparent;
            border-radius: 0;
            box-shadow: none;
            padding: 0;
            overflow-x: auto;
        }

        /* Asegurar que el DataTable sea responsive */
        .dataTables_wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table.dataTable {
            width: 100% !important;
        }

        .dt-controls-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }

        .btn-action-tratamiento {
            padding: 6px 14px;
            font-size: 0.875rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-editar-tratamiento {
            background: #3b82f6;
            color: white;
        }

        .btn-editar-tratamiento:hover {
            background: #2563eb;
            transform: translateY(-1px);
        }

        .btn-borrar-tratamiento {
            background: #ef4444;
            color: white;
        }

        .btn-borrar-tratamiento:hover {
            background: #dc2626;
        }

        .btn-restaurar-tratamiento {
            background: #10b981;
            color: white;
        }

        .btn-restaurar-tratamiento:hover {
            background: #059669;
        }

        .trat-padre {
            font-weight: 600;
            color: #14253f;
        }

        .trat-hijo {
            color: #6b7280;
            padding-left: 20px;
        }

        .badge-grid-gray {
            background: #e5e7eb;
            color: #374151;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
        }

        .alert-success {
            background: #d1fae5;
            border: 1px solid #10b981;
            color: #065f46;
            border-radius: 8px;
            padding: 12px;
        }

        @@media (max-width: 1200px) {
            .admin-layout-flex {
                flex-direction: column;
            }
            .grid-wrapper, .side-panel {
                flex: 1 1 100%;
                max-width: 100%;
            }
            .side-panel {
                position: static;
                max-height: none;
            }
        }
    </style>
}

<div class="eii-page eii-page--wide">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="eii-page-title eii-page-title--sm mb-0">Tratamientos</h2>

        <div class="d-flex gap-2">
            <!-- Triage de limpieza: decide qué es tratamiento y qué es ruido heredado -->
            <button type="button" class="btn btn-outline-dark btn-lg" id="btnRevisarNina">
                <i class="bi bi-funnel"></i> Revisar con NINA
            </button>

            <!-- ⭐ NUEVO: Botón Actualización Masiva -->
            <button type="button" class="btn btn-primary btn-lg" id="btnActualizacionMasiva">
                <i class="bi bi-magic"></i> Actualización Masiva con IA
            </button>
        </div>
    </div>

    <div class="admin-layout-flex">
        <!-- ===== GRID (LADO IZQUIERDO 65%) ===== -->
        <div class="grid-wrapper">
            <div class="dt-controls-flex">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchEliminadosTratamientos">
                    <label class="form-check-label" for="switchEliminadosTratamientos">Mostrar eliminados</label>
                </div>

                <div class="d-flex align-items-center gap-2 ms-3">
                    <label class="form-label small mb-0 text-muted" for="filtroTriage">Triage:</label>
                    <select id="filtroTriage" class="form-select form-select-sm" style="width:auto;">
                        <option value="">Todos</option>
                        <option value="norevisado">No revisado</option>
                        <option value="valido">Válido</option>
                        <option value="basura">Basura</option>
                        <option value="dudoso">Dudoso (cola humana)</option>
                    </select>
                </div>
            </div>

            <div class="table-centered-admin">
                <table id="tratamientosGrid" class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>ID Padre</th>
                            <th>Idioma</th>
                            <th><i class="bi bi-robot" title="Validado por IA"></i> IA</th>
                            <th><i class="bi bi-person-check" title="Validado por Humano"></i> Humano</th>
                            <th>EII</th>
                            <th><i class="bi bi-funnel" title="Triage de limpieza"></i> Triage</th>
                            <th>Eliminado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- ===== PANEL LATERAL (LADO DERECHO 35%) ===== -->
        <div class="side-panel" id="panelEditarTratamiento">
            <div class="side-panel-header">
                <h3>Editar Tratamiento</h3>
                <button type="button" class="btn-close-panel" id="btnCerrarPanel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="formEditarTratamiento">
                <input type="hidden" name="id" id="editTratamiento_id">

                <div class="mb-3">
                    <label for="editTratamiento_nombre" class="form-label fw-semibold">Nombre</label>
                    <input type="text" class="form-control" id="editTratamiento_nombre" name="nombre" required>
                </div>

                <!-- Otros campos colapsados -->
                <div class="accordion accordion-flush mb-3" id="acordeonOtrosTratamiento">
                    <div class="accordion-item border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed py-2 px-3"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#otrosCamposTratamiento"
                                    aria-expanded="false"
                                    style="background:#f9fafb;font-size:.875rem;">
                                <i class="bi bi-three-dots me-2 text-muted"></i>
                                <span class="text-muted">Otros campos</span>
                            </button>
                        </h2>
                        <div id="otrosCamposTratamiento" class="accordion-collapse collapse">
                            <div class="accordion-body py-2 px-3">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <label class="form-label small mb-1">ID Padre</label>
                                        <input type="number" class="form-control form-control-sm"
                                               id="editTratamiento_idPadre" name="idPadre">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1">ID Idioma</label>
                                        <input type="number" class="form-control form-control-sm"
                                               id="editTratamiento_idIdioma" name="idIdioma">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1">Ícono</label>
                                        <input type="text" class="form-control form-control-sm"
                                               id="editTratamiento_icono" name="icono">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== NUEVO: DESCRIPCIÓN IA ===== -->
                <div class="mb-3">
                    <label for="editTratamiento_descripcionIA" class="form-label fw-semibold">
                        <i class="bi bi-magic"></i> Descripción IA
                    </label>
                    <textarea class="form-control" id="editTratamiento_descripcionIA" name="descripcionIA" rows="6" 
                              placeholder="Genera una descripción automática con IA..."></textarea>
                    <button type="button" class="btn-generar-ia" id="btnGenerarIA">
                        <i class="bi bi-stars"></i>
                        <span>Generar con IA</span>
                    </button>
                </div>

                <!-- ===== NUEVO: VALIDACIÓN HUMANA ===== -->
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="editTratamiento_validadoHumano" name="validadoHumano">
                    <label class="form-check-label" for="editTratamiento_validadoHumano">
                        <i class="bi bi-person-check-fill text-primary"></i> Validado por Humano
                    </label>
                </div>

                <!-- ===== NUEVO: RELACIÓN CON EII (SOLO LECTURA) ===== -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-info-circle-fill text-primary"></i> Relación con EII
                    </label>
                    <div class="alert alert-info mb-0" id="editTratamiento_relacionEIIContainer" style="display: none;">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                            <div>
                                <strong>Este tratamiento está relacionado con la EII</strong>
                                <p class="mb-0 mt-2" id="editTratamiento_relacionEIITexto"></p>

                                <!-- ⭐ MOSTRAR FUENTES SOLO SI EXISTEN -->
                                <div class="mt-2 pt-2 border-top" id="editTratamiento_fuentesContainer" style="display: none;">
                                    <small class="text-muted">
                                        <i class="bi bi-link-45deg"></i> <strong>Fuentes verificadas:</strong> 
                                        <span id="editTratamiento_fuentes"></span>
                                    </small>
                                </div>

                                <!-- ⭐ DISCLAIMER CUANDO NO HAY FUENTES -->
                                <div class="mt-2 pt-2 border-top" id="editTratamiento_noFuentesDisclaimer" style="display: none;">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle"></i> 
                                        <em>Información generada por IA. Consulta fuentes médicas confiables o tu médico para verificar.</em>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-secondary mb-0" id="editTratamiento_noRelacionEIIContainer" style="display: none;">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-x-circle text-muted me-2 mt-1"></i>
                            <div>
                                <strong>Sin relación documentada con EII</strong>
                                <p class="mb-0 mt-2 text-muted">No se encontró evidencia de relación con Enfermedad Inflamatoria Intestinal</p>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">Esta información la determina la IA automáticamente</small>
                </div>

                <!-- ===== BLOQUE GLOSARIO ===== -->
                <div class="card mb-3 border-0" id="editTratamiento_glosarioBlock" style="display:none;">
                    <div class="card-header text-white py-2 rounded-top"
                         style="background:linear-gradient(135deg,#10b981,#059669);">
                        <i class="bi bi-journal-medical me-1"></i>
                        <span class="fw-semibold">Glosario Médico</span>
                        <small class="ms-2 opacity-75" id="editTratamiento_glosarioTermId"></small>
                    </div>
                    <div class="card-body p-3" style="background:#f0fdf4;">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <p class="text-muted mb-1" style="font-size:.75rem;">Sugerido por NINA:</p>
                                <div id="editTratamiento_nivelIA"><span class="text-muted small fst-italic">No determinado</span></div>
                            </div>
                            <div class="col-6">
                                <p class="text-muted mb-1" style="font-size:.75rem;">Confirmado (admin):</p>
                                <div id="editTratamiento_nivelConfirmado"><span class="text-muted small fst-italic">Sin confirmar</span></div>
                            </div>
                        </div>
                        <div id="editTratamiento_reasoningBlock" class="mb-3 p-2 rounded"
                             style="background:#fff;border:1px solid #bbf7d0;display:none;">
                            <p class="mb-1" style="font-size:.72rem;color:#059669;">
                                <i class="bi bi-robot me-1"></i><strong>Razonamiento NINA:</strong>
                            </p>
                            <p class="mb-0 small" id="editTratamiento_reasoning"></p>
                        </div>
                        <hr class="my-2">
                        <p class="fw-semibold mb-2" style="font-size:.8rem;">
                            <i class="bi bi-people me-1"></i> Historial de validaciones:
                        </p>
                        <div id="editTratamiento_validaciones">
                            <p class="text-muted small mb-0 fst-italic">Sin validaciones registradas</p>
                        </div>
                    </div>
                </div>

                <!-- Activo / Eliminado -->
                <div class="mb-3 d-flex align-items-center gap-2 p-2 rounded border">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="editTratamiento_activo" style="cursor:pointer;">
                        <label class="form-check-label fw-semibold" for="editTratamiento_activo">
                            Registro activo
                        </label>
                    </div>
                    <small class="text-muted">(desmarcar = eliminar registro)</small>
                </div>

                <div class="alert alert-success d-none" id="msgEditTratamientoSuccess">
                    <i class="bi bi-check-circle-fill"></i> ¡Guardado exitosamente!
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-lg"></i> Guardar Cambios
                    </button>
                    <button type="button" class="btn btn-secondary" id="btnCancelar">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ⭐ MODAL DE ACTUALIZACIÓN MASIVA -->
<div class="modal fade" id="modalActualizacionMasiva" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-magic"></i> Actualización Masiva con IA
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" id="btnCerrarModal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Este proceso generará descripciones IA automáticamente</strong>
                    <p class="mb-0 mt-2">Procesa registros en lotes. Selecciona cuántos registros procesar en total y el sistema hará sub-lotes de 10 con pausa entre cada sub-lote para evitar saturación.</p>
                    <div class="mt-2">
                        <label class="form-label small mb-1">Registros a procesar:</label>
                        <select id="selectBatchSize" class="form-select form-select-sm" style="width:120px;display:inline-block;">
                            <option value="10">10</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500">500</option>
                            <option value="1000">1000</option>
                        </select>
                        <small class="text-muted ms-2">Sub-lotes de 10, pausa 5s entre cada sub-lote</small>
                    </div>
                </div>

                <!-- Progreso -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span><strong>Progreso:</strong></span>
                        <span id="progresoTexto">0 / 0 procesados</span>
                    </div>
                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                             id="progressBar" 
                             role="progressbar" 
                             style="width: 0%">
                            0%
                        </div>
                    </div>
                </div>

                <!-- Estadísticas -->
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="card bg-success text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="exitososCount">0</h3>
                                <small>Exitosos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-danger text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="fallidosCount">0</h3>
                                <small>Fallidos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="pendientesCount">0</h3>
                                <small>Pendientes</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Log de resultados -->
                <div class="card">
                    <div class="card-header bg-light">
                        <strong>Registro de procesamiento:</strong>
                    </div>
                    <div class="card-body" style="max-height: 300px; overflow-y: auto;" id="logResultados">
                        <p class="text-muted">Presiona "Iniciar Actualización" para comenzar...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="btnCerrar">Cerrar</button>
                <div>
                    <button type="button" class="btn btn-primary btn-lg" id="btnIniciarBatch">
                        <i class="bi bi-play-fill"></i> Iniciar Actualización
                    </button>
                    <button type="button" class="btn btn-success btn-lg d-none" id="btnContinuarBatch">
                        <i class="bi bi-arrow-right-circle-fill"></i> Continuar (Siguientes 10)
                    </button>
                    <button type="button" class="btn btn-warning d-none" id="btnPausarBatch">
                        <i class="bi bi-pause-fill"></i> Pausar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE TRIAGE DE LIMPIEZA (NINA) -->
<div class="modal fade" id="modalRevisarNina" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-funnel"></i> Revisar catálogo con NINA
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" id="btnCerrarModalNina"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Clasifica en tres vías: Válido · Basura · Dudoso</strong>
                    <p class="mb-0 mt-2">
                        Decide si el registro es una intervención terapéutica real — no si tiene
                        relación con EII. Un tratamiento real sin relación con EII se conserva.
                        Nunca borra: la basura se desactiva (<em>Eliminado</em>) y es reversible.
                        Los <strong>Dudosos</strong> jamás se desactivan solos: van a la cola humana.
                    </p>
                    <div class="mt-3">
                        <label class="form-label small mb-1" for="selectRama">Rama a revisar:</label>
                        <select id="selectRama" class="form-select form-select-sm">
                            <option value="">Cargando categorías...</option>
                        </select>
                        <small class="text-muted">
                            Ordenadas por cuántos registros les faltan revisar. Enfocar una rama evita
                            gastar horas de IA recorriendo el catálogo curado de fármacos.
                        </small>
                    </div>

                    <div class="mt-3 d-flex align-items-center flex-wrap gap-3">
                        <div>
                            <label class="form-label small mb-1">Registros a revisar:</label>
                            <select id="selectReviewSize" class="form-select form-select-sm" style="width:120px;">
                                <option value="100">100</option>
                                <option value="300">300</option>
                                <option value="500">500</option>
                                <option value="1000">1000</option>
                            </select>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchDryRun" checked>
                            <label class="form-check-label" for="switchDryRun">
                                <strong>Dry-run</strong> (solo clasificar, no desactiva a nadie)
                            </label>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        Toma los siguientes sin revisar (reanuda solo, no reprocesa). Sub-lotes de 10 con pausa de 5s.
                    </small>
                </div>

                <div class="alert alert-danger d-none" id="avisoDryRunOff">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Dry-run desactivado.</strong> Los registros clasificados como Basura con
                    confianza ≥ 0.85 quedarán <strong>desactivados</strong> (reversible con Restaurar
                    o con el UPDATE en bloque del script SQL).
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span><strong>Progreso:</strong></span>
                        <span id="progresoTextoNina">0 / 0 revisados</span>
                    </div>
                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             id="progressBarNina" role="progressbar" style="width: 0%">0%</div>
                    </div>
                </div>

                <!-- Resumen por bucket -->
                <div class="row text-center mb-3 g-2">
                    <div class="col">
                        <div class="card bg-success text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="validosCount">0</h3>
                                <small>Válidos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card bg-danger text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="basuraCount">0</h3>
                                <small>Basura</small>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card bg-warning text-dark">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="dudososCount">0</h3>
                                <small>Dudosos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card bg-secondary text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="protegidosCount">0</h3>
                                <small>Intactos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card bg-primary text-white">
                            <div class="card-body py-2">
                                <h3 class="mb-0" id="pendientesNinaCount">0</h3>
                                <small>Pendientes</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light">
                        <strong>Registro de clasificación:</strong>
                    </div>
                    <div class="card-body" style="max-height: 300px; overflow-y: auto;" id="logResultadosNina">
                        <p class="text-muted">Presiona "Iniciar revisión" para comenzar...</p>
                    </div>
                </div>

                <!-- Paso destructivo: aplica lo YA clasificado como Basura. Sin llamadas a la IA. -->
                <div class="card border-danger mt-3">
                    <div class="card-header bg-danger text-white">
                        <i class="bi bi-trash"></i> <strong>Aplicar desactivación a Basura</strong>
                    </div>
                    <div class="card-body">
                        <p class="small mb-2">
                            Desactiva los registros que el triage ya marcó como <strong>Basura</strong>
                            en la rama seleccionada. No consulta a la IA: solo aplica lo revisado.
                            Respeta los mismos guards (nodos con hijos, validados por humano, con
                            pacientes activos) y es reversible desde <em>Restaurar</em> o con el
                            UPDATE en bloque del script SQL.
                        </p>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <button type="button" class="btn btn-danger" id="btnAplicarBasura" disabled>
                                <i class="bi bi-trash"></i> Aplicar desactivación a Basura
                            </button>
                            <span class="small text-muted" id="basuraRamaInfo">Elige una rama para ver cuántos hay.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="btnCerrarNina">Cerrar</button>
                <div>
                    <button type="button" class="btn btn-dark btn-lg" id="btnIniciarReview">
                        <i class="bi bi-play-fill"></i> Iniciar revisión
                    </button>
                    <button type="button" class="btn btn-success btn-lg d-none" id="btnContinuarReview">
                        <i class="bi bi-arrow-right-circle-fill"></i> Continuar
                    </button>
                    <button type="button" class="btn btn-warning d-none" id="btnPausarReview">
                        <i class="bi bi-pause-fill"></i> Pausar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div style="display:none">@Html.AntiForgeryToken()</div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let tratamientosTabla;
        let hijosTratPorPadre = {};

        // ===== HELPERS GLOSARIO TRATAMIENTOS =====
        function nivelBadgeTrat(level) {
            if (!level && level !== 0) return '<span class="text-muted small fst-italic">—</span>';
            const map = { 1: ['\uD83D\uDFE2', 'Directa', 'success'], 2: ['\uD83D\uDFE1', 'Indirecta', 'warning'], 3: ['\uD83D\uDD35', 'Secundaria', 'info'] };
            const [icon, label, color] = map[level] || ['\u26AA', 'Desconocido', 'secondary'];
            return `<span class="badge bg-${color}">${icon} ${label}</span>`;
        }

        function renderValidacionesTrat(validations) {
            if (!validations || validations.length === 0)
                return '<p class="text-muted small mb-0 fst-italic">Sin validaciones registradas</p>';
            const typeLabels = { 1: 'Descripci\u00f3n', 2: 'Relaci\u00f3n' };
            return validations.map(v => {
                const date = new Date(v.createdAt).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: '2-digit' });
                const typeLabel = typeLabels[v.validationType] || 'Validaci\u00f3n';
                const levelHtml = v.relationTypeId ? nivelBadgeTrat(v.relationTypeId) : '';
                const commentHtml = v.comment ? `<p class="mb-0 small text-dark mt-1">&ldquo;${v.comment}&rdquo;</p>` : '';
                return `<div class="d-flex gap-2 align-items-start mb-2 p-2 rounded" style="background:#fff;border:1px solid #e5e7eb;">
                    <i class="bi bi-person-circle text-secondary flex-shrink-0 mt-1" aria-label="privado" title="privado" style="font-size:1.1rem;"></i>
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                            <span class="fw-semibold small">${v.userDisplay}</span>
                            <span class="badge bg-secondary" style="font-size:.65rem;">${typeLabel}</span>
                            ${levelHtml}
                            <small class="text-muted ms-auto">${date}</small>
                        </div>
                        ${commentHtml}
                    </div>
                </div>`;
            }).join('');
        }

        function cargarGlosarioTratamiento(id) {
            $('#editTratamiento_glosarioBlock').hide();
            $.get('/api/admin/tratamientos/' + id + '/glossary', function (g) {
                if (!g || !g.ok || !g.hasGlossaryTerm) return;
                $('#editTratamiento_glosarioTermId').text('#' + g.glossaryTermId);
                $('#editTratamiento_nivelIA').html(nivelBadgeTrat(g.nivelSugerido));
                $('#editTratamiento_nivelConfirmado').html(nivelBadgeTrat(g.nivelConfirmado));
                if (g.aiReasoning) {
                    $('#editTratamiento_reasoning').text(g.aiReasoning);
                    $('#editTratamiento_reasoningBlock').show();
                } else {
                    $('#editTratamiento_reasoningBlock').hide();
                }
                $('#editTratamiento_validaciones').html(renderValidacionesTrat(g.validations));
                $('#editTratamiento_glosarioBlock').show();
            });
        }

        function actualizarDiccionarioHijosTratamientos(data) {
            hijosTratPorPadre = {};
            data.forEach(item => {
                if (item.idPadre && item.idPadre !== 0) {
                    if (!hijosTratPorPadre[item.idPadre]) {
                        hijosTratPorPadre[item.idPadre] = [];
                    }
                    hijosTratPorPadre[item.idPadre].push(item.id);
                }
            });
        }

        $(function () {
            $.ajaxSetup({
                beforeSend: function(xhr, settings) {
                    if (settings.type === 'POST' || settings.type === 'PUT' || settings.type === 'DELETE') {
                        xhr.setRequestHeader('RequestVerificationToken',
                            $('input[name="__RequestVerificationToken"]').val());
                    }
                }
            });
            tratamientosTabla = $('#tratamientosGrid').DataTable({
                processing: true,
                serverSide: true,
                scrollX: true,
                scrollCollapse: true,
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'POST',
                    cache: false,
                    data: function (d) {
                        d.mostrarEliminados = $('#switchEliminadosTratamientos').is(':checked');
                        d.filtroTriage = $('#filtroTriage').val();
                    },
                    dataSrc: function (json) {
                        console.log('Datos recibidos del servidor:', json);
                        actualizarDiccionarioHijosTratamientos(json.data);
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'nombre',
                        orderable: false,
                        render: function (data, type, row) {
                            if (!row.esPadre && row.idPadre) {
                                return `<span class="trat-hijo">- ${data}</span>`;
                            }
                            return `<span class="trat-padre">${data}</span>`;
                        }
                    },
                    {
                        data: 'esPadre',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Padre</span>`
                                : `<span class="badge badge-grid-gray">Hijo</span>`;
                        }
                    },
                    { data: 'idPadre', orderable: false, defaultContent: '' },
                    { data: 'idIdioma', orderable: false },
                    // ⭐ NUEVA COLUMNA: Validado IA
                    {
                        data: 'validadoIA',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<i class="bi bi-check-circle-fill text-success" title="Validado por IA"></i>' 
                                : '<i class="bi bi-dash-circle text-muted" title="No validado por IA"></i>';
                        }
                    },
                    // ⭐ NUEVA COLUMNA: Validado Humano
                    {
                        data: 'validadoHumano',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<i class="bi bi-person-check-fill text-primary" title="Validado por Humano"></i>' 
                                : '<i class="bi bi-dash-circle text-muted" title="No validado por Humano"></i>';
                        }
                    },
                    // ⭐ NUEVA COLUMNA: Relación EII
                    {
                        data: 'relacionEII',
                        orderable: false,
                        render: function (data) {
                            return data 
                                ? '<span class="badge bg-success">Sí</span>' 
                                : '<span class="badge bg-secondary">No</span>';
                        }
                    },
                    // Triage de limpieza (eje 1) — independiente de la relación con EII (eje 2)
                    {
                        data: 'triageEstado',
                        orderable: false,
                        render: function (data, type, row) {
                            const motivo = (row.triageMotivo || '').replace(/"/g, '&quot;');
                            if (data === 1) return `<span class="badge bg-success" title="${motivo}">Válido</span>`;
                            if (data === 2) return `<span class="badge bg-danger" title="${motivo}">Basura</span>`;
                            if (data === 3) return `<span class="badge bg-warning text-dark" title="${motivo}">Dudoso</span>`;
                            return '<span class="badge badge-grid-gray">Sin revisar</span>';
                        }
                    },
                    {
                        data: 'eliminado',
                        orderable: false,
                        render: function (data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Sí</span>`
                                : `<span class="badge badge-grid-gray">No</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            let editBtn = `<button class='btn btn-sm btn-action-tratamiento btn-editar-tratamiento' title='Editar' data-id='${row.id}'><i class="bi bi-pencil-square"></i> Editar</button>`;
                            let eliminarBtn = '', restaurarBtn = '';
                            const esPadre = row.esPadre;
                            const tieneHijos = hijosTratPorPadre[row.id] && hijosTratPorPadre[row.id].length > 0;
                            if (row.eliminado) {
                                restaurarBtn = `<button class='btn btn-sm btn-success btn-restaurar-tratamiento ms-1' title='Restaurar' data-id='${row.id}'><i class="bi bi-arrow-counterclockwise"></i> Restaurar</button>`;
                            } else {
                                if (!(esPadre && tieneHijos)) {
                                    eliminarBtn = `<button class='btn btn-sm btn-danger btn-borrar-tratamiento ms-1' title='Eliminar' data-id='${row.id}'><i class="bi bi-trash"></i> Eliminar</button>`;
                                }
                            }
                            return editBtn + eliminarBtn + restaurarBtn;
                        }
                    }
                ],
                order: [],
                language: {
                    emptyTable: "No hay tratamientos registrados."
                }
            });

            $('#switchEliminadosTratamientos').change(function () {
                tratamientosTabla.ajax.reload();
            });

            $('#filtroTriage').change(function () {
                tratamientosTabla.ajax.reload();
            });

            $('#tratamientosGrid').on('click', '.btn-editar-tratamiento', function () {
                const id = $(this).data('id');

                // Cargar datos del tratamiento usando la API nueva
                $.get('/api/admin/tratamientos/' + id, function (data) {
                    console.log('API response:', data);

                    if (!data || !data.ok) {
                        alert('Error: ' + (data?.error || 'No se pudo obtener el tratamiento.'));
                        return;
                    }

                    // Rellenar formulario
                    $('#editTratamiento_id').val(data.id);
                    $('#editTratamiento_nombre').val(data.nombre || '');
                    $('#editTratamiento_idPadre').val(data.idPadre || "");
                    $('#editTratamiento_idIdioma').val(data.idIdioma || '');
                    $('#editTratamiento_icono').val(data.icono || "");
                    $('#editTratamiento_descripcionIA').val(data.descripcionIA || "");
                    $('#editTratamiento_validadoHumano').prop('checked', data.validadoHumano || false);

                    // ⭐ MOSTRAR RELACIÓN EII CON EXPLICACIÓN
                    if (data.relacionEII) {
                        $('#editTratamiento_relacionEIIContainer').show();
                        $('#editTratamiento_noRelacionEIIContainer').hide();
                        $('#editTratamiento_relacionEIITexto').text(data.relacionEIIDescripcion || 'Tratamiento documentado para EII');

                        // ⭐ MOSTRAR FUENTES SOLO SI EXISTEN Y SON REALES
                        if (data.fuentes && data.fuentes.trim() !== '') {
                            $('#editTratamiento_fuentes').text(data.fuentes);
                            $('#editTratamiento_fuentesContainer').show();
                            $('#editTratamiento_noFuentesDisclaimer').hide();
                        } else {
                            $('#editTratamiento_fuentesContainer').hide();
                            $('#editTratamiento_noFuentesDisclaimer').show();
                        }
                    } else {
                        $('#editTratamiento_relacionEIIContainer').hide();
                        $('#editTratamiento_noRelacionEIIContainer').show();
                    }

                    $('#editTratamiento_activo').prop('checked', !data.eliminado);
                    $('#msgEditTratamientoSuccess').addClass('d-none');

                    // Mostrar panel lateral
                    $('#panelEditarTratamiento').addClass('active');
                    cargarGlosarioTratamiento(data.id);

                    // ⭐ NUEVO: Recalcular DataTable después de abrir el panel
                    setTimeout(function() {
                        tratamientosTabla.columns.adjust().draw(false);
                    }, 350);
                }).fail(function (xhr, status, error) {
                    console.error('API failed:', status, error, xhr.responseText);
                    alert('Error al obtener el tratamiento: ' + (xhr.responseJSON?.error || error));
                });
            });

            // ⭐ NUEVO: Cerrar panel lateral
            $('#btnCerrarPanel, #btnCancelar').on('click', function () {
                $('#panelEditarTratamiento').removeClass('active');
                $('#msgEditTratamientoSuccess').addClass('d-none');

                // ⭐ NUEVO: Recalcular DataTable después de cerrar el panel
                setTimeout(function() {
                    tratamientosTabla.columns.adjust().draw(false);
                }, 350);
            });

            // ⭐ NUEVO: Botón Generar IA
            $('#btnGenerarIA').on('click', function () {
                const id = $('#editTratamiento_id').val();
                const $btn = $(this);
                const $icon = $btn.find('i');
                const $span = $btn.find('span');

                if (!id) {
                    alert('Error: No hay tratamiento seleccionado');
                    return;
                }

                // Deshabilitar botón y mostrar loading
                $btn.prop('disabled', true);
                $icon.removeClass('bi-stars').addClass('d-none');
                $btn.prepend('<span class="loading-spinner"></span>');
                $span.text('Generando...');

                // Llamar a la API
                $.ajax({
                    url: `/api/admin/tratamientos/${id}/generate-ia-description`,
                    type: 'POST',
                    contentType: 'application/json',
                    success: function (data) {
                        if (data.ok) {
                            // Llenar el textarea con la descripción generada
                            $('#editTratamiento_descripcionIA').val(data.descripcion);

                            // ⭐ ACTUALIZAR NOMBRE SI FUE TRADUCIDO
                            if (data.nombreTraducido && data.nombreTraducido.trim() !== '') {
                                const nombreActual = $('#editTratamiento_nombre').val();
                                if (data.nombreTraducido !== nombreActual) {
                                    $('#editTratamiento_nombre').val(data.nombreTraducido);
                                    agregarLog('info', `📝 Nombre traducido: ${nombreActual} → ${data.nombreTraducido}`);
                                }
                            }

                            // ⭐ ACTUALIZAR RELACIÓN EII CON EXPLICACIÓN
                            if (data.relacionEII) {
                                $('#editTratamiento_relacionEIIContainer').show();
                                $('#editTratamiento_noRelacionEIIContainer').hide();
                                $('#editTratamiento_relacionEIITexto').text(data.relacionEIITexto || 'Tratamiento documentado para EII');

                                // ⭐ MOSTRAR FUENTES SOLO SI EXISTEN Y SON REALES
                                if (data.fuentes && data.fuentes.trim() !== '') {
                                    $('#editTratamiento_fuentes').text(data.fuentes);
                                    $('#editTratamiento_fuentesContainer').show();
                                    $('#editTratamiento_noFuentesDisclaimer').hide();
                                } else {
                                    $('#editTratamiento_fuentesContainer').hide();
                                    $('#editTratamiento_noFuentesDisclaimer').show();
                                }
                            } else {
                                $('#editTratamiento_relacionEIIContainer').hide();
                                $('#editTratamiento_noRelacionEIIContainer').show();
                            }

                            // Mostrar mensaje de éxito
                            let mensaje = '✅ Descripción generada exitosamente por IA';
                            if (data.nombreTraducido) {
                                mensaje += '\n\n📝 El nombre fue traducido al español';
                            }
                            alert(mensaje);

                            // Recargar el grid para mostrar el checkmark de ValidadoIA
                            tratamientosTabla.ajax.reload(null, false);
                            const tid = $('#editTratamiento_id').val();
                            if (tid) cargarGlosarioTratamiento(parseInt(tid));
                        } else {
                            alert('Error: ' + (data.error || 'No se pudo generar la descripción'));
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error generando IA:', error, xhr.responseText);
                        alert('Error al generar descripción: ' + (xhr.responseJSON?.error || error));
                    },
                    complete: function () {
                        // Restaurar botón
                        $btn.prop('disabled', false);
                        $btn.find('.loading-spinner').remove();
                        $icon.removeClass('d-none').addClass('bi-stars');
                        $span.text('Generar con IA');
                    }
                });
            });

            $('#formEditarTratamiento').on('submit', function (e) {
                e.preventDefault();
                const id = $('#editTratamiento_id').val();

                // Preparar datos para enviar usando la API
                const requestData = {
                    nombre: $('#editTratamiento_nombre').val(),
                    idPadre: $('#editTratamiento_idPadre').val() ? parseInt($('#editTratamiento_idPadre').val()) : null,
                    idIdioma: parseInt($('#editTratamiento_idIdioma').val()),
                    icono: $('#editTratamiento_icono').val(),
                    eliminado: !$('#editTratamiento_activo').is(':checked'),
                    descripcionIA: $('#editTratamiento_descripcionIA').val(),
                    validadoHumano: $('#editTratamiento_validadoHumano').is(':checked')
                };

                $.ajax({
                    url: `/api/admin/tratamientos/${id}`,
                    type: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        console.log('Respuesta del servidor al guardar:', response);
                        if (response.ok) {
                            $('#msgEditTratamientoSuccess').removeClass('d-none');

                            console.log('Recargando grid de tratamientos...');

                            // ⭐ RECARGAR GRID INMEDIATAMENTE sin resetear paginación
                            tratamientosTabla.ajax.reload(function(json) {
                                console.log('Grid recargado. Registros:', json.recordsTotal);
                                console.log('Datos recibidos:', json.data);
                            }, false);

                            setTimeout(function () {
                                $('#panelEditarTratamiento').removeClass('active');
                                $('#msgEditTratamientoSuccess').addClass('d-none');

                                // ⭐ RECARGA ADICIONAL después de cerrar panel
                                console.log('Recarga adicional del grid...');
                                tratamientosTabla.ajax.reload(function() {
                                    console.log('Segunda recarga completada');
                                }, false);

                                // ⭐ FORZAR REDIBUJADO COMPLETO
                                tratamientosTabla.columns.adjust().draw(false);
                            }, 1500);
                        } else {
                            alert('Error: ' + (response.error || 'No se pudo guardar.'));
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al guardar:', error, xhr.responseText);
                        alert('Error al guardar: ' + (xhr.responseJSON?.error || error));
                    }
                });
            });

            $('#tratamientosGrid').on('click', '.btn-borrar-tratamiento', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea eliminar este tratamiento? Esta acción no se puede deshacer.')) {
                    $.ajax({
                        url: '@Url.Page(null, "EliminarTratamiento")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                tratamientosTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo eliminar.'));
                            }
                        }
                    });
                }
            });

            $('#tratamientosGrid').on('click', '.btn-restaurar-tratamiento', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea restaurar este tratamiento?')) {
                    $.ajax({
                        url: '@Url.Page(null, "RestaurarTratamiento")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                tratamientosTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo restaurar.'));
                            }
                        }
                    });
                }
            });

            // ⭐⭐⭐ ACTUALIZACIÓN MASIVA CON IA ⭐⭐⭐
            let batchSkip = 0;
            let batchRequestedTotal = 10; // total records user wants to process in this run
            let batchRequestedRemaining = 0;
            const batchChunk = 10; // sub-lote de 10
            const delayMsBetweenChunks = 5000; // 5 segundos
            let chunkTimeoutId = null;
            let totalExitosos = 0;
            let totalFallidos = 0;
            let batchEnProgreso = false;
            let batchPaused = false;

            // Abrir modal
            $('#btnActualizacionMasiva').on('click', function() {
                console.log('Abriendo modal de actualización masiva');
                batchSkip = 0;
                totalExitosos = 0;
                totalFallidos = 0;
                resetearEstadisticas();
                $('#modalActualizacionMasiva').modal('show');
            });

            // Iniciar procesamiento
            $('#btnIniciarBatch').on('click', function() {
                console.log('Click en Iniciar Batch');
                if (!confirm('¿Desea iniciar la actualización masiva? Este proceso puede tardar varios minutos.')) return;

                // Leer selección del combo
                batchRequestedTotal = parseInt($('#selectBatchSize').val() || '10', 10);
                batchRequestedRemaining = batchRequestedTotal;
                batchSkip = 0;
                totalExitosos = 0;
                totalFallidos = 0;
                batchPaused = false;
                $('#btnIniciarBatch').addClass('d-none');
                $('#btnPausarBatch').removeClass('d-none').prop('disabled', false);
                $('#btnContinuarBatch').addClass('d-none');
                procesarBatchChunk();
            });

            // Continuar (cuando estaba pausado o se desea procesar siguientes lotes en DB)
            $('#btnContinuarBatch').on('click', function() {
                console.log('Click en Continuar Batch');
                if (batchRequestedRemaining > 0) {
                    // continuar procesando lo que quedó seleccionado
                    batchPaused = false;
                    $('#btnContinuarBatch').addClass('d-none');
                    $('#btnPausarBatch').removeClass('d-none').prop('disabled', false);
                    procesarBatchChunk();
                } else {
                    // procesar siguientes del DB (comportamiento legacy)
                    batchRequestedRemaining = batchChunk;
                    $('#btnContinuarBatch').addClass('d-none');
                    procesarBatchChunk();
                }
            });

            // Pausar
            $('#btnPausarBatch').on('click', function() {
                console.log('Click en Pausar Batch');
                batchPaused = true;
                if (chunkTimeoutId) {
                    clearTimeout(chunkTimeoutId);
                    chunkTimeoutId = null;
                }
                $('#btnPausarBatch').addClass('d-none');
                $('#btnContinuarBatch').removeClass('d-none').prop('disabled', false);
                agregarLog('info', '⏸️ Proceso en pausa por el usuario');
            });

            // Cerrar modal
            $('#btnCerrar, #btnCerrarModal').on('click', function() {
                console.log('Click en Cerrar modal');
                if (batchEnProgreso) {
                    if (!confirm('Hay un proceso en curso. ¿Desea cancelarlo?')) {
                        return false;
                    }
                }
                batchPaused = true;
                if (chunkTimeoutId) { clearTimeout(chunkTimeoutId); chunkTimeoutId = null; }
                $('#modalActualizacionMasiva').modal('hide');
                tratamientosTabla.ajax.reload();
            });

            function resetearEstadisticas() {
                $('#progresoTexto').text('0 / 0 procesados');
                $('#progressBar').css('width', '0%').text('0%');
                $('#exitososCount').text('0');
                $('#fallidosCount').text('0');
                $('#pendientesCount').text('0');
                $('#logResultados').html('<p class="text-muted">Presiona "Iniciar Actualización" para comenzar...</p>');
                $('#btnIniciarBatch').removeClass('d-none');
                $('#btnContinuarBatch').addClass('d-none');
                $('#btnPausarBatch').addClass('d-none');
            }

            function procesarBatchChunk() {
                if (batchPaused) {
                    batchEnProgreso = false;
                    return;
                }

                batchEnProgreso = true;
                $('#btnContinuarBatch').prop('disabled', true).addClass('d-none');
                $('#btnPausarBatch').removeClass('d-none');
                $('#btnCerrar').prop('disabled', true);

                // take = mínimo entre chunk y lo que queda solicitado
                const takeNow = Math.min(batchChunk, batchRequestedRemaining > 0 ? batchRequestedRemaining : batchChunk);
                agregarLog('info', `🚀 Procesando registros ${batchSkip + 1} a ${batchSkip + takeNow}...`);

                $.ajax({
                    url: '/api/admin/tratamientos/batch-generate-ia',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ skip: batchSkip, take: takeNow }),
                    success: function(data) {
                        console.log('Respuesta del servidor:', data);
                        if (data.ok) {
                            const processed = data.procesados || (data.resultados ? data.resultados.length : 0);
                            totalExitosos += data.exitosos || 0;
                            totalFallidos += data.fallidos || 0;

                            // Actualizar estadísticas
                            $('#exitososCount').text(totalExitosos);
                            $('#fallidosCount').text(totalFallidos);
                            $('#pendientesCount').text(data.pendientes);

                            // Actualizar barra de progreso y texto (procesados / solicitados)
                            const totalProcesados = totalExitosos + totalFallidos;
                            if (batchRequestedTotal > 0) {
                                $('#progresoTexto').text(`${totalProcesados} / ${batchRequestedTotal} procesados`);
                                const pct = Math.min(100, Math.round((totalProcesados / batchRequestedTotal) * 100));
                                $('#progressBar').css('width', pct + '%').text(pct + '%');
                            } else {
                                $('#progresoTexto').text(`${totalProcesados} procesados`);
                            }

                            // Mostrar resultados
                            (data.resultados || []).forEach(function(item) {
                                if (item.success) {
                                    const eiiIcon = item.relacionEII ? '🔗' : '○';
                                    if (item.nombreOriginal && item.nombreOriginal !== item.nombre) {
                                        agregarLog('success', `✅ ${item.nombre} ${eiiIcon} (traducido de: ${item.nombreOriginal})`);
                                    } else {
                                        agregarLog('success', `✅ ${item.nombre} ${eiiIcon}`);
                                    }
                                } else {
                                    agregarLog('error', `❌ ${item.nombre} - ${item.error}`);
                                }
                            });

                            batchSkip += processed;

                            // Reducir contador solicitado (si aplica)
                            if (batchRequestedRemaining > 0) {
                                batchRequestedRemaining -= processed;
                            }

                            if (batchRequestedRemaining > 0) {
                                // aún faltan sub-lotes por procesar en esta ejecución
                                agregarLog('info', `✋ Sub-lote completado. Quedan ${batchRequestedRemaining} registros de los ${batchRequestedTotal} solicitados.`);
                                // esperar y ejecutar siguiente sub-lote (guardable/cancelable)
                                chunkTimeoutId = setTimeout(function() {
                                    if (!batchPaused) procesarBatchChunk();
                                    chunkTimeoutId = null;
                                }, delayMsBetweenChunks);
                            } else if (data.pendientes > 0) {
                                // completamos lo solicitado, pero hay más en la BD
                                agregarLog('info', `✋ Lote completo. Quedan ${data.pendientes} registros pendientes en la BD.`);
                                $('#btnContinuarBatch').prop('disabled', false).removeClass('d-none');
                                $('#btnPausarBatch').addClass('d-none');
                            } else {
                                agregarLog('success', `🎉 ¡Proceso completado! Total: ${totalExitosos} exitosos, ${totalFallidos} fallidos.`);
                                $('#btnContinuarBatch').addClass('d-none');
                                $('#btnPausarBatch').addClass('d-none');
                                $('#progressBar').removeClass('progress-bar-animated').addClass('bg-success').css('width', '100%').text('100%');
                            }
                        } else {
                            agregarLog('error', `❌ Error: ${data.error}`);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error en batch:', error, xhr.responseText);
                        agregarLog('error', `❌ Error al procesar lote: ${xhr.responseJSON?.error || error}`);
                        $('#btnContinuarBatch').prop('disabled', false).removeClass('d-none');
                        $('#btnPausarBatch').addClass('d-none');
                    },
                    complete: function() {
                        batchEnProgreso = false;
                        $('#btnCerrar').prop('disabled', false);
                    }
                });
            }

            // ===== TRIAGE DE LIMPIEZA CON NINA =====
            // Mismo patrón que la actualización masiva: el selector es el TOTAL de la corrida y
            // el cliente lo parte en sub-lotes de 10 para no reventar el timeout de la petición
            // (cada registro = una llamada a la IA). El endpoint no lleva Skip: reanuda solo,
            // tomando siempre los siguientes sin revisar.
            let reviewRequestedTotal = 100;
            let reviewRemaining = 0;
            const reviewChunk = 10;
            let reviewTimeoutId = null;
            let reviewPaused = false;
            let reviewEnProgreso = false;
            let reviewDryRun = true;
            let reviewRaizId = null;   // rama congelada al arrancar la corrida
            let totValidos = 0, totBasura = 0, totDudosos = 0, totProtegidos = 0, totFallidosNina = 0, totDesactivados = 0;

            $('#switchDryRun').on('change', function () {
                $('#avisoDryRunOff').toggleClass('d-none', $(this).is(':checked'));
            });

            // Catálogo de ramas (categorías raíz) con su avance de triage.
            let ramasCache = [];

            function raizSeleccionada() {
                const v = $('#selectRama').val();
                return v ? parseInt(v, 10) : null;
            }

            function cargarRamas(preservarSeleccion) {
                const previa = preservarSeleccion ? $('#selectRama').val() : null;
                return $.get('/api/admin/tratamientos/ramas', function (data) {
                    if (!data.ok) return;
                    ramasCache = data.ramas || [];
                    const opciones = ['<option value="">Todo el catálogo (por id)</option>'];
                    ramasCache.forEach(function (r) {
                        opciones.push(
                            `<option value="${r.raizId}">${r.categoria} — ${r.sinRevisar} sin revisar` +
                            (r.basuraPendiente ? ` · ${r.basuraPendiente} basura` : '') +
                            (r.dudosos ? ` · ${r.dudosos} dudosos` : '') +
                            `</option>`);
                    });
                    $('#selectRama').html(opciones.join(''));
                    if (previa !== null) $('#selectRama').val(previa);
                    actualizarInfoBasura();
                });
            }

            function actualizarInfoBasura() {
                const raiz = raizSeleccionada();
                const rama = raiz === null ? null : ramasCache.find(r => r.raizId === raiz);
                const pendiente = rama
                    ? rama.basuraPendiente
                    : ramasCache.reduce((acc, r) => acc + r.basuraPendiente, 0);
                const donde = rama ? `en "${rama.categoria}"` : 'en todo el catálogo';
                $('#basuraRamaInfo').text(
                    pendiente > 0
                        ? `${pendiente} marcados como Basura sin desactivar ${donde}.`
                        : `No hay nada marcado como Basura ${donde}.`);
                $('#btnAplicarBasura').prop('disabled', pendiente === 0);
            }

            $('#selectRama').on('change', actualizarInfoBasura);

            $('#btnRevisarNina').on('click', function () {
                resetearEstadisticasNina();
                cargarRamas(false);
                $('#modalRevisarNina').modal('show');
            });

            // Paso destructivo. El conteo de la confirmación sale del MISMO helper del servidor
            // que hace la aplicación, así que lo que se confirma es lo que ocurre.
            $('#btnAplicarBasura').on('click', function () {
                const raiz = raizSeleccionada();
                const $btn = $(this).prop('disabled', true);
                const url = '/api/admin/tratamientos/basura-preview' + (raiz ? `?raizId=${raiz}` : '');

                $.get(url, function (prev) {
                    if (!prev.ok) { agregarLogNina('error', '❌ No se pudo calcular el conteo previo'); $btn.prop('disabled', false); return; }

                    if (prev.aDesactivar === 0) {
                        agregarLogNina('info', `Nada que aplicar: 0 desactivables (${prev.bloqueados} bloqueados por guard).`);
                        $btn.prop('disabled', false);
                        return;
                    }

                    const rama = raiz === null ? 'TODO el catálogo' : `la rama "${ramasCache.find(r => r.raizId === raiz)?.categoria}"`;
                    const msg = `Se van a DESACTIVAR ${prev.aDesactivar} tratamientos en ${rama}.\n\n` +
                                `Bloqueados por guard (no se tocan): ${prev.bloqueados}\n` +
                                `Total marcado como Basura: ${prev.total}\n\n` +
                                `Es reversible con Restaurar o con el UPDATE en bloque.\n\n¿Aplicar?`;
                    if (!confirm(msg)) { $btn.prop('disabled', false); return; }

                    $.ajax({
                        url: '/api/admin/tratamientos/batch-apply-basura',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ raizId: raiz }),
                        success: function (data) {
                            if (!data.ok) { agregarLogNina('error', `❌ ${data.error}`); return; }
                            agregarLogNina('success', `🗑️ Aplicado: ${data.desactivados} desactivados, ${data.bloqueados} bloqueados por guard.`);
                            (data.bloqueadosDetalle || []).forEach(function (b) {
                                agregarLogNina('warn', `🛡️ ${b.nombre} — no desactivado: ${b.motivo}`);
                            });
                            if (data.desactivados !== prev.aDesactivar) {
                                agregarLogNina('warn', `⚠️ El conteo previo decía ${prev.aDesactivar} y se aplicaron ${data.desactivados}.`);
                            }
                            cargarRamas(true);
                            tratamientosTabla.ajax.reload();
                        },
                        error: function (xhr, status, error) {
                            agregarLogNina('error', `❌ Error al aplicar: ${xhr.responseJSON?.error || error}`);
                        },
                        complete: function () { $btn.prop('disabled', false); }
                    });
                }).fail(function () {
                    agregarLogNina('error', '❌ Error al calcular el conteo previo');
                    $btn.prop('disabled', false);
                });
            });

            $('#btnIniciarReview').on('click', function () {
                reviewDryRun = $('#switchDryRun').is(':checked');

                if (!reviewDryRun) {
                    if (!confirm('Dry-run DESACTIVADO: los registros clasificados como Basura con confianza alta quedarán desactivados.\n\n¿Confirmas que ya revisaste los buckets del dry-run?')) return;
                } else {
                    if (!confirm('¿Iniciar la revisión en dry-run? Solo clasifica; no desactiva a nadie.')) return;
                }

                reviewRequestedTotal = parseInt($('#selectReviewSize').val() || '100', 10);
                reviewRemaining = reviewRequestedTotal;
                totValidos = totBasura = totDudosos = totProtegidos = totFallidosNina = totDesactivados = 0;
                reviewPaused = false;
                // Se congela la rama al arrancar: cambiar el select a media corrida movería el
                // alcance entre sub-lotes y los contadores dejarían de cuadrar.
                reviewRaizId = raizSeleccionada();
                const nombreRama = reviewRaizId === null
                    ? 'todo el catálogo'
                    : `"${ramasCache.find(r => r.raizId === reviewRaizId)?.categoria}"`;
                agregarLogNina('info', `📂 Rama: ${nombreRama}`);
                $('#selectReviewSize, #switchDryRun, #selectRama').prop('disabled', true);
                $('#btnIniciarReview').addClass('d-none');
                $('#btnPausarReview').removeClass('d-none').prop('disabled', false);
                $('#btnContinuarReview').addClass('d-none');
                procesarReviewChunk();
            });

            $('#btnContinuarReview').on('click', function () {
                if (reviewRemaining <= 0) reviewRemaining = reviewChunk;
                reviewPaused = false;
                $('#btnContinuarReview').addClass('d-none');
                $('#btnPausarReview').removeClass('d-none').prop('disabled', false);
                procesarReviewChunk();
            });

            $('#btnPausarReview').on('click', function () {
                reviewPaused = true;
                if (reviewTimeoutId) { clearTimeout(reviewTimeoutId); reviewTimeoutId = null; }
                $('#btnPausarReview').addClass('d-none');
                $('#btnContinuarReview').removeClass('d-none').prop('disabled', false);
                agregarLogNina('info', '⏸️ Revisión en pausa por el usuario');
            });

            $('#btnCerrarNina, #btnCerrarModalNina').on('click', function () {
                if (reviewEnProgreso && !confirm('Hay una revisión en curso. ¿Desea cancelarla?')) return false;
                reviewPaused = true;
                if (reviewTimeoutId) { clearTimeout(reviewTimeoutId); reviewTimeoutId = null; }
                $('#modalRevisarNina').modal('hide');
                tratamientosTabla.ajax.reload();
            });

            function resetearEstadisticasNina() {
                $('#progresoTextoNina').text('0 / 0 revisados');
                $('#progressBarNina').css('width', '0%').text('0%')
                    .addClass('progress-bar-animated').removeClass('bg-success');
                $('#validosCount, #basuraCount, #dudososCount, #protegidosCount, #pendientesNinaCount').text('0');
                $('#logResultadosNina').html('<p class="text-muted">Presiona "Iniciar revisión" para comenzar...</p>');
                $('#selectReviewSize, #switchDryRun, #selectRama').prop('disabled', false);
                $('#btnIniciarReview').removeClass('d-none');
                $('#btnContinuarReview').addClass('d-none');
                $('#btnPausarReview').addClass('d-none');
                $('#avisoDryRunOff').toggleClass('d-none', $('#switchDryRun').is(':checked'));
            }

            function procesarReviewChunk() {
                if (reviewPaused) { reviewEnProgreso = false; return; }

                reviewEnProgreso = true;
                $('#btnContinuarReview').prop('disabled', true).addClass('d-none');
                $('#btnPausarReview').removeClass('d-none');
                $('#btnCerrarNina').prop('disabled', true);

                const takeNow = Math.min(reviewChunk, reviewRemaining > 0 ? reviewRemaining : reviewChunk);
                agregarLogNina('info', `🔎 Clasificando ${takeNow} registros${reviewDryRun ? ' (dry-run)' : ''}...`);

                $.ajax({
                    url: '/api/admin/tratamientos/batch-review',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ take: takeNow, dryRun: reviewDryRun, raizId: reviewRaizId }),
                    success: function (data) {
                        if (!data.ok) {
                            agregarLogNina('error', `❌ Error: ${data.error}`);
                            return;
                        }

                        totValidos      += data.validos      || 0;
                        totBasura       += data.basura       || 0;
                        totDudosos      += data.dudosos      || 0;
                        totProtegidos   += data.protegidos   || 0;
                        totDesactivados += data.desactivados || 0;
                        totFallidosNina += data.fallidos     || 0;

                        $('#validosCount').text(totValidos);
                        $('#basuraCount').text(totBasura);
                        $('#dudososCount').text(totDudosos);
                        $('#protegidosCount').text(totProtegidos);
                        $('#pendientesNinaCount').text(data.pendientes);

                        const revisados = totValidos + totBasura + totDudosos + totFallidosNina;
                        $('#progresoTextoNina').text(`${revisados} / ${reviewRequestedTotal} revisados`);
                        const pct = Math.min(100, Math.round((revisados / reviewRequestedTotal) * 100));
                        $('#progressBarNina').css('width', pct + '%').text(pct + '%');

                        (data.resultados || []).forEach(function (item) {
                            if (!item.success) {
                                agregarLogNina('error', `❌ ${item.nombre} — ${item.error}`);
                                return;
                            }
                            const conf = item.confianza != null ? ` [${Number(item.confianza).toFixed(2)}]` : '';
                            if (item.protegido) {
                                agregarLogNina('info', `🛡️ ${item.nombre} — intacto (${item.motivo})`);
                            } else if (item.estado === 1) {
                                agregarLogNina('success', `✅ Válido${conf} — ${item.nombre}`);
                            } else if (item.estado === 2) {
                                const marca = item.desactivado ? ' · DESACTIVADO' : '';
                                agregarLogNina('error', `🗑️ Basura${conf}${marca} — ${item.nombre}: ${item.motivo}`);
                            } else {
                                agregarLogNina('warn', `❓ Dudoso${conf} — ${item.nombre}: ${item.motivo}`);
                            }
                        });

                        const procesadosAhora = data.procesados || 0;
                        if (reviewRemaining > 0) reviewRemaining -= procesadosAhora;

                        // El endpoint devolvió menos de lo pedido → ya no queda nada sin revisar
                        if (procesadosAhora === 0) {
                            agregarLogNina('success', `🎉 No quedan registros sin revisar. Total: ${totValidos} válidos, ${totBasura} basura, ${totDudosos} dudosos, ${totProtegidos} intactos.`);
                            finalizarReview(true);
                        } else if (reviewRemaining > 0) {
                            agregarLogNina('info', `✋ Sub-lote listo. Quedan ${reviewRemaining} de los ${reviewRequestedTotal} solicitados.`);
                            reviewTimeoutId = setTimeout(function () {
                                if (!reviewPaused) procesarReviewChunk();
                                reviewTimeoutId = null;
                            }, delayMsBetweenChunks);
                        } else {
                            agregarLogNina('success', `🎉 Corrida completa: ${totValidos} válidos, ${totBasura} basura (${totDesactivados} desactivados), ${totDudosos} dudosos, ${totProtegidos} intactos. Quedan ${data.pendientes} sin revisar en la BD.`);
                            finalizarReview(data.pendientes === 0);
                        }
                    },
                    error: function (xhr, status, error) {
                        agregarLogNina('error', `❌ Error al clasificar lote: ${xhr.responseJSON?.error || error}`);
                        $('#btnContinuarReview').prop('disabled', false).removeClass('d-none');
                        $('#btnPausarReview').addClass('d-none');
                    },
                    complete: function () {
                        reviewEnProgreso = false;
                        $('#btnCerrarNina').prop('disabled', false);
                    }
                });
            }

            function finalizarReview(todoListo) {
                $('#btnPausarReview').addClass('d-none');
                $('#selectReviewSize, #switchDryRun, #selectRama').prop('disabled', false);
                // Refrescar conteos: la corrida acaba de crear Basura pendiente de aplicar.
                cargarRamas(true);
                if (todoListo) {
                    $('#btnContinuarReview').addClass('d-none');
                    $('#btnIniciarReview').removeClass('d-none');
                    $('#progressBarNina').removeClass('progress-bar-animated')
                        .addClass('bg-success').css('width', '100%').text('100%');
                } else {
                    $('#btnContinuarReview').prop('disabled', false).removeClass('d-none');
                }
            }

            function agregarLogNina(tipo, mensaje) {
                const timestamp = new Date().toLocaleTimeString();
                let clase = '';
                switch (tipo) {
                    case 'success': clase = 'text-success'; break;
                    case 'error':   clase = 'text-danger'; break;
                    case 'warn':    clase = 'text-warning'; break;
                    case 'info':    clase = 'text-primary'; break;
                }
                $('#logResultadosNina').append(`<p class="${clase} mb-1"><small>[${timestamp}]</small> ${mensaje}</p>`);
                $('#logResultadosNina').scrollTop($('#logResultadosNina')[0].scrollHeight);
            }

            function agregarLog(tipo, mensaje) {
                const timestamp = new Date().toLocaleTimeString();
                let clase = '';
                switch(tipo) {
                    case 'success': clase = 'text-success'; break;
                    case 'error': clase = 'text-danger'; break;
                    case 'info': clase = 'text-primary'; break;
                }

                const logEntry = `<p class="${clase} mb-1"><small>[${timestamp}]</small> ${mensaje}</p>`;
                $('#logResultados').append(logEntry);
                $('#logResultados').scrollTop($('#logResultados')[0].scrollHeight);
            }
        });
    </script>
}