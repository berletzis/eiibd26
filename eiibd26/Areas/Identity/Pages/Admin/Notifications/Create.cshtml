@page
@model eiibd26.Areas.Identity.Pages.Admin.Notifications.CreateModel
@{
    ViewData["Title"] = "Nueva Notificación Push";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex align-items-center mb-4">
                <a asp-page="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 mb-1">ð± Nueva Notificación Push</h1>
                    <p class="text-muted mb-0">Crea y programa notificaciones para tus usuarios</p>
                </div>
            </div>

            <form method="post">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Tipo de Notificación</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Selecciona un template o crea personalizada:</label>

                            <!-- Template: Estado de Ánimo -->
                            <div class="card mb-2 template-card" data-template="mood" style="cursor:pointer;">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="bi bi-emoji-smile fs-4 text-primary"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong>¿Cómo te sientes hoy?</strong>
                                            <small class="d-block text-muted">Pregunta diaria de estado de ánimo con respuesta rápida</small>
                                        </div>
                                        <div>
                                            <span class="badge bg-success">Con acciones</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Template: Recordatorio Medicamento -->
                            <div class="card mb-2 template-card" data-template="medication" style="cursor:pointer;">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-info bg-opacity-10 p-2 rounded">
                                            <i class="bi bi-capsule fs-4 text-info"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong>Recordatorio de medicamento</strong>
                                            <small class="d-block text-muted">Pregunta si tomó su medicamento hoy</small>
                                        </div>
                                        <div>
                                            <span class="badge bg-success">Con acciones</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Template: Personalizada -->
                            <div class="card mb-2 template-card active" data-template="custom" style="cursor:pointer;">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-secondary bg-opacity-10 p-2 rounded">
                                            <i class="bi bi-pencil-square fs-4 text-secondary"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong>Notificación personalizada</strong>
                                            <small class="d-block text-muted">Crea tu propia Notificación con contenido personalizado</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="Input.TemplateType" id="templateType" value="custom" />
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4" id="customContentSection">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Contenido de la Notificación</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.Title" class="form-label">
                                Título <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Title" class="form-control" maxlength="100" required />
                            <span asp-validation-for="Input.Title" class="text-danger"></span>
                            <small class="text-muted">Máximo 100 caracteres</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Body" class="form-label">
                                Mensaje <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Input.Body" class="form-control" rows="3" maxlength="500" required></textarea>
                            <span asp-validation-for="Input.Body" class="text-danger"></span>
                            <small class="text-muted">Máximo 500 caracteres</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Tipo" class="form-label">
                                Tipo de notificación <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.Tipo" class="form-select" id="inputTipo">
                                <option value="General">📢 General</option>
                                <option value="Mood">😊 Mood (estado de ánimo)</option>
                                <option value="Recordatorio">💊 Recordatorio</option>
                                <option value="Respuesta">💬 Respuesta</option>
                            </select>
                            <span asp-validation-for="Input.Tipo" class="text-danger"></span>
                            <small class="text-muted">Determina las acciones rápidas disponibles en la notificación</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Url" class="form-label">
                                URL de destino (opcional)
                            </label>
                            <input asp-for="Input.Url" class="form-control" placeholder="/Preguntas" />
                            <span asp-validation-for="Input.Url" class="text-danger"></span>
                            <small class="text-muted">Ejemplos: /Preguntas, /Contenidos/articulo-slug, https://ejemplo.com</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Icon" class="form-label">
                                Ícono personalizado (opcional)
                            </label>
                            <input asp-for="Input.Icon" class="form-control" placeholder="/img/icons/icon-192x192.png" />
                            <span asp-validation-for="Input.Icon" class="text-danger"></span>
                            <small class="text-muted">URL absoluta o relativa de la imagen</small>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Destinatarios</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Enviar a:</label>
                            <div class="form-check">
                                <input asp-for="Input.SendToAll" class="form-check-input" type="radio" value="true" id="sendToAll" checked />
                                <label class="form-check-label" for="sendToAll">
                                    <i class="bi bi-people-fill text-primary"></i>
                                    <strong>Todos los usuarios</strong>
                                    <small class="text-muted d-block">(@Model.TotalSubscribers suscriptores activos)</small>
                                </label>
                            </div>
                            <div class="form-check mt-2">
                                <input asp-for="Input.SendToAll" class="form-check-input" type="radio" value="false" id="sendToSpecific" />
                                <label class="form-check-label" for="sendToSpecific">
                                    <i class="bi bi-person-check text-info"></i>
                                    <strong>Usuarios específicos</strong>
                                    <small class="text-muted d-block">Por email o filtros</small>
                                </label>
                            </div>
                        </div>

                        <div id="specificUsersSection" style="display:none;">
                            <hr class="my-3" />

                            <!-- Por Email -->
                            <div class="mb-3">
                                <label asp-for="Input.TargetEmails" class="form-label">
                                    <i class="bi bi-envelope"></i> Emails de usuarios <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Input.TargetEmails" class="form-control" rows="4" 
                                          placeholder="usuario1@email.com, usuario2@email.com, usuario3@email.com"></textarea>
                                <small class="text-muted">Separa múltiples emails con comas</small>
                                <span asp-validation-for="Input.TargetEmails" class="text-danger"></span>
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <strong>Nota:</strong> Solo se enviarán notificaciones a usuarios que:
                                <ul class="mb-0 mt-2">
                                    <li>Tengan cuenta registrada con esos emails</li>
                                    <li>Estén suscritos a notificaciones push</li>
                                </ul>
                            </div>

                            <div class="alert alert-secondary">
                                <i class="bi bi-lightbulb"></i>
                                <strong>Próximamente:</strong> Filtros por condiciones, síntomas y tratamientos
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Programación</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">¿Cuándo enviar?</label>
                            <div class="form-check">
                                <input asp-for="Input.SendNow" class="form-check-input" type="radio" value="true" checked />
                                <label class="form-check-label" asp-for="Input.SendNow">
                                    <i class="bi bi-send text-success"></i>
                                    <strong>Enviar inmediatamente</strong>
                                </label>
                            </div>
                            <div class="form-check mt-2">
                                <input asp-for="Input.SendNow" class="form-check-input" type="radio" value="false" id="scheduleRadio" />
                                <label class="form-check-label" for="scheduleRadio">
                                    <i class="bi bi-calendar-event text-warning"></i>
                                    <strong>Programar envío</strong>
                                </label>
                            </div>
                        </div>

                        <div id="scheduleFields" style="display:none;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.ScheduledDate" class="form-label">Fecha</label>
                                    <input asp-for="Input.ScheduledDate" class="form-control" type="date" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.ScheduledTime" class="form-label">Hora (local del servidor)</label>
                                    <input asp-for="Input.ScheduledTime" class="form-control" type="time" />
                                    <small class="text-muted d-block mt-1">
                                        <i class="bi bi-clock"></i> Hora actual del servidor: <strong>@DateTime.Now.ToString("HH:mm")</strong>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Preview Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Vista Previa</h5>
                    </div>
                    <div class="card-body bg-light">
                        <div class="notification-preview p-3 bg-white rounded shadow-sm" style="max-width: 400px;">
                            <div class="d-flex align-items-start gap-3">
                                <img id="preview-icon" src="/img/icons/icon-72x72.png" width="48" height="48" class="rounded" alt="Icon" />
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong id="preview-title" class="text-dark">Título de la Notificación</strong>
                                        <small class="text-muted">ahora</small>
                                    </div>
                                    <p id="preview-body" class="mb-0 text-muted small">Mensaje de la Notificación...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Crear Notificación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Template selection
        const templates = {
            mood: {
                title: '¿Cómo te sientes hoy?',
                body: 'Comparte tu estado de ánimo con la comunidad',
                icon: '/img/icons/icon-192x192.png',
                url: '',
                tipo: 'Mood'
            },
            medication: {
                title: '¿Tomaste tu medicamento?',
                body: 'Recuerda tomar tu medicamento de hoy',
                icon: '/img/icons/icon-192x192.png',
                url: '',
                tipo: 'Recordatorio'
            }
        };

        // Handle template selection
        document.querySelectorAll('.template-card').forEach(card => {
            card.addEventListener('click', function() {
                // Remove active from all
                document.querySelectorAll('.template-card').forEach(c => {
                    c.classList.remove('active', 'border-primary');
                });

                // Add active to clicked
                this.classList.add('active', 'border-primary');

                const template = this.dataset.template;
                document.getElementById('templateType').value = template;

                const customSection = document.getElementById('customContentSection');

                if (template === 'custom') {
                    // Show custom fields
                    customSection.style.display = 'block';
                } else if (templates[template]) {
                    // Fill with template data
                    document.getElementById('Input_Title').value = templates[template].title;
                    document.getElementById('Input_Body').value = templates[template].body;
                    document.getElementById('Input_Icon').value = templates[template].icon;
                    document.getElementById('Input_Url').value = templates[template].url;
                    document.getElementById('inputTipo').value = templates[template].tipo;

                    // Hide custom section
                    customSection.style.display = 'none';

                    // Update preview
                    updatePreview();
                }
            });
        });

        // Toggle schedule fields
        document.querySelectorAll('input[name="Input.SendNow"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const scheduleFields = document.getElementById('scheduleFields');
                scheduleFields.style.display = this.value === 'false' ? 'block' : 'none';
            });
        });

        // Toggle specific users section
        document.querySelectorAll('input[name="Input.SendToAll"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const specificSection = document.getElementById('specificUsersSection');
                specificSection.style.display = this.value === 'false' ? 'block' : 'none';
            });
        });

        // Live preview
        function updatePreview() {
            const title = document.getElementById('Input_Title').value || 'Título de la Notificación';
            const body = document.getElementById('Input_Body').value || 'Mensaje de la Notificación...';
            const icon = document.getElementById('Input_Icon').value || '/img/icons/icon-72x72.png';

            document.getElementById('preview-title').textContent = title;
            document.getElementById('preview-body').textContent = body;
            document.getElementById('preview-icon').src = icon;
        }

        document.getElementById('Input_Title').addEventListener('input', updatePreview);
        document.getElementById('Input_Body').addEventListener('input', updatePreview);
        document.getElementById('Input_Icon').addEventListener('input', updatePreview);
    </script>

    <style>
        .template-card {
            transition: all 0.2s;
        }
        .template-card:hover {
            border-color: var(--eii-primary) !important;
            box-shadow: 0 2px 8px rgba(106, 78, 122, 0.15);
        }
        .template-card.active {
            border: 2px solid var(--eii-primary) !important;
            background-color: rgba(106, 78, 122, 0.05);
        }
    </style>
}
