@page
@model eiibd26.Areas.Identity.Pages.Admin.Laboratorios.ResultadosModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <style>
        .crm-container-admin { max-width: 1320px; margin: 0 auto 30px auto; padding: 0 10px; }
        .crm-title-admin { font-size: 2.08rem; font-weight: 600; letter-spacing: -.07em; color: #14253f; margin-bottom: .7em; }
        .block-admin-uniform { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(40,60,120,.08); padding: 30px 32px 18px; margin-bottom: 36px; border: 1px solid #dde6f1; }
        .table-centered-admin { background: #fff; border-radius: 18px; box-shadow: 0 2px 16px rgba(70,80,120,.07); padding: 20px 22px 9px; }
        .dt-controls-flex { max-width: 1320px; margin: 0 auto 8px; display: flex; align-items: center; justify-content: space-between; gap: 1.5em; flex-wrap: wrap; }
        .dt-controls-left, .dt-controls-right { display: flex; align-items: center; gap: 1.5em; flex-wrap: wrap; }
        #resGrid th { background: #eef4fa !important; color: #3d436c !important; font-weight: 600 !important; border-bottom: 2.7px solid #ddeaf7 !important; }
        #resGrid td { background: #fff !important; border-bottom: 1.1px solid #f2f7fd !important; padding-top: 11px !important; padding-bottom: 11px !important; font-size: .95em; }
        #resGrid tr:nth-child(even) td { background: #f9fbfc !important; }
        .badge-grid-gray { background: #ededed !important; color: #191919 !important; font-weight: 600; font-size: .9em; border-radius: 9px; border: 1px solid #ddd; padding: 4px 10px; }
        .badge-elim { background: #fee2e2 !important; color: #991b1b !important; border-color: #fca5a5; }
        .dataTables_filter input { width: 220px; border-radius: 7px; border: 1px solid #dbe3f2; padding: .38em 1em; background: #f8fafd; margin-left: .4em; }
        .dataTables_paginate { display: flex; justify-content: flex-end; padding: .55em .25em; }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Laboratorios — Resultados</h2>

    <div class="block-admin-uniform mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="mb-2 fs-4">
                    <i class="bi bi-journal-medical me-2" style="font-size:1.4em;color:#3196fa;vertical-align:middle"></i>
                    Resultados de pacientes
                </div>
                <div class="text-muted mb-2">Consulta los resultados de laboratorio registrados por los pacientes.</div>
            </div>
            <a href="/Identity/Admin/Laboratorios/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-ul me-1"></i> Ver catálogo
            </a>
        </div>
    </div>

    <div class="dt-controls-flex">
        <div class="dt-controls-left"><div id="gridLengthWrapper"></div></div>
        <div class="dt-controls-right"><div id="gridSearchWrapper"></div></div>
    </div>

    <div class="table-centered-admin">
        <table id="resGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Paciente</th>
                    <th>Estudio</th>
                    <th>Categoría</th>
                    <th>Resultado</th>
                    <th>Unidad</th>
                    <th>Fecha resultado</th>
                    <th>Registrado</th>
                    <th>Estado</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script>
$(function() {
    const tabla = $('#resGrid').DataTable({
        processing: true, serverSide: true, dom: 'lfrtip',
        ajax: { url: '@Url.Page(null, "GridData")', type: 'GET' },
        columns: [
            { data: 'email',       orderable: false },
            { data: 'tipoPadre',   orderable: false, render: v => `<span class="badge badge-grid-gray">${v}</span>` },
            { data: 'tipoNombre',  orderable: false },
            { data: 'resultValue', orderable: false, render: v => `<strong>${v}</strong>` },
            { data: 'resultUnit',  orderable: false, defaultContent: '—' },
            { data: 'resultDate',  orderable: false },
            { data: 'fechaCreado', orderable: false },
            { data: 'eliminado',   orderable: false, render: v =>
                v ? `<span class="badge badge-grid-gray badge-elim">Eliminado</span>`
                  : `<span class="badge badge-grid-gray">Activo</span>` }
        ],
        order: [],
        language: { emptyTable: 'Sin resultados registrados.', search: 'Buscar:', lengthMenu: 'Mostrar _MENU_ registros' },
        initComplete: function() {
            $('#resGrid_length').css({display:'inline-flex','align-items':'center',margin:'0'});
            $('#gridLengthWrapper').empty().append($('#resGrid_length').children());
            $('#resGrid_filter').css({display:'inline-flex','align-items':'center',margin:'0'});
            $('#gridSearchWrapper').empty().append($('#resGrid_filter').children());
        }
    });
});
</script>
}
