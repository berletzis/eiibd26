@page
@model eiibd26.Areas.Identity.Pages.Admin.Campanas.CampanasIndexModel
@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@attribute [Authorize(Roles = "Administrador")]
@{
    ViewData["Title"] = "Campañas de email";
    Layout = "_Layout";
}

<div class="eii-page eii-page--wide">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
    <h2 class="eii-page-title eii-page-title--sm mb-4">Campañas de email</h2>

    <div class="row g-4">

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- ENVIAR CAMPAÑA — combo audiencia + template libre                 -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3" style="background:linear-gradient(135deg,#1a7abf 0%,#0d4f7c 100%);">
                    <h5 class="mb-0 text-white fw-semibold">
                        <i class="bi bi-send me-2"></i>Enviar campaña
                    </h5>
                </div>
                <div class="card-body p-4">

                    <!-- Selectores: Audiencia + Template + Elegibles -->
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold" style="font-size:.85rem;">Audiencia</label>
                            <select id="audienciaSelect" class="form-select form-select-sm">
                                <option value="1">Toque 1 — Reactivación (viejos sin contactar)</option>
                                <option value="2">Toque 2 — Activación (recibieron T1, no reactivaron)</option>
                                <option value="3">Toque 3 — Recordatorio (recibieron T2, no reactivaron)</option>
                                <option value="4">Todos los confirmados</option>
                                <optgroup label="Tarea pendiente">
                                    <option value="5">Sin condición registrada</option>
                                    <option value="6">Sin estado de ánimo registrado</option>
                                    <option value="7">Con respuestas esta semana</option>
                                    <option value="8">Fecha de diagnóstico pendiente</option>
                                    <option value="9">Sin foto de perfil</option>
                                    <option value="10">Completar fecha de diagnóstico</option>
                                    <option value="11">Sin mood reciente (14 días)</option>
                                </optgroup>
                            </select>
                            <div class="form-text" id="audienciaHint" style="font-size:.77rem;"></div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold" style="font-size:.85rem;">Template SendGrid</label>
                            <select id="campanaTemplateSelect" class="form-select form-select-sm">
                                <option value="">Cargando templates...</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <div class="p-2 rounded border text-center" style="background:#f0f7ff;border-color:#c8e1f7!important;min-height:58px;display:flex;flex-direction:column;justify-content:center;">
                                <div class="fw-bold text-primary" style="font-size:1.4rem;line-height:1;" id="elegiblesCount">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                                <div class="text-muted mt-1" style="font-size:.73rem;">elegibles</div>
                            </div>
                        </div>
                    </div>

                    <!-- Prueba previa -->
                    <div class="mb-3 p-2 rounded" style="background:#f8f9fa;border:1px solid #dee2e6;font-size:.85rem;">
                        <span class="text-muted fw-semibold">Prueba previa:</span>
                        <div class="d-flex gap-2 mt-1 flex-wrap align-items-center">
                            <input type="email" id="campanaCorreoPrueba" class="form-control form-control-sm"
                                   placeholder="correo@prueba.com" style="max-width:200px;" />
                            <button type="button" id="btnEnviarPrueba" class="btn btn-sm btn-outline-secondary text-nowrap">
                                <i class="bi bi-envelope-check me-1"></i>Probar
                            </button>
                            <span id="pruebaSendStatus" style="font-size:.82rem;"></span>
                        </div>
                    </div>

                    <!-- Avisos y estado -->
                    <div id="campanaAviso" class="alert alert-warning d-none mb-3 py-2" style="font-size:.85rem;">
                        <i class="bi bi-exclamation-triangle me-1"></i><span id="campanaAvisoText"></span>
                    </div>
                    <div id="campanaStatus" class="alert d-none mb-3" role="alert" style="font-size:.88rem;"></div>

                    <!-- Botones -->
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <label for="cantidadSelect" class="form-label fw-semibold mb-0 text-nowrap" style="font-size:.85rem;">Tamaño de tanda:</label>
                            <select id="cantidadSelect" class="form-select form-select-sm" style="width:auto;">
                                <option value="50">50</option>
                                <option value="100" selected>100</option>
                                <option value="300">300</option>
                                <option value="500">500</option>
                                <option value="-1">Todos</option>
                            </select>
                            <button id="btnEnviarAudiencia" class="btn btn-primary text-nowrap">
                                <i class="bi bi-send me-2"></i>Enviar batch
                            </button>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button id="btnResetearAudiencia" class="btn btn-sm btn-outline-danger"
                                    title="Borra el tracking (EmailCampanaLog) de la audiencia seleccionada para reabrir su lista de elegibles desde cero">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Resetear envíos de esta audiencia
                            </button>
                            <span id="resetStatus" style="font-size:.82rem;"></span>
                        </div>
                    </div>

                    <!-- Progreso de esta audiencia (aparece al encolar un envío) -->
                    <div id="progresoPanel" class="mt-4 p-3 rounded border d-none"
                         style="background:#f8fbff;border-color:#c8e1f7!important;">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                            <span class="fw-semibold text-secondary" style="font-size:.9rem;">
                                <i class="bi bi-graph-up-arrow me-1"></i>Progreso de esta audiencia
                            </span>
                            <span id="progresoJobEstado" class="badge bg-secondary">—</span>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 rounded bg-white border h-100">
                                    <div class="fw-bold text-success" style="font-size:1.4rem;line-height:1;" id="progEnviados">—</div>
                                    <div class="text-muted mt-1" style="font-size:.72rem;">Enviados en total a esta audiencia</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-white border h-100">
                                    <div class="fw-bold text-primary" style="font-size:1.4rem;line-height:1;" id="progFaltan">—</div>
                                    <div class="text-muted mt-1" style="font-size:.72rem;">Pendientes por enviar</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-white border h-100">
                                    <div class="fw-bold text-dark" style="font-size:1.4rem;line-height:1;" id="progTotal">—</div>
                                    <div class="text-muted mt-1" style="font-size:.72rem;">Total de la audiencia</div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                            <span id="progresoMensaje" class="text-muted" style="font-size:.82rem;"></span>
                            <button id="btnContinuarEnviando" class="btn btn-sm btn-success" disabled
                                    title="Manda la siguiente tanda a los que aún faltan (misma audiencia, template y tamaño)">
                                <i class="bi bi-arrow-right-circle me-1"></i>Continuar enviando
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- DIAGNÓSTICO DE CONFIGURACIÓN SENDGRID                     -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="mt-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3 d-flex align-items-center justify-content-between"
                 style="background:#f8f9fa;border-bottom:1px solid #e9ecef;">
                <h6 class="mb-0 fw-semibold text-secondary">
                    <i class="bi bi-gear-fill me-2"></i>Diagnóstico de configuración SendGrid
                </h6>
                <button id="btnVerificarConfig" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-search me-1"></i>Verificar configuración
                </button>
            </div>
            <div class="card-body p-4" id="diagnosticoContent" style="display:none;">
                <div class="text-center text-muted py-2">
                    <span class="spinner-border spinner-border-sm me-1"></span>Cargando...
                </div>
            </div>
            <div class="card-footer py-2 px-4" style="background:#fffdf0;border-top:1px solid #fde68a;font-size:.8rem;">
                <i class="bi bi-info-circle text-warning me-1"></i>
                <strong>Lo que la app NO puede verificar:</strong>
                DKIM, SPF y DMARC se configuran en el DNS y se verifican en
                <a href="https://app.sendgrid.com/settings/sender_auth" target="_blank" rel="noopener" class="text-decoration-none">SendGrid → Sender Authentication</a>.
                La entregabilidad real se mide en
                <a href="https://www.mail-tester.com" target="_blank" rel="noopener" class="text-decoration-none">mail-tester.com</a>.
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- GRID DE ESTATUS (F3) — Resumen + detalle por campaña      -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="mt-5">
        <div class="d-flex align-items-center mb-3 gap-3">
            <h5 class="mb-0 fw-semibold">Estatus de campañas</h5>
            <button id="btnRefrescarEstatus" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-clockwise me-1"></i>Refrescar
            </button>
            <span id="estatusLoadingMsg" class="text-muted" style="font-size:.83rem;display:none;">
                <span class="spinner-border spinner-border-sm me-1"></span>Cargando...
            </span>
        </div>

        <div id="estatusResumenWrap">
            <div class="text-center py-4 text-muted" style="font-size:.9rem;">
                <span class="spinner-border spinner-border-sm me-2"></span>Cargando estatus...
            </div>
        </div>

        <div id="estatusDetalleWrap" class="d-none mt-4">
            <div class="d-flex align-items-center mb-2 gap-2 flex-wrap">
                <span class="fw-semibold" id="detalleTitle" style="font-size:.95rem;"></span>
                <div class="btn-group btn-group-sm" id="detalleFiltros" role="group">
                    <button class="btn btn-outline-secondary detalle-filtro active" data-filtro="">Todos</button>
                    <button class="btn btn-outline-success  detalle-filtro" data-filtro="open">Abrieron</button>
                    <button class="btn btn-outline-primary  detalle-filtro" data-filtro="click">Clickearon</button>
                    <button class="btn btn-outline-warning  detalle-filtro" data-filtro="noopen" title="Entregados pero no abrieron">No abrieron</button>
                    <button class="btn btn-outline-danger   detalle-filtro" data-filtro="bounce">Rebotaron</button>
                    <button class="btn btn-outline-danger   detalle-filtro" data-filtro="spamreport">Spam</button>
                </div>
                <button id="btnCerrarDetalle" class="btn btn-sm btn-outline-secondary ms-auto">
                    <i class="bi bi-x"></i> Cerrar
                </button>
            </div>
            <div id="estatusDetalleContent">
                <div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm"></span></div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- DIRECCIONES EXCLUIDAS POR REBOTE (F3) — panel transparencia -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="mt-5">
        <div class="d-flex align-items-center mb-2 gap-3 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2"
                    type="button" data-bs-toggle="collapse" data-bs-target="#excluidosWrap"
                    aria-expanded="false" aria-controls="excluidosWrap" id="btnToggleExcluidos">
                <i class="bi bi-chevron-right" id="excluidosChevron"></i>
                <span class="fw-semibold">Direcciones excluidas de envíos</span>
                <span class="badge bg-secondary" id="excluidosBadgeTotal">…</span>
            </button>
            <button id="btnRefrescarExcluidos" class="btn btn-sm btn-outline-secondary" type="button" title="Recalcular">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        <div class="collapse" id="excluidosWrap">
            <div class="alert alert-light border" style="font-size:.83rem;">
                <i class="bi bi-info-circle me-1"></i>
                Estas direcciones <strong>no reciben campañas</strong>. Se calcula al vuelo desde los
                eventos de SendGrid — no afecta estadísticas ni la validez del usuario. Las marcadas como
                <span class="badge bg-warning text-dark">temporales</span> (buzón lleno) volverán a
                incluirse <strong>automáticamente</strong> si una futura entrega tiene éxito; las
                <span class="badge bg-danger">permanentes</span> seguirán excluidas.
            </div>
            <div id="excluidosContent">
                <div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        var basePath  = window.location.pathname;

        // ── Nombres de audiencias para mensajes de confirmación ──
        var audienciaLabels = {
            '1': 'Toque 1 — Reactivación (viejos sin contactar)',
            '2': 'Toque 2 — Activación (recibieron T1, no reactivaron)',
            '3': 'Toque 3 — Recordatorio (recibieron T2, no reactivaron)',
            '4': 'Todos los confirmados',
            '5': 'Sin condición registrada',
            '6': 'Sin estado de ánimo registrado',
            '7': 'Con respuestas esta semana',
            '8': 'Fecha de diagnóstico pendiente',
            '9': 'Sin foto de perfil',
            '10': 'Completar fecha de diagnóstico',
            '11': 'Sin mood reciente (14 días)'
        };
        var audienciaHints = {
            '1': 'Viejos sin ningún contacto previo. FaseLog=1.',
            '2': 'Viejos que recibieron T1 y aún no reactivaron (hash len=68). FaseLog=2.',
            '3': 'Viejos que recibieron T2 y aún no reactivaron. FaseLog=3.',
            '4': 'Todos los usuarios con email confirmado. FaseLog=10 + TemplateId.',
            '5': 'Confirmados sin ninguna condición registrada. FaseLog=20. Excluye a quien ya recibió (resetear para reenviar).',
            '6': 'Confirmados que nunca registraron mood. FaseLog=21. Excluye a quien ya recibió (resetear para reenviar).',
            '7': 'Cuyas preguntas recibieron respuesta de otro usuario en los últimos 7 días. FaseLog=22. Excluye a quien ya recibió (resetear para reenviar).',
            '8': 'Con condición cuya fecha de inicio = fecha de registro (diagnóstico sin actualizar). FaseLog=23. Excluye a quien ya recibió (resetear para reenviar).',
            '9': 'Avatar null/vacío, o contiene ui-avatars.com o default (mismo criterio que scoring de usuarios). FaseLog=24. Excluye a quien ya recibió (resetear para reenviar).',
            '10': 'Confirmados con condición pero sin fecha de diagnóstico real (vacía o placeholder 1-ene). FaseLog=25. Excluye a quien ya recibió (resetear para reenviar).',
            '11': 'Confirmados que registraron mood antes pero no en los últimos 14 días (recordatorio de hábito). NO incluye a quienes nunca registraron. FaseLog=26. Excluye a quien ya recibió (resetear para reenviar).'
        };

        var templateLabels = {}; // id → nombre

        // ── Cargar templates ──
        var templateSel = document.getElementById('campanaTemplateSelect');
        fetch(basePath + '?handler=TemplatesCorreo')
            .then(function (r) { return r.json(); })
            .then(function (templates) {
                var opts = '<option value="">— Selecciona template —</option>';
                if (templates && templates.length) {
                    templates.forEach(function (t) {
                        var label = t.nombre + (t.fase > 0 ? ' (Fase ' + t.fase + ')' : '');
                        opts += '<option value="' + t.id + '">' + label + '</option>';
                        templateLabels[t.id] = t.nombre;
                    });
                }
                templateSel.innerHTML = opts;
                actualizarConteo();
            })
            .catch(function () { templateSel.innerHTML = '<option value="">Error al cargar</option>'; });

        // ── Conteo en vivo ──
        function actualizarConteo() {
            var audiencia  = document.getElementById('audienciaSelect').value;
            var templateId = templateSel.value;
            var countEl    = document.getElementById('elegiblesCount');
            countEl.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            // Hint de audiencia
            document.getElementById('audienciaHint').textContent = audienciaHints[audiencia] || '';

            var url = basePath + '?handler=ConteoAudiencia&audiencia=' + encodeURIComponent(audiencia);
            if (templateId) url += '&templateId=' + encodeURIComponent(templateId);

            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    countEl.textContent = d.elegibles != null ? d.elegibles : '—';
                })
                .catch(function () { countEl.textContent = '—'; });
        }

        document.getElementById('audienciaSelect').addEventListener('change', function () {
            actualizarConteo();
            pintarProgreso(this.value); // el panel siempre refleja la audiencia seleccionada
        });
        templateSel.addEventListener('change', actualizarConteo);

        // ── Prueba ──
        document.getElementById('btnEnviarPrueba').addEventListener('click', function () {
            var emailInput = document.getElementById('campanaCorreoPrueba');
            var email      = emailInput.value.trim();
            var templateId = templateSel.value;
            var statusEl   = document.getElementById('pruebaSendStatus');
            var btn        = this;

            if (!templateId) { statusEl.innerHTML = '<span class="text-warning">Selecciona un template.</span>'; return; }
            if (!emailInput.checkValidity() || !email) { statusEl.innerHTML = '<span class="text-danger">Correo inválido.</span>'; return; }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
            statusEl.innerHTML = '';

            fetch(basePath + '?handler=CampanaEnviarPrueba', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                body: JSON.stringify({ email: email, templateId: templateId })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-envelope-check me-1"></i>Probar';
                statusEl.innerHTML = data.success
                    ? '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Enviado</span>'
                    : '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>' + esc(data.error || 'Error') + '</span>';
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-envelope-check me-1"></i>Probar';
                statusEl.innerHTML = '<span class="text-danger">Error de conexión.</span>';
            });
        });

        // ── Progreso asociado a la audiencia seleccionada ─────────────────────
        // El panel refleja SIEMPRE la audiencia del dropdown (no "el último envío").
        // Estados: vacío (sin historial) · estático/gris (con historial, nada corriendo)
        // · vivo (esta audiencia tiene un job en curso → polling cada 4s).
        var pollTimer = null;
        var POLL_INTERVAL_MS = 4000;
        var POLL_MAX_MS = 5 * 60 * 1000;   // salvaguarda del polling en pantalla
        var pollStart = 0;
        var pollAudiencia = null;          // audiencia del envío vivo que se está pintando

        // localStorage: SOLO identificadores de UI no sensibles (audiencia, jobId, timestamp).
        // Prohibido correos, nombres, tokens o cualquier dato personal/clínico.
        var LS_KEY = 'eiibd_campana_envio_activo';
        var ENVIO_MAX_MS = 30 * 60 * 1000; // caducidad anti-zombie

        function guardarEnvioActivo(audiencia, jobId) {
            try {
                localStorage.setItem(LS_KEY, JSON.stringify({
                    audiencia: String(audiencia), jobId: jobId, timestamp: Date.now()
                }));
            } catch (e) { /* localStorage no disponible: degradar en silencio */ }
        }
        function limpiarEnvioActivo() {
            try { localStorage.removeItem(LS_KEY); } catch (e) { }
        }
        // Devuelve {audiencia, jobId} del envío activo, o null (aplica caducidad de 30 min).
        function hayEnvioActivo() {
            try {
                var raw = localStorage.getItem(LS_KEY);
                if (!raw) return null;
                var o = JSON.parse(raw);
                if (!o || !o.jobId || o.audiencia == null) { limpiarEnvioActivo(); return null; }
                if (Date.now() - (o.timestamp || 0) > ENVIO_MAX_MS) { limpiarEnvioActivo(); return null; }
                return { audiencia: String(o.audiencia), jobId: o.jobId };
            } catch (e) { return null; }
        }

        function estadoBadge(estado) {
            switch (estado) {
                case 'Enqueued':   return { cls: 'bg-secondary', texto: 'En cola' };
                case 'Processing': return { cls: 'bg-primary',   texto: 'Procesando…' };
                case 'Succeeded':  return { cls: 'bg-success',   texto: 'Completado' };
                case 'Failed':     return { cls: 'bg-danger',    texto: 'Falló' };
                default:           return { cls: 'bg-secondary', texto: estado || '—' };
            }
        }

        function detenerPolling() {
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            pollAudiencia = null;
        }

        // El botón de envío se bloquea mientras haya CUALQUIER envío activo (todas las audiencias).
        function refrescarBotonEnvio(activo) {
            if (activo === undefined) activo = hayEnvioActivo();
            document.getElementById('btnEnviarAudiencia').disabled = !!activo;
        }

        // Pinta los tres contadores. atenuado=true → modo estático/gris (histórico).
        function setContadores(d, atenuado) {
            var e = document.getElementById('progEnviados');
            var f = document.getElementById('progFaltan');
            var t = document.getElementById('progTotal');
            e.textContent = d.enviados; e.className = 'fw-bold ' + (atenuado ? 'text-muted' : 'text-success');
            f.textContent = d.faltan;   f.className = 'fw-bold ' + (atenuado ? 'text-muted' : 'text-primary');
            t.textContent = d.total;    t.className = 'fw-bold ' + (atenuado ? 'text-muted' : 'text-dark');
        }

        function setBadge(cls, texto) {
            var badgeEl = document.getElementById('progresoJobEstado');
            badgeEl.className = 'badge ' + cls;
            badgeEl.textContent = texto;
        }

        // Consulta el handler de progreso (solo lectura). Devuelve el objeto d o null.
        function consultarProgreso(aud, jobId) {
            var url = basePath + '?handler=ProgresoAudiencia&audiencia=' + encodeURIComponent(aud);
            if (jobId) url += '&jobId=' + encodeURIComponent(jobId);
            return fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) { return (!d || d.error) ? null : d; })
                .catch(function () { return null; });
        }

        // ── Estado maestro del panel: SIEMPRE refleja la audiencia indicada ──
        function pintarProgreso(audiencia) {
            audiencia = String(audiencia);
            var activo = hayEnvioActivo();
            refrescarBotonEnvio(activo);

            if (activo && activo.audiencia === audiencia) {
                // Envío activo para ESTA audiencia → modo vivo (reengancha/continúa polling).
                iniciarPolling(audiencia, activo.jobId);
                return;
            }

            // Sin envío activo para esta audiencia → parar polling y pintar estático/vacío.
            detenerPolling();
            var panel   = document.getElementById('progresoPanel');
            document.getElementById('btnContinuarEnviando').classList.add('d-none'); // solo en modo vivo

            consultarProgreso(audiencia, null).then(function (d) {
                // Si mientras consultábamos cambió la audiencia seleccionada, no pisar el panel.
                if (String(document.getElementById('audienciaSelect').value) !== audiencia) return;
                if (!d || d.enviados === 0) {
                    panel.classList.add('d-none'); // sin historial → panel oculto
                    return;
                }
                // Con historial, nada corriendo → foto estática/gris (sin badge verde, sin polling).
                panel.classList.remove('d-none');
                setContadores(d, true);
                setBadge('bg-light text-muted border', 'Histórico');
                document.getElementById('progresoMensaje').innerHTML =
                    '<span class="text-muted"><i class="bi bi-clock-history me-1"></i>Estado histórico — no hay ningún envío en curso para esta audiencia.</span>';
            });
        }

        function iniciarPolling(aud, jobId) {
            detenerPolling();
            pollStart = Date.now();
            pollAudiencia = String(aud);
            var panel   = document.getElementById('progresoPanel');
            var btnCont = document.getElementById('btnContinuarEnviando');
            panel.classList.remove('d-none');
            btnCont.classList.remove('d-none');
            btnCont.disabled = true;
            document.getElementById('btnEnviarAudiencia').disabled = true;
            document.getElementById('progresoMensaje').innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span>Enviando en segundo plano…';

            var tick = function () {
                consultarProgreso(aud, jobId).then(function (d) {
                    if (pollAudiencia === null) return; // se cambió de audiencia: el server sigue solo
                    if (!d) return;                     // error puntual: reintenta en el próximo tick
                    setContadores(d, false);
                    var b = estadoBadge(d.jobEstado);
                    setBadge(b.cls, b.texto);

                    if (d.jobEstado === 'Succeeded') {
                        detenerPolling();
                        limpiarEnvioActivo();
                        document.getElementById('progresoMensaje').innerHTML =
                            '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Envío completado.</span>';
                        refrescarBotonEnvio(null);
                        btnCont.disabled = false; // permite mandar la siguiente tanda
                        actualizarConteo();
                    } else if (d.jobEstado === 'Failed') {
                        detenerPolling();
                        limpiarEnvioActivo();
                        document.getElementById('progresoMensaje').innerHTML =
                            '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>El job falló. Revisa el panel de Hangfire.</span>';
                        refrescarBotonEnvio(null);
                        btnCont.classList.add('d-none');
                        actualizarConteo();
                    } else if (Date.now() - pollStart > POLL_MAX_MS) {
                        // Pausa del seguimiento en pantalla; NO limpia localStorage (el job puede seguir).
                        // Al volver a esta audiencia o recargar, se re-engancha si sigue activo.
                        detenerPolling();
                        document.getElementById('progresoMensaje').innerHTML =
                            '<span class="text-muted">Seguimiento en pantalla pausado. Vuelve a esta audiencia o recarga para reanudar.</span>';
                    }
                });
            };
            tick(); // lectura inmediata
            pollTimer = setInterval(tick, POLL_INTERVAL_MS);
        }

        // Al cargar: si hay un envío activo en localStorage, engancharlo/limpiarlo según su estado real.
        function reengancharAlCargar() {
            var activo = hayEnvioActivo();
            var seleccionada = String(document.getElementById('audienciaSelect').value);
            if (!activo) { pintarProgreso(seleccionada); return; }

            if (activo.audiencia === seleccionada) {
                // Coincide con la seleccionada: pintarProgreso → iniciarPolling, cuyo primer tick
                // reengancha si sigue vivo, o muestra el resultado final y limpia si ya terminó.
                pintarProgreso(seleccionada);
                return;
            }

            // Activo en OTRA audiencia: comprobar si ya terminó para no dejar el botón bloqueado de más.
            consultarProgreso(activo.audiencia, activo.jobId).then(function (d) {
                if (d && (d.jobEstado === 'Succeeded' || d.jobEstado === 'Failed')) limpiarEnvioActivo();
                pintarProgreso(seleccionada);
            });
        }

        // ── Enviar batch (reutilizable: botón principal y "Continuar enviando") ──
        function dispararEnvio(skipConfirm) {
            var audiencia  = document.getElementById('audienciaSelect').value;
            var templateId = templateSel.value;
            var cantidad   = parseInt(document.getElementById('cantidadSelect').value, 10);
            var countEl    = document.getElementById('elegiblesCount');
            var btn        = document.getElementById('btnEnviarAudiencia');
            var btnCont    = document.getElementById('btnContinuarEnviando');

            // Un solo envío activo a la vez (en cualquier audiencia).
            var activo = hayEnvioActivo();
            if (activo) {
                var nombreActivo = audienciaLabels[activo.audiencia] || ('audiencia ' + activo.audiencia);
                mostrarAviso('Ya hay un envío en curso para ' + nombreActivo + '. Espera a que termine.');
                refrescarBotonEnvio(activo);
                return;
            }

            if (!templateId) {
                mostrarAviso('Selecciona un template antes de enviar.');
                return;
            }

            if (!skipConfirm) {
                var templateNombre  = templateLabels[templateId] || templateId;
                var audienciaNombre = audienciaLabels[audiencia] || audiencia;
                var elegiblesTexto  = countEl.textContent.trim();
                var cantidadTexto   = cantidad === -1 ? 'Todos los elegibles' : cantidad;
                var confirmMsg = 'Vas a encolar el envío:\n  Template: ' + templateNombre +
                    '\n  Audiencia: ' + audienciaNombre +
                    '\n  Tamaño de tanda: ' + cantidadTexto +
                    '\n  Elegibles actuales: ' + elegiblesTexto + '\n\n¿Continuar?';
                if (!confirm(confirmMsg)) return;
            }

            btn.disabled = true;
            btnCont.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Encolando...';
            ocultarAviso();
            ocultarStatus();

            fetch(basePath + '?handler=EnviarAudiencia', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                body: JSON.stringify({ audiencia: parseInt(audiencia), templateId: templateId, cantidad: cantidad })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.innerHTML = '<i class="bi bi-send me-2"></i>Enviar batch';
                if (!data.success) {
                    btn.disabled = false;
                    mostrarAviso(data.error || 'Error desconocido.');
                    return;
                }
                mostrarStatus('success', '<i class="bi bi-check-circle me-1"></i>' +
                    (data.mensaje || 'Envío encolado. Los correos se enviarán en segundo plano.'));
                if (data.jobId) {
                    // Registrar el envío activo (identificadores no sensibles) y arrancar el modo vivo.
                    guardarEnvioActivo(audiencia, data.jobId);
                    iniciarPolling(audiencia, data.jobId);
                } else {
                    // Sin jobId (caso improbable): comportamiento previo — refrescar conteo tras unos segundos.
                    btn.disabled = false;
                    setTimeout(actualizarConteo, 4000);
                }
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-2"></i>Enviar batch';
                mostrarStatus('danger', '<i class="bi bi-exclamation-triangle me-1"></i>Error de conexión. Intenta de nuevo.');
            });
        }

        document.getElementById('btnEnviarAudiencia').addEventListener('click', function () { dispararEnvio(false); });
        document.getElementById('btnContinuarEnviando').addEventListener('click', function () { dispararEnvio(true); });

        // ── Resetear envíos de la audiencia seleccionada (global) ──
        document.getElementById('btnResetearAudiencia').addEventListener('click', function () {
            var btn         = this;
            var statusEl    = document.getElementById('resetStatus');
            var audiencia   = document.getElementById('audienciaSelect').value;
            var audNombre   = audienciaLabels[audiencia] || audiencia;
            var btnHtml     = '<i class="bi bi-arrow-counterclockwise me-1"></i>Resetear envíos de esta audiencia';

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Verificando...';
            statusEl.innerHTML = '';

            // Conteo previo de registros a borrar para una confirmación nombrada.
            fetch(basePath + '?handler=ConteoResetAudiencia&audiencia=' + encodeURIComponent(audiencia))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                btn.disabled = false;
                btn.innerHTML = btnHtml;
                var n = (d && d.registros != null) ? d.registros : '?';

                if (n === 0) {
                    statusEl.innerHTML = '<span class="text-muted">No hay envíos registrados para esta audiencia.</span>';
                    return;
                }

                var msg = "¿Resetear envíos de '" + audNombre + "'?\n\n" +
                    'Esto borrará ' + n + ' registro(s) y permitirá reenviar desde cero.\n\n' +
                    '¿Continuar?';
                if (!confirm(msg)) return;

                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Reseteando...';

                fetch(basePath + '?handler=ResetearAudiencia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
                    body: JSON.stringify({ audiencia: parseInt(audiencia) })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    btn.disabled = false;
                    btn.innerHTML = btnHtml;
                    if (data.success) {
                        statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>' +
                            data.eliminados + ' envíos reseteados.</span>';
                        actualizarConteo();
                    } else {
                        statusEl.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>' +
                            esc(data.error || 'Error al resetear.') + '</span>';
                    }
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = btnHtml;
                    statusEl.innerHTML = '<span class="text-danger">Error de conexión.</span>';
                });
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = btnHtml;
                statusEl.innerHTML = '<span class="text-danger">Error de conexión.</span>';
            });
        });

        // ── Helpers UI ──
        function mostrarAviso(msg) {
            var el = document.getElementById('campanaAviso');
            document.getElementById('campanaAvisoText').textContent = msg;
            el.classList.remove('d-none');
        }
        function ocultarAviso() { document.getElementById('campanaAviso').classList.add('d-none'); }

        function mostrarStatus(tipo, html) {
            var el = document.getElementById('campanaStatus');
            el.className = 'alert alert-' + tipo + ' mb-3';
            el.innerHTML = html;
        }
        function ocultarStatus() { document.getElementById('campanaStatus').className = 'alert d-none mb-3'; }

        function esc(str) {
            var d = document.createElement('span');
            d.textContent = str || '';
            return d.innerHTML;
        }

        // Conteo inicial al cargar la página
        actualizarConteo();
        // Re-enganche del panel al envío activo (si lo hay en localStorage) o pintado del estado
        // de la audiencia seleccionada (vacío / histórico estático).
        reengancharAlCargar();

    }());

    // ──────────────────────────────────────────────────────────────────────
    // DIAGNÓSTICO SENDGRID
    // ──────────────────────────────────────────────────────────────────────
    document.getElementById('btnVerificarConfig').addEventListener('click', function () {
        var btn     = this;
        var content = document.getElementById('diagnosticoContent');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Verificando...';
        content.style.display = 'block';
        content.innerHTML = '<div class="text-center text-muted py-2"><span class="spinner-border spinner-border-sm me-1"></span>Cargando...</div>';

        fetch(window.location.pathname + '?handler=DiagnosticoSendGrid')
            .then(function (r) { return r.json(); })
            .then(function (d) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i>Verificar configuración';
                renderDiagnostico(d, content);
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i>Verificar configuración';
                content.innerHTML = '<div class="alert alert-warning">Error cargando diagnóstico.</div>';
            });
    });

    function badge(ok, okTxt, failTxt) {
        return ok
            ? '<span class="badge bg-success-subtle text-success border border-success-subtle">' + okTxt + '</span>'
            : '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">' + failTxt + '</span>';
    }

    function renderDiagnostico(d, el) {
        function esc(str) { var s = document.createElement('span'); s.textContent = str || ''; return s.innerHTML; }

        var webhookNote = d.webhookPublicKeyPresente
            ? ''
            : '<span class="text-muted ms-2" style="font-size:.78rem;">El webhook recibe eventos pero no valida firma — configurar para producción.</span>';

        var templatesHtml = '';
        if (d.templates && d.templates.length) {
            templatesHtml += '<ul class="list-unstyled mb-0">';
            d.templates.forEach(function (t) {
                templatesHtml += '<li>' + badge(t.idValido, '✓', '⚠') +
                    ' <span style="font-size:.83rem;">' + esc(t.nombre) + ' (Fase ' + t.fase + ')</span></li>';
            });
            templatesHtml += '</ul>';
        } else { templatesHtml = '<span class="text-muted" style="font-size:.82rem;">Sin templates configurados</span>'; }

        var campanasHtml = '';
        if (d.campanas && d.campanas.length) {
            campanasHtml += '<ul class="list-unstyled mb-0">';
            d.campanas.forEach(function (c) {
                campanasHtml += '<li>' + badge(c.idValido, '✓', '⚠') +
                    ' <span style="font-size:.83rem;">' + esc(c.codigo) + ' — ' + esc(c.nombre) +
                    ' <span class="text-muted">(' + esc(c.publico) + ')</span></span></li>';
            });
            campanasHtml += '</ul>';
        } else { campanasHtml = '<span class="text-muted" style="font-size:.82rem;">Sin campañas configuradas</span>'; }

        var webhookEventos = d.eventosWebhookRecibidos > 0
            ? '<span class="badge bg-success-subtle text-success border border-success-subtle">✓ ' + d.eventosWebhookRecibidos + ' eventos recibidos</span>'
            : '<span class="badge bg-warning-subtle text-warning border border-warning-subtle">Aún no se han recibido eventos</span>';

        el.innerHTML =
            '<div class="row g-3">' +
            '<div class="col-md-6">' +
            '<table class="table table-sm mb-0" style="font-size:.85rem;"><tbody>' +
            '<tr><th class="text-muted fw-normal" style="width:160px;">API Key</th><td>' +
            badge(d.apiKeyPresente, d.apiKeyPreview || '✓', '❌ No configurada') + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">From Email</th><td>' + esc(d.fromEmail) + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">From Name</th><td>' + esc(d.fromName) + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">Categorías</th><td>' +
            (d.defaultCategories && d.defaultCategories.length
                ? d.defaultCategories.map(function (c) { return '<span class="badge bg-secondary me-1">' + esc(c) + '</span>'; }).join('')
                : '<span class="text-muted">—</span>') + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">Webhook key</th><td>' +
            badge(d.webhookPublicKeyPresente, '✓ Configurada', '⚠ Sin configurar') + webhookNote + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">Eventos webhook</th><td>' + webhookEventos + '</td></tr>' +
            '<tr><th class="text-muted fw-normal">Suscriptores email</th><td>' + d.totalSuscriptoresEmail + ' usuarios confirmados</td></tr>' +
            '</tbody></table>' +
            (d.templatesConProblema > 0
                ? '<div class="alert alert-warning py-1 px-2 mt-2 mb-0" style="font-size:.8rem;"><i class="bi bi-exclamation-triangle me-1"></i>' + d.templatesConProblema + ' template(s) con ID placeholder o vacío.</div>'
                : '') +
            '</div>' +
            '<div class="col-md-6">' +
            '<p class="fw-semibold mb-1" style="font-size:.82rem;color:#555;">TEMPLATES (SendGrid:Templates)</p>' + templatesHtml +
            '<p class="fw-semibold mb-1 mt-3" style="font-size:.82rem;color:#555;">CAMPAÑAS (SendGrid:Campanas)</p>' + campanasHtml +
            '</div></div>';
    }

    // ──────────────────────────────────────────────────────────────────────
    // GRID DE ESTATUS — F3
    // ──────────────────────────────────────────────────────────────────────
    (function () {
        var campanaActiva = null;
        var filtroActivo  = '';

        var iconos = {
            delivered:   '<i class="bi bi-envelope-check text-primary" title="Entregado"></i>',
            open:        '<i class="bi bi-eye text-success" title="Abierto"></i>',
            click:       '<i class="bi bi-cursor text-info" title="Click"></i>',
            bounce:      '<i class="bi bi-x-circle text-danger" title="Rebote"></i>',
            spamreport:  '<i class="bi bi-shield-exclamation text-danger" title="Spam"></i>',
            unsubscribe: '<i class="bi bi-dash-circle text-warning" title="Baja"></i>',
            dropped:     '<i class="bi bi-slash-circle text-secondary" title="Dropped"></i>'
        };

        function esc(str) { var d = document.createElement('span'); d.textContent = str || ''; return d.innerHTML; }

        function renderResumen(data) {
            var wrap = document.getElementById('estatusResumenWrap');
            if (!data.campanas || data.campanas.length === 0) {
                wrap.innerHTML = '<div class="alert alert-info" style="font-size:.88rem;">' +
                    '<i class="bi bi-info-circle me-2"></i>' +
                    'Aún no hay eventos registrados. Los eventos aparecen cuando SendGrid reporta actividad ' +
                    '(requiere el Event Webhook configurado y campañas enviadas con custom args).' +
                    '</div>';
                return;
            }

            var html = '<div class="table-responsive"><table class="table table-hover align-middle mb-0" style="font-size:.88rem;">' +
                '<thead class="table-light"><tr>' +
                '<th>Campaña</th><th class="text-center">Entregados</th>' +
                '<th class="text-center">Abiertos</th><th class="text-center text-success">% Apertura</th>' +
                '<th class="text-center">Clicks</th><th class="text-center text-primary">% Click</th>' +
                '<th class="text-center text-danger">Rebotes</th>' +
                '<th class="text-center">Spam</th><th class="text-center">Bajas</th>' +
                '<th class="text-center text-muted">Detalle</th>' +
                '</tr></thead><tbody>';

            data.campanas.forEach(function (c) {
                html += '<tr>' +
                    '<td><span class="badge bg-secondary">' + esc(c.campana || '—') + '</span></td>' +
                    '<td class="text-center">' + c.entregados + '</td>' +
                    '<td class="text-center"><span class="badge bg-success-subtle text-success">' + c.abiertos + '</span></td>' +
                    '<td class="text-center fw-semibold text-success">' + (c.entregados ? c.tasaApertura + '%' : '—') + '</td>' +
                    '<td class="text-center"><span class="badge bg-primary-subtle text-primary">' + c.clicks + '</span></td>' +
                    '<td class="text-center text-primary">' + (c.entregados ? c.tasaClick + '%' : '—') + '</td>' +
                    '<td class="text-center"><span class="badge ' + (c.rebotes > 0 ? 'bg-danger' : 'bg-light text-muted') + '">' + c.rebotes + '</span></td>' +
                    '<td class="text-center"><span class="badge ' + (c.spam > 0 ? 'bg-danger' : 'bg-light text-muted') + '">' + c.spam + '</span></td>' +
                    '<td class="text-center">' + c.bajas + '</td>' +
                    '<td class="text-center"><button class="btn btn-sm btn-outline-secondary btn-detalle" data-campana="' + esc(c.campana) + '">' +
                    '<i class="bi bi-list-ul"></i></button></td>' +
                    '</tr>';
            });
            html += '</tbody></table></div>';
            wrap.innerHTML = html;

            document.querySelectorAll('.btn-detalle').forEach(function (btn) {
                btn.addEventListener('click', function () { cargarDetalle(this.dataset.campana, ''); });
            });
        }

        function cargarResumen() {
            document.getElementById('estatusLoadingMsg').style.display = '';
            fetch(window.location.pathname + '?handler=EstatusCampanas')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    document.getElementById('estatusLoadingMsg').style.display = 'none';
                    renderResumen(d);
                })
                .catch(function () {
                    document.getElementById('estatusLoadingMsg').style.display = 'none';
                    document.getElementById('estatusResumenWrap').innerHTML =
                        '<div class="alert alert-warning">Error cargando estatus.</div>';
                });
        }

        function cargarDetalle(campana, filtro) {
            campanaActiva = campana;
            filtroActivo  = filtro;
            document.getElementById('detalleTitle').textContent = 'Detalle: ' + campana + (filtro ? ' · ' + filtro : ' · todos');
            document.getElementById('estatusDetalleWrap').classList.remove('d-none');
            document.getElementById('estatusDetalleContent').innerHTML =
                '<div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm"></span></div>';

            document.querySelectorAll('.detalle-filtro').forEach(function (b) {
                b.classList.toggle('active', b.dataset.filtro === filtro);
            });

            var url = window.location.pathname + '?handler=EstatusDetalle&campana=' + encodeURIComponent(campana);
            if (filtro) url += '&filtro=' + encodeURIComponent(filtro);

            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) { renderDetalle(d); })
                .catch(function () {
                    document.getElementById('estatusDetalleContent').innerHTML =
                        '<div class="alert alert-warning">Error cargando detalle.</div>';
                });
        }

        function renderDetalle(d) {
            var el = document.getElementById('estatusDetalleContent');
            if (!d.usuarios || d.usuarios.length === 0) {
                el.innerHTML = '<p class="text-muted text-center py-3">No hay usuarios con este filtro.</p>';
                return;
            }

            var html = '<p class="text-muted mb-2" style="font-size:.8rem;">Mostrando ' + d.usuarios.length + ' usuarios' +
                (d.total === 200 ? ' (límite 200 — usa el filtro para acotar)' : '') + '</p>' +
                '<div class="table-responsive"><table class="table table-sm table-hover mb-0" style="font-size:.83rem;">' +
                '<thead class="table-light"><tr>' +
                '<th>Email</th><th>Nombre</th><th class="text-center">Entregado</th>' +
                '<th class="text-center">Abrió</th><th class="text-center">Click</th>' +
                '<th class="text-center">Rebote</th><th class="text-center">Spam</th>' +
                '<th class="text-center">Baja</th><th>Último evento</th>' +
                '</tr></thead><tbody>';

            d.usuarios.forEach(function (u) {
                html += '<tr>' +
                    '<td>' + esc(u.email) + '</td>' +
                    '<td class="text-muted">' + esc(u.nombre || '—') + '</td>' +
                    '<td class="text-center">' + (u.entregado ? iconos.delivered   : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-center">' + (u.abierto   ? iconos.open        : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-center">' + (u.click     ? iconos.click       : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-center">' + (u.rebote    ? iconos.bounce      : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-center">' + (u.spam      ? iconos.spamreport  : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-center">' + (u.baja      ? iconos.unsubscribe : '<span class="text-muted">—</span>') + '</td>' +
                    '<td class="text-muted">' + esc(u.ultimoEvento || '—') + '</td>' +
                    '</tr>';
            });
            html += '</tbody></table></div>';
            el.innerHTML = html;
        }

        document.getElementById('detalleFiltros').addEventListener('click', function (e) {
            var btn = e.target.closest('.detalle-filtro');
            if (!btn || !campanaActiva) return;
            cargarDetalle(campanaActiva, btn.dataset.filtro);
        });

        document.getElementById('btnCerrarDetalle').addEventListener('click', function () {
            document.getElementById('estatusDetalleWrap').classList.add('d-none');
            campanaActiva = null;
        });

        document.getElementById('btnRefrescarEstatus').addEventListener('click', function () {
            cargarResumen();
            if (campanaActiva) cargarDetalle(campanaActiva, filtroActivo);
        });

        // ── EXCLUIDOS POR REBOTE ──────────────────────────────────────────────
        var excluidosCargados = false;

        function renderExcluidos(d) {
            var el = document.getElementById('excluidosContent');
            document.getElementById('excluidosBadgeTotal').textContent = d.total;

            if (!d.items || d.items.length === 0) {
                el.innerHTML = '<p class="text-muted text-center py-3">No hay direcciones excluidas por rebote.</p>';
                return;
            }

            var html = '<p class="text-muted mb-2" style="font-size:.8rem;">' +
                '<strong>' + d.total + '</strong> direcciones excluidas · ' +
                '<span class="text-danger">' + d.hard + ' permanentes</span> · ' +
                '<span class="text-warning">' + d.soft + ' temporales reincidentes</span></p>' +
                '<div class="table-responsive"><table class="table table-sm table-hover mb-0" style="font-size:.83rem;">' +
                '<thead class="table-light"><tr>' +
                '<th>Email</th><th>Nombre</th><th class="text-center">Motivo</th>' +
                '<th class="text-center">Rebotes</th><th>Último rebote</th><th>Razón</th>' +
                '</tr></thead><tbody>';

            d.items.forEach(function (it) {
                var badge = it.motivo === 'hard'
                    ? '<span class="badge bg-danger" title="Rebote permanente — no se recupera">Permanente</span>'
                    : '<span class="badge bg-warning text-dark" title="Buzón lleno reincidente — se re-incluye si una entrega tiene éxito">Temporal</span>';
                html += '<tr>' +
                    '<td>' + esc(it.email) + '</td>' +
                    '<td class="text-muted">' + esc(it.nombre || '—') + '</td>' +
                    '<td class="text-center">' + badge + '</td>' +
                    '<td class="text-center">' + it.rebotes + '</td>' +
                    '<td class="text-muted">' + esc(it.ultimoRebote || '—') + '</td>' +
                    '<td class="text-muted" style="max-width:340px;">' + esc(it.razon || '—') + '</td>' +
                    '</tr>';
            });
            html += '</tbody></table></div>';
            el.innerHTML = html;
        }

        function cargarExcluidos() {
            document.getElementById('excluidosContent').innerHTML =
                '<div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</div>';
            fetch(window.location.pathname + '?handler=ExcluidosPorRebote')
                .then(function (r) { return r.json(); })
                .then(function (d) { excluidosCargados = true; renderExcluidos(d); })
                .catch(function () {
                    document.getElementById('excluidosContent').innerHTML =
                        '<div class="alert alert-warning mb-0">Error cargando direcciones excluidas.</div>';
                });
        }

        // Carga perezosa: solo al abrir el colapsable por primera vez.
        var excluidosWrap = document.getElementById('excluidosWrap');
        excluidosWrap.addEventListener('show.bs.collapse', function () {
            document.getElementById('excluidosChevron').className = 'bi bi-chevron-down';
            if (!excluidosCargados) cargarExcluidos();
        });
        excluidosWrap.addEventListener('hide.bs.collapse', function () {
            document.getElementById('excluidosChevron').className = 'bi bi-chevron-right';
        });
        document.getElementById('btnRefrescarExcluidos').addEventListener('click', function (e) {
            e.stopPropagation();
            cargarExcluidos();
        });

        cargarResumen();
    }());
    </script>
}
