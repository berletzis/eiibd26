@page
@model eiibd26.Areas.Identity.Pages.Admin.Condiciones.IndexModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }

        .crm-title-admin {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #14253f;
            margin-bottom: .7em;
        }

        .block-admin-uniform {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(40,60,120,0.08);
            padding: 30px 32px 18px 32px;
            margin: 0 0 36px 0;
            border: 1px solid #dde6f1;
            max-width: 100%;
        }

        .table-centered-admin {
            max-width: 1320px;
            margin: 0;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(70,80,120,0.07);
            border: none;
            padding: 20px 22px 9px 22px;
        }

        .dt-controls-flex {
            max-width: 1320px;
            margin: 0 auto 8px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .dt-controls-left {
            display: flex;
            align-items: center;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .dt-controls-right {
            display: flex;
            align-items: center;
            gap: 1.5em;
            flex-wrap: wrap;
        }

        .form-switch,
        #gridLengthWrapper,
        #gridSearchWrapper {
            margin-bottom: 0 !important;
        }

            #gridLengthWrapper label {
                margin-right: .5em;
            }

        .dataTables_length {
            display: inline-flex !important;
            align-items: center !important;
            vertical-align: middle !important;
            gap: 11px;
            margin-bottom: 0 !important;
            white-space: nowrap;
        }

            .dataTables_length label {
                display: flex !important;
                align-items: center !important;
                gap: 0.25em;
                margin-bottom: 0 !important;
                white-space: nowrap;
            }

                .dataTables_length label > select {
                    margin: 0 4px;
                    min-width: 52px;
                }

                .dataTables_length label > span,
                .dataTables_length label > select,
                .dataTables_length label > input {
                    display: inline-block !important;
                    vertical-align: middle !important;
                }

            .dataTables_length label {
                white-space: nowrap;
            }

                .dataTables_length label select,
                .dataTables_length label {
                    margin-bottom: 0 !important;
                }

        .dataTables_filter,
        .form-check.form-switch {
            display: inline-flex !important;
            align-items: center !important;
            vertical-align: middle !important;
            margin-bottom: 0 !important;
        }

            .dataTables_filter input {
                width: 200px;
                border-radius: 7px;
                border: 1px solid #dbe3f2;
                padding: 0.38em 1em;
                background: #f8fafd;
                margin-left: 0.4em;
            }

        #condicionesGrid {
            width: 100% !important;
            margin: 0;
        }

            #condicionesGrid th, #condicionesGrid td {
                border: none !important;
            }

            #condicionesGrid th {
                background: #eef4fa !important;
                color: #3d436c !important;
                font-weight: 600 !important;
                border-bottom: 2.7px solid #ddeaf7 !important;
                font-size: 1.07em;
            }

            #condicionesGrid tbody tr {
                border-bottom: 1.2px solid #e7ebf4 !important;
                box-shadow: 0 1px 18px #e6edfa0c;
            }

            #condicionesGrid tbody td {
                background: #fff !important;
                border-top: none !important;
                border-bottom: 1.1px solid #f2f7fd !important;
                font-size: 1.03em;
                padding-top: 13px !important;
                padding-bottom: 13px !important;
            }

            #condicionesGrid tbody tr:nth-child(even) td {
                background: #f9fbfc !important;
            }

        .btn-action-grid {
            background: #f6f8fd !important;
            color: #222 !important;
            border: 0px solid #dee2e6 !important;
            font-weight: 500;
            margin-right: 0.16em;
            transition: box-shadow .08s;
            border-radius: 9px !important;
            box-shadow: 0 1px 6px #dae4f377;
            padding: 6px 15px !important;
        }

            .btn-action-grid i {
                font-size: 1.09em;
                vertical-align: middle;
            }

        .btn-action-edit i {
            color: #ffbe17 !important;
        }

        .btn-action-delete i {
            color: #c92a2a !important;
        }

        .badge-grid-gray {
            background: #ededed !important;
            color: #191919 !important;
            font-weight: 600;
            font-size: .94em;
            border-radius: 9px;
            border: 1px solid #dddddd;
            padding: 6px 12px;
            letter-spacing: .01em;
            box-shadow: 0 1px 7px #dde2eb22;
        }

        .cond-hijo {
            padding-left: 2em;
            color: #717485;
        }

        .cond-padre {
            font-weight: bold;
        }

        .modal-header .btn-close {
            position: absolute;
            right: 1.1rem;
            top: 1.1rem;
        }

        .crm-modal-header {
            background: #f7f9fd;
            border-bottom: 1px solid #e5e8ef;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            padding: 1.1rem 1.5rem;
            color: #315686;
        }

        .crm-modal-title {
            font-size: 1.34rem;
            font-weight: 600;
            color: #315686;
        }

        .crm-modal-content {
            border-radius: 20px;
            box-shadow: 0 13px 32px 0 #b7c3f859;
            background: #fff;
        }

        .crm-modal-footer {
            border-top: 1px solid #ebecf1;
            padding: 1rem 1.5rem;
            background: #f7f9fd;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            text-align: right;
        }

        .crm-modal-body {
            padding: 1.3rem 1.5rem 1.3rem 1.5rem;
        }

        .dataTables_paginate {
            padding: 0.55em 0.25em;
            font-size: 1em;
            display: flex;
            justify-content: flex-end;
        }

        .modal-lg .crm-modal-content {
            max-width: 730px;
            margin: 0 auto;
        }
        @@media (max-width: 1100px) {
            .crm-container-admin, .table-centered-admin, .block-admin-uniform, .dt-controls-flex

        {
            max-width: 99vw;
        }

        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="crm-title-admin mb-4">Gestión de condiciones médicas</h2>
    <!-- Bloque Título estandarizado -->
    <div class="block-admin-uniform mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center block-title-admin-x">
            <div>
                <div class="mb-2 fs-4">
                    <i class="bi bi-hospital me-2" style="font-size:1.4em;color:#3196fa;vertical-align:middle"></i>
                    Gestión de condiciones médicas
                </div>
                <div class="text-muted mb-2">
                    Administre, edite y relacione todas las condiciones médicas del sistema.
                </div>
            </div>
        </div>
    </div>

    <!-- Bloque de controles en una sola linea (select izquierda, buscador y mostrar eliminados derecha) -->
    <div class="dt-controls-flex">
        <div class="dt-controls-left">
            <div id="gridLengthWrapper"></div>
        </div>
        <div class="dt-controls-right">
            <div class="form-check form-switch d-inline-block align-middle">
                <input class="form-check-input" type="checkbox" role="switch" id="switchEliminados">
                <label class="form-check-label" for="switchEliminados">Mostrar eliminados</label>
            </div>
            <div id="gridSearchWrapper"></div>
        </div>
    </div>

    <!-- Bloque Grid centrado -->
    <div class="table-centered-admin">
        <table id="condicionesGrid" class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>ID Padre</th>
                    <th>Idioma</th>
                    <th>Eliminado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal Editar -->
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form id="formEditar" class="crm-modal-content modal-content">
                <div class="crm-modal-header modal-header">
                    <h5 class="crm-modal-title modal-title" id="modalEditarLabel">Editar Condición</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="crm-modal-body modal-body">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="mb-3">
                        <label for="edit_nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="edit_nombre" name="nombre" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit_idPadre" class="form-label">ID Padre (dejar vacío si es padre)</label>
                        <input type="number" class="form-control" id="edit_idPadre" name="idPadre">
                    </div>
                    <div class="mb-3">
                        <label for="edit_idIdioma" class="form-label">ID Idioma</label>
                        <input type="number" class="form-control" id="edit_idIdioma" name="idIdioma" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit_icono" class="form-label">Ícono</label>
                        <input type="text" class="form-control" id="edit_icono" name="icono">
                    </div>
                    <div class="mb-3">
                        <label for="edit_eliminado" class="form-label">¿Eliminado?</label>
                        <select class="form-select" id="edit_eliminado" name="eliminado">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>
                    </div>
                    <div class="alert alert-success d-none" id="msgEditSuccess">¡Edición realizada correctamente!</div>
                </div>
                <div class="crm-modal-footer modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Aceptar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    var urlEditar = Url.Page(null, "EditarCondicion");
}
<script>console.log("URL EditarCondicion:", "@urlEditar");</script>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let condicionesTabla;
        let hijosPorPadre = {};
        function actualizarDiccionarioHijos(data) {
            hijosPorPadre = {};
            data.forEach(item => {
                if (item.idPadre && item.idPadre !== 0) {
                    if (!hijosPorPadre[item.idPadre]) {
                        hijosPorPadre[item.idPadre] = [];
                    }
                    hijosPorPadre[item.idPadre].push(item.id);
                }
            });
        }

        $(function() {
            condicionesTabla = $('#condicionesGrid').DataTable({
                processing: true,
                serverSide: true,
                dom: 'lfrtip',
                ajax: {
                    url: '@Url.Page(null, "GridData")',
                    type: 'GET',
                    data: function (d) {
                        d.mostrarEliminados = $('#switchEliminados').is(':checked');
                    },
                    dataSrc: function(json) {
                        actualizarDiccionarioHijos(json.data);
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'nombre',
                        orderable: false,
                        render: function(data, type, row) {
                            if (!row.esPadre && row.idPadre) {
                                return `<span class="cond-hijo">- ${data}</span>`;
                            }
                            return `<span class="cond-padre">${data}</span>`;
                        }
                    },
                    {
                        data: 'esPadre',
                        orderable: false,
                        render: function(data) {
                            return data
                                ? `<span class="badge badge-grid-gray">Padre</span>`
                                : `<span class="badge badge-grid-gray">Hijo</span>`;
                        }
                    },
                    { data: 'idPadre', orderable: false, defaultContent: '' },
                    { data: 'idIdioma', orderable: false },
                    {
                        data: 'eliminado',
                        orderable: false,
                        render: function(data) {
                            let texto = data ? "Sí" : "No";
                            return `<span class="badge badge-grid-gray">${texto}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            let editBtn = `<button class='btn btn-sm btn-action-grid btn-action-edit btn-editar' title='Editar' data-id='${row.id}'><i class="bi bi-pencil-square"></i> Editar</button>`;
                            let actionBtn = "";
                            const esHijo = !row.esPadre && row.idPadre;
                            const tieneHijos = hijosPorPadre[row.id] && hijosPorPadre[row.id].length > 0;
                            let eliminarBtn = `<button class='btn btn-sm btn-action-grid btn-action-delete btn-borrar' title='Eliminar' data-id='${row.id}'><i class="bi bi-trash"></i> Eliminar</button>`;
                            if (row.eliminado) {
                                if (esHijo && !tieneHijos) {
                                    actionBtn = ` <button class='btn btn-sm btn-action-grid btn-action-edit btn-restaurar' title='Restaurar' data-id='${row.id}'><i class="bi bi-arrow-counterclockwise" style="color:#3196fa"></i> Restaurar</button>`;
                                }
                            } else {
                                if (esHijo && !tieneHijos) {
                                    actionBtn = eliminarBtn;
                                }
                            }
                            return editBtn + actionBtn;
                        }
                    }
                ],
                order: [],
                language: {
                    emptyTable: "No hay condiciones registradas.",
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros"
                },
                initComplete: function(settings, json) {
                    if ($('#condicionesGrid_length').length) {
                        const $length = $('#condicionesGrid_length');
                        $length.css({display:'inline-flex','align-items':'center',margin:'0', 'white-space':'nowrap'});
                        $("#gridLengthWrapper").empty().append($length.children());
                    }
                    if ($('#condicionesGrid_filter').length) {
                        const $filter = $('#condicionesGrid_filter');
                        $filter.css({display:'inline-flex','align-items':'center',margin:'0', 'white-space':'nowrap'});
                        $("#gridSearchWrapper").empty().append($filter.children());
                    }
                }
            });

            $('#switchEliminados').change(function () {
                condicionesTabla.ajax.reload();
            });

            $('#condicionesGrid').on('click', '.btn-editar', function () {
                const id = $(this).data('id');
                $.get('@Url.Page(null, "GetCondicion")', { id: id }, function(data) {
                    $('#edit_id').val(data.id);
                    $('#edit_nombre').val(data.nombre);
                    $('#edit_idPadre').val(data.idPadre || "");
                    $('#edit_idIdioma').val(data.idIdioma);
                    $('#edit_icono').val(data.icono || "");
                    $('#edit_eliminado').val(data.eliminado ? "true" : "false");
                    $('#msgEditSuccess').addClass('d-none');
                    $('#modalEditar').modal('show');
                })
            });

            $('#formEditar').on('submit', function (e) {
                e.preventDefault();
                var serialized = $(this).serialize();
                $.ajax({
                    url: '@Url.Page(null, "EditarCondicion")',
                    type: "POST",
                    data: serialized,
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    success: function (response) {
                        if (response.success) {
                            $('#msgEditSuccess').removeClass('d-none');
                            condicionesTabla.ajax.reload(null, false);
                            setTimeout(function () {
                                $('#modalEditar').modal('hide');
                            }, 1000);
                        } else {
                            alert('Error: ' + (response.message || 'No se pudo guardar.'));
                        }
                    }
                });
            });

            $('#condicionesGrid').on('click', '.btn-borrar', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea eliminar este registro? Esta acción no se puede deshacer.')) {
                    $.ajax({
                        url: '@Url.Page(null, "EliminarCondicion")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                condicionesTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo eliminar.'));
                            }
                        }
                    });
                }
            });

            $('#condicionesGrid').on('click', '.btn-restaurar', function () {
                const id = $(this).data('id');
                if (confirm('¿Seguro que desea restaurar este registro?')) {
                    $.ajax({
                        url: '@Url.Page(null, "RestaurarCondicion")',
                        type: "POST",
                        data: $.param({ id: id }),
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        success: function (response) {
                            if (response.success) {
                                condicionesTabla.ajax.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo restaurar.'));
                            }
                        }
                    });
                }
            });

        });
    </script>
}