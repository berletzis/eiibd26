@* Shared sidebar menu (corrección final)
   - Mantengo tu markup intacto.
   - Incluyo botón inline (class="sidebar-toggle-inline") dentro del sidebar.
   - Incluyo script que ELIMINA (remove()) cualquier otro botón que abra #sidebarOffcanvas
     siempre que esté fuera de .sidebar-menu o ubicado en la topbar.
*@

@using Microsoft.AspNetCore.Http
@{
    var path = ViewContext.HttpContext.Request.Path.ToString();
    // Mustard color for the icon
    var mustard = "#D4A017";

    // Helpers for active states
    bool IsActive(string p) => string.Equals(path, p, StringComparison.OrdinalIgnoreCase);
    bool IsStartingWith(string p) => path.StartsWith(p ?? "", StringComparison.OrdinalIgnoreCase);

    // Content submenu open if any contenidos route is active
    var contenidosRoot = "/Identity/Admin/Contenidos";
    var contenidosOpen = IsStartingWith(contenidosRoot);
}

<style>
    /* Sidebar sizing (desktop) - more width so items don't wrap and reduce white area */
    .sidebar-menu {
        width: 260px;
        min-width: 260px;
        max-width: 320px;
        box-sizing: border-box;
    }

        /* Tighter nav item spacing */
        .sidebar-menu .nav-link {
            padding: .45rem .6rem;
        }

            /* Ensure icons keep consistent space */
            .sidebar-menu .nav-link .me-2 {
                min-width: 30px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

    /* Offcanvas (mobile) width: make it wider and remove big blank margins */
    #sidebarOffcanvas.offcanvas {
        --bs-offcanvas-width: 320px; /* bootstrap 5 variable */
        max-width: 92%;
    }

    /* Slightly reduce padding inside offcanvas body so content fills space */
    #sidebarOffcanvas .offcanvas-body {
        padding-top: .75rem;
        padding-bottom: .75rem;
        padding-left: .6rem;
        padding-right: .6rem;
    }

    /* When sidebar-menu is rendered inside the offcanvas, make it use the full offcanvas width */
    #sidebarOffcanvas .sidebar-menu {
        width: 100%;
        min-height: calc(100vh - 56px);
        border-right: none;
        box-shadow: none;
    }

    /* Remove duplicate inline toggler from inside the offcanvas (visual safety) -
       script already attempts to remove duplicates, esto evita ver un botón encima */
    #sidebarOffcanvas .sidebar-toggle-inline {
        display: none !important;
    }

    /* Reduce the large blank vertical spacing between items inside offcanvas */
    #sidebarOffcanvas .nav {
        gap: .25rem;
    }

    /* Position close button visually consistent */
    #sidebarOffcanvas .btn-close {
        position: absolute;
        top: .5rem;
        right: .5rem;
    }

    /* Responsive tweaks: on narrow devices, let offcanvas take a bit more width */
    @@media (max-width: 768px) {
        .sidebar-menu {
            width: auto;
            min-width: 0;
        }

        #sidebarOffcanvas.offcanvas {
            --bs-offcanvas-width: 85%;
            max-width: 420px;
        }
    }

    /* Accessibility & small styling */
    .sidebar-menu .nav-link .visually-hidden {
        margin-left: .25rem;
    }
</style>

<div class="d-flex flex-column flex-shrink-0 p-3 bg-light sidebar-menu" style="min-height: 100vh; border-right: 1px solid #ececec; position:relative;">
    @* Mobile inline toggler: visible only on small screens, positioned at top-right of the sidebar box *@
    <button class="btn sidebar-toggle-inline d-md-none"
            type="button"
            data-sidebar-toggle-id="1"
            data-bs-toggle="offcanvas"
            data-bs-target="#sidebarOffcanvas"
            aria-controls="sidebarOffcanvas"
            aria-label="Abrir menú lateral">
        <span class="visually-hidden">Abrir menú</span>
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <ul class="nav nav-pills flex-column mb-auto">
        <!-- Inicio -->
        <li class="nav-item mb-1">
            <a href="/" class="nav-link text-dark @(IsActive("/") ? "active" : "")">
                <i class="bi bi-house"></i> Inicio
            </a>
        </li>

        <!-- Admin encabezado (solo escudo rojo en cuadro, palabra normal) -->
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
        {
            <li class="nav-item mt-2 mb-1">
                <span class="nav-link disabled fw-bold d-flex align-items-center" style="opacity:1;">
                    <span class="d-inline-flex align-items-center justify-content-center rounded border admin-icon me-2" style="width:30px;height:30px; border-width:2px;">
                        <i class="bi bi-shield-shaded" style="color:#c92a2a; font-size:1.3em"></i>
                    </span>
                    <span>Admin</span>
                </span>
            </li>

            @* Contenidos parent with collapsible submenu *@
            <li class="nav-item">
                <a class="nav-link admin d-flex ms-2 text-dark @(contenidosOpen ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#submenuContenidos"
                   role="button"
                   aria-expanded="@(contenidosOpen.ToString().ToLower())"
                   aria-controls="submenuContenidos"
                   style="gap:.5rem;">
                    <i class="bi bi-folder2-open me-2"></i>
                    <span>Contenidos</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </a>

                <div class="collapse @(contenidosOpen ? "show" : "")" id="submenuContenidos">
                    <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                        <li>
                            <a href="/Identity/Admin/Contenidos/Index"
                               class="nav-link ms-4 text-dark @(IsActive("/Identity/Admin/Contenidos/Index") ? "active" : "")">
                                <i class="bi bi-file-earmark-text"></i> Panel Contenidos
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Admin/Contenidos/ContenidosCategorias"
                               class="nav-link ms-4 text-dark @(IsActive("/Identity/Admin/Contenidos/ContenidosCategorias") ? "active" : "")">
                                <i class="bi bi-tags"></i> Categorías de Contenido
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="/Identity/Admin/Usuarios/Index" class="nav-link admin ms-4 text-dark @(IsActive("/Identity/Admin/Usuarios/Index") ? "active" : "")">
                    <i class="bi bi-person-vcard"></i> Usuarios
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Condiciones/Index" class="nav-link admin ms-4 text-dark @(IsActive("/Identity/Admin/Condiciones/Index") ? "active" : "")">
                    <i class="bi bi-hospital"></i> Condiciones
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Sintomas/Index" class="nav-link admin ms-4 text-dark @(IsActive("/Identity/Admin/Sintomas/Index") ? "active" : "")">
                    <i class="bi bi-activity"></i> Síntomas
                </a>
            </li>
            <li>
                <a href="/Identity/Admin/Tratamientos/Index" class="nav-link admin ms-4 text-dark @(IsActive("/Identity/Admin/Tratamientos/Index") ? "active" : "")">
                    <i class="bi bi-prescription2"></i> Tratamientos
                </a>
            </li>
        }
        @* Mi PyR: top-level, now uses same icon container/size as Admin *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <li class="nav-item mb-1">
                <a href="/Identity/Usuario/Dashboard"
                   class="nav-link text-dark d-flex align-items-center @(IsActive("/Identity/Usuario/Dashboard") ? "active fw-bold" : "fw-bold")"
                   style="gap:.5rem;">
                    <span class="d-inline-flex align-items-center justify-content-center rounded border me-2" style="width:30px;height:30px; border-width:2px;">
                        <i class="bi bi-motherboard" style="color:@mustard; font-size:1.3em"></i>
                    </span>
                    <span>Panel de Control</span>
                </a>
            </li>

            <li class="nav-item mb-1">
                <a href="/Identity/Usuario/usuarioPreguntasRespuestas"
                   class="nav-link text-dark d-flex align-items-center @(IsActive("/Identity/Usuario/usuarioPreguntasRespuestas") ? "active fw-bold" : "fw-bold")"
                   style="gap:.5rem;">
                    <span class="d-inline-flex align-items-center justify-content-center rounded border me-2" style="width:30px;height:30px; border-width:2px;">
                        <i class="bi bi-chat-left-dots" style="color:@mustard; font-size:1.3em"></i>
                    </span>
                    <span>Mis P&R</span>
                </a>
            </li>
        }

        <!-- Mi Salud encabezado (corazón en cuadro morado, texto normal) -->
        <li class="nav-item mt-4 mb-1">
            <span class="nav-link disabled fw-bold d-flex align-items-center" style="opacity:1;">
                <span class="d-inline-flex align-items-center justify-content-center rounded border salud-icon me-2" style="width:30px;height:30px; border-width:2px;">
                    <i class="bi bi-heart-pulse" style="color:#7522ca; font-size:1.35em"></i>
                </span>
                <span>Mi Salud</span>
            </span>
        </li>

        <li>
            <a href="/Identity/Usuario/UsuarioEstadoAnimo" class="nav-link salud ms-4 text-dark @(IsActive("/Identity/Usuario/UsuarioEstadoAnimo") ? "active" : "")">
                <i class="bi bi-person-vcard"></i> Mi Mood
            </a>
        </li>
        <li>
            <a href="/Identity/Usuario/UsuarioCondiciones" class="nav-link salud ms-4 text-dark @(IsActive("/Identity/Usuario/UsuarioCondiciones") ? "active" : "")">
                <i class="bi bi-lungs"></i> Mis condiciones
            </a>
        </li>
        <li>
            <a href="/Identity/Usuario/UsuarioSintomas" class="nav-link salud ms-4 text-dark @(IsActive("/Identity/Usuario/UsuarioSintomas") ? "active" : "")">
                <i class="bi bi-heartbreak"></i> Mis síntomas
            </a>
        </li>
        <li>
            <a href="/Identity/Usuario/UsuarioSintomasSeguimiento" class="nav-link salud ms-4 text-dark @(IsActive("/Identity/Usuario/UsuarioSintomasSeguimiento") ? "active" : "")">
                <i class="bi bi-graph-up"></i> Seguimiento de síntomas
            </a>
        </li>
        <li>
            <a href="/Identity/Usuario/UsuarioTratamientos" class="nav-link salud ms-4 text-dark @(IsActive("/Identity/Usuario/UsuarioTratamientos") ? "active" : "")">
                <i class="bi bi-capsule-pill"></i> Mis tratamientos
            </a>
        </li>
    </ul>
</div>

<script>
    (function () {
        // Definitive removal of duplicate togglers:
        // Keep only the button that belongs to .sidebar-menu (the inline toggler).
        function removeDuplicateSidebarTogglers() {
            try {
                // find togglers that target the sidebar offcanvas
                var selectors = 'button[data-bs-target="#sidebarOffcanvas"], button[aria-controls="sidebarOffcanvas"], [data-bs-toggle="offcanvas"][data-bs-target="#sidebarOffcanvas"]';
                var all = document.querySelectorAll(selectors);

                all.forEach(function (btn) {
                    // if button is inside .sidebar-menu -> keep it
                    if (btn.closest && btn.closest('.sidebar-menu')) {
                        return;
                    }

                    // if the button is inside a topbar/header-like area -> remove it
                    if (btn.closest && (btn.closest('.topbar') || btn.closest('.navbar') || btn.closest('header') || btn.closest('.site-header') || btn.closest('.topbar-desktop') || btn.closest('.topb'))) {
                        btn.remove();
                        return;
                    }

                    // As fallback: remove any button that is near the top of the viewport (likely the top toggler)
                    var rect = btn.getBoundingClientRect && btn.getBoundingClientRect();
                    if (rect && rect.top < (window.innerHeight * 0.25)) {
                        btn.remove();
                        return;
                    }

                    // Finally, if there is already a .sidebar-menu toggler present, remove other buttons
                    if (document.querySelector('.sidebar-menu .sidebar-toggle-inline')) {
                        btn.remove();
                    }
                });
            } catch (e) {
                console && console.warn && console.warn('removeDuplicateSidebarTogglers error', e);
            }
        }

        // Run on DOM ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                removeDuplicateSidebarTogglers();
                setTimeout(removeDuplicateSidebarTogglers, 700);
            });
        } else {
            removeDuplicateSidebarTogglers();
            setTimeout(removeDuplicateSidebarTogglers, 700);
        }

        // Observe DOM changes and remove any duplicated toggler that may be injected later
        var observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                m.addedNodes.forEach(function (node) {
                    if (!node || node.nodeType !== 1) return;
                    try {
                        if (node.matches && node.matches('button[data-bs-target="#sidebarOffcanvas"], button[aria-controls="sidebarOffcanvas"], [data-bs-toggle="offcanvas"][data-bs-target="#sidebarOffcanvas"]')) {
                            // if not inside .sidebar-menu -> remove
                            if (!node.closest('.sidebar-menu')) node.remove();
                        } else {
                            // if descendants include such buttons
                            var found = node.querySelector && node.querySelector('button[data-bs-target="#sidebarOffcanvas"], button[aria-controls="sidebarOffcanvas"], [data-bs-toggle="offcanvas"][data-bs-target="#sidebarOffcanvas"]');
                            if (found && !found.closest('.sidebar-menu')) found.remove();
                        }
                    } catch (e) { /* ignore */ }
                });
            });
        });

        observer.observe(document.body, { childList: true, subtree: true });

        // Extra safety: run a few times during initial load
        var tries = 0;
        var interval = setInterval(function () {
            removeDuplicateSidebarTogglers();
            tries++;
            if (tries > 6) clearInterval(interval);
        }, 500);
    })();
</script>