@using Microsoft.AspNetCore.Http
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
}
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="~/img/logo.png" alt="eiibd26 logo" height="38"
                     style="max-height:38px;max-width:140px;object-fit:contain;" />
            </a>

            <button class="navbar-toggler" type="button"
                    title="Abrir menú principal" aria-label="Abrir menú principal"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Menú principal izquierda -->
                <ul class="navbar-nav me-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Inicio</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Privacy">Privacidad</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" href="/Preguntas" title="Ir a mi Preguntas y Respuestas" aria-label="Preguntas y Respuestas">
                            <i class="bi bi-person-circle me-1"></i>
                            <span>Preguntas y Respuestas</span>
                        </a>
                    </li>

                    @* "Ir a Mi Perfil" se mantiene a la izquierda y sólo se muestra si está autenticado *@
                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" href="/Identity/Usuario/UsuarioPerfil" title="Ir a mi perfil" aria-label="Ir a mi perfil">
                                <i class="bi bi-person-circle me-1"></i>
                                <span>Ir a Mi Perfil</span>
                            </a>
                        </li>
                    }
                </ul>

                <!-- Menú de usuario derecha: Login & Registro (cuando NO está autenticado)
                     y el dropdown "Mi Perfil (Opciones)" (cuando SÍ está autenticado) -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (!isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Register">
                                <i class="bi bi-person-plus me-1"></i> Registro
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="perfilDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false" title="Mi Perfil" aria-label="Mi Perfil">
                                <i class="bi bi-person-gear me-1"></i>
                                <span>Mi Perfil (Opciones)</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="perfilDropdown">
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage">
                                        <i class="bi bi-person-card me-1"></i> Perfil principal
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/Email">
                                        <i class="bi bi-envelope me-1"></i> Cambiar email
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/ChangePassword">
                                        <i class="bi bi-key me-1"></i> Cambiar contraseña
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/TwoFactorAuthentication">
                                        <i class="bi bi-shield-lock me-1"></i> Doble factor
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Identity/Account/Manage/ExternalLogins">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Logins externos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>