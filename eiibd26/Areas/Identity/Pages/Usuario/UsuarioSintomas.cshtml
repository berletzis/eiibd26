@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioSintomasModel
@{
    ViewData["Title"] = "Mis síntomas";
    Layout = "_Layout";
}
<div class="container py-4">
    <h1 class="crm-title mb-4">Mis síntomas</h1>
    <div class="qp-wrapper-flex">

        <div class="crm-card">
            <label for="sintomaBuscar" class="crm-label">
                Busca y agregar el Sintoma que tienes o recuerdes haber tenido.
            </label>
        <form id="agregarSintomaForm" autocomplete="off" class="crm-form-row" onsubmit="return false;">
            <div class="crm-search-group crm-col-8">
 
                <div class="crm-search-horizontal">
                        <input id="sintomaBuscar" type="text" class="crm-input" placeholder="Ej: Dolor de cabeza, Tos..." autocomplete="off" />
                        <button id="btnAgregarSintoma" class="crm-btn crm-btn-primary" type="button">
                            <i class="bi bi-zoom-in"></i>
                    </button>
                </div>
                <input id="sintomaIdSeleccionado" type="hidden" />
                <ul id="sintomaSugerencias" class="crm-list-suggest"></ul>
            </div>
        </form>
    </div>
    </div>
        <div class="condiciones-paginacion" aria-label="Paginación">
            <span>Lista de todos los Sintomas</span>
        </div>

            <div class="condiciones-cards" aria-label="Condiciones">
    @if (Model.MisSintomas.Any())
    {
        <div class="crm-card-row">
            @foreach (var sint in Model.MisSintomas)
            {
                var ultimoTracking = sint.UltimoTracking;
                <div class="crm-card-condicion">
                    <div class="crm-card-inner">
                        <div class="crm-card-header">
                            <span class="crm-card-title">
                                @sint.Nombre
                            </span>
                            <button type="button" class="crm-btn crm-btn-delete btn-eliminar-sintoma"
                                    style="border:none;background:#f3f5f8;box-shadow:none;"
                                    data-id="@sint.Id"
                                    data-nombre="@sint.Nombre"
                                    data-tratamientos="@sint.TratamientosCount"
                                    data-condiciones="@sint.CondicionesCount"
                                    title="Eliminar síntoma">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                        <div class="crm-card-fecha">
                                <span class="crm-card-label">
                                    <i class="bi bi-calendar2-date"></i>
                                    Fecha de Inicio del Sintoma
                                </span>
                            <form method="post" class="form-editar-fecha" data-id="@sint.Id" asp-page-handler="EditarFechaInicio">
                                <div class="crm-input-group" style="column-gap:3px;">
                                    <input type="hidden" name="sintId" value="@sint.Id" />
                                    <input type="date"
                                           class="crm-input-date fecha-inicio"
                                           style="width:150px; min-width:140px; max-width:170px;"
                                           name="nuevaFechaInicio"
                                           value="@sint.FechaInicio.ToString("yyyy-MM-dd")"
                                           disabled />
                                    <button type="button"
                                            class="crm-btn crm-btn-secondary btn-editar-fecha"
                                            style="border:none;"
                                            title="Editar fecha de inicio">
                                   Editar
                                    </button>
                                    <button type="submit"
                                            class="crm-btn crm-btn-success d-none btn-guardar-fecha"
                                            style="border:none;"
                                            title="Guardar nueva fecha">
                               Guardar
                                    </button>
                                    <button type="button"
                                            class="crm-btn crm-btn-cancel d-none btn-cancelar-fecha"
                                            style="border:none;"
                                            title="Cancelar edición de fecha">
                                            Cancelar
                                    </button>
        
                                </div>
                            </form>
                        </div>
                        <div class="crm-card-section mb-2">
                            <div class="crm-card-subtitle" style="font-size:.98em; color:#315686;">
                                Condiciones
                                <button type="button" class="crm-btn crm-btn-secondary open-modal-cond ms-1" style="padding:0 8px; border:none;" data-sintid="@sint.Id" title="Asociar condiciones">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                            <div class="crm-card-badges mt-2" id="cond-list-@sint.Id">
                                @if (sint.Condiciones.Any())
                                {
                                    @foreach (var cond in sint.Condiciones)
                                    {
                                        <a href="#" class="crm-badge crm-badge-label bg-info mb-1 d-inline-flex align-items-center">
                                            @cond.Nombre
                                            <button type="button" class="crm-btn btn-sm btn-link p-0 ms-1 badge-cond-del" style="color:red; border:none;" data-condid="@cond.Id" data-sintid="@sint.Id" title="Quitar condición">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Ninguna</span>
                                }
                            </div>
                        </div>
                        <div class="crm-card-section mb-2">
                            <div class="crm-card-subtitle" style="font-size:.98em; color:#315686;">
                                Tratamientos
                                <button type="button" class="crm-btn crm-btn-secondary open-modal-trat ms-1" style="padding:0 8px; border:none;" data-sintid="@sint.Id" title="Asociar tratamientos">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                            <div class="crm-card-badges mt-2" id="trat-list-@sint.Id">
                                @if (sint.Tratamientos.Any())
                                {
                                    @foreach (var trat in sint.Tratamientos)
                                    {
                                        <a href="#" class="crm-badge crm-badge-label bg-success text-white mb-1 d-inline-flex align-items-center">
                                            @trat.Nombre
                                            <button type="button" class="crm-btn btn-sm btn-link p-0 ms-1 badge-trat-del" style="color:red; border:none;" data-tratid="@trat.Id" data-sintid="@sint.Id" title="Quitar tratamiento">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Ninguno</span>
                                }
                            </div>
                        </div>
                        <!-- Seguimiento: leyenda tipo fuente y tamaño igual a Sin seguimiento -->
                        <div class="mt-auto pt-2 d-flex align-items-start flex-wrap justify-content-start">
                                <div class="crm-card-subtitle" style="font-size:.98em; color:#315686;">
                                    <div>Seguimiento</div>
                                    <div class="crm-seguimiento-value" style="margin-top:6px;">
                                        @if (ultimoTracking != null)
                                        {
                                            <span>@(ultimoTracking.Estado) (@ultimoTracking.Fecha.ToString("dd/MM/yyyy"))</span>
                                        }
                                        else
                                        {
                                            <span>Sin seguimiento</span>
                                        }
                                    </div>
                                </div>
                            <button type="button" class="btn-track-sintoma" 
                                    data-id="@sint.Id"
                                    data-nombre="@sint.Nombre"
                                    title="Registra cómo estás hoy">
                                <i class="bi bi-clipboard-heart-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="crm-card mb-2">
            <div class="fw-light text-muted crm-empty">
                Aún no has agregado ningún síntoma.
            </div>
        </div>
    }
</div>

<!-- MODAL TRACKING -->
<div class="modal fade" id="modalTrackSintoma" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formTrackSintoma">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTrackSintomaTitle">Seguimiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="mensajeTrackingAgregado" class="alert alert-success py-2 px-3 small mb-2 d-none">
                        <i class="bi bi-check-circle-fill me-1"></i> Tracking agregado
                    </div>
                    <div class="mb-2 fw-semibold" id="modalTrackSintomaPregunta"></div>
                    <div id="modalTrackSintomaOpciones" class="d-flex flex-column gap-2">
                        <!-- Se llena por JS -->
                    </div>
                </div>
                <input type="hidden" name="sintomaUsuarioId" id="trackSintomaUsuarioId" />
            </form>
        </div>
    </div>
</div>

<!-- MODAL CONDICIONES -->
<div class="modal fade" id="modalCondiciones" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formAsociaCond">
                <div class="modal-header">
                    <h5 class="modal-title">Asociar condiciones al síntoma</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="cond-list-modal"></div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                </div>
                <input type="hidden" name="sintomaId" id="modalCondSintId" />
            </form>
        </div>
    </div>
</div>

<!-- MODAL TRATAMIENTOS -->
<div class="modal fade" id="modalTratamientos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formAsociaTrat">
                <div class="modal-header">
                    <h5 class="modal-title">Asociar tratamientos al síntoma</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="trat-list-modal"></div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                </div>
                <input type="hidden" name="sintomaId" id="modalTratSintId" />
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Autocomplete buscar síntoma
            const urlAutocomplete = "/api/sintomas/autocomplete";
            document.getElementById('sintomaBuscar').addEventListener('input', async function () {
                let query = this.value.trim();
                let sugerenciasUl = document.getElementById('sintomaSugerencias');
                sugerenciasUl.innerHTML = '';
                document.getElementById('sintomaIdSeleccionado').value = "";
                if (query.length < 2) return;
                let resp = await fetch(urlAutocomplete + '?q=' + encodeURIComponent(query));
                if (!resp.ok) return;
                let datos = await resp.json();
                datos.forEach(item => {
                    let li = document.createElement('li');
                    li.className = 'crm-list-item list-group-item';
                    li.innerText = item.nombre;
                    li.onclick = function () {
                        document.getElementById('sintomaBuscar').value = item.nombre;
                        document.getElementById('sintomaIdSeleccionado').value = item.id;
                        sugerenciasUl.innerHTML = '';
                    }
                    sugerenciasUl.appendChild(li);
                });
            });
            document.getElementById('sintomaBuscar').addEventListener('blur', function () {
                setTimeout(() => { document.getElementById('sintomaSugerencias').innerHTML = ''; }, 200);
            });

            // Agregar síntoma
            document.getElementById('btnAgregarSintoma').addEventListener('click', async function () {
                let id = document.getElementById('sintomaIdSeleccionado').value;
                if (!id) {
                    alert("Debes seleccionar un síntoma del listado");
                    return;
                }
                let formData = new FormData();
                formData.append('sintomaId', id);
                let resp = await fetch('?handler=AgregarSintoma', { method: "POST", body: formData });
                if (resp.ok) location.reload();
                else {
                    let msg = await resp.json();
                    alert(msg.mensaje || "Error");
                }
            });

            // Eliminar síntoma
            document.querySelectorAll('.btn-eliminar-sintoma').forEach(btn => {
                btn.addEventListener('click', function () {
                    let tratamientos = parseInt(this.dataset.tratamientos || "0");
                    let condiciones = parseInt(this.dataset.condiciones || "0");
                    let nombre = this.dataset.nombre || "";
                    let sintid = this.dataset.id || "";
                    if (tratamientos > 0 || condiciones > 0) {
                        alert("No se puede eliminar \"" + nombre + "\" porque tiene tratamientos o condiciones relacionados. Primero elimínalos.");
                        return;
                    }
                    if (confirm('¿Estás seguro de eliminar "' + nombre + '"? Esta acción no se puede deshacer.')) {
                        let formData = new FormData();
                        formData.append('sintId', sintid);
                        fetch('?handler=EliminarSintoma', { method: "POST", body: formData })
                            .then(resp => resp.ok ? location.reload() : resp.json().then(d => alert(d.mensaje || "Error eliminando síntoma")));
                    }
                });
            });

            // Tracking: setup always even for not tracked
            function setupTrackingButtons() {
                document.querySelectorAll('.btn-track-sintoma').forEach(btn => {
                    btn.onclick = function () {
                        document.getElementById('mensajeTrackingAgregado').classList.add("d-none");
                        const sintId = this.dataset.id;
                        const nombre = this.dataset.nombre;
                        document.getElementById('modalTrackSintomaTitle').innerText = 'Seguimiento de "' + nombre + '"';
                        document.getElementById('modalTrackSintomaPregunta').innerText = `¿Cómo está tu "${nombre}" hoy?`;

                        const opcionesEstado = [
                            { val: "Ninguno", label: "Ninguno" },
                            { val: "Leve", label: "Leve" },
                            { val: "Moderado", label: "Moderado" },
                            { val: "Severo", label: "Severo" }
                        ];
                        let html = '';
                        opcionesEstado.forEach(o => {
                            html += `<button type="button" class="btn btn-outline-primary w-100 btn-opcion-tracking" data-estado="${o.val}">${o.label}</button>`;
                        });
                        document.getElementById('modalTrackSintomaOpciones').innerHTML = html;
                        document.getElementById('trackSintomaUsuarioId').value = sintId;

                        var modalElem = document.getElementById('modalTrackSintoma');
                        if (modalElem) {
                            var modal = bootstrap.Modal.getOrCreateInstance(modalElem);
                            modal.show();
                        }

                        setTimeout(function() {
                            document.querySelectorAll('.btn-opcion-tracking').forEach(btnOpcion => {
                                btnOpcion.onclick = async function () {
                                    let estado = this.dataset.estado;
                                    let sintomaUsuarioId = document.getElementById('trackSintomaUsuarioId').value;
                                    let formData = new FormData();
                                    formData.append('sintomaUsuarioId', sintomaUsuarioId);
                                    formData.append('estado', estado);
                                    let resp = await fetch('?handler=TrackSintoma', { method: 'POST', body: formData });
                                    if (resp.ok) {
                                        let msg = document.getElementById('mensajeTrackingAgregado');
                                        if (msg) msg.classList.remove('d-none');

                                        // Update seguimiento text inside the card without refreshing
                                        const btnTrack = document.querySelector('.btn-track-sintoma[data-id="' + sintomaUsuarioId + '"]');
                                        if (btnTrack) {
                                            const cardInner = btnTrack.closest('.crm-card-inner');
                                            if (cardInner) {
                                                const segEl = cardInner.querySelector('.crm-seguimiento-value');
                                                if (segEl) {
                                                    const hoy = new Date();
                                                    const fecha = hoy.getDate().toString().padStart(2, '0') + "/" + (hoy.getMonth() + 1).toString().padStart(2, '0') + "/" + hoy.getFullYear();
                                                    segEl.textContent = estado + ' (' + fecha + ')';
                                                }
                                            }
                                        }

                                        setTimeout(() => {
                                            var modalElemClose = document.getElementById('modalTrackSintoma');
                                            if (modalElemClose) {
                                                bootstrap.Modal.getOrCreateInstance(modalElemClose).hide();
                                            }
                                        }, 700);
                                    } else {
                                        alert('Error guardando seguimiento');
                                    }
                                };
                            });
                        }, 80);
                    };
                });
            }
            setupTrackingButtons();
            document.addEventListener("readystatechange", function () {
                if (document.readyState === "complete") {
                    setupTrackingButtons();
                }
            });

            // Editar fecha inicio
            document.querySelectorAll('.form-editar-fecha').forEach(form => {
                let btnEdit = form.querySelector('.btn-editar-fecha');
                let btnSave = form.querySelector('.btn-guardar-fecha');
                let btnCancel = form.querySelector('.btn-cancelar-fecha');
                let input = form.querySelector('.fecha-inicio');
                let valorOriginal = input.value;

                btnEdit.addEventListener('click', (e) => {
                    e.preventDefault();
                    input.disabled = false;
                    btnEdit.classList.add('d-none');
                    btnSave.classList.remove('d-none');
                    btnCancel.classList.remove('d-none');
                });
                btnCancel.addEventListener('click', (e) => {
                    e.preventDefault();
                    input.value = valorOriginal;
                    input.disabled = true;
                    btnEdit.classList.remove('d-none');
                    btnSave.classList.add('d-none');
                    btnCancel.classList.add('d-none');
                });
                form.addEventListener('submit', async function (ev) {
                    ev.preventDefault();
                    input.disabled = false;
                    let formData = new FormData(form);
                    try {
                        let resp = await fetch(form.action, { method: "POST", body: formData });
                        if (resp.ok) {
                            valorOriginal = input.value;
                            input.disabled = true;
                            btnEdit.classList.remove('d-none');
                            btnSave.classList.add('d-none');
                            btnCancel.classList.add('d-none');
                        } else {
                            let data = await resp.json().catch(() => ({}));
                            alert('Error al guardar: ' + (data.mensaje || resp.status));
                        }
                    } catch (err) {
                        alert('Error de red al guardar la fecha.');
                    }
                });
            });

            // Condiciones y tratamientos: Mantener los existentes y solo agregar/quitar seleccionados / bug fix
            const condicionesUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MisCondicionesSimplificadas));
            const tratamientosUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MisTratamientosSimplificados));

            var formAsociaCond = document.getElementById('formAsociaCond');
            if (formAsociaCond) {
                formAsociaCond.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    let sintid = document.getElementById('modalCondSintId').value;
                    let condidsChecked = Array.from(document.querySelectorAll('#cond-list-modal input[type=checkbox]:checked')).map(x => x.value);
                    let badges = document.querySelectorAll(`#cond-list-${sintid} .crm-badge`);
                    let yaRelacionadas = Array.from(badges).map(b => b.childNodes[0].textContent.trim());
                    let todosCondIds = Array.from(new Set([...yaRelacionadas, ...condidsChecked]));
                    let formData = new FormData();
                    formData.append('sintomaId', sintid);
                    todosCondIds.forEach(cId => formData.append('condicionUsuarioIds', cId));
                    const resp = await fetch('?handler=AsociarCondiciones', { method: 'POST', body: formData });
                    if (resp.ok) location.reload();
                    else alert("Error al guardar.");
                });
            }
            document.querySelectorAll('.open-modal-cond').forEach(btn => {
                btn.addEventListener('click', function () {
                    let sintid = this.dataset.sintid;
                    let html = "";
                    if (condicionesUsuario.length === 0) {
                        html = `<div class="alert alert-info"><i class="bi bi-exclamation-circle"></i>Debes agregar primero alguna condición en la sección "Condiciones".</div>`;
                    } else {
                        let badges = document.querySelectorAll("#cond-list-" + sintid + " .crm-badge");
                        let seleccionadas = Array.from(badges).map(b => b.childNodes[0].textContent.trim());
                        condicionesUsuario.forEach(c => {
                            let checked = seleccionadas.includes(c.Nombre) ? 'checked' : '';
                            html += `<div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" name="condids" value="${c.Id}" id="chkCond${c.Id}" ${checked}/>
                                <label class="form-check-label" for="chkCond${c.Id}">${c.Nombre}</label>
                            </div>`;
                        });
                    }
                    document.getElementById('cond-list-modal').innerHTML = html;
                    document.getElementById('modalCondSintId').value = sintid;
                    let modal = new bootstrap.Modal(document.getElementById('modalCondiciones'));
                    modal.show();
                });
            });
            document.querySelectorAll('.badge-cond-del').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (confirm('¿Quitar la relación?')) {
                        let sintid = this.dataset.sintid;
                        let condid = this.dataset.condid;
                        let formData = new FormData();
                        formData.append('sintomaId', sintid);
                        formData.append('condicionUsuarioId', condid);
                        fetch('?handler=QuitarRelacionCondicion', { method: 'POST', body: formData })
                            .then(resp => resp.ok ? location.reload() : alert("Error al quitar"));
                    }
                });
            });

            var formAsociaTrat = document.getElementById('formAsociaTrat');
            if (formAsociaTrat) {
                formAsociaTrat.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    let sintid = document.getElementById('modalTratSintId').value;
                    let tratidsChecked = Array.from(document.querySelectorAll('#trat-list-modal input[type=checkbox]:checked')).map(x => x.value);
                    let badges = document.querySelectorAll(`#trat-list-${sintid} .crm-badge`);
                    let yaRelacionadas = Array.from(badges).map(b => b.childNodes[0].textContent.trim());
                    let todosTratIds = Array.from(new Set([...yaRelacionadas, ...tratidsChecked]));
                    let formData = new FormData();
                    formData.append('sintomaId', sintid);
                    todosTratIds.forEach(tId => formData.append('tratamientoUsuarioIds', tId));
                    const resp = await fetch('?handler=AsociarTratamientos', { method: 'POST', body: formData });
                    if (resp.ok) location.reload();
                    else alert("Error al guardar.");
                });
            }
            document.querySelectorAll('.open-modal-trat').forEach(btn => {
                btn.addEventListener('click', function () {
                    let sintid = this.dataset.sintid;
                    let html = "";
                    if (tratamientosUsuario.length === 0) {
                        html = `<div class="alert alert-info"><i class="bi bi-exclamation-circle"></i>Debes agregar primero algún tratamiento en la sección "Tratamientos".</div>`;
                    } else {
                        let badges = document.querySelectorAll("#trat-list-" + sintid + " .crm-badge");
                        let seleccionadas = Array.from(badges).map(b => b.childNodes[0].textContent.trim());
                        tratamientosUsuario.forEach(t => {
                            let checked = seleccionadas.includes(t.Nombre) ? 'checked' : '';
                            html += `<div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" name="tratids" value="${t.Id}" id="chkTrat${t.Id}" ${checked}/>
                                <label class="form-check-label" for="chkTrat${t.Id}">${t.Nombre}</label>
                            </div>`;
                        });
                    }
                    document.getElementById('trat-list-modal').innerHTML = html;
                    document.getElementById('modalTratSintId').value = sintid;
                    let modal = new bootstrap.Modal(document.getElementById('modalTratamientos'));
                    modal.show();
                });
            });
            document.querySelectorAll('.badge-trat-del').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (confirm('¿Quitar la relación?')) {
                        let sintid = this.dataset.sintid;
                        let tratid = this.dataset.tratid;
                        let formData = new FormData();
                        formData.append('sintomaId', sintid);
                        formData.append('tratamientoUsuarioId', tratid);
                        fetch('?handler=QuitarRelacionTratamiento', { method: 'POST', body: formData })
                            .then(resp => resp.ok ? location.reload() : alert("Error al quitar"));
                    }
                });
            });
        });
    </script>
}