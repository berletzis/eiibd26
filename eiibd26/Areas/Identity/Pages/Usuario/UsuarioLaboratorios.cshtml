@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioLaboratoriosModel
@{
    ViewData["Title"] = "Mis Laboratorios";
    Layout = "_Layout";
}

<div class="container py-4">
    <h1 class="eii-page-title">Mis Laboratorios</h1>

    <div class="qp-wrapper-flex">
        <div class="eii-card">
            <label for="selectTipoLab" class="eii-label">
                Selecciona el tipo de estudio para agregar un resultado.
            </label>
            <form id="agregarLabForm" autocomplete="off" class="d-flex flex-wrap gap-3" onsubmit="return false;">
                <div class="position-relative w-100 col-8">
                    <div class="d-flex flex-row align-items-end gap-3">
                        <select id="selectTipoLab" class="eii-input" style="min-width:240px;">
                            <option value="">— Selecciona estudio / categoría —</option>
                            @foreach (var t in Model.TiposHoja)
                            {
                                <option value="@t.Id">@t.Display</option>
                            }
                        </select>
                        <button id="btnAgregarLab" class="eii-btn eii-btn--primary eii-btn--icon eii-btn--circle" type="button">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="condiciones-paginacion" aria-label="Resultados">
        <span>Lista de resultados registrados</span>
    </div>

    <div class="condiciones-cards" aria-label="Resultados de laboratorio">
        @if (Model.Resultados.Any())
        {
            <div class="eii-grid eii-grid--cards">
                @foreach (var r in Model.Resultados)
                {
                    <div class="d-flex flex-column h-100">
                        <div class="eii-card eii-card--elevated">

                            <div class="eii-card__header">
                                <span class="eii-card__title">
                                    @if (!string.IsNullOrWhiteSpace(r.ResultValue))
                                    {
                                        @r.ResultValue
                                        if (!string.IsNullOrWhiteSpace(r.ResultUnit))
                                        {
                                            <small class="text-muted ms-1" style="font-size:.78em;">@r.ResultUnit</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-style:italic;font-size:.9em;">Sin resultado aún</span>
                                    }
                                </span>
                                <div class="d-flex gap-1 align-items-center">
                                    <button type="button"
                                            class="eii-btn eii-btn--neutral btn-eliminar-resultado"
                                            style="border:none;background:#f3f5f8;box-shadow:none;"
                                            data-id="@r.Id"
                                            title="Eliminar resultado">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex flex-column mb-2">
                                <span class="eii-text-muted eii-text-sm"><i class="bi bi-file-earmark-medical"></i> Estudio</span>
                                <span class="small text-body">@r.TipoPadre</span>
                            </div>
                            <div class="d-flex flex-column mb-2">
                                <span class="eii-text-muted eii-text-sm"><i class="bi bi-diagram-3"></i> Categoría</span>
                                <span class="small text-body">@r.TipoNombre</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.CondicionNombre))
                            {
                                <div class="d-flex flex-column mb-2">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-lungs"></i> Condición</span>
                                    <span class="small text-body">@r.CondicionNombre</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.SintomaNombre))
                            {
                                <div class="d-flex flex-column mb-2">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-heartbreak"></i> Síntoma</span>
                                    <span class="small text-body">@r.SintomaNombre</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.TratamientoNombre))
                            {
                                <div class="d-flex flex-column mb-2">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-capsule-pill"></i> Tratamiento</span>
                                    <span class="small text-body">@r.TratamientoNombre</span>
                                </div>
                            }

                            <form method="post" class="form-editar-lab" asp-page-handler="ActualizarResultado">
                                <input type="hidden" name="resultadoId" value="@r.Id" />

                                <div class="d-flex flex-column mb-2 mt-2">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-clipboard-pulse"></i> Resultado / Unidad:</span>
                                    <div style="display:flex; flex-wrap:nowrap; gap:4px; align-items:center;">
                                        <input type="text" class="eii-input campo-lab" name="resultValue"
                                               value="@(r.ResultValue ?? "")" placeholder="Resultado..."
                                               maxlength="500" disabled style="flex:2; min-width:0;" />
                                        <select class="eii-input campo-lab" name="laboratoryUnitCatalogId"
                                                disabled style="flex:1; min-width:0; max-width:110px;">
                                            <option value="">—</option>
                                            @foreach (var u in Model.UnidadesMedida)
                                            {
                                                if (r.LaboratoryUnitCatalogId == u.Id) { <option value="@u.Id" selected>@u.Abreviatura</option> }
                                                else { <option value="@u.Id">@u.Abreviatura</option> }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex flex-column mb-2 mt-1">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-calendar2-date"></i> Fecha:</span>
                                    <div class="d-flex align-items-center flex-wrap" style="column-gap:3px;">
                                        <input type="date" class="eii-input campo-lab" name="resultDate"
                                               value="@(r.ResultDate.HasValue ? r.ResultDate.Value.ToString("yyyy-MM-dd") : "")"
                                               disabled />
                                    </div>
                                </div>

                                <div class="d-flex flex-column mb-2 mt-1">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-lungs"></i> Condición:</span>
                                    <div class="d-flex align-items-center flex-wrap" style="column-gap:3px;">
                                        <select class="eii-input campo-lab" name="condicionUsuarioId" disabled
                                                style="min-width:0; flex:1;">
                                            <option value="">— Sin condición —</option>
                                            @foreach (var c in Model.MisCondiciones)
                                            {
                                                if (r.CondicionUsuarioId == c.Id)
                                                {
                                                    <option value="@c.Id" selected>@c.Nombre</option>
                                                }
                                                else
                                                {
                                                    <option value="@c.Id">@c.Nombre</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex flex-column mb-2 mt-1">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-heartbreak"></i> Síntoma:</span>
                                    <div class="d-flex align-items-center flex-wrap" style="column-gap:3px;">
                                        <select class="eii-input campo-lab" name="sintomaUsuarioId" disabled style="min-width:0; flex:1;">
                                            <option value="">— Sin síntoma —</option>
                                            @foreach (var s in Model.MisSintomas)
                                            {
                                                if (r.SintomaUsuarioId == s.Id) { <option value="@s.Id" selected>@s.Nombre</option> }
                                                else { <option value="@s.Id">@s.Nombre</option> }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex flex-column mb-2 mt-1">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-capsule-pill"></i> Tratamiento:</span>
                                    <div class="d-flex align-items-center flex-wrap" style="column-gap:3px;">
                                        <select class="eii-input campo-lab" name="tratamientoUsuarioId" disabled style="min-width:0; flex:1;">
                                            <option value="">— Sin tratamiento —</option>
                                            @foreach (var t in Model.MisTratamientos)
                                            {
                                                if (r.TratamientoUsuarioId == t.Id) { <option value="@t.Id" selected>@t.Nombre</option> }
                                                else { <option value="@t.Id">@t.Nombre</option> }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex flex-column mb-2 mt-1">
                                    <span class="eii-text-muted eii-text-sm"><i class="bi bi-chat-text"></i> Notas:</span>
                                    <div class="d-flex align-items-center flex-wrap" style="column-gap:3px;">
                                        <input type="text" class="eii-input campo-lab" name="notes"
                                               value="@(r.Notes ?? "")" placeholder="Observaciones..."
                                               maxlength="1000" disabled />
                                    </div>
                                </div>

                                <div class="d-flex align-items-center flex-wrap mt-2" style="column-gap:3px;">
                                    <button type="button" class="eii-btn eii-btn--ghost eii-btn--sm btn-editar-lab">
                                        Editar
                                    </button>
                                    <button type="submit" class="eii-btn eii-btn--solid eii-btn--sm d-none btn-guardar-lab">
                                        Guardar
                                    </button>
                                    <button type="button" class="eii-btn eii-btn--ghost eii-btn--sm d-none btn-cancelar-lab">
                                        Cancelar
                                    </button>
                                </div>
                            </form>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="eii-card mb-2">
                <div class="fw-light text-muted eii-text-disabled py-2">
                    <i class="bi bi-journal-medical"></i>
                    Aún no tienes resultados de laboratorio registrados.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function getAntiforgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
        function addAntiforgeryToken(formData) {
            const token = getAntiforgeryToken();
            if (token) formData.set('__RequestVerificationToken', token);
            return formData;
        }

        // Agregar: solo tipo → crea el card vacío
        document.getElementById('btnAgregarLab').addEventListener('click', async function () {
            const tipoId = document.getElementById('selectTipoLab').value;
            if (!tipoId) { alert('Selecciona un estudio / categoría.'); return; }

            const formData = new FormData();
            formData.append('laboratoryTypeId', tipoId);
            addAntiforgeryToken(formData);

            const resp = await fetch('?handler=AgregarResultado', { method: 'POST', body: formData });
            if (resp.ok) location.reload();
            else {
                const data = await resp.json().catch(() => ({}));
                alert(data.mensaje || 'Error al agregar.');
            }
        });

        // Editar / Guardar / Cancelar inline por card
        document.querySelectorAll('.form-editar-lab').forEach(form => {
            const campos     = form.querySelectorAll('.campo-lab');
            const btnEditar  = form.querySelector('.btn-editar-lab');
            const btnGuardar = form.querySelector('.btn-guardar-lab');
            const btnCancelar= form.querySelector('.btn-cancelar-lab');

            const originales = {};
            campos.forEach(c => { originales[c.name] = c.value; });

            btnEditar.addEventListener('click', () => {
                campos.forEach(c => c.disabled = false);
                btnEditar.classList.add('d-none');
                btnGuardar.classList.remove('d-none');
                btnCancelar.classList.remove('d-none');
            });

            btnCancelar.addEventListener('click', () => {
                campos.forEach(c => { c.value = originales[c.name]; c.disabled = true; });
                btnEditar.classList.remove('d-none');
                btnGuardar.classList.add('d-none');
                btnCancelar.classList.add('d-none');
            });

            form.addEventListener('submit', async function (ev) {
                ev.preventDefault();
                campos.forEach(c => c.disabled = false);
                const formData = new FormData(form);
                addAntiforgeryToken(formData);

                btnGuardar.disabled = true;
                btnGuardar.textContent = 'Guardando...';

                try {
                    const resp = await fetch(form.action, { method: 'POST', body: formData });
                    if (resp.ok) {
                        campos.forEach(c => { originales[c.name] = c.value; c.disabled = true; });
                        btnEditar.classList.remove('d-none');
                        btnGuardar.classList.add('d-none');
                        btnCancelar.classList.add('d-none');
                    } else {
                        alert('Error al guardar.');
                    }
                } catch {
                    alert('Error de red.');
                } finally {
                    btnGuardar.disabled = false;
                    btnGuardar.textContent = 'Guardar';
                }
            });
        });

        // Eliminar
        document.querySelectorAll('.btn-eliminar-resultado').forEach(btn => {
            btn.addEventListener('click', function () {
                if (!confirm('¿Estás seguro de eliminar este resultado? Esta acción no se puede deshacer.')) return;
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '?handler=EliminarResultado';
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = 'resultadoId'; inp.value = this.dataset.id;
                form.appendChild(inp);
                const token = getAntiforgeryToken();
                if (token) {
                    const csrf = document.createElement('input');
                    csrf.type = 'hidden';
                    csrf.name = '__RequestVerificationToken';
                    csrf.value = token;
                    form.appendChild(csrf);
                }
                document.body.appendChild(form);
                form.submit();
            });
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/tracking-sintomas.css" asp-append-version="true" />
}
