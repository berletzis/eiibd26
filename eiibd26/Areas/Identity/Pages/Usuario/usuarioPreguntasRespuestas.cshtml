@page
@model eiibd26.Areas.Identity.Pages.Usuario.PreguntasRespuestasModel
@{
    ViewData["Title"] = "Preguntas y Respuestas";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }

    // Render vote control but keep same data attributes & classes the JS expects (.btn-voto-single)
    // Dislike now renders a grey icon button (no text) to match the requested design.
    string RenderVoteControl(Guid id, int userVote, int score, Guid questionOwnerId)
    {
        if (!User.Identity.IsAuthenticated)
            return "<div class=\"vote-login-hint\">Inicia sesión para realizar un voto. <a href=\"/Identity/Account/Login\">Iniciar sesión</a></div>";

        var currentIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentIdClaim) && Guid.TryParse(currentIdClaim, out var currentGuid) && currentGuid == questionOwnerId)
        {
            return "<div class=\"text-muted small\">No puedes votar tu propia pregunta</div>";
        }

        // When user has already upvoted, show grey "dislike" icon to remove vote
        if (userVote == 1)
        {
            return $"<div class=\"vote-container\"><button class=\"crm-vote-btn btn-dislike btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\" title=\"Quitar voto\"><i class=\"bi bi-hand-thumbs-down\"></i></button></div>";
        }

        // If not voted and score <= 0 show like (gradient)
        if (score <= 0)
        {
            return $"<div class=\"vote-container\"><button class=\"crm-vote-btn btn-like btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"1\" title=\"Me gusta\"><i class=\"bi bi-hand-thumbs-up\"></i></button></div>";
        }

        // default (if score > 0 and not voted) show grey dislike icon to allow toggling
        return $"<div class=\"vote-container\"><button class=\"crm-vote-btn btn-dislike btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\" title=\"Quitar voto\"><i class=\"bi bi-hand-thumbs-down\"></i></button></div>";
    }

    string SafePreview(string? text, int maxChars)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (text.Length <= maxChars) return text;
        return text.Substring(0, maxChars).TrimEnd() + "…";
    }
}

<div class="crm-container">
    <h2 class="crm-title mb-4">Preguntas y Respuestas</h2>

    @* Hidden antiforgery token for AJAX calls *@
    <form id="__antiForgeryForm" class="crm-form-row">@Html.AntiForgeryToken()</form>
    <div class="crm-card mb-3 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="mb-2 fs-4">Consulta y ayuda entre usuarios</div>
                <div class="text-muted mb-2">Aquí ves tus preguntas y también las preguntas a las que has respondido o votado. Publica la tuya o responde a otras.</div>
            </div>
            <button class="crm-btn crm-btn-primary w-100" id="btnAbrirModalPregunta" type="button" data-bs-toggle="modal" data-bs-target="#preguntaModal">
                <i class="bi bi-plus-circle me-1"></i>   Preguntar
            </button>
        </div>
    </div> 
    <div class="crm-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><strong>@Model.Total</strong> preguntas</div>
            <div>
                <a class="crm-btn crm-btn-outline" href="?page=@(Model.Page > 1 ? Model.Page - 1 : 1)">Anterior</a>
                <a class="crm-btn crm-btn-outline" href="?page=@(Model.Page + 1)">Siguiente</a>
            </div>
        </div>

        <div id="qrCards" class="qr-card-panel">
            @foreach (var q in Model.Preguntas)
            {
                <div class="qr-card"
                     data-id="@q.Id"
                     data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                     data-user-vote="@q.UsuarioVoto"
                     data-score="@q.Score"
                     data-owner-id="@q.UsuarioId">

                    @* view button aligned to top-right corner of card *@
                    <a class="crm-icon-btn view-btn" title="Ver detalle" href="/Preguntas/Detalles/@q.Id">
                        <i class="bi bi-eye"></i>
                    </a>

                    <div class="qr-title-row">
                        <div class="qr-title" title="@q.Titulo">
                            <a href="/Preguntas/Detalles/@q.Id" class="qr-title-link" title="@q.Titulo">@SafePreview(q.TituloPreview ?? q.Titulo, 100)</a>

                            @* delete button must appear at the end of the title *@
                            @if (q.EsMia)
                            {
                                <button class="btn-delete-inline btn-delete-pregunta" title="Eliminar pregunta" type="button" data-id="@q.Id" data-title="@q.Titulo">🗑</button>
                            }
                        </div>
                    </div>

                    <div class="qr-body" title="@q.CuerpoPreview">@SafePreview(q.CuerpoPreview ?? q.CuerpoPreview, 420)</div>

                    <div class="avatars-row" aria-hidden="true">
                        <img class="avatar-author lazy-avatar"
                             src="@Url.Content("~/img/avatar-placeholder.png")"
                             data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                             alt="@q.AutorNombre"
                             width="40" height="40" decoding="async"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />

                        <div class="author-info">
                            <small class="text-muted">@q.AutorNombre</small>
                            <div class="text-muted small">Publicado · @q.FechaCreacion.ToLocalTime().ToString("d")</div>
                        </div>
                    </div>

                    <div class="qr-meta">
                        

                        <div class="qr-meta-right">@* reserved for future *@</div>
                    </div>

                    @* vote + score group placed bottom-right; RenderVoteControl outputs .vote-container that JS expects *@
                    <div class="qr-score-wrap" aria-hidden="true">
                        @* <div class="vote-legend text-muted small">@((q.UsuarioVoto == 0) ? "No votado" : (q.UsuarioVoto == 1 ? "Has votado" : "Votaste -1"))</div> *@
                        @* RenderVoteControl returns the button markup (.vote-container with .btn-voto-single) *@
                        @Html.Raw(RenderVoteControl(q.Id, q.UsuarioVoto, q.Score, q.UsuarioId))
                        <div class="qr-score" id="score-@q.Id">Score: @q.Score</div>
                    </div>

                    @* Participants avatars + responses badge placed bottom-left inside the card *@
                    <div class="responses-bottom-left" aria-hidden="true">
                        <div class="participants-group">
                            @{
                                var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                                if (!string.IsNullOrWhiteSpace(q.AutorAvatarUrl)) added.Add(q.AutorAvatarUrl);
                                var rc = 0;
                                foreach (var a in q.RespondersAvatars ?? Enumerable.Empty<string>())
                                {
                                    if (rc >= 5) break;
                                    if (string.IsNullOrWhiteSpace(a)) continue;
                                    if (added.Contains(a)) continue;
                                    added.Add(a);
                                    <img class="participant-avatar lazy-avatar" src="@Url.Content("~/img/avatar-placeholder.png")" data-src="@ResolveAvatar(a)" alt="P" width="28" height="28" decoding="async" />
                                    rc++;
                                }
                                if (rc == 0)
                                {
                                    // render nothing (no participants)
                                }
                            }
                        </div>

                        <div class="responses-badge">
                            <span class="small text-muted d-block">Respuestas</span>
                            <span class="badge responses-count">@q.RespuestasCount</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Preguntas.Any())
        {
            <div class="text-muted p-4">No hay preguntas relacionadas contigo aún.</div>
        }
    </div>
</div>

<!-- Modal: Nueva pregunta -->
<div class="modal fade" id="preguntaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="preguntaForm" method="post" action="?handler=CrearPregunta">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Publicar nueva pregunta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="alertPregunta" style="display:none" class="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input name="titulo" id="preguntaTitulo" class="form-control" maxlength="180" required />
                        <div class="form-text text-muted">Máx. 180 caracteres</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cuerpo</label>
                        <textarea name="cuerpo" id="preguntaCuerpo" class="form-control" rows="6" maxlength="2000" required></textarea>
                        <div class="form-text text-muted">Máx. 2000 caracteres</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSavePregunta" type="submit" class="crm-btn crm-btn-success">Publicar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (shared for question/answer deletion) -->
<div class="modal fade modal-confirm" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div class="d-flex gap-3 align-items-start">
                    <div style="font-size:1.6rem;color:#dc2741;">🗑</div>
                    <div style="flex:1 1 auto;">
                        <h5 class="mb-2">Confirmar eliminación</h5>
                        <p id="confirmDeleteMessage" class="mb-0 text-muted">¿Estás seguro que deseas eliminar este elemento? Esta acción no se puede deshacer.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="crm-btn crm-btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmDeleteBtn" class="crm-btn btn-confirm">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" />
    <style>
        /* Base container */
        .crm-container {
            max-width: 1320px;
            margin: 22px auto;
            padding: 0 12px;
            font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            box-sizing: border-box;
        }

        .crm-card {
            background: #fff;
            border-radius: 18px;
            padding: 1.6rem;
            margin-bottom: 18px;
            box-shadow: 0 8px 30px rgba(50,65,120,0.06);
            box-sizing: border-box;
        }

        /* Button base */
        .crm-btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .45rem .9rem;
            border-radius: .65rem;
            border: 0;
            cursor: pointer;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Specific button in card header: make it pill-like and keep on single line */
        .card-action-wrap {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-left: 12px;
        }

        .crm-btn-primary {
            background: linear-gradient(90deg,#2ea6ff,#6a4bd8);
            color: #fff;
            padding: .55rem .95rem;
            border-radius: 12px;
            font-size: .95rem;
            box-shadow: 0 6px 18px rgba(46,166,255,0.15);
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .crm-btn-outline {
            background: transparent;
            border: 1px solid rgba(78,115,170,0.08);
            padding: .35rem .7rem;
            border-radius: .6rem;
            color: #2b4a78;
        }

        .crm-btn-success {
            background: linear-gradient(90deg,#5dd3b3,#2fb17a);
            color: #fff;
        }

        .crm-btn-cancel {
            background: #fff;
            border: 1px solid #dee2e6;
            color: #333;
        }

        /* Grid: use minmax(0,1fr) to prevent overflow */
        .qr-card-panel {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 18px;
            margin-top: 12px;
            align-items: start;
            box-sizing: border-box;
        }

        @@media (max-width:1100px) {
            .qr-card-panel {
                grid-template-columns: repeat(2, minmax(0,1fr));
            }
        }

        @@media (max-width:680px) {
            .qr-card-panel {
                grid-template-columns: 1fr;
            }

            .qr-actions {
                align-self: stretch;
                justify-content: flex-end;
            }
        }

        /* Card look (bluish/purple) */
        .qr-card {
            background: linear-gradient(180deg,#f7f9ff,#f3f6ff);
            border-radius: 14px;
            padding: 18px;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 6px 18px rgba(25,45,85,0.04);
            border: 1px solid rgba(70,90,150,0.04);
            position: relative; /* for absolute badge */
            box-sizing: border-box;
            padding-bottom: 84px; /* reserve space for absolute score/vote area */
            min-width: 0; /* allow children to shrink inside grid */
            overflow: hidden;
        }

        /* view button top-right */
        .view-btn {
            position: absolute;
            right: 12px;
            top: 12px;
            z-index: 5;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #fff;
            border: 1px solid rgba(110,150,220,0.2);
            color: #335a8a;
            text-decoration: none;
        }

        /* Title: single-line ellipsis, delete at end */
        .qr-title {
            font-size: 1.03rem;
            font-weight: 600;
            color: #123a57;
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            width: 100%;
        }

        .qr-title-link {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: calc(100% - 56px); /* leave space for delete button */
            color: inherit;
            text-decoration: none;
        }

        .btn-delete-inline {
            background: #fff;
            border-radius: 8px;
            padding: .25rem;
            border: 1px solid rgba(220,39,65,0.06);
            color: #d23b4a;
            margin-left: auto;
            flex: 0 0 auto;
        }

        .crm-icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #fff;
            border: 1px solid rgba(110,150,220,0.2);
            color: #335a8a;
            text-decoration: none;
            flex: 0 0 auto;
        }

        /* Body: multi-line clamp (max 4 lines) so cards remain consistent */
        .qr-body {
            color: #2b3b4a;
            font-size: .95rem;
            line-height: 1.35;
            margin-top: 8px;
            flex: 1 1 auto;
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
        }

        /* Avatar + author info */
        .avatars-row {
            margin-top: 12px;
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: flex-start;
        }

        .avatar-author {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
            flex: 0 0 auto;
        }

        .author-info {
            margin-left: 8px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }

        /* participants avatars group (small overlapping circles) */
        .participants-group {
            display: flex;
            align-items: center;
        }

        .participant-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
            margin-left: -8px;
        }

        .responses-badge .responses-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 28px;
            padding: 0 .6rem;
            border-radius: 14px;
            background: linear-gradient(90deg,#eef5ff,#f2f9ff);
            color: #2b5a93;
            font-weight: 600;
            border: 1px solid rgba(110,150,220,0.08);
        }

        /* bottom-left participants + responses wrapper */
        .responses-bottom-left {
            position: absolute;
            left: 16px;
            bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 6;
        }

        /* meta */
        .qr-meta {
            font-size: .86rem;
            color: #6b7483;
            margin-top: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* actions (vote area) */
        .qr-actions {
            margin-top: 12px;
            display: flex;
            gap: 8px;
            align-items: center;
        }

        /* vote buttons look (these are rendered inside .vote-container by RenderVoteControl) */
        .crm-vote-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 36px;
            border-radius: 8px;
            border: 1px solid rgba(0,0,0,0.06);
            background: #fff;
            color: #2b5a93;
            cursor: pointer;
            font-size: 1.05rem;
            padding: 0 10px;
        }

        .btn-like {
            width: 42px;
            background: linear-gradient(90deg,#2ea6ff,#6a4bd8);
            color: #fff;
            border: 0;
        }
        /* dislike in grey tone (icon only) */
        .btn-dislike {
            width: 42px;
            background: #f5f6f8;
            color: #6b6b6b;
            border: 1px solid rgba(0,0,0,0.04);
        }

        /* vote + score wrap placed bottom-right */
        .qr-score-wrap {
            position: absolute;
            right: 16px;
            bottom: 12px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            z-index: 6;
        }

        .vote-legend {
            font-size: .78rem;
            color: #6b7483;
            padding-right: 6px;
        }

        /* score badge */
        .qr-score {
            background: #fff;
            padding: 6px 10px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
            color: #1f4666;
            font-weight: 600;
            min-width: 92px;
            text-align: center;
        }

        /* small badges used inside cards to mimic treatment style */
        .crm-badge {
            padding: .35rem .6rem;
            border-radius: .6rem;
            background: linear-gradient(90deg,#eef5ff,#f2f9ff);
            color: #2b5a93;
            margin-right: .5rem;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        /* delete modal confirm */
        .modal-confirm .btn-confirm {
            background: linear-gradient(90deg,#6a4bd8,#2ea6ff);
            color: #fff;
            border: 0;
        }

        /* ensure truncated anchors don't overflow their container */
        .qr-card .qr-title a {
            max-width: calc(100% - 56px);
            display: inline-block;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            function getAntiForgeryToken() {
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : null;
            }

            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const onLoad = img => img.classList.add('loaded');
                const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { onError(img); return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = function () { try { img.src = src; } catch {} onLoad(img); };
                    tmp.onerror = function () { onError(img); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                observer.unobserve(img);
                                loadImg(img);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => {
                        if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) io.observe(i);
                        else if (i.getAttribute('data-src')) i.classList.add('loaded');
                    });
                } else imgs.forEach(i => loadImg(i));
            }

            // delete logic unchanged
            let pendingDelete = null;

            function initDeleteHandlers() {
                const modalEl = document.getElementById('confirmDeleteModal');
                const modal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
                const messageEl = document.getElementById('confirmDeleteMessage');
                const confirmBtn = document.getElementById('confirmDeleteBtn');

                document.addEventListener('click', function (e) {
                    if (e.defaultPrevented) return;

                    const btnQ = e.target.closest('.btn-delete-pregunta');
                    const btnA = e.target.closest('.btn-delete-respuesta');
                    if (!btnQ && !btnA) return;
                    e.preventDefault();
                    e.stopPropagation();

                    if (btnQ) {
                        const id = btnQ.getAttribute('data-id');
                        const title = btnQ.getAttribute('data-title') || '';
                        pendingDelete = { type: 'pregunta', id: id, element: btnQ.closest('.qr-card') };
                        messageEl.textContent = title ? `¿Deseas eliminar "${title}"? Esta acción no se puede deshacer.` : '¿Deseas eliminar esta pregunta? Esta acción no se puede deshacer.';
                        if (modal) modal.show();
                    } else {
                        const id = btnA.getAttribute('data-id');
                        pendingDelete = { type: 'respuesta', id: id, element: btnA.closest('.ans-card') };
                        messageEl.textContent = '¿Deseas eliminar esta respuesta? Esta acción no se puede deshacer.';
                        if (modal) modal.show();
                    }
                });

                if (confirmBtn) {
                    confirmBtn.addEventListener('click', async function () {
                        if (!pendingDelete) { if (modal) modal.hide(); return; }
                        confirmBtn.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const urlBase = pendingDelete.type === 'pregunta' ? '/api/preguntas/' : '/api/respuestas/';
                            const res = await fetch(urlBase + pendingDelete.id + '/eliminar', { method: 'POST', headers: headers });
                            if (!res.ok) { const txt = await res.text(); alert('Error eliminando: ' + (txt || res.status)); return; }
                            const j = await res.json();
                            if (j.ok) { if (pendingDelete.element) pendingDelete.element.remove(); } else { alert('No se pudo eliminar: ' + (j.error || 'error')); }
                        } catch (err) { console.error(err); alert('Error de red al eliminar'); }
                        finally { confirmBtn.disabled = false; pendingDelete = null; if (modal) modal.hide(); }
                    });
                }
            }

            // voting handlers -- selectors unchanged, behavior unchanged
            function initVotingHandlers() {
                document.addEventListener('click', async function (e) {
                    if (e.defaultPrevented) return;

                    const btnQ = e.target.closest('.btn-voto-single');
                    if (btnQ) {
                        e.preventDefault();
                        e.stopPropagation();
                        const id = btnQ.getAttribute('data-id');
                        const valor = parseInt(btnQ.getAttribute('data-valor') || "0", 10);
                        if (!id || (valor !== 1 && valor !== -1)) { try { btnQ.disabled = false; } catch {} return; }
                        btnQ.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const res = await fetch('/api/preguntas/' + id + '/votar', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({ valor: valor })
                            });
                            if (!res.ok) { const txt = await res.text(); console.warn('Votar pregunta falló:', res.status, txt); return; }
                            const j = await res.json();
                            const card = document.querySelector('.qr-card[data-id="' + id + '"]');
                            if (!card) return;
                            const scoreEl = document.getElementById('score-' + id);
                            if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;
                            const container = card.querySelector('.vote-container');
                            const authenticated = card.getAttribute('data-authenticated') === 'true';
                            const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                            const score = (j.score !== undefined) ? j.score : parseInt(card.getAttribute('data-score') || "0", 10);
                            if (!container) return;
                            if (!authenticated) {
                                container.innerHTML = '<div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Identity/Account/Login">Iniciar sesión</a></div>';
                            } else {
                                if (userVote === 1) {
                                    container.innerHTML = '<div class="vote-container"><button class="crm-vote-btn btn-dislike btn-voto-single" data-id="' + id + '" data-valor="-1" type="button" title="Quitar voto"><i class="bi bi-hand-thumbs-down"></i></button></div>';
                                } else {
                                    if (score <= 0) {
                                        container.innerHTML = '<div class="vote-container"><button class="crm-vote-btn btn-like btn-voto-single" data-id="' + id + '" data-valor="1" type="button" title="Me gusta"><i class="bi bi-hand-thumbs-up"></i></button></div>';
                                    } else {
                                        container.innerHTML = '<div class="vote-container"><button class="crm-vote-btn btn-dislike btn-voto-single" data-id="' + id + '" data-valor="-1" type="button" title="Quitar voto"><i class="bi bi-hand-thumbs-down"></i></button></div>';
                                    }
                                }
                            }
                            card.setAttribute('data-score', String(j.score ?? score));
                            card.setAttribute('data-user-vote', String(userVote));
                        } catch (err) { console.error('Error votando pregunta', err); }
                        finally { try { btnQ.disabled = false; } catch {} }
                        return;
                    }

                    // Answer vote handler left unchanged for compatibility
                    const btnA = e.target.closest('.btn-voto-ans');
                    if (btnA) {
                        e.preventDefault();
                        e.stopPropagation();
                        const id = btnA.getAttribute('data-id');
                        const valor = parseInt(btnA.getAttribute('data-valor') || "0", 10);
                        if (!id || (valor !== 1 && valor !== -1)) { try { btnA.disabled = false; } catch {} return; }
                        btnA.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const res = await fetch('/api/respuestas/' + id + '/votar', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({ valor: valor })
                            });
                            if (!res.ok) { const txt = await res.text(); console.warn('Votar respuesta falló:', res.status, txt); return; }
                            const j = await res.json();
                            const card = document.querySelector('.ans-card[data-id="' + id + '"]');
                            if (!card) return;
                            const scoreEl = document.getElementById('ascore-' + id);
                            if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;
                            const container = card.querySelector('.vote-container');
                            const authenticated = card.getAttribute('data-authenticated') === 'true';
                            const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                            const score = (j.score !== undefined) ? j.score : parseInt(card.getAttribute('data-score') || "0", 10);
                            if (!container) return;
                            if (!authenticated) {
                                container.innerHTML = '<div class="vote-login-hint">Inicia sesión para ver/realizar votos. <a href="/Identity/Account/Login">Iniciar sesión</a></div>';
                            } else {
                                if (userVote === 1) {
                                    container.innerHTML = '<button class="crm-vote-btn btn-dislike btn-voto-ans" data-id="' + id + '" data-valor="-1" type="button" title="Quitar voto"><i class="bi bi-hand-thumbs-down"></i></button>';
                                } else {
                                    if (score <= 0) {
                                        container.innerHTML = '<button class="crm-vote-btn btn-like btn-voto-ans" data-id="' + id + '" data-valor="1" type="button" title="Me gusta"><i class="bi bi-hand-thumbs-up"></i></button>';
                                    } else {
                                        container.innerHTML = '<button class="crm-vote-btn btn-dislike btn-voto-ans" data-id="' + id + '" data-valor="-1" type="button" title="Quitar voto"><i class="bi bi-hand-thumbs-down"></i></button>';
                                    }
                                }
                            }
                            card.setAttribute('data-score', String(j.score ?? score));
                            card.setAttribute('data-user-vote', String(userVote));
                        } catch (err) { console.error('Error votando respuesta', err); }
                        finally { try { btnA.disabled = false; } catch {} }
                        return;
                    }
                });
            }

            function initModalAndForm() {
                const preguntaModalEl = document.getElementById('preguntaModal');
                const preguntaModal = preguntaModalEl ? bootstrap.Modal.getOrCreateInstance(preguntaModalEl) : null;
                const btnNew = document.getElementById('btnAbrirModalPregunta');

                if (btnNew) {
                    btnNew.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        try { if (preguntaModal) preguntaModal.show(); } catch (ex) { /* ignore */ }
                        setTimeout(() => {
                            const t = document.getElementById('preguntaTitulo');
                            if (t) t.focus();
                        }, 120);
                    });
                }

                const preguntaForm = document.getElementById('preguntaForm');
                if (preguntaForm) {
                    preguntaForm.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const form = e.target;
                        const data = new FormData(form);
                        const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                        const headers = tokenEl ? { 'RequestVerificationToken': tokenEl.value, 'X-Requested-With': 'XMLHttpRequest' } : { 'X-Requested-With': 'XMLHttpRequest' };
                        const btn = document.getElementById('btnSavePregunta');
                        if (btn) btn.disabled = true;
                        try {
                            const url = new URL(form.action, window.location.href).toString();
                            const resp = await fetch(url, { method: 'POST', headers: headers, body: data });
                            if (!resp.ok) {
                                showAlert('alertPregunta', 'Error al publicar pregunta: ' + resp.status, true);
                                return;
                            }
                            const j = await resp.json();
                            if (j.ok) {
                                showAlert('alertPregunta', 'Pregunta publicada', false);
                                setTimeout(() => { try { if (preguntaModal) preguntaModal.hide(); } catch {} location.reload(); }, 700);
                            } else {
                                showAlert('alertPregunta', 'Error al publicar: ' + (j.error || 'error'), true);
                            }
                        } catch (ex) {
                            console.error(ex);
                            showAlert('alertPregunta', 'Error de red.', true);
                        } finally {
                            if (btn) btn.disabled = false;
                        }
                    });
                }
            }

            function showAlert(id, msg, isError) {
                const el = document.getElementById(id);
                if (!el) return;
                el.textContent = msg;
                el.className = isError ? 'alert alert-danger' : 'alert alert-success';
                el.style.display = 'block';
            }

            // initialize everything
            function initPage() {
                initLazyAvatars();
                initDeleteHandlers();
                initVotingHandlers();
                initModalAndForm();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPage);
            } else {
                initPage();
            }
        })();
    </script>
}