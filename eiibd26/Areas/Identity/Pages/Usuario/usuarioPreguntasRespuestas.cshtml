@page
@model eiibd26.Areas.Identity.Pages.Usuario.PreguntasRespuestasModel
@{
    ViewData["Title"] = "Preguntas y Respuestas";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }

    // Render single vote control server-side following rules:
    // - if not authenticated -> hint
    // - if author -> "No puedes votar tu propia pregunta"
    // - else:
    //     if userVote == 1 -> show -1 (to remove)
    //     else if score <= 0 -> show +1 (prevent negative)
    //     else show -1 (allow downvote when score > 0)
    string RenderVoteControl(Guid id, int userVote, int score, Guid questionOwnerId)
    {
        if (!User.Identity.IsAuthenticated)
            return "<div class=\"vote-login-hint\">Inicia sesión para realizar un voto. <a href=\"/Account/Login\">Iniciar sesión</a></div>";

        var currentIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentIdClaim) && Guid.TryParse(currentIdClaim, out var currentGuid) && currentGuid == questionOwnerId)
        {
            return "<div class=\"text-muted small\">No puedes votar tu propia pregunta</div>";
        }

        if (userVote == 1)
        {
            return $"<div class=\"vote-container\"><button class=\"btn btn-outline-danger btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\">-1</button></div>";
        }

        // userVote != 1
        if (score <= 0)
        {
            return $"<div class=\"vote-container\"><button class=\"btn btn-outline-success btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"1\">+1</button></div>";
        }
        else
        {
            // score > 0 and user hasn't voted -> show -1 to allow reducing
            return $"<div class=\"vote-container\"><button class=\"btn btn-outline-danger btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\">-1</button></div>";
        }
    }
}
<style>
    .crm-container {
        max-width: 1320px;
        margin: 22px auto;
        padding: 0 12px;
    }

    .crm-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(50,65,120,0.06);
        padding: 1.6rem;
        margin-bottom: 18px;
    }

    .qr-card-panel {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 12px;
    }

    .qr-card {
        background: #f8fbff;
        border-radius: 14px;
        padding: 14px;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        overflow: visible;
    }

    .qr-title-row {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: space-between;
    }

    .qr-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: #1f4460;
        margin-bottom: 6px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-body {
        font-size: .95rem;
        color: #2b3b4a;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        margin-top: 6px;
    }
    /* add padding to meta row and separate it from avatars */
    .qr-meta {
        font-size: .86rem;
        color: #6b7483;
        margin-top: 12px;
        padding-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .avatars-row {
        margin-top: 10px;
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: flex-start;
    }

    .avatar-author {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        flex: 0 0 auto;
    }

    .avatar-res {
        width: 27px;
        height: 27px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        flex: 0 0 auto;
    }

    /* space between author info and responders */
    .author-info {
        margin-left: 6px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .qr-actions {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .qr-score {
        background: #fff;
        padding: 6px 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        font-size: .9rem;
    }

    .voto-btn {
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .voto-activo {
        box-shadow: inset 0 0 0 2px rgba(0,0,0,.06);
    }

    .vote-login-hint {
        font-size: .9rem;
        color: #495057;
    }

    @@media (max-width:1100px) {
        .qr-card-panel

    {
        grid-template-columns: repeat(2,1fr);
    }

    }

    @@media (max-width:680px) {
        .qr-card-panel

    {
        grid-template-columns: 1fr;
    }

    .qr-actions {
        right: 8px;
        bottom: 8px;
    }

    }
</style>

<div class="crm-container">
    <h2 class="crm-title">Preguntas y Respuestas</h2>

    <div class="crm-card d-flex justify-content-between align-items-center">
        <div>
            <div class="fs-5">Consulta y ayuda entre usuarios</div>
            <div class="text-muted">Aquí ves tus preguntas y también las preguntas a las que has respondido o votado. Publica la tuya o responde a otras.</div>
        </div>
        <div class="d-flex gap-2">
            <!-- bootstrap native modal trigger + JS keeps focus behavior -->
            <button class="btn btn-success" id="btnAbrirModalPregunta" type="button" data-bs-toggle="modal" data-bs-target="#preguntaModal">Nueva pregunta</button>
        </div>
    </div>

    <div class="crm-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><strong>@Model.Total</strong> preguntas</div>
            <div>
                <a class="btn btn-sm btn-outline-secondary" href="?page=@(Model.Page > 1 ? Model.Page - 1 : 1)">Anterior</a>
                <a class="btn btn-sm btn-outline-secondary" href="?page=@(Model.Page + 1)">Siguiente</a>
            </div>
        </div>

        <div id="qrCards" class="qr-card-panel">
            @foreach (var q in Model.Preguntas)
            {
                var currentIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var isMine = false;
                if (!string.IsNullOrEmpty(currentIdClaim) && Guid.TryParse(currentIdClaim, out var cg) && cg == q.UsuarioId) { isMine = true; }

                <div class="qr-card" data-id="@q.Id" data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")" data-user-vote="@q.UsuarioVoto" data-score="@q.Score">
                    <div class="qr-title-row">
                        <div class="qr-title">
                            <a href="/Preguntas/Detalles/@q.Id" style="color:inherit;text-decoration:none;display:block" title="@q.Titulo">@q.TituloPreview</a>
                        </div>
                        <a class="btn btn-sm btn-outline-secondary qr-eye" title="Ver detalle" href="/Preguntas/Detalles/@q.Id">
                            <span style="font-size:0.95rem;">👁</span>
                        </a>
                    </div>

                    <div class="qr-body">@Html.Raw(q.CuerpoPreview)</div>

                    <div class="avatars-row" aria-hidden="true">
                        <img class="avatar-author lazy-avatar"
                             src="@Url.Content("~/img/avatar-placeholder.png")"
                             data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                             alt="@q.AutorNombre"
                             width="36" height="36"
                             decoding="async"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />

                        <div class="author-info">
                            <small class="text-muted">@q.AutorNombre</small>
                            @* date without time *@
                            <div class="text-muted small">Publicado · @q.FechaCreacion.ToLocalTime().ToString("d")</div>
                        </div>

                        @{
                            var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                            if (!string.IsNullOrWhiteSpace(q.AutorAvatarUrl)) added.Add(q.AutorAvatarUrl);
                            var rc = 0;
                            foreach (var a in q.RespondersAvatars ?? Enumerable.Empty<string>())
                            {
                                if (rc >= 5) break;
                                if (string.IsNullOrWhiteSpace(a)) continue;
                                if (added.Contains(a)) continue;
                                added.Add(a);
                                <img class="avatar-res lazy-avatar"
                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(a)"
                                     alt="Responder"
                                     width="27" height="27"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                rc++;
                            }
                        }
                    </div>

                    <div class="qr-meta">
                        <div class="qr-meta-left">
                            <div style="padding:6px 0">Respuestas: <strong>@q.RespuestasCount</strong></div>
                        </div>

                        <div class="qr-meta-right">@* reserved for future badges *@</div>
                    </div>

                    <div class="qr-actions">
                        @* Vote control (server-rendered initial state) *@
                        @Html.Raw(RenderVoteControl(q.Id, q.UsuarioVoto, q.Score, q.UsuarioId))

                        <div class="qr-score" id="score-@q.Id">Score: @q.Score</div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Preguntas.Any())
        {
            <div class="text-muted p-4">No hay preguntas relacionadas contigo aún.</div>
        }
    </div>
</div>

<!-- Modal: Nueva pregunta -->
<div class="modal fade" id="preguntaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="preguntaForm" method="post" action="?handler=CrearPregunta">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Publicar nueva pregunta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="alertPregunta" style="display:none" class="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input name="titulo" id="preguntaTitulo" class="form-control" maxlength="300" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cuerpo</label>
                        <textarea name="cuerpo" id="preguntaCuerpo" class="form-control" rows="6" required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Relacionar a Condición (opcional)</label>
                            <select name="relacionCondicionId" class="form-select">
                                <option value="">Sin relación</option>
                                @foreach (dynamic e in Model.Condiciones ?? Enumerable.Empty<object>())
                                {
                                    <option value="@e.Id">@e.NombreCanonico @(!string.IsNullOrWhiteSpace((string?)e.Nombre) ? " — " + (string)e.Nombre : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Relacionar a Síntoma (opcional)</label>
                            <select name="relacionSintomaId" class="form-select">
                                <option value="">Sin relación</option>
                                @foreach (dynamic e in Model.Sintomas ?? Enumerable.Empty<object>())
                                {
                                    <option value="@e.Id">@e.NombreCanonico @(!string.IsNullOrWhiteSpace((string?)e.Nombre) ? " — " + (string)e.Nombre : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Relacionar a Tratamiento (opcional)</label>
                            <select name="relacionTratamientoId" class="form-select">
                                <option value="">Sin relación</option>
                                @foreach (dynamic e in Model.Tratamientos ?? Enumerable.Empty<object>())
                                {
                                    <option value="@e.Id">@e.NombreCanonico @(!string.IsNullOrWhiteSpace((string?)e.Nombre) ? " — " + (string)e.Nombre : "")</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSavePregunta" type="submit" class="btn btn-success">Publicar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Nueva respuesta (kept for reply modal usage elsewhere) -->
<div class="modal fade" id="respuestaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="respuestaForm" method="post" action="?handler=CrearRespuesta">
                @Html.AntiForgeryToken()
                <input type="hidden" id="respuestaPreguntaId" name="preguntaId" />
                <div class="modal-header">
                    <h5 class="modal-title">Publicar respuesta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="alertRespuesta" style="display:none" class="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">Respuesta</label>
                        <textarea name="cuerpo" id="respuestaCuerpo" class="form-control" rows="5" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSaveRespuesta" type="submit" class="btn btn-primary">Responder</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                function initLazyAvatars() {
                    const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                    if (!imgs.length) return;
                    const onLoad = img => img.classList.add('loaded');
                    const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                    const loadImg = img => {
                        const src = img.getAttribute('data-src');
                        if (!src) { onError(img); return; }
                        const tmp = new Image();
                        tmp.decoding = 'async';
                        tmp.onload = function () { try { img.src = src; } catch {} onLoad(img); };
                        tmp.onerror = function () { onError(img); };
                        tmp.src = src;
                    };
                    if ('IntersectionObserver' in window) {
                        const io = new IntersectionObserver((entries, observer) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    const img = entry.target;
                                    observer.unobserve(img);
                                    loadImg(img);
                                }
                            });
                        }, { rootMargin: '200px 0px' });
                        imgs.forEach(i => {
                            if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) io.observe(i);
                            else if (i.getAttribute('data-src')) i.classList.add('loaded');
                        });
                    } else imgs.forEach(i => loadImg(i));
                }

                const preguntaModalEl = document.getElementById('preguntaModal');
                const preguntaModal = preguntaModalEl ? bootstrap.Modal.getOrCreateInstance(preguntaModalEl) : null;
                const respuestaModalEl = document.getElementById('respuestaModal');
                const respuestaModal = respuestaModalEl ? bootstrap.Modal.getOrCreateInstance(respuestaModalEl) : null;

                const btnNew = document.getElementById('btnAbrirModalPregunta');
                if (btnNew) {
                    btnNew.addEventListener('click', function () {
                        const alertEl = document.getElementById('alertPregunta');
                        if (alertEl) { alertEl.style.display = 'none'; }
                        // focus title after modal shown
                        setTimeout(() => {
                            const t = document.getElementById('preguntaTitulo');
                            if (t) t.focus();
                        }, 250);
                    });
                }

                // Open reply modal for cards (delegation by btn that has data-bs-target too)
                document.addEventListener('click', function (e) {
                    const openBtn = e.target.closest('.btn-abrir-respuesta') || e.target.closest('.btn-abrir-responder');
                    if (!openBtn) return;
                    const qid = openBtn.getAttribute('data-id');
                    const hid = document.getElementById('respuestaPreguntaId');
                    if (hid) hid.value = qid;
                    const alertEl = document.getElementById('alertRespuesta');
                    if (alertEl) alertEl.style.display = 'none';
                    if (respuestaModal) respuestaModal.show();
                    setTimeout(() => {
                        const t = document.getElementById('respuestaCuerpo');
                        if (t) t.focus();
                    }, 120);
                });

                // Delegated vote handler (single-button UI, same rules as server)
                document.addEventListener('click', async function (e) {
                    const btn = e.target.closest('.btn-voto-single');
                    if (!btn) return;
                    e.preventDefault();

                    const id = btn.getAttribute('data-id');
                    const valor = parseInt(btn.getAttribute('data-valor') || "0", 10);
                    if (!id || (valor !== 1 && valor !== -1)) return;

                    btn.disabled = true;
                    try {
                        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                        const headers = tokenEl ? { 'RequestVerificationToken': tokenEl.value, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };

                        const res = await fetch('/api/preguntas/' + id + '/votar', {
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify({ valor: valor })
                        });

                        if (!res.ok) {
                            const txt = await res.text();
                            console.warn('Votar pregunta falló:', res.status, txt);
                            return;
                        }

                        const j = await res.json();
                        const card = document.querySelector('.qr-card[data-id="' + id + '"]');
                        if (!card) return;
                        const scoreEl = document.getElementById('score-' + id);
                        if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;

                        // re-render single control consistent with server-side rules:
                        const containerParent = card.querySelector('.qr-actions');
                        const container = card.querySelector('.vote-container') || (containerParent ? containerParent.querySelector('.vote-container') : null);

                        const authenticated = card.getAttribute('data-authenticated') === 'true';
                        const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                        const score = (j.score !== undefined) ? j.score : parseInt(card.getAttribute('data-score') || "0", 10);
                        const ownerId = card.getAttribute('data-owner-id') || null; // not always set client-side

                        if (!authenticated) {
                            if (container) container.innerHTML = '<div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Account/Login">Iniciar sesión</a></div>';
                        } else {
                            // if server returned that user is author, server Render would have sent text; so we detect via userVote==null? but simpler:
                            // if userVote==1 => show -1
                            // else if score <= 0 => show +1
                            // else show -1
                            if (userVote === 1) {
                                if (container) container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-danger btn-voto-single" type="button" data-id="' + id + '" data-valor="-1">-1</button></div>';
                            } else {
                                if (score <= 0) {
                                    if (container) container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-success btn-voto-single" type="button" data-id="' + id + '" data-valor="1">+1</button></div>';
                                } else {
                                    if (container) container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-danger btn-voto-single" type="button" data-id="' + id + '" data-valor="-1">-1</button></div>';
                                }
                            }
                        }

                        // update attributes
                        card.setAttribute('data-score', String(j.score ?? score));
                        card.setAttribute('data-user-vote', String(userVote));

                    } catch (ex) {
                        console.error('Error votando', ex);
                    } finally {
                        try { btn.disabled = false; } catch {}
                    }
                });

                // AJAX submit new question
                const preguntaForm = document.getElementById('preguntaForm');
                if (preguntaForm) {
                    preguntaForm.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        const form = e.target;
                        const data = new FormData(form);
                        const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                        const headers = tokenEl ? { 'RequestVerificationToken': tokenEl.value, 'X-Requested-With': 'XMLHttpRequest' } : { 'X-Requested-With': 'XMLHttpRequest' };
                        const btn = document.getElementById('btnSavePregunta');
                        if (btn) btn.disabled = true;
                        try {
                            const resp = await fetch(form.action, { method: 'POST', headers: headers, body: data });
                            if (!resp.ok) {
                                showAlert('alertPregunta', 'Error al publicar pregunta: ' + resp.status, true);
                                return;
                            }
                            const j = await resp.json();
                            if (j.ok) {
                                showAlert('alertPregunta', 'Pregunta publicada', false);
                                setTimeout(() => { if (preguntaModal) preguntaModal.hide(); location.reload(); }, 700);
                            } else {
                                showAlert('alertPregunta', 'Error al publicar', true);
                            }
                        } catch (ex) {
                            showAlert('alertPregunta', 'Error de red.', true);
                        } finally {
                            if (btn) btn.disabled = false;
                        }
                    });
                }

                // AJAX submit answer
                const respuestaForm = document.getElementById('respuestaForm');
                if (respuestaForm) {
                    respuestaForm.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        const form = e.target;
                        const data = new FormData(form);
                        const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                        const headers = tokenEl ? { 'RequestVerificationToken': tokenEl.value, 'X-Requested-With': 'XMLHttpRequest' } : { 'X-Requested-With': 'XMLHttpRequest' };
                        const btn = document.getElementById('btnSaveRespuesta');
                        if (btn) btn.disabled = true;
                        try {
                            const resp = await fetch(form.action, { method: 'POST', headers: headers, body: data });
                            if (!resp.ok) { showAlert('alertRespuesta', 'Error al publicar respuesta: ' + resp.status, true); return; }
                            const j = await resp.json();
                            if (j.ok) {
                                showAlert('alertRespuesta', 'Respuesta publicada', false);
                                setTimeout(() => { if (respuestaModal) respuestaModal.hide(); location.reload(); }, 700);
                            } else showAlert('alertRespuesta', 'Error al publicar', true);
                        } catch (ex) {
                            showAlert('alertRespuesta', 'Error de red.', true);
                        } finally {
                            if (btn) btn.disabled = false;
                        }
                    });
                }

                function showAlert(id, msg, isError) {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.textContent = msg;
                    el.className = isError ? 'alert alert-danger' : 'alert alert-success';
                    el.style.display = 'block';
                }

                initLazyAvatars();
            });
        })();
    </script>
}