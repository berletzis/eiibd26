@page
@model eiibd26.Areas.Identity.Pages.Usuario.PreguntasRespuestasModel
@{
    ViewData["Title"] = "Tus Preguntas y Participaciones";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        // Normaliza barras invertidas y espacios
        avatar = avatar.Replace("\\", "/").Trim();

        if (avatar.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return avatar;
        // Si la ruta ya es absoluta del sitio (/...), la devolvemos tal cual
        if (avatar.StartsWith("/")) return avatar;
        // Quita prefijos ~/ si los tiene y construye Url.Content
        if (avatar.StartsWith("~/")) avatar = avatar.TrimStart('~', '/');
        return Url.Content("~/" + avatar);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        /* Page-specific structural tweaks — keep colors inherited from existing site styles */
        .crm-card {
            padding: 1rem !important;
            box-sizing: border-box;
        }

        .se-item {
            padding: 0.85rem 0.9rem;
            margin-bottom: 0.6rem;
            border-radius: 10px;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(18,34,60,0.04);
            box-sizing: border-box;
        }

        .se-summary {
            padding-left: 0.6rem;
            min-width: 0;
        }

        .se-title a {
            word-break: break-word;
        }

        /* Actions row: put Edit / Delete into its own line below the metadata.
                   Keep colors neutral by not forcing color values here (inherit from site theme). */
        .se-actions-row {
            margin-top: .5rem;
            display: flex;
            gap: .6rem;
            align-items: center;
            padding-left: 0.6rem; /* align with summary content */
        }

            .se-actions-row .se-action-link {
                font-weight: 600;
                text-decoration: none;
                padding: .25rem .45rem;
                border-radius: 6px;
                background: transparent;
                transition: background .12s;
            }

                .se-actions-row .se-action-link:hover {
                    background: #f3f4f6;
                    color: inherit;
                }

        /* Small-screen adjustments to avoid layout collisions */
        @@media (max-width: 767.98px) {
            .se-stats {
                flex: 0 0 auto;
                margin-right: 0.5rem;
            }

            .se-summary {
                padding-left: 0;
            }

            .se-item {
                padding: .6rem;
            }

            .se-actions-row {
                padding-left: 0;
                justify-content: flex-start;
            }
        }

        /* Pagination: center controls, keep colors as defined by global styles */
        .pag-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: center;
            align-items: center;
            padding: .65rem 0;
        }

        .pag-btn, .pag-num {
            display: inline-block;
            padding: .45rem .65rem;
            border-radius: 6px;
            background: #fff;
            border: 1px solid #e6e9ef;
            color: #2b3440;
            text-decoration: none;
        }

            .pag-btn.disabled, .pag-num.disabled {
                opacity: .45;
                pointer-events: none;
            }

        .pag-ellipsis {
            padding: .45rem .25rem;
            color: #6b7280;
        }

        .pag-info {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-left: 0.5rem;
        }

            .pag-info span {
                color: #6b7280;
                font-size: .95rem;
            }

        .pag-size-inline {
            display: inline-flex;
            gap: .35rem;
            align-items: center;
        }

            .pag-size-inline label {
                font-size: .9rem;
                color: #6b7280;
            }

        @@media (max-width: 767.98px) {
            .pag-bar {
                gap: .5rem;
            }

            .pag-info {
                flex-direction: column;
                align-items: center;
                width: 100%;
                margin-left: 0;
            }

            .pag-size-inline {
                justify-content: center;
            }
        }

        .preguntas-paginacion {
            display: flex;
            justify-content: center;
        }

        /* Keep modals vertically centered and scrollable on small screens */
        .modal-dialog-centered {
            display: flex;
            align-items: center;
            min-height: calc(100% - 1rem);
        }

        .modal-content {
            max-height: calc(100vh - 3.5rem);
            overflow: auto;
        }
        @@media (max-width: 576px) {
            .modal-dialog.modal-lg {
                max-width: 92%;
                margin: 0 auto;
            }
        }
    </style>
}

<form id="__afForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="container py-4">
    <h1 class="se-page-title">Mis Preguntas</h1>
    <div class="qp-wrapper-flex">
        <div class="crm-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <div class="text-muted mb-2">Lista de tus preguntas y aquellas en las que has participado..</div>
                </div>
                <div class="d-inline-flex align-items-center">
                    <a class="se-btn se-btn-primary me-0" style="font-size:28px;"
                       href="~/Identity/Usuario/UusuarioPreguntaDetalle">
                        <i class="bi bi-question"></i>
                    </a>
                    <button id="btnModalPregunta" type="button"
                            class="se-btn se-btn-primary ms-1"
                            data-bs-toggle="modal" data-bs-target="#preguntaModal">
                        <i class="btn-icon alert-light bi bi-lightning"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="preguntas-paginacion" aria-label="Paginación">
        @if (Model.TotalPages > 1)
        {
            int current = Model.PageNumber;
            int total = Model.TotalPages;
            int window = 2;
            var list = new List<int>();

            if (total <= 12)
            {
                list.AddRange(Enumerable.Range(1, total));
            }
            else
            {
                int start = Math.Max(1, current - window);
                int end = Math.Min(total, current + window);

                if (start > 1)
                {
                    list.Add(1);
                    if (start > 2) list.Add(-1);
                }
                list.AddRange(Enumerable.Range(start, end - start + 1));
                if (end < total)
                {
                    if (end < total - 1) list.Add(-1);
                    list.Add(total);
                }
            }

            string baseSearch = Model.Search ?? "";
            Func<int, string> pageUrl = p => Url.Page(
            null,
            null,
            new { search = baseSearch, pageSize = Model.PageSize, pageNumber = p },
            null
            ) ?? "#";

            <div class="pag-bar">
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Primera página"
                   href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Página anterior"
                   href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>

                @foreach (var p in list)
                {
                    if (p == -1)
                    {
                        <span class="pag-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        var active = p == current ? "active" : "";
                        <a class="pag-num @active"
                           aria-label="Página @p"
                           aria-current="@(active == "active" ? "page" : null)"
                           href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                    }
                }

                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Página siguiente"
                   href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Última página"
                   href="@(current == total ? "#" : pageUrl(total))">»</a>

                <div class="pag-info">
                    <span>Total: @Model.TotalItems preguntas</span>
                    <span>Página @Model.PageNumber de @Model.TotalPages</span>
                    <form method="get" class="pag-size-inline" id="inlineSizeForm">
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <label for="inlinePageSize">Tamaño</label>
                        <select id="inlinePageSize" name="pageSize" onchange="document.getElementById('inlineSizeForm').submit();">
                            @{
                                var sizes2 = new[] { 10, 12, 30, 60, 100 };
                            }
                            @foreach (var s in sizes2)
                            {
                                <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                            }
                        </select>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="qp-wrapper-flex">
        @if (!Model.Preguntas.Any())
        {
            <div class="se-empty">No hay preguntas relacionadas contigo todavía.</div>
        }
        else
        {
            <div class="qp-main" id="userQuestionsList" role="list">
                @foreach (var q in Model.Preguntas)
                {
                    var disableUp = q.UsuarioVoto != 0;
                    var disableDown = q.UsuarioVoto != 1 || q.Score <= 0;

                    <article class="se-item se-user-item"
                             role="listitem"
                             data-id="@q.Id"
                             data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")"
                             data-user-vote="@q.UsuarioVoto"
                             data-score="@q.Score"
                             data-owner="@q.UsuarioId">
                        <div class="se-stats">
                            <div class="se-vote" aria-label="Votación">
                                @if (!User.Identity.IsAuthenticated || q.EsMia)
                                {
                                    <button class="se-vote-btn se-vote-up" type="button" disabled title="@(q.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"> ▲</button>
                                    <div class="se-votes-count" id="score-@q.Id">@q.Score</div>
                                    <button class="se-vote-btn se-vote-down" type="button" disabled title="@(q.EsMia ? "No puedes votar tu propia pregunta" : "Inicia sesión para votar")"> ▼</button>
                                }
                                else
                                {
                                    <button class="se-vote-btn se-vote-up @(q.UsuarioVoto == 1 ? "active" : "")"
                                            data-id="@q.Id"
                                            data-dir="up"
                                            type="button"
                                            title="+1"
                                            aria-label="Votar +1"
                                            @(disableUp ? "disabled" : null)>
                                        ▲
                                    </button>
                                    <div class="se-votes-count" id="score-@q.Id">@q.Score</div>
                                    <button class="se-vote-btn se-vote-down"
                                            data-id="@q.Id"
                                            data-dir="down"
                                            type="button"
                                            title="Quitar voto"
                                            aria-label="Quitar voto"
                                            @(disableDown ? "disabled" : null)>
                                        ▼
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="se-summary">
                            <h2 class="se-title">
                                <h2 class="se-title">
                                    <a href="/Preguntas/@q.Slug" title="@q.Titulo">@q.TituloPreview</a>  <!-- ✅ AHORA -->
                                </h2>
                            </h2>

                            <div class="se-excerpt">@q.CuerpoPreview</div>

                            @if ((q.Condiciones?.Any() ?? false) || (q.Sintomas?.Any() ?? false) || (q.Tratamientos?.Any() ?? false))
                            {
                                <div class="se-relations">
                                    @if (q.Condiciones?.Any() ?? false)
                                    {
                                        <div class="se-rel-group">
                                            <span class="se-rel-label">Condiciones</span>
                                            <div class="se-rel-badges">
                                                @foreach (var c in q.Condiciones.Take(6))
                                                {
                                                    <span class="se-rel-badge">@c</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (q.Sintomas?.Any() ?? false)
                                    {
                                        <div class="se-rel-group">
                                            <span class="se-rel-label">Síntomas</span>
                                            <div class="se-rel-badges">
                                                @foreach (var s in q.Sintomas.Take(6))
                                                {
                                                    <span class="se-rel-badge">@s</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (q.Tratamientos?.Any() ?? false)
                                    {
                                        <div class="se-rel-group">
                                            <span class="se-rel-label">Tratamientos</span>
                                            <div class="se-rel-badges">
                                                @foreach (var t in q.Tratamientos.Take(6))
                                                {
                                                    <span class="se-rel-badge">@t</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="se-meta">
                                <div class="se-user">
                                    <img class="se-avatar lazy-avatar"
                                         src="@Url.Content("~/img/avatar-placeholder.png")"
                                         data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                                         alt="@q.AutorNombre"
                                         width="36"
                                         height="36"
                                         decoding="async"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                    <a class="se-user-name" href="#">@q.AutorNombre</a>
                                </div>
                                <span class="se-time">@q.FechaCreacion.ToLocalTime().ToString("g")</span>
                            </div>

                            @* Actions row: show Edit / Delete in a separate line beneath meta when item belongs to the user *@
                            @if (q.EsMia)
                            {
                                <div class="se-actions-row">
                                    @if (q.RespuestasCount > 0)
                                    {
                                        <a href="#" class="se-action-link se-action-delete-blocked"
                                           data-id="@q.Id"
                                           data-title="@q.Titulo"
                                           data-responses="@q.RespuestasCount"
                                           title="No se puede eliminar: ya tiene respuestas">
                                            Eliminar
                                        </a>
                                        <a class="se-action-link se-action-edit"
                                           href="~/Identity/Usuario/UusuarioPreguntaDetalle?id=@q.Id"
                                           title="Editar pregunta">Editar</a>
                                    }
                                    else
                                    {
                                        <a href="#" class="se-action-link se-action-delete"
                                           data-id="@q.Id"
                                           data-title="@q.Titulo"
                                           title="Eliminar pregunta">
                                            Eliminar
                                        </a>
                                        <a class="se-action-link se-action-edit"
                                           href="~/Identity/Usuario/UusuarioPreguntaDetalle?id=@q.Id"
                                           title="Editar pregunta">Editar</a>
                                    }
                                </div>
                            }

                            <div class="se-answers-float @(q.RespuestasCount > 0 ? "answered" : "unanswered")">
                                <span class="se-answers-float-count">@q.RespuestasCount</span>
                                <span class="se-answers-float-label">Respuesta(s)</span>
                                @if (q.RespondersAvatars?.Any() == true)
                                {
                                    <div class="se-answers-responders">
                                        @{
                                            var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                                            if (!string.IsNullOrWhiteSpace(q.AutorAvatarUrl)) added.Add(q.AutorAvatarUrl);
                                            var limit = 0;
                                            foreach (var av in q.RespondersAvatars)
                                            {
                                                if (limit >= 6) break;
                                                if (string.IsNullOrWhiteSpace(av)) continue;
                                                if (added.Contains(av)) continue;
                                                added.Add(av);
                                                <img class="se-responder-avatar lazy-avatar"
                                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                                     data-src="@ResolveAvatar(av)"
                                                     alt="Responder"
                                                     width="20"
                                                     height="20"
                                                     decoding="async"
                                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                                limit++;
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="preguntas-paginacion" aria-label="Paginación">
        @if (Model.TotalPages > 1)
        {
            int current = Model.PageNumber;
            int total = Model.TotalPages;
            int window = 2;
            var list = new List<int>();

            if (total <= 12)
            {
                list.AddRange(Enumerable.Range(1, total));
            }
            else
            {
                int start = Math.Max(1, current - window);
                int end = Math.Min(total, current + window);

                if (start > 1)
                {
                    list.Add(1);
                    if (start > 2) list.Add(-1);
                }
                list.AddRange(Enumerable.Range(start, end - start + 1));
                if (end < total)
                {
                    if (end < total - 1) list.Add(-1);
                    list.Add(total);
                }
            }

            string baseSearch = Model.Search ?? "";
            Func<int, string> pageUrl = p => Url.Page(
            null,
            null,
            new { search = baseSearch, pageSize = Model.PageSize, pageNumber = p },
            null
            ) ?? "#";

            <div class="pag-bar">
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Primera página"
                   href="@(current == 1 ? "#" : pageUrl(1))">«</a>
                <a class="pag-btn @(current == 1 ? "disabled" : "")"
                   aria-label="Página anterior"
                   href="@(current == 1 ? "#" : pageUrl(current - 1))">‹</a>

                @foreach (var p in list)
                {
                    if (p == -1)
                    {
                        <span class="pag-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        var active = p == current ? "active" : "";
                        <a class="pag-num @active"
                           aria-label="Página @p"
                           aria-current="@(active == "active" ? "page" : null)"
                           href="@(active == "active" ? "#" : pageUrl(p))">@p</a>
                    }
                }

                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Página siguiente"
                   href="@(current == total ? "#" : pageUrl(current + 1))">›</a>
                <a class="pag-btn @(current == total ? "disabled" : "")"
                   aria-label="Última página"
                   href="@(current == total ? "#" : pageUrl(total))">»</a>

                <div class="pag-info">
                    <span>Total: @Model.TotalItems preguntas</span>
                    <span>Página @Model.PageNumber de @Model.TotalPages</span>
                    <form method="get" class="pag-size-inline" id="inlineSizeFormBottom">
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <label for="inlinePageSize">Tamaño</label>
                        <select id="inlinePageSize" name="pageSize" onchange="document.getElementById('inlineSizeFormBottom').submit();">
                            @{
                                var sizes2 = new[] { 10, 12, 30, 60, 100 };
                            }
                            @foreach (var s in sizes2)
                            {
                                <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                            }
                        </select>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal nueva pregunta rápida -->
<div class="modal fade" id="preguntaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="preguntaForm" method="post" asp-page-handler="CrearPregunta">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Publicar nueva pregunta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="alertPregunta" style="display:none" class="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input name="titulo" id="preguntaTitulo" class="form-control" maxlength="180" required />
                        <div class="form-text text-muted">Máx. 180 caracteres</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cuerpo</label>
                        <textarea name="cuerpo" id="preguntaCuerpo" class="form-control" rows="6" maxlength="2000" required></textarea>
                        <div class="form-text text-muted">Máx. 2000 caracteres</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSavePregunta" type="submit" class="se-btn se-btn-primary" style="font-size:28px;"><i class="bi bi-check"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal confirmar eliminación (sin botón "Cancelar"; cierre con la X en la esquina superior derecha) -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <p id="confirmDeleteMessage" class="mb-0 text-muted">¿Deseas eliminar este elemento? Esta acción es irreversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" id="confirmDeleteBtn" class="se-btn se-btn-primary"><i class="bi bi-trash3"></i></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            if (typeof bootstrap === 'undefined') {
                var s = document.createElement('script');
                s.src = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js';
                s.crossOrigin = 'anonymous';
                s.onload = function(){ console.debug('Bootstrap fallback loaded'); };
                document.head.appendChild(s);
            }
        })();
    </script>

    <script>
        (function () {
            let pendingDelete = null;

            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { img.src='@Url.Content("~/img/avatar-placeholder.png")'; return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = () => { img.src = src; img.classList.add('loaded'); };
                    tmp.onerror = () => { img.src='@Url.Content("~/img/avatar-placeholder.png")'; img.classList.add('loaded'); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver(entries => {
                        entries.forEach(e => {
                            if (e.isIntersecting) { io.unobserve(e.target); loadImg(e.target); }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => io.observe(i));
                } else {
                    imgs.forEach(loadImg);
                }
            }

            document.addEventListener('click', async e => {
                const voteBtn = e.target.closest('.se-vote-btn');
                if (voteBtn) {
                    const item = voteBtn.closest('.se-item');
                    if (!item) return;

                    const isAuth = item.getAttribute('data-authenticated') === 'true';
                    const ownerId = item.getAttribute('data-owner');
                    const currentUserId = '@@User.FindFirstValue(ClaimTypes.NameIdentifier)';
                    const userVote = parseInt(item.getAttribute('data-user-vote') || '0', 10);
                    const score = parseInt(item.getAttribute('data-score') || '0', 10);
                    const dir = voteBtn.getAttribute('data-dir');
                    const id = item.getAttribute('data-id');

                    if (!isAuth) return;
                    if (ownerId && currentUserId && ownerId === currentUserId) return;
                    if (!id || !dir) return;

                    if (dir === 'up' && userVote !== 0) return;
                    if (dir === 'down' && (userVote !== 1 || score <= 0)) return;

                    const upBtn = item.querySelector('.se-vote-up');
                    const downBtn = item.querySelector('.se-vote-down');
                    if (upBtn) upBtn.disabled = true;
                    if (downBtn) downBtn.disabled = true;

                    const valor = dir === 'up' ? 1 : -1;

                    try {
                        const res = await fetch('/api/preguntas/' + id + '/votar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ valor })
                        });
                        if (!res.ok) {
                            alert('Error al votar: ' + res.status);
                            return;
                        }
                        const j = await res.json();
                        let newScore = j.score !== undefined ? parseInt(j.score, 10) : (dir === 'up' ? score + 1 : Math.max(0, score - 1));
                        let backendVote = (j.userVote !== undefined) ? parseInt(j.userVote, 10) : (dir === 'up' ? 1 : 0);
                        if (backendVote < 0) backendVote = 0;

                        item.setAttribute('data-score', String(newScore));
                        item.setAttribute('data-user-vote', String(backendVote));

                        const scoreEl = document.getElementById('score-' + id);
                        if (scoreEl) scoreEl.textContent = newScore;

                        if (backendVote === 1) {
                            upBtn?.classList.add('active');
                            if (upBtn) upBtn.disabled = true;
                            if (downBtn) downBtn.disabled = newScore <= 0;
                        } else {
                            upBtn?.classList.remove('active');
                            if (upBtn) upBtn.disabled = false;
                            if (downBtn) downBtn.disabled = true;
                        }
                    } catch (err) {
                        console.error('Error votando', err);
                        alert('Error de red al votar');
                    } finally {
                        const newUserVote = parseInt(item.getAttribute('data-user-vote') || '0', 10);
                        const newScoreFinal = parseInt(item.getAttribute('data-score') || '0', 10);
                        if (upBtn && newUserVote === 0) upBtn.disabled = false;
                        if (downBtn) downBtn.disabled = !(newUserVote === 1 && newScoreFinal > 0);
                    }
                    return;
                }

                const delBtn = e.target.closest('.se-action-delete, .se-action-delete-blocked');
                if (!delBtn) return;
                e.preventDefault();

                if (delBtn.classList.contains('se-action-delete-blocked')) {
                    const responses = parseInt(delBtn.getAttribute('data-responses') || '0', 10);
                    const msg = responses > 0
                        ? 'Esta pregunta ya tiene respuestas asignadas y no se puede editar ni eliminar.'
                        : 'No es posible eliminar esta pregunta.';
                    alert(msg);
                    return;
                }

                const id = delBtn.getAttribute('data-id');
                const title = delBtn.getAttribute('data-title') || '';
                if (!id) return;
                pendingDelete = { id, element: delBtn.closest('.se-item') };
                const msgEl = document.getElementById('confirmDeleteMessage');
                if (msgEl) msgEl.textContent = (title && title.length > 0)
                    ? `¿Eliminar "${title}"? Esta acción no se puede deshacer.`
                    : "¿Eliminar esta pregunta? Esta acción es irreversible.";
                const modalEl = document.getElementById('confirmDeleteModal');
                const modal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
                modal?.show();
            });

            const preguntaForm = document.getElementById('preguntaForm');
            const alertPregunta = document.getElementById('alertPregunta');
            preguntaForm?.addEventListener('submit', async e => {
                e.preventDefault();
                const fd = new FormData(preguntaForm);
                const btn = document.getElementById('btnSavePregunta');
                if (btn) btn.disabled = true;
                try {
                    const resp = await fetch(preguntaForm.action || '?handler=CrearPregunta', {
                        method: 'POST',
                        body: fd
                    });
                    if (!resp.ok) {
                        const t = await resp.text();
                        showAlert('Error al publicar: ' + t, true);
                        return;
                    }
                    const j = await resp.json();
                    if (j.ok) {
                        showAlert('Pregunta publicada correctamente.', false);
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showAlert('Error: ' + (j.error || 'desconocido'), true);
                    }
                } catch (ex) {
                    console.error(ex);
                    showAlert('Error de red', true);
                } finally {
                    if (btn) btn.disabled = false;
                }
            });

            function showAlert(msg, isErr) {
                if (!alertPregunta) return;
                alertPregunta.textContent = msg;
                alertPregunta.className = 'alert ' + (isErr ? 'alert-danger' : 'alert-success');
                alertPregunta.style.display = 'block';
            }

            document.getElementById('confirmDeleteBtn')?.addEventListener('click', async () => {
                if (!pendingDelete) return;
                const btn = document.getElementById('confirmDeleteBtn');
                if (btn) btn.disabled = true;
                try {
                    const res = await fetch('/api/preguntas/' + pendingDelete.id + '/eliminar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    if (!res.ok) {
                        alert('Error al eliminar: ' + res.status);
                    } else {
                        const j = await res.json();
                        if (j.ok) pendingDelete.element?.remove();
                        else alert('No se pudo eliminar.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de red al eliminar.');
                } finally {
                    if (btn) btn.disabled = false;
                    const modalEl = document.getElementById('confirmDeleteModal');
                    const modal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
                    modal?.hide();
                    pendingDelete = null;
                }
            });

            function init() {
                initLazyAvatars();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
            else init();
        })();
    </script>
}