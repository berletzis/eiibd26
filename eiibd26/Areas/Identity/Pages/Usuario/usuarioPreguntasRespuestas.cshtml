@page
@model eiibd26.Areas.Identity.Pages.Usuario.PreguntasRespuestasModel
@{
    ViewData["Title"] = "Preguntas y Respuestas";
    Layout = "_Layout";

    string ResolveAvatar(string avatar)
    {
        if (string.IsNullOrWhiteSpace(avatar)) return Url.Content("~/img/avatar-placeholder.png");
        if (avatar.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return avatar;
        if (avatar.StartsWith("/")) return avatar;
        return Url.Content("~/" + avatar.TrimStart('/'));
    }

    string RenderVoteControl(Guid id, int userVote, int score, Guid questionOwnerId)
    {
        if (!User.Identity.IsAuthenticated)
            return "<div class=\"vote-login-hint\">Inicia sesión para realizar un voto. <a href=\"/Account/Login\">Iniciar sesión</a></div>";

        var currentIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentIdClaim) && Guid.TryParse(currentIdClaim, out var currentGuid) && currentGuid == questionOwnerId)
        {
            return "<div class=\"text-muted small\">No puedes votar tu propia pregunta</div>";
        }

        if (userVote == 1)
            return $"<div class=\"vote-container\"><button class=\"btn btn-outline-danger btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\">-1</button></div>";

        if (score <= 0)
            return $"<div class=\"vote-container\"><button class=\"btn btn-outline-success btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"1\">+1</button></div>";

        return $"<div class=\"vote-container\"><button class=\"btn btn-outline-danger btn-voto-single\" type=\"button\" data-id=\"{id}\" data-valor=\"-1\">-1</button></div>";
    }
}

<style>
    .crm-container {
        max-width: 1320px;
        margin: 22px auto;
        padding: 0 12px;
    }

    .crm-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(50,65,120,0.06);
        padding: 1.6rem;
        margin-bottom: 18px;
    }

    .qr-card-panel {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 12px;
        align-items: stretch;
    }

    .qr-card {
        background: #f8fbff;
        border-radius: 14px;
        padding: 14px;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .qr-title-row {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: space-between;
    }

    .qr-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: #1f4460;
        margin-bottom: 6px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-delete-inline {
        margin-left: 6px;
        border: none;
        background: transparent;
        color: #dc2741;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-delete-inline:hover {
            background: #fff0f2;
        }

    .qr-body {
        font-size: .95rem;
        color: #2b3b4a;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        margin-top: 6px;
        flex: 1 1 auto;
        line-height: 1.35;
        max-height: calc(1.35em * 5);
        word-break: break-word;
        overflow-wrap: anywhere;
        white-space: normal;
    }

    .qr-meta {
        font-size: .86rem;
        color: #6b7483;
        margin-top: 12px;
        padding-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .avatars-row {
        margin-top: 10px;
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: flex-start;
    }

    .avatar-author {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        flex: 0 0 auto;
    }

    .avatar-res {
        width: 27px;
        height: 27px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        flex: 0 0 auto;
    }

    .author-info {
        margin-left: 6px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .qr-actions {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        align-items: center;
        align-self: flex-end;
    }

    .qr-score {
        background: #fff;
        padding: 6px 8px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        font-size: .9rem;
    }

    .vote-login-hint {
        font-size: .9rem;
        color: #495057;
    }
    @@media (max-width:1100px) {
        .qr-card-panel

    {
        grid-template-columns: repeat(2,1fr);
    }

    }
    @@media (max-width:680px) {
        .qr-card-panel

    {
        grid-template-columns: 1fr;
    }

    .qr-actions {
        align-self: stretch;
        justify-content: flex-end;
    }

    }
    /* modal styles for confirmation */
    .modal-confirm .modal-content {
        border-radius: 12px;
    }

    .modal-confirm .btn-confirm {
        background: linear-gradient(90deg,#2ea6ff,#1db0d9);
        color: #fff;
        border: 0;
    }

    .modal-confirm .btn-cancel {
        background: #fff;
        border: 1px solid #dee2e6;
        color: #333;
    }
</style>

<div class="crm-container">
    <h2 class="crm-title">Preguntas y Respuestas</h2>

    @* Hidden antiforgery token for AJAX calls *@
    <form id="__antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

    <div class="crm-card d-flex justify-content-between align-items-center">
        <div>
            <div class="fs-5">Consulta y ayuda entre usuarios</div>
            <div class="text-muted">Aquí ves tus preguntas y también las preguntas a las que has respondido o votado. Publica la tuya o responde a otras.</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success" id="btnAbrirModalPregunta" type="button" data-bs-toggle="modal" data-bs-target="#preguntaModal">Nueva pregunta</button>
        </div>
    </div>

    <div class="crm-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><strong>@Model.Total</strong> preguntas</div>
            <div>
                <a class="btn btn-sm btn-outline-secondary" href="?page=@(Model.Page > 1 ? Model.Page - 1 : 1)">Anterior</a>
                <a class="btn btn-sm btn-outline-secondary" href="?page=@(Model.Page + 1)">Siguiente</a>
            </div>
        </div>

        <div id="qrCards" class="qr-card-panel">
            @foreach (var q in Model.Preguntas)
            {
                <div class="qr-card" data-id="@q.Id" data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")" data-user-vote="@q.UsuarioVoto" data-score="@q.Score" data-owner-id="@q.UsuarioId">
                    <div class="qr-title-row">
                        <div class="qr-title">
                            <a href="/Preguntas/Detalles/@q.Id" style="color:inherit;text-decoration:none;display:block" title="@q.Titulo">@q.TituloPreview</a>

                            @* delete button inline after title - visible only to owner *@
                            @if (q.EsMia)
                            {
                                <button class="btn-delete-inline btn-delete-pregunta" title="Eliminar pregunta" type="button" data-id="@q.Id" data-title="@q.Titulo">🗑</button>
                            }
                        </div>

                        <a class="btn btn-sm btn-outline-secondary qr-eye" title="Ver detalle" href="/Preguntas/Detalles/@q.Id">
                            <span style="font-size:0.95rem;">👁</span>
                        </a>
                    </div>

                    <div class="qr-body">@q.CuerpoPreview</div>

                    <div class="avatars-row" aria-hidden="true">
                        <img class="avatar-author lazy-avatar"
                             src="@Url.Content("~/img/avatar-placeholder.png")"
                             data-src="@ResolveAvatar(q.AutorAvatarUrl)"
                             alt="@q.AutorNombre"
                             width="36" height="36" decoding="async"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />

                        <div class="author-info">
                            <small class="text-muted">@q.AutorNombre</small>
                            <div class="text-muted small">Publicado · @q.FechaCreacion.ToLocalTime().ToString("d")</div>
                        </div>

                        @{
                            var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                            if (!string.IsNullOrWhiteSpace(q.AutorAvatarUrl)) added.Add(q.AutorAvatarUrl);
                            var rc = 0;
                            foreach (var a in q.RespondersAvatars ?? Enumerable.Empty<string>())
                            {
                                if (rc >= 5) break;
                                if (string.IsNullOrWhiteSpace(a)) continue;
                                if (added.Contains(a)) continue;
                                added.Add(a);
                                <img class="avatar-res lazy-avatar"
                                     src="@Url.Content("~/img/avatar-placeholder.png")"
                                     data-src="@ResolveAvatar(a)"
                                     alt="Responder"
                                     width="27" height="27"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/img/avatar-placeholder.png")';" />
                                rc++;
                            }
                        }
                    </div>

                    <div class="qr-meta">
                        <div class="qr-meta-left">
                            <div style="padding:6px 0">Respuestas: <strong>@q.RespuestasCount</strong></div>
                        </div>

                        <div class="qr-meta-right">@* reserved *@</div>
                    </div>

                    <div class="qr-actions">
                        @Html.Raw(RenderVoteControl(q.Id, q.UsuarioVoto, q.Score, q.UsuarioId))
                        <div class="qr-score" id="score-@q.Id">Score: @q.Score</div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Preguntas.Any())
        {
            <div class="text-muted p-4">No hay preguntas relacionadas contigo aún.</div>
        }
    </div>
</div>

<!-- Modal: Nueva pregunta -->
<div class="modal fade" id="preguntaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="preguntaForm" method="post" action="?handler=CrearPregunta">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Publicar nueva pregunta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="alertPregunta" style="display:none" class="alert"></div>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input name="titulo" id="preguntaTitulo" class="form-control" maxlength="300" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cuerpo</label>
                        <textarea name="cuerpo" id="preguntaCuerpo" class="form-control" rows="6" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSavePregunta" type="submit" class="btn btn-success">Publicar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (shared for question/answer deletion) -->
<div class="modal fade modal-confirm" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div class="d-flex gap-3 align-items-start">
                    <div style="font-size:1.6rem;color:#dc2741;">🗑</div>
                    <div style="flex:1 1 auto;">
                        <h5 class="mb-2">Confirmar eliminación</h5>
                        <p id="confirmDeleteMessage" class="mb-0 text-muted">¿Estás seguro que deseas eliminar este elemento? Esta acción no se puede deshacer.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-confirm">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            function getAntiForgeryToken() {
                const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : null;
            }

            function initLazyAvatars() {
                const imgs = Array.from(document.querySelectorAll('img.lazy-avatar[data-src]'));
                if (!imgs.length) return;
                const onLoad = img => img.classList.add('loaded');
                const onError = img => { img.classList.add('loaded'); img.src = '@Url.Content("~/img/avatar-placeholder.png")'; };
                const loadImg = img => {
                    const src = img.getAttribute('data-src');
                    if (!src) { onError(img); return; }
                    const tmp = new Image();
                    tmp.decoding = 'async';
                    tmp.onload = function () { try { img.src = src; } catch {} onLoad(img); };
                    tmp.onerror = function () { onError(img); };
                    tmp.src = src;
                };
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                observer.unobserve(img);
                                loadImg(img);
                            }
                        });
                    }, { rootMargin: '200px 0px' });
                    imgs.forEach(i => {
                        if (i.getAttribute('data-src') && i.src.indexOf('avatar-placeholder.png') >= 0) io.observe(i);
                        else if (i.getAttribute('data-src')) i.classList.add('loaded');
                    });
                } else imgs.forEach(i => loadImg(i));
            }

            // delete logic
            let pendingDelete = null;

            function initDeleteHandlers() {
                const modalEl = document.getElementById('confirmDeleteModal');
                const modal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
                const messageEl = document.getElementById('confirmDeleteMessage');
                const confirmBtn = document.getElementById('confirmDeleteBtn');

                document.addEventListener('click', function (e) {
                    // ensure other handlers can prevent when needed
                    if (e.defaultPrevented) return;

                    const btnQ = e.target.closest('.btn-delete-pregunta');
                    const btnA = e.target.closest('.btn-delete-respuesta');
                    if (!btnQ && !btnA) return;
                    e.preventDefault();
                    e.stopPropagation();

                    if (btnQ) {
                        const id = btnQ.getAttribute('data-id');
                        const title = btnQ.getAttribute('data-title') || '';
                        pendingDelete = { type: 'pregunta', id: id, element: btnQ.closest('.qr-card') };
                        messageEl.textContent = title ? `¿Deseas eliminar "${title}"? Esta acción no se puede deshacer.` : '¿Deseas eliminar esta pregunta? Esta acción no se puede deshacer.';
                        if (modal) modal.show();
                    } else {
                        const id = btnA.getAttribute('data-id');
                        pendingDelete = { type: 'respuesta', id: id, element: btnA.closest('.ans-card') };
                        messageEl.textContent = '¿Deseas eliminar esta respuesta? Esta acción no se puede deshacer.';
                        if (modal) modal.show();
                    }
                });

                if (confirmBtn) {
                    confirmBtn.addEventListener('click', async function () {
                        if (!pendingDelete) { if (modal) modal.hide(); return; }
                        confirmBtn.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const urlBase = pendingDelete.type === 'pregunta' ? '/api/preguntas/' : '/api/respuestas/';
                            const res = await fetch(urlBase + pendingDelete.id + '/eliminar', { method: 'POST', headers: headers });
                            if (!res.ok) { const txt = await res.text(); alert('Error eliminando: ' + (txt || res.status)); return; }
                            const j = await res.json();
                            if (j.ok) { if (pendingDelete.element) pendingDelete.element.remove(); } else { alert('No se pudo eliminar: ' + (j.error || 'error')); }
                        } catch (err) { console.error(err); alert('Error de red al eliminar'); }
                        finally { confirmBtn.disabled = false; pendingDelete = null; if (modal) modal.hide(); }
                    });
                }
            }

            // voting handlers (questions + answers)
            function initVotingHandlers() {
                document.addEventListener('click', async function (e) {
                    if (e.defaultPrevented) return;

                    // Question vote
                    const btnQ = e.target.closest('.btn-voto-single');
                    if (btnQ) {
                        e.preventDefault();
                        e.stopPropagation();
                        const id = btnQ.getAttribute('data-id');
                        const valor = parseInt(btnQ.getAttribute('data-valor') || "0", 10);
                        if (!id || (valor !== 1 && valor !== -1)) { btnQ.disabled = false; return; }
                        btnQ.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const res = await fetch('/api/preguntas/' + id + '/votar', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({ valor: valor })
                            });
                            if (!res.ok) { const txt = await res.text(); console.warn('Votar pregunta falló:', res.status, txt); return; }
                            const j = await res.json();
                            const card = document.querySelector('.qr-card[data-id="' + id + '"]');
                            if (!card) return;
                            const scoreEl = document.getElementById('score-' + id);
                            if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;
                            const container = card.querySelector('.vote-container');
                            const authenticated = card.getAttribute('data-authenticated') === 'true';
                            const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                            const score = (j.score !== undefined) ? j.score : parseInt(card.getAttribute('data-score') || "0", 10);
                            if (!container) return;
                            if (!authenticated) {
                                container.innerHTML = '<div class="vote-login-hint">Inicia sesión para realizar un voto. <a href="/Account/Login">Iniciar sesión</a></div>';
                            } else {
                                if (userVote === 1) {
                                    container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-danger btn-voto-single" type="button" data-id="' + id + '" data-valor="-1">-1</button></div>';
                                } else {
                                    if (score <= 0) {
                                        container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-success btn-voto-single" type="button" data-id="' + id + '" data-valor="1">+1</button></div>';
                                    } else {
                                        container.innerHTML = '<div class="vote-container"><button class="btn btn-outline-danger btn-voto-single" type="button" data-id="' + id + '" data-valor="-1">-1</button></div>';
                                    }
                                }
                            }
                            card.setAttribute('data-score', String(j.score ?? score));
                            card.setAttribute('data-user-vote', String(userVote));
                        } catch (err) { console.error('Error votando pregunta', err); }
                        finally { try { btnQ.disabled = false; } catch {} }
                        return;
                    }

                    // Answer vote
                    const btnA = e.target.closest('.btn-voto-ans');
                    if (btnA) {
                        e.preventDefault();
                        e.stopPropagation();
                        const id = btnA.getAttribute('data-id');
                        const valor = parseInt(btnA.getAttribute('data-valor') || "0", 10);
                        if (!id || (valor !== 1 && valor !== -1)) { btnA.disabled = false; return; }
                        btnA.disabled = true;
                        try {
                            const token = getAntiForgeryToken();
                            const headers = token ? { 'RequestVerificationToken': token, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
                            const res = await fetch('/api/respuestas/' + id + '/votar', {
                                method: 'POST',
                                headers: headers,
                                body: JSON.stringify({ valor: valor })
                            });
                            if (!res.ok) { const txt = await res.text(); console.warn('Votar respuesta falló:', res.status, txt); return; }
                            const j = await res.json();
                            const card = document.querySelector('.ans-card[data-id="' + id + '"]');
                            if (!card) return;
                            const scoreEl = document.getElementById('ascore-' + id);
                            if (j.score !== undefined && scoreEl) scoreEl.textContent = 'Score: ' + j.score;
                            const container = card.querySelector('.vote-container');
                            const authenticated = card.getAttribute('data-authenticated') === 'true';
                            const userVote = (j.userVote !== undefined) ? j.userVote : 0;
                            const score = (j.score !== undefined) ? j.score : parseInt(card.getAttribute('data-score') || "0", 10);
                            if (!container) return;
                            if (!authenticated) {
                                container.innerHTML = '<div class="vote-login-hint">Inicia sesión para ver/realizar votos. <a href="/Account/Login">Iniciar sesión</a></div>';
                            } else {
                                if (userVote === 1) {
                                    container.innerHTML = '<button class="btn btn-outline-danger btn-voto-ans" data-id="' + id + '" data-valor="-1" type="button">-1</button>';
                                } else {
                                    if (score <= 0) {
                                        container.innerHTML = '<button class="btn btn-outline-success btn-voto-ans" data-id="' + id + '" data-valor="1" type="button">+1</button>';
                                    } else {
                                        container.innerHTML = '<button class="btn btn-outline-danger btn-voto-ans" data-id="' + id + '" data-valor="-1" type="button">-1</button>';
                                    }
                                }
                            }
                            card.setAttribute('data-score', String(j.score ?? score));
                            card.setAttribute('data-user-vote', String(userVote));
                        } catch (err) { console.error('Error votando respuesta', err); }
                        finally { try { btnA.disabled = false; } catch {} }
                        return;
                    }
                });
            }

            // modal open + form submit handlers
            function initModalAndForm() {
                const preguntaModalEl = document.getElementById('preguntaModal');
                const preguntaModal = preguntaModalEl ? bootstrap.Modal.getOrCreateInstance(preguntaModalEl) : null;
                const btnNew = document.getElementById('btnAbrirModalPregunta');

                if (btnNew) {
                    btnNew.addEventListener('click', function (e) {
                        // stop propagation so delegated handlers don't intercept
                        e.preventDefault();
                        e.stopPropagation();
                        try { if (preguntaModal) preguntaModal.show(); } catch (ex) { /* ignore */ }
                        setTimeout(() => {
                            const t = document.getElementById('preguntaTitulo');
                            if (t) t.focus();
                        }, 120);
                    });
                }

                const preguntaForm = document.getElementById('preguntaForm');
                if (preguntaForm) {
                    preguntaForm.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const form = e.target;
                        const data = new FormData(form);
                        const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                        const headers = tokenEl ? { 'RequestVerificationToken': tokenEl.value, 'X-Requested-With': 'XMLHttpRequest' } : { 'X-Requested-With': 'XMLHttpRequest' };
                        const btn = document.getElementById('btnSavePregunta');
                        if (btn) btn.disabled = true;
                        try {
                            const url = new URL(form.action, window.location.href).toString();
                            const resp = await fetch(url, { method: 'POST', headers: headers, body: data });
                            if (!resp.ok) {
                                showAlert('alertPregunta', 'Error al publicar pregunta: ' + resp.status, true);
                                return;
                            }
                            const j = await resp.json();
                            if (j.ok) {
                                showAlert('alertPregunta', 'Pregunta publicada', false);
                                setTimeout(() => { try { if (preguntaModal) preguntaModal.hide(); } catch {} location.reload(); }, 700);
                            } else {
                                showAlert('alertPregunta', 'Error al publicar: ' + (j.error || 'error'), true);
                            }
                        } catch (ex) {
                            console.error(ex);
                            showAlert('alertPregunta', 'Error de red.', true);
                        } finally {
                            if (btn) btn.disabled = false;
                        }
                    });
                }
            }

            function showAlert(id, msg, isError) {
                const el = document.getElementById(id);
                if (!el) return;
                el.textContent = msg;
                el.className = isError ? 'alert alert-danger' : 'alert alert-success';
                el.style.display = 'block';
            }

            // initialize everything
            function initPage() {
                initLazyAvatars();
                initDeleteHandlers();
                initVotingHandlers();
                initModalAndForm();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPage);
            } else {
                initPage();
            }
        })();
    </script>
}