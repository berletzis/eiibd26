@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioTratamientosModel
@{
    ViewData["Title"] = "Mis tratamientos";
    Layout = "_Layout";
}
<div class="container py-4">
    <h2 class="crm-title mb-4">Mis tratamientos</h2>
    <div class="qp-wrapper-flex">
    <div class="crm-card">
            <label for="tratamientoBuscar" class="crm-label">
                Busca y agregar el Tratamiento que te recetaron para tu Condicion o Sintoma.
            </label>
        <form id="agregarTratamientoForm" autocomplete="off" class="crm-form-row" onsubmit="return false;">
            <div class="crm-search-group crm-col-8">
         
                <div class="crm-search-horizontal">
                    <input id="tratamientoBuscar" type="text" class="crm-input" placeholder="Ej: Amoxicilina, Ibuprofeno..." autocomplete="off" />
                        <button id="btnAgregarTratamiento" class="crm-btn crm-btn-primary" type="button">
                            <i class="bi bi-zoom-in"></i>
                    </button>
                </div>
                <input id="tratamientoIdSeleccionado" type="hidden" />
                <ul id="tratamientoSugerencias" class="crm-list-suggest"></ul>
            </div>
        </form>
    </div>
    </div>

    <div class="condiciones-paginacion" aria-label="Paginación">
        <span>Lista de todos los Tratamientos</span>
    </div>
    <div class="condiciones-cards" aria-label="Condiciones">
    @if (Model.MisTratamientos.Any())
    {
        <div class="crm-card-row">
            @foreach (var trat in Model.MisTratamientos)
            {
                <div class="crm-card-condicion">
                    <div class="crm-card-inner">
                        <div class="crm-card-header">
                            <span class="crm-card-title">

                                @trat.Nombre
                            </span>
                            <div class="d-flex gap-1 align-items-center">
                                <button type="button"
                                        class="btn-star-trat crm-btn"
                                        style="border:none;background:transparent;font-size:1.15rem;padding:0 4px;line-height:1;"
                                        data-id="@trat.Id"
                                        data-principal="@trat.EsPrincipal.ToString().ToLower()"
                                        title="@(trat.EsPrincipal ? "Quitar como tratamiento principal" : "Marcar como tratamiento principal")">
                                    @(trat.EsPrincipal ? "⭐" : "☆")
                                </button>
                                <button type="button" class="crm-btn crm-btn-delete btn-eliminar-trat"
                                        style="border:none;background:#f3f5f8;box-shadow:none;"
                                        data-id="@trat.Id"
                                        data-nombre="@trat.Nombre"
                                        data-sintomas="@trat.SintomasCount"
                                        data-condiciones="@trat.CondicionesCount"
                                        title="Eliminar tratamiento">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </div>
                        <div class="crm-card-fecha">
                                <span class="crm-card-label">
                                    <i class="bi bi-calendar2-date"></i>
                                    Fecha inicio del Tratamiento
                                </span>
                            <form method="post" class="form-editar-fecha" data-id="@trat.Id" asp-page-handler="EditarFechaInicio">
                                <div class="crm-input-group" style="column-gap:3px;">
                                   
                                    <input type="date"
                                           class="crm-input-date fecha-inicio"
                                           style="width:150px; min-width:140px; max-width:170px;"
                                           name="nuevaFechaInicio"
                                           value="@trat.FechaInicio.ToString("yyyy-MM-dd")"
                                           disabled />
                                    <button type="button"
                                            class="crm-btn crm-btn-secondary btn-editar-fecha"
                                            style="border:none;"
                                            title="Editar fecha de inicio">
                                       Editar
                                    </button>
                                    <button type="submit"
                                            class="crm-btn crm-btn-success d-none btn-guardar-fecha"
                                            style="border:none;"
                                            title="Guardar nueva fecha">
                                  Guardar
                                    </button>
                                    <button type="button"
                                            class="crm-btn crm-btn-cancel d-none btn-cancelar-fecha"
                                            style="border:none;"
                                            title="Cancelar edición de fecha">
                                    Cancelar
                                    </button>
                                    <input type="hidden" name="tratId" value="@trat.Id" />
                                </div>
                            </form>
                        </div>
                        <!-- Síntomas asociados -->
                        <div class="crm-card-section mb-2">
                            <div class="crm-card-subtitle" style="font-size:.98em; color:#315686;">
                                Síntomas
                                <button type="button" class="crm-btn crm-btn-secondary open-modal-sint ms-1" style="padding:0 8px; border:none;" data-tratid="@trat.Id" title="Asociar síntomas">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                            <div class="crm-card-badges mt-2" id="sint-list-@trat.Id">
                                @if (trat.Sintomas.Any())
                                {
                                    @foreach (var sint in trat.Sintomas)
                                    {
                                        <a href="#" class="crm-badge crm-badge-label bg-info mb-1 d-inline-flex align-items-center">
                                            @sint.Nombre
                                            <button type="button" class="crm-btn btn-sm btn-link p-0 ms-1 badge-sint-del" style="color:red; border:none;" data-sintid="@sint.Id" data-tratid="@trat.Id" title="Quitar síntoma">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Ninguno</span>
                                }
                            </div>
                        </div>
                        <!-- Condiciones asociadas -->
                        <div class="crm-card-section mb-2">
                            <div class="crm-card-subtitle" style="font-size:.98em; color:#315686;">
                                Condiciones
                                <button type="button" class="crm-btn crm-btn-secondary open-modal-cond ms-1" style="padding:0 8px; border:none;" data-tratid="@trat.Id" title="Asociar condiciones">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                            <div class="crm-card-badges mt-2" id="cond-list-@trat.Id">
                                @if (trat.Condiciones.Any())
                                {
                                    @foreach (var cond in trat.Condiciones)
                                    {
                                        <a href="#" class="crm-badge crm-badge-label bg-success text-white mb-1 d-inline-flex align-items-center">
                                            @cond.Nombre
                                            <button type="button" class="crm-btn btn-sm btn-link p-0 ms-1 badge-cond-del" style="color:red; border:none;" data-condid="@cond.Id" data-tratid="@trat.Id" title="Quitar condición">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Ninguna</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="crm-card mb-2">
            <div class="fw-light text-muted crm-empty">
                Aún no has agregado ningún tratamiento.
            </div>
        </div>
    }
</div>
</div>
<!-- MODAL SÍNTOMAS -->
<div class="modal fade" id="modalSintomas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formAsociaSint">
                <div class="modal-header">
                    <h5 class="modal-title">Asociar síntomas al tratamiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="sint-list-modal"></div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                </div>
                <input type="hidden" name="tratamientoId" id="modalSintTratId" />
            </form>
        </div>
    </div>
</div>

<!-- MODAL CONDICIONES -->
<div class="modal fade" id="modalCondiciones" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form id="formAsociaCond">
                <div class="modal-header">
                    <h5 class="modal-title">Asociar condiciones al tratamiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="cond-list-modal"></div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                </div>
                <input type="hidden" name="tratamientoId" id="modalCondTratId" />
            </form>
        </div>
    </div>
</div>


@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" />
}

@section Scripts {
    <script>
        // Helper: obtiene el token antiforgery para enviarlo en cada POST fetch
        function getAntiforgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
        function addAntiforgeryToken(formData) {
            const token = getAntiforgeryToken();
            if (token) formData.append('__RequestVerificationToken', token);
            return formData;
        }

        // --- Autocomplete para tratamientos ---
        const urlAutocomplete = "/api/tratamientos/autocomplete";
        // token to ignore stale responses when user types fast
        let _lastTratAutocompleteToken = 0;
        document.getElementById('tratamientoBuscar').addEventListener('input', async function () {
            let query = this.value.trim();
            let sugerenciasUl = document.getElementById('tratamientoSugerencias');
            // clear immediately
            sugerenciasUl.innerHTML = '';
            document.getElementById('tratamientoIdSeleccionado').value = "";
            if (query.length < 2) return;

            const myToken = ++_lastTratAutocompleteToken;
            let resp;
            try {
                resp = await fetch(urlAutocomplete + '?q=' + encodeURIComponent(query));
            } catch (e) {
                return; // network error
            }

            // ignore if newer request started
            if (myToken !== _lastTratAutocompleteToken) return;
            if (!resp.ok) return;
            let datos = await resp.json();

            // Defensive: ignore if input changed
            if (document.getElementById('tratamientoBuscar').value.trim() !== query) return;

            // Dedupe by id before rendering
            const seen = new Set();
            datos.forEach(item => {
                if (seen.has(item.id)) return;
                seen.add(item.id);

                let li = document.createElement('li');
                li.className = 'crm-list-item list-group-item';
                li.innerText = item.nombre;
                li.onclick = function () {
                    document.getElementById('tratamientoBuscar').value = item.nombre;
                    document.getElementById('tratamientoIdSeleccionado').value = item.id;
                    sugerenciasUl.innerHTML = '';
                }
                sugerenciasUl.appendChild(li);
            });
        });

        document.getElementById('tratamientoBuscar').addEventListener('blur', function () {
            setTimeout(() => { document.getElementById('tratamientoSugerencias').innerHTML = ''; }, 220);
        });

        // Agregar tratamiento
        document.getElementById('btnAgregarTratamiento').addEventListener('click', async function () {
            let id = document.getElementById('tratamientoIdSeleccionado').value;
            if (!id) {
                alert("Debes seleccionar un tratamiento del listado");
                return;
            }
            let formData = new FormData();
            formData.append('tratamientoId', id);
            addAntiforgeryToken(formData);
            let resp = await fetch('?handler=AgregarTratamiento', { method: "POST", body: formData });
            if (resp.ok) location.reload();
            else {
                let msg = await resp.json();
                alert(msg.mensaje || "Error");
            }
        });

        // Editar fecha inicio
        document.querySelectorAll('.form-editar-fecha').forEach(form => {
            let btnEdit = form.querySelector('.btn-editar-fecha');
            let btnSave = form.querySelector('.btn-guardar-fecha');
            let btnCancel = form.querySelector('.btn-cancelar-fecha');
            let input = form.querySelector('.fecha-inicio');
            let valorOriginal = input.value;

            btnEdit.addEventListener('click', (e) => {
                e.preventDefault();
                input.disabled = false;
                btnEdit.classList.add('d-none');
                btnSave.classList.remove('d-none');
                btnCancel.classList.remove('d-none');
            });
            btnCancel.addEventListener('click', (e) => {
                e.preventDefault();
                input.value = valorOriginal;
                input.disabled = true;
                btnEdit.classList.remove('d-none');
                btnSave.classList.add('d-none');
                btnCancel.classList.add('d-none');
            });
            form.addEventListener('submit', async function (ev) {
                ev.preventDefault();
                input.disabled = false;
                let formData = new FormData(form);
                addAntiforgeryToken(formData);
                try {
                    let resp = await fetch(form.action, { method: "POST", body: formData });
                    if (resp.ok) {
                        valorOriginal = input.value;
                        input.disabled = true;
                        btnEdit.classList.remove('d-none');
                        btnSave.classList.add('d-none');
                        btnCancel.classList.add('d-none');
                    } else {
                        let data = await resp.json().catch(() => ({}));
                        alert('Error al guardar: ' + (data.mensaje || resp.status));
                    }
                } catch (err) {
                    alert('Error de red al guardar la fecha.');
                }
            });
        });

        // Eliminar tratamiento
        document.querySelectorAll('.btn-eliminar-trat').forEach(btn => {
            btn.addEventListener('click', function () {
                let sintomas = parseInt(this.dataset.sintomas || "0");
                let condiciones = parseInt(this.dataset.condiciones || "0");
                let nombre = this.dataset.nombre || "";
                let tratid = this.dataset.id || "";
                if (sintomas > 0 || condiciones > 0) {
                    alert("No se puede eliminar \"" + nombre + "\" porque tiene síntomas o condiciones asociados. Primero elimínalos.");
                    return;
                }
                if (confirm('¿Estás seguro de eliminar "' + nombre + '"? Esta acción no se puede deshacer.')) {
                    let formData = new FormData();
                    formData.append('tratId', tratid);
                    addAntiforgeryToken(formData);
                    fetch('?handler=EliminarTratamiento', { method: "POST", body: formData })
                        .then(resp => resp.ok ? location.reload() : resp.json().then(d => alert(d.mensaje || "Error eliminando tratamiento")));
                }
            });
        });

        // Datos para modales
        const sintomasUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MisSintomasSimplificados));
        const condicionesUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MisCondicionesSimplificadas));

        // MODAL SÍNTOMAS
        document.querySelectorAll('.open-modal-sint').forEach(btn => {
            btn.addEventListener('click', function () {
                let tratid = this.dataset.tratid;
                let html = "";
                if (sintomasUsuario.length === 0) {
                    html = `<div class="alert alert-info">
                            <i class="bi bi-exclamation-circle"></i>
                            Debes agregar primero algún síntoma en la sección "Síntomas".
                            </div>`;
                } else {
                    let sintlist = document.querySelectorAll("#sint-list-" + tratid + " .crm-badge");
                    let seleccionadas = Array.from(sintlist).map(b => b.innerText);
                    sintomasUsuario.forEach(s => {
                        let checked = seleccionadas.includes(s.Nombre) ? 'checked' : '';
                        html += `<div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" name="sintids" value="${s.Id}" id="chkSint${s.Id}" ${checked}/>
                            <label class="form-check-label" for="chkSint${s.Id}">${s.Nombre}</label>
                        </div>`;
                    });
                }
                document.getElementById('sint-list-modal').innerHTML = html;
                document.getElementById('modalSintTratId').value = tratid;
                let modal = new bootstrap.Modal(document.getElementById('modalSintomas'));
                modal.show();
            });
        });

        // Guardar síntomas
        document.getElementById('formAsociaSint').addEventListener('submit', async function (e) {
            e.preventDefault();
            let tratid = document.getElementById('modalSintTratId').value;
            let sintids = Array.from(document.querySelectorAll('#sint-list-modal input[type=checkbox]:checked')).map(x => x.value);
            let formData = new FormData();
            formData.append('tratamientoId', tratid);
            sintids.forEach(id => formData.append('sintomaUsuarioIds', id));
            addAntiforgeryToken(formData);
            const resp = await fetch('?handler=AsociarSintomas', { method: 'POST', body: formData });
            if (resp.ok) location.reload();
            else alert("Error al guardar.");
        });

        // Quitar síntoma de tratamiento
        document.querySelectorAll('.badge-sint-del').forEach(btn => {
            btn.addEventListener('click', function () {
                if (confirm('¿Quitar la relación?')) {
                    let tratid = this.dataset.tratid;
                    let sintid = this.dataset.sintid;
                    let formData = new FormData();
                    formData.append('tratamientoId', tratid);
                    formData.append('sintomaUsuarioId', sintid);
                    addAntiforgeryToken(formData);
                    fetch('?handler=QuitarRelacionSintoma', { method: 'POST', body: formData })
                        .then(resp => resp.ok ? location.reload() : alert("Error al quitar"));
                }
            });
        });

        // MODAL CONDICIONES
        document.querySelectorAll('.open-modal-cond').forEach(btn => {
            btn.addEventListener('click', function () {
                let tratid = this.dataset.tratid;
                let html = "";
                if (condicionesUsuario.length === 0) {
                    html = `<div class="alert alert-info">
                        <i class="bi bi-exclamation-circle"></i>
                        Debes agregar primero alguna condición en la sección "Condiciones".
                        </div>`;
                } else {
                    let condlist = document.querySelectorAll("#cond-list-" + tratid + " .crm-badge");
                    let seleccionadas = Array.from(condlist).map(b => b.innerText);
                    condicionesUsuario.forEach(c => {
                        let checked = seleccionadas.includes(c.Nombre) ? 'checked' : '';
                        html += `<div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" name="condids" value="${c.Id}" id="chkCond${c.Id}" ${checked}/>
                            <label class="form-check-label" for="chkCond${c.Id}">${c.Nombre}</label>
                        </div>`;
                    });
                }
                document.getElementById('cond-list-modal').innerHTML = html;
                document.getElementById('modalCondTratId').value = tratid;
                let modal = new bootstrap.Modal(document.getElementById('modalCondiciones'));
                modal.show();
            });
        });

        // Guardar condiciones
        document.getElementById('formAsociaCond').addEventListener('submit', async function (e) {
            e.preventDefault();
            let tratid = document.getElementById('modalCondTratId').value;
            let condids = Array.from(document.querySelectorAll('#cond-list-modal input[type=checkbox]:checked')).map(x => x.value);
            let formData = new FormData();
            formData.append('tratamientoId', tratid);
            condids.forEach(id => formData.append('condicionUsuarioIds', id));
            addAntiforgeryToken(formData);
            const resp = await fetch('?handler=AsociarCondiciones', { method: 'POST', body: formData });
            if (resp.ok) location.reload();
            else alert("Error al guardar.");
        });

        // Quitar condición de tratamiento
        document.querySelectorAll('.badge-cond-del').forEach(btn => {
            btn.addEventListener('click', function () {
                if (confirm('¿Quitar la relación?')) {
                    let tratid = this.dataset.tratid;
                    let condid = this.dataset.condid;
                    let formData = new FormData();
                    formData.append('tratamientoId', tratid);
                    formData.append('condicionUsuarioId', condid);
                    addAntiforgeryToken(formData);
                    fetch('?handler=QuitarRelacionCondicion', { method: 'POST', body: formData })
                        .then(resp => resp.ok ? location.reload() : alert("Error al quitar"));
                }
            });
        });

        // Estrella: toggle tratamiento principal
        document.querySelectorAll('.btn-star-trat').forEach(btn => {
            btn.addEventListener('click', async function () {
                const tratId = this.dataset.id;
                const formData = new FormData();
                formData.append('tratId', tratId);
                addAntiforgeryToken(formData);
                const resp = await fetch('?handler=TogglePrincipalTratamiento', { method: 'POST', body: formData });
                if (resp.ok) {
                    const data = await resp.json();
                    document.querySelectorAll('.btn-star-trat').forEach(b => {
                        b.textContent = '☆';
                        b.dataset.principal = 'false';
                        b.title = 'Marcar como tratamiento principal';
                    });
                    if (data.esPrincipal) {
                        this.textContent = '⭐';
                        this.dataset.principal = 'true';
                        this.title = 'Quitar como tratamiento principal';
                    }
                }
            });
        });
    </script>
}