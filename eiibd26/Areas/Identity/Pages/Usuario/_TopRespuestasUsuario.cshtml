@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var answers = Model?.Respuestas?.OrderByDescending(r => r.Votes).ThenByDescending(r => r.Id).ToList()
                  ?? new List<eiibd26.Models.AnswerItem>();

    var containerId = "top-answers-" + Guid.NewGuid().ToString("N");
    var pageSize = 8;
    var totalCount = answers.Count;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<style>
    /* Match compact style used in Top Preguntas */
    .top-answers-card {
        padding: 1rem;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        margin-top: 8px;
        font-weight: 400;
    }

        .top-answers-card .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 1rem;
        }

        .top-answers-card .a-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .top-answers-card .a-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 6px;
            background: #f8fafc;
            transition: background .2s ease;
        }

            .top-answers-card .a-item:hover {
                background: #f1f5f9;
            }

        .top-answers-card .a-body {
            flex: 1;
            font-size: .9rem;
            color: #0f172a;
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            word-break: break-word;
        }

        .top-answers-card .a-badges {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
            align-items: center;
        }

        .top-answers-card .badge-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .top-answers-card .badge-votes {
            background: #dbeafe;
            color: #1e40af;
        }

        .top-answers-card .badge-label {
            font-size: .85rem;
            color: #6b7280;
            padding: 4px 8px;
            border-radius: 6px;
            background: transparent;
        }

        .top-answers-card .pagination-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            padding-top: .75rem;
            border-top: 1px solid #e9ecef;
        }

            .top-answers-card .pagination-controls .page-info {
                font-size: .85rem;
                color: #6b7280;
            }

            .top-answers-card .pagination-controls .btn-pagination {
                padding: 6px 14px;
                font-size: .85rem;
                border-radius: 6px;
                border: 1px solid #e9ecef;
                background: #fff;
                color: #0f172a;
                cursor: pointer;
                transition: all .2s ease;
            }

                .top-answers-card .pagination-controls .btn-pagination:hover:not(:disabled) {
                    background: #f8fafc;
                    border-color: #6a4e7a;
                    color: #6a4e7a;
                }

                .top-answers-card .pagination-controls .btn-pagination:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

        .top-answers-card .no-data {
            text-align: center;
            color: #9ca3af;
            font-size: .9rem;
            padding: 2rem 0;
        }

    @@media (max-width: 768px) {
        .top-answers-card .a-item {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

        .top-answers-card .pagination-controls {
            flex-direction: column;
            gap: 10px;
        }

            .top-answers-card .pagination-controls .page-info {
                order: -1;
            }
    }
</style>

<div id="@containerId" class="top-answers-card">
    <div class="card-title">Top Respuestas</div>

    @if (!answers.Any())
    {
        <div class="no-data">No hay respuestas para mostrar.</div>
    }
    else
    {
        <div class="a-list">
            @for (int i = 0; i < answers.Count; i++)
            {
                var a = answers[i];
                <div class="a-item answer-entry" data-index="@i" style="display:none;">
                    <div class="a-body">@Html.Raw(a.Cuerpo)</div>

                    <div class="a-badges" aria-hidden="false">
                        <span class="badge-pill badge-votes" title="Votos">
                            <i class="bi bi-arrow-up-circle me-1" aria-hidden="true"></i>@a.Votes
                        </span>
                      
                    </div>
                </div>
            }
        </div>

        <div class="pagination-controls" aria-label="Paginación">
            <div class="page-info">Página <span class="current-page">1</span> de <span class="total-pages">@totalPages</span></div>
            <div>
                <button type="button" class="btn-pagination prev-btn" aria-label="Anterior" style="display:none;">Anterior</button>
                <button type="button" class="btn-pagination next-btn" aria-label="Siguiente" style="display:none;">Siguiente</button>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var container = document.getElementById('@containerId');
        if (!container) return;

        var entries = container.querySelectorAll('.answer-entry');
        var pageSize = @pageSize;
        var totalCount = entries.length;
        var totalPages = Math.ceil(totalCount / pageSize) || 1;
        var currentPage = 1;

        var prevBtn = container.querySelector('.prev-btn');
        var nextBtn = container.querySelector('.next-btn');
        var currentPageSpan = container.querySelector('.current-page');
        var totalPagesSpan = container.querySelector('.total-pages');

        if (totalPagesSpan) totalPagesSpan.textContent = totalPages;

        function renderPage(page) {
            currentPage = Math.max(1, Math.min(page, totalPages));
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;

            entries.forEach(function (el, idx) {
                el.style.display = (idx >= start && idx < end) ? '' : 'none';
            });

            if (prevBtn) prevBtn.style.display = (currentPage > 1) ? '' : 'none';
            if (nextBtn) nextBtn.style.display = (currentPage < totalPages) ? '' : 'none';
            if (currentPageSpan) currentPageSpan.textContent = currentPage;
        }

        if (prevBtn) prevBtn.addEventListener('click', function () {
            renderPage(currentPage - 1);
        });
        if (nextBtn) nextBtn.addEventListener('click', function () {
            renderPage(currentPage + 1);
        });

        var paginationControls = container.querySelector('.pagination-controls');
        if (totalPages <= 1) {
            if (paginationControls) paginationControls.style.display = 'none';
        } else {
            if (paginationControls) paginationControls.style.display = 'flex';
        }

        renderPage(1);
    })();
</script>