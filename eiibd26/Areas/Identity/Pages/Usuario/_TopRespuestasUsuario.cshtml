@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var answers = Model?.Respuestas?.OrderByDescending(r => r.Votes).ThenByDescending(r => r.Id).ToList()
                  ?? new List<eiibd26.Models.AnswerItem>();

    var containerId = "top-answers-" + Guid.NewGuid().ToString("N");
    var pageSize = 8;
    var totalCount = answers.Count;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<style>
    .top-answers-card {
        padding: .75rem;
        background: #fff;
        border-radius: 12px;
        margin-top: 8px;
        font-weight: 400;
    }

        .top-answers-card .title {
            font-weight: 400;
            color: #172849;
            margin-bottom: .5rem;
        }

        .top-answers-card .a-item {
            padding: 8px 0;
            border-bottom: 1px solid #f1f3f6;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            justify-content: space-between;
        }

            .top-answers-card .a-item:last-child {
                border-bottom: none;
            }

            .top-answers-card .a-item > .a-main {
                flex: 1;
                min-width: 0;
            }

        .top-answers-card .a-body {
            color: #374151;
            font-size: .95rem;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            line-height: 1.2em;
            height: calc(1.2em * 2);
            word-break: break-word;
            font-weight: 400;
        }

        .top-answers-card .a-meta {
            font-size: .85rem;
            color: #6b7280;
            display: flex;
            gap: 8px;
            align-items: center;
            margin-top: 6px;
            flex-wrap: wrap;
            font-weight: 400;
        }

        .top-answers-card .badge-votes {
            background: #f4edfc;
            color: #764ba2;
            padding: 4px 8px;
            border-radius: 999px;
            font-weight: 400;
            white-space: nowrap;
        }

        .top-answers-card .link-view {
            color: #764ba2;
            text-decoration: none;
            word-break: break-word;
            white-space: nowrap;
            font-weight: 400;
        }

            .top-answers-card .link-view:hover {
                color: #5a2d7a;
                text-decoration: underline;
            }

        .top-answers-card .pagination-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: flex-end;
            margin-top: .5rem;
        }

            .top-answers-card .pagination-controls .page-info {
                font-size: .85rem;
                color: #6b7280;
                margin-right: auto;
                font-weight: 400;
            }

    @@media (max-width: 768px) {
        .top-answers-card .a-item {
            flex-direction: column;
            align-items: stretch;
        }

        .top-answers-card .link-view {
            margin-top: 8px;
            display: inline-block;
            white-space: normal;
        }
    }

    @@media (max-width: 480px) {
        .top-answers-card .a-body {
            -webkit-line-clamp: 3;
            height: calc(1.2em * 3);
            font-size: .95rem;
        }

        .top-answers-card .a-meta {
            font-size: .8rem;
        }

        .top-answers-card .pagination-controls {
            justify-content: center;
        }
    }
</style>

<div id="@containerId" class="top-answers-card">
    <div class="title">Top respuestas</div>

    @if (!answers.Any())
    {
        <div class="text-muted small" style="font-weight:400;">No hay respuestas para mostrar.</div>
    }
    else
    {
        <div class="answers-list">
            @for (int i = 0; i < answers.Count; i++)
            {
                var a = answers[i];
                var aId = (a.Id != Guid.Empty) ? a.Id.ToString() : "";
                <div class="a-item answer-entry" data-index="@i" style="display:none;">
                    <div class="a-main">
                        <div class="a-body">@a.Cuerpo</div>
                        <div class="a-meta">
                            <div class="badge-votes">@a.Votes</div>
                            <div class="text-muted small" style="font-weight:400;">Respuesta</div>
                            <div class="text-muted">·</div>
                            <div class="text-muted small" style="font-weight:400;">Id: @aId</div>
                        </div>
                    </div>
                    <div class="a-actions">
                        <a href="@Url.Page("/Foro/Pregunta", new { id = a.PreguntaId })" class="link-view">Ver pregunta</a>
                    </div>
                </div>
            }
        </div>

        <div class="pagination-controls" aria-label="Paginación">
            <div class="page-info">Página <span class="current-page">1</span> de <span class="total-pages">@totalPages</span></div>
            <button type="button" class="btn btn-sm btn-outline-primary prev-btn" aria-label="Anterior" style="display:none;font-weight:400;">Anterior</button>
            <button type="button" class="btn btn-sm btn-outline-primary next-btn" aria-label="Siguiente" style="display:none;font-weight:400;">Siguiente</button>
        </div>
    }
</div>

<script>
    (function () {
        var container = document.getElementById('@containerId');
        if (!container) return;

        var entries = container.querySelectorAll('.answer-entry');
        var pageSize = @pageSize;
        var totalCount = entries.length;
        var totalPages = Math.ceil(totalCount / pageSize) || 1;
        var currentPage = 1;

        var prevBtn = container.querySelector('.prev-btn');
        var nextBtn = container.querySelector('.next-btn');
        var currentPageSpan = container.querySelector('.current-page');
        var totalPagesSpan = container.querySelector('.total-pages');

        if (totalPagesSpan) totalPagesSpan.textContent = totalPages;

        function renderPage(page) {
            currentPage = Math.max(1, Math.min(page, totalPages));
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;

            entries.forEach(function (el, idx) {
                el.style.display = (idx >= start && idx < end) ? '' : 'none';
            });

            if (prevBtn) prevBtn.style.display = (currentPage > 1) ? '' : 'none';
            if (nextBtn) nextBtn.style.display = (currentPage < totalPages) ? '' : 'none';
            if (currentPageSpan) currentPageSpan.textContent = currentPage;
        }

        if (prevBtn) prevBtn.addEventListener('click', function () {
            renderPage(currentPage - 1);
        });
        if (nextBtn) nextBtn.addEventListener('click', function () {
            renderPage(currentPage + 1);
        });

        var paginationControls = container.querySelector('.pagination-controls');
        if (totalPages <= 1) {
            if (paginationControls) paginationControls.style.display = 'none';
        } else {
            if (paginationControls) paginationControls.style.display = 'flex';
        }

        renderPage(1);
    })();
</script>