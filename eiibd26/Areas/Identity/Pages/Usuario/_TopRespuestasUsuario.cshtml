@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var answers = Model?.Respuestas?.OrderByDescending(r => r.Votes).ThenByDescending(r => r.Id).ToList()
                  ?? new List<eiibd26.Models.AnswerItem>();

    var containerId = "top-answers-" + Guid.NewGuid().ToString("N");
    var pageSize = 8;
    var totalCount = answers.Count;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<style>
    /* Match compact style used in Top Preguntas */
    .top-answers-card {
        padding: 1rem;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        margin-top: 8px;
        font-weight: 400;
    }

        .top-answers-card .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 1rem;
        }

        .top-answers-card .a-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .top-answers-card .a-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 6px;
            background: #f8fafc;
            transition: background .2s ease;
            text-decoration: none;
            color: inherit;
        }

            .top-answers-card .a-item:hover {
                background: #f1f5f9;
                text-decoration: none;
            }

        .top-answers-card .a-body {
            flex: 1;
            font-size: .9rem;
            color: #0f172a;
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            word-break: break-word;
        }

        .top-answers-card .a-badges {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
            align-items: center;
        }

        .top-answers-card .badge-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .top-answers-card .badge-votes {
            background: #dbeafe;
            color: #1e40af;
        }

        .top-answers-card .badge-label {
            font-size: .85rem;
            color: #6b7280;
            padding: 4px 8px;
            border-radius: 6px;
            background: transparent;
        }

        .top-answers-card .pagination-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            padding-top: .75rem;
            border-top: 1px solid #e9ecef;
        }

        .top-answers-card .page-info {
            font-size: .85rem;
            color: #6b7280;
        }

        .top-answers-card .btn-pagination {
            padding: 6px 14px;
            font-size: .85rem;
            border-radius: 6px;
            border: 1px solid #e9ecef;
            background: #fff;
            color: #0f172a;
            cursor: pointer;
            transition: all .2s ease;
        }

        .top-answers-card .no-data {
            text-align: center;
            color: #9ca3af;
            font-size: .9rem;
            padding: 2rem 0;
        }

    @@media (max-width:768px) {
        .top-answers-card .a-item {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

        .top-answers-card .pagination-controls {
            flex-direction: column;
            gap: 10px;
        }

        .top-answers-card .page-info {
            order: -1;
        }
    }
</style>

<div id="@containerId" class="top-answers-card">
    <div class="card-title">Top Respuestas</div>

    @if (!answers.Any())
    {
        <div class="no-data">No hay respuestas para mostrar.</div>
    }
    else
    {
        <div class="a-list">
            @for (int i = 0; i < answers.Count; i++)
            {
                var a = answers[i];

                // 1) Try to read server-provided slug properties (common names)
                string preguntaSlug = null;
                if (a != null)
                {
                    var slugCandidates = new[] { "PreguntaSlug", "QuestionSlug", "Slug" };
                    foreach (var propName in slugCandidates)
                    {
                        var p = a.GetType().GetProperty(propName, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                        if (p != null && p.PropertyType == typeof(string))
                        {
                            preguntaSlug = p.GetValue(a) as string;
                            if (!string.IsNullOrWhiteSpace(preguntaSlug)) break;
                            preguntaSlug = null;
                        }
                    }

                    // If no slug found, check nested Pregunta?.Slug
                    if (string.IsNullOrWhiteSpace(preguntaSlug))
                    {
                        var preguntaProp = a.GetType().GetProperty("Pregunta", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                        if (preguntaProp != null)
                        {
                            var preguntaObj = preguntaProp.GetValue(a);
                            if (preguntaObj != null)
                            {
                                var slugProp = preguntaObj.GetType().GetProperty("Slug", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                                if (slugProp != null && slugProp.PropertyType == typeof(string))
                                {
                                    preguntaSlug = slugProp.GetValue(preguntaObj) as string;
                                }
                            }
                        }
                    }
                }

                // 2) Resolve preguntaId string for fallback (look only for PreguntaId or nested Pregunta.Id)
                string preguntaIdStr = null;
                if (a != null)
                {
                    var pidProp = a.GetType().GetProperty("PreguntaId", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                    if (pidProp != null)
                    {
                        var val = pidProp.GetValue(a);
                        if (val != null) preguntaIdStr = val.ToString();
                    }
                    else
                    {
                        // try nested Pregunta.Id
                        var preguntaProp = a.GetType().GetProperty("Pregunta", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                        if (preguntaProp != null)
                        {
                            var preguntaObj = preguntaProp.GetValue(a);
                            if (preguntaObj != null)
                            {
                                var idProp = preguntaObj.GetType().GetProperty("Id", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
                                if (idProp != null)
                                {
                                    var idVal = idProp.GetValue(preguntaObj);
                                    if (idVal != null) preguntaIdStr = idVal.ToString();
                                }
                            }
                        }
                    }
                }

                // 3) Build href: prefer SEO-friendly slug; otherwise fallback to details?id=GUID
                string href = !string.IsNullOrWhiteSpace(preguntaSlug)
                ? "/Preguntas/" + Uri.EscapeDataString(preguntaSlug)
                : "/Preguntas/Detalles?id=" + Uri.EscapeDataString(preguntaIdStr ?? "");

                // Use preguntaIdStr and preguntaSlug in data-attributes (so client-side resolver can use them if needed)
                <a href="@href"
                   class="a-item answer-entry link-to-question"
                   data-index="@i"
                   data-pregunta-id="@(preguntaIdStr ?? "")"
                   data-has-slug="@(string.IsNullOrWhiteSpace(preguntaSlug) ? "false" : "true")"
                   data-slug="@(preguntaSlug ?? "")"
                   style="display:none;">
                    <div class="a-body">@Html.Raw(a.Cuerpo)</div>

                    <div class="a-badges" aria-hidden="false">
                        <span class="badge-pill badge-votes" title="Votos">
                            <i class="bi bi-arrow-up-circle me-1" aria-hidden="true"></i>@a.Votes
                        </span>
                        <span class="badge-label" title="Tipo">Respuesta</span>
                    </div>
                </a>
            }
        </div>

        <div class="pagination-controls" aria-label="Paginación">
            <div class="page-info">Página <span class="current-page">1</span> de <span class="total-pages">@totalPages</span></div>
            <div>
                <button type="button" class="btn-pagination prev-btn" aria-label="Anterior" style="display:none;">Anterior</button>
                <button type="button" class="btn-pagination next-btn" aria-label="Siguiente" style="display:none;">Siguiente</button>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var container = document.getElementById('@containerId');
        if (!container) return;

        var entries = Array.from(container.querySelectorAll('.answer-entry'));
        var pageSize = @pageSize;
        var totalCount = entries.length;
        var totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
        var currentPage = 1;

        var prevBtn = container.querySelector('.prev-btn');
        var nextBtn = container.querySelector('.next-btn');
        var currentPageSpan = container.querySelector('.current-page');
        var totalPagesSpan = container.querySelector('.total-pages');

        if (totalPagesSpan) totalPagesSpan.textContent = totalPages;

        function renderPage(page) {
            currentPage = Math.max(1, Math.min(page, totalPages));
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;

            entries.forEach(function (el, idx) {
                el.style.display = (idx >= start && idx < end) ? '' : 'none';
            });

            if (prevBtn) prevBtn.style.display = (currentPage > 1) ? '' : 'none';
            if (nextBtn) nextBtn.style.display = (currentPage < totalPages) ? '' : 'none';
            if (currentPageSpan) currentPageSpan.textContent = currentPage;

            // Improve links for visible entries: if they lack slug, try to fetch slugs in batch.
            resolveSlugsForVisible();
        }

        async function resolveSlugsForVisible() {
            var visible = entries.filter(el => el.style.display !== 'none');
            var idsToFetch = visible
                .filter(el => el.getAttribute('data-has-slug') === 'false')
                .map(el => el.getAttribute('data-pregunta-id'))
                .filter((v, i, arr) => v && arr.indexOf(v) === i);

            if (!idsToFetch.length) return;

            try {
                const res = await fetch('/api/preguntas/slugs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: idsToFetch })
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json(); // expect { "<id>": "<slug>", ... }

                visible.forEach(function (el) {
                    var qid = el.getAttribute('data-pregunta-id');
                    if (!qid) return;
                    if (el.getAttribute('data-has-slug') === 'true') return;
                    var slug = data && data[qid];
                    if (slug) {
                        el.setAttribute('href', '/Preguntas/' + encodeURIComponent(slug));
                        el.setAttribute('data-has-slug', 'true');
                        el.setAttribute('data-slug', slug);
                    }
                });
            } catch (err) {
                console.warn('No se pudieron resolver slugs para respuestas:', err);
            }
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', function () {
                renderPage(currentPage - 1);
            });
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', function () {
                renderPage(currentPage + 1);
            });
        }

        // Initial render
        renderPage(1);
    })();
</script>