@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Usuario.UusuarioPreguntaDetalleModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Pregunta Detallada" : "Nueva Pregunta Detallada";
    Layout = "_Layout";
}

@section Styles {

    <link rel="stylesheet" href="~/css/preguntas.css" />
    <style>
        .qp-wrapper-flex {
            display: flex;
            gap: 24px;
            align-items: flex-start;
        }

        /* Main card for the form.
                           On desktop it keeps a max width to avoid overly wide forms,
                           on smaller screens it expands to the available container width. */
        .qp-main {
            flex: 1 1 auto;
            max-width: 1100px;
            width: 100%;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #e8eef6;
            box-sizing: border-box;
        }

        .qp-aside {
            width: 340px;
            flex: 0 0 340px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .rel-box {
            background: #fff;
            border: 1px solid #d9e3ec;
            border-radius: 10px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
        }

            .rel-box h5 {
                font-size: 1rem;
                font-weight: 600;
                margin: 0 0 8px 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }


        .accion-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            border-radius: 3px;
            border: 1px solid var(--se-border);
            background: #fff;
            color: var(--se-text);
            padding: .5rem .7rem;
            font-weight: 100;
            text-decoration: none;
            cursor: pointer;
            font-size: .9rem;
            line-height: 1.1;
        }

            .accion-btn:hover {
                filter: brightness(0.98);
            }


        .accion-btn-primary {
            margin-top: 0px;
            font-size: 1.03rem;
            color: #2b3b4a;
            border-radius: 50%;
            border-width: 2px;
            width: 48px;
            height: 48px;
        }

            .accion-btn-primary:hover {
                background: #F4EDFC;
                border: 2px solid #6a4e7a;
            }

        .rel-search-row {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 6px;
        }

            .rel-search-row input {
                width: 100%;
                padding: 6px 8px;
                border: 1px solid #c9d6e6;
                border-radius: 6px;
                font-size: .85rem;
                box-sizing: border-box;
            }

        .rel-selected-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 72px;
            overflow-y: auto;
            padding: 2px 0;
        }

        .rel-badge-sel {
            background: #eef5ff;
            color: #24527a;
            border: 1px solid #c9d6e6;
            border-radius: 999px;
            padding: 3px 8px;
            font-size: .65rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .rel-badge-sel button {
                background: transparent;
                border: 0;
                cursor: pointer;
                color: #24527a;
                padding: 0;
                font-size: .7rem;
                line-height: 1;
            }

        .rel-scroll {
            flex: 1 1 auto;
            min-height: 240px;
            max-height: 300px;
            overflow: auto;
            border: 1px solid #e1e7ef;
            border-radius: 6px;
            background: #fafbfd;
            padding: 6px;
            box-sizing: border-box;
        }

        .rel-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 4px;
            border-radius: 4px;
            font-size: .78rem;
            line-height: 1.2;
        }

            .rel-item:hover {
                background: #eef5ff;
            }

        .rel-empty {
            font-size: .72rem;
            color: #6a737c;
            padding: 4px;
        }

        .qp-main h3 {
            margin-top: 0;
            font-weight: 600;
        }

        .qp-info-text {
            font-size: .8rem;
            color: #6a737c;
            margin-top: 4px;
        }

        .disabled-mask {
            opacity: .55;
            pointer-events: none;
        }

        /* Permite que elementos específicos dentro de disabled-mask mantengan interactividad */
        .enable-pointer {
            pointer-events: auto !important;
            opacity: 1 !important;
        }

        @@media (max-width:1200px) {
            .qp-wrapper-flex {
                flex-direction: column;
                gap: 16px;
            }

            .qp-aside {
                width: 100%;
                flex: 1 1 auto;
            }
            /* Make the main form card fill the container and remove restrictive max-width */
            .qp-main {
                max-width: 100%;
                width: 100%;
                padding: 16px;
            }
        }

        @@media (max-width: 576px) {
            .qp-main {
                padding: 12px;
            }

            .accion-btn-primary {
                width: 44px;
                height: 44px;
            }

            .rel-scroll {
                max-height: 220px;
            }
        }
    </style>
}

<div class="container py-4">
    <form method="post" asp-page-handler="Save" id="preguntaDetForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="qp-wrapper-flex">
            <div class="qp-main @(Model.CanModify ? "" : "disabled-mask")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="mb-0">@ViewData["Title"]</h3>

                        @* Mostrar slug siempre si existe *@
                        @if (!string.IsNullOrEmpty(Model.CurrentSlug) || !string.IsNullOrEmpty(Model.CreatedQuestionSlug))
                        {
                            var slugToShow = !string.IsNullOrEmpty(Model.CurrentSlug) ? Model.CurrentSlug : Model.CreatedQuestionSlug;
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <small class="text-muted">
                                    <i class="bi bi-link-45deg"></i> 
                                    <strong>Slug:</strong> 
                                    <code style="background: #f8f9fa; padding: 2px 6px; border-radius: 3px;">@slugToShow</code>
                                </small>
                                @* Botón para ir a ver la pregunta si ya tiene respuesta IA *@
                                @if (Model.TieneRespuestaIA)
                                {
                                    <a href="@Url.Page("/Preguntas/Detalles", new { slug = slugToShow })" 
                                       class="btn btn-sm btn-outline-primary enable-pointer" 
                                       style="font-size: 0.75rem; padding: 2px 8px;"
                                       title="Ver pregunta con respuestas"
                                       target="_blank">
                                        <i class="bi bi-box-arrow-up-right"></i> Ver pregunta
                                    </a>
                                }
                            </div>
                        }

                        @* Badge de IA si tiene respuesta *@
                        @if (Model.TieneRespuestaIA && Model.FechaGeneracionIA.HasValue)
                        {
                            <div class="mt-2">
                                <span class="badge" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem;">
                                    <i class="bi bi-robot"></i> Respuesta de IA generada el @Model.FechaGeneracionIA.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        }
                    </div>

                    @* Botón eliminar movido a la esquina superior derecha; mantiene la misma funcionalidad (abre #deleteModal) *@
                    @if (Model.Id.HasValue)
                    {
                        if (Model.CanModify)
                        {
                            <button type="button" class="btn btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Eliminar pregunta">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger border-0" disabled title="No se puede eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" id="pregunta-error">@Model.ErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success" id="pregunta-success">
                        @Model.SuccessMessage

                        @* Mostrar link para ir a la pregunta si se acaba de crear *@
                        @if (!string.IsNullOrEmpty(Model.CreatedQuestionSlug))
                        {
                            <div class="mt-3">
                                <strong>🔗 Link de tu pregunta:</strong>
                                <div class="input-group mt-2">
                                    <input type="text" class="form-control" 
                                           value="@Url.Page("/Preguntas/Detalles", new { slug = Model.CreatedQuestionSlug })" 
                                           readonly 
                                           id="questionLinkInput" />
                                    <button class="btn btn-outline-secondary" 
                                            type="button" 
                                            onclick="copyToClipboard()" 
                                            title="Copiar link">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                <div class="mt-3">
                                    <a href="@Url.Page("/Preguntas/Detalles", new { slug = Model.CreatedQuestionSlug })" 
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-arrow-right-circle"></i> Ir a la pregunta para ver las respuestas
                                    </a>
                                </div>

                                @* Indicador de procesamiento de IA *@
                                @if (!Model.TieneRespuestaIA)
                                {
                                    <div class="mt-3 p-3" style="background: rgba(118, 75, 162, 0.08); border-radius: 8px; border: 1px solid rgba(118, 75, 162, 0.2);" id="aiProcessingIndicator" data-pregunta-id="@Model.Id" data-slug="@Model.CreatedQuestionSlug">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status" style="width: 18px; height: 18px;">
                                                <span class="visually-hidden">Cargando...</span>
                                            </div>
                                            <span style="color: #764ba2; font-weight: 500;">
                                                🤖 Procesando tu pregunta... La IA está generando una respuesta educativa.
                                            </span>
                                        </div>
                                        <small class="text-muted d-block mt-2">
                                            La página se actualizará automáticamente cuando esté lista.
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                @if (Model.Id.HasValue && !Model.CanModify)
                {
                    <div class="alert alert-warning mb-3">Esta pregunta ya tiene respuestas activas. No puede editarse ni eliminarse.</div>
                }

                <div class="mb-3">
                    <label class="form-label">Título</label>
                    @if (Model.CanModify)
                    {
                        <input class="form-control" asp-for="Titulo" maxlength="180" required autocomplete="off" />
                    }
                    else
                    {
                        <input class="form-control" asp-for="Titulo" maxlength="180" required autocomplete="off" disabled />
                    }
                    <div class="qp-info-text">Máx. 180 caracteres</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Cuerpo</label>
                    @if (Model.CanModify)
                    {
                        <textarea class="form-control" asp-for="Cuerpo" rows="8" maxlength="4000" required></textarea>
                    }
                    else
                    {
                        <textarea class="form-control" asp-for="Cuerpo" rows="8" maxlength="4000" required disabled></textarea>
                    }
                    <div class="qp-info-text">Máx. 4000 caracteres</div>
                </div>

                <div class="mt-4 text-end">
                    @if (Model.Id.HasValue)
                    {
                        @if (Model.CanModify)
                        {
                            @* botón Eliminar movido arriba; aquí solo queda guardar *@
                            <button type="submit" class="accion-btn-primary" style="font-size:18px;"><i class="bi bi-floppy"></i></button>
                        }
                        else
                        {
                            <button type="button" class="accion-btn-primary" disabled><i class="bi bi-floppy"></i></button>
                        }
                    }
                    else
                    {
                        <button type="submit" class="accion-btn-primary"><i class="bi bi-floppy"></i></button>
                    }
                </div>
            </div>

            <aside class="qp-aside @(Model.CanModify ? "" : "disabled-mask")">
                <!-- Condiciones -->
                <div class="rel-box" id="boxCondiciones">
                    <h5>Condiciones <span class="badge bg-light text-dark">@Model.CondicionesLista.Count</span></h5>
                    <div class="rel-search-row">
                        @if (Model.CanModify)
                        {
                            <input type="text" id="searchCondiciones" placeholder="Filtrar..." autocomplete="off" />
                        }
                        else
                        {
                            <input type="text" id="searchCondiciones" placeholder="Filtrar..." autocomplete="off" disabled />
                        }
                        <div id="badgesCondiciones" class="rel-selected-badges">
                            @foreach (var c in Model.CondicionesLista.Where(x => Model.SelectedCondiciones.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@c.id">
                                    @c.nombre
                                    @if (Model.CanModify)
                                    {
                                        <button type="button" class="badge-remove" data-target="SelectedCondiciones" data-id="@c.id" aria-label="Quitar">✕</button>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="scrollCondiciones">
                        @if (!Model.CondicionesLista.Any())
                        {
                            <div class="rel-empty">No tienes condiciones registradas.</div>
                        }
                        else
                        {
                            @foreach (var c in Model.CondicionesLista)
                            {
                                var checkedAttr = Model.SelectedCondiciones.Contains(c.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@c.nombre?.ToLowerInvariant()">
                                    @if (Model.CanModify)
                                    {
                                        <input type="checkbox" class="rel-check-condicion" name="SelectedCondiciones" value="@c.id" @checkedAttr />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="rel-check-condicion" name="SelectedCondiciones" value="@c.id" @checkedAttr disabled />
                                    }
                                    <span>@c.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <!-- Síntomas -->
                <div class="rel-box" id="boxSintomas">
                    <h5>Síntomas <span class="badge bg-light text-dark">@Model.SintomasLista.Count</span></h5>
                    <div class="rel-search-row">
                        @if (Model.CanModify)
                        {
                            <input type="text" id="searchSintomas" placeholder="Filtrar..." autocomplete="off" />
                        }
                        else
                        {
                            <input type="text" id="searchSintomas" placeholder="Filtrar..." autocomplete="off" disabled />
                        }
                        <div id="badgesSintomas" class="rel-selected-badges">
                            @foreach (var s in Model.SintomasLista.Where(x => Model.SelectedSintomas.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@s.id">
                                    @s.nombre
                                    @if (Model.CanModify)
                                    {
                                        <button type="button" class="badge-remove" data-target="SelectedSintomas" data-id="@s.id">✕</button>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="scrollSintomas">
                        @if (!Model.SintomasLista.Any())
                        {
                            <div class="rel-empty">No tienes síntomas registrados.</div>
                        }
                        else
                        {
                            @foreach (var s in Model.SintomasLista)
                            {
                                var checkedAttr = Model.SelectedSintomas.Contains(s.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@s.nombre?.ToLowerInvariant()">
                                    @if (Model.CanModify)
                                    {
                                        <input type="checkbox" class="rel-check-sintoma" name="SelectedSintomas" value="@s.id" @checkedAttr />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="rel-check-sintoma" name="SelectedSintomas" value="@s.id" @checkedAttr disabled />
                                    }
                                    <span>@s.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <!-- Tratamientos -->
                <div class="rel-box" id="boxTratamientos">
                    <h5>Tratamientos <span class="badge bg-light text-dark">@Model.TratamientosLista.Count</span></h5>
                    <div class="rel-search-row">
                        @if (Model.CanModify)
                        {
                            <input type="text" id="searchTratamientos" placeholder="Filtrar..." autocomplete="off" />
                        }
                        else
                        {
                            <input type="text" id="searchTratamientos" placeholder="Filtrar..." autocomplete="off" disabled />
                        }
                        <div id="badgesTratamientos" class="rel-selected-badges">
                            @foreach (var t in Model.TratamientosLista.Where(x => Model.SelectedTratamientos.Contains(x.id)))
                            {
                                <span class="rel-badge-sel" data-id="@t.id">
                                    @t.nombre
                                    @if (Model.CanModify)
                                    {
                                        <button type="button" class="badge-remove" data-target="SelectedTratamientos" data-id="@t.id">✕</button>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="rel-scroll" id="scrollTratamientos">
                        @if (!Model.TratamientosLista.Any())
                        {
                            <div class="rel-empty">No tienes tratamientos registrados.</div>
                        }
                        else
                        {
                            @foreach (var t in Model.TratamientosLista)
                            {
                                var checkedAttr = Model.SelectedTratamientos.Contains(t.id) ? "checked" : "";
                                <label class="rel-item" data-filter="@t.nombre?.ToLowerInvariant()">
                                    @if (Model.CanModify)
                                    {
                                        <input type="checkbox" class="rel-check-tratamiento" name="SelectedTratamientos" value="@t.id" @checkedAttr />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="rel-check-tratamiento" name="SelectedTratamientos" value="@t.id" @checkedAttr disabled />
                                    }
                                    <span>@t.nombre</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar Pregunta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (Model.CanModify)
                    {
                        <p class="mb-0">¿Seguro que deseas eliminar la pregunta? Se marcará como eliminada y sus relaciones se eliminarán.</p>
                    }
                    else
                    {
                        <p class="text-danger mb-0">Esta pregunta tiene respuestas activas y no puede eliminarse.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    @if (Model.CanModify)
                    {
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function initFilter(inputId, scrollId){
            const input=document.getElementById(inputId);
            const cont=document.getElementById(scrollId);
            if(!input||!cont) return;
            input.addEventListener('input',()=>{
                const term=input.value.trim().toLowerCase();
                cont.querySelectorAll('.rel-item').forEach(item=>{
                    const txt=item.getAttribute('data-filter')||'';
                    item.style.display = !term || txt.includes(term) ? '' : 'none';
                });
            });
        }
        initFilter('searchCondiciones','scrollCondiciones');
        initFilter('searchSintomas','scrollSintomas');
        initFilter('searchTratamientos','scrollTratamientos');

        function refreshBadges(containerId, selector){
            const container=document.getElementById(containerId);
            if(!container) return;
            const frag=document.createDocumentFragment();
            document.querySelectorAll(selector).forEach(ch=>{
                if(ch.checked){
                    const name=ch.nextElementSibling?.textContent||ch.value;
                    const span=document.createElement('span');
                    span.className='rel-badge-sel';
                    span.dataset.id=ch.value;
                    span.innerHTML=`${name} <button type="button" class="badge-remove" data-target="${selector}" data-id="${ch.value}">✕</button>`;
                    frag.appendChild(span);
                }
            });
            container.innerHTML='';
            container.appendChild(frag);
        }
        function attachEvents(){
            document.addEventListener('change',e=>{
                if(e.target.matches('.rel-check-condicion')){
                    refreshBadges('badgesCondiciones','.rel-check-condicion');
                }else if(e.target.matches('.rel-check-sintoma')){
                    refreshBadges('badgesSintomas','.rel-check-sintoma');
                }else if(e.target.matches('.rel-check-tratamiento')){
                    refreshBadges('badgesTratamientos','.rel-check-tratamiento');
                }
            });
            document.addEventListener('click',e=>{
                const btn=e.target.closest('.badge-remove');
                if(!btn) return;
                const id=btn.getAttribute('data-id');
                const selector=btn.getAttribute('data-target');
                const el=document.querySelector(`${selector}[value="${CSS.escape(id)}"]`);
                if(el){
                    el.checked=false;
                    el.dispatchEvent(new Event('change'));
                }
            });
        }
        attachEvents();
        refreshBadges('badgesCondiciones','.rel-check-condicion');
        refreshBadges('badgesSintomas','.rel-check-sintoma');
        refreshBadges('badgesTratamientos','.rel-check-tratamiento');

        // Auto-hide success message after creation/update (8s para dar tiempo de ver el link)
        document.addEventListener('DOMContentLoaded', function () {
            const suc = document.getElementById('pregunta-success');
            if (suc) {
                setTimeout(() => {
                    suc.style.transition = 'opacity 0.4s ease';
                    suc.style.opacity = '0';
                    setTimeout(() => { if (suc.parentNode) suc.parentNode.removeChild(suc); }, 450);
                }, 8000); // Más tiempo si hay link
            }
        });

        // Function to copy question link to clipboard
        function copyToClipboard() {
            const input = document.getElementById('questionLinkInput');
            if (input) {
                input.select();
                input.setSelectionRange(0, 99999); // For mobile

                try {
                    document.execCommand('copy');
                    alert('✅ Link copiado al portapapeles');
                } catch (err) {
                    // Fallback para navegadores modernos
                    navigator.clipboard.writeText(input.value).then(() => {
                        alert('✅ Link copiado al portapapeles');
                    }).catch(() => {
                        alert('❌ No se pudo copiar el link');
                    });
                }
            }
        }

        // ===== POLLING PARA VERIFICAR SI LA RESPUESTA IA ESTÁ LISTA =====
        document.addEventListener('DOMContentLoaded', function () {
            const aiIndicator = document.getElementById('aiProcessingIndicator');
            if (!aiIndicator) return;

            const preguntaId = aiIndicator.getAttribute('data-pregunta-id');
            const slug = aiIndicator.getAttribute('data-slug');

            if (!preguntaId) return;

            let pollCount = 0;
            const maxPolls = 60; // 5 minutos (cada 5 segundos)

            const pollForAiAnswer = async () => {
                if (pollCount >= maxPolls) {
                    console.log('⏰ [AI Polling] Timeout alcanzado');
                    aiIndicator.innerHTML = '<small class="text-warning">⚠️ La respuesta de IA está tomando más tiempo del esperado. Puedes revisar la pregunta más tarde.</small>';
                    return;
                }

                pollCount++;
                console.log(`🔄 [AI Polling] Intento ${pollCount}/${maxPolls} para pregunta ${preguntaId}`);

                try {
                    const response = await fetch(`/api/preguntas/${preguntaId}/ai-status`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (response.ok) {
                        const data = await response.json();

                        if (data.ok && data.hasAiAnswer) {
                            console.log('✅ [AI Polling] Respuesta de IA detectada, recargando página...');

                            // Mostrar mensaje de éxito antes de recargar
                            aiIndicator.innerHTML = '<div class="text-success"><i class="bi bi-check-circle"></i> ✅ Respuesta de IA lista. Recargando...</div>';

                            // Recargar la página para mostrar el badge actualizado
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                            return;
                        }

                        console.log(`⏳ [AI Polling] Aún no hay respuesta, continuando...`);
                    } else {
                        console.warn(`⚠️ [AI Polling] Error en request: ${response.status}`);
                    }
                } catch (err) {
                    console.error('❌ [AI Polling] Error:', err);
                }

                // Continuar polling
                setTimeout(pollForAiAnswer, 5000);
            };

            // Iniciar polling después de 5 segundos
            console.log('🚀 [AI Polling] Iniciando polling para detectar respuesta de IA...');
            setTimeout(pollForAiAnswer, 5000);
        });
    </script>

}