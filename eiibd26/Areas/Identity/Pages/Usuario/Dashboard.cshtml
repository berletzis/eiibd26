@page
@model eiibd26.Areas.Identity.Pages.Usuario.DashboardModel
@{
    ViewData["Title"] = "Mi Dashboard";
    Layout = "_Layout";
}

/* Grid simple 2 columnas responsive */
<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }
    @@media(min - width:900px) {
        .dashboard-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<h1>Mi Dashboard</h1>

<div class="dashboard-grid">
    <div>
        @* Columna 1: partial con la gráfica estilo solicitado. Pasa el VM cargado en el PageModel *@
        @await Html.PartialAsync("_DashboardColumn1", Model.VM)
    </div>

    <div>
        @* Columna 2: placeholder para Mis Síntomas / Mis Preguntas / Mis Respuestas (implementa tus cards aquí) *@
        <div class="card p-3">
            <h3>Mis Síntomas</h3>
            <p class="text-muted">Top 3 y botón para agregar (implementa aquí los componentes que prefieras).</p>

            <h3 class="mt-4">Mis Preguntas</h3>
            <p class="text-muted">Últimas 3 preguntas.</p>

            <h3 class="mt-4">Mis Respuestas</h3>
            <p class="text-muted">Últimas 3 respuestas.</p>
        </div>
    </div>
</div>