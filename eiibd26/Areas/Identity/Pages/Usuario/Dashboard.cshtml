@page
@model eiibd26.Areas.Identity.Pages.Usuario.DashboardModel

@{
    ViewData["Title"] = "Mi Dashboard";
    Layout = "_Layout";
}

@section Head {
    <link rel="stylesheet" href="~/css/dashboard-paciente.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estado-animo.css" asp-append-version="true" />
}

<main>
    <div class="container py-4">
        <h1 class="eii-page-title">Mi Panel de Control</h1>

        @await Html.PartialAsync("_PushNotificationCard")

        @await Html.PartialAsync("_DashboardNotifications", Model.VM)

        <div class="dash-grid">
            <div>
                @await Html.PartialAsync("_DashboardColumn1", Model.VM)
            </div>

            <div>
                <div class="eii-card eii-card--elevated">
                    @await Html.PartialAsync("_SintomasTop5Seguimiento", Model.VM)
                </div>
            </div>

            <div>
                <div class="eii-card eii-card--elevated">
                    <div class="eii-card__header">
                        <div>
                            <div class="eii-card__title">Preguntas y Respuestas</div>
                            <div class="eii-text-sm eii-text-muted">Se muestran registros en orden con Mayor Votación.</div>
                        </div>
                        <div class="d-inline-flex align-items-center gap-1">
                            <a class="eii-btn eii-btn--primary eii-btn--icon eii-btn--circle" href="/Identity/Usuario/UusuarioPreguntaDetalle" title="Ver preguntas">
                                <i class="bi bi-question"></i>
                            </a>
                            <button id="btnModalPregunta" type="button" class="eii-btn eii-btn--primary eii-btn--icon eii-btn--circle"
                                    data-bs-toggle="modal" data-bs-target="#preguntaModal" title="Agregar pregunta rápida">
                                <i class="bi bi-lightning"></i>
                            </button>
                        </div>
                    </div>
                    @await Html.PartialAsync("_TopPreguntasUsuario", Model.VM)
                    @await Html.PartialAsync("_TopRespuestasUsuario", Model.VM)
                </div>
            </div>

            <div>
                <div class="eii-card eii-card--elevated">
                    <div class="sintomas-top5">
                        <div class="eii-card__header">
                            <div>
                                <div class="eii-card__title">Resultados de laboratorio</div>
                                <div class="eii-text-sm eii-text-muted">
                                    @if (Model.VM.TotalLaboratorios > 0)
                                    {
                                        <span>@Model.VM.TotalLaboratorios resultado@(Model.VM.TotalLaboratorios == 1 ? "" : "s") registrado@(Model.VM.TotalLaboratorios == 1 ? "" : "s").</span>
                                    }
                                    else
                                    {
                                        <span>Sin resultados registrados aún.</span>
                                    }
                                </div>
                            </div>
                            <a href="/Identity/Usuario/UsuarioLaboratorios" class="eii-btn eii-btn--primary eii-btn--icon eii-btn--circle" title="Ver laboratorios">
                                <i class="bi bi-file-earmark-medical"></i>
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-borderless align-middle">
                                <thead>
                                    <tr>
                                        <th class="text-start sintoma-col">Estudio / Categoría</th>
                                        <th class="text-start date-col">Resultado</th>
                                        <th class="text-center date-col">Fecha</th>
                                        <th class="text-start cond-col">Condición</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.VM.UltimosLaboratorios.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-muted small fst-italic">No hay resultados para mostrar.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var lab in Model.VM.UltimosLaboratorios)
                                        {
                                            <tr>
                                                <td class="text-start sintoma-col eii-text-sm">
                                                    @lab.Estudio
                                                    @if (!string.IsNullOrWhiteSpace(lab.Categoria) && lab.Categoria != lab.Estudio)
                                                    {
                                                        <br /><small class="text-muted">@lab.Categoria</small>
                                                    }
                                                </td>
                                                <td class="text-start date-col eii-text-sm">
                                                    @if (!string.IsNullOrWhiteSpace(lab.Resultado))
                                                    {
                                                        <strong>@lab.Resultado</strong>
                                                        if (!string.IsNullOrWhiteSpace(lab.Unidad))
                                                        {
                                                            <small class="text-muted ms-1">@lab.Unidad</small>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small fst-italic">—</span>
                                                    }
                                                </td>
                                                <td class="text-center date-col eii-text-sm">
                                                    @(lab.FechaResultado.HasValue ? lab.FechaResultado.Value.ToString("dd/MM/yy") : "—")
                                                </td>
                                                <td class="wrap-condiciones cond-col">
                                                    @if (!string.IsNullOrWhiteSpace(lab.Condicion))
                                                    {
                                                        @lab.Condicion
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Sin Condición</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="eii-card eii-card--elevated" id="cardResumenMedico">
                    <div class="eii-card__header">
                        <div>
                            <div class="eii-card__title">Mi Salud en un Vistazo</div>
                            <div class="eii-text-sm eii-text-muted">Exporta tu historial médico en PDF para llevar a consulta.</div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a href="#" class="btn btn-sm btn-outline-primary btn-export-pdf" data-meses="1">
                            <i class="bi bi-download me-1"></i>Último mes
                        </a>
                        <a href="#" class="btn btn-sm btn-outline-primary btn-export-pdf" data-meses="3">
                            <i class="bi bi-download me-1"></i>Últimos 3 meses
                        </a>
                        <a href="#" class="btn btn-sm btn-outline-primary btn-export-pdf" data-meses="6">
                            <i class="bi bi-download me-1"></i>Últimos 6 meses
                        </a>
                    </div>

                    <hr class="my-2" />

                    <div class="eii-text-sm eii-text-muted mb-1">Rango personalizado</div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <input type="date" id="resumenDesde" class="form-control form-control-sm" style="max-width:150px;" />
                        <span class="eii-text-sm eii-text-muted">al</span>
                        <input type="date" id="resumenHasta" class="form-control form-control-sm" style="max-width:150px;" />
                        <button type="button" id="btnExportarPersonalizado" class="btn btn-sm btn-primary">
                            <i class="bi bi-file-earmark-pdf me-1"></i>Exportar
                        </button>
                        <span id="resumenExportError" class="text-danger eii-text-sm" style="display:none;"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
(function () {
    var baseUrl = '/Identity/Usuario/ResumenMedico';

    function buildUrl(desde, hasta) {
        return baseUrl + '?desde=' + encodeURIComponent(desde) + '&hasta=' + encodeURIComponent(hasta);
    }

    function toInputDate(d) {
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        return d.getFullYear() + '-' + mm + '-' + dd;
    }

    document.querySelectorAll('.btn-export-pdf').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var meses = parseInt(btn.dataset.meses) || 1;
            var hasta = new Date();
            var desde = new Date();
            desde.setMonth(desde.getMonth() - meses);
            window.open(buildUrl(toInputDate(desde), toInputDate(hasta)), '_blank');
        });
    });

    var hoyEl = document.getElementById('resumenHasta');
    var desdeEl = document.getElementById('resumenDesde');
    if (hoyEl && desdeEl) {
        var hoy = new Date();
        var hace1mes = new Date(); hace1mes.setMonth(hace1mes.getMonth() - 1);
        hoyEl.value = toInputDate(hoy);
        desdeEl.value = toInputDate(hace1mes);
    }

    var btnPersonalizado = document.getElementById('btnExportarPersonalizado');
    var errSpan = document.getElementById('resumenExportError');
    if (btnPersonalizado) {
        btnPersonalizado.addEventListener('click', function () {
            errSpan.style.display = 'none';
            var desde = desdeEl.value;
            var hasta = hoyEl.value;
            if (!desde || !hasta) {
                errSpan.textContent = 'Selecciona ambas fechas.';
                errSpan.style.display = 'inline';
                return;
            }
            if (desde > hasta) {
                errSpan.textContent = 'La fecha inicio debe ser menor o igual a la fecha fin.';
                errSpan.style.display = 'inline';
                return;
            }
            window.open(buildUrl(desde, hasta), '_blank');
        });
    }
})();
</script>

@await Html.PartialAsync("_ModalCrearPregunta")
