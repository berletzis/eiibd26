@page
@model eiibd26.Areas.Identity.Pages.Usuario.DashboardModel

@{
    ViewData["Title"] = "Mi Dashboard";
    Layout = "_Layout";
}


<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 900px) {
        .dashboard-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<h1>Mi Dashboard</h1>

@* Notifications card (full-width row) *@
@await Html.PartialAsync("_DashboardNotifications", Model.VM)

<div class="dashboard-grid">
    <div>
        @* Columna 1: partial con la gráfica estilo solicitado. Pasa el VM cargado en el PageModel *@
        @await Html.PartialAsync("_DashboardColumn1", Model.VM)
    </div>

    <div>
        @* Columna 2: placeholder para Mis Síntomas / Mis Preguntas / Mis Respuestas (implementa tus cards aquí) *@
        <div class="card p-3">

            @* Incluir aquí el partial que muestra Top 5 síntomas (ayer + hoy) *@
            @await Html.PartialAsync("_SintomasTop5Seguimiento", Model.VM)

        </div>
    </div>

    <div>
        @* Columna 2: placeholder para Mis Síntomas / Mis Preguntas / Mis Respuestas (implementa tus cards aquí) *@
        <div class="card p-3">
                   <div class="dashboard-col1-title">Preguntas y Respuestas</div>
            <div class="small-muted" style="font-size:.9rem;">Se muestran registros  en orden con Mayor Votación.</div>
            @* Top preguntas partial *@
            @await Html.PartialAsync("_TopPreguntasUsuario", Model.VM)

            @* Top respuestas partial *@
            @await Html.PartialAsync("_TopRespuestasUsuario", Model.VM)
        </div>
    </div>
</div>