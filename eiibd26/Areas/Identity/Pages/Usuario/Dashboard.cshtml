@page
@model eiibd26.Areas.Identity.Pages.Usuario.DashboardModel

@{
    ViewData["Title"] = "Mi Dashboard";
    Layout = "_Layout";
}

@section Head {
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-11417573828"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-11417573828');
    </script>
}

<style>
    /* Estilos tomados y ajustados (sin negritas) para título y card principal */
    .conte-page {
        padding-top: 16px;
        padding-bottom: 24px;
    }

    .se-page-title {
        font-size: 2.1rem;
        font-weight: 300;
        letter-spacing: -0.06em;
        color: #172849;
        padding-bottom: 20px;
    }

    .se-header {
        /* background: #fff;
        border: 1px solid #eef2f7; */
        /* border-radius: 8px;
        padding: 18px;
        box-sizing: border-box;
        margin-bottom: 12px;
        font-weight: 400; */
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 900px) {
        .dashboard-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<main class="conte-page">
    <div class="container py-4">
        <!-- Título centrado -->
        <h1 class="se-page-title">Mi Panel de Control</h1>

        <!-- PWA Push Notifications Card -->
        @await Html.PartialAsync("_PushNotificationCard")

        <!-- Card de notificaciones centrado -->
        <div class="se-header">
            @await Html.PartialAsync("_DashboardNotifications", Model.VM)
        </div>

        <div class="dashboard-grid">
            <div>
                @await Html.PartialAsync("_DashboardColumn1", Model.VM)
            </div>

            <div>
                <div class="card p-3">
                    @await Html.PartialAsync("_SintomasTop5Seguimiento", Model.VM)
                </div>
            </div>

            <div>
                <div class="card p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center">
                        <div>
                            <div class="dashboard-col1-title">Preguntas y Respuestas</div>
                            <div class="small-muted" style="font-size:.9rem;">Se muestran registros  en orden con Mayor Votación.</div>
                        </div>
                        <style>
                            .circle-btn {
                                width: 44px;
                                height: 44px;
                                border-radius: 50%;
                                border: 2px solid #bcbcbc;
                                background: #fff;
                                color: #bcbcbc;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 28px;
                                transition: box-shadow .15s, border-color .15s;
                                box-shadow: 0 1px 6px #e6e8ef77;
                                padding: 0;
                            }
                            .circle-btn:hover, .circle-btn:focus, .circle-btn:active {
                                background: #f7f0ff;
                                border-color: #9B5DE5;
                                color: #9B5DE5;
                                box-shadow: 0 2px 10px #e6e8ef77;
                            }
                            .circle-btn i {
                                color: #bcbcbc !important;
                                font-size: 28px;
                                transition: color .15s;
                            }
                            .circle-btn:hover i, .circle-btn:focus i, .circle-btn:active i {
                                color: #bcbcbc !important;
                            }
                        </style>
                        <div class="d-inline-flex align-items-center">
                            <a class="circle-btn me-0" href="/Identity/Usuario/UusuarioPreguntaDetalle" title="Ver preguntas">
                                <i class="bi bi-question"></i>
                            </a>
                            <button id="btnModalPregunta" type="button" class="circle-btn ms-1"
                                    data-bs-toggle="modal" data-bs-target="#preguntaModal" title="Agregar pregunta rápida">
                                <i class="btn-icon alert-light bi bi-lightning"></i>
                            </button>
                        </div>
                    </div>
                    @await Html.PartialAsync("_TopPreguntasUsuario", Model.VM)
                    @await Html.PartialAsync("_TopRespuestasUsuario", Model.VM)
                </div>
            </div>
        </div>
    </div>
</main>

@await Html.PartialAsync("_ModalCrearPregunta")