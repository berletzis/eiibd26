@model eiibd26.Models.DashboardViewModel
@using System
@{
    var showConfirmEmail = !Model.EmailConfirmed;

    // Temporal: deshabilitamos la notificación de teléfono por el momento
    var showConfirmPhone = false;

    var showAddCondition = !Model.HasAnyCondition;
    var showAddMood = !Model.HasMoodToday;
    var newAnswers = Model.NewAnswersCount;
    var scheduled = Model.ScheduledItemsCount;
    var needsDiagUpdate = Model.NeedsDiagnosisDateUpdate;
    var diagCount = Model.DiagnosisUpdatesCount;
    var needsAvatar = Model.NeedsAvatar;
}

<div class="dash-notifications" id="dashboardNotificationsList" role="region" aria-label="Notificaciones">

    @* Add avatar *@
    @if (needsAvatar)
    {
        <div class="dash-notification" data-notif="add-avatar" role="group" aria-label="Agregar foto de perfil">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación foto de perfil" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--primary" aria-hidden="true">
                    <i class="bi bi-camera-fill" title="Foto de perfil"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Agregá tu foto de perfil</div>
                    <div class="dash-notification__sub">Una foto ayuda a que la comunidad te reconozca. Subí la tuya en unos segundos.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Account/Manage/UsuarioPerfil", new { area = "Identity" })" aria-label="Ir a subir foto de perfil">Subir foto</a>
            </div>
        </div>
    }

    @* Diagnosis date update *@
    @if (needsDiagUpdate)
    {
        <div class="dash-notification" data-notif="diag-update" role="group" aria-label="Actualizar fecha de diagnóstico">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación diagnóstico" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--warning" aria-hidden="true">
                    <i class="bi bi-exclamation-triangle-fill" title="Alerta"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Actualiza tu fecha de Diagnóstico</div>
                    <div class="dash-notification__sub">Si no la recuerdas exactamente, indica aproximadamente cuándo te lo comunicó el médico o cuándo notaste los primeros síntomas.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Usuario/UsuarioCondiciones", new { area = "Identity" })" aria-label="Ir a condiciones">Actualizar</a>
            </div>
        </div>
    }

    @* EMAIL confirmation *@
    @if (showConfirmEmail)
    {
        <div class="dash-notification" data-notif="confirm-email" role="group" aria-label="Confirmar correo">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación correo" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--info" aria-hidden="true">
                    <i class="bi bi-envelope-fill" title="Correo"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Confirma tu correo</div>
                    <div class="dash-notification__sub">Te recomendamos confirmar tu email para seguridad y notificaciones.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Account/ResendEmailConfirmation", new { area = "Identity" })" aria-label="Ir a reenviar confirmación de correo">Reenviar</a>
            </div>
        </div>
    }

    @* PHONE confirmation (temporalmente escondida) *@
    @if (showConfirmPhone)
    {
        <div class="dash-notification" data-notif="confirm-phone" role="group" aria-label="Confirmar teléfono">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación teléfono" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--info" aria-hidden="true">
                    <i class="bi bi-telephone-fill" title="Teléfono"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Confirma tu teléfono</div>
                    <div class="dash-notification__sub">Verifica tu número para recibir alertas y mejorar seguridad.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })" aria-label="Ir a confirmar teléfono">Ir</a>
            </div>
        </div>
    }

    @* Add condition *@
    @if (showAddCondition)
    {
        <div class="dash-notification" data-notif="add-condition" role="group" aria-label="Agregar condición">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación agregar condición" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--primary" aria-hidden="true">
                    <i class="bi bi-heart-pulse-fill" title="Condición"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Agrega al menos 1 condición</div>
                    <div class="dash-notification__sub">Relacionar una condición mejora tus sugerencias y seguimiento.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Usuario/UsuarioCondiciones", new { area = "Identity" })" aria-label="Ir a agregar condición">Agregar</a>
            </div>
        </div>
    }

    @* Add name *@
    @{ var showAddName = !Model.HasRealName; }
    @if (showAddName)
    {
        <div class="dash-notification" data-notif="add-name" role="group" aria-label="Agregar nombre">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación nombre" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--primary" aria-hidden="true">
                    <i class="bi bi-person-badge" title="Nombre"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Agrega tu nombre</div>
                    <div class="dash-notification__sub">Personaliza tu perfil para que la comunidad te conozca.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="/Identity/Usuario/Perfil" aria-label="Ir a agregar nombre">Agregar nombre</a>
            </div>
        </div>
    }

    @* Add mood *@
    @if (showAddMood)
    {
        <div class="dash-notification" data-notif="add-mood" role="group" aria-label="Registrar estado de ánimo">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación mood" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--success" aria-hidden="true">
                    <i class="bi bi-emoji-smile-fill" title="Estado de ánimo"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Registra tu estado de ánimo de hoy</div>
                    <div class="dash-notification__sub">Lleva un seguimiento diario para ver tu evolución.</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Usuario/UsuarioEstadoAnimo", new { area = "Identity" })" aria-label="Ir a registrar mood">Registrar</a>
            </div>
        </div>
    }

    @* New answers *@
    @if (newAnswers > 0)
    {
        <div class="dash-notification" data-notif="new-answers" role="group" aria-label="Nuevas respuestas">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación respuestas" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--info" aria-hidden="true">
                    <i class="bi bi-reply-fill" title="Respuestas"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Nuevas respuestas a tus preguntas</div>
                    <div class="dash-notification__sub">@($"{newAnswers} respuesta(s) en los últimos 7 días")</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <span class="dash-notification__badge" aria-hidden="true">@newAnswers</span>
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Usuario/usuarioPreguntasRespuestas", new { area = "Identity" })" aria-label="Ir a ver respuestas">Ver</a>
            </div>
        </div>
    }

    @* Scheduled items *@
    @if (scheduled > 0)
    {
        <div class="dash-notification" data-notif="scheduled" role="group" aria-label="Programados">
            <button type="button" class="dash-notification__close" aria-label="Cerrar notificación programados" title="Cerrar" data-notif-close>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="dash-notification__left">
                <div class="dash-notification__icon dash-notification__icon--info" aria-hidden="true">
                    <i class="bi bi-calendar-check-fill" title="Programados"></i>
                </div>
                <div class="dash-notification__content">
                    <div class="dash-notification__title">Tienes tareas o servicios programados</div>
                    <div class="dash-notification__sub">@($"{scheduled} ítem(s) programado(s)")</div>
                </div>
            </div>
            <div class="dash-notification__actions">
                <a class="btn btn-sm btn-outline-primary" href="@Url.Page("/Usuario/Programados", new { area = "Identity" })" aria-label="Ir a programados">Ver</a>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        function initCloseButtons() {
            document.querySelectorAll('[data-notif-close]').forEach(btn => {
                btn.replaceWith(btn.cloneNode(true));
            });
            document.querySelectorAll('[data-notif-close]').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    const card = btn.closest('.dash-notification');
                    if (!card) return;
                    card.style.transition = 'opacity .18s ease, transform .18s ease, height .18s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(-6px)';
                    setTimeout(() => {
                        if (card.parentNode) card.parentNode.removeChild(card);
                    }, 200);
                });
            });
        }

        initCloseButtons();
    })();
</script>
