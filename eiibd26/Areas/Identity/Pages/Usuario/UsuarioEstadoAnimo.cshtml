@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioEstadoAnimoModel
@{
    ViewData["Title"] = "Estado de Ánimo";
    Layout = "_Layout";
    var moodColors = new Dictionary<string, string> { { "MuyBien", "success" }, { "Bien", "primary" }, { "Neutral", "secondary" }, { "Mal", "warning" }, { "MuyMal", "danger" } };
    var moodLabels = new Dictionary<string, string> { { "MuyBien", "Muy bien" }, { "Bien", "Bien" }, { "Neutral", "Neutral" }, { "Mal", "Mal" }, { "MuyMal", "Muy mal" } };
}
<style>
    #mooodCards .card > .me-4 {
        border-right: 1px solid #eee;
        padding-right: 1rem;
        min-width: 142px;
    }
</style>
<div class="container mt-4">
    <!-- 1: Bloque superior -->
    <div class="card mb-3 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="mb-2 fs-4">¡Bienvenido! ¿Cómo te sientes hoy?</div>
                <div class="text-muted mb-2">Registra tu estado de ánimo diario y reflexiones.</div>
            </div>
            <button class="btn btn-primary btn-lg" id="btnAbrirMood">¿Cuál es tu Mood hoy?</button>
        </div>
    </div>
    <!-- 2: Gráfica -->
    <div class="card mb-3 p-4">
        <h5 class="mb-3">Tus moods recientes</h5>
        <canvas id="moodChart" height="110"></canvas>
        <div class="d-flex flex-wrap gap-2 mt-2">
            @foreach (var k in moodColors)
            {
                <span class="badge bg-@k.Value">@moodLabels[k.Key]</span>
            }
        </div>
    </div>
    <!-- 3: Cards histórico -->
    <!-- ... -->
    <div id="moodCards" class="d-flex flex-column gap-3">
        @foreach (var item in Model.UltimosEstados)
        {
            var mood = item.EstadoMood ?? "";
            var label = moodLabels.ContainsKey(mood) ? moodLabels[mood] : mood;
            var color = moodColors.ContainsKey(mood) ? moodColors[mood] : "secondary";
            var fecha = item.FechaRegistro.ToString("dd/MM/yyyy HH:mm");
            // Relación a mostrar: Condición > Síntoma > Tratamiento
            string relacionLabel = null, relacionValor = null;
            if (item.CondicionUsuario != null && item.CondicionUsuario.Condicion != null)
            {
                relacionLabel = "Condición";
                relacionValor = item.CondicionUsuario.Condicion.nombre;
            }
            else if (item.SintomaUsuario != null && item.SintomaUsuario.Sintoma != null)
            {
                relacionLabel = "Síntoma";
                relacionValor = item.SintomaUsuario.Sintoma.nombre;
            }
            else if (item.TratamientoUsuario != null && item.TratamientoUsuario.Tratamiento != null)
            {
                relacionLabel = "Tratamiento";
                relacionValor = item.TratamientoUsuario.Tratamiento.nombre;
            }
            <div class="card flex-row align-items-center p-3">
                @* Celda lateral de relación *@
                <div class="me-4 text-center" style="min-width:142px;">
                    @if (relacionLabel != null && relacionValor != null)
                    {
                        <span class="badge bg-info text-dark mb-2">@relacionLabel</span>
                
                        <br />
                        <span class="fw-semibold">@relacionValor</span>
                    }
                </div>
                <div class="me-3">
                    <span class="badge bg-@color">@label</span>
                </div>
                <div class="flex-grow-1">
                    <small class="text-muted">@fecha</small>
                    <div>@item.Texto</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Mood -->
<div class="modal fade" id="modalMood" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="formModalMood" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title">¿Cuál es tu Mood hoy?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div>Selecciona tu estado:</div>
                <div id="opcionesMood" class="d-flex gap-2 my-2"></div>
                <div>
                    <label class="form-label small">Asociar opcional a:</label>
                    <select class="form-select mb-2" id="moodRelacion" name="moodRelacion">
                        <option value="" selected>Ninguna relación</option>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">Comentario/reflexión</label>
                    <textarea class="form-control" id="modalMoodTexto" rows="3"></textarea>
                </div>
                <div id="leyendaInfoMood" class="alert alert-success d-none py-2 mt-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Información guardada
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnCancelarMood">Cancelar</button>
                <button type="submit" class="btn btn-success" id="btnPublicarMood" disabled>Publicar</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const moodOpts = [
            { val: "MuyBien", label: "Muy bien", color: "success" },
            { val: "Bien", label: "Bien", color: "primary" },
            { val: "Neutral", label: "Neutral", color: "secondary" },
            { val: "Mal", label: "Mal", color: "warning" },
            { val: "MuyMal", label: "Muy mal", color: "danger" },
        ];
        let moodState = "";
        let moodChart;

        // Opciones y bindings
        document.addEventListener("DOMContentLoaded", async function() {
            const moodOpciones = document.getElementById("opcionesMood");
            moodOpciones.innerHTML = "";
            moodOpts.forEach(o=>{
                let btn = document.createElement("button");
                btn.type="button";
                btn.className = `btn btn-outline-${o.color} mood-btn`;
                btn.innerText = o.label;
                btn.dataset.valor = o.val;
                btn.onclick = function(){
                    moodState = o.val;
                    document.querySelectorAll("#opcionesMood .mood-btn").forEach(bb=>bb.classList.remove("active","btn-primary","btn-success","btn-secondary","btn-warning","btn-danger"));
                    btn.classList.add("active",`btn-${o.color}`);
                    document.getElementById("btnPublicarMood").disabled = false;
                };
                moodOpciones.appendChild(btn);
            });

            // Abrir modal
            document.getElementById("btnAbrirMood").onclick = async function() {
                moodState = "";
                document.getElementById("modalMoodTexto").value = "";
                document.getElementById("btnPublicarMood").disabled = true;
                document.querySelectorAll("#opcionesMood .mood-btn").forEach(bb=>bb.classList.remove("active"));
                document.getElementById("leyendaInfoMood").classList.add("d-none");
                // Llenar select relaciones AJAX
                let select = document.getElementById("moodRelacion");
                select.innerHTML = `<option value="" selected>Ninguna relación</option>`;
                let rel = await fetch("/api/Usuario/RelacionesMoodOptions");
                if(rel.ok) {
                    let opts = await rel.json();
                    opts.sintomas.forEach(s=> select.innerHTML += `<option value="Sintoma-${s.id}">Síntoma: ${s.nombre}</option>`);
                    opts.condiciones.forEach(c=> select.innerHTML += `<option value="Condicion-${c.id}">Condición: ${c.nombre}</option>`);
                    opts.tratamientos.forEach(t=> select.innerHTML += `<option value="Tratamiento-${t.id}">Tratamiento: ${t.nombre}</option>`);
                }
                var modal = new bootstrap.Modal(document.getElementById('modalMood'));
                modal.show();
            };

            document.getElementById("btnCancelarMood").onclick = function(){
                moodState="";
            };

            // Publicar
            document.getElementById("formModalMood").onsubmit = async function(ev){
                ev.preventDefault();
                if (!moodState) return;
                let texto = document.getElementById("modalMoodTexto").value;
                // relación sintoma/condicion/tratamiento
                let tipo = "", id=null;
                let relVal = document.getElementById("moodRelacion").value;
                if(relVal) {
                    let toks = relVal.split('-');
                    if(toks.length === 2) { tipo = toks[0]; id = parseInt(toks[1]||"0"); }
                }
                let formData = new FormData();
                formData.append("mood", moodState);
                formData.append("texto", texto);
                if(tipo=="Sintoma") formData.append("sintomaUsuarioId", id);
                if(tipo=="Condicion") formData.append("condicionUsuarioId", id);
                if(tipo=="Tratamiento") formData.append("tratamientoUsuarioId", id);
                let resp = await fetch("/api/EstadoAnimoUsuario/nuevo", { method:"POST", body:formData });
                if(resp.ok) {
                    let obj = await resp.json();
                    document.getElementById("leyendaInfoMood").classList.remove('d-none');
                    setTimeout(()=>{
                        bootstrap.Modal.getInstance(document.getElementById('modalMood')).hide();
                        agregarMoodCard(obj);
                        addMoodToChart(obj);
                    },900);
                } else {
                    alert("No se pudo guardar.");
                }
            };

            // Gráfica y carga histórica
            await cargarHistorialEstadoAnimo();
        });

        function badgeFor(val) {
            let m = moodOpts.find(o=>o.val===val);
            return `<span class="badge bg-${m?.color||'secondary'}">${m?.label||val}</span>`;
        }
        function formatFecha(fecha) {
            let d = new Date(fecha);
            return d.toLocaleDateString('es-MX')+" "+d.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});
        }
        function agregarMoodCard(dto){
            let relacion = "";
            if(dto.TipoRelacion) relacion = `<span class="badge bg-info ms-2">(${dto.TipoRelacion}: ${dto.RelacionNombre})</span>`;
            let html = `<div class="card flex-row align-items-center p-3">
                <div class="me-3">${badgeFor(dto.EstadoMood)}</div>
                <div class="flex-grow-1">
                    <small class="text-muted">${formatFecha(dto.FechaRegistro||new Date())}${relacion}</small>
                    <div>${dto.Texto||""}</div>
                </div>
            </div>`;
            document.getElementById('moodCards').insertAdjacentHTML('afterbegin', html);
        }
        function addMoodToChart(dto){
            let chart = window.moodChartInst;
            if (!chart) return;
            chart.data.labels.push(dto.FechaRegistro?.substring(0,10) || "");
            chart.data.datasets[0].data.push(dto.EstadoMood);
            chart.data.datasets[0].backgroundColor.push(moodOpts.find(o=>o.val===dto.EstadoMood)?.color||"#CCC");
            chart.update();
        }
                async function cargarHistorialEstadoAnimo() {
            let respuesta = await fetch("/api/EstadoAnimoUsuario/historico");
            let datos = await respuesta.json();

            // Cards: usa las propiedades minúscula
            document.getElementById("moodCards").innerHTML = "";
            datos.forEach(function(dto){
                let mood = dto.estadoMood ?? "";
                let label = moodOpts.find(o=>o.val===mood)?.label || mood;
                let color = moodOpts.find(o=>o.val===mood)?.color || "secondary";
                let fecha = dto.fechaRegistro ? formatFecha(dto.fechaRegistro) : "";
                let relacion = "";
                if(dto.tipoRelacion && dto.relacionNombre){
                    relacion = `<span class="badge bg-info ms-2">(${dto.tipoRelacion}: ${dto.relacionNombre})</span>`;
                }
                let html = `<div class="card flex-row align-items-center p-3">
                    <div class="me-3"><span class="badge bg-${color}">${label}</span></div>
                    <div class="flex-grow-1">
                        <small class="text-muted">${fecha}${relacion}</small>
                        <div>${dto.texto||""}</div>
                    </div>
                </div>`;
                document.getElementById('moodCards').insertAdjacentHTML('beforeend', html);
            });

            // Para gráfica: mapea estadoMood a Número
            const moodValues = {
                "MuyBien": 5,
                "Bien": 4,
                "Neutral": 3,
                "Mal": 2,
                "MuyMal": 1
            };
            const moodLabels = {
                5: "Muy bien",
                4: "Bien",
                3: "Neutral",
                2: "Mal",
                1: "Muy mal"
            };
            let labels = datos.map(x => x.fechaRegistro ? x.fechaRegistro.substring(0,10) : "");
            let moodsNum = datos.map(x => moodValues[x.estadoMood] || 3);
            let colors = datos.map(x => {
                switch(x.estadoMood){
                    case "MuyBien": return "#28a745";
                    case "Bien": return "#0d6efd";
                    case "Neutral": return "#6c757d";
                    case "Mal": return "#ffc107";
                    case "MuyMal": return "#dc3545";
                    default: return "#CCC";
                }
            });

            // Destruye gráfica anterior si existe (evita overlays)
            if(window.moodChartInst) { window.moodChartInst.destroy(); }

            let ctx = document.getElementById("moodChart");
            window.moodChartInst = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Estado diario",
                        data: moodsNum,
                        backgroundColor: colors,
                        borderWidth: 1,
                        borderColor: "#FFFFFF"
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display:false },
                        tooltip: { callbacks: {
                            label: ctx => {
                                let moodValue = ctx.raw;
                                return moodLabels[moodValue] ? moodLabels[moodValue] : moodValue;
                            }
                        }}
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) { return moodLabels[value] || value; },
                                stepSize: 1,
                                min: 1,
                                max: 5
                            },
                            beginAtZero: false,
                            grid: {display: false}
                        }
                    }
                }
            });
        }
    </script>
}