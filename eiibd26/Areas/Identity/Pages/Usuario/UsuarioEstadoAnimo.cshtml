@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioEstadoAnimoModel
@{
    ViewData["Title"] = "Estado de Ánimo";
    Layout = "_Layout";
    var moodImgs = new Dictionary<string, string> {
        { "MuyBien", "/img/muybien.svg" }, { "Bien", "/img/bien.svg" }, { "Neutral", "/img/neutral.svg" }, { "Mal", "/img/mal.svg" }, { "MuyMal", "/img/muymal.svg" }
    };
    var moodLabels = new Dictionary<string, string> {
        { "MuyBien", "Muy bien" }, { "Bien", "Bien" }, { "Neutral", "Neutral" }, { "Mal", "Mal" }, { "MuyMal", "Muy mal" }
    };
    var moodPointColors = new Dictionary<string, string> {
        { "MuyBien", "#38D6C1" },   // turquesa
        { "Bien", "#B3F1E9" },      // celeste pastel
        { "Neutral", "#FEE019" },   // amarillo
        { "Mal", "#D8B4F8" },       // lila pastel
        { "MuyMal", "#9B5DE5" }     // morado
    };
}
<style>
    .mood-leyenda-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 34px;
        margin-top: 8px;
        margin-bottom: 5px;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    .mood-leyenda-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        font-size: 1.13em;
        padding: 1px 0;
    }

    .mood-leyenda-img {
        width: 31px;
        height: 31px;
        object-fit: contain;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 1px 6px #e6e8ef77;
    }

    .mood-card-panel {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px;
        align-items: start;
        margin-top: 14px;
        margin-bottom: 10px;
        width: 100%;
    }

    .mood-card-item {
        background: #f7f9fd !important;
        min-width: 0;
        max-width: 100%;
        border-radius: 18px;
        box-shadow: 0 2px 12px rgb(180 193 239 / 12%);
        border: none;
        padding: 1.15rem 1rem 1rem 1rem;
        margin: 0;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 13px;
        height: 100%;
        position: relative;
        box-sizing: border-box;
        width: 100%;
    }

    .mood-card-img {
        width: 46px;
        height: 46px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 14px rgba(0,0,0,0.12);
        object-fit: contain;
        border: 3px solid #fff;
        margin-right: 4px;
        padding: 2px;
        display: inline-block;
        flex-shrink: 0;
    }

    .mood-card-content {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        min-width: 0;
        height: 100%;
        width: 100%;
    }

    .mood-label {
        font-size: .9rem;
        font-weight: 600;
        color: #315686;
        margin-bottom: 6px;
        margin-top: 0px;
        display: inline-block;
        line-height: 1.15;
        word-break: break-word;
    }

    .mood-reflexion {
        font-size: .9em;
        margin-bottom: 7px;
        margin-top: 0;
        color: #283343;
        word-break: break-word;
        white-space: pre-line;
    }

    .mood-main-legend {
        font-size: .9em !important;
        color: #888ca0 !important;
        font-weight: 100 !important;
        margin-bottom: 4px;
        display: block;
        margin-top: 0;
    }

    .mood-relacion {
        font-size: .93em;
        color: #7e7e9d;
        margin-bottom: 2px;
        display: block;
    }

    .mood-delete-btn {
        position: absolute;
        right: 10px;
        top: 10px;
        border: none;
        background: transparent;
        color: #c92a2a;
        cursor: pointer;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .mood-delete-btn:hover {
            text-decoration: underline;
        }

    .mood-filters-row {
        display: flex;
        gap: .5rem;
        align-items: center;
        overflow: hidden;
    }

        .mood-filters-row .mood-filter-btn {
            flex: 0 0 auto;
        }

    #moodCountLegend {
        margin-top: .6rem;
        color: #6b7280;
        font-size: .95rem;
    }

    @@media (max-width: 900px) {
        .crm-container {
            max-width: 98vw;
        }

        .mood-card-panel {
            grid-template-columns: repeat(2,1fr)
        }

        .mood-card-item {
            min-width: 0;
            max-width: 100%;
        }

        .crm-title {
            font-size: 1.38rem;
        }
    }

    @@media (max-width: 750px) {
        .mood-card-panel {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .crm-card {
            padding: 1.15rem 0.6rem 1.1rem 0.6rem;
        }

        .mood-card-item {
            width: 100%;
            min-width: 0;
            max-width: 98vw;
        }

        #moodFilterBlock {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: .4rem;
            width: 100%;
        }

            #moodFilterBlock > div {
                display: block;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                white-space: nowrap;
            }

                #moodFilterBlock > div .mood-filter-btn {
                    display: inline-block;
                    white-space: nowrap;
                    margin-right: .4rem;
                }

        #moodCountLegend {
            margin-top: 0;
            margin-left: 0.15rem;
        }

        .mood-main-legend {
            line-height: 1.1;
        }

        .mood-filter-btn[data-filter="6m"],
        .mood-filter-btn[data-filter="12m"] {
            display: none !important;
        }
    }

    .modal-dialog-centered {
        display: flex;
        align-items: center;
        min-height: calc(100% - 1rem);
    }

    .modal-content {
        max-height: calc(100vh - 3.5rem);
        overflow: auto;
    }

    /* Custom Select Dropdown */
    .custom-select-wrapper {
        position: relative;
    }

    .custom-select-display {
        width: 100%;
        padding: 0.375rem 2.25rem 0.375rem 0.75rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
        color: #212529;
        background-color: #fff;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 16px 12px;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        cursor: pointer;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }

        .custom-select-display:hover {
            border-color: #86b7fe;
        }

        .custom-select-display.active {
            border-color: #86b7fe;
            outline: 0;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .custom-select-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        display: none;
        max-height: 250px;
        margin-top: 0.125rem;
        background-color: #fff;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
        overflow: hidden;
    }

        .custom-select-dropdown.show {
            display: block;
        }

    .custom-select-search {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: none;
        border-bottom: 1px solid #dee2e6;
        outline: none;
        font-size: 0.95rem;
    }

        .custom-select-search:focus {
            background-color: #f8f9fa;
        }

    .custom-select-options {
        max-height: 200px;
        overflow-y: auto;
        padding: 0.25rem 0;
    }

    .custom-select-option {
        padding: 0.5rem 0.75rem;
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }

        .custom-select-option:hover {
            background-color: #f8f9fa;
        }

        .custom-select-option.selected {
            background-color: #e7f1ff;
            font-weight: 500;
        }

    .custom-select-no-results {
        padding: 0.5rem 0.75rem;
        color: #6c757d;
        font-style: italic;
        text-align: center;
    }
</style>

<div class="container py-4">
    <h1 class="crm-title mb-4">Estado de Ánimo</h1>

    <div class="qp-wrapper-flex">
        <div class="crm-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <div class="mb-2 fs-4">¡Bienvenido! ¿Cómo te sientes hoy?</div>
                    <div class="crm-label">Registra tu estado de ánimo diario y reflexiones.</div>
                </div>
                <button class="crm-btn crm-btn-primary btn-lg" id="btnAbrirMood" type="button">+<i class="bi bi-emoji-wink"></i></button>
            </div>
        </div>
    </div>

    <div class="condiciones-paginacion" aria-label="Paginación">
        <span>Tu gráfica de estados de ánimo</span>
    </div>

    <div class="crm-card mb-3 p-4">
        <div style="height:335px;position:relative">
            <canvas id="moodChart" height="325"></canvas>
        </div>
        <div class="mood-leyenda-row">
            @foreach (var k in moodImgs)
            {
                <span class="mood-leyenda-item">
                    <img class="mood-leyenda-img" src="@k.Value" alt="@moodLabels[k.Key]" />
                    <span>@moodLabels[k.Key]</span>
                </span>
            }
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center mb-3" id="moodFilterBlock">
        <div class="mood-filters-row">
            <button type="button" class="btn btn-outline-secondary mx-1 mood-filter-btn active" data-filter="1m">Último Mes</button>
            <button type="button" class="btn btn-outline-secondary mx-1 mood-filter-btn" data-filter="3m">3 Meses</button>
            <button type="button" class="btn btn-outline-secondary mx-1 mood-filter-btn" data-filter="6m">6 Meses</button>
            <button type="button" class="btn btn-outline-secondary mx-1 mood-filter-btn" data-filter="12m">Todo este Año</button>
        </div>
        <span id="moodCountLegend" class="mood-count-legend"></span>
    </div>
    <div id="moodCards" class="mood-card-panel"></div>

    <!-- Modal: Registrar Mood -->
    <div class="modal fade" tabindex="-1" id="moodModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="moodForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Registrar Mood</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="alertMoodAdded" class="alert alert-success alert-mood-added" style="display:none"></div>
                        <div class="mb-3">
                            <label class="form-label">Selecciona tu estado de ánimo:</label>
                            <div id="moodOptionsBtns" class="d-flex gap-2"></div>
                            <input type="hidden" id="moodSelected" name="estadoMood">
                        </div>
                        <div class="mb-3">
                            <label for="moodText" class="form-label">Reflexión breve (opcional):</label>
                            <textarea id="moodText" name="texto" class="form-control" maxlength="100" rows="2"></textarea>
                        </div>
                        
                        <!-- CONDICIÓN CUSTOM SELECT -->
                        <div class="mb-3">
                            <label class="form-label">Relacionar a condición (opcional):</label>
                            <div class="custom-select-wrapper" data-field="condicion">
                                <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                                <div class="custom-select-dropdown">
                                    <input type="text" class="custom-select-search" placeholder="Buscar...">
                                    <div class="custom-select-options"></div>
                                </div>
                                <input type="hidden" id="condicionSelectedId" name="condicionUsuarioId">
                            </div>
                        </div>

                        <!-- SÍNTOMA CUSTOM SELECT -->
                        <div class="mb-3">
                            <label class="form-label">Relacionar a síntoma (opcional):</label>
                            <div class="custom-select-wrapper" data-field="sintoma">
                                <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                                <div class="custom-select-dropdown">
                                    <input type="text" class="custom-select-search" placeholder="Buscar...">
                                    <div class="custom-select-options"></div>
                                </div>
                                <input type="hidden" id="sintomaSelectedId" name="sintomaUsuarioId">
                            </div>
                        </div>

                        <!-- TRATAMIENTO CUSTOM SELECT -->
                        <div class="mb-3">
                            <label class="form-label">Relacionar a tratamiento (opcional):</label>
                            <div class="custom-select-wrapper" data-field="tratamiento">
                                <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                                <div class="custom-select-dropdown">
                                    <input type="text" class="custom-select-search" placeholder="Buscar...">
                                    <div class="custom-select-options"></div>
                                </div>
                                <input type="hidden" id="tratamientoSelectedId" name="tratamientoUsuarioId">
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button id="btnSaveMood" type="submit" class="se-btn se-btn-primary" style="font-size:28px; border-radius:50%;"><i class="bi bi-check"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const moodOpts = [
        { val: 5, label: "Muy bien", color: "#38D6C1", img: "/img/muybien.svg" },
        { val: 4, label: "Bien", color: "#B3F1E9", img: "/img/bien.svg" },
        { val: 3, label: "Neutral", color: "#FEE019", img: "/img/neutral.svg" },
        { val: 2, label: "Mal", color: "#D8B4F8", img: "/img/mal.svg" },
        { val: 1, label: "Muy mal", color: "#9B5DE5", img: "/img/muymal.svg" }
        ];

        const DAY_MS = 24 * 60 * 60 * 1000;

        let condicionesData = [];
        let sintomasData = [];
        let tratamientosData = [];

        function moodNumFromStr(val){
        if (typeof val === 'number') return val >= 1 && val <= 5 ? val : null;
        if (typeof val === 'string') {
        const num = parseInt(val.trim());
        return num >= 1 && num <= 5 ? num : null;
        }
        return null;
        }

        function moodPointColorFromNum(num) {
        const colors = {
        5: "#38D6C1", 4: "#B3F1E9", 3: "#FEE019", 2: "#D8B4F8", 1: "#9B5DE5"
        };
        return colors[num] ?? "#CCC";
        }

        function moodImgFromNum(num){
        const imgs = {
        5: "/img/muybien.svg", 4: "/img/bien.svg", 3: "/img/neutral.svg",
        2: "/img/mal.svg", 1: "/img/muymal.svg"
        };
        return imgs[num] ?? "/img/neutral.svg";
        }

        function moodLabelFromNum(n){
        const labels = {
        5: "Muy bien", 4: "Bien", 3: "Neutral", 2: "Mal", 1: "Muy mal"
        };
        return labels[n] || "";
        }

        function formatFecha(fecha){
        let d = new Date(fecha);
        if (isNaN(d.getTime())) return fecha;
        return d.toLocaleDateString('es-MX');
        }

        function agregarMoodCard(dto){
        let id = dto.Id || dto.id || "";
        let mood = dto.EstadoMood || dto.estadoMood || "";
        let moodNum = moodNumFromStr(mood);
        let label = moodLabelFromNum(moodNum);
        let img = moodImgFromNum(moodNum);
        let fecha = (dto.FechaRegistro || dto.fechaRegistro) ? formatFecha(dto.FechaRegistro || dto.fechaRegistro) : "";
        let reflexion = dto.Texto || dto.texto || "";
            
        // ✅ CORREGIDO: Acceso correcto a las propiedades de las relaciones
        let relacionesHtml = '';
            
        // Verificar Condicion
        const condicion = dto.Condicion || dto.condicion;
        if (condicion && (condicion.Nombre || condicion.nombre)) {
        const nombreCondicion = condicion.Nombre || condicion.nombre;
        relacionesHtml += `<span class="mood-relacion"><strong>Condición:</strong> ${nombreCondicion}</span>`;
        }
            
        // Verificar Sintoma
        const sintoma = dto.Sintoma || dto.sintoma;
        if (sintoma && (sintoma.Nombre || sintoma.nombre)) {
        const nombreSintoma = sintoma.Nombre || sintoma.nombre;
        relacionesHtml += `<span class="mood-relacion"><strong>Síntoma:</strong> ${nombreSintoma}</span>`;
        }
            
        // Verificar Tratamiento
        const tratamiento = dto.Tratamiento || dto.tratamiento;
        if (tratamiento && (tratamiento.Nombre || tratamiento.nombre)) {
        const nombreTratamiento = tratamiento.Nombre || tratamiento.nombre;
        relacionesHtml += `<span class="mood-relacion"><strong>Tratamiento:</strong> ${nombreTratamiento}</span>`;
        }
            
        let deleteBtn = id ? `<button class="mood-delete-btn" onclick="eliminarMood(${id})" title="Eliminar este estado de ánimo"><i class="bi bi-trash"></i></button>` : "";
            
        return `<div class="mood-card-item" data-id="${id}">
        ${deleteBtn}
        <img class="mood-card-img" src="${img}" alt="${label}" />
        <div class="mood-card-content">
        <span class="mood-label">${label}</span>
        <div class="mood-reflexion">${reflexion}</div>
        <div class="mood-main-legend">Ultimo Seguimiento<br/><span style="color:#7e7e9d;font-weight:400">${fecha}</span></div>
        ${relacionesHtml}
        </div>
        </div>`;
        }

        let allMoodsData = [], lastFilteredCount = 0, windowChart = null;

        function parseDateString(s) {
        if (!s) return null;
        try {
        s = String(s);
        s = s.replace(/\.(\d{3})\d+/, '.$1');
        if (!/[zZ]$/.test(s) && !/[+\-]\d{2}:\d{2}$/.test(s)) s = s + 'Z';
        const d = new Date(s);
        return isNaN(d.getTime()) ? null : d;
        } catch (e) { return null; }
        }

        function getLast3Window() {
        const today = new Date();
        const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 2);
        const startMs = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
        const endMs = startMs + 3 * DAY_MS - 1;
        return { startMs, endMs };
        }

        function collapseToLastPerDay(items) {
        const byDay = {};
        items.forEach(it => {
        const ts = it.fechaTs || null;
        if (!ts) return;
        const d = new Date(ts);
        const key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
        if (!byDay[key] || (byDay[key] && (it.fechaTs > byDay[key].fechaTs))) {
        byDay[key] = it;
        }
        });
        return Object.keys(byDay).map(k => byDay[k]);
        }

        // =====================
        // CUSTOM SELECT LOGIC
        // =====================
        function initCustomSelect(wrapper, dataArray, hiddenInputId) {
        const display = wrapper.querySelector('.custom-select-display');
        const dropdown = wrapper.querySelector('.custom-select-dropdown');
        const searchInput = wrapper.querySelector('.custom-select-search');
        const optionsContainer = wrapper.querySelector('.custom-select-options');
        const hiddenInput = document.getElementById(hiddenInputId);

        let allOptions = dataArray;
        let selectedId = null;

        function renderOptions(filteredData) {
        optionsContainer.innerHTML = '';
        if (filteredData.length === 0) {
        optionsContainer.innerHTML = '<div class="custom-select-no-results">Sin resultados</div>';
        return;
        }
        filteredData.forEach(item => {
        const div = document.createElement('div');
        div.className = 'custom-select-option';
        if (item.id === selectedId) div.classList.add('selected');
        div.textContent = item.nombre;
        div.dataset.id = item.id;
        div.dataset.nombre = item.nombre;
        div.addEventListener('click', function() {
        selectedId = item.id;
        hiddenInput.value = item.id;
        display.textContent = item.nombre;
        closeDropdown();
        });
        optionsContainer.appendChild(div);
        });
        }

        function openDropdown() {
        dropdown.classList.add('show');
        display.classList.add('active');
        searchInput.value = '';
        renderOptions(allOptions);
        searchInput.focus();
        }

        function closeDropdown() {
        dropdown.classList.remove('show');
        display.classList.remove('active');
        }

        display.addEventListener('click', function(e) {
        e.stopPropagation();
        if (dropdown.classList.contains('show')) {
        closeDropdown();
        } else {
        document.querySelectorAll('.custom-select-dropdown.show').forEach(d => {
        d.classList.remove('show');
        d.previousElementSibling.classList.remove('active');
        });
        openDropdown();
        }
        });

        searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        const filtered = allOptions.filter(item => item.nombre.toLowerCase().includes(query));
        renderOptions(filtered);
        });

        searchInput.addEventListener('click', function(e) {
        e.stopPropagation();
        });

        document.addEventListener('click', function(e) {
        if (!wrapper.contains(e.target)) {
        closeDropdown();
        }
        });

        wrapper.resetSelect = function() {
        selectedId = null;
        hiddenInput.value = '';
        display.textContent = 'Seleccionar...';
        };
        }

        async function cargarCondicionesUsuario() {
        try {
        let resp = await fetch("/api/EstadoAnimoUsuario/condiciones-usuario", { cache: "no-store" });
        condicionesData = await resp.json();
        } catch (e) {
        condicionesData = [];
        }
        }

        async function cargarSintomasUsuario() {
        try {
        let resp = await fetch("/api/EstadoAnimoUsuario/sintomas-usuario", { cache: "no-store" });
        sintomasData = await resp.json();
        } catch (e) {
        sintomasData = [];
        }
        }

        async function cargarTratamientosUsuario() {
        try {
        let resp = await fetch("/api/EstadoAnimoUsuario/tratamientos-usuario", { cache: "no-store" });
        tratamientosData = await resp.json();
        } catch (e) {
        tratamientosData = [];
        }
        }

        document.addEventListener("DOMContentLoaded", async function(){
        await cargarCondicionesUsuario();
        await cargarSintomasUsuario();
        await cargarTratamientosUsuario();
        await cargarHistorialEstadoAnimo();

        const condicionWrapper = document.querySelector('[data-field="condicion"]');
        const sintomaWrapper = document.querySelector('[data-field="sintoma"]');
        const tratamientoWrapper = document.querySelector('[data-field="tratamiento"]');

        initCustomSelect(condicionWrapper, condicionesData, 'condicionSelectedId');
        initCustomSelect(sintomaWrapper, sintomasData, 'sintomaSelectedId');
        initCustomSelect(tratamientoWrapper, tratamientosData, 'tratamientoSelectedId');

        document.querySelectorAll('.mood-filter-btn').forEach(btn => {
        btn.addEventListener('click', function () {
        document.querySelectorAll('.mood-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        aplicarFiltroMood(btn.dataset.filter);
        });
        });

        document.getElementById("btnAbrirMood").addEventListener("click", function(){
        document.getElementById("alertMoodAdded").style.display = "none";
        document.getElementById("moodForm").reset();
        condicionWrapper.resetSelect();
        sintomaWrapper.resetSelect();
        tratamientoWrapper.resetSelect();
        var modalEl = document.getElementById("moodModal");
        var modaObj = bootstrap.Modal.getOrCreateInstance(modalEl);
        modaObj.show();
        });

        renderMoodOptionsBtns();

        document.getElementById("moodModal").addEventListener('hidden.bs.modal', function () {
        document.getElementById("btnAbrirMood").focus();
        });

        document.getElementById("moodForm").addEventListener("submit", async function(e){
        e.preventDefault();
        const moodSelected = document.getElementById("moodSelected").value;
        if (!moodSelected || ![1,2,3,4,5].includes(parseInt(moodSelected))) {
        mostrarLeyendaModal("Selecciona tu estado de ánimo por favor.", true);
        return;
        }
        const moodText = document.getElementById("moodText").value || "";
        const condicionUsuarioId = document.getElementById("condicionSelectedId").value || "";
        const sintomaUsuarioId = document.getElementById("sintomaSelectedId").value || "";
        const tratamientoUsuarioId = document.getElementById("tratamientoSelectedId").value || "";

        const formData = new FormData();
        formData.append("mood", moodSelected);
        formData.append("texto", moodText);
        if (condicionUsuarioId) formData.append("condicionUsuarioId", condicionUsuarioId);
        if (sintomaUsuarioId) formData.append("sintomaUsuarioId", sintomaUsuarioId);
        if (tratamientoUsuarioId) formData.append("tratamientoUsuarioId", tratamientoUsuarioId);

        try {
        let resp = await fetch("/api/EstadoAnimoUsuario/nuevo", {
        method: "POST",
        body: formData
        });
        if(resp.ok){
        mostrarLeyendaModal("¡Estado de ánimo agregado correctamente!", false);
        setTimeout(()=>{
        bootstrap.Modal.getOrCreateInstance(document.getElementById("moodModal")).hide();
        document.getElementById("alertMoodAdded").style.display = "none";
        document.getElementById("moodForm").reset();
        }, 1100);
        await cargarHistorialEstadoAnimo();
        try { window.dispatchEvent(new CustomEvent('mood:added', { detail: { source: 'fullpage' } })); } catch(e){}
        } else {
        mostrarLeyendaModal("Error al agregar estado de ánimo. Código: " + resp.status, true);
        }
        }catch(e){
        mostrarLeyendaModal("Ocurrió un error de red.", true);
        }
        });

        window.addEventListener('mood:added', async function(e){
        await cargarHistorialEstadoAnimo();
        const activeBtn = document.querySelector('.mood-filter-btn.active');
        if (activeBtn) aplicarFiltroMood(activeBtn.dataset.filter || '1m');
        });
        });

        function mostrarLeyendaModal(msg, error){
        const leyenda = document.getElementById("alertMoodAdded");
        leyenda.textContent = msg;
        leyenda.className = error ? "alert alert-danger alert-mood-added" : "alert alert-success alert-mood-added";
        leyenda.style.display = "block";
        }

        function renderMoodOptionsBtns(){
        const container = document.getElementById("moodOptionsBtns");
        container.innerHTML = "";
        moodOpts.forEach(o=>{
        let btn=document.createElement("button");
        btn.type="button";
        btn.className=`btn btn-outline-secondary mood-btn-option`;
        btn.innerHTML = `<img src="${o.img}" alt="${o.label}" style="width:25px;vertical-align:middle;margin-right:6px;"> <span>${o.label}</span>`;
        btn.onclick=function(){
        document.getElementById("moodSelected").value = o.val;
        container.querySelectorAll(".mood-btn-option").forEach(b=>b.classList.remove("active"));
        btn.classList.add("active");
        };
        container.appendChild(btn);
        });
        }

        async function cargarHistorialEstadoAnimo(){
        try {
        let respuesta = await fetch("/api/EstadoAnimoUsuario/historico", { cache: "no-store" });
        let datos = await respuesta.json();
                
        console.log("Datos recibidos del API:", datos); // DEBUG
                
        allMoodsData = Array.isArray(datos)
        ? datos.map(x => {
        let mood = x.EstadoMood || x.estadoMood || 0;
        let rawFecha = (x.FechaRegistro || x.fechaRegistro || "") + "";
        const parsed = parseDateString(rawFecha);
        const fechaTs = parsed ? parsed.getTime() : null;
        const fechaIso = parsed ? parsed.toISOString() : rawFecha;
                        
        // ✅ MANTENER las relaciones exactamente como vienen del API
        return {
        ...x,
        estadoMood: mood,
        fechaRegistro: fechaIso,
        fechaTs: fechaTs,
        texto: x.Texto || x.texto || null
        };
        })
        : [];
                    
        console.log("allMoodsData procesado:", allMoodsData); // DEBUG
        } catch (e) {
        console.error("Error al cargar historial:", e);
        allMoodsData = [];
        }
        aplicarFiltroMood("1m");
        }

        function aplicarFiltroMood(filtro){
        let fromDateTs, toDateTs;
        const today = new Date();
        const end = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59, 999);
        if (filtro === "1m") {
        const start = new Date(today.getFullYear(), today.getMonth(), 1, 0, 0, 0, 0);
        fromDateTs = start.getTime(); toDateTs = end.getTime();
        } else if (filtro === "3m") {
        let monthStart = today.getMonth() - 2;
        let yearStart = today.getFullYear(); while (monthStart < 0) { yearStart--; monthStart += 12; }
        const start = new Date(yearStart, monthStart, 1, 0, 0, 0, 0);
        fromDateTs = start.getTime(); toDateTs = end.getTime();
        } else if (filtro === "6m") {
        let monthStart = today.getMonth() - 5;
        let yearStart = today.getFullYear(); while (monthStart < 0) { yearStart--; monthStart += 12; }
        const start = new Date(yearStart, monthStart, 1, 0, 0, 0, 0);
        fromDateTs = start.getTime(); toDateTs = end.getTime();
        } else {
        const start = new Date(today.getFullYear(), 0, 1, 0, 0, 0, 0);
        fromDateTs = start.getTime(); toDateTs = end.getTime();
        }

        let validData = (allMoodsData||[]).filter(x =>
        [1,2,3,4,5].includes(x.estadoMood) &&
        x.fechaTs && !isNaN(x.fechaTs)
        );

        let filtrados = validData.filter(x => x.fechaTs >= fromDateTs && x.fechaTs <= toDateTs);

        lastFilteredCount = filtrados.length;
        updateMoodCountLegend(lastFilteredCount);
        renderMoodCards(filtrados);
        renderMoodChart(filtrados);
        }

        function updateMoodCountLegend(count){
        let legendSpan = document.getElementById("moodCountLegend");
        legendSpan.textContent = `${count} registro${count === 1 ? "" : "s"} mostrado${count === 1 ? "" : "s"} en el rango`;
        }

        function renderMoodCards(data){
        const moodCards=document.getElementById("moodCards");
        moodCards.innerHTML = "";
        if (!Array.isArray(data) || data.length === 0) {
        moodCards.innerHTML = `<div class="text-muted text-center p-4">No hay registros de ánimo en este rango.</div>`;
        updateMoodCountLegend(0);
        renderMoodChart([]);
        return;
        }
        const sorted = data.slice().sort((a, b) => b.fechaTs - a.fechaTs);
        let gridHtml = "";
        for (let i = 0; i < sorted.length; i++) {
        gridHtml += agregarMoodCard(sorted[i]);
        }
        moodCards.innerHTML = gridHtml;
        }

        function renderMoodChart(data){
        const isMobile = (Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0) <= 750);
        let toPlot = Array.isArray(data) ? data.slice() : [];

        if (isMobile) {
        const w3 = getLast3Window();
        const last3 = toPlot.filter(n => n.fechaTs >= w3.startMs && n.fechaTs <= w3.endMs);
        const collapsed = collapseToLastPerDay(last3);
        toPlot = collapsed.sort((a,b) => a.fechaTs - b.fechaTs);
        } else {
        toPlot = toPlot.sort((a,b) => a.fechaTs - b.fechaTs);
        }

        const canvas = document.getElementById("moodChart");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        if (windowChart) try { windowChart.destroy(); } catch(e){}

        const labels = toPlot.map(x => {
        const d = new Date(x.fechaTs);
        return d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
        });
        const dataNum = toPlot.map(x => moodNumFromStr(x.estadoMood));
        const colors  = toPlot.map(x => moodPointColorFromNum(x.estadoMood));

        const isMobileChart = isMobile;
        const pointRadius = isMobileChart ? 10 : 13;
        const pointHoverRadius = isMobileChart ? 14 : 19;
        const borderWidth = isMobileChart ? 1.5 : 2;

        windowChart = new Chart(ctx, {
        type: 'line',
        data: {
        labels: labels,
        datasets: [{
        label: "Estado de ánimo",
        data: dataNum,
        backgroundColor: colors,
        borderColor: "#3498db",
        borderWidth: borderWidth,
        pointBackgroundColor: colors,
        pointRadius: pointRadius,
        pointBorderColor: colors,
        pointHoverRadius: pointHoverRadius,
        pointStyle: 'circle',
        fill: false,
        tension: 0.3
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display:false },
        tooltip: {
        callbacks: {
        title: function(ctxArr) {
        if (!ctxArr || !ctxArr.length) return '';
        const idx = ctxArr[0].dataIndex;
        return new Date(toPlot[idx].fechaTs).toLocaleString('es-ES', { weekday:'short', day:'2-digit', month:'short' });
        },
        label: function(ctx){
        const idx = ctx.dataIndex;
        const entry = toPlot[idx];
        const label = moodLabelFromNum(ctx.raw);
        const time = entry && entry.fechaTs ? new Date(entry.fechaTs).toLocaleTimeString('es-ES', {hour:'2-digit',minute:'2-digit'}) : '';
        return (label ? label + (time ? ' — ' + time : '') : ctx.raw);
        },
        afterBody: function(ctxArr) {
        const idx = ctxArr && ctxArr[0] && ctxArr[0].dataIndex;
        const entry = toPlot[idx];
        let lines = [];
                                    
        if (entry && (entry.texto || entry.Texto)) {
        lines.push('"' + (entry.texto || entry.Texto) + '"');
        }
                                    
        const condicion = entry && (entry.Condicion || entry.condicion);
        if (condicion && (condicion.Nombre || condicion.nombre)) {
        lines.push('Condición: ' + (condicion.Nombre || condicion.nombre));
        }
                                    
        const sintoma = entry && (entry.Sintoma || entry.sintoma);
        if (sintoma && (sintoma.Nombre || sintoma.nombre)) {
        lines.push('Síntoma: ' + (sintoma.Nombre || sintoma.nombre));
        }
                                    
        const tratamiento = entry && (entry.Tratamiento || entry.tratamiento);
        if (tratamiento && (tratamiento.Nombre || tratamiento.nombre)) {
        lines.push('Tratamiento: ' + (tratamiento.Nombre || tratamiento.nombre));
        }
                                    
        return lines;
        }
        }
        }
        },
        scales: {
        x: {
        ticks: {
        autoSkip: true,
        maxTicksLimit: isMobileChart ? 3 : 7,
        font: { size: isMobileChart ? 10 : 12 }
        },
        grid: { display: false }
        },
        y: {
        min: 1, max: 5.43,
        suggestedMin: 0.8,
        suggestedMax: 5.4,
        stepSize: 1,
        beginAtZero: false,
        ticks: {
        callback: function(v) {
        if (v === 5) return "Muy bien";
        if (v === 4) return "Bien";
        if (v === 3) return "Neutral";
        if (v === 2) return "Mal";
        if (v === 1) return "Muy mal";
        return "";
        },
        font: { size: isMobileChart ? 10 : 12 }
        }
        }
        },
        layout: {
        padding: {top: isMobileChart ? 20 : 50, bottom: 10, left:10, right:10}
        }
        }
        });
        }

        async function eliminarMood(id){
        if (!id) return;
        if (!confirm('¿Eliminar este estado de ánimo? Esta acción lo ocultará (soft-delete).')) return;
        try {
        const res = await fetch(`/api/EstadoAnimoUsuario/eliminar/${id}`, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        credentials: 'same-origin'
        });
        if (res.ok) {
        await cargarHistorialEstadoAnimo();
        const activeBtn = document.querySelector('.mood-filter-btn.active');
        if (activeBtn) aplicarFiltroMood(activeBtn.dataset.filter || '1m');
        try { window.dispatchEvent(new CustomEvent('mood:deleted', { detail: { id: id } })); } catch(e){}
        } else {
        const body = await res.json().catch(()=>null);
        alert(body && body.error ? body.error : 'Error al eliminar el estado de ánimo.');
        }
        } catch (e) {
        console.error(e);
        alert('Error al eliminar el estado de ánimo.');
        }
        }
    </script>
}