@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioSintomasSeguimientoModel
@{
    ViewData["Title"] = "Seguimiento de mis síntomas";
    Layout = "_Layout";
    var diasSemana = Model.DiasSemana;
    var hoy = Model.Hoy;
    var ayer = Model.Ayer;
    var descripcionPagina = "Aquí puedes registrar y analizar cómo evolucionan tus síntomas día a día.";
    var badgeColors = new Dictionary<string, string> {
        { "Ninguno", "#E6E6EB" },
        { "Leve", "#B6C2D7" },
        { "Moderado", "#FFD121" },
        { "Severo", "#FF8A65" },
        { "Extremo", "#D32F2F" }
    };
    var estadosTracking = new List<(string val, string label, string color)> {
        ("Ninguno", "Ninguno", "#E6E6EB"),
        ("Leve", "Leve", "#B6C2D7"),
        ("Moderado", "Moderado", "#FFD121"),
        ("Severo", "Severo", "#FF8A65"),
        ("Extremo", "Extremo", "#D32F2F")
    };

    // Strings for selector use in responsive CSS (server-rendered values)
    var hoyAttr = hoy.ToString("yyyy-MM-dd");
    var ayerAttr = ayer.ToString("yyyy-MM-dd");
}

<style>

    .crm-info-block {
        background: #f7f9fd;
        border-radius: 19px !important;
        box-shadow: 0 2px 10px 0 rgba(50,65,120,0.07);
        border: none !important;
        padding: 1.2rem 1.8rem .9rem 1.8rem;
        margin-bottom: 16px;
        font-size: 1.07em;
        color: #4f5871;
    }

    .crm-table-block {
        background: #fff;
        border-radius: 29px !important;
        box-shadow: 0 9px 36px 0 rgba(50,65,120,0.08);
        border: none !important;
        padding: 2.3rem 2.6rem 1.9rem 2.6rem !important;
        margin-bottom: 15px;
    }

    .crm-table-title {
        font-size: 1.38rem;
        font-weight: 600;
        color: #315686;
        margin-bottom: .9em;
        letter-spacing: -0.02em;
    }

    .crm-table-seguimiento {
        width: 100%;
        border-radius: 18px;
        overflow: hidden;
        background: #f8fafc;
        box-shadow: 0 1px 8px #e5e8ef1a;
    }

        .crm-table-seguimiento th,
        .crm-table-seguimiento td {
            font-size: 1em;
            padding: 14px 9px;
            vertical-align: top;
        }

            .crm-table-seguimiento th.bg-light {
                background: #f6f6fe !important;
                color: #3b426c;
                font-weight: 500;
            }

            .crm-table-seguimiento th.bg-warning {
                background: #fff7dc !important;
                color: #6f571b;
                font-weight: 700;
            }

            .crm-table-seguimiento td.text-nowrap {
                max-width: 180px;
                white-space: nowrap;
            }

            .crm-table-seguimiento td.wrap-condiciones {
                max-width: 220px;
                white-space: normal !important;
                word-break: break-word;
                font-size: 1em;
                line-height: 1.02em;
            }

        .crm-table-seguimiento td {
            background: #fff;
        }

    .crm-circle-tracking {
        display: inline-block;
        border-radius: 50%;
        width: 19px;
        height: 19px;
        margin-right: 1px;
        box-shadow: 0 1px 4px #ccd1ea3a;
        border: 2px solid #f3f4f8;
        vertical-align: middle;
        cursor: pointer;
    }

    .crm-tracking-legenda-row {
        display: flex;
        flex-direction: row;
        gap: 28px;
        margin-bottom: 11px;
        align-items: center;
        flex-wrap: wrap;
    }

    .crm-tracking-legenda-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 1.02em;
        font-weight: 500;
        color: #315686;
    }

    .btn.btn-outline-gray.btn-sm.btn-agregar-tracking-matriz {
        border-radius: 9px !important;
        padding: 4px 10px !important;
        font-size: 1.08em !important;
        border: 1.5px solid #E0E3EA !important;
        background: #f8fafc;
        color: #686D7F !important;
    }

    .wrap-condiciones {
        max-width: 220px;
    }

    /* ---------- Responsive adjustments (only affect small screens) ---------- */
    /* For mobile we show only Ayer and Hoy columns, remove Conditions column, and remove bold from symptom names */
    @@media (max-width: 750px) {

        .crm-container {
            max-width: 98vw;
            padding: 0;
        }

        .crm-table-block {
            padding: 1.2rem 0.6rem 1.1rem 0.6rem;
        }

        .crm-title {
            font-size: 1.24rem;
        }

        .crm-table-title {
            font-size: 1.15rem;
        }

        .crm-info-block {
            font-size: .97em;
        }
        /* Reduce padding and font sizes inside table for mobile */
        .crm-table-seguimiento th, .crm-table-seguimiento td {
            padding: 10px 8px;
            font-size: .95rem;
        }
        /* Hide ALL day columns by default (those with data-dia), then show only ayer and hoy */
        .crm-table-seguimiento thead th[data-dia],
        .crm-table-seguimiento tbody td[data-dia] {
            display: none !important;
            visibility: collapse !important;
            width: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        /* Show only ayer and hoy columns (server values injected) */
        .crm-table-seguimiento thead th[data-dia="@ayerAttr"],
        .crm-table-seguimiento thead th[data-dia="@hoyAttr"],
        .crm-table-seguimiento tbody td[data-dia="@ayerAttr"],
        .crm-table-seguimiento tbody td[data-dia="@hoyAttr"] {
            display: table-cell !important;
            visibility: visible !important;
            width: auto !important;
            padding: 10px 8px !important;
        }
        /* Hide the Condiciones column entirely on mobile */
        .crm-table-seguimiento th.cond-col,
        .crm-table-seguimiento td.cond-col {
            display: none !important;
        }
        /* Symptoms column: remove bold and allow wrapping */
        .crm-table-seguimiento tbody td:first-child,
        .crm-table-seguimiento thead th:first-child {
            white-space: normal !important;
            overflow-wrap: anywhere;
            font-weight: 400 !important;
            max-width: 55%;
        }
        /* Ensure small icons/buttons center properly */
        .crm-table-seguimiento td.text-center {
            text-align: center !important;
        }
        /* Make buttons slightly smaller on mobile */
        .btn.btn-outline-gray.btn-sm.btn-agregar-tracking-matriz {
            font-size: .95rem !important;
            padding: 3px 8px !important;
        }
        /* Prevent table from forcing horizontal scroll; allow smooth auto scroll if needed */
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
    }

    @@media (max-width: 900px) {
        .crm-container {
            max-width: 98vw;
            padding: 0;
        }
    }

    @@media (max-width: 750px) {
        .crm-table-seguimiento td.wrap-condiciones {
            max-width: 98vw;
        }
    }

</style>
<div class="container py-4">
    <h1 class="crm-title mb-4">Seguimiento semanal de síntomas</h1>
    <div class="condiciones-paginacion" aria-label="Paginación">
        <span> @descripcionPagina</span>
    </div>
    <div class="crm-table-block">
        <div class="crm-table-title">Matriz de síntomas y seguimiento</div>
        <div class="crm-tracking-legenda-row">
            @foreach (var estado in estadosTracking)
            {
                <span class="crm-tracking-legenda-item">
                    <span class="crm-circle-tracking" style="background:@estado.color;" title="@estado.label" alt="@estado.label"></span>@estado.label
                </span>
            }
        </div>
        <div class="table-responsive">
            <table class="crm-table-seguimiento table table-bordered table-sm align-middle text-center">
                <thead>
                    <tr>
                        <th class="bg-light text-nowrap">Síntoma</th>
                        <th class="bg-light text-nowrap" style="min-width:110px;"
                            title="Basado en la evolución del síntoma durante el período (no solo el último día)">Tendencia</th>
                        @foreach (var dia in diasSemana)
                        {
                            var esHoy = (dia.Date == hoy.Date);
                            var esAyer = (dia.Date == ayer.Date);
                            var bgClass = (esHoy || esAyer) ? "bg-warning bg-opacity-25" : "bg-light";
                            <th class="@bgClass small date-col" data-dia="@dia.ToString("yyyy-MM-dd")" style="min-width:56px;">
                                @dia.ToString("dd/MM")<br /><span class="text-muted">@dia.ToString("ddd")</span>
                                @if (esHoy)
                                {
                                    <div class="small fw-bold text-warning">HOY</div>
                                }
                                else if (esAyer)
                                {
                                    <div class="small fw-bold text-warning">AYER</div>
                                }
                            </th>
                        }
                        <th class="bg-light text-nowrap cond-col">Condiciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sint in Model.Sintomas)
                    {
                        <tr>
                            <td class="text-start" style="vertical-align: middle;">@sint.Nombre</td>
                            @{
                                Model.TendenciasPorSintoma.TryGetValue(sint.Nombre.Trim(), out var trend);
                                var tendTxt = trend?.Tendencia ?? "Sin datos suficientes";
                                var (tendDotClass, tendTextClass, tendShort) = tendTxt switch
                                {
                                    "Empeorando" => ("tendencia-empeorando", "text-empeorando", "Empeorando"),
                                    "Mejorando"  => ("tendencia-mejorando",  "text-mejorando",  "Mejorando"),
                                    "Estable"    => ("tendencia-estable",    "text-estable",    "Estable"),
                                    _            => ("tendencia-sin",        "text-sin",        "Sin datos")
                                };
                            }
                            <td class="text-nowrap"
                                title="Basado en la evolución del síntoma durante el período (no solo el último día)">
                                <span class="tendencia-cell">
                                    <span class="tendencia-dot @tendDotClass"></span>
                                    <span class="tendencia-label @tendTextClass">@tendShort</span>
                                </span>
                            </td>
                            @foreach (var dia in diasSemana)
                            {
                                var key = dia.ToString("yyyy-MM-dd");
                                var esHoy = (dia.Date == hoy.Date);
                                var esAyer = (dia.Date == ayer.Date);
                                var diaTrack = sint.SeguimientoPorDia.ContainsKey(key) ? sint.SeguimientoPorDia[key] : new eiibd26.Areas.Identity.Pages.Usuario.UsuarioSintomasSeguimientoModel.DiaTracking();
                                var seguimiento = diaTrack.Estado;
                                var esFuturo = dia.Date > hoy;
                                var cellClass = $"matrix-cell-{sint.Id}-{dia.ToString("yyyyMMdd")}";
                                <td class="@cellClass @(esHoy || esAyer ? "bg-warning bg-opacity-25" : "") text-center"
                                    data-nombre="@sint.Nombre"
                                    data-dia="@key"
                                    data-sintid="@sint.Id"
                                    data-tipo="@sint.TipoSintoma"
                                    data-dolor="@(diaTrack.Dolor?.ToString() ?? "")"
                                    data-sangrado="@(diaTrack.TieneSangrado.HasValue ? (diaTrack.TieneSangrado.Value ? "true" : "false") : "")"
                                    data-frecuencia="@(diaTrack.FrecuenciaId?.ToString() ?? "")">
                                    @if (!string.IsNullOrEmpty(seguimiento))
                                    {
                                        string color = badgeColors.ContainsKey(seguimiento) ? badgeColors[seguimiento] : "#E6E6EB";
                                        <span class="crm-circle-tracking"
                                              style="background:@color;"
                                              alt="@seguimiento"
                                              title="@seguimiento"></span>
                                    }
                                    else if ((esHoy || esAyer) && !esFuturo)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-gray btn-sm btn-agregar-tracking-matriz"
                                                data-sintid="@sint.Id"
                                                data-dia="@dia.ToString("yyyy-MM-dd")"
                                                data-nombre="@sint.Nombre"
                                                data-tipo="@sint.TipoSintoma"
                                                title="Agregar seguimiento"
                                                tabindex="0">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    }
                                    else if (!esFuturo)
                                    {
                                        <span class="text-muted" style="font-size:small;">-</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:small;"> </span>
                                    }
                                </td>
                            }
                            <td class="wrap-condiciones small text-muted cond-col">@string.Join(", ", sint.Condiciones)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- MODAL TRACKING PARA MATRIZ -->
<div class="modal fade" id="modalTrackingMatriz" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="crm-modal-content modal-content">
            <form id="formTrackingMatriz">
                @Html.AntiForgeryToken()
                <div class="crm-modal-header modal-header">
                    <h5 class="crm-modal-title modal-title" id="tituloTrackingMatriz"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="crm-modal-body modal-body">
                    <div id="mensajeTrackingMatriz" class="alert alert-success py-2 px-3 small mb-2 d-none">
                        <i class="bi bi-check-circle-fill me-1"></i> Seguimiento agregado
                    </div>
                    <div class="mb-2 fw-semibold" id="preguntaTrackingMatriz"></div>
                    <div id="opcionesTrackingMatriz" class="crm-tracking-opciones-btns d-flex flex-column gap-2">
                        <!-- Opciones por JS -->
                    </div>
                    <!-- Dolor (solo TipoSintoma 1=Medible o 2=Dolor) -->
                    <div id="trackDolorContainerMatriz" class="mt-3" style="display:none;">
                        <label class="crm-label mb-1" for="trackDolorMatriz">
                            Dolor <span class="text-muted small">(opcional)</span>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="range" class="form-range flex-grow-1" id="trackDolorMatriz"
                                   min="0" max="10" step="1" value="0" />
                            <span id="trackDolorValorMatriz" class="fw-semibold" style="min-width:1.5rem;text-align:center;">0</span>
                            <span class="text-muted small">/10</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted" style="font-size:.75rem;">Sin dolor</span>
                            <span class="text-muted" style="font-size:.75rem;">Máximo</span>
                        </div>
                    </div>
                    <!-- Sangrado (solo TipoSintoma 1=Medible) -->
                    <div id="trackSangradoContainerMatriz" class="mt-3 align-items-center gap-3" style="display:none;">
                        <label class="crm-label mb-0" for="trackSangradoMatriz">Sangrado</label>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="trackSangradoMatriz" style="width:2.5em;height:1.3em;" />
                            <label class="form-check-label text-muted small" for="trackSangradoMatriz" id="trackSangradoLabelMatriz">No</label>
                        </div>
                    </div>
                    <!-- Frecuencia (solo TipoSintoma 1=Medible) -->
                    <div id="trackFrecuenciaContainerMatriz" class="mt-3" style="display:none;">
                        <label class="crm-label mb-1" for="trackFrecuenciaMatriz">
                            Frecuencia del síntoma <span class="text-muted small">(opcional)</span>
                        </label>
                        <select id="trackFrecuenciaMatriz" class="form-select form-select-sm">
                            <option value="">— Sin especificar —</option>
                            @foreach (var f in Model.FrecuenciasCatalog)
                            {
                                <option value="@f.Id">@f.Nombre</option>
                            }
                        </select>
                        <div class="form-text">Frecuencia aproximada del síntoma durante el día</div>
                    </div>
                </div>
                <div class="crm-modal-footer modal-footer">
                    <button type="button" id="btnGuardarTrackingMatriz" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
                <input type="hidden" id="sintomaIdTrackingMatriz" />
                <input type="hidden" id="fechaTrackingMatriz" />
                <input type="hidden" id="nombreSintomaTrackingMatriz" />
                <input type="hidden" id="tipoSintomaTrackingMatriz" value="0" />
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const opcionesTracking = [
                { val: "Ninguno", label: "Ninguno", color: "#E6E6EB" },
                { val: "Leve", label: "Leve", color: "#B6C2D7" },
                { val: "Moderado", label: "Moderado", color: "#FFD121" },
                { val: "Severo", label: "Severo", color: "#FF8A65" },
                { val: "Extremo", label: "Extremo", color: "#D32F2F" }
            ];

            // Add click event to each crm-circle-tracking in matrix for edit modal
            function addCircleEditEvent() {
                document.querySelectorAll('td .crm-circle-tracking').forEach(function(circle) {
                    const td = circle.closest('td');
                    if (td && !td.classList.contains('disabled-edit')) {
                        td.onclick = function () {
                            const sintId      = td.getAttribute('data-sintid');
                            const fechaTrack  = td.getAttribute('data-dia');
                            const nombreSintoma = td.getAttribute('data-nombre');
                            const tipo        = td.getAttribute('data-tipo') || 0;
                            const dolor       = td.getAttribute('data-dolor') || '';
                            const sangrado    = td.getAttribute('data-sangrado') || '';
                            const frecuencia  = td.getAttribute('data-frecuencia') || '';
                            const estado      = circle.getAttribute('alt');
                            abrirModalTrackingMatriz(sintId, fechaTrack, nombreSintoma, estado, tipo, dolor, sangrado, frecuencia);
                        };
                        td.classList.add('disabled-edit');
                    }
                });
            }

            function resetTrackingButtons() {
                setTimeout(function() {
                    const trackBtns = document.querySelectorAll('.btn-opcion-track-matriz');
                    trackBtns.forEach(btnOpcion => {
                        btnOpcion.disabled = false;
                        btnOpcion.style.pointerEvents = 'auto';
                        btnOpcion.onclick = function () {
                            // Only highlight selection; actual save happens on Guardar button
                            trackBtns.forEach(b => b.classList.remove('active'));
                            this.classList.add('active');
                        };
                    });
                }, 80);
            }

            // Muestra/oculta campos clínicos según TipoSintoma (0=Subjetivo: Estado+Dolor, 1=Medible: Estado+Dolor+Sangrado+Frecuencia)
            function toggleCamposMatriz(tipo) {
                const tipoNum = parseInt(tipo) || 0;
                const dolorEl = document.getElementById('trackDolorContainerMatriz');
                const sangEl  = document.getElementById('trackSangradoContainerMatriz');
                const frecEl  = document.getElementById('trackFrecuenciaContainerMatriz');
                dolorEl.style.display = '';
                sangEl.style.display  = (tipoNum === 1) ? 'flex' : 'none';
                frecEl.style.display  = (tipoNum === 1) ? '' : 'none';
            }

            function abrirModalTrackingMatriz(sintId, fecha, nombreSintoma, estadoActual, tipo, dolor, sangrado, frecuencia) {
                tipo = tipo || 0;
                document.getElementById('sintomaIdTrackingMatriz').value = sintId;
                document.getElementById('fechaTrackingMatriz').value = fecha;
                document.getElementById('nombreSintomaTrackingMatriz').value = nombreSintoma;
                document.getElementById('tipoSintomaTrackingMatriz').value = tipo;
                document.getElementById('mensajeTrackingMatriz').classList.add('d-none');
                document.getElementById('mensajeTrackingMatriz').classList.remove('alert-danger');
                document.getElementById('mensajeTrackingMatriz').textContent = 'Seguimiento agregado';
                document.getElementById('tituloTrackingMatriz').innerText = "Seguimiento de síntoma";
                const fechaObj = new Date(fecha + "T12:00:00");
                const fechaTxt = `${fechaObj.getDate().toString().padStart(2, "0")}/${(fechaObj.getMonth()+1).toString().padStart(2,"0")}/${fechaObj.getFullYear()}`;
                document.getElementById('preguntaTrackingMatriz').innerText = `¿Cómo estuvo "${nombreSintoma}" el ${fechaTxt}?`;
                let html = '';
                opcionesTracking.forEach(o => {
                    let active = (o.val === estadoActual) ? "active" : "";
                    html += `<button type="button" class="btn btn-outline-primary w-100 btn-opcion-track-matriz ${active}" data-estado="${o.val}" style="display:flex;align-items:center;gap:10px;">
                        <span class="crm-circle-tracking" style="background:${o.color};"></span> ${o.label}
                    </button>`;
                });
                document.getElementById('opcionesTrackingMatriz').innerHTML = html;
                toggleCamposMatriz(tipo);
                // Restaurar valores guardados
                const dolorEl = document.getElementById('trackDolorMatriz');
                if (dolorEl) {
                    const dolorVal = (dolor !== '' && dolor !== null && dolor !== undefined) ? parseInt(dolor) : 0;
                    dolorEl.value = dolorVal;
                    document.getElementById('trackDolorValorMatriz').textContent = dolorVal;
                }
                const sangEl = document.getElementById('trackSangradoMatriz');
                if (sangEl) {
                    const sangVal = sangrado === 'true';
                    sangEl.checked = sangVal;
                    document.getElementById('trackSangradoLabelMatriz').textContent = sangVal ? 'Sí' : 'No';
                }
                const frecEl = document.getElementById('trackFrecuenciaMatriz');
                if (frecEl) frecEl.value = frecuencia || '';
                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalTrackingMatriz'));
                modal.show();
                resetTrackingButtons();
            }

            document.querySelectorAll('.btn-agregar-tracking-matriz').forEach(btn => {
                btn.addEventListener('click', function () {
                    var sintId = this.dataset.sintid;
                    var fecha = this.dataset.dia;
                    var nombreSintoma = this.dataset.nombre;
                    var tipo = this.dataset.tipo || 0;
                    abrirModalTrackingMatriz(sintId, fecha, nombreSintoma, "", tipo, '', '', '');
                });
            });

            addCircleEditEvent();

            document.getElementById('modalTrackingMatriz').addEventListener('shown.bs.modal', function () {
                resetTrackingButtons();
            });

            // Guardar button: do POST with all current field values
            document.getElementById('btnGuardarTrackingMatriz')?.addEventListener('click', async function () {
                const activeBtn = document.querySelector('#opcionesTrackingMatriz .btn-opcion-track-matriz.active');
                if (!activeBtn) {
                    alert('Por favor selecciona un estado antes de guardar.');
                    return;
                }
                const estado = activeBtn.dataset.estado;
                const sintomaUsuarioId = document.getElementById('sintomaIdTrackingMatriz').value;
                const fechaTrack = document.getElementById('fechaTrackingMatriz').value;
                const nombreSintoma = document.getElementById('nombreSintomaTrackingMatriz').value;

                this.disabled = true;
                let formData = new FormData();
                const aftToken = document.querySelector('#formTrackingMatriz input[name="__RequestVerificationToken"]')?.value;
                if (aftToken) formData.append('__RequestVerificationToken', aftToken);
                formData.append('sintomaUsuarioId', sintomaUsuarioId);
                formData.append('estado', estado);
                formData.append('fecha', fechaTrack);
                const dolorCont = document.getElementById('trackDolorContainerMatriz');
                const sangCont  = document.getElementById('trackSangradoContainerMatriz');
                const frecCont  = document.getElementById('trackFrecuenciaContainerMatriz');
                if (dolorCont && dolorCont.style.display !== 'none') {
                    const dolorVal = document.getElementById('trackDolorMatriz')?.value;
                    if (dolorVal !== undefined) formData.append('dolor', dolorVal);
                }
                if (sangCont && sangCont.style.display !== 'none') {
                    const sangVal = document.getElementById('trackSangradoMatriz')?.checked ? 'true' : 'false';
                    formData.append('tieneSangrado', sangVal);
                }
                if (frecCont && frecCont.style.display !== 'none') {
                    const frecVal = document.getElementById('trackFrecuenciaMatriz')?.value;
                    if (frecVal) formData.append('frecuenciaId', frecVal);
                }

                let resp = await fetch('?handler=TrackSintomaMatriz', { method: 'POST', body: formData });
                this.disabled = false;
                if (resp.ok) {
                    let fechaCellId = fechaTrack.replace(/-/g, "");
                    let cellClass = '.matrix-cell-' + sintomaUsuarioId + '-' + fechaCellId;
                    let celdas = document.querySelectorAll(cellClass);
                    let colorMap = {
                        "Ninguno": "#E6E6EB", "Leve": "#B6C2D7", "Moderado": "#FFD121",
                        "Severo": "#FF8A65", "Extremo": "#D32F2F"
                    };
                    let bgStyle = colorMap[estado] || "#E6E6EB";
                    const tipoGuardado  = document.getElementById('tipoSintomaTrackingMatriz')?.value || '0';
                    const dolorGuardado = document.getElementById('trackDolorMatriz')?.value || '';
                    const sangGuardado  = document.getElementById('trackSangradoMatriz')?.checked ? 'true' : 'false';
                    const frecGuardada  = document.getElementById('trackFrecuenciaMatriz')?.value || '';
                    celdas.forEach(celda => {
                        celda.innerHTML = `<span class="crm-circle-tracking" style="background:${bgStyle};" alt="${estado}" title="${estado}"></span>`;
                        celda.setAttribute('data-tipo',      tipoGuardado);
                        celda.setAttribute('data-dolor',     dolorGuardado);
                        celda.setAttribute('data-sangrado',  sangGuardado);
                        celda.setAttribute('data-frecuencia', frecGuardada);
                        celda.onclick = function() {
                            abrirModalTrackingMatriz(sintomaUsuarioId, fechaTrack, nombreSintoma, estado, tipoGuardado, dolorGuardado, sangGuardado, frecGuardada);
                        };
                    });
                    addCircleEditEvent();
                    bootstrap.Modal.getInstance(document.getElementById('modalTrackingMatriz'))?.hide();
                } else {
                    let msg = document.getElementById('mensajeTrackingMatriz');
                    msg.classList.remove('d-none');
                    msg.classList.add('alert-danger');
                    msg.textContent = 'Error guardando seguimiento. Intenta nuevamente';
                    setTimeout(() => {
                        msg.classList.add('d-none');
                        msg.classList.remove('alert-danger');
                        msg.textContent = 'Seguimiento agregado';
                    }, 2000);
                }
            });

            // Slider label update
            const dolorSlider = document.getElementById('trackDolorMatriz');
            if (dolorSlider) {
                dolorSlider.addEventListener('input', function() {
                    document.getElementById('trackDolorValorMatriz').textContent = this.value;
                });
            }
            const sangSwitch = document.getElementById('trackSangradoMatriz');
            if (sangSwitch) {
                sangSwitch.addEventListener('change', function() {
                    document.getElementById('trackSangradoLabelMatriz').textContent = this.checked ? 'Sí' : 'No';
                });
            }
        });
    </script>
}