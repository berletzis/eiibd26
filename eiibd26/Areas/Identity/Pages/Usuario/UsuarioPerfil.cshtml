@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioPerfilModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Perfil de Usuario";
}
@section Styles {
    <link rel="stylesheet" href="~/css/avatar-card.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }

        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }

        .perfil-title {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #172849;
            margin-bottom: .7em;
        }

        .card-row {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
        }

        .card-block-modern {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 6px 30px rgba(50,65,120,0.07);
            border: none;
            padding: 2.1rem 2.2rem 1.8rem;
            margin-bottom: 36px;
            flex: 1 1 0px;
        }

        .block-title {
            font-size: 1.38rem;
            font-weight: 600;
            margin-bottom: 19px;
            color: #305586;
            letter-spacing: -.02em;
        }

        .form-col {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .form-row {
            display: flex;
            gap: 16px;
            align-items: center;
        }

            .form-row .form-col {
                width: 100%;
            }

        .form-col-sm {
            flex: 0 0 45%;
        }

        .form-col-lg {
            flex: 1 0 55%;
        }

        .card-block-modern input.form-control, .card-block-modern textarea.form-control, .card-block-modern select.form-select {
            border-radius: 8px;
            border: 1px solid #dde6f1;
            background: #f8fafd;
            font-size: 1.07em;
        }

        .card-block-modern input[type="checkbox"] {
            margin-right: 10px;
            height: 20px;
            width: 20px;
            accent-color: #1e88e5;
        }

        .avatar-perfil-box img {
            width: 110px;
            height: 110px;
            border-radius: 70px;
            box-shadow: 0 2px 13px #cad6ea54;
            border: 2px solid #b4d3ee;
            object-fit: cover;
            display: block;
            margin: 0 auto;
        }

        .perfil-label {
            font-size: 1.07em;
            font-weight: 500;
            color: #375586;
        }

        .form-text-error {
            color: #c92a2a;
            font-size: 0.97em;
            margin-left: 3px;
        }

        .readonly-label {
            background: #f8fafd;
            border-radius: 6px;
            border: 1px solid #dde6f1;
            padding: 7px 10px;
            font-size: 1.05em;
            color: #1e355e;
            min-height: 37px;
        }

        .form-check-label {
            font-size: 1.05em;
            color: #305586;
        }

        input[type="hidden"] {
            display: none !important;
        }

        .avatar-controls-row {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-top: 12px;
            justify-content: center;
        }

        .btn-loading {
            opacity: 0.7;
            pointer-events: none;
        }

        @@media (max-width: 900px) {
            .crm-container-admin {
                max-width: 98vw;
            }

            .card-row {
                flex-direction: column;
                gap: 24px;
            }

            .card-block-modern {
                padding: 1.1rem 0.7rem 1.0rem 0.7rem;
            }

            .form-row {
                flex-direction: column;
            }

            .form-col-sm, .form-col-lg {
                flex: 1 1 100%;
            }
        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="perfil-title mb-4">Perfil de Usuario</h2>

    @* Solo un alert para success, se auto-ocultará con JS *@
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success text-center" role="alert" id="perfil-success-alert">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger text-center" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Perfil != null)
    {
        <form method="post" autocomplete="off" id="perfilForm">
            @Html.AntiForgeryToken()
            <input asp-for="Perfil.idUser" type="hidden" id="Perfil_idUser" />
            <input asp-for="Perfil.Avatar" type="hidden" id="Perfil_AvatarHidden" />

            <!-- Card: Mi Perfil público -->
            <div class="card-block-modern mb-3">
                <h3 class="block-title mb-3"><i class="bi bi-eye"></i> Mi Perfil público</h3>
                <div class="form-row">
                    <div class="form-col-lg">
                        <label class="perfil-label" for="Perfil_slug">Slug público</label>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <input asp-for="Perfil.slug" class="form-control" id="Perfil_slug" placeholder="mi-slug-personal"
                                   data-check-url="@Url.Page(null, null, new { handler = "CheckSlug" }, Request.Scheme)" />
                            <button type="button" id="generate-slug-btn" class="btn btn-outline-primary" data-generate-url="@Url.Page(null, null, new { handler = "GenerateSlug" }, Request.Scheme)">Generar slug</button>
                        </div>
                        <div class="form-text mt-1 text-muted">El slug será parte de la URL pública. Puedes escribir el tuyo o generar uno único automáticamente.</div>
                        <div class="form-text-error mt-1" id="slug-error" style="display:@(ViewData.ModelState.ContainsKey("Perfil.slug") && ViewData.ModelState["Perfil.slug"].Errors.Any() ? "block" : "none")">
                            @if (ViewData.ModelState.ContainsKey("Perfil.slug") && ViewData.ModelState["Perfil.slug"].Errors.Any())
                            {
                                @ViewData.ModelState["Perfil.slug"].Errors.First().ErrorMessage
                            }
                        </div>
                        <div class="form-text text-success mt-1" id="slug-ok" style="display:none;"></div>

                        <div class="mt-2 text-muted">
                            Slug actual: <strong id="slug-current">@Model.Perfil?.slug</strong>
                        </div>
                        <div class="mt-2">
                            URL pública: <a id="slug-preview" href="@(Model.Perfil?.slug != null ? $"{Request.Scheme}://{Request.Host}/u/{Model.Perfil.slug}" : "#")" target="_blank">
                                @(Model.Perfil?.slug != null ? $"{Request.Scheme}://{Request.Host}/u/{Model.Perfil.slug}" : "—")
                            </a>
                        </div>

                        <div class="mt-2" id="slug-suggestion-row" style="display:none;">
                            <span class="text-muted">Sugerencia disponible:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" id="use-suggestion-btn">Usar sugerencia</button>
                            <span id="slug-suggestion" class="ms-2 fw-bold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Avatar block: preview + upload (server centers/crops) -->
            <div class="card-row">
                <div class="card-block-modern" style="flex:0 0 300px;">
                    @* Dentro de Areas/Identity/Pages/Usuario/UsuarioPerfil.cshtml *@
                    @await Html.PartialAsync("_AvatarCard", Model)
                </div>

                <!-- Información General -->
                <div class="card-block-modern" style="flex:1 1 0px;">
                    <h3 class="block-title mb-3"><i class="bi bi-person-badge"></i> Información General</h3>

                    <div class="form-row">
                        <div class="form-col-sm">
                            <label class="perfil-label" asp-for="Perfil.Titulo">Título</label>
                            <input asp-for="Perfil.Titulo" class="form-control" />
                        </div>
                        <div class="form-col-lg">
                            <label class="perfil-label" asp-for="Perfil.Nombre">Nombre</label>
                            <input asp-for="Perfil.Nombre" class="form-control" id="Perfil_Nombre" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Apellidos">Apellidos</label>
                            <input asp-for="Perfil.Apellidos" class="form-control" id="Perfil_Apellidos" />
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.UsoPlataforma">Uso plataforma</label>
                            <input asp-for="Perfil.UsoPlataforma" class="form-control" readonly style="background:#f4f6fa;" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.FechaDeNacimiento">Fecha de nacimiento</label>
                            <input asp-for="Perfil.FechaDeNacimiento" class="form-control" type="date" />
                            <span class="form-text-error d-none" id="fnac-error">La fecha no puede ser futura.</span>
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Genero">Género</label>
                            <select asp-for="Perfil.Genero" asp-items="Model.GenerosList" class="form-select" id="genero-select">
                                <option value="">Selecciona...</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.AcercaDe">Acerca de</label>
                            <textarea asp-for="Perfil.AcercaDe" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Datos para la plataforma -->
            <div class="card-row">
                <div class="card-block-modern">
                    <h3 class="block-title mb-3"><i class="bi bi-geo-alt"></i> Datos para la plataforma</h3>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.NombrePais">País</label>
                            <select asp-for="Perfil.NombrePais" asp-items="Model.PaisesSelectList" class="form-select" id="pais-select">
                                <option value="">Selecciona país...</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.NombreCiudad">Ciudad</label>
                            <input asp-for="Perfil.NombreCiudad" class="form-control" id="ciudad-input" autocomplete="off" />
                            <span class="form-text-error d-none" id="ciudad-error">Debes elegir una ciudad válida.</span>
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirMostrarPais" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirMostrarPais" name="Perfil.PermitirMostrarPais" value="true"
                                       @(Model.Perfil?.PermitirMostrarPais == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirMostrarPais">Permitir que otros usuarios vean de qué país soy</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Telefono">Teléfono</label>
                            <input asp-for="Perfil.Telefono" class="form-control" id="telefono-input" maxlength="14" />
                            <span class="form-text-error d-none" id="telefono-error">Teléfono debe tener 10 dígitos.</span>
                        </div>
                    </div>

                    <div class="form-row mt-1">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirTelefonoReal" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirTelefonoReal" name="Perfil.PermitirTelefonoReal" value="true"
                                       @(Model.Perfil?.PermitirTelefonoReal == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirTelefonoReal">Permitir utilizar teléfono para saber si soy real</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Email">Email</label>
                            <input asp-for="Perfil.Email" class="form-control" id="email-input" />
                            <span class="form-text-error d-none" id="email-error">Ingrese un email válido.</span>
                        </div>
                    </div>

                    <div class="form-row mt-1">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirCorreoNoticias" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirCorreoNoticias" name="Perfil.PermitirCorreoNoticias" value="true"
                                       @(Model.Perfil?.PermitirCorreoNoticias == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirCorreoNoticias">Permitir enviarme correos de notificaciones o noticias</label>
                            </div>
                        </div>
                    </div>

                    <input asp-for="Perfil.Latitud" type="hidden" id="latitud-input" />
                    <input asp-for="Perfil.Longitud" type="hidden" id="longitud-input" />
                </div>
            </div>

            <!-- Estado y Privacidad -->
            <div class="card-block-modern mb-3" style="max-width:700px;margin:0 auto;">
                <h3 class="block-title mb-3"><i class="bi bi-info-circle"></i> Estado y Privacidad</h3>
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.Activo" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_Activo" name="Perfil.Activo" value="true"
                                   @(Model.Perfil?.Activo == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_Activo">Activo</label>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.AceptoPP" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_AceptoPP" name="Perfil.AceptoPP" value="true"
                                   @(Model.Perfil?.AceptoPP == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_AceptoPP">Aceptó Política Privacidad</label>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.Eliminado" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_Eliminado" name="Perfil.Eliminado" value="true"
                                   @(Model.Perfil?.Eliminado == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_Eliminado">Eliminado</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-3 mb-5">
                <button class="btn btn-success" type="submit"><i class="bi bi-save"></i> Guardar Cambios</button>
                <a class="btn btn-secondary ms-2" href="/">Volver</a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger">No se encontró usuario/perfil.</div>
    }
</div>

@section Scripts {
    <!-- Google maps wrapper (unchanged) -->
    <script>
        window.initAutocomplete = function() {
            if (typeof window.initAutocompleteImpl === 'function') {
                window.initAutocompleteImpl();
                return;
            }
            var tries = 0;
            var wait = setInterval(function() {
                tries++;
                if (typeof window.initAutocompleteImpl === 'function') {
                    clearInterval(wait);
                    window.initAutocompleteImpl();
                } else if (tries > 50) { // ~5s timeout
                    clearInterval(wait);
                    console.warn('initAutocompleteImpl not defined after waiting');
                }
            }, 100);
        };
    </script>

    <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBUUBxDv3VvzMmdR_pf9aFOd7frbTeUWXk&libraries=places&callback=initAutocomplete"></script>

    <script>
        // Implementation of autocomplete placed as initAutocompleteImpl (so the wrapper above can call it)
        window.initAutocompleteImpl = function() {
            try {
                var input = document.getElementById('ciudad-input');
                var paisSel = document.getElementById('pais-select');
                var latEl = document.getElementById('latitud-input');
                var lngEl = document.getElementById('longitud-input');
                if (!input || !window.google || !google.maps || !google.maps.places) {
                    console.warn('Google places not available');
                    return;
                }
                var autocomplete = new google.maps.places.Autocomplete(input, { types: ['(cities)'] });

                function sanitizeCountryCode(raw){
                    if(!raw) return "";
                    var token = String(raw).trim().split(/\s|-/)[0];
                    var match = token.match(/[A-Za-z]{2,3}/);
                    return match ? match[0].toLowerCase() : "";
                }

                if (paisSel) {
                    paisSel.addEventListener('change', function(){
                        var code = sanitizeCountryCode(paisSel.value);
                        try {
                            if (code) autocomplete.setComponentRestrictions({country:code});
                            else autocomplete.setComponentRestrictions({});
                        } catch (e) { console.warn('setComponentRestrictions failed', e); }
                        input.value = '';
                        if (latEl) latEl.value = '';
                        if (lngEl) lngEl.value = '';
                    });
                }

                autocomplete.addListener('place_changed', function(){
                    var place = autocomplete.getPlace();
                    if (place && place.geometry && place.geometry.location) {
                        document.getElementById('ciudad-error') && document.getElementById('ciudad-error').classList.add('d-none');
                        if (latEl) latEl.value = place.geometry.location.lat();
                        if (lngEl) lngEl.value = place.geometry.location.lng();
                    } else {
                        if (latEl) latEl.value = '';
                        if (lngEl) lngEl.value = '';
                        document.getElementById('ciudad-error') && document.getElementById('ciudad-error').classList.remove('d-none');
                    }
                });

                console.debug('Places autocomplete initialized');
            } catch (ex) {
                console.error('initAutocompleteImpl error', ex);
            }
        };
    </script>

    <script>
        // slug live-check + generate (unchanged)
        (function(){
            function el(id){return document.getElementById(id);}
            var slugInput = el('Perfil_slug');
            var generateBtn = el('generate-slug-btn');
            var slugOk = el('slug-ok');
            var slugErr = el('slug-error');
            var slugCurrent = el('slug-current');
            var slugPreview = el('slug-preview');
            var suggestionRow = el('slug-suggestion-row');
            var suggestionEl = el('slug-suggestion');
            var useSuggestionBtn = el('use-suggestion-btn');
            var userId = (el('Perfil_idUser') && el('Perfil_idUser').value) ? el('Perfil_idUser').value : '';

            function updatePreview(slug){
                if(!slug){ if(slugPreview){ slugPreview.href = '#'; slugPreview.textContent = '—'; } return; }
                var origin = window.location.origin;
                var url = origin + '/u/' + slug;
                if(slugPreview){ slugPreview.href = url; slugPreview.textContent = url; }
                if(slugCurrent) slugCurrent.textContent = slug;
            }

            if(slugInput){
                updatePreview(slugInput.value);
                var checkUrl = slugInput.dataset.checkUrl;
                var timeout;
                slugInput.addEventListener('input', function(){
                    var val = this.value.trim();
                    updatePreview(val);
                    clearTimeout(timeout);
                    if(!val){ slugOk.style.display='none'; slugErr.style.display='none'; suggestionRow.style.display='none'; return; }
                    timeout = setTimeout(function(){
                        var url = (checkUrl || window.location.pathname + '?handler=CheckSlug') + '&slug=' + encodeURIComponent(val);
                        if(userId) url += '&userId=' + encodeURIComponent(userId);
                        fetch(url, { method:'GET', credentials:'same-origin' })
                            .then(function(resp){ if(!resp.ok) throw new Error('HTTP ' + resp.status); return resp.json(); })
                            .then(function(json){
                                if(json.exists){
                                    slugErr.style.display = 'block';
                                    slugErr.textContent = 'El slug ya está en uso.';
                                    slugOk.style.display = 'none';
                                    if(json.suggestion){
                                        suggestionEl.textContent = json.suggestion;
                                        suggestionRow.style.display = 'block';
                                    }
                                } else {
                                    slugErr.style.display = 'none';
                                    slugOk.style.display = 'block';
                                    slugOk.textContent = 'Slug disponible';
                                    suggestionRow.style.display = 'none';
                                }
                            }).catch(function(e){ console.error('[slug] check error', e); });
                    }, 350);
                });
            }

            if(useSuggestionBtn){
                useSuggestionBtn.addEventListener('click', function(){
                    var s = suggestionEl.textContent;
                    if(s && slugInput){ slugInput.value = s; updatePreview(s); suggestionRow.style.display='none'; slugOk.style.display='block'; slugOk.textContent='Sugerencia aplicada'; slugErr.style.display='none'; }
                });
            }

            if(generateBtn){
                generateBtn.addEventListener('click', function(){
                    var base = slugInput && slugInput.value.trim() ? slugInput.value.trim() : '';
                    if(!base){
                        var nombre = (document.getElementById('Perfil_Nombre') && document.getElementById('Perfil_Nombre').value) || '';
                        var apellidos = (document.getElementById('Perfil_Apellidos') && document.getElementById('Perfil_Apellidos').value) || '';
                        base = (nombre + ' ' + apellidos).trim();
                    }
                    if(!base){ slugErr.style.display='block'; slugErr.textContent='Proporciona un nombre o apellidos para generar el slug.'; slugOk.style.display='none'; return; }
                    slugErr.style.display='none';
                    slugOk.style.display='none';
                    var urlBase = generateBtn.getAttribute('data-generate-url') || window.location.pathname + '?handler=GenerateSlug';
                    var url = urlBase + '&baseText=' + encodeURIComponent(base);
                    fetch(url, { method:'GET', credentials:'same-origin' })
                        .then(function(resp){ if(!resp.ok) throw new Error('HTTP ' + resp.status); return resp.json(); })
                        .then(function(data){
                            if(data && data.slug){
                                if(slugInput) slugInput.value = data.slug;
                                updatePreview(data.slug);
                                slugOk.style.display='block';
                                slugOk.textContent = 'Slug generado: ' + data.slug;
                                slugErr.style.display='none';
                                suggestionRow.style.display='none';
                                suggestionEl.textContent = '';
                            } else {
                                slugErr.style.display='block';
                                slugErr.textContent = 'No se pudo generar slug.';
                                slugOk.style.display='none';
                            }
                        }).catch(function(e){ console.error('[slug] generate error', e); slugErr.style.display='block'; slugErr.textContent='Error al generar slug.'; slugOk.style.display='none'; });
                });
            }
        })();
    </script>

    <!-- Include avatar JS once, at the end of the page -->
    <script src="~/js/avatar-card.js" asp-append-version="true"></script>

    <!-- Auto-hide success alert (3s) -->
    <script>
        (function(){
            try {
                var success = document.getElementById('perfil-success-alert');
                if (success) {
                    setTimeout(function(){
                        success.style.transition = 'opacity 0.45s ease';
                        success.style.opacity = '0';
                        setTimeout(function(){ if (success.parentNode) success.parentNode.removeChild(success); }, 500);
                    }, 3000);
                }
            } catch(e){ console.error(e); }
        })();
    </script>
}