@page "{id?}"
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioPerfilModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Perfil de Usuario";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f5f7fb;
        }
        .crm-container-admin {
            max-width: 1320px;
            margin: 0 auto 30px auto;
            padding-left: 10px;
            padding-right: 10px;
        }
        .perfil-title {
            font-size: 2.08rem;
            font-weight: 600;
            letter-spacing: -0.07em;
            color: #172849;
            margin-bottom: .7em;
        }
        .card-row {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
        }
        .card-block-modern {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 6px 30px 0 rgba(50,65,120,0.07);
            border: none;
            padding: 2.1rem 2.2rem 1.8rem 2.2rem;
            margin-bottom: 36px;
            flex:1 1 0px;
        }
        .block-title {
            font-size: 1.38rem;
            font-weight: 600;
            margin-bottom: 19px;
            color: #305586;
            letter-spacing: -.02em;
        }
        .form-col {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .form-row {
            display: flex;
            gap: 16px;
            align-items: center;
        }
        .form-row .form-col { width: 100%; }
        .form-col-sm { flex: 0 0 45%; }
        .form-col-lg { flex: 1 0 55%; }
        .card-block-modern input.form-control,
        .card-block-modern textarea.form-control,
        .card-block-modern select.form-select {
            border-radius: 8px;
            border: 1px solid #dde6f1;
            background: #f8fafd;
            font-size: 1.07em;
        }
        .card-block-modern input[type="checkbox"] {
            margin-right: 10px;
            height:20px; width:20px;
            accent-color: #1e88e5;
        }
        .avatar-perfil-box img {
            width: 110px;
            height: 110px;
            border-radius: 70px;
            box-shadow: 0 2px 13px #cad6ea54;
            border: 2px solid #b4d3ee;
            object-fit: cover;
        }
        .perfil-label {
            font-size: 1.07em;
            font-weight: 500;
            color: #375586;
        }
        .form-text-error {
            color: #c92a2a;
            font-size: 0.97em;
            margin-left: 3px;
        }
        .readonly-label {
            background: #f8fafd;
            border-radius: 6px;
            border: 1px solid #dde6f1;
            padding: 7px 10px;
            font-size: 1.05em;
            color: #1e355e;
            min-height:37px;
        }
        .form-check-label {
            font-size:1.05em;
            color:#305586;
        }

        /* Ensure hidden inputs don't appear in UI */
        input[type="hidden"] { display:none !important; }

        @@media (max-width: 900px) {
            .crm-container-admin { max-width: 98vw; }
            .card-row { flex-direction: column; gap:24px; }
            .card-block-modern { padding: 1.1rem 0.7rem 1.0rem 0.7rem;}
            .form-row { flex-direction: column; }
            .form-col-sm, .form-col-lg { flex: 1 1 100%;}
        }
    </style>
}

<div class="crm-container-admin">
    <h2 class="perfil-title mb-4">Perfil de Usuario</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success text-center" role="alert">@Model.SuccessMessage</div>
        <div class="text-center text-success mb-3" id="info-actualizada-legend">Información actualizada</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger text-center" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Perfil != null)
    {
        <form method="post" autocomplete="off" id="perfilForm">
            @Html.AntiForgeryToken()
            <input asp-for="Perfil.idUser" type="hidden" />
            <input asp-for="Perfil.Avatar" type="hidden" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <ul>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="card-row">
                <!-- Card 1: Información General -->
                <div class="card-block-modern">
                    <h3 class="block-title mb-3"><i class="bi bi-person-badge"></i> Información General</h3>
                    <div class="mb-3 text-center avatar-perfil-box">
                        <img src="@(string.IsNullOrWhiteSpace(Model.Perfil?.Avatar) ? "https://ui-avatars.com/api/?name=Usuario+Demo&size=110" : Model.Perfil.Avatar)" alt="Avatar" />
                    </div>

                    <div class="form-row">
                        <div class="form-col-sm">
                            <label class="perfil-label" asp-for="Perfil.Titulo">Título</label>
                            <input asp-for="Perfil.Titulo" class="form-control" />
                        </div>
                        <div class="form-col-lg">
                            <label class="perfil-label" asp-for="Perfil.Nombre">Nombre</label>
                            <input asp-for="Perfil.Nombre" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Apellidos">Apellidos</label>
                            <input asp-for="Perfil.Apellidos" class="form-control" />
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.UsoPlataforma">Uso plataforma</label>
                            <input asp-for="Perfil.UsoPlataforma" class="form-control" readonly style="background:#f4f6fa;" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.FechaDeNacimiento">Fecha de nacimiento</label>
                            <input asp-for="Perfil.FechaDeNacimiento" class="form-control" type="date" />
                            <span class="form-text-error d-none" id="fnac-error">La fecha no puede ser futura.</span>
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Genero">Género</label>
                            <select asp-for="Perfil.Genero" asp-items="Model.GenerosList" class="form-select" id="genero-select">
                                <option value="">Selecciona...</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.AcercaDe">Acerca de</label>
                            <textarea asp-for="Perfil.AcercaDe" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Datos para la Plataforma -->
                <div class="card-block-modern">
                    <h3 class="block-title mb-3"><i class="bi bi-geo-alt"></i> Datos para la plataforma</h3>

                    <div class="form-row">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.NombrePais">País</label>
                            <select asp-for="Perfil.NombrePais" asp-items="Model.PaisesSelectList" class="form-select" id="pais-select">
                                <option value="">Selecciona país...</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.NombreCiudad">Ciudad</label>
                            <input asp-for="Perfil.NombreCiudad" class="form-control" id="ciudad-input" autocomplete="off" />
                            <span class="form-text-error d-none" id="ciudad-error">Debes elegir una ciudad válida.</span>
                        </div>
                    </div>

                    <!-- PermitirMostrarPais (hidden + checkbox) -->
                    <div class="form-row mt-2">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirMostrarPais" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirMostrarPais" name="Perfil.PermitirMostrarPais" value="true"
                                       @(Model.Perfil?.PermitirMostrarPais == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirMostrarPais">Permitir que otros usuarios vean de qué país soy</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Telefono">Teléfono</label>
                            <input asp-for="Perfil.Telefono" class="form-control" id="telefono-input" maxlength="14" />
                            <span class="form-text-error d-none" id="telefono-error">Teléfono debe tener 10 dígitos.</span>
                        </div>
                    </div>

                    <!-- PermitirTelefonoReal (hidden + checkbox) -->
                    <div class="form-row mt-1">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirTelefonoReal" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirTelefonoReal" name="Perfil.PermitirTelefonoReal" value="true"
                                       @(Model.Perfil?.PermitirTelefonoReal == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirTelefonoReal">Permitir utilizar teléfono para saber si soy real</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <div class="form-col">
                            <label class="perfil-label" asp-for="Perfil.Email">Email</label>
                            <input asp-for="Perfil.Email" class="form-control" id="email-input" />
                            <span class="form-text-error d-none" id="email-error">Ingrese un email válido.</span>
                        </div>
                    </div>

                    <!-- PermitirCorreoNoticias (hidden + checkbox) -->
                    <div class="form-row mt-1">
                        <div class="form-col">
                            <div class="form-check">
                                <input type="hidden" name="Perfil.PermitirCorreoNoticias" value="false" />
                                <input class="form-check-input" type="checkbox" id="Perfil_PermitirCorreoNoticias" name="Perfil.PermitirCorreoNoticias" value="true"
                                       @(Model.Perfil?.PermitirCorreoNoticias == true ? "checked" : "") />
                                <label class="form-check-label" for="Perfil_PermitirCorreoNoticias">Permitir enviarme correos de notificaciones o noticias</label>
                            </div>
                        </div>
                    </div>

                    <input asp-for="Perfil.Latitud" type="hidden" id="latitud-input" />
                    <input asp-for="Perfil.Longitud" type="hidden" id="longitud-input" />
                </div>
            </div>

            <!-- Card 3: Estado y Privacidad -->
            <div class="card-block-modern mb-3" style="max-width:700px;margin:0 auto;">
                <h3 class="block-title mb-3"><i class="bi bi-info-circle"></i> Estado y Privacidad</h3>
                <div class="form-row">
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.Activo" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_Activo" name="Perfil.Activo" value="true"
                                   @(Model.Perfil?.Activo == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_Activo">Activo</label>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.AceptoPP" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_AceptoPP" name="Perfil.AceptoPP" value="true"
                                   @(Model.Perfil?.AceptoPP == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_AceptoPP">Aceptó Política Privacidad</label>
                        </div>
                    </div>
                    <div class="form-col">
                        <div class="form-check">
                            <input type="hidden" name="Perfil.Eliminado" value="false" />
                            <input class="form-check-input" type="checkbox" id="Perfil_Eliminado" name="Perfil.Eliminado" value="true"
                                   @(Model.Perfil?.Eliminado == true ? "checked" : "") />
                            <label class="perfil-label form-check-label" for="Perfil_Eliminado">Eliminado</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-3 mb-5">
                <button class="btn btn-success" type="submit"><i class="bi bi-save"></i> Guardar Cambios</button>
                <a class="btn btn-secondary ms-2" href="/">Volver</a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger">No se encontró usuario/perfil.</div>
    }
</div>

@section Scripts {
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places&callback=initAutocomplete"></script>

    <script>
        function el(id){return document.getElementById(id);}

        // Phone mask (123-456-7890)
        (function(){
            var tel = el('telefono-input');
            if(!tel) return;
            tel.addEventListener('input', function(){
                var digits = this.value.replace(/\D/g,'').slice(0,10);
                var out = digits;
                if(digits.length>6) out = digits.slice(0,3) + '-' + digits.slice(3,6) + '-' + digits.slice(6);
                else if(digits.length>3) out = digits.slice(0,3) + '-' + digits.slice(3);
                this.value = out;
                var telErr = el('telefono-error');
                if(telErr) telErr.classList.toggle('d-none', digits.length === 10);
            });
        })();

        // Email validation
        (function(){
            var email = el('email-input');
            if(!email) return;
            email.addEventListener('input', function(){
                var ok = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.value);
                var elErr = el('email-error');
                if(elErr) elErr.classList.toggle('d-none', ok);
            });
        })();

        // Places autocomplete (cities)
        function sanitizeCountryCode(raw){ if(!raw) return ""; var token=String(raw).trim().split(/\s|-/)[0]; var match=token.match(/[A-Za-z]{2,3}/); return match?match[0].toLowerCase():""; }
        function initAutocomplete(){
            try{
                var input=el('ciudad-input'), paisSel=el('pais-select'), latEl=el('latitud-input'), lngEl=el('longitud-input');
                if(!input || !window.google || !google.maps || !google.maps.places) return;
                var autocomplete = new google.maps.places.Autocomplete(input, { types: ['(cities)'] });
                if(paisSel){
                    paisSel.addEventListener('change', function(){
                        var code = sanitizeCountryCode(paisSel.value);
                        try{ if(code) autocomplete.setComponentRestrictions({country:code}); else autocomplete.setComponentRestrictions({}); }catch(e){ console.warn(e); }
                        input.value=''; if(latEl) latEl.value=''; if(lngEl) lngEl.value='';
                    });
                }
                autocomplete.addListener('place_changed', function(){
                    var place = autocomplete.getPlace();
                    if(place && place.geometry && place.geometry.location){
                        el('ciudad-error') && el('ciudad-error').classList.add('d-none');
                        if(latEl) latEl.value = place.geometry.location.lat();
                        if(lngEl) lngEl.value = place.geometry.location.lng();
                    } else {
                        if(latEl) latEl.value = ''; if(lngEl) lngEl.value = '';
                        el('ciudad-error') && el('ciudad-error').classList.remove('d-none');
                    }
                });
            }catch(e){ console.error('initAutocomplete error', e); }
        }

        // fallback clear lat/lng on country change
        document.addEventListener('DOMContentLoaded', function(){
            var paisSel = el('pais-select'), ciudad = el('ciudad-input');
            if(paisSel && ciudad){
                paisSel.addEventListener('change', function(){
                    el('latitud-input') && (el('latitud-input').value='');
                    el('longitud-input') && (el('longitud-input').value='');
                    ciudad.value = '';
                });
            }
        });
    </script>
}