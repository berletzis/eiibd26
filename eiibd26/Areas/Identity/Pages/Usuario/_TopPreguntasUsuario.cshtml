@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var questions = Model?.Preguntas?.OrderByDescending(p => p.Votes).ThenByDescending(p => p.AnswersCount).ToList()
                    ?? new List<eiibd26.Models.QuestionItem>();

    var containerId = "top-questions-" + Guid.NewGuid().ToString("N");
    var pageSize = 8;
    var totalCount = questions.Count;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<style>
    .top-questions-card {
        padding: 1rem;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        margin-top: 8px;
    }

        .top-questions-card .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 1rem;
        }

        .top-questions-card .q-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .top-questions-card .q-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 6px;
            background: #f8fafc;
            transition: background .2s ease;
        }

            .top-questions-card .q-item:hover {
                background: #f1f5f9;
            }

        .top-questions-card .q-link {
            flex: 1;
            font-size: .9rem;
            color: #0f172a;
            text-decoration: none;
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

            .top-questions-card .q-link:hover {
                color: #6a4e7a;
                text-decoration: underline;
            }

        .top-questions-card .q-badges {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .top-questions-card .badge-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .top-questions-card .badge-votes {
            background: #dbeafe;
            color: #1e40af;
        }

        .top-questions-card .badge-answers {
            background: #d1fae5;
            color: #065f46;
        }

        .top-questions-card .pagination-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            padding-top: .75rem;
            border-top: 1px solid #e9ecef;
        }

            .top-questions-card .pagination-controls .page-info {
                font-size: .85rem;
                color: #6b7280;
            }

            .top-questions-card .pagination-controls .btn-pagination {
                padding: 6px 14px;
                font-size: .85rem;
                border-radius: 6px;
                border: 1px solid #e9ecef;
                background: #fff;
                color: #0f172a;
                cursor: pointer;
                transition: all .2s ease;
            }

                .top-questions-card .pagination-controls .btn-pagination:hover:not(:disabled) {
                    background: #f8fafc;
                    border-color: #6a4e7a;
                    color: #6a4e7a;
                }

                .top-questions-card .pagination-controls .btn-pagination:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

        .top-questions-card .no-data {
            text-align: center;
            color: #9ca3af;
            font-size: .9rem;
            padding: 2rem 0;
        }

    @@media (max-width: 768px) {
        .top-questions-card .q-item {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

        .top-questions-card .q-badges {
            justify-content: flex-start;
        }

        .top-questions-card .pagination-controls {
            flex-direction: column;
            gap: 10px;
        }

            .top-questions-card .pagination-controls .page-info {
                order: -1;
            }
    }
</style>

<div id="@containerId" class="top-questions-card">
    <div class="card-title">Top Preguntas</div>

    @if (!questions.Any())
    {
        <div class="no-data">No hay preguntas para mostrar.</div>
    }
    else
    {
        <div class="q-list">
            @for (int i = 0; i < questions.Count; i++)
            {
                var q = questions[i];

                <div class="q-item question-entry" data-index="@i" style="display:none;">
                    <a href="@Url.Page("/Preguntas/Detalles", new { id = q.Id })"
                       class="q-link"
                       title="@q.Titulo">
                        @q.Titulo
                    </a>
                    <div class="q-badges">
                        <span class="badge-pill badge-votes" title="Votos">
                            <i class="bi bi-arrow-up-circle me-1"></i>@q.Votes
                        </span>
                        <span class="badge-pill badge-answers" title="Respuestas">
                            <i class="bi bi-chat-dots me-1"></i>@q.AnswersCount
                        </span>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination-controls" aria-label="Paginación">
                <div class="page-info">
                    Página <span class="current-page">1</span> de <span class="total-pages">@totalPages</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn-pagination prev-btn" aria-label="Anterior">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </button>
                    <button type="button" class="btn-pagination next-btn" aria-label="Siguiente">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</div>

<script>
    (function () {
        var container = document.getElementById('@containerId');
        if (!container) return;

        var entries = container.querySelectorAll('.question-entry');
        var pageSize = @pageSize;
        var totalCount = entries.length;
        var totalPages = Math.ceil(totalCount / pageSize) || 1;
        var currentPage = 1;

        var prevBtn = container.querySelector('.prev-btn');
        var nextBtn = container.querySelector('.next-btn');
        var currentPageSpan = container.querySelector('.current-page');
        var totalPagesSpan = container.querySelector('.total-pages');

        if (totalPagesSpan) totalPagesSpan.textContent = totalPages;

        function renderPage(page) {
            currentPage = Math.max(1, Math.min(page, totalPages));
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;

            entries.forEach(function (el, idx) {
                el.style.display = (idx >= start && idx < end) ? '' : 'none';
            });

            if (prevBtn) {
                prevBtn.disabled = (currentPage <= 1);
            }
            if (nextBtn) {
                nextBtn.disabled = (currentPage >= totalPages);
            }
            if (currentPageSpan) {
                currentPageSpan.textContent = currentPage;
            }
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', function () {
                if (currentPage > 1) {
                    renderPage(currentPage - 1);
                }
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', function () {
                if (currentPage < totalPages) {
                    renderPage(currentPage + 1);
                }
            });
        }

        renderPage(1);
    })();
</script>