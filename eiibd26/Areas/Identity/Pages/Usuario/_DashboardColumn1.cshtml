@model eiibd26.Models.DashboardViewModel
@using Newtonsoft.Json
@{
    // Partial: Dashboard column — últimos N días.
    // Responsive: en móvil mostramos sólo los últimos 3 días (anteayer + ayer + hoy).
}

<style>
    .dashboard-col1-card {
        background: #fff;
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 2px 14px rgba(0,0,0,0.06);
        margin-bottom: 1rem;
        box-sizing: border-box;
        font-weight: 400;
    }

    .dashboard-col1-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .dashboard-col1-title {
        font-size: 1.1rem;
        font-weight: 400;
        margin: 0;
        color: #172849;
    }

    .small-muted {
        font-weight: 400;
    }

    .chart-wrapper {
        height: 335px;
        position: relative;
        margin-top: 12px;
        box-sizing: border-box;
        width: 100%;
        padding: 0;
    }

        .chart-wrapper canvas {
            width: 100% !important;
            max-width: 100% !important;
            height: 100% !important;
            display: block;
            box-sizing: border-box;
        }

    .mood-leyenda-row {
        display: flex;
        gap: 18px;
        margin-top: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .mood-leyenda-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 400;
        color: #333;
    }

    .mood-leyenda-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 1px 6px #e6e8ef77;
        background: #fff;
        padding: 3px;
    }

    .btn-add-mood {
        background: #764ba2;
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 400;
    }

    .no-chart-msg {
        padding: 30px 10px;
        text-align: center;
        color: #6b7280;
        font-weight: 400;
    }

    .mood-toast {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 1200;
        min-width: 220px;
    }

    @@media (max-width: 767.98px) {
        .chart-wrapper {
            height: 220px;
        }

        .mood-leyenda-img {
            width: 24px;
            height: 24px;
        }
    }

    .modal-dialog-centered {
        display: flex;
        align-items: center;
        min-height: calc(100% - 1rem);
    }

    .modal-content {
        max-height: calc(100vh - 3.5rem);
        overflow: auto;
    }

    /* Custom Select Dropdown - MISMO ESTILO QUE LA PÁGINA PRINCIPAL */
    .custom-select-wrapper {
        position: relative;
    }

    .custom-select-display {
        width: 100%;
        padding: 0.375rem 2.25rem 0.375rem 0.75rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
        color: #212529;
        background-color: #fff;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 16px 12px;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        cursor: pointer;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }

        .custom-select-display:hover {
            border-color: #86b7fe;
        }

        .custom-select-display.active {
            border-color: #86b7fe;
            outline: 0;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .custom-select-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        display: none;
        max-height: 250px;
        margin-top: 0.125rem;
        background-color: #fff;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
        overflow: hidden;
    }

        .custom-select-dropdown.show {
            display: block;
        }

    .custom-select-search {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: none;
        border-bottom: 1px solid #dee2e6;
        outline: none;
        font-size: 0.95rem;
    }

        .custom-select-search:focus {
            background-color: #f8f9fa;
        }

    .custom-select-options {
        max-height: 200px;
        overflow-y: auto;
        padding: 0.25rem 0;
    }

    .custom-select-option {
        padding: 0.5rem 0.75rem;
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }

        .custom-select-option:hover {
            background-color: #f8f9fa;
        }

        .custom-select-option.selected {
            background-color: #e7f1ff;
            font-weight: 500;
        }

    .custom-select-no-results {
        padding: 0.5rem 0.75rem;
        color: #6c757d;
        font-style: italic;
        text-align: center;
    }
</style>

<div class="dashboard-col1-card">
    <div class="dashboard-col1-header">
        <div>
            <div class="dashboard-col1-title">Mi Estado de Ánimo (Últimos 7 días)</div>
            <div class="small-muted" style="font-size:.9rem;">Se muestran registros reales (varios por día permitidos).</div>
        </div>
        <button id="col1OpenMoodBtn" class="crm-btn crm-btn-primary btn-lg" type="button">+<i class="bi bi-emoji-wink"></i></button>
    </div>

    <div class="chart-wrapper" id="col1ChartWrapper">
        <canvas id="col1MoodChart" aria-label="Gráfica últimos días"></canvas>
    </div>

    <div class="mood-leyenda-row" aria-hidden="true">
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/muybien.svg" alt="Muy bien" /> Muy bien</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/bien.svg" alt="Bien" /> Bien</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/neutral.svg" alt="Neutral" /> Neutral</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/mal.svg" alt="Mal" /> Mal</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/muymal.svg" alt="Muy mal" /> Muy mal</span>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="col1MoodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="col1MoodForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 id="tituloTrackingPartial" class="modal-title">Agregar estado de ánimo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="col1MoodAlert" style="display:none;" class="alert" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label">Selecciona tu estado</label>
                        <div class="d-flex gap-2 flex-wrap" id="col1MoodOptions">
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="5"><img src="/img/muybien.svg" style="width:22px;margin-right:6px" /> Muy bien</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="4"><img src="/img/bien.svg" style="width:22px;margin-right:6px" /> Bien</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="3"><img src="/img/neutral.svg" style="width:22px;margin-right:6px" /> Neutral</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="2"><img src="/img/mal.svg" style="width:22px;margin-right:6px" /> Mal</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="1"><img src="/img/muymal.svg" style="width:22px;margin-right:6px" /> Muy mal</button>
                        </div>
                        <input type="hidden" id="col1MoodSelected" name="mood" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reflexión (opcional)</label>
                        <textarea class="form-control" id="col1MoodText" name="texto" rows="2" maxlength="200"></textarea>
                    </div>

                    <!-- CONDICIÓN CUSTOM SELECT -->
                    <div class="mb-3">
                        <label class="form-label">Relacionar a condición (opcional):</label>
                        <div class="custom-select-wrapper" data-field="condicion">
                            <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                            <div class="custom-select-dropdown">
                                <input type="text" class="custom-select-search" placeholder="Buscar...">
                                <div class="custom-select-options"></div>
                            </div>
                            <input type="hidden" id="col1CondicionSelectedId" name="condicionUsuarioId">
                        </div>
                    </div>

                    <!-- SÍNTOMA CUSTOM SELECT -->
                    <div class="mb-3">
                        <label class="form-label">Relacionar a síntoma (opcional):</label>
                        <div class="custom-select-wrapper" data-field="sintoma">
                            <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                            <div class="custom-select-dropdown">
                                <input type="text" class="custom-select-search" placeholder="Buscar...">
                                <div class="custom-select-options"></div>
                            </div>
                            <input type="hidden" id="col1SintomaSelectedId" name="sintomaUsuarioId">
                        </div>
                    </div>

                    <!-- TRATAMIENTO CUSTOM SELECT -->
                    <div class="mb-3">
                        <label class="form-label">Relacionar a tratamiento (opcional):</label>
                        <div class="custom-select-wrapper" data-field="tratamiento">
                            <div class="custom-select-display" tabindex="0">Seleccionar...</div>
                            <div class="custom-select-dropdown">
                                <input type="text" class="custom-select-search" placeholder="Buscar...">
                                <div class="custom-select-options"></div>
                            </div>
                            <input type="hidden" id="col1TratamientoSelectedId" name="tratamientoUsuarioId">
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="col1MoodSubmit" type="submit" class="se-btn se-btn-primary" style="font-size:28px; border-radius:50%;"><i class="bi bi-check"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="col1MoodToast" class="mood-toast" style="display:none;">
    <div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="col1MoodToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" onclick="document.getElementById('col1MoodToast').style.display='none'"></button>
        </div>
    </div>
</div>

<script>
    (function ensureChart(next){
      if (typeof Chart !== 'undefined') return next();
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      s.onload = next;
      s.onerror = function(){ console.error("No se pudo cargar Chart.js"); next(); };
      document.head.appendChild(s);
    })(function(){

      const ENDPOINT_HISTORICO = "/api/EstadoAnimoUsuario/historico";
      const ENDPOINT_NUEVO = "/api/EstadoAnimoUsuario/nuevo";
      const ENDPOINT_CONDICIONES = "/api/EstadoAnimoUsuario/condiciones-usuario";
      const ENDPOINT_SINTOMAS = "/api/EstadoAnimoUsuario/sintomas-usuario";
      const ENDPOINT_TRATAMIENTOS = "/api/EstadoAnimoUsuario/tratamientos-usuario";
      const DAY_MS = 24 * 60 * 60 * 1000;
      
      // Variables globales para las listas
      let col1CondicionesData = [];
      let col1SintomasData = [];
      let col1TratamientosData = [];

      // Mapeo de colores por valor numérico
      const mapColor = { 5:"#38D6C1", 4:"#B3F1E9", 3:"#FEE019", 2:"#D8B4F8", 1:"#9B5DE5" };
      const moodLabelFromNum = n => ({5:"Muy bien",4:"Bien",3:"Neutral",2:"Mal",1:"Muy mal"}[n]||"");

      function parseDateString(s) {
        if (!s) return null;
        try {
          s = String(s).replace(/\.(\d{3})\d+/, '.$1');
          if (!/[zZ]$/.test(s) && !/[+\-]\d{2}:\d{2}$/.test(s)) s = s + 'Z';
          const d = new Date(s);
          return isNaN(d.getTime()) ? null : d;
        } catch (e) { return null; }
      }

      function getLast7Window() {
        const today = new Date();
        const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 6);
        const startMs = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
        const endMs = startMs + 7 * DAY_MS - 1;
        return { startMs, endMs };
      }

      function getLast3Window() {
        const today = new Date();
        const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 2);
        const startMs = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
        const endMs = startMs + 3 * DAY_MS - 1;
        return { startMs, endMs };
      }

      function normalize(list) {
        const out = [];
        if (!Array.isArray(list)) return out;
        const w = getLast7Window();
        (list || []).forEach(x => {
          let estadoNum = x.estadoMood ?? x.EstadoMood ?? null;
          if (estadoNum === null || estadoNum === undefined) return;
          
          estadoNum = parseInt(estadoNum);
          if (isNaN(estadoNum) || estadoNum < 1 || estadoNum > 5) return;
          
          const fecha = parseDateString(x.fechaRegistro ?? x.FechaRegistro ?? x.FechaIso ?? x.Fecha ?? null);
          if (!fecha) return;
          const ts = fecha.getTime();
          if (ts < w.startMs || ts > w.endMs) return;
          out.push({
            estado: estadoNum,
            fecha,
            ts,
            texto: x.texto ?? x.Texto ?? "",
            relacion: x.relacionNombre ?? x.RelacionNombre ?? ""
          });
        });
        out.sort((a,b) => a.ts - b.ts);
        return out;
      }

      function buildLabelsAndData(normalizedList) {
        const labels = [];
        const data = [];
        const bg = [];
        normalizedList.forEach(n => {
          labels.push(new Date(n.ts).toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }));
          data.push(n.estado);
          bg.push(mapColor[n.estado]);
        });
        return { labels, data, bg, raws: normalizedList };
      }

      function filterForMobile(normalizedList) {
        const w3 = getLast3Window();
        return normalizedList.filter(n => n.ts >= w3.startMs && n.ts <= w3.endMs);
      }

      let chartInstance = null;

      function createChartOptions(isMobile, arrRaw) {
        const baseOptions = {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function(items) {
                  if (!items || !items.length) return '';
                  const idx = items[0].dataIndex;
                  const raw = arrRaw && arrRaw[idx];
                  return new Date(raw.ts).toLocaleString('es-ES', { weekday:'short', day:'2-digit', month:'short' });
                },
                label: function(ctx) {
                  const idx = ctx.dataIndex;
                  const raw = arrRaw && arrRaw[idx];
                  const val = ctx.parsed.y;
                  const time = raw && raw.fecha ? new Date(raw.fecha).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' }) : '';
                  return (moodLabelFromNum(val) || val) + (time ? ' — ' + time : '');
                },
                afterBody: function(ctxArr) {
                  const idx = ctxArr && ctxArr[0] && ctxArr[0].dataIndex;
                  const raw = arrRaw && arrRaw[idx];
                  if (raw && raw.texto) return ['"' + raw.texto + '"'];
                  if (raw && raw.relacion) return ['Relacionado: ' + raw.relacion];
                  return [];
                }
              }
            }
          },
          scales: {
            x: {
              ticks: {
                autoSkip: true,
                maxTicksLimit: isMobile ? 3 : 7,
                callback: function(val, index) {
                  return this.getLabelForValue(index);
                },
                font: { size: isMobile ? 10 : 12 }
              },
              grid: { display: false }
            },
            y: {
              min: 1, max: 5,
              ticks: {
                stepSize: 1,
                callback: function(v){ return {5:"Muy bien",4:"Bien",3:"Neutral",2:"Mal",1:"Muy mal"}[v] || ""; },
                font: { size: isMobile ? 10 : 12 }
              }
            }
          }
        };

        if (isMobile) {
          baseOptions.plugins.tooltip.bodyFont = { size: 12 };
          baseOptions.plugins.tooltip.titleFont = { size: 12 };
        }

        return baseOptions;
      }

      function renderChartFromArrays(arr, isMobile) {
        const canvas = document.getElementById('col1MoodChart');
        if (!canvas) {
          const wrapper = document.getElementById('col1ChartWrapper');
          if (wrapper) wrapper.innerHTML = '<div class="no-chart-msg">No se encontró el canvas para dibujar la gráfica.</div>';
          return;
        }
        const ctx = canvas.getContext('2d');
        if (chartInstance) try { chartInstance.destroy(); } catch(e) {}

        const pointRadius = isMobile ? 8 : 12;
        const pointHoverRadius = isMobile ? 12 : 16;
        const borderWidth = isMobile ? 1.5 : 2;

        const labels = arr.labels;
        const datasetData = arr.data;
        const backgroundColors = arr.bg;

        const options = createChartOptions(isMobile, arr.raws);

        chartInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: "Estado de ánimo",
              data: datasetData,
              backgroundColor: backgroundColors,
              borderColor: "#3498db",
              borderWidth: borderWidth,
              pointBackgroundColor: backgroundColors,
              pointRadius: pointRadius,
              pointHoverRadius: pointHoverRadius,
              pointStyle: 'circle',
              spanGaps: false,
              fill: false,
              tension: 0.3
            }]
          },
          options: options
        });

        try {
          if (canvas.hasAttribute('width')) canvas.removeAttribute('width');
          canvas.style.width = '100%';
          canvas.style.height = '100%';
        } catch (e) {}

        setTimeout(function () {
          try { chartInstance.resize(); } catch (e) {}
        }, 50);

        setTimeout(function () {
          try { chartInstance.resize(); } catch (e) {}
        }, 300);
      }

      async function loadAndRenderHistorico(){
        try {
          const res = await fetch(ENDPOINT_HISTORICO, { cache: "no-store" });
          if (!res.ok) { console.warn("histórico fetch failed", res.status); renderChartFromArrays({labels:[],data:[],bg:[],raws:[]}, false); return; }
          const json = await res.json();
          const normalized = normalize(json);

          const isMobile = (Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0) <= 767.98);

          const toUse = isMobile ? filterForMobile(normalized) : normalized;

          const arr = buildLabelsAndData(toUse);
          renderChartFromArrays(arr, isMobile);
        } catch (e) { console.error("loadAndRenderHistorico error", e); }
      }

      // =====================
      // CUSTOM SELECT LOGIC (MISMO QUE PÁGINA PRINCIPAL)
      // =====================
      function initCustomSelect(wrapper, dataArray, hiddenInputId) {
        const display = wrapper.querySelector('.custom-select-display');
        const dropdown = wrapper.querySelector('.custom-select-dropdown');
        const searchInput = wrapper.querySelector('.custom-select-search');
        const optionsContainer = wrapper.querySelector('.custom-select-options');
        const hiddenInput = document.getElementById(hiddenInputId);

        let allOptions = dataArray;
        let selectedId = null;

        function renderOptions(filteredData) {
          optionsContainer.innerHTML = '';
          if (filteredData.length === 0) {
            optionsContainer.innerHTML = '<div class="custom-select-no-results">Sin resultados</div>';
            return;
          }
          filteredData.forEach(item => {
            const div = document.createElement('div');
            div.className = 'custom-select-option';
            if (item.id === selectedId) div.classList.add('selected');
            div.textContent = item.nombre;
            div.dataset.id = item.id;
            div.dataset.nombre = item.nombre;
            div.addEventListener('click', function() {
              selectedId = item.id;
              hiddenInput.value = item.id;
              display.textContent = item.nombre;
              closeDropdown();
            });
            optionsContainer.appendChild(div);
          });
        }

        function openDropdown() {
          dropdown.classList.add('show');
          display.classList.add('active');
          searchInput.value = '';
          renderOptions(allOptions);
          searchInput.focus();
        }

        function closeDropdown() {
          dropdown.classList.remove('show');
          display.classList.remove('active');
        }

        display.addEventListener('click', function(e) {
          e.stopPropagation();
          if (dropdown.classList.contains('show')) {
            closeDropdown();
          } else {
            document.querySelectorAll('.custom-select-dropdown.show').forEach(d => {
              d.classList.remove('show');
              d.previousElementSibling.classList.remove('active');
            });
            openDropdown();
          }
        });

        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          const filtered = allOptions.filter(item => item.nombre.toLowerCase().includes(query));
          renderOptions(filtered);
        });

        searchInput.addEventListener('click', function(e) {
          e.stopPropagation();
        });

        document.addEventListener('click', function(e) {
          if (!wrapper.contains(e.target)) {
            closeDropdown();
          }
        });

        wrapper.resetSelect = function() {
          selectedId = null;
          hiddenInput.value = '';
          display.textContent = 'Seleccionar...';
        };
      }

      async function cargarCondicionesUsuario() {
        try {
          let resp = await fetch(ENDPOINT_CONDICIONES, { cache: "no-store" });
          col1CondicionesData = await resp.json();
        } catch (e) {
          col1CondicionesData = [];
        }
      }

      async function cargarSintomasUsuario() {
        try {
          let resp = await fetch(ENDPOINT_SINTOMAS, { cache: "no-store" });
          col1SintomasData = await resp.json();
        } catch (e) {
          col1SintomasData = [];
        }
      }

      async function cargarTratamientosUsuario() {
        try {
          let resp = await fetch(ENDPOINT_TRATAMIENTOS, { cache: "no-store" });
          col1TratamientosData = await resp.json();
        } catch (e) {
          col1TratamientosData = [];
        }
      }

      // Cargar listas y gráfica al inicio
      (async function init() {
        await cargarCondicionesUsuario();
        await cargarSintomasUsuario();
        await cargarTratamientosUsuario();
        await loadAndRenderHistorico();

        const condicionWrapper = document.querySelector('[data-field="condicion"]');
        const sintomaWrapper = document.querySelector('[data-field="sintoma"]');
        const tratamientoWrapper = document.querySelector('[data-field="tratamiento"]');

        if (condicionWrapper) initCustomSelect(condicionWrapper, col1CondicionesData, 'col1CondicionSelectedId');
        if (sintomaWrapper) initCustomSelect(sintomaWrapper, col1SintomasData, 'col1SintomaSelectedId');
        if (tratamientoWrapper) initCustomSelect(tratamientoWrapper, col1TratamientosData, 'col1TratamientoSelectedId');
      })();

      (function setupResize() {
        let timer = null;
        window.addEventListener('resize', function () {
          if (timer) clearTimeout(timer);
          timer = setTimeout(function () {
            loadAndRenderHistorico();
          }, 200);
        });
      })();

      (function attachOpenButton(){
        const btn = document.getElementById('col1OpenMoodBtn');
        if (!btn) return;
        btn.addEventListener('click', function(){
          const modalEl = document.getElementById('col1MoodModal');
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();
        });
      })();

      (function attachMoodOptionBtns(){
        const container = document.getElementById('col1MoodOptions');
        if (!container) return;
        container.querySelectorAll('.mood-option-btn').forEach(b => {
          b.addEventListener('click', function(){
            container.querySelectorAll('.mood-option-btn').forEach(x => x.classList.remove('active'));
            this.classList.add('active');
            document.getElementById('col1MoodSelected').value = this.dataset.val;
          });
        });
      })();

      window.addEventListener('mood:added', function(e){
        loadAndRenderHistorico();
      });

      (function attachFormSubmit(){
        const form = document.getElementById("col1MoodForm");
        if (!form) return;
        form.addEventListener("submit", async function(ev){
          ev.preventDefault();
          const selected = document.getElementById("col1MoodSelected").value;
          
          const moodNum = parseInt(selected);
          if (!selected || isNaN(moodNum) || moodNum < 1 || moodNum > 5) {
            const alertEl = document.getElementById("col1MoodAlert");
            alertEl.className="alert alert-danger";
            alertEl.textContent="Selecciona un estado de ánimo.";
            alertEl.style.display="block";
            return;
          }
          
          const texto = document.getElementById("col1MoodText").value || "";
          const condicionId = document.getElementById("col1CondicionSelectedId").value || "";
          const sintomaId = document.getElementById("col1SintomaSelectedId").value || "";
          const tratamientoId = document.getElementById("col1TratamientoSelectedId").value || "";
          
          const fd = new FormData();
          fd.append("mood", selected);
          fd.append("texto", texto);
          if (condicionId) fd.append("condicionUsuarioId", condicionId);
          if (sintomaId) fd.append("sintomaUsuarioId", sintomaId);
          if (tratamientoId) fd.append("tratamientoUsuarioId", tratamientoId);

          try {
            const resp = await fetch(ENDPOINT_NUEVO, { method: "POST", body: fd });
            if (!resp.ok) {
              const alertEl = document.getElementById("col1MoodAlert");
              alertEl.className="alert alert-danger";
              alertEl.textContent="Error al guardar. Código: "+resp.status;
              alertEl.style.display="block";
              return;
            }
            const created = await resp.json();
            const modalEl = document.getElementById('col1MoodModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            
            document.getElementById('col1MoodToastBody').textContent = "Estado guardado";
            document.getElementById('col1MoodToast').style.display = 'block';
            setTimeout(()=> document.getElementById('col1MoodToast').style.display='none', 2000);
            
            // Reset form
            document.getElementById('col1MoodSelected').value = '';
            document.getElementById('col1MoodText').value = '';
            document.querySelectorAll('#col1MoodOptions .mood-option-btn').forEach(x=>x.classList.remove('active'));
            
            // Reset custom selects
            const condicionWrapper = document.querySelector('[data-field="condicion"]');
            const sintomaWrapper = document.querySelector('[data-field="sintoma"]');
            const tratamientoWrapper = document.querySelector('[data-field="tratamiento"]');
            if (condicionWrapper && condicionWrapper.resetSelect) condicionWrapper.resetSelect();
            if (sintomaWrapper && sintomaWrapper.resetSelect) sintomaWrapper.resetSelect();
            if (tratamientoWrapper && tratamientoWrapper.resetSelect) tratamientoWrapper.resetSelect();
            
            await loadAndRenderHistorico();
            try { window.dispatchEvent(new CustomEvent('mood:added', { detail: { created } })); } catch(e) {}
          } catch (e) {
            console.error(e);
            const alertEl = document.getElementById("col1MoodAlert");
            alertEl.className = "alert alert-danger";
            alertEl.textContent = "Error de red al guardar.";
            alertEl.style.display = "block";
          }
        });
      })();

    });
</script>