@model eiibd26.Models.DashboardViewModel
@using Newtonsoft.Json
@{
    // Partial: Dashboard column — últimos 7 días.
    // Ahora usamos eje X categorical: una etiqueta por registro (fecha), así varios registros del mismo día se muestran claramente.
}

<style>
    .dashboard-col1-card {
        background: #fff;
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 2px 14px rgba(0,0,0,0.06);
        margin-bottom: 1rem;
    }

    .dashboard-col1-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .dashboard-col1-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0;
    }

    .chart-wrapper {
        height: 335px;
        position: relative;
        margin-top: 12px;
    }

        .chart-wrapper canvas {
            width: 100% !important;
            height: 100% !important;
            display: block;
        }

    .mood-leyenda-row {
        display: flex;
        gap: 18px;
        margin-top: 12px;
        flex-wrap: wrap;
        align-items: center;
    }Mis Síntomas

    .mood-leyenda-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        color: #333;
    }

    .mood-leyenda-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 1px 6px #e6e8ef77;
        background: #fff;
        padding: 3px;
    }

    .btn-add-mood {
        background: #2563eb;
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
    }

    .no-chart-msg {
        padding: 30px 10px;
        text-align: center;
        color: #6b7280;
        font-weight: 500;
    }

    .mood-toast {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 1200;
        min-width: 220px;
    }
</style>

<div class="dashboard-col1-card">
    <div class="dashboard-col1-header">
        <div>
            <div class="dashboard-col1-title">Mi Estado de Ánimo (Últimos 7 días)</div>
            <div class="small-muted" style="font-size:.9rem;">Se muestran registros reales (varios por día permitidos).</div>
        </div>
        <button id="col1OpenMoodBtn" class="btn-add-mood" type="button">Agregar</button>
    </div>

    <div class="chart-wrapper" id="col1ChartWrapper">
        <canvas id="col1MoodChart" aria-label="Gráfica últimos 7 días"></canvas>
    </div>

    <div class="mood-leyenda-row" aria-hidden="true">
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/muybien.svg" alt="Muy bien" /> Muy bien</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/bien.svg" alt="Bien" /> Bien</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/neutral.svg" alt="Neutral" /> Neutral</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/mal.svg" alt="Mal" /> Mal</span>
        <span class="mood-leyenda-item"><img class="mood-leyenda-img" src="/img/muymal.svg" alt="Muy mal" /> Muy mal</span>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="col1MoodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="col1MoodForm">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar estado de ánimo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="col1MoodAlert" style="display:none;" class="alert" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label">Selecciona tu estado</label>
                        <div class="d-flex gap-2 flex-wrap" id="col1MoodOptions">
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="MuyBien"><img src="/img/muybien.svg" style="width:22px;margin-right:6px" /> Muy bien</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="Bien"><img src="/img/bien.svg" style="width:22px;margin-right:6px" /> Bien</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="Neutral"><img src="/img/neutral.svg" style="width:22px;margin-right:6px" /> Neutral</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="Mal"><img src="/img/mal.svg" style="width:22px;margin-right:6px" /> Mal</button>
                            <button type="button" class="btn btn-outline-secondary mood-option-btn" data-val="MuyMal"><img src="/img/muymal.svg" style="width:22px;margin-right:6px" /> Muy mal</button>
                        </div>
                        <input type="hidden" id="col1MoodSelected" name="mood" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reflexión (opcional)</label>
                        <textarea class="form-control" id="col1MoodText" name="texto" rows="2" maxlength="200"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Relacionar con</label>
                        <select class="form-select" id="col1MoodRelacion" name="condicionUsuarioId">
                            <option value="">Sin relación</option>
                            @if (Model?.MoodRelations != null)
                            {
                                foreach (var r in Model.MoodRelations)
                                {
                                    <option value="@r.Id">@r.Nombre (@r.Tipo)</option>
                                    ;
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="col1MoodSubmit" type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="col1MoodToast" class="mood-toast" style="display:none;">
    <div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="col1MoodToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" onclick="document.getElementById('col1MoodToast').style.display='none'"></button>
        </div>
    </div>
</div>

<script>
    (function ensureChart(next){
      if (typeof Chart !== 'undefined') return next();
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      s.onload = next;
      s.onerror = function(){ console.error("No se pudo cargar Chart.js"); next(); };
      document.head.appendChild(s);
    })(function(){

      const ENDPOINT_HISTORICO = "/api/EstadoAnimoUsuario/historico";
      const ENDPOINT_NUEVO = "/api/EstadoAnimoUsuario/nuevo";
      const DAY_MS = 24 * 60 * 60 * 1000;
      const mapVal = { "MuyBien":5, "Bien":4, "Neutral":3, "Mal":2, "MuyMal":1 };
      const mapColor = { "MuyBien":"#38D6C1", "Bien":"#B3F1E9", "Neutral":"#FEE019", "Mal":"#D8B4F8", "MuyMal":"#9B5DE5" };
      const moodLabelFromNum = n => ({5:"Muy bien",4:"Bien",3:"Neutral",2:"Mal",1:"Muy mal"}[n]||"");

      function parseDateString(s) {
        if (!s) return null;
        try {
          s = String(s).replace(/\.(\d{3})\d+/, '.$1');
          if (!/[zZ]$/.test(s) && !/[+\-]\d{2}:\d{2}$/.test(s)) s = s + 'Z';
          const d = new Date(s);
          return isNaN(d.getTime()) ? null : d;
        } catch (e) { return null; }
      }

      // last 7 days window (used only to filter; labels built per-record)
      function getLast7Window() {
        const today = new Date();
        const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 6);
        const startMs = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
        const endMs = startMs + 7 * DAY_MS - 1;
        return { startMs, endMs };
      }

      function normalize(list) {
        const out = [];
        if (!Array.isArray(list)) return out;
        const w = getLast7Window();
        (list || []).forEach(x => {
          const estado = (x.estadoMood ?? x.EstadoMood ?? x.Estado ?? "").toString();
          if (!estado || mapVal[estado] === undefined) return;
          const fecha = parseDateString(x.fechaRegistro ?? x.FechaRegistro ?? x.FechaIso ?? x.Fecha ?? null);
          if (!fecha) return;
          const ts = fecha.getTime();
          if (ts < w.startMs || ts > w.endMs) return;
          out.push({ estado, fecha, ts, texto: x.texto ?? x.Texto ?? "", relacion: x.relacionNombre ?? x.RelacionNombre ?? "" });
        });
        // ordenar por tiempo ascendente
        out.sort((a,b) => a.ts - b.ts);
        return out;
      }

      // Build labels (one per record) and data arrays so multiple records same day are separate indices
      function buildLabelsAndData(normalizedList) {
        const labels = [];
        const data = [];
        const bg = [];
        normalizedList.forEach(n => {
          // label as locale short date (same format as full page)
          labels.push(new Date(n.ts).toLocaleDateString('es-ES'));
          data.push(mapVal[n.estado]);
          bg.push(mapColor[n.estado]);
        });
        return { labels, data, bg, raws: normalizedList };
      }

      let chartInstance = null;
      function renderChartFromArrays(arr) {
        const canvas = document.getElementById('col1MoodChart');
        if (!canvas) {
          const wrapper = document.getElementById('col1ChartWrapper');
          if (wrapper) wrapper.innerHTML = '<div class="no-chart-msg">No se encontró el canvas para dibujar la gráfica.</div>';
          return;
        }
        const ctx = canvas.getContext('2d');
        if (chartInstance) try { chartInstance.destroy(); } catch(e) {}

        const labels = arr.labels;
        const datasetData = arr.data;
        const backgroundColors = arr.bg;

        chartInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: "Estado de ánimo",
              data: datasetData,
              backgroundColor: backgroundColors,
              borderColor: "#3498db",
              borderWidth: 2,
              pointBackgroundColor: backgroundColors,
              pointRadius: 12,
              pointHoverRadius: 16,
              pointStyle: 'circle',
              spanGaps: false,
              fill: false,
              tension: 0.3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: function(items) {
                    if (!items || !items.length) return '';
                    const idx = items[0].dataIndex;
                    const raw = arr.raws[idx];
                    return new Date(raw.ts).toLocaleString('es-ES', { weekday:'short', day:'2-digit', month:'short' });
                  },
                  label: function(ctx) {
                    const idx = ctx.dataIndex;
                    const raw = arr.raws[idx];
                    const val = ctx.parsed.y;
                    const time = raw && raw.fecha ? new Date(raw.fecha).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' }) : '';
                    return (moodLabelFromNum(val) || val) + (time ? ' — ' + time : '');
                  },
                  afterBody: function(ctxArr) {
                    const idx = ctxArr && ctxArr[0] && ctxArr[0].dataIndex;
                    const raw = arr.raws[idx];
                    if (raw && raw.texto) return ['"' + raw.texto + '"'];
                    if (raw && raw.relacion) return ['Relacionado: ' + raw.relacion];
                    return [];
                  }
                }
              }
            },
            scales: {
              x: {
                // categorical axis uses provided labels; show only one tick per day label
                ticks: {
                  autoSkip: true,
                  maxTicksLimit: 7,
                  callback: function(val, index) {
                    // show label as-is
                    return this.getLabelForValue(index);
                  }
                },
                grid: { display: false }
              },
              y: {
                min: 1, max: 5,
                ticks: {
                  stepSize: 1,
                  callback: function(v){ return {5:"Muy bien",4:"Bien",3:"Neutral",2:"Mal",1:"Muy mal"}[v] || ""; }
                }
              }
            }
          }
        });
      }

      async function loadAndRenderHistorico(){
        try {
          const res = await fetch(ENDPOINT_HISTORICO, { cache: "no-store" });
          if (!res.ok) { console.warn("histórico fetch failed", res.status); renderChartFromArrays({labels:[],data:[],bg:[],raws:[]}); return; }
          const json = await res.json();
          const normalized = normalize(json);
          const arr = buildLabelsAndData(normalized);
          renderChartFromArrays(arr);
        } catch (e) { console.error("loadAndRenderHistorico error", e); }
      }

      // initial render
      loadAndRenderHistorico();

      // Open modal button
      (function attachOpenButton(){
        const btn = document.getElementById('col1OpenMoodBtn');
        if (!btn) return;
        btn.addEventListener('click', function(){
          const modalEl = document.getElementById('col1MoodModal');
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();
        });
      })();

      // mood option buttons
      (function attachMoodOptionBtns(){
        const container = document.getElementById('col1MoodOptions');
        if (!container) return;
        container.querySelectorAll('.mood-option-btn').forEach(b => {
          b.addEventListener('click', function(){
            container.querySelectorAll('.mood-option-btn').forEach(x => x.classList.remove('active'));
            this.classList.add('active');
            document.getElementById('col1MoodSelected').value = this.dataset.val;
          });
        });
      })();

      // listen for mood added globally to refresh
      window.addEventListener('mood:added', function(e){
        loadAndRenderHistorico();
      });

      // form submit (create new mood)
      (function attachFormSubmit(){
        const form = document.getElementById("col1MoodForm");
        if (!form) return;
        form.addEventListener("submit", async function(ev){
          ev.preventDefault();
          const selected = document.getElementById("col1MoodSelected").value;
          if (!selected || !["MuyBien","Bien","Neutral","Mal","MuyMal"].includes(selected.trim())) {
            const alertEl = document.getElementById("col1MoodAlert"); alertEl.className="alert alert-danger"; alertEl.textContent="Selecciona un estado de ánimo."; alertEl.style.display="block"; return;
          }
          const texto = document.getElementById("col1MoodText").value || "";
          const relacionId = document.getElementById("col1MoodRelacion").value || "";
          const fd = new FormData();
          fd.append("mood", selected);
          fd.append("texto", texto);
          if (relacionId) fd.append("condicionUsuarioId", relacionId);

          try {
            const resp = await fetch(ENDPOINT_NUEVO, { method: "POST", body: fd });
            if (!resp.ok) {
              const alertEl = document.getElementById("col1MoodAlert"); alertEl.className="alert alert-danger"; alertEl.textContent="Error al guardar. Código: "+resp.status; alertEl.style.display="block"; return;
            }
            const created = await resp.json();
            const modalEl = document.getElementById('col1MoodModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            document.getElementById('col1MoodToastBody').textContent = "Estado guardado";
            document.getElementById('col1MoodToast').style.display = 'block';
            setTimeout(()=> document.getElementById('col1MoodToast').style.display='none', 2000);
            document.getElementById('col1MoodSelected').value = '';
            document.getElementById('col1MoodText').value = '';
            document.getElementById('col1MoodRelacion').value = '';
            document.querySelectorAll('#col1MoodOptions .mood-option-btn').forEach(x=>x.classList.remove('active'));
            await loadAndRenderHistorico();
            try { window.dispatchEvent(new CustomEvent('mood:added', { detail: { created } })); } catch(e) {}
          } catch (e) {
            console.error(e);
            const alertEl = document.getElementById("col1MoodAlert"); alertEl.className="alert alert-danger"; alertEl.textContent="Error de red al guardar."; alertEl.style.display="block";
          }
        });
      })();

    }); // end ensureChart
</script>