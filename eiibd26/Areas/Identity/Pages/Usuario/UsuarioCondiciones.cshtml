@page
@model eiibd26.Areas.Identity.Pages.Usuario.UsuarioCondicionesModel
@{
    ViewData["Title"] = "Mis condiciones";
    Layout = "_Layout";
}
<div class="container py-4">
    <h1 class="eii-page-title">Mis condiciones</h1>
    <div class="qp-wrapper-flex">
        <div class="crm-card">
            <label for="condicionBuscar" class="crm-label">
                Busca y agregar la condición con la que fuiste diagnosticad@@
            </label>
            <form id="agregarCondicionForm" autocomplete="off" class="crm-form-row" onsubmit="return false;">
                @Html.AntiForgeryToken()
                <div class="crm-search-group crm-col-8">
                    <div class="crm-search-horizontal">
                        <input id="condicionBuscar" type="text" class="crm-input" placeholder="Ej: Colitis Ulcerativa, Crohn, etc..." autocomplete="off" />
                        <button id="btnAgregarCondicion" class="crm-btn crm-btn-primary" type="button">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                    </div>
                    <input id="condicionIdSeleccionada" type="hidden" />
                    <ul id="condicionSugerencias" class="crm-list-suggest"></ul>
                </div>
            </form>
        </div>
    </div>
    <div class="condiciones-paginacion" aria-label="Paginación">
        <span>Lista de todas las condiciones</span>
    </div>

    <div class="condiciones-cards" aria-label="Condiciones">
        <!-- Cards grid -->
        @if (Model.MisCondicionesAgrupadas.Any())
        {
            <div class="crm-card-row">
                @foreach (var grupo in Model.MisCondicionesAgrupadas)
                {
                    @foreach (var hijo in grupo.Hijos)
                    {
                        <div class="crm-card-condicion">
                            <div class="crm-card-inner">
                                <div class="crm-card-header">
                                    <span class="crm-card-title">
                                        @hijo.Nombre
                                    </span>
                                    <div class="d-flex gap-1 align-items-center">
                                        <button type="button"
                                                class="btn-star-condicion crm-btn"
                                                style="border:none;background:transparent;font-size:1.15rem;padding:0 4px;line-height:1;"
                                                data-id="@hijo.CondicionUsuarioId"
                                                data-principal="@hijo.EsPrincipal.ToString().ToLower()"
                                                title="@(hijo.EsPrincipal ? "Quitar como condición principal" : "Marcar como condición principal")">
                                            @(hijo.EsPrincipal ? "⭐" : "☆")
                                        </button>
                                        <button type="button" class="crm-btn crm-btn-delete btn-eliminar"
                                                data-id="@hijo.CondicionUsuarioId"
                                                data-nombre="@hijo.Nombre"
                                                data-tratamientos="@hijo.TratamientosCount"
                                                data-sintomas="@hijo.SintomasCount"
                                                title="Eliminar condición">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="crm-card-fecha">
                                    <span class="crm-card-label"><i class="bi bi-diagram-3"></i> Grupo</span>
                                    <span class="crm-card-value">@grupo.PadreNombre</span>
                                </div>
                                <div class="crm-card-fecha">
                                    <span class="crm-card-label">
                                        <i class="bi bi-calendar2-date"></i> Fecha de Diagonostico:</span>
                                    <form method="post" class="form-editar-fecha" data-id="@hijo.CondicionUsuarioId" asp-page-handler="EditarFechaInicio">
                                        <div class="crm-input-group">
                                            <input type="date"
                                                   class="crm-input-date fecha-inicio"
                                                   name="nuevaFechaInicio"
                                                   value="@hijo.FechaInicio.ToString("yyyy-MM-dd")"
                                                   disabled />
                                            <button type="button"
                                                    class="crm-btn crm-btn-secondary btn-editar-fecha"
                                                    title="Editar fecha de inicio">
                                                Editar
                                            </button>
                                            <button type="submit"
                                                    class="crm-btn crm-btn-success d-none btn-guardar-fecha"
                                                    title="Guardar nueva fecha">
                                                Guardar
                                            </button>
                                            <button type="button"
                                                    class="crm-btn crm-btn-cancel d-none btn-cancelar-fecha"
                                                    title="Cancelar edición de fecha">
                                                Cancelar
                                            </button>
                                            <input type="hidden" name="condUsuarioId" value="@hijo.CondicionUsuarioId" />
                                        </div>
                                    </form>
                                    @* Legend alert below the date field when diagnosis date equals profile creation date *@
                                    @if (hijo.FechaCoincideConRegistro)
                                    {
                                        <div class="small text-warning mt-2" role="note">
                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                            &nbsp;Actualiza tu Fecha de Diagnostico
                                        </div>
                                    }
                                </div>
                                <div class="crm-card-section">
                                    <div class="crm-card-subtitle">Relacionados</div>
                                    <div class="crm-card-badges">
                                        <div class="crm-badge-row">
                                            <span class="crm-badge crm-badge-label">Tratamientos</span>
                                            @if (hijo.TratamientosCount > 0)
                                            {
                                                <span class="crm-badge-count">@hijo.TratamientosCount</span>
                                            }
                                        </div>
                                        <div class="crm-badge-row">
                                            <span class="crm-badge crm-badge-label">Síntomas</span>
                                            @if (hijo.SintomasCount > 0)
                                            {
                                                <span class="crm-badge-count">@hijo.SintomasCount</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="crm-card mb-2">
                <div class="fw-light text-muted crm-empty">
                    <i class="bi bi-emoji-neutral"></i>
                    Aún no has agregado ninguna condición.
                </div>
            </div>
        }
    
    
    </div>

    @section Styles {
        <link rel="stylesheet" href="~/css/usuario-condiciones-crm.css" asp-append-version="true" />
    }
</div>
@section Scripts {
    <script>
        const urlAutocomplete = "/api/condiciones/autocomplete";
        const urlAgregar = "/Identity/Usuario/UsuarioCondiciones?handler=AgregarCondicion";
        const urlEliminar = "/Identity/Usuario/UsuarioCondiciones?handler=EliminarCondicion";
        const urlEditarFecha = "/Identity/Usuario/UsuarioCondiciones?handler=EditarFechaInicio";

        function getAntiforgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }
        function addAntiforgeryToken(formData) {
            const t = getAntiforgeryToken();
            if (t) formData.set('__RequestVerificationToken', t);
        }
        // Autocomplete guard: track last request token and ignore stale responses.
        let _lastAutocompleteToken = 0;
        document.getElementById('condicionBuscar').addEventListener('input', async function () {
            let query = this.value.trim();
            let sugerenciasUl = document.getElementById('condicionSugerencias');
            // Clear current suggestions immediately
            sugerenciasUl.innerHTML = '';
            document.getElementById('condicionIdSeleccionada').value = "";
            if (query.length < 2) return;

            const myToken = ++_lastAutocompleteToken;
            let resp;
            try {
                resp = await fetch(urlAutocomplete + '?q=' + encodeURIComponent(query));
            } catch (e) {
                return; // network error
            }

            // If a newer request was started meanwhile, ignore this response
            if (myToken !== _lastAutocompleteToken) return;

            if (!resp.ok) return;
            let datos = await resp.json();

            // Defensive: ignore response if input changed after request was issued
            if (document.getElementById('condicionBuscar').value.trim() !== query) return;

            // Render suggestions, avoiding duplicates by id
            const seen = new Set();
            datos.forEach(item => {
                if (seen.has(item.id)) return;
                seen.add(item.id);

                let display = item.padreNombre
                    ? item.padreNombre + ' > ' + item.nombre
                    : item.nombre;
                let li = document.createElement('li');
                li.className = 'list-group-item crm-list-item';
                li.innerText = display;
                if (item.esPadre) {
                    li.classList.add('disabled', 'text-muted');
                    li.style.cursor = "not-allowed";
                } else {
                    li.addEventListener('mousedown', function (e) {
                        e.preventDefault(); // evita que el blur limpie las sugerencias antes del click
                        document.getElementById('condicionBuscar').value = display;
                        document.getElementById('condicionIdSeleccionada').value = item.id;
                        sugerenciasUl.innerHTML = '';
                    });
                }
                sugerenciasUl.appendChild(li);
            });
        });
        document.getElementById('btnAgregarCondicion').addEventListener('click', async function () {
            let id = document.getElementById('condicionIdSeleccionada').value;
            if (!id) {
                alert("Debes seleccionar una condición hija del listado");
                return;
            }
            let formData = new FormData();
            formData.append('condicionId', id);
            addAntiforgeryToken(formData);
            let resp = await fetch(urlAgregar, { method: "POST", body: formData });
            if (resp.ok) location.reload();
        });
        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', function () {
                let tratamientos = parseInt(this.dataset.tratamientos || "0");
                let sintomas = parseInt(this.dataset.sintomas || "0");
                let nombre = this.dataset.nombre || "";
                if (tratamientos > 0 || sintomas > 0) {
                    alert("No se puede eliminar \"" + nombre + "\" porque tiene tratamientos o síntomas relacionados. Primero elimínalos.");
                    return;
                }
                if (confirm('¿Estás seguro de eliminar "' + nombre + '"? Esta acción no se puede deshacer.')) {
                    let form = document.createElement("form");
                    form.method = "post";
                    form.action = urlEliminar;
                    let inp = document.createElement("input");
                    inp.type = "hidden";
                    inp.name = "condUsuarioId";
                    inp.value = this.dataset.id;
                    form.appendChild(inp);
                    let csrf = document.createElement("input");
                    csrf.type = "hidden";
                    csrf.name = "__RequestVerificationToken";
                    csrf.value = getAntiforgeryToken();
                    form.appendChild(csrf);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        });
        document.querySelectorAll('.form-editar-fecha').forEach(form => {
            let btnEdit = form.querySelector('.btn-editar-fecha');
            let btnSave = form.querySelector('.btn-guardar-fecha');
            let btnCancel = form.querySelector('.btn-cancelar-fecha');
            let input = form.querySelector('.fecha-inicio');
            let valorOriginal = input.value;
            btnEdit.addEventListener('click', (e) => {
                e.preventDefault();
                input.disabled = false;
                btnEdit.classList.add('d-none');
                btnSave.classList.remove('d-none');
                btnCancel.classList.remove('d-none');
            });
            btnCancel.addEventListener('click', (e) => {
                e.preventDefault();
                input.value = valorOriginal;
                input.disabled = true;
                btnEdit.classList.remove('d-none');
                btnSave.classList.add('d-none');
                btnCancel.classList.add('d-none');
            });
            form.addEventListener('submit', async function (ev) {
                ev.preventDefault();
                let formData = new FormData(form);
                addAntiforgeryToken(formData);
                let resp = await fetch(urlEditarFecha, { method: "POST", body: formData });
                if (resp.ok) {
                    valorOriginal = input.value;
                    input.disabled = true;
                    btnEdit.classList.remove('d-none');
                    btnSave.classList.add('d-none');
                    btnCancel.classList.add('d-none');
                }
            });
        });
        document.getElementById('condicionBuscar').addEventListener('blur', function () {
            setTimeout(() => { document.getElementById('condicionSugerencias').innerHTML = ''; }, 220);
        });

        // Estrella: toggle condición principal
        const urlTogglePrincipalCond = "/Identity/Usuario/UsuarioCondiciones?handler=TogglePrincipalCondicion";
        document.querySelectorAll('.btn-star-condicion').forEach(btn => {
            btn.addEventListener('click', async function () {
                const condUsuarioId = this.dataset.id;
                const formData = new FormData();
                formData.append('condUsuarioId', condUsuarioId);
                addAntiforgeryToken(formData);
                const resp = await fetch(urlTogglePrincipalCond, { method: 'POST', body: formData });
                if (resp.ok) {
                    const data = await resp.json();
                    document.querySelectorAll('.btn-star-condicion').forEach(b => {
                        b.textContent = '☆';
                        b.dataset.principal = 'false';
                        b.title = 'Marcar como condición principal';
                    });
                    if (data.esPrincipal) {
                        this.textContent = '⭐';
                        this.dataset.principal = 'true';
                        this.title = 'Quitar como condición principal';
                    }
                }
            });
        });
    </script>
}