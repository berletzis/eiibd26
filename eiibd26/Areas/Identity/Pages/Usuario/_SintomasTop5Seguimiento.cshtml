@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var hoy = DateTime.Today;
    var ayer = hoy.AddDays(-1);
    var top = Model?.TopSintomas?.Take(5).ToList() ?? new List<eiibd26.Models.SymptomTopItem>();

    Func<string, string> estadoToColor = estado =>
    {
        if (string.IsNullOrWhiteSpace(estado)) return "#E6E6EB";
        switch (estado.Trim().ToLowerInvariant())
        {
            case "ninguno": return "#E6E6EB";
            case "leve": return "#B6C2D7";
            case "moderado": return "#FFD121";
            case "severo": return "#FF8A65";
            case "extremo": return "#D32F2F";
            default: return "#E6E6EB";
        }
    };

    string KeyForDate(DateTime d) => d.ToString("yyyy-MM-dd");
}

<style>
    .sintomas-top5 {
        padding: 0.6rem;
        font-weight: 400;
    }

        .sintomas-top5 .track-table-title,
        .sintomas-top5 .dashboard-col1-title {
            font-weight: 400;
            color: #172849;
            margin-bottom: .4rem;
        }

        .sintomas-top5 .small-muted {
            font-size: .9rem;
            color: #6b7280;
            margin-bottom: .5rem;
            font-weight: 400;
        }

        .sintomas-top5 .track-dot {
            display: inline-block;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            box-shadow: 0 1px 4px rgba(204,209,234,.23);
            border: 2px solid #f3f4f8;
            vertical-align: middle;
            cursor: pointer;
        }

        .sintomas-top5 .btn-agregar {
            background: #fff;
            color: #6a4e7a;
            border: 1.5px solid #d4b8e6;
            border-radius: 9px;
            padding: 4px 9px;
            font-size: .95rem;
            font-weight: 500;
            box-shadow: 0 1px 3px rgba(106,78,122,0.08);
            transition: background .15s, border-color .15s, box-shadow .15s;
        }

            .sintomas-top5 .btn-agregar:hover,
            .sintomas-top5 .btn-agregar:focus {
                background: #f5eefb;
                border-color: #6a4e7a;
                color: #5a3d69;
                box-shadow: 0 2px 8px rgba(106,78,122,0.14);
            }

            .sintomas-top5 .btn-agregar i {
                color: #6a4e7a;
                font-size: 1.05rem;
                line-height: 1;
            }

        /* Condición más pequeña, texto un poco más chico */
        .sintomas-top5 .wrap-condiciones {
            max-width: 160px;
            white-space: normal;
            word-break: break-word;
            color: #6b7280;
            font-size: .85rem;
        }

    .table-sm td, .table-sm th {
        vertical-align: middle;
        font-weight: 400;
    }

    .table-sm th, .table-sm td {
        padding: .45rem .5rem;
    }

    .table-borderless td, .table-borderless th {
        border: none;
    }

    .sintomas-top5 .table {
        width: 100%;
        table-layout: auto;
    }

    /* Síntoma: más ancho, fuente como la leyenda */
    .sintomas-top5 th.sintoma-col,
    .sintomas-top5 td.sintoma-col {
        min-width: 220px;
        max-width: 360px;
        font-size: .9rem; /* igual que la leyenda "Ordenados..." */
        color: #111827;
        white-space: normal;
        word-break: break-word;
    }

    /* Ayer / Hoy algo más angostas */
    .sintomas-top5 th.date-col,
    .sintomas-top5 td.date-col {
        min-width: 80px;
        width: 90px;
        white-space: nowrap;
        text-align: center;
        font-size: .85rem;
    }

    .sintomas-top5 th.cond-col,
    .sintomas-top5 td.cond-col {
        min-width: 120px;
        max-width: 160px;
        white-space: normal;
        font-size: .85rem;
    }

    @@media (max-width: 576px) {
        .sintomas-top5 {
            padding-left: .4rem;
            padding-right: .4rem;
        }

            /* En móvil: solo Síntoma + Hoy. Se ocultan Tendencia, Ayer y Condición */
            .sintomas-top5 thead th:nth-child(2),
            .sintomas-top5 tbody td:nth-child(2),
            .sintomas-top5 thead th:nth-child(3),
            .sintomas-top5 tbody td:nth-child(3),
            .sintomas-top5 thead th:nth-child(5),
            .sintomas-top5 tbody td:nth-child(5) {
                display: none !important;
            }

            .sintomas-top5 .table {
                table-layout: fixed;
                width: 100%;
            }

            .sintomas-top5 th, .sintomas-top5 td {
                padding: .45rem .35rem;
                font-size: .95rem;
            }

            .sintomas-top5 th.sintoma-col,
            .sintomas-top5 td.sintoma-col {
                min-width: 0;
                width: auto;
                white-space: normal;
                overflow-wrap: anywhere;
            }

            .sintomas-top5 th.date-col,
            .sintomas-top5 td.date-col {
                min-width: 0;
                width: 72px;
                font-size: .92rem;
                white-space: normal;
            }

            .sintomas-top5 .track-dot {
                width: 14px;
                height: 14px;
                border-width: 1px;
            }

            .sintomas-top5 .btn-agregar {
                padding: 3px 6px;
                font-size: .88rem;
            }

            .sintomas-top5 .table-responsive {
                overflow-x: hidden;
            }
    }

    .sintomas-top5 th .small {
        display: block;
        margin-top: 2px;
        color: rgba(107,114,128,1);
        font-weight: 400;
    }
</style>

<div id="sintomasTop5Root" class="sintomas-top5">
    <div class="dashboard-col1-title">Síntomas </div>
    <div class="small-muted" style="font-size:.9rem;">Ordenados por mayor seguimiento en el período.</div>
    @if (Model.HealthStats != null && Model.HealthStats.Symptoms.TotalRegistros > 0)
    {
@*         var dashGlobalTend = Model.HealthStats.Symptoms.Tendencia;
        var (dashGlobalIcon, dashGlobalColor) = dashGlobalTend switch
        {
            "Empeorando" => ("🔴", "#dc3545"),
            "Mejorando"  => ("🟢", "#198754"),
            "Estable"    => ("⚪️",  "#6c757d"),
            _            => ("—",  "#adb5bd")
        };
        <div class="small-muted mt-1" style="font-size:.82rem; color:#666;">📊 Tendencia general</div>
        <div class="mt-1 mb-2" style="font-size:.9rem; font-weight:600; color:@dashGlobalColor;">
            @dashGlobalIcon @dashGlobalTend
            <span style="font-weight:400; color:#888; font-size:.8rem;">
                — @Model.HealthStats.Symptoms.TotalRegistros registro@(Model.HealthStats.Symptoms.TotalRegistros == 1 ? "" : "s")
            </span>
        </div>
        }
    else if (Model.HealthStats != null)
    {
        <div class="small-muted mt-1" style="font-size:.85rem;">Sin seguimiento en los últimos 7 días</div>
    }
    @if (Model.HealthInsight is { TieneDatos: true } insight)
    {
        <div class="d-flex flex-wrap gap-2 mt-2">
            @if (!string.IsNullOrEmpty(insight.SintomaMayorFrecuencia) && !string.IsNullOrEmpty(insight.SintomaMayorFrecuenciaNombre))
            {
                <span class="badge text-bg-light border" style="font-size:.78rem;"
                      title="Síntoma con más registros de frecuencia en el período">
                    <i class="bi bi-clock-history me-1" aria-hidden="true"></i>@insight.SintomaMayorFrecuencia: @insight.SintomaMayorFrecuenciaNombre
                </span>
            }
            @if (insight.PromedioDolorGlobal.HasValue)
            {
                <span class="badge text-bg-light border" style="font-size:.78rem;"
                      title="Promedio de dolor global del período (0-10)">
                    <i class="bi bi-activity me-1" aria-hidden="true"></i>Dolor promedio: @insight.PromedioDolorGlobal.Value.ToString("0.#")/10
                </span>
            }
        </div>
        *@
    }
    @{
        var tendDict = (Model.HealthStats?.Symptoms?.PorSintoma ?? new List<eiibd26.DTOs.Analytics.SymptomTrendDto>())
            .ToDictionary(t => t.NombreSintoma, t => t, StringComparer.OrdinalIgnoreCase);
    }
    <div class="table-responsive">
        <table class="table table-sm table-borderless align-middle">
            <thead>
                <tr>
                    <th class="text-start sintoma-col">Síntoma</th>
                    <th class="text-start" style="min-width:90px; font-size:.82rem;">Tendencia</th>
                    <th class="text-center date-col">
                        @ayer.ToString("dd/MM")
                        <small class="text-muted">@ayer.ToString("ddd")</small>
                        <div class="small text-warning">AYER</div>
                    </th>
                    <th class="text-center date-col">
                        @hoy.ToString("dd/MM")
                        <small class="text-muted">@hoy.ToString("ddd")</small>
                        <div class="small text-warning">HOY</div>
                    </th>
                    <th class="text-start cond-col">Condición</th>
                </tr>
            </thead>
            <tbody>
                @if (!top.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-msg">No hay síntomas para mostrar.</td>
                    </tr>
                }
                else
                {
                    foreach (var s in top)
                    {
                        var sintId = s.SintomaUsuarioId.ToString();
                        var keyAyer = KeyForDate(ayer);
                        var keyHoy = KeyForDate(hoy);

                        string seguimientoAyer = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyAyer) ? s.SeguimientoPorDia[keyAyer].Estado : "";
                        string seguimientoHoy  = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyHoy)  ? s.SeguimientoPorDia[keyHoy].Estado  : "";
                        var trackAyer = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyAyer) ? s.SeguimientoPorDia[keyAyer] : null;
                        var trackHoy  = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyHoy)  ? s.SeguimientoPorDia[keyHoy]  : null;
                        var condiciones = s.Condiciones ?? new List<string>();

                        <tr class="@(s.Finalizado ? "track-row--finalizado" : "")">
                            <td class="text-start sintoma-col">
                                @s.Nombre
                                @if (s.Finalizado)
                                {
                                    var finTxt = s.FechaFin!.Value.ToString("dd/MM/yyyy");
                                    <span class="track-badge--finalizado"
                                          title="Finalizó el @finTxt — ya no admite seguimiento">Finalizado</span>
                                }
                            </td>
                            @{
                                var hasTrend = tendDict.TryGetValue(s.Nombre?.Trim() ?? "", out var rowTrend);
                                var (rowDotClass, rowTextClass, rowTendShort) = hasTrend ? rowTrend!.Tendencia switch
                                {
                                    "Empeorando" => ("track-trend-dot--empeorando", "track-trend-label--empeorando", "Empeorando"),
                                    "Mejorando"  => ("track-trend-dot--mejorando",  "track-trend-label--mejorando",  "Mejorando"),
                                    "Estable"    => ("track-trend-dot--estable",    "track-trend-label--estable",    "Estable"),
                                    _            => ("track-trend-dot--sin",        "track-trend-label--sin",        "Sin datos")
                                } : ("track-trend-dot--sin", "track-trend-label--sin", "Sin datos");
                            }
                            <td title="Basado en la evolución del síntoma durante el período (no solo el último día)">
                                <span class="track-trend-cell">
                                    <span class="track-trend-dot @rowDotClass"></span>
                                    <span class="track-trend-label @rowTextClass">@rowTendShort</span>
                                </span>
                            </td>

                            <td class="text-center date-col"
                                data-dolor="@(trackAyer?.Dolor?.ToString() ?? "")"
                                data-sangrado="@(trackAyer?.TieneSangrado.HasValue == true ? (trackAyer.TieneSangrado.Value ? "true" : "false") : "")"
                                data-frecuencia="@(trackAyer?.FrecuenciaId?.ToString() ?? "")">
                                @if (!string.IsNullOrEmpty(seguimientoAyer))
                                {
                                    var color = estadoToColor(seguimientoAyer);
                                    <span class="track-dot" style="background:@color" title="@seguimientoAyer" alt="@seguimientoAyer"></span>
                                }
                                else if (!s.Finalizado)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-agregar"
                                            data-sintid="@sintId"
                                            data-dia="@keyAyer"
                                            data-nombre="@s.Nombre"
                                            data-tipo="@s.TipoSintoma"
                                            title="Agregar seguimiento (ayer)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        <span class="visually-hidden">Agregar seguimiento ayer</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <td class="text-center date-col" data-sintid="@sintId" data-dia="@keyHoy" data-nombre="@s.Nombre" data-tipo="@s.TipoSintoma"
                                data-dolor="@(trackHoy?.Dolor?.ToString() ?? "")"
                                data-sangrado="@(trackHoy?.TieneSangrado.HasValue == true ? (trackHoy.TieneSangrado.Value ? "true" : "false") : "")"
                                data-frecuencia="@(trackHoy?.FrecuenciaId?.ToString() ?? "")">
                                @if (!string.IsNullOrEmpty(seguimientoHoy))
                                {
                                    var color = estadoToColor(seguimientoHoy);
                                    <span class="track-dot" style="background:@color" title="@seguimientoHoy" alt="@seguimientoHoy"></span>
                                }
                                else if (!s.Finalizado)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-agregar"
                                            data-sintid="@sintId"
                                            data-dia="@keyHoy"
                                            data-nombre="@s.Nombre"
                                            data-tipo="@s.TipoSintoma"
                                            title="Agregar seguimiento (hoy)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        <span class="visually-hidden">Agregar seguimiento hoy</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <td class="wrap-condiciones cond-col">
                                @if (condiciones.Any())
                                {
                                    @string.Join(", ", condiciones)
                                }
                                else
                                {
                                    <span class="text-muted small">Sin Condición</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var dashTopViewData = new ViewDataDictionary(ViewData)
    {
        ["suffixId"]     = "DashTop",
        ["handlerUrl"]   = "?handler=TrackSintomaMatriz",
        ["includeFecha"] = true,
        ["frecuencias"]  = Model?.FrecuenciasCatalog ?? new List<eiibd26.Models.FrecuenciaSintomaCatalog>()
    };
}
<partial name="_TrackingSintomaModal" view-data="dashTopViewData" />

<script>
(function () {
    const root = document.getElementById('sintomasTop5Root');

    function colorFor(estado) {
        switch ((estado ?? '').toLowerCase()) {
            case "ninguno":  return "#E6E6EB";
            case "leve":     return "#B6C2D7";
            case "moderado": return "#FFD121";
            case "severo":   return "#FF8A65";
            case "extremo":  return "#D32F2F";
            default:         return "#E6E6EB";
        }
    }

    // Delegated click on add-buttons and circles
    if (root) {
        root.addEventListener('click', function (ev) {
            const addBtn = ev.target.closest('.btn-agregar');
            if (addBtn) {
                openTrackingModal_DashTop(
                    addBtn.dataset.sintid,
                    addBtn.dataset.nombre,
                    addBtn.dataset.tipo ?? '0',
                    '', '', '', '',
                    addBtn.dataset.dia
                );
                return;
            }
            const circle = ev.target.closest('.track-dot');
            if (circle) {
                // Síntoma finalizado: no admite seguimiento, tampoco editar el ya registrado.
                if (circle.closest('tr')?.classList.contains('track-row--finalizado')) return;
                const td = circle.closest('td');
                if (!td) return;
                openTrackingModal_DashTop(
                    td.getAttribute('data-sintid'),
                    td.getAttribute('data-nombre'),
                    td.getAttribute('data-tipo') ?? '0',
                    circle.getAttribute('alt') || '',
                    td.getAttribute('data-dolor')     || '',
                    td.getAttribute('data-sangrado')  || '',
                    td.getAttribute('data-frecuencia') || '',
                    td.getAttribute('data-dia')
                );
            }
        });
    }

    // Update cell UI after a successful save
    document.addEventListener('tracking:saved', function (ev) {
        const { sintomaUsuarioId, estado, fecha } = ev.detail;
        const selector = `[data-sintid="${sintomaUsuarioId}"][data-dia="${fecha}"]`;
        document.querySelectorAll(selector).forEach(function (td) {
            td.innerHTML = `<span class="track-dot"
                                  style="background:${colorFor(estado)}"
                                  alt="${estado}"
                                  title="${estado}"></span>`;
        });
    });
})();
</script>
