@model eiibd26.Models.DashboardViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
    var hoy = DateTime.Today;
    var ayer = hoy.AddDays(-1);
    var top = Model?.TopSintomas?.Take(5).ToList() ?? new List<eiibd26.Models.SymptomTopItem>();

    Func<string, string> estadoToColor = estado =>
    {
        if (string.IsNullOrWhiteSpace(estado)) return "#E6E6EB";
        switch (estado.Trim().ToLowerInvariant())
        {
            case "ninguno": return "#E6E6EB";
            case "leve": return "#B6C2D7";
            case "moderado": return "#FFD121";
            case "severo": return "#FF8A65";
            case "extremo": return "#D32F2F";
            default: return "#E6E6EB";
        }
    };

    string KeyForDate(DateTime d) => d.ToString("yyyy-MM-dd");
}

<style>
    .sintomas-top5 {
        padding: 0.6rem;
        font-weight: 400;
    }

        .sintomas-top5 .crm-table-title,
        .sintomas-top5 .dashboard-col1-title {
            font-weight: 400;
            color: #172849;
            margin-bottom: .4rem;
        }

        .sintomas-top5 .small-muted {
            font-size: .9rem;
            color: #6b7280;
            margin-bottom: .5rem;
            font-weight: 400;
        }

        .sintomas-top5 .crm-circle {
            display: inline-block;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            box-shadow: 0 1px 4px rgba(204,209,234,.23);
            border: 2px solid #f3f4f8;
            vertical-align: middle;
            cursor: pointer;
        }

        .sintomas-top5 .btn-agregar {
            border-radius: 9px;
            padding: 4px 8px;
            font-size: .95rem;
            font-weight: 400;
        }

            .sintomas-top5 .btn-agregar i {
                font-size: 1.05rem;
                line-height: 1;
            }

        /* Condición más pequeña, texto un poco más chico */
        .sintomas-top5 .wrap-condiciones {
            max-width: 160px;
            white-space: normal;
            word-break: break-word;
            color: #6b7280;
            font-size: .85rem;
        }

    .table-sm td, .table-sm th {
        vertical-align: middle;
        font-weight: 400;
    }

    .table-sm th, .table-sm td {
        padding: .45rem .5rem;
    }

    .table-borderless td, .table-borderless th {
        border: none;
    }

    .sintomas-top5 .table {
        width: 100%;
        table-layout: auto;
    }

    /* Síntoma: más ancho, fuente como la leyenda */
    .sintomas-top5 th.sintoma-col,
    .sintomas-top5 td.sintoma-col {
        min-width: 220px;
        max-width: 360px;
        font-size: .9rem; /* igual que la leyenda "Ordenados..." */
        color: #111827;
        white-space: normal;
        word-break: break-word;
    }

    /* Ayer / Hoy algo más angostas */
    .sintomas-top5 th.date-col,
    .sintomas-top5 td.date-col {
        min-width: 80px;
        width: 90px;
        white-space: nowrap;
        text-align: center;
        font-size: .85rem;
    }

    .sintomas-top5 th.cond-col,
    .sintomas-top5 td.cond-col {
        min-width: 120px;
        max-width: 160px;
        white-space: normal;
        font-size: .85rem;
    }

    .crm-modal-content {
        overflow: visible;
    }

    @@media (max-width: 576px) {
        .sintomas-top5 {
            padding-left: .4rem;
            padding-right: .4rem;
        }
            /* En móvil ocultamos Ayer y Condición; sólo se ve Síntoma + Hoy */
            .sintomas-top5 thead th:nth-child(2),
            .sintomas-top5 tbody td:nth-child(2),
            .sintomas-top5 thead th:nth-child(4),
            .sintomas-top5 tbody td:nth-child(4) {
                display: none !important;
            }

            .sintomas-top5 .table {
                table-layout: auto;
            }

            .sintomas-top5 th, .sintomas-top5 td {
                padding: .45rem .35rem;
                font-size: .95rem;
            }

                .sintomas-top5 th.date-col,
                .sintomas-top5 td.date-col {
                    min-width: 70px;
                    width: 70px;
                    font-size: .92rem;
                }

            .sintomas-top5 .crm-circle {
                width: 14px;
                height: 14px;
                border-width: 1px;
            }

            .sintomas-top5 .btn-agregar {
                padding: 3px 6px;
                font-size: .88rem;
            }

            .sintomas-top5 td.sintoma-col,
            .sintomas-top5 th.sintoma-col {
                white-space: normal;
                overflow-wrap: anywhere;
            }

            .sintomas-top5 .table-responsive {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
    }

    .sintomas-top5 th .small {
        display: block;
        margin-top: 2px;
        color: rgba(107,114,128,1);
        font-weight: 400;
    }
</style>

<div id="sintomasTop5Root" class="sintomas-top5">
    <div class="dashboard-col1-title">Síntomas (últimos 7 días)</div>
    <div class="small-muted" style="font-size:.9rem;">Ordenados por mayor seguimiento en el período.</div>
    @if (Model.HealthStats != null && Model.HealthStats.Symptoms.TotalRegistros > 0)
    {
        <div class="small-muted mt-1" style="font-size:.85rem;">
            <strong>@Model.HealthStats.Symptoms.Tendencia</strong>
            — @Model.HealthStats.Symptoms.TotalRegistros registro@(Model.HealthStats.Symptoms.TotalRegistros == 1 ? "" : "s")
        </div>
    }
    else if (Model.HealthStats != null)
    {
        <div class="small-muted mt-1" style="font-size:.85rem;">Sin seguimiento en los últimos 7 días</div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-borderless align-middle">
            <thead>
                <tr>
                    <th class="text-start sintoma-col">Síntoma</th>
                    <th class="text-center date-col">
                        @ayer.ToString("dd/MM")
                        <small class="text-muted">@ayer.ToString("ddd")</small>
                        <div class="small text-warning">AYER</div>
                    </th>
                    <th class="text-center date-col">
                        @hoy.ToString("dd/MM")
                        <small class="text-muted">@hoy.ToString("ddd")</small>
                        <div class="small text-warning">HOY</div>
                    </th>
                    <th class="text-start cond-col">Condición</th>
                </tr>
            </thead>
            <tbody>
                @if (!top.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-msg">No hay síntomas para mostrar.</td>
                    </tr>
                }
                else
                {
                    foreach (var s in top)
                    {
                        var sintId = s.SintomaUsuarioId.ToString();
                        var keyAyer = KeyForDate(ayer);
                        var keyHoy = KeyForDate(hoy);

                        string seguimientoAyer = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyAyer) ? s.SeguimientoPorDia[keyAyer] : "";
                        string seguimientoHoy = s.SeguimientoPorDia != null && s.SeguimientoPorDia.ContainsKey(keyHoy) ? s.SeguimientoPorDia[keyHoy] : "";
                        var condiciones = s.Condiciones ?? new List<string>();

                        <tr>
                            <td class="text-start sintoma-col">@s.Nombre</td>

                            <td class="text-center date-col" data-sintid="@sintId" data-dia="@keyAyer" data-nombre="@s.Nombre">
                                @if (!string.IsNullOrEmpty(seguimientoAyer))
                                {
                                    var color = estadoToColor(seguimientoAyer);
                                    <span class="crm-circle" style="background:@color" title="@seguimientoAyer" alt="@seguimientoAyer"></span>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-agregar"
                                            data-sintid="@sintId"
                                            data-dia="@keyAyer"
                                            data-nombre="@s.Nombre"
                                            title="Agregar seguimiento (ayer)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        <span class="visually-hidden">Agregar seguimiento ayer</span>
                                    </button>
                                }
                            </td>

                            <td class="text-center date-col" data-sintid="@sintId" data-dia="@keyHoy" data-nombre="@s.Nombre">
                                @if (!string.IsNullOrEmpty(seguimientoHoy))
                                {
                                    var color = estadoToColor(seguimientoHoy);
                                    <span class="crm-circle" style="background:@color" title="@seguimientoHoy" alt="@seguimientoHoy"></span>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-agregar"
                                            data-sintid="@sintId"
                                            data-dia="@keyHoy"
                                            data-nombre="@s.Nombre"
                                            title="Agregar seguimiento (hoy)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        <span class="visually-hidden">Agregar seguimiento hoy</span>
                                    </button>
                                }
                            </td>

                            <td class="wrap-condiciones cond-col">
                                @if (condiciones.Any())
                                {
                                    @string.Join(", ", condiciones)
                                }
                                else
                                {
                                    <span class="text-muted small">Sin Condición</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal necesario para el JS existente -->
<div class="modal fade" id="modalTrackingPartial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content crm-modal-content">
            <form id="formTrackingPartial" method="post" class="p-0">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 id="tituloTrackingPartial" class="modal-title">Seguimiento de síntoma</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="mensajeTrackingPartial" class="alert alert-success py-2 px-3 small mb-2 d-none">Seguimiento agregado</div>
                    <div id="errorTrackingPartial" class="alert alert-danger py-2 px-3 small mb-2 d-none"></div>
                    <div class="mb-2 fw-semibold" id="preguntaTrackingPartial"></div>
                    <div id="opcionesTrackingPartial" class="d-flex flex-column gap-2"></div>
                </div>
                <div class="modal-footer"></div>

                <input type="hidden" id="sintomaIdTrackingPartial" name="sintomaUsuarioId" />
                <input type="hidden" id="fechaTrackingPartial" name="fecha" />
                <input type="hidden" id="nombreSintomaTrackingPartial" name="nombre" />
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const opcionesTracking = [
            { val: "Ninguno", label: "Ninguno", color: "#E6E6EB" },
            { val: "Leve", label: "Leve", color: "#B6C2D7" },
            { val: "Moderado", label: "Moderado", color: "#FFD121" },
            { val: "Severo", label: "Severo", color: "#FF8A65" },
            { val: "Extremo", label: "Extremo", color: "#D32F2F" }
        ];

        const root = document.getElementById('sintomasTop5Root');

        function normalize(s) { return (s||"").toString().trim(); }
        function colorFor(estado) {
            switch (normalize(estado).toLowerCase()) {
                case "ninguno": return "#E6E6EB";
                case "leve": return "#B6C2D7";
                case "moderado": return "#FFD121";
                case "severo": return "#FF8A65";
                case "extremo": return "#D32F2F";
                default: return "#E6E6EB";
            }
        }

        function getAntiForgeryToken() {
            const f = document.getElementById('formTrackingPartial');
            if (!f) return null;
            const el = f.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : null;
        }

        function buildOptionsHtml(current) {
            let html = '';
            opcionesTracking.forEach(o => {
                const active = normalize(current).toLowerCase() === o.val.toLowerCase() ? "active" : "";
                html += `<button type="button" class="btn btn-outline-primary w-100 btn-opcion-track-partial ${active}" data-estado="${o.val}" style="display:flex;align-items:center;gap:10px;">
                            <span style="background:${o.color};width:18px;height:18px;border-radius:50%;display:inline-block;margin-right:8px;"></span>${o.label}
                        </button>`;
            });
            return html;
        }

        function openModal(sintId, fecha, nombre, estadoActual) {
            document.getElementById('sintomaIdTrackingPartial').value = sintId;
            document.getElementById('fechaTrackingPartial').value = fecha;
            document.getElementById('nombreSintomaTrackingPartial').value = nombre;

            document.getElementById('errorTrackingPartial').classList.add('d-none');
            document.getElementById('mensajeTrackingPartial').classList.add('d-none');

            const fechaObj = new Date(fecha + "T12:00:00");
            const fechaTxt = `${fechaObj.getDate().toString().padStart(2,"0")}/${(fechaObj.getMonth()+1).toString().padStart(2,"0")}/${fechaObj.getFullYear()}`;
            document.getElementById('preguntaTrackingPartial').innerText = `¿Cómo estuvo \"${nombre}\" el ${fechaTxt}?`;

            document.getElementById('opcionesTrackingPartial').innerHTML = buildOptionsHtml(estadoActual);

            const opcionesContainer = document.getElementById('opcionesTrackingPartial');
            opcionesContainer.onclick = function (ev) {
                const btn = ev.target.closest && ev.target.closest('.btn-opcion-track-partial');
                if (!btn) return;
                const estado = btn.dataset.estado;
                handleOptionSelected(estado);
            };

            var modalEl = document.getElementById('modalTrackingPartial');
            if (!modalEl || typeof bootstrap === 'undefined') return;
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function findCellsFor(sintomaUsuarioId, fecha) {
            const selector = `[data-sintid="${sintomaUsuarioId}"][data-dia="${fecha}"]`;
            return Array.from(document.querySelectorAll(selector));
        }

        async function handleOptionSelected(estado) {
            const sintomaUsuarioId = document.getElementById('sintomaIdTrackingPartial').value;
            const fechaTrack = document.getElementById('fechaTrackingPartial').value;
            const nombreSintoma = document.getElementById('nombreSintomaTrackingPartial').value;

            const cells = findCellsFor(sintomaUsuarioId, fechaTrack);
            const prevHTML = cells.map(c => c.innerHTML);
            const badgeHtml = `<span class="crm-circle" style="background:${colorFor(estado)}" alt="${estado}" title="${estado}"></span>`;

            cells.forEach(c => {
                c.innerHTML = badgeHtml;
                c.onclick = function () { openModal(sintomaUsuarioId, fechaTrack, nombreSintoma, estado); };
            });

            var modalEl = document.getElementById('modalTrackingPartial');
            if (modalEl && typeof bootstrap !== 'undefined') {
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }

            const fd = new FormData();
            fd.append('sintomaUsuarioId', sintomaUsuarioId);
            fd.append('estado', estado);
            fd.append('fecha', fechaTrack);

            const token = getAntiForgeryToken();
            const headers = token ? { 'RequestVerificationToken': token } : {};

            try {
                const resp = await fetch('?handler=TrackSintomaMatriz', {
                    method: 'POST',
                    body: fd,
                    headers: headers,
                    credentials: 'same-origin'
                });

                if (!resp.ok) {
                    cells.forEach((c,i) => c.innerHTML = prevHTML[i] || '');
                    const errorEl = document.getElementById('errorTrackingPartial');
                    let text = '';
                    try { text = await resp.text(); } catch(e) {}
                    errorEl.textContent = text ? `Error: ${text}` : 'Error guardando seguimiento';
                    errorEl.classList.remove('d-none');
                    setTimeout(()=> errorEl.classList.add('d-none'), 4000);
                    return;
                }

                let json = null;
                try { json = await resp.json().catch(()=>null); } catch(e) { json = null; }
                if (json && json.estado) {
                    const serverEstado = json.estado;
                    const badgeHtml2 = `<span class="crm-circle" style="background:${colorFor(serverEstado)}" alt="${serverEstado}" title="${serverEstado}"></span>`;
                    cells.forEach(c => {
                        c.innerHTML = badgeHtml2;
                        c.onclick = function () { openModal(sintomaUsuarioId, fechaTrack, nombreSintoma, serverEstado); };
                    });
                }
            } catch (err) {
                cells.forEach((c,i) => c.innerHTML = prevHTML[i] || '');
                console.error('Network error saving seguimiento', err);
                const errorEl = document.getElementById('errorTrackingPartial');
                errorEl.textContent = 'Error de red al guardar seguimiento';
                errorEl.classList.remove('d-none');
                setTimeout(()=> errorEl.classList.add('d-none'), 4000);
            }
        }

        if (root) {
            root.addEventListener('click', function (ev) {
                const target = ev.target;
                const addBtn = target.closest ? target.closest('.btn-agregar') : null;
                if (addBtn) {
                    const sintId = addBtn.dataset.sintid;
                    const fecha = addBtn.dataset.dia;
                    const nombre = addBtn.dataset.nombre;
                    openModal(sintId, fecha, nombre, "");
                    return;
                }
                const circle = target.closest ? target.closest('.crm-circle') : null;
                if (circle) {
                    const td = circle.closest('td');
                    if (!td) return;
                    const sintId = td.getAttribute('data-sintid');
                    const fecha = td.getAttribute('data-dia');
                    const nombre = td.getAttribute('data-nombre');
                    const estado = circle.getAttribute('alt') || "";
                    openModal(sintId, fecha, nombre, estado);
                    return;
                }
            });
        }
    })();
</script>