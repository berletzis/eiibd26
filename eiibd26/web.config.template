<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled="true"  → activa logs de inicio en .\logs\stdout_*.log
        Desactívalo (false) una vez resuelto el problema de arranque.

        SECRETS: los valores de las variables de entorno de abajo deben llenarse
        con los valores reales ANTES de subir este archivo al servidor.
        Usar doble guión bajo (__) como separador de sección de configuración.
        IMPORTANTE: no subas este archivo al repositorio con valores reales.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\eiibd26.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="REEMPLAZAR_CON_CADENA_DE_CONEXION_REAL" />
          <environmentVariable name="SendGrid__ApiKey" value="REEMPLAZAR_CON_SENDGRID_API_KEY" />
          <environmentVariable name="Twilio__AccountSid" value="REEMPLAZAR_CON_TWILIO_ACCOUNT_SID" />
          <environmentVariable name="Twilio__AuthToken" value="REEMPLAZAR_CON_TWILIO_AUTH_TOKEN" />
          <environmentVariable name="Twilio__FromNumber" value="REEMPLAZAR_CON_NUMERO_TWILIO" />
          <environmentVariable name="VapidKeys__PublicKey" value="REEMPLAZAR_CON_VAPID_PUBLIC_KEY" />
          <environmentVariable name="VapidKeys__PrivateKey" value="REEMPLAZAR_CON_VAPID_PRIVATE_KEY" />
          <environmentVariable name="AiAnswer__AnthropicApiKey" value="REEMPLAZAR_CON_ANTHROPIC_API_KEY" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
