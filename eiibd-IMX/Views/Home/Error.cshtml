@{
    var code = ViewData["Code"];
    ViewData["Title"] = code?.ToString() == "404" ? "Página no encontrada" : "Algo salió mal";
    ViewData["NoIndex"] = true;
}
<section class="wrap intro">
    <p class="eyebrow">Error @code</p>
    <h1>@(code?.ToString() == "404" ? "Esta página no existe." : "Algo salió mal de nuestro lado.")</h1>
    <p>Vuelve al <a href="/">inicio</a> o usa el menú para encontrar lo que buscabas.</p>
</section>
