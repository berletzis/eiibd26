@model HomeVm
@{
    ViewData["Title"] = "Fundación IMX · Aliado estratégico del sector productivo";
    ViewData["Description"] = "Organización sin fines de lucro y donataria autorizada. Proyectos de inversión social, protección civil, medio ambiente y orientación médica a grupos vulnerables en México.";
}

@* ═══════════ Slider vertical · 5 paneles ═══════════
   Los cinco paneles viven en el HTML desde la primera carga: el slider solo
   los desplaza. Nada se carga por JS, asi que el contenido completo es
   indexable y, si el JS falla, se ven los cinco apilados. *@
<section class="wrap slider tema-imx" id="fundacion" aria-roledescription="carrusel" aria-label="Sobre la Fundación">

    <nav class="slider-rail" aria-label="Paneles">
        <button type="button" class="rail-item" data-go="0" aria-current="true"><span>01</span>La Fundación</button>
        <button type="button" class="rail-item" data-go="1"><span>02</span>Donataria autorizada</button>
        <button type="button" class="rail-item" data-go="2"><span>03</span>Misión y valores</button>
        <button type="button" class="rail-item" data-go="3"><span>04</span>Ejes de trabajo</button>
        <button type="button" class="rail-item" data-go="4"><span>05</span>Cómo participar</button>
    </nav>

    <div class="slider-viewport">
        <div class="slider-track" id="track">

            @* ── 01 ── *@
            <div class="slide" role="group" aria-label="1 de 5: La Fundación">
                <div class="split-text">
                    <p class="eyebrow">Asociación civil · donataria autorizada</p>
                    <h1 class="h1-marca">Fundación IMX</h1>
                    <p class="h1-sub">Aliado estratégico del sector productivo</p>
                    <p class="lead">Somos una organización sin fines de lucro que surge
                       como iniciativa del sector productivo para promover el liderazgo empresarial,
                       el altruismo y la responsabilidad social.</p>
                    <p>Impulsamos proyectos de inversión social en zonas vulnerables de municipios
                       marginados, en coordinación con los comités de responsabilidad social de las
                       empresas afiliadas. Somos donataria autorizada: las aportaciones son deducibles
                       de impuestos.</p>
                </div>
                <figure class="split-fig">
                    <partial name="_FiguraComunidad" />
                    <figcaption class="fig-cap">Empresarios, sociedad civil, academia y autoridades
                        trabajando sobre el mismo problema.</figcaption>
                </figure>
            </div>

            @* ── 02 ── *@
            <div class="slide" role="group" aria-label="2 de 5: Donataria autorizada">
                <div class="split-text">
                    <p class="eyebrow">Donataria autorizada</p>
                    <h2>Tu donativo es deducible de impuestos.</h2>
                    <p class="lead">Fundación IMX está autorizada para expedir recibos deducibles
                       conforme a la Ley del Impuesto sobre la Renta. Aplica tanto para donativos
                       desde México como desde el extranjero.</p>
                    <p>Puedes aportar de forma periódica o por única vez, mediante transferencia
                       bancaria, o en especie con equipo y materiales. Todo lo recibido se destina
                       a los proyectos de los dos ejes de trabajo.</p>
                </div>

                <div class="panel">
                    <partial name="_DatosFiscales" model="Model.Organizacion" />
                </div>
            </div>

            @* ── 03 ── *@
            <div class="slide" role="group" aria-label="3 de 5: Misión y valores">
                <div class="split-text">
                    <p class="eyebrow">Misión y visión</p>
                    <h2>Contribuir en la comunidad a través del esfuerzo social.</h2>
                    <p class="lead">Programas y proyectos que impulsen la participación del sector
                       empresarial, la sociedad civil, la academia y las autoridades; y que propicien
                       la participación activa de empresarios con sentido y responsabilidad social.</p>
                    <p>A corto plazo, motivar la participación empresarial en los proyectos.
                       A mediano plazo, sumar gradualmente a quienes aún son escépticos.
                       A largo plazo, consolidar los proyectos a nivel nacional e internacional.</p>
                </div>
                <div class="panel">
                    <h3 class="panel-title">Valores</h3>
                    <partial name="_Valores" />
                </div>
            </div>

            @* ── 04 ── *@
            <div class="slide" role="group" aria-label="4 de 5: Ejes de trabajo">
                <div class="split-text">
                    <p class="eyebrow">Ejes de trabajo</p>
                    <h2>Dos frentes, alineados a la Agenda 2030.</h2>
                    <p class="lead">Todo proyecto de la Fundación entra por alguno de estos dos ejes.
                       Es lo que decide qué se aprueba y qué no.</p>
                    <p>La orientación médica a grupos vulnerables —de donde nace el contenido sobre
                       enfermedad inflamatoria intestinal de este sitio— pertenece al segundo eje.</p>
                </div>
                <div class="panel">
                    <partial name="_Ejes" />
                </div>
            </div>

            @* ── 05 ── *@
            <div class="slide" role="group" aria-label="5 de 5: Cómo participar">
                <div class="split-text">
                    <p class="eyebrow">Cómo participar</p>
                    <h2>Hay tres formas de entrar, y ninguna exige las otras dos.</h2>
                    <p class="lead">La Fundación se sostiene con aportaciones deducibles y con trabajo
                       voluntario. Puedes aportar dinero, especie, tiempo o red de contactos.</p>
                    <p>Si quieres participar, la vía formal es el formulario de contacto de
                       <a href="https://www.industrialesmx.org/fundacion/" rel="noopener">Fundación IMX</a>,
                       donde se eligen los ejes de interés y el tipo de participación.</p>
                </div>
                <div class="panel">
                    <partial name="_FormasParticipar" />
                </div>
            </div>

        </div>
    </div>

    <div class="slider-arrows">
        <button type="button" id="slide-prev" aria-label="Panel anterior">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 10l4-4 4 4" stroke="currentColor" stroke-width="1.8"
                      stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span id="slide-count">1 / 5</span>
        <button type="button" id="slide-next" aria-label="Panel siguiente">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8"
                      stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
    </div>
</section>

@* ═══════════ Programas de la Fundación ═══════════ *@
@if (Model.Programas.Count > 0)
{
    <section class="wrap row-section" id="programas">
        <div class="row-head">
            <div>
                <p class="eyebrow">Acciones permanentes</p>
                <h2>Programas de la Fundación</h2>
                <p>Los proyectos que operan todo el año. Cada uno tiene su propia página con
                   convocatorias, calendario y forma de sumarse.</p>
            </div>
            <a class="row-all" href="https://www.industrialesmx.org/fundacion/" rel="noopener">Sitio de la Fundación →</a>
        </div>
        <div class="cards cards-programas">
            @foreach (var p in Model.Programas)
            {
                <article class="card">
                    <h3><a href="@p.Url" rel="noopener">@p.Titulo</a></h3>
                    <p>@p.Descripcion</p>
                    <span class="card-ext">industrialesmx.org ↗</span>
                </article>
            }
        </div>
    </section>
}

@* ═══════════ Bloque 3 · el proyecto de salud, con la paleta de EIIBD ═══════════
   El encabezado y las dos filas viven dentro de una sola <section> con banda
   tintada, para que se lean como un mismo bloque y no como tres sueltos. *@
<section class="bloque tema-eii" id="proyecto">
    <div class="wrap">
        <header class="bloque-head">
            <p class="eyebrow">@Model.Proyecto.Eyebrow</p>
            <h2>@Model.Proyecto.Titulo</h2>
            <p>@Model.Proyecto.Descripcion</p>
        </header>

        @foreach (var fila in Model.Filas)
        {
            <div class="row-section" id="@fila.Ancla">
                <div class="row-head">
                    <div>
                        <h3>@fila.Titulo</h3>
                        <p>@fila.Descripcion</p>
                    </div>
                    <a class="row-all" href="/@fila.CategoriaSlug">Ver los @fila.TotalEnCategoria →</a>
                </div>
                <div class="cards" data-cat="@fila.CategoriaSlug">
                    <partial name="_Cards" model="fila.Cards" />
                </div>
                @if (fila.TotalEnCategoria > fila.Cards.Count)
                {
                    <button class="mas" type="button" data-cat="@fila.CategoriaSlug"
                            data-skip="@fila.Cards.Count">Cargar más</button>
                }
            </div>
        }
    </div>
</section>

<section class="wrap" id="contacto">
    <div class="aviso">
        <strong>Aviso importante.</strong> Todo el contenido de salud de este sitio es educativo
        y no sustituye la valoración de un profesional. Si tienes síntomas, acude con tu médico.
    </div>
</section>
