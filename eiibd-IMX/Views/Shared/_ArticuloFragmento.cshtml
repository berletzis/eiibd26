@model ArticuloDetalleVm
<span class="modal-cat" data-cat>@Model.CategoriaNombre</span>
<h2 data-titulo>@Model.Titulo</h2>
<p class="modal-meta">Actualizado el @Model.Actualizado.ToString("d 'de' MMMM 'de' yyyy",
    new System.Globalization.CultureInfo("es-MX"))</p>
<div class="prosa">@Html.Raw(Model.CuerpoHtml)</div>
<p class="modal-perma">
    Esta página también vive en su propia dirección:
    <a href="@Model.Url">@Model.Url</a>
</p>
