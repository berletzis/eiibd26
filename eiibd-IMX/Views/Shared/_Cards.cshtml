@model List<ArticuloCardVm>
@foreach (var a in Model)
{
    <article class="card">
        <div class="card-rank">@a.Posicion.ToString("00")</div>
        <h3><a href="@a.Url">@a.Titulo</a></h3>
        <p>@a.Resumen</p>
        <button class="card-open" type="button"
                data-cat="@a.CategoriaSlug" data-slug="@a.Slug">
            Leer aquí
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h9m-3.5-4L12.5 8 8.5 12" stroke="currentColor"
                      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </article>
}
